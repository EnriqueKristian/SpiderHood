﻿﻿@using Microsoft.AspNetCore.Components.Authorization
@using SpiderHood.Components.Pages.Shared
@inject Services.CustomAuthenticationStateProvider AuthProvider

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Aplica el tema guardado (o el del sistema operativo) ANTES de que se pinte
         cualquier cosa, para no mostrar un flash del tema equivocado. Tiene que ser
         un script inline y síncrono acá arriba — para cuando theme.js (al final del
         body) se ejecuta, la página ya se pintó. Ver wwwroot/js/theme.js para el resto
         de la lógica (cambiar de tema, seguir el del SO en "Sistema", etc). -->
    <script>
            (function() {
                try {
                    var theme = localStorage.getItem('theme') || 'system';
                    var effective = (theme === 'dark' || theme === 'light')
                        ? theme
                        : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                    document.documentElement.setAttribute('data-bs-theme', effective);
                } catch (e) { /* localStorage no disponible (modo privado, etc.) — se queda con el tema claro por defecto */ }
            })();
    </script>
    <ResourcePreloader />
    <!-- Misma tipografía que el sitio público (wwwroot/index.html), para que no
         se note el salto de un sitio a otro al iniciar sesión. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
    <!-- Bootstrap: una sola versión (antes se cargaba también 5.3.7 por CDN
         encima de esta 5.3.3 local, mezclando reglas de dos versiones). -->
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- Estilos propios de SpiderHood, en orden: tokens de diseño, base, componentes -->
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets["css/components.css"]" />
    <link rel="stylesheet" href="@Assets["SpiderHood.styles.css"]" />

    <link href="_content/Blazor.Bootstrap/blazor.bootstrap.css" rel="stylesheet" />

    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />

</head>

<body>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Program).Assembly">
            <Found Context="routeData">
                @* Solo usa AuthorizeRouteView, él manejará el login automáticamente *@
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                    <Authorizing>
                        <div class="d-flex justify-content-center align-items-center min-vh-100">
                            <div class="text-center">
                                <div class="spinner-border text-primary mb-3" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                                <h5>Cargando sesión...</h5>
                                <p class="text-muted">Por favor espera un momento</p>
                            </div>
                        </div>
                    </Authorizing>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>No encontrado</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <h1>Página no encontrada</h1>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <!-- Add chart.js reference if chart components are used in your application. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.0.1/chart.umd.js" integrity="sha512-gQhCDsnnnUfaRzD8k1L5llCCV6O9HN09zClIzzeJ8OJ9MpGmIlCxm+pdCkqTwqJ4JcjbojFr79rl2F1mzcoLMQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Add chartjs-plugin-datalabels.min.js reference if chart components with data label feature is used in your application. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js" integrity="sha512-JPcRR8yFa8mmCsfrw4TNte1ZvF1e3+1SdGMslZvmrzDYxS69J7J49vkFL8u6u8PlPJK+H3voElBtUCzaXj+6ig==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Add sortable.js reference if SortableList component is used in your application. -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>
    <script src="@Assets["js/fileDownload.js"]"></script>
    <script src="@Assets["js/utilidades.js"]"></script>
    <script src="@Assets["js/theme.js"]"></script>
</body>

</html>