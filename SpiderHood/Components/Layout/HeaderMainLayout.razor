    private static bool IsDynamicSegment(string segment) => Guid.TryParse(segment, out _) || int.TryParse(segment, out _);

    // "Menu Items" a partir de "MenuItems" (separa PascalCase) o "Select Building" a
    // partir de "select-building" -- fallback para una ruta que no está en el
    // diccionario, en vez del ToTitleCase crudo de antes (que sobre una ruta real como
    // "movement/cargar" no separaba nada y quedaba ilegible).
    private static string Humanize(string segment)
    {
        var spaced = System.Text.RegularExpressions.Regex.Replace(segment, "(?<!^)([A-Z])", " $1")
            .Replace('-', ' ').Replace('_', ' ');
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(spaced.ToLowerInvariant());
    }

    private string GetPageLabel()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');

        if (uri.Length == 0)
            return "Dashboard";

        var segments = uri.Split('/');

        // IncidentList (lista) e IncidentDetail (un incidente puntual) son páginas
        // distintas de verdad -- a diferencia del resto de las rutas con id, donde la
        // "versión con id" es la MISMA página razor filtrada (ver comentario sobre
        // PeriodPage/ConciliacionExpensesPage/MonthlyInstallmentHistory más abajo).
        if (segments.Length == 2 && segments[0].Equals("incidents", StringComparison.OrdinalIgnoreCase) && IsDynamicSegment(segments[1]))
            return "Detalle de Incidencia";

        // Probar el path completo y después ir sacando el último segmento -- así una ruta
        // con id al final (p.ej. "cuotahistorico/{guid}", "periods/{guid}",
        // "reconcileexpenses/{guid}") cae en la entrada de su prefijo estático
        // ("Histórico de Cuotas", "Períodos", "Conciliación Bancaria") salvo que exista
        // una entrada más específica para ese prefijo completo (como
        // "settings/roles/edit").
        for (var len = segments.Length; len >= 1; len--)
        {
            var candidate = string.Join('/', segments.Take(len));
            if (RouteLabels.TryGetValue(candidate, out var label))
                return label;
        }

        var fallbackSegment = segments.Reverse().FirstOrDefault(s => !IsDynamicSegment(s)) ?? segments[0];
        return Humanize(fallbackSegment);
    }

    public async Task RefreshBuildingsAsync()
    {
        _isLoading = true;
        StateHasChanged();
        await LoadUserDataAsync();
        _isLoading = false;
        StateHasChanged();
    }
}