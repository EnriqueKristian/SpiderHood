@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization

@if (_currentUser?.IsViewingAs == true)
{
    <div class="d-flex justify-content-between align-items-center px-3 py-2" style="background-color:#fff3cd;border-bottom:1px solid #ffe69c;">
        <span>
            <i class="bi bi-eye-fill me-2"></i>
            Viendo como <strong>@_currentUser.Role</strong> — solo lectura
        </span>
        <button class="btn btn-sm btn-outline-dark" @onclick="SalirDeVerComo">
            <i class="bi bi-x-circle me-1"></i>Salir de Ver Como
        </button>
    </div>
}

<div class="header-container">
    <div class="header-left">
        <!-- Antes había un breadcrumb (ícono casa + nombre) y, al lado, un título --
             ambos salían del mismo switch de 8 rutas hardcodeadas contra ~50 rutas
             reales de la app, así que en la práctica case-sensitive-mismatcheaban casi
             siempre y terminaban mostrando el mismo texto sin traducir duplicado (ver
             GetPageLabel). Se unifica en un solo elemento: un link a Dashboard + el
             nombre real de la página actual. Nada de breadcrumb con jerarquía todavía
             -- ese espacio es candidato a compartirse con el buscador del header más
             adelante, así que no vale la pena construir algo más elaborado hoy. -->
        <a href="/" class="page-home-link" title="Ir al Dashboard">
            <i class="bi bi-house"></i>
        </a>
        <h5 class="page-title">
            @GetPageLabel()
        </h5>
    </div>

    <div class="header-right">
        <!-- Selector de edificio -->
        <div class="building-selector @(Buildings.Count == 0 ? "disabled" : "")"
             data-bs-toggle="dropdown"
             aria-expanded="false"
             @onclick="() => LoadBuildingsIfNeeded()">
            <div class="building-info">
                <div class="building-icon">
                    <i class="bi bi-building"></i>
                </div>
                <div class="building-details">
                    <span class="building-name">
                        @if (_isLoading)
                        {
                            <span><i class="bi bi-arrow-repeat bi-spin me-1"></i>Cargando...</span>
                        }
                        else
                        {
                            @BuildingName
                        }
                    </span>
                </div>
            </div>
            <i class="bi bi-chevron-down ms-2"></i>
        </div>

        <!-- Dropdown de edificios -->
        <ul class="dropdown-menu building-dropdown">
            <li><h6 class="dropdown-header">Mis Edificios</h6></li>
            @if (_isLoading)
            {
                <li><span class="dropdown-item text-muted"><i class="bi bi-arrow-repeat bi-spin me-2"></i>Cargando...</span></li>
            }
            else if (!Buildings.Any())
            {
                <li><span class="dropdown-item text-muted"><i class="bi bi-info-circle me-2"></i>Sin edificios</span></li>
            }
            else
            {
                @foreach (var building in UniqueBuildings)
                {
                    <li>
                        <a class="dropdown-item @(IsActiveBuilding(building) ? "active" : "")"
                           href="javascript:void(0)"
                           @onclick="() => OnBuildingSelected(building)">
                            <i class="bi bi-building me-2"></i>
                            @(building.Building?.Name ?? "Sin nombre")
                            <span class="badge bg-@GetRoleBadgeColor(building.Role)">@(building.Role ?? "Rol")</span>
                        </a>
                    </li>
                }
            }
            @if (_canCreateBuilding)
            {
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="/buildings">
                        <i class="bi bi-plus me-2"></i>Nuevo Edificio
                    </a>
                </li>
            }
        </ul>

        <!-- Menú Usuario -->
        <div class="user-dropdown @(Buildings.Count == 0 ? "disabled" : "")">
            <button class="btn-user" data-bs-toggle="dropdown">
                <div class="avatar">
                    @if (_currentUser != null)
                    {
                        <span>@GetUserInitials()</span>
                    }
                    else
                    {
                        <span>U</span>
                    }
                </div>
                <div class="user-info">
                    <span class="user-name">@GetUserDisplayName()</span>
                    <small class="user-role">@GetUserRole()</small>
                </div>
                <i class="bi bi-chevron-down ms-2"></i>
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                <li><a class="dropdown-item" href="/Security"><i class="bi bi-shield me-2"></i>Seguridad</a></li>
                @if (_currentUser?.Roles.Contains("Administrador") == true)
                {
                    <li><a class="dropdown-item" href="/Settings"><i class="bi bi-credit-card me-2"></i>Mi Suscripción</a></li>
                }
                @if (_currentUser?.IsViewingAs == true || _currentUser?.Roles.Contains("SysAdmin") == true)
                {
                    <li><a class="dropdown-item" href="/view-as"><i class="bi bi-eye me-2"></i>Ver como...</a></li>
                }
                @if (_currentUser?.Roles.Contains("SysAdmin") == true)
                {
                    <li><a class="dropdown-item" href="/Settings/SystemLogs"><i class="bi bi-journal-text me-2"></i>Logs de Sistema</a></li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <!-- data-enhance-nav="false": sin esto, la navegación mejorada de
                         Blazor resuelve este link como un fetch dentro del MISMO circuito
                         — el layout (este componente, LeftMenu) nunca se destruye, así que
                         se queda mostrando al usuario ya deslogueado (la cookie se borra en
                         el servidor, pero el estado en memoria de este circuito no se
                         entera). Forzando una navegación de página completa, el circuito
                         viejo se tira abajo y el nuevo arranca ya anónimo. -->
                    <a class="dropdown-item text-danger" href="/Logout" data-enhance-nav="false">
                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

@code {
    [Inject] private Services.AuthService AuthService { get; set; } = default!;
    [Inject] private Services.CustomAuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private Services.ParameterService ParameterService { get; set; } = default!;
    [Inject] private Services.IPermissionService PermissionService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ILogger<HeaderMainLayout> Logger { get; set; } = default!;

    private bool _initialized = false;
    private bool _isLoading = true;
    private bool _canCreateBuilding;

    // OnBuildingSelected llama AuthService.SetCurrentBuilding, que dispara
    // MarkUserAsAuthenticated y por lo tanto AuthenticationStateChanged -- este mismo
    // componente está suscripto a ese evento (ver OnAuthenticationStateChangedAsync) y
    // reacciona volviendo a llamar LoadUserDataAsync/LoadCurrentBuildingAsync, EN
    // PARALELO con la secuencia explícita que OnBuildingSelected ya está corriendo.
    // Las dos vías terminan escribiendo en localStorage al mismo tiempo (a veces con
    // el edificio nuevo, a veces todavía con el viejo, según cuál gane la carrera), y
    // el forceLoad de OnBuildingSelected corta el circuito en el medio -- se veía
    // como TaskCanceledException/JSDisconnectedException en los logs, y el edificio
    // que terminaba guardado en localStorage era impredecible. Esta bandera hace que
    // la reacción al evento no haga nada mientras OnBuildingSelected ya se está
    // ocupando de todo -- no hace falta resetearla, el forceLoad tira abajo el
    // circuito (y este componente con él) apenas termina.
    private bool _switchingBuilding = false;
    private Models.UserSession? _currentUser;
    private List<Models.UserBuilding> Buildings { get; set; } = new();
    private string BuildingName { get; set; } = "Seleccionar Edificio";
    private Guid? CurrentBuildingId { get; set; }

    // Un mismo edificio puede aparecer varias veces en Buildings (una fila por rol al
    // que el usuario tiene acceso ahí) — este dropdown es sólo un selector de edificio,
    // no de rol (eso ya lo cubre /select-building), así que se colapsa a una fila por
    // edificio. Si es el edificio actualmente activo, se muestra el rol con el que se
    // está usando ahora mismo; para los demás, cualquiera de sus roles sirve como
    // representante (todos apuntan al mismo edificio).
    private IEnumerable<Models.UserBuilding> UniqueBuildings =>
        Buildings
            .Where(b => b.Building != null)
            .GroupBy(b => b.Building!.IdBuilding)
            .Select(g => g.FirstOrDefault(b => b.Building!.IdBuilding == CurrentBuildingId && b.Role == _currentUser?.Role) ?? g.First());

    protected override void OnInitialized()
    {
        // Igual que en LeftMenu: login, selección de edificio y cambio de rol navegan
        // SIN forceLoad, así que este componente no se recrea entre esas pantallas y su
        // OnAfterRenderAsync(firstRender) corre una sola vez por circuito — normalmente
        // en /login, con el usuario todavía anónimo. Sin esto, el header se quedaba
        // mostrando "Invitado" para siempre después de loguearse en el mismo circuito.
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChangedAsync;
    }

    private void OnAuthenticationStateChangedAsync(Task<AuthenticationState> task)
    {
        if (_switchingBuilding) return;

        _ = InvokeAsync(async () =>
        {
            await LoadUserDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            Logger.LogDebug("🟢 HeaderMainLayout.OnAfterRenderAsync - Inicializando");

            try
            {
                _isLoading = true;
                StateHasChanged();

                await AuthStateProvider.InitializeClientAsync();
                await LoadUserDataAsync();

                if (_currentUser != null)
                {
                    _canCreateBuilding = await PermissionService.HasPermissionAsync(_currentUser, "create_building");
                }

                _initialized = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "❌ Error en HeaderMainLayout.OnAfterRenderAsync");
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadUserDataAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();

        if (_currentUser?.Buildings != null)
        {
            Buildings = _currentUser.Buildings.ToList();
            await LoadCurrentBuildingAsync();

            Logger.LogDebug($"✅ Usuario: {_currentUser.Email} con {Buildings.Count} edificios");
        }
        else
        {
            Buildings = new List<Models.UserBuilding>();
            BuildingName = "Seleccionar Edificio";
            Logger.LogDebug("⚠️ Usuario sin edificios");
        }
    }

    private async Task LoadCurrentBuildingAsync()
    {
        // 0. Preferencia guardada por el propio usuario (localStorage) — sólo si ya
        // estamos en la conexión interactiva real. GetDefaultBuildingAsync usa
        // IJSRuntime para leer localStorage, y eso lanza InvalidOperationException
        // durante el prerender estático. RendererInfo.IsInteractive distingue
        // exactamente eso: prerender estático vs. circuito ya conectado.
        //
        // Va ANTES que el CurrentBuildingId de la sesión (paso 1) a propósito: ese
        // CurrentBuildingId no siempre refleja una elección real del usuario.
        // UserSessionLoader lo recalcula en CADA circuito nuevo (recarga de página,
        // reconexión) con un default arbitrario ("el primer edificio" para SysAdmin,
        // ver ResolveDefaultBuildingAndRole) — así que si esto fuera el paso 0, la
        // preferencia guardada quedaba inalcanzable: ese default arbitrario, al no
        // ser Guid.Empty, ganaba siempre y el usuario volvía al primer edificio en
        // cada recarga sin importar cuál hubiera elegido la última vez. No hay
        // riesgo de pisar una elección recién hecha EN este mismo circuito (p.ej.
        // desde /select-building o el dropdown de acá abajo): ambos guardan en
        // localStorage en el mismo momento en que actualizan la sesión, así que para
        // cuando este método corre de nuevo, localStorage ya refleja esa elección.
        if (RendererInfo.IsInteractive)
        {
            var defaultBuildingId = await AuthService.GetDefaultBuildingAsync();
            if (defaultBuildingId.HasValue)
            {
                var building = Buildings.FirstOrDefault(b => b.Building?.IdBuilding == defaultBuildingId.Value);
                if (building != null)
                {
                    await SetCurrentBuilding(building);
                    return;
                }
            }
        }

        // 1. Preferir el edificio+ROL ya confirmado en la sesión. Un mismo edificio puede
        // tener varias filas en Buildings (una por rol al que el usuario tiene acceso), y
        // los pasos de abajo (ParameterService, URL) solo matchean
        // por IdBuilding — así que con 2-3 roles sobre el mismo edificio siempre
        // resolvían a la PRIMERA fila (el primer rol), sin importar cuál se hubiera
        // elegido realmente. _currentUser.CurrentBuildingId/Role sí quedan sincronizados
        // entre sí porque AuthService.SetCurrentBuilding actualiza ambos juntos.
        if (_currentUser != null && _currentUser.CurrentBuildingId != Guid.Empty)
        {
            var current = Buildings.FirstOrDefault(b =>
                b.Building?.IdBuilding == _currentUser.CurrentBuildingId && b.Role == _currentUser.Role);

            if (current != null)
            {
                await SetCurrentBuilding(current);
                return;
            }
        }

        // 2. Intentar con ParameterService
        if (ParameterService.CurrentBuilding != null)
        {
            var building = Buildings.FirstOrDefault(b =>
                b.Building?.IdBuilding == ParameterService.CurrentBuilding.IdBuilding);

            if (building != null)
            {
                await SetCurrentBuilding(building);
                return;
            }
        }

        // 3. Intentar con URL
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (uri.StartsWith("building/"))
        {
            var buildingIdString = uri.Split('/').LastOrDefault();
            if (Guid.TryParse(buildingIdString, out Guid buildingId))
            {
                var building = Buildings.FirstOrDefault(b => b.Building?.IdBuilding == buildingId);
                if (building != null)
                {
                    await SetCurrentBuilding(building);
                    return;
                }
            }
        }

        // 4. Usar el primer edificio
        if (Buildings.Any())
        {
            await SetCurrentBuilding(Buildings.First());
        }
    }

    private async Task SetCurrentBuilding(Models.UserBuilding building)
    {
        if (building?.Building == null) return;

        CurrentBuildingId = building.Building.IdBuilding;
        BuildingName = building.Building.Name ?? "Sin nombre";

        // Actualizar servicios
        ParameterService.CurrentBuilding = building.Building;

        // Este método resuelve el edificio "de verdad" (localStorage, sesión,
        // ParameterService, URL, primero de la lista) y actualiza el estado local del
        // header (CurrentBuildingId/BuildingName arriba) y ParameterService -- pero
        // ANTES no tocaba la sesión (_currentUser.CurrentBuildingId/Role) para nada.
        // Eso dejaba un split-brain: cuando este método resolvía por localStorage
        // (paso 0) un edificio DISTINTO al que trajo la sesión recién reconstruida
        // (UserSessionLoader, en cada circuito nuevo), el header mostraba el
        // correcto pero LeftMenu, los permisos y cualquier página que lea la sesión
        // directamente (no ParameterService) seguían viendo el edificio/rol viejo.
        //
        // El "if" de acá abajo importa, y no es sólo una optimización:
        // AuthService.SetCurrentBuilding llama a MarkUserAsAuthenticated, que dispara
        // AuthenticationStateChanged incondicionalmente -- este mismo componente (y
        // LeftMenu) están suscriptos a ese evento y reaccionan volviendo a llamar a
        // este método. Sin el "if", cada resolución exitosa generaría otra
        // notificación, que generaría otra resolución idéntica, en loop infinito.
        // Sólo hace falta tocar la sesión cuando de verdad cambia algo.
        if (_currentUser != null &&
            (_currentUser.CurrentBuildingId != building.Building.IdBuilding || _currentUser.Role != building.Role))
        {
            await AuthService.SetCurrentBuilding(building.Building.IdBuilding, building.Role);
            _currentUser.CurrentBuildingId = building.Building.IdBuilding;
            _currentUser.Role = building.Role;
        }

        // No bloquear la UI mientras se guarda la preferencia. Igual que arriba, sólo
        // tiene sentido (y sólo es seguro para IJSRuntime) una vez conectado el circuito.
        if (RendererInfo.IsInteractive)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await AuthService.SetDefaultBuildingAsync(building.Building.IdBuilding);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error guardando preferencia de edificio");
                }
            });
        }

        StateHasChanged();
    }

    private async Task LoadBuildingsIfNeeded()
    {
        if (!Buildings.Any() && !_isLoading)
        {
            _isLoading = true;
            StateHasChanged();
            await LoadUserDataAsync();
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnBuildingSelected(Models.UserBuilding building)
    {
        if (building?.Building == null) return;

        // Ver el comentario en la declaración de _switchingBuilding -- corta la
        // reacción en cascada a AuthenticationStateChanged que dispara la línea de
        // abajo, para que no compita en paralelo con esta misma secuencia.
        _switchingBuilding = true;

        // Este dropdown puede listar el MISMO edificio varias veces (una fila por rol),
        // así que "seleccionar" acá también es seleccionar rol — igual que en
        // /select-building. Antes esta llamada estaba comentada, por eso elegir
        // cualquier opción no tenía ningún efecto. AuthService.SetCurrentBuilding
        // actualiza CurrentBuildingId y Role en la sesión y notifica el cambio
        // (LeftMenu y este mismo header ya escuchan ese evento); el resto de la
        // página actual (presupuestos, unidades, etc.) no escucha ese evento, solo
        // carga sus datos una vez en OnInitializedAsync -- así que hace falta un
        // recargue real. NavigationManager.Refresh() (sin forceLoad) no alcanza acá:
        // en un circuito InteractiveServer ya conectado no fuerza un nuevo request al
        // servidor, así que los componentes de la página no vuelven a inicializar y
        // se quedaban mostrando los datos del edificio anterior hasta navegar a otro
        // lado y volver. forceLoad:true fuerza una recarga real de la página.
        await AuthService.SetCurrentBuilding(building.Building.IdBuilding, building.Role);

        // Sin esto, forceLoad de la línea de abajo tira el circuito abajo y con él
        // la sesión en memoria que SetCurrentBuilding acaba de actualizar -- el
        // circuito nuevo la reconstruye desde cero (UserSessionLoader) sin memoria de
        // qué se acaba de elegir acá, así que sin guardarlo en localStorage quedaba
        // pisado por el default de UserSessionLoader (el primer edificio) apenas se
        // recargaba la página. Mismo mecanismo que ya usa /select-building.
        await AuthService.SetDefaultBuildingAsync(building.Building.IdBuilding);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private async Task SalirDeVerComo()
    {
        // Sin forceLoad -- "Ver como" vive sólo en memoria de este circuito (ver
        // VerComo.razor); un forceLoad tira el circuito abajo y la sesión se
        // rehidrataría desde la base de datos, que ya no tendría nada que "salir".
        await AuthService.StopViewAsAsync();
        NavigationManager.NavigateTo("/dashboard");
    }

    private bool IsActiveBuilding(Models.UserBuilding building)
    {
        return building?.Building != null &&
               building.Building.IdBuilding == CurrentBuildingId &&
               building.Role == _currentUser?.Role;
    }

    private string GetRoleBadgeColor(string? role)
    {
        return role?.ToLower() switch
        {
            "admin" or "administrador" => "danger",
            "owner" or "propietario" => "warning",
            "tenant" or "inquilino" => "info",
            _ => "secondary"
        };
    }

    // Métodos para el usuario
    private string GetUserDisplayName()
    {
        if (_currentUser == null) return "Invitado";

        if (!string.IsNullOrEmpty(_currentUser.FullName))
            return _currentUser.FullName.Split(' ')[0];

        return _currentUser.Email?.Split('@')[0] ?? "Usuario";
    }

    private string GetUserInitials()
    {
        if (_currentUser == null) return "U";

        if (!string.IsNullOrEmpty(_currentUser.FullName))
        {
            var parts = _currentUser.FullName.Split(' ');
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[1][0]}".ToUpper();
            if (parts.Length == 1)
                return parts[0][0].ToString().ToUpper();
        }

        return _currentUser.Email?[0].ToString().ToUpper() ?? "U";
    }

    private string GetUserRole()
    {
        // Antes mostraba TODOS los roles a los que el usuario tiene acceso
        // (_currentUser.Roles), no el que está usando ahora — confuso cuando un usuario
        // tiene 2-3 roles sobre el mismo edificio. El rol activo es _currentUser.Role.
        return string.IsNullOrWhiteSpace(_currentUser?.Role) ? "Usuario" : _currentUser.Role;
    }

    // Nombre en español de cada ruta real de la app (ver `grep -rn '@page "' Components/Pages/`
    // -- son ~50, no las 8 que cubría el switch anterior). Clave = el path sin barra
    // inicial/final, en minúsculas (el Dictionary compara OrdinalIgnoreCase, así que no
    // hace falta lowercasear a mano en GetPageLabel). Sólo los prefijos ESTÁTICOS
    // llevan entrada acá -- los segmentos dinámicos (guid/int) los pela GetPageLabel
    // probando el path completo y sacando el último segmento hasta encontrar match, así
    // que "incidents/{un guid}" cae solo en la entrada "incidents" salvo que haya una
    // más específica (como "settings/roles/edit").
    private static readonly Dictionary<string, string> RouteLabels = new(StringComparer.OrdinalIgnoreCase)
    {
        [""] = "Dashboard",
        ["dashboard"] = "Dashboard",
        ["buildings"] = "Edificios",
        ["building-request"] = "Solicitud de Edificio",
        ["select-building"] = "Selección de Edificio",
        ["assignunits"] = "Asignar Unidades",
        ["owners"] = "Propietarios",
        ["owners/details"] = "Detalle de Propietario",
