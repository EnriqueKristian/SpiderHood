        ["budgetlist"] = "Presupuestos",
        ["budgetgenerator"] = "Generar Presupuesto",
        ["cuotas"] = "Cuotas",
        ["cuotahistorico"] = "Histórico de Cuotas",
        ["cuotaextraordinaria"] = "Cuota Extraordinaria",
        ["multasymora"] = "Multas y Mora",
        ["detallecuota"] = "Detalle de Cuota",
