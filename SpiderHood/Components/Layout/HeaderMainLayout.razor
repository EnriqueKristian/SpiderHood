        ["reconcileinstallments"] = "Conciliar Cuotas",
        ["reconcileexpenses"] = "Conciliación Bancaria",
        ["conciliacionpagos"] = "Conciliación de Pagos",
        ["conciliaciongastos"] = "Conciliación de Gastos",
        ["movement"] = "Movimientos",
        ["movement/cargar"] = "Cargar Estado de Cuenta",
        ["movement/detalle"] = "Detalle de Movimiento",
        ["incidents"] = "Incidencias",
        ["category"] = "Categorías",
        ["expense"] = "Gastos",
        ["expensenew"] = "Nuevo Gasto",
        ["waterreadings"] = "Lecturas de Agua",
        ["calculoagua"] = "Cálculo de Agua",
