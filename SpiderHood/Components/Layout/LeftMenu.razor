@* LeftMenuLayout.razor *@
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject Services.IPermissionService PermissionService
@inject Services.AuthService AuthService
@inject Services.CustomAuthenticationStateProvider AuthStateProvider

@if (ShowMenu)
{
    <div class="nav-scrollable bg-dark" id="nav-collapse">
        <nav class="nav flex-column nav-pills">

            <!-- Información del usuario -->
            <a href="/Profile" class="user-info-card text-decoration-none">
                <div class="user-avatar">@GetInitials()</div>
                <div class="user-details">
                    <div class="user-email">@_currentUser?.Email</div>
                    <span class="role-chip @GetRoleColorClass(_currentUser?.Role)">
                        <i class="@GetRoleIcon(_currentUser?.Role) me-1"></i>@GetRoleDisplayName(_currentUser?.Role)
                    </span>
                </div>
            </a>

            @foreach (var menuItem in _filteredMenu)
            {
                @if (menuItem.Children.Any())
                {
                    <!-- Menú con submenús -->
                    <div class="nav-item px-1">
                        <a class="nav-link collapsed" data-bs-toggle="collapse" href="#@menuItem.Target" role="button" aria-expanded="false">
                            <i class="@menuItem.Icon me-2"></i>@menuItem.Title
                            <i class="fas fa-chevron-down ms-auto toggle-icon"></i>
                        </a>
                        <div class="collapse" id="@menuItem.Target" data-bs-parent="#nav-collapse">
                            <div class="submenu-wrapper">
                                @foreach (var child in menuItem.Children)
                                {
                                    <NavLink class="nav-link ps-3" href="@child.Url" Match="NavLinkMatch.All">
                                        <i class="@child.Icon me-2"></i>@child.Title
                                        @if (ShouldShowBadge(child.ItemKey))
                                        {
                                            <span class="badge bg-danger ms-2">@GetBadgeCount(child.ItemKey)</span>
                                        }
                                    </NavLink>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Menú simple -->
                    <div class="nav-item px-1 mt-2">
                        <NavLink class="nav-link d-flex align-items-center" href="@menuItem.Url" Match="NavLinkMatch.All">
                            <i class="@menuItem.Icon me-2"></i>@menuItem.Title
                        </NavLink>
                    </div>
                }
                
            }

            <!-- Selector de rol (solo para desarrollo/demo) -->
            @if (_isDevelopment)
            {
                <div class="role-selector mt-3 px-1">
                    <div class="role-selector-header">
                        <i class="fas fa-flask me-1"></i>Modo Desarrollo
                    </div>
                    <div class="current-role">
                        <i class="@GetRoleIcon(_currentUser?.Role) me-2"></i>@GetRoleDisplayName(_currentUser?.Role)
                    </div>
                    <div class="role-options">
                        @foreach (var role in _currentUser?.Roles ?? new())
                        {
                            <span class="role-badge @GetRoleColorClass(role) @(_currentUser?.Role == role ? "active" : "")" @onclick='() => SwitchRole(role)'>
                                <i class="@GetRoleIcon(role) me-1"></i>@role
                            </span>
                        }
                    </div>
                </div>
            }


            <br />
        </nav>
    </div>
}

@code {
    private bool ShowMenu = false;
    private Models.UserSession? _currentUser;
    private List<Models.MenuItem> _filteredMenu = new();
    private bool _isDevelopment;

    [Inject] private IWebHostEnvironment Environment { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _isDevelopment = Environment.IsDevelopment();

        // Login, selección de edificio y cambio de rol navegan SIN forceLoad para no perder
        // la sesión del circuito (ver notas en Login.razor/SelectBuilding.razor). Eso significa
        // que este componente NO se recrea entre esas pantallas, así que su OnAfterRenderAsync
        // con firstRender==true corre una sola vez por circuito — normalmente en /login, con el
        // usuario todavía anónimo. Sin esta suscripción, el menú quedaba vacío hasta un F5 real
        // (que sí recrea el circuito). Al escuchar el evento de la sesión, el menú se recarga en
        // cuanto login/SetCurrentBuilding/SwitchRole notifican el cambio de sesión.
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("🟢 LeftMenuLayout.OnAfterRenderAsync - Inicializando");

            try
            {
                await AuthStateProvider.InitializeClientAsync();
                await LoadUserDataAsync();
                await LoadMenuAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error en LeftMenuLayout.OnAfterRenderAsync {ex.Message}");
            }
        }
    }

    private void OnAuthenticationStateChangedAsync(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadUserDataAsync();
            await LoadMenuAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChangedAsync;
    }

    private async Task LoadUserDataAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();

        // ShowMenu tiene que reflejar el estado ACTUAL, no solo activarse: este método
        // también corre en logout (vía OnAuthenticationStateChangedAsync), donde
        // _currentUser vuelve a null. Antes solo se ponía ShowMenu = true y nunca se
        // apagaba, así que después de cerrar sesión el menú intentaba re-renderizar el
        // selector de rol con un _currentUser null y tiraba NullReferenceException.
        //
        // También exigimos CurrentBuildingId != Guid.Empty: un usuario recién logueado
        // con más de un edificio/rol todavía no ha confirmado ninguno (CurrentBuildingId
        // se queda en Guid.Empty hasta que SetCurrentBuilding corre desde /select-building
        // — ver GetDefaultBuilding en AuthService). Sin esta condición, el menú aparecía
        // apenas terminaba el login, mostrando de entrada el primer rol devuelto por la
        // BD, antes de que el usuario eligiera edificio/rol en /select-building.
        ShowMenu = _currentUser != null && _currentUser.CurrentBuildingId != Guid.Empty;

        if (_currentUser != null)
        {
            Console.WriteLine($"✅ Cargar Menu Usuario: {_currentUser.Email} - Rol: {_currentUser.Role}");
        }

        if (!ShowMenu)
        {
            _filteredMenu = new();
        }
    }

    private async Task LoadMenuAsync()
    {
        if (!ShowMenu || _currentUser == null)
        {
            _filteredMenu = new();
            return;
        }

        _filteredMenu = await PermissionService.GetMenuForUserAsync(_currentUser);
    }

    private async Task SwitchRole(string role)
    {
        if (_currentUser != null)
        {
            _currentUser.Role = role;

            // Persistir el cambio ANTES de refrescar: Navigation.Refresh() tira abajo el
            // circuito actual y arranca uno nuevo, que restaura la sesión desde localStorage
            // (CustomAuthenticationStateProvider.InitializeClientAsync). Sin este guardado,
            // el rol nuevo solo vivía en memoria del circuito viejo y el refresh lo revertía
            // silenciosamente al rol original.
            await AuthStateProvider.MarkUserAsAuthenticated(_currentUser);
            await PermissionService.RefreshMenu();
            await LoadMenuAsync();
            StateHasChanged();
            Navigation.Refresh();
        }
    }

    private string GetRoleDisplayName(string? role)
    {
        return role switch
        {
            "Administrador" => "Administrador",
            "SysAdmin" => "Super Admin",
            "Junta" => "Miembro de Junta",
            "Residente" => "Residente",
            _ => "Usuario"
        };
    }

    private string GetRoleColorClass(string? role)
    {
        return role switch
        {
            "Administrador" => "role-admin",
            "SysAdmin" => "role-sysadmin",
            "Junta" => "role-junta",
            "Residente" => "role-residente",
            _ => "role-neutral"
        };
    }

    private string GetRoleIcon(string? role)
    {
        return role switch
        {
            "Administrador" => "fas fa-user-shield",
            "SysAdmin" => "fas fa-crown",
            "Junta" => "fas fa-users",
            "Residente" => "fas fa-house-user",
            _ => "fas fa-user"
        };
    }

    private string GetInitials()
    {
        if (_currentUser == null)
            return "U";

        var name = _currentUser.FullName;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[1][0]}".ToUpper();
            if (parts.Length == 1)
                return parts[0][0].ToString().ToUpper();
        }

        return !string.IsNullOrWhiteSpace(_currentUser.Email) ? _currentUser.Email[0].ToString().ToUpper() : "U";
    }

    private bool ShouldShowBadge(string menuId)
    {
        // Lógica para mostrar badges en ciertos menús
        return menuId switch
        {
            "allincidents" => true,
            _ => false
        };
    }

    private string GetBadgeCount(string menuId)
    {
        // Lógica para obtener contadores
        return menuId switch
        {
            "allincidents" => "3",
            _ => ""
        };
    }
}
<script>
    // Para manejar el ícono del toggle (chevron) al abrir/cerrar
    document.addEventListener('DOMContentLoaded', function() {
        var toggles = document.querySelectorAll('[data-bs-toggle="collapse"]');
        toggles.forEach(function(toggle) {
            toggle.addEventListener('click', function() {
                var icon = this.querySelector('.toggle-icon');
                if (icon) {
                    icon.classList.toggle('fa-chevron-down');
                    icon.classList.toggle('fa-chevron-up');
                }
            });
        });
    });
</script>