﻿﻿@* LeftMenuLayout.razor *@
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject Services.IPermissionService PermissionService
@inject Services.IPermissionAdminService PermissionAdminService
@inject Services.IBudgetService BudgetService
@inject Services.IExpenseService ExpenseService
@inject Services.IReservationService ReservationService
@inject Services.AuthService AuthService
@inject Services.CustomAuthenticationStateProvider AuthStateProvider
@inject Services.IPreferenceService PreferenceService
@inject Services.SidebarStateService SidebarState
@inject IJSRuntime JS

@if (ShowMenu)
{
    <div class="nav-scrollable bg-dark collapse" id="nav-collapse">
        <nav class="nav flex-column nav-pills @(SidebarState.Collapsed ? "nav-pills-collapsed" : "")">

            @* Tarjeta de usuario -- sacada a pedido del usuario (2026-09-23): ya está
               cubierta por el menú de cuenta del top bar (avatar + nombre + rol, arriba
               a la derecha en toda la app), así que acá era información repetida. Se
               deja comentada (no borrada) por si más adelante se decide traerla de
               vuelta, o mostrar el rol de forma sutil en ese menú del top bar.
            <a href="/Profile" class="user-info-card text-decoration-none">
                <div class="user-avatar">@GetInitials()</div>
                <div class="user-details">
                    <div class="user-email">@_currentUser?.Email</div>
                    <span class="role-chip @GetRoleColorClass(_currentUser?.Role)">
                        <i class="@GetRoleIcon(_currentUser?.Role) me-1"></i>@GetRoleDisplayName(_currentUser?.Role)
                    </span>
                </div>
            </a>
            *@

            @{ var _menu = MenuAgrupado; }
            @for (var _i = 0; _i < _menu.Count; _i++)
            {
                var menuItem = _menu[_i];
                var esNuevoGrupo = !string.IsNullOrEmpty(menuItem.GroupName) && menuItem.GroupName != (_i == 0 ? null : _menu[_i - 1].GroupName);

                @if (esNuevoGrupo)
                {
                    @if (SidebarState.Collapsed)
                    {
                        @if (_i != 0)
                        {
                            <hr class="nav-section-divider" />
                        }
                    }
                    else
                    {
                        <div class="nav-section-header">@menuItem.GroupName.ToUpperInvariant()</div>
                    }
                }

                @if (menuItem.Children.Any())
                {
                    @if (SidebarState.Collapsed)
                    {
                        <!-- Menú con submenús, colapsado: flyout al pasar el mouse/foco en vez del
                             acordeón -- no hay espacio para mostrar los hijos en línea con el
                             sidebar reducido a solo íconos. -->
                        <div class="nav-item px-1 nav-item-flyout-trigger">
                            <div class="nav-link" tabindex="0" title="@menuItem.Title">
                                <i class="@menuItem.Icon"></i>
                            </div>
                            <div class="flyout-submenu">
                                <div class="flyout-submenu-header">@menuItem.Title</div>
                                @foreach (var child in menuItem.Children)
                                {
                                    <NavLink class="nav-link" href="@child.Url" Match="NavLinkMatch.All">
                                        <i class="@child.Icon me-2"></i>@child.Title
                                        @if (ShouldShowBadge(child))
                                        {
                                            <span class="badge bg-danger ms-2">@GetBadgeCount(child)</span>
                                        }
                                    </NavLink>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Menú con submenús -->
                        <div class="nav-item px-1">
                            <a class="nav-link collapsed" data-bs-toggle="collapse" href="#@menuItem.Target" role="button" aria-expanded="false">
                                <i class="@menuItem.Icon me-2"></i>@menuItem.Title
                                <i class="bi bi-chevron-down ms-auto toggle-icon"></i>
                            </a>
                            <div class="collapse" id="@menuItem.Target" data-bs-parent="#nav-collapse">
                                <div class="submenu-wrapper">
                                    @foreach (var child in menuItem.Children)
                                    {
                                        <NavLink class="nav-link ps-3" href="@child.Url" Match="NavLinkMatch.All">
                                            <i class="@child.Icon me-2"></i>@child.Title
                                            @if (ShouldShowBadge(child))
                                            {
                                                <span class="badge bg-danger ms-2">@GetBadgeCount(child)</span>
                                            }
                                        </NavLink>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Menú simple -->
                    <div class="nav-item px-1 mt-2">
                        <NavLink class="nav-link d-flex align-items-center" href="@menuItem.Url" Match="NavLinkMatch.All" title="@menuItem.Title">
                            <i class="@menuItem.Icon me-2"></i>
                            @if (!SidebarState.Collapsed)
                            {
                                @menuItem.Title
                            }
                        </NavLink>
                    </div>
                }

            }

            <!-- Selector de rol (solo para desarrollo/demo) -- oculto en modo colapsado, no
                 entra en un sidebar de solo íconos. -->
            @if (_isDevelopment && !SidebarState.Collapsed)
            {
                <div class="role-selector mt-3 px-1">
                    <div class="role-selector-header">
                        <i class="bi bi-tools me-1"></i>Modo Desarrollo
                    </div>
                    <div class="current-role">
                        <i class="@GetRoleIcon(_currentUser?.Role) me-2"></i>@GetRoleDisplayName(_currentUser?.Role)
                    </div>
                    <div class="role-options">
                        @foreach (var role in _currentUser?.Roles ?? new())
                        {
                            <span class="role-badge @GetRoleColorClass(role) @(_currentUser?.Role == role ? "active" : "")" @onclick='() => SwitchRole(role)'>
                                <i class="@GetRoleIcon(role) me-1"></i>@role
                            </span>
                        }
                    </div>
                </div>
            }

            <!-- Colapsar/expandir sidebar -- <button>, no <a href="#">: un <a> real dispara
                 la navegación mejorada de Blazor (enhanced navigation) apenas el click llega
                 al browser, y @onclick:preventDefault en Blazor Server no llega a tiempo para
                 frenarlo (es un viaje de ida y vuelta por SignalR, no un preventDefault()
                 síncrono) -- con <a> el toggle terminaba navegando a otra pantalla en vez de
                 solo cambiar el estado. -->
            <div class="nav-item px-1 mt-2 sidebar-toggle-item">
                <button type="button" class="nav-link d-flex align-items-center w-100 border-0 bg-transparent text-start" @onclick="ToggleSidebarAsync"
                   title="@(SidebarState.Collapsed ? "Expandir menú" : "Colapsar menú")">
                    <i class="bi @(SidebarState.Collapsed ? "bi-chevron-double-right" : "bi-chevron-double-left") me-2"></i>
                    @if (!SidebarState.Collapsed)
                    {
                        <span>Colapsar menú</span>
                    }
                </button>
            </div>

            <br />
        </nav>
    </div>
}

@code {
    private bool ShowMenu = false;
    private Models.UserSession? _currentUser;
    private List<Models.MenuItem> _filteredMenu = new();
    private bool _isDevelopment;

    // GroupName (GET_FullMenu) agrupa, pero NO reordena -- un item de un grupo
    // puede quedar intercalado entre items de otro si su DisplayOrder cae en el
    // medio (ej. "Reportes" en General, sembrado con un DisplayOrder mayor al de
    // los items de Comunidad). Sin esto, esa mezcla partía el grupo en dos
    // encabezados "GENERAL" separados en vez de uno solo. Se reordena acá, en el
    // layout, en vez de tocar los DisplayOrder reales en BD (que siguen sirviendo
    // para el orden relativo DENTRO de cada grupo, ya vienen ordenados así desde
    // GET_FullMenu -- OrderBy es estable, así que ThenBy por posición original
    // preserva ese orden).
    private static readonly string[] _ordenGrupos = { "General", "Comunidad", "Administración" };

    private List<Models.MenuItem> MenuAgrupado =>
        _filteredMenu
            .Select((item, index) => (item, index))
            .OrderBy(x =>
            {
                var pos = Array.IndexOf(_ordenGrupos, x.item.GroupName);
                return pos < 0 ? int.MaxValue : pos; // sin grupo/grupo desconocido -> al final
            })
            .ThenBy(x => x.index)
            .Select(x => x.item)
            .ToList();

    [Inject] private IWebHostEnvironment Environment { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _isDevelopment = Environment.IsDevelopment();

        // Login, selección de edificio y cambio de rol navegan SIN forceLoad para no perder
        // la sesión del circuito (ver notas en Login.razor/SelectBuilding.razor). Eso significa
        // que este componente NO se recrea entre esas pantallas, así que su OnAfterRenderAsync
        // con firstRender==true corre una sola vez por circuito — normalmente en /login, con el
        // usuario todavía anónimo. Sin esta suscripción, el menú quedaba vacío hasta un F5 real
        // (que sí recrea el circuito). Al escuchar el evento de la sesión, el menú se recarga en
        // cuanto login/SetCurrentBuilding/SwitchRole notifican el cambio de sesión.
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChangedAsync;

        // Ver el guard de /select-building en LoadUserDataAsync: SelectBuilding.razor
        // llama SetCurrentBuilding (dispara AuthenticationStateChanged, arriba) y RECIÉN
        // DESPUÉS NavigationManager.NavigateTo("/dashboard") -- sin forceLoad, así que es
        // dos pasos separados del mismo método, no un solo evento. Si el handler de
        // AuthenticationStateChanged corre (encolado vía InvokeAsync) ANTES de que el
        // NavigateTo termine de actualizar la ruta, LoadUserDataAsync lee todavía
        // "/select-building" y calcula ShowMenu=false -- y como nada más vuelve a
        // llamarlo, el menú quedaba oculto para siempre incluso ya parado en el
        // Dashboard. Esta segunda suscripción cubre exactamente ese caso: en cuanto el
        // router termina de procesar el cambio de URL (a esa altura ya es "/dashboard"),
        // se vuelve a evaluar con la ruta correcta.
        Navigation.LocationChanged += OnLocationChanged;

        SidebarState.CollapsedChanged += OnSidebarCollapsedChanged;
    }

    // MainLayout (.sidebar) y NavMenu (el texto del logo) NO son interactivos -- el modo
    // interactivo de este componente no "sube" hacia sus ancestros en el árbol de layout,
    // así que ninguno de los dos puede reaccionar en Blazor a este evento (confirmado en
    // vivo: su propio handler nunca llegaba a dispararse). En vez de eso, esas dos clases
    // se sincronizan acá mismo por JS de forma directa sobre el DOM -- ver
    // spiderHoodSidebar.setCollapsed en el <script> de abajo.
    private void OnSidebarCollapsedChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await SincronizarLayoutEstaticoAsync();
            StateHasChanged();
        });
    }

    private async Task SincronizarLayoutEstaticoAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("spiderHoodSidebar.setCollapsed", SidebarState.Collapsed);
        }
        catch (JSException)
        {
            // Circuito todavía no listo (prerender) -- LoadUserDataAsync/OnAfterRenderAsync
            // vuelven a intentar más adelante, ya con el circuito conectado.
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadUserDataAsync();
            await LoadMenuAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("🟢 LeftMenuLayout.OnAfterRenderAsync - Inicializando");

            try
            {
                await AuthStateProvider.InitializeClientAsync();
                await LoadUserDataAsync();
                await LoadMenuAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error en LeftMenuLayout.OnAfterRenderAsync {ex.Message}");
            }
        }
    }

    private void OnAuthenticationStateChangedAsync(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadUserDataAsync();
            await LoadMenuAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChangedAsync;
        Navigation.LocationChanged -= OnLocationChanged;
        SidebarState.CollapsedChanged -= OnSidebarCollapsedChanged;
    }

    // Se carga una sola vez por circuito, la primera vez que hay un usuario -- después
    // el estado vive en SidebarState (en memoria) y se persiste solo al tocar el botón
    // (ToggleSidebarAsync), no hace falta releer la preferencia en cada LoadUserDataAsync.
    private bool _sidebarPrefCargada;

    private async Task CargarPreferenciaSidebarAsync()
    {
        if (_sidebarPrefCargada || _currentUser == null) return;
        _sidebarPrefCargada = true;

        var prefs = await PreferenceService.GetPreferencesAsync(_currentUser.IdUser);
        SidebarState.SetCollapsed(prefs.SidebarCollapsed);
    }

    private async Task ToggleSidebarAsync()
    {
        var nuevoValor = !SidebarState.Collapsed;
        SidebarState.SetCollapsed(nuevoValor);

        if (_currentUser != null)
        {
            await PreferenceService.UpdateSidebarCollapsedAsync(_currentUser.IdUser, nuevoValor);
        }
    }

    private async Task LoadUserDataAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();

        // ShowMenu tiene que reflejar el estado ACTUAL, no solo activarse: este método
        // también corre en logout (vía OnAuthenticationStateChangedAsync), donde
        // _currentUser vuelve a null. Antes solo se ponía ShowMenu = true y nunca se
        // apagaba, así que después de cerrar sesión el menú intentaba re-renderizar el
        // selector de rol con un _currentUser null y tiraba NullReferenceException.
        //
        // También exigimos CurrentBuildingId != Guid.Empty: un usuario recién logueado
        // con más de un edificio/rol todavía no ha confirmado ninguno (CurrentBuildingId
        // se queda en Guid.Empty hasta que SetCurrentBuilding corre desde /select-building
        // — ver GetDefaultBuilding en AuthService). Sin esta condición, el menú aparecía
        // apenas terminaba el login, mostrando de entrada el primer rol devuelto por la
        // BD, antes de que el usuario eligiera edificio/rol en /select-building.
        //
        // Chequeo extra por las dudas (defensa en profundidad, no el único lugar que
        // arregla esto -- ver el guard equivalente en HeaderMainLayout.LoadCurrentBuildingAsync):
        // aunque CurrentBuildingId ya esté resuelto en la sesión, si la ruta actual
        // sigue siendo /select-building no mostramos el menú -- esa pantalla es
        // justamente donde el usuario todavía no confirmó una elección explícita.
        var enSelectBuilding = string.Equals(
            Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'),
            "select-building", StringComparison.OrdinalIgnoreCase);
        ShowMenu = _currentUser != null && _currentUser.CurrentBuildingId != Guid.Empty && !enSelectBuilding;

        if (_currentUser != null)
        {
            Console.WriteLine($"✅ Cargar Menu Usuario: {_currentUser.Email} - Rol: {_currentUser.Role}");
            await CargarPreferenciaSidebarAsync();
        }

        if (!ShowMenu)
        {
            _filteredMenu = new();
        }
    }

    private async Task LoadMenuAsync()
    {
        if (!ShowMenu || _currentUser == null)
        {
            _filteredMenu = new();
            _pendingCountsByUrl = new();
            return;
        }

        _filteredMenu = await PermissionService.GetMenuForUserAsync(_currentUser);

        // Los badges de "pendientes" (solicitudes de acceso, aprobaciones) no bloquean
        // más la aparición del menú -- antes LoadMenuAsync esperaba a LoadBadgeCountsAsync
        // (2-3 consultas extra encadenadas) antes de que OnAfterRenderAsync pudiera hacer
        // el primer StateHasChanged, así que toda la barra lateral (incluidos los links sin
        // badge) quedaba en blanco hasta que esas consultas terminaban. Ahora el menú se
        // pinta apenas están los ítems, y los badges aparecen un instante después con su
        // propio StateHasChanged.
        var usuarioDeEstaCarga = _currentUser;
        _ = CargarBadgesYRepintarAsync(usuarioDeEstaCarga);
    }

    private async Task CargarBadgesYRepintarAsync(Models.UserSession usuario)
    {
        try
        {
            await LoadBadgeCountsAsync();

            // Si mientras tanto cambió el usuario/rol (login, logout, cambio de edificio),
            // no pisar el estado del circuito con badges que ya no corresponden.
            if (!ReferenceEquals(_currentUser, usuario)) return;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error cargando badges del menú: {ex.Message}");
        }
    }

    private async Task SwitchRole(string role)
    {
        if (_currentUser != null)
        {
            // Persistir el cambio ANTES de recargar: a diferencia de lo que decía el
            // comentario anterior, la sesión YA NO se restaura de localStorage -- un
            // circuito nuevo la reconstruye desde la base de datos vía IUserSessionLoader
            // (ver su comentario de clase), que no sabe nada de este cambio en memoria.
            // Sin guardar el rol elegido en localStorage (mismo mecanismo que usa
            // HeaderMainLayout.OnRoleSelected/AuthService.SetCurrentBuilding),
            // Navigation.Refresh() de más abajo tiraba el circuito abajo y el rol nuevo
            // se perdía -- volvía a resolver el primero que trajera la consulta.
            await AuthService.SetCurrentBuilding(_currentUser.CurrentBuildingId, role);
            await AuthService.SetDefaultBuildingAsync(_currentUser.CurrentBuildingId);
            await AuthService.SetDefaultRoleAsync(role);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }

    private string GetRoleDisplayName(string? role)
    {
        return role switch
        {
            "Administrador" => "Administrador",
            "SysAdmin" => "Super Admin",
            "Junta" => "Miembro de Junta",
            "Residente" => "Residente",
            _ => "Usuario"
        };
    }

    private string GetRoleColorClass(string? role)
    {
        return role switch
        {
            "Administrador" => "role-admin",
            "SysAdmin" => "role-sysadmin",
            "Junta" => "role-junta",
            "Residente" => "role-residente",
            _ => "role-neutral"
        };
    }

    private string GetRoleIcon(string? role)
    {
        return role switch
        {
            "Administrador" => "bi bi-person-badge",
            "SysAdmin" => "bi bi-award",
            "Junta" => "bi bi-people",
            "Residente" => "bi bi-house-door",
            _ => "bi bi-person"
        };
    }

    private string GetInitials()
    {
        if (_currentUser == null)
            return "U";

        var name = _currentUser.FullName;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[1][0]}".ToUpper();
            if (parts.Length == 1)
                return parts[0][0].ToString().ToUpper();
        }

        return !string.IsNullOrWhiteSpace(_currentUser.Email) ? _currentUser.Email[0].ToString().ToUpper() : "U";
    }

    // Antes esto era un stub fijo (sólo "allincidents", con el número "3" a mano, sin
    // conectar a ningún dato real) -- reemplazado por conteos reales de "algo esperando
    // a este usuario", uno por URL de menú (ver _pendingCountsByUrl/LoadBadgeCountsAsync).
    // Se matchea por Url en vez de ItemKey porque el ítem "Asignar Roles" quedó con
    // ItemKey vacío en el script de reorganización del menú (ver
    // 2026-09-10_86_Fix_ItemKey_Vacio_Reorganizar_Menu.sql).
    private bool ShouldShowBadge(Models.MenuItem item) => GetBadgeCountValue(item) > 0;

    private string GetBadgeCount(Models.MenuItem item) => GetBadgeCountValue(item).ToString();

    private int GetBadgeCountValue(Models.MenuItem item) =>
        _pendingCountsByUrl.TryGetValue(item.Url?.Trim('/').ToLowerInvariant() ?? "", out var count) ? count : 0;

    private Dictionary<string, int> _pendingCountsByUrl = new();

    private async Task LoadBadgeCountsAsync()
    {
        _pendingCountsByUrl = new();
        if (_currentUser == null) return;

        // Las dos bandejas ("solicitudes" y "aprobaciones") son independientes entre sí --
        // antes se consultaban una atrás de la otra (hasta 4 round-trips encadenados: 2
        // chequeos de permiso + 2 consultas de datos). Con el cache de permisos ya
        // arreglado en PermissionService, los HasPermissionAsync de acá adentro son
        // gratis (cache hit) -- lo que queda son las 2-3 consultas de datos reales,
        // que sí vale la pena correr en paralelo.
        var solicitudesTask = ContarSolicitudesPendientesAsync(_currentUser);
        var aprobacionesTask = ContarAprobacionesPendientesAsync(_currentUser);
        await Task.WhenAll(solicitudesTask, aprobacionesTask);

        _pendingCountsByUrl["settings/userroles"] = solicitudesTask.Result;
        _pendingCountsByUrl["aprobaciones"] = aprobacionesTask.Result;
    }

    // Solicitudes de acceso pendientes (mismo criterio que _pendingRequests en
    // UserRoles.razor) -- sólo consulta si el usuario puede hacer algo con ellas, para no
    // sumar una consulta de más a Residente/Junta.
    private async Task<int> ContarSolicitudesPendientesAsync(Models.UserSession usuario)
    {
        if (!await PermissionService.HasPermissionAsync(usuario, "assign_roles")) return 0;

        var esSysAdmin = usuario.Role == "SysAdmin";
        var misEdificios = usuario.Buildings
            .Where(b => b.IsApproved && b.Building != null)
            .Select(b => b.Building!.IdBuilding)
            .ToHashSet();

        var asociaciones = await PermissionAdminService.GetUserBuildingRoleAssignmentsAsync();
        return asociaciones.Count(a =>
            !a.IsApproved && a.Status != "Rejected" && a.Status != "Inactive"
            && (esSysAdmin || misEdificios.Contains(a.IdBuilding)));
    }

    // Presupuestos en revisión + gastos pendientes del edificio actual, para quien puede
    // aprobar cada uno -- ver Components/Pages/ApprovalsPages/Approvals.razor. Los dos
    // suman al mismo badge (una sola bandeja "Aprobaciones").
    private async Task<int> ContarAprobacionesPendientesAsync(Models.UserSession usuario)
    {
        if (usuario.CurrentBuildingId == Guid.Empty) return 0;

        var count = 0;
        if (await PermissionService.HasPermissionAsync(usuario, "approve_budget"))
        {
            var presupuestos = await BudgetService.GetBudgetsAsync(usuario.CurrentBuildingId, estado: Models.BudgetStatus.Check);
            count += presupuestos.Count;
        }

        if (await PermissionService.HasPermissionAsync(usuario, "approve_expenses"))
        {
            var gastos = await ExpenseService.GetExpensesByBuildingAsync(usuario.CurrentBuildingId);
            count += gastos.Count(e => e.Status == Models.StatusExpense.Pending);
        }

        if (await PermissionService.HasPermissionAsync(usuario, "approve_reservations"))
        {
            var reservas = await ReservationService.GetReservationsPendientesAsync(usuario.CurrentBuildingId);
            count += reservas.Count;
        }

        return count;
    }
}
<script>
    // MainLayout (.sidebar) y NavMenu (el texto del logo) no son componentes interactivos
    // -- no pueden reaccionar en Blazor cuando este componente (que sí lo es) cambia
    // SidebarStateService. Esta función la llama LeftMenu por JS interop (ver
    // SincronizarLayoutEstaticoAsync en el bloque de código) cada vez que cambia el estado
    // colapsado/expandido, para mantener sincronizados esos dos elementos que viven
    // fuera de su propio árbol interactivo. window.spiderHoodSidebar en vez de una
    // función suelta para no ensuciar el scope global con más de un nombre.
    window.spiderHoodSidebar = {
        setCollapsed: function (collapsed) {
            var sidebar = document.querySelector('.sidebar');
            if (sidebar) sidebar.classList.toggle('sidebar-collapsed', collapsed);

            // classList en vez de solo el atributo `hidden`: NavMenu.razor.css ya define
            // `.brand-text { display: flex; ... }`, que por especificidad le gana al
            // `display: none` implícito de [hidden] -- un estilo inline sí gana siempre.
            var brandText = document.querySelector('.brand-text');
            if (brandText) brandText.style.display = collapsed ? 'none' : '';
        }
    };

    // Para manejar el ícono del toggle (chevron) al abrir/cerrar
    document.addEventListener('DOMContentLoaded', function() {
        var toggles = document.querySelectorAll('[data-bs-toggle="collapse"]');
        toggles.forEach(function(toggle) {
            toggle.addEventListener('click', function() {
                var icon = this.querySelector('.toggle-icon');
                if (icon) {
                    icon.classList.toggle('bi-chevron-down');
                    icon.classList.toggle('bi-chevron-up');
                }
            });
        });
    });

    // Flyout de submenú cuando el sidebar está colapsado a solo íconos. Con
    // delegación en `document` (no querySelectorAll + addEventListener directo como
    // arriba) a propósito: los ítems con submenú se renderizan/destruyen según carga
    // el menú por rol (LoadMenuAsync, async) y según se colapsa/expande el sidebar, en
    // cualquier momento después de este primer render -- un listener delegado en
    // `document` sigue funcionando sin importar cuándo Blazor agregue o saque esos
    // nodos del DOM, sin tener que volver a "cablear" nada.
    //
    // position:fixed (ver CSS .flyout-submenu) para no quedar recortado por el
    // overflow-y:auto de .nav-scrollable -- un position:absolute ahí adentro se
    // recortaría (overflow-y:auto fuerza el overflow-x calculado a auto también,
    // aunque no se lo pida). fixed no depende de eso, pero tampoco se puede anclar
    // solo con CSS a "el ítem sobre el que estoy" -- de ahí el cálculo de posición acá.
    // Ver más abajo (click) -- Blazor puede volver a renderizar este mismo nodo
    // (LocationChanged tras navegar) con el mouse real todavía parado en el mismo
    // punto de la pantalla, y el browser dispara un mouseover "fantasma" apenas el
    // elemento reaparece bajo el cursor sin que el mouse se haya movido -- confirmado
    // en vivo: sin esta ventana, el flyout se cerraba al click pero volvía a abrirse
    // solo un instante después. lastFlyoutCloseAt ignora esos mouseover cercanos a un
    // cierre por click.
    var lastFlyoutCloseAt = 0;

    document.addEventListener('mouseover', function (e) {
        var trigger = e.target.closest('.nav-item-flyout-trigger');
        if (!trigger) return;
        if (Date.now() - lastFlyoutCloseAt < 400) return;
        var flyout = trigger.querySelector('.flyout-submenu');
        if (!flyout) return;
        var rect = trigger.getBoundingClientRect();
        flyout.style.top = rect.top + 'px';
        flyout.style.left = rect.right + 'px';
        flyout.classList.add('flyout-open');
    });

    document.addEventListener('mouseout', function (e) {
        var trigger = e.target.closest('.nav-item-flyout-trigger');
        if (!trigger) return;
        // relatedTarget es adonde entró el mouse -- si sigue dentro del propio
        // trigger (que incluye el flyout, es su hijo en el DOM) no hay que cerrar.
        if (trigger.contains(e.relatedTarget)) return;
        var flyout = trigger.querySelector('.flyout-submenu');
        if (flyout) flyout.classList.remove('flyout-open');
    });

    // Clic en un hijo del flyout (navega a otra pantalla): cerrarlo YA, no esperar a
    // un mouseout que nunca llega -- el mouse real no se mueve al hacer clic, así que
    // sin esto el panel se quedaba "pegado" abierto y encima flotando sobre el
    // contenido de la pantalla nueva (LeftMenu no se recrea al navegar dentro de la
    // app, así que el mismo nodo del flyout persiste con su clase flyout-open puesta
    // de antes). Se cierra por JS al toque, sin esperar el viaje de ida y vuelta al
    // servidor de la navegación misma.
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.flyout-submenu')) return;
        lastFlyoutCloseAt = Date.now();
        document.querySelectorAll('.flyout-submenu.flyout-open').forEach(function (flyout) {
            flyout.classList.remove('flyout-open');
        });
    });
</script>