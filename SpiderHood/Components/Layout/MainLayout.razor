@using SpiderHood.Models
@inherits LayoutComponentBase
@inject Services.AuthService AuthService

@* MainLayout NO es interactivo (sin @rendermode) -- el modo interactivo de LeftMenu
   más abajo en el árbol no "sube" hacia sus ancestros (el render mode cascadea hacia
   ABAJO, a los hijos, no hacia arriba al layout que lo contiene). Por eso .sidebar no
   puede reaccionar en Blazor a SidebarStateService -- LeftMenu sincroniza esta clase
   directamente por JS (ver spiderHoodSidebar.setCollapsed en su <script>) apenas
   conecta su propio circuito, en vez de que este componente escuche el evento (nunca
   le llegaría: confirmado en vivo -- ver commit de este cambio). *@
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- HEADER MEJORADO -->
        
        <div class="top-row px-4">
            <HeaderMainLayout />
        </div>

        <!-- CONTENIDO PRINCIPAL -->
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- Error UI -->
<div id="blazor-error-ui" data-nosnippet>
    <div class="error-content">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Ha ocurrido un error inesperado.
        <a href="." class="reload ms-3">
            <i class="bi bi-arrow-clockwise me-1"></i>Recargar
        </a>
        <span class="dismiss">✕</span>
    </div>
</div>

@code {
    private UserSession? currentUser = null;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
    }
}