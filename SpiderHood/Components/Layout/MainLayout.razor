@inherits LayoutComponentBase
@inject Services.ParameterService ParameterService
@inject NavigationManager NavigationManager

<style>
    /* Estilos adicionales para el header mejorado */

    .top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 70px;
        background: white;
        border-bottom: 1px solid #e9ecef;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    /* Header Left */
    .header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
    }

    .breadcrumb-item a {
        color: #6c757d;
        text-decoration: none;
    }

    .breadcrumb-item.active {
        color: #2563eb;
        font-weight: 500;
    }

    .page-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1e293b;
        border-left: 2px solid #e9ecef;
        padding-left: 16px;
    }

    /* Header Right */
    .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    /* Building Selector */
    .building-selector {
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border-radius: 10px;
        padding: 6px 16px 6px 12px;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid #e9ecef;
        min-width: 200px;
    }

        .building-selector:hover {
            background: #e9ecef;
            border-color: #ced4da;
        }

    .building-info {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
    }

    .building-icon {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #2563eb, #1e40af);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
    }

    .building-details {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .building-name {
        font-weight: 600;
        color: #1e293b;
        font-size: 0.9rem;
    }

    .building-period {
        font-size: 0.7rem;
        color: #6c757d;
    }

    /* Building Dropdown */
    .building-dropdown {
        width: 280px;
        padding: 8px 0;
    }

        .building-dropdown .dropdown-item {
            display: flex;
            align-items: center;
            padding: 10px 16px;
        }

            .building-dropdown .dropdown-item.active {
                background: #e9ecef;
                color: #2563eb;
            }

    /* Notifications */
    .notification-dropdown {
        position: relative;
    }

    .btn-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid #e9ecef;
        background: white;
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: relative;
    }

        .btn-icon:hover {
            background: #f8f9fa;
        }

    .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #dc3545;
        color: white;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        font-size: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* User Dropdown */
    .user-dropdown {
        position: relative;
    }

    .btn-user {
        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: 1px solid #e9ecef;
        border-radius: 30px;
        padding: 4px 16px 4px 4px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-user:hover {
            background: #f8f9fa;
            border-color: #ced4da;
        }

    .avatar {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
    }

    .user-info {
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .user-name {
        font-weight: 600;
        color: #1e293b;
        font-size: 0.9rem;
    }

    .user-role {
        font-size: 0.7rem;
        color: #6c757d;
    }

    /* Dropdown Menus */
    .dropdown-menu {
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        border-radius: 12px;
        padding: 8px 0;
        min-width: 220px;
    }

    .dropdown-item {
        padding: 10px 20px;
        font-size: 0.9rem;
        color: #1e293b;
    }

        .dropdown-item i {
            width: 20px;
            color: #6c757d;
        }

        .dropdown-item:hover {
            background: #f8f9fa;
        }

        .dropdown-item.text-danger i {
            color: #dc3545;
        }

    .dropdown-divider {
        margin: 8px 0;
        border-color: #e9ecef;
    }

    /* Error UI */
    #blazor-error-ui {
        background: #dc3545;
        color: white;
        padding: 8px 16px;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 2000;
        display: none;
    }

    .error-content {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    #blazor-error-ui .reload {
        color: white;
        text-decoration: none;
        background: rgba(255,255,255,0.2);
        padding: 4px 12px;
        border-radius: 20px;
    }

    #blazor-error-ui .dismiss {
        cursor: pointer;
        margin-left: 16px;
        opacity: 0.8;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .building-selector {
            min-width: auto;
        }

        .building-details .building-period {
            display: none;
        }

        .user-info {
            display: none !important;
        }

        .btn-user {
            padding: 4px;
        }
    }
</style>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- HEADER MEJORADO -->
        <div class="top-row px-4">
            <div class="header-left col-md-4">
                <!-- Breadcrumb mejorado -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/Dashboard">
                                <i class="fas fa-home"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            @GetCurrentPageName()
                        </li>
                    </ol>
                </nav>

                <!-- Título de página opcional -->
                <h5 class="page-title ms-3 mb-0 d-none d-md-block">
                    @*GetPageTitle()*@
                    @(ParameterService.CurrentBuilding?.Name ?? "Vacio");
                </h5>
            </div>
            <div class=" col-md-2"></div>

            <div class="header-right col-md-6">
                <!-- Selector de edificio mejorado -->
                <div class="building-selector" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="building-info">
                        <div class="building-icon">
                            <i class="fas fa-building"></i>
                        </div>
                        <div class="building-details">
                            <span class="building-name">
                                @(ParameterService.CurrentBuilding?.Name ?? "Seleccionar Edificio")
                            </span>
                            <!--<small class="building-period">
                                @GetCurrentPeriod()
                            </small>-->
                        </div>
                    </div>
                    <i class="fas fa-chevron-down ms-2"></i>
                </div>

                <!-- Dropdown de edificios -->
                <ul class="dropdown-menu dropdown-menu-end building-dropdown">
                    <li><h6 class="dropdown-header">Mis Edificios</h6></li>
                    @foreach (var building in GetBuildings())
                    {
                        <li>
                            <a class="dropdown-item @(building.IdBuilding == ParameterService.CurrentBuilding?.IdBuilding ? "active" : "")"
                               href="@($"building/{building.IdBuilding}")">
                                <i class="fas fa-building me-2"></i>
                                @building.Name
                                <span class="badge bg-success ms-2">@building.Apartments</span>
                            </a>
                        </li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="/Buildings/Create">
                            <i class="fas fa-plus me-2"></i>Nuevo Edificio
                        </a>
                    </li>
                </ul>

                <!-- Notificaciones -->
                <div class="notification-dropdown">
                    <button class="btn btn-icon" data-bs-toggle="dropdown">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge">3</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notifications">
                        <div class="notifications-header">
                            <h6>Notificaciones</h6>
                            <a href="#">Marcar todas como leídas</a>
                        </div>
                        <div class="notifications-list">
                            <!-- Items de notificación -->
                        </div>
                    </div>
                </div>

                <!-- Usuario mejorado -->
                <div class="user-dropdown">
                    <button class="btn-user" data-bs-toggle="dropdown">
                        <div class="avatar">
                            <span>MP</span>
                        </div>
                        <div class="user-info d-none d-lg-block">
                            <span class="user-name">Admin</span>
                            <small class="user-role">Administrador</small>
                        </div>
                        <i class="fas fa-chevron-down ms-2"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/Profile">
                                <i class="fas fa-user me-2"></i>Mi Perfil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/Settings">
                                <i class="fas fa-gear me-2"></i>Configuración
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/Security">
                                <i class="fas fa-shield me-2"></i>Seguridad
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="/Logout">
                                <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- CONTENIDO PRINCIPAL -->
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- Error UI -->
<div id="blazor-error-ui" data-nosnippet>
    <div class="error-content">
        <i class="fas fa-exclamation-triangle me-2"></i>
        Ha ocurrido un error inesperado.
        <a href="." class="reload ms-3">
            <i class="fas fa-rotate-right me-1"></i>Recargar
        </a>
        <span class="dismiss">✕</span>
    </div>
</div>

@code {
    //private Guid IdBuilding = new Guid("C574A553-1573-48C8-F85E-08DE3426C28E");

    protected override async Task OnInitializedAsync()
    {
        //await ParameterService.LoadParametersAsync(IdBuilding);
    }


    // Obtener nombre de la página actual
    private string GetCurrentPageName()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return uri switch
        {
            "Dashboard" => "Dashboard",
            "Buildings" => "Edificios",
            "Units" => "Unidades",
            "budgetlist" => "Presupuestos",
            "budgetgenerator" => "Presupuesto",
            "Reconciliation" => "Conciliación",
            "WaterReadings" => "Lectura",
            "Reports" => "Reportes",
            _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(uri)
        };
    }

    // Obtener título descriptivo
    private string GetPageTitle()
    {
        var page = GetCurrentPageName();
        return page switch
        {
            "Dashboard" => "Panel de Control",
            "Edificios" => "Gestión de Edificios",
            "Unidades" => "Administración de Unidades",
            "Presupuestos" => "Ciclo Presupuestario",
            "Presupuesto" => "Presupuesto",
            "Conciliación" => "Conciliación Bancaria",
            "Lectura Agua" => "Lectura Agua",
            "Reportes" => "Reportes y Estadísticas",
            _ => page
        };
    }

    // Obtener período actual
    private string GetCurrentPeriod()
    {
        return DateTime.Now.ToString("MMMM yyyy").ToUpper();
    }

    // Obtener lista de edificios (implementar según tu lógica)
    private List<Models.Building> GetBuildings()
    {
        // Aquí deberías obtener los edificios de tu servicio
        return ParameterService.Buildings.ToList();
    }

}