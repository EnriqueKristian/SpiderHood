@page "/usuarios"
@using SpiderHood.Models
@using SpiderHood.Services
@inject UsuarioService UsuarioService

<PageTitle>Gestión de Usuarios</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="page-title">
                    <i class="fas fa-users me-2"></i>Gestión de Usuarios
                </h1>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" @onclick="ExportarUsuarios">
                        <i class="fas fa-file-export me-1"></i> Exportar
                    </button>
                    <button class="btn btn-primary" @onclick="MostrarModalNuevoUsuario">
                        <i class="fas fa-user-plus me-1"></i> Nuevo Usuario
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tarjetas de Resumen -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-muted">Total Usuarios</h6>
                            <h3 class="card-title mb-0">@usuarios.Count</h3>
                        </div>
                        <div class="icon-circle bg-primary">
                            <i class="fas fa-users text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-muted">Administradores</h6>
                            <h3 class="card-title mb-0">@usuarios.Count(u => u.Rol == "Administrador")</h3>
                        </div>
                        <div class="icon-circle bg-warning">
                            <i class="fas fa-user-shield text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-muted">Usuarios Activos</h6>
                            <h3 class="card-title mb-0">@usuarios.Count(u => u.Estado == "Activo")</h3>
                        </div>
                        <div class="icon-circle bg-success">
                            <i class="fas fa-user-check text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-muted">Usuarios Inactivos</h6>
                            <h3 class="card-title mb-0">@usuarios.Count(u => u.Estado == "Inactivo")</h3>
                        </div>
                        <div class="icon-circle bg-secondary">
                            <i class="fas fa-user-clock text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Filtros -->
        <div class="col-lg-3 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filtros</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="text-muted mb-3">
                            <i class="fas fa-user-tag me-2"></i>Roles
                        </h6>
                        <div class="list-group list-group-flush">
                            @foreach (var rol in roles)
                            {
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(rolSeleccionado == rol ? "active" : "")"
                                        @onclick="() => FiltrarPorRol(rol)">
                                    @rol
                                    <span class="badge bg-primary rounded-pill">@ObtenerCantidadPorRol(rol)</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div>
                        <h6 class="text-muted mb-3">
                            <i class="fas fa-chart-bar me-2"></i>Estado
                        </h6>
                        <div class="list-group list-group-flush">
                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(filtroEstado == null ? "active" : "")"
                                    @onclick="() => FiltrarPorEstado(null)">
                                Todos
                                <span class="badge bg-secondary rounded-pill">@usuarios.Count</span>
                            </button>
                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(filtroEstado == "Activo" ? "active" : "")"
                                    @onclick="() => FiltrarPorEstado(strActivo)">
                                Activos
                                <span class="badge bg-success rounded-pill">@usuarios.Count(u => u.Estado == "Activo")</span>
                            </button>
                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(filtroEstado == "Inactivo" ? "active" : "")"
                                    @onclick="() => FiltrarPorEstado(strInactivo)">
                                Inactivos
                                <span class="badge bg-secondary rounded-pill">@usuarios.Count(u => u.Estado == "Inactivo")</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Usuarios -->
        <div class="col-lg-9">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>USUARIO</th>
                                    <th>CONTACTO</th>
                                    <th>ROL</th>
                                    <th>DEPTO</th>
                                    <th>ESTADO</th>
                                    <th>FECHA INGRESO</th>
                                    <th>ACCIONES</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in usuariosFiltrados)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar @GetAvatarClass(usuario)">
                                                    @GetIniciales(usuario.Nombre)
                                                </div>
                                                <div class="ms-3">
                                                    <div class="fw-bold">@usuario.Nombre</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <small class="text-primary">@usuario.Email</small>
                                                <small class="text-muted">@usuario.Telefono</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @GetRolBadgeClass(usuario.Rol)">
                                                @usuario.Rol
                                            </span>
                                        </td>
                                        <td>@usuario.Departamento</td>
                                        <td>
                                            <span class="badge @(usuario.Estado == "Activo" ? "bg-success" : "bg-secondary")">
                                                @usuario.Estado
                                            </span>
                                        </td>
                                        <td>@usuario.FechaIngreso.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-outline-primary"
                                                        @onclick="() => EditarUsuario(usuario.Id)"
                                                        title="Editar usuario">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-outline-warning"
                                                        @onclick="() => CambiarEstadoUsuario(usuario.Id)"
                                                        title="Cambiar estado">
                                                    <i class="fas @(usuario.Estado == "Activo" ? "fa-user-slash" : "fa-user-check")"></i>
                                                </button>
                                                <button class="btn btn-outline-danger"
                                                        @onclick="() => EliminarUsuario(usuario.Id)"
                                                        title="Eliminar usuario">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!usuariosFiltrados.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No se encontraron usuarios con los filtros seleccionados</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Nuevo/Editar Usuario -->
@if (mostrarModalUsuario)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas @(usuarioEditando == null ? "fa-user-plus" : "fa-user-edit") me-2"></i>
                        @(usuarioEditando == null ? "Nuevo Usuario" : "Editar Usuario")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalUsuario"></button>
                </div>
                <div class="modal-body">
                    <UsuarioForm Usuario="usuarioActual"
                                 OnSave="GuardarUsuario"
                                 OnCancel="CerrarModalUsuario" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Usuario> usuarios = new();
    private List<Usuario> usuariosFiltrados = new();
    private List<string> roles = new() { "Todos", "Administrador", "Junta Directiva", "Residente" };

    private string? rolSeleccionado = "Todos";
    private string? filtroEstado;

    private bool mostrarModalUsuario = false;
    private Usuario? usuarioActual;
    private Usuario? usuarioEditando;

    private string strActivo = "Activo";
    private string strInactivo = "Inactivo";


    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
        AplicarFiltros();
    }

    private async Task CargarUsuarios()
    {
        // En una aplicación real, esto vendría de una base de datos o API
        usuarios = new List<Usuario>
        {
            new Usuario { Id = 1, Nombre = "Juan Pérez", Email = "juan.perez@email.com",
                         Telefono = "+52 55 1234 5678", Rol = "Administrador",
                         Departamento = "101", Estado = "Activo", FechaIngreso = new DateTime(2023, 1, 14) },
            new Usuario { Id = 2, Nombre = "María García", Email = "maria.garcia@email.com",
                         Telefono = "+52 55 2345 6789", Rol = "Junta Directiva",
                         Departamento = "102", Estado = "Activo", FechaIngreso = new DateTime(2023, 2, 19) },
            new Usuario { Id = 3, Nombre = "Carlos López", Email = "carlos.lopez@email.com",
                         Telefono = "+52 55 3456 7890", Rol = "Residente",
                         Departamento = "201", Estado = "Activo", FechaIngreso = new DateTime(2023, 3, 9) },
            new Usuario { Id = 4, Nombre = "Ana Martínez", Email = "ana.martinez@email.com",
                         Telefono = "+52 55 4567 8901", Rol = "Junta Directiva",
                         Departamento = "202", Estado = "Activo", FechaIngreso = new DateTime(2023, 4, 4) },
            new Usuario { Id = 5, Nombre = "Roberto Silva", Email = "roberto.silva@email.com",
                         Telefono = "+52 55 5678 9012", Rol = "Residente",
                         Departamento = "301", Estado = "Activo", FechaIngreso = new DateTime(2023, 5, 11) },
            new Usuario { Id = 6, Nombre = "Laura Torres", Email = "laura.torres@gmail.com",
                         Telefono = "+52 55 6789 0123", Rol = "Residente",
                         Departamento = "302", Estado = "Inactivo", FechaIngreso = new DateTime(2023, 6, 17) }
        };
    }

    private void FiltrarPorRol(string rol)
    {
        rolSeleccionado = rol;
        AplicarFiltros();
    }

    private void FiltrarPorEstado(string? estado)
    {
        filtroEstado = estado;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        usuariosFiltrados = usuarios
            .Where(u => rolSeleccionado == "Todos" || u.Rol == rolSeleccionado)
            .Where(u => filtroEstado == null || u.Estado == filtroEstado)
            .ToList();
    }

    private int ObtenerCantidadPorRol(string rol)
    {
        return rol == "Todos" ? usuarios.Count : usuarios.Count(u => u.Rol == rol);
    }

    private string GetAvatarClass(Usuario usuario)
    {
        return usuario.Rol switch
        {
            "Administrador" => "avatar-admin",
            "Junta Directiva" => "avatar-junta",
            "Residente" => "avatar-residente",
            _ => "avatar-default"
        };
    }

    private string GetIniciales(string nombre)
    {
        var partes = nombre.Split(' ');
        if (partes.Length >= 2)
            return $"{partes[0][0]}{partes[1][0]}";
        return nombre.Length >= 2 ? nombre.Substring(0, 2).ToUpper() : nombre.ToUpper();
    }

    private string GetRolBadgeClass(string rol)
    {
        return rol switch
        {
            "Administrador" => "bg-primary",
            "Junta Directiva" => "bg-warning",
            "Residente" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private void MostrarModalNuevoUsuario()
    {
        usuarioActual = new Usuario();
        usuarioEditando = null;
        mostrarModalUsuario = true;
    }

    private void EditarUsuario(int id)
    {
        usuarioEditando = usuarios.FirstOrDefault(u => u.Id == id);
        usuarioActual = usuarioEditando?.Clone();
        mostrarModalUsuario = true;
    }

    private async Task GuardarUsuario(Usuario usuario)
    {
        if (usuarioEditando == null)
        {
            // Nuevo usuario
            usuario.Id = usuarios.Max(u => u.Id) + 1;
            usuarios.Add(usuario);
        }
        else
        {
            // Editar usuario existente
            var index = usuarios.FindIndex(u => u.Id == usuarioEditando.Id);
            if (index >= 0)
            {
                usuarios[index] = usuario;
            }
        }

        AplicarFiltros();
        CerrarModalUsuario();
        StateHasChanged();
    }

    private void CerrarModalUsuario()
    {
        mostrarModalUsuario = false;
        usuarioActual = null;
        usuarioEditando = null;
    }

    private async Task CambiarEstadoUsuario(int id)
    {
        var usuario = usuarios.FirstOrDefault(u => u.Id == id);
        if (usuario != null)
        {
            usuario.Estado = usuario.Estado == "Activo" ? "Inactivo" : "Activo";
            AplicarFiltros();
            StateHasChanged();
        }
    }

    private async Task EliminarUsuario(int id)
    {
        var usuario = usuarios.FirstOrDefault(u => u.Id == id);
        if (usuario != null)
        {
            // Confirmación antes de eliminar
            if (await jsRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro de eliminar al usuario {usuario.Nombre}?"))
            {
                usuarios.Remove(usuario);
                AplicarFiltros();
                StateHasChanged();
            }
        }
    }

    private async Task ExportarUsuarios()
    {
        // Lógica para exportar usuarios
        await jsRuntime.InvokeVoidAsync("alert", "Exportando usuarios...");
    }

    [Inject]
    private IJSRuntime jsRuntime { get; set; } = default!;
}