@using SpiderHood.Models

<div class="modal-backdrop show"></div>
<div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-user-plus me-2"></i>
                    Crear Cuenta
                </h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>

            <div class="modal-body">
                <div class="registration-steps">
                    <ul class="nav nav-pills nav-justified mb-4">
                        <li class="nav-item">
                            <button class="nav-link @(currentStep == 1 ? "active" : "")"
                                    @onclick="() => ChangeStep(1)"
                                    :disabled="currentStep > 1">
                                <i class="fas fa-user me-2"></i>Cuenta
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(currentStep == 2 ? "active" : "")"
                                    @onclick="() => ChangeStep(2)"
                                    :disabled="currentStep > 2">
                                <i class="fas fa-building me-2"></i>Edificio
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(currentStep == 3 ? "active" : "")"
                                    @onclick="() => ChangeStep(3)"
                                    :disabled="currentStep > 3">
                                <i class="fas fa-check-circle me-2"></i>Confirmar
                            </button>
                        </li>
                    </ul>

                    <!-- Paso 1: Información de Cuenta -->
                    @if (currentStep == 1)
                    {
                        <div class="step-content">
                            <h6 class="mb-4">Información Personal</h6>
                            <form @onsubmit="NextStep" @formname="step1Form">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Nombre *</label>
                                        <input type="text"
                                               class="form-control @(errors.ContainsKey("FirstName") ? "is-invalid" : "")"
                                               @bind="registrationModel.FirstName"
                                               @bind:event="oninput" />
                                        @if (errors.ContainsKey("FirstName"))
                                        {
                                            <div class="invalid-feedback d-block">
                                                @errors["FirstName"]
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Apellido *</label>
                                        <input type="text"
                                               class="form-control @(errors.ContainsKey("LastName") ? "is-invalid" : "")"
                                               @bind="registrationModel.LastName"
                                               @bind:event="oninput" />
                                        @if (errors.ContainsKey("LastName"))
                                        {
                                            <div class="invalid-feedback d-block">
                                                @errors["LastName"]
                                            </div>
                                        }
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Correo Electrónico *</label>
                                        <input type="email"
                                               class="form-control @(errors.ContainsKey("Email") ? "is-invalid" : "")"
                                               @bind="registrationModel.Email"
                                               @bind:event="oninput" />
                                        @if (errors.ContainsKey("Email"))
                                        {
                                            <div class="invalid-feedback d-block">
                                                @errors["Email"]
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Contraseña *</label>
                                        <div class="input-group">
                                            <input type="@(showPassword ? "text" : "password")"
                                                   class="form-control @(errors.ContainsKey("Password") ? "is-invalid" : "")"
                                                   @bind="registrationModel.Password"
                                                   @bind:event="oninput" />
                                            <button class="btn btn-outline-secondary"
                                                    type="button"
                                                    @onclick="TogglePasswordVisibility">
                                                <i class="fas @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                            </button>
                                        </div>
                                        @if (errors.ContainsKey("Password"))
                                        {
                                            <div class="invalid-feedback d-block">
                                                @errors["Password"]
                                            </div>
                                        }
                                        <small class="form-text text-muted">
                                            Mínimo 8 caracteres, incluir mayúsculas, minúsculas y números
                                        </small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Confirmar Contraseña *</label>
                                        <input type="password"
                                               class="form-control @(errors.ContainsKey("ConfirmPassword") ? "is-invalid" : "")"
                                               @bind="registrationModel.ConfirmPassword"
                                               @bind:event="oninput" />
                                        @if (errors.ContainsKey("ConfirmPassword"))
                                        {
                                            <div class="invalid-feedback d-block">
                                                @errors["ConfirmPassword"]
                                            </div>
                                        }
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Teléfono</label>
                                        <input type="tel"
                                               class="form-control"
                                               @bind="registrationModel.PhoneNumber"
                                               @bind:event="oninput" />
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input @(errors.ContainsKey("Terms") ? "is-invalid" : "")"
                                                   type="checkbox"
                                                   @bind="registrationModel.AcceptTerms" />
                                            <label class="form-check-label">
                                                Acepto los <a href="#" class="text-primary">Términos y Condiciones</a>
                                                y la <a href="#" class="text-primary">Política de Privacidad</a>
                                            </label>
                                            @if (errors.ContainsKey("Terms"))
                                            {
                                                <div class="invalid-feedback d-block">
                                                    @errors["Terms"]
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-4">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="CloseModal">
                                        Cancelar
                                    </button>
                                    <button type="submit"
                                            class="btn btn-primary"
                                            disabled="@isLoading">
                                        Siguiente <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    }

                    <!-- Paso 2: Información del Edificio -->
                    else if (currentStep == 2)
                    {
                    <div class="step-content">
                        <h6 class="mb-4">Información del Edificio</h6>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Como primer usuario, serás designado como <strong>Administrador</strong> del edificio.
                        </div>

                        <form @onsubmit="NextStep" @formname="step2Form">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Nombre del Edificio *</label>
                                    <input type="text"
                                           class="form-control @(errors.ContainsKey("BuildingName") ? "is-invalid" : "")"
                                           placeholder="Ej: Torres del Sol"
                                           @bind="registrationModel.BuildingName"
                                           @bind:event="oninput" />
                                    @if (errors.ContainsKey("BuildingName"))
                                    {
                                        <div class="invalid-feedback d-block">
                                            @errors["BuildingName"]
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Dirección *</label>
                                    <input type="text"
                                           class="form-control @(errors.ContainsKey("Address") ? "is-invalid" : "")"
                                           placeholder="Calle y número"
                                           @bind="registrationModel.Address"
                                           @bind:event="oninput" />
                                    @if (errors.ContainsKey("Address"))
                                    {
                                        <div class="invalid-feedback d-block">
                                            @errors["Address"]
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Ciudad *</label>
                                    <input type="text"
                                           class="form-control @(errors.ContainsKey("City") ? "is-invalid" : "")"
                                           @bind="registrationModel.City"
                                           @bind:event="oninput" />
                                    @if (errors.ContainsKey("City"))
                                    {
                                        <div class="invalid-feedback d-block">
                                            @errors["City"]
                                        </div>
                                    }
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Número de Departamentos</label>
                                    <input type="number"
                                           class="form-control"
                                           min="1"
                                           @bind="registrationModel.TotalApartments"
                                           @bind:event="oninput" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Pisos</label>
                                    <input type="number"
                                           class="form-control"
                                           min="1"
                                           @bind="registrationModel.Floors"
                                           @bind:event="oninput" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Año de Construcción</label>
                                    <input type="number"
                                           class="form-control"
                                           min="1900"
                                           max="@DateTime.Now.Year"
                                           @bind="registrationModel.ConstructionYear"
                                           @bind:event="oninput" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Tipo de Edificio</label>
                                    <select class="form-select" @bind="registrationModel.BuildingType">
                                        <option value="">Seleccionar...</option>
                                        <option value="Residencial">Residencial</option>
                                        <option value="Comercial">Comercial</option>
                                        <option value="Mixto">Mixto</option>
                                        <option value="Oficinas">Oficinas</option>
                                    </select>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Descripción (Opcional)</label>
                                    <textarea class="form-control"
                                              rows="3"
                                              placeholder="Información adicional sobre el edificio..."
                                              @bind="registrationModel.BuildingDescription"
                                              @bind:event="oninput"></textarea>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="PreviousStep">
                                    <i class="fas fa-arrow-left me-2"></i> Atrás
                                </button>
                                <button type="submit"
                                        class="btn btn-primary"
                                        disabled="@isLoading">
                                    Siguiente <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                    }

                    <!-- Paso 3: Confirmación -->
                    else if (currentStep == 3)
                    {
                    <div class="step-content">
                        <h6 class="mb-4">Confirmar Información</h6>

                        <div class="confirmation-summary">
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Información Personal</h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Nombre:</dt>
                                        <dd class="col-sm-8">@registrationModel.FirstName @registrationModel.LastName</dd>

                                        <dt class="col-sm-4">Email:</dt>
                                        <dd class="col-sm-8">@registrationModel.Email</dd>

                                        <dt class="col-sm-4">Teléfono:</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(registrationModel.PhoneNumber) ? "No especificado" : registrationModel.PhoneNumber)</dd>
                                    </dl>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Información del Edificio</h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Nombre:</dt>
                                        <dd class="col-sm-8">@registrationModel.BuildingName</dd>

                                        <dt class="col-sm-4">Dirección:</dt>
                                        <dd class="col-sm-8">@registrationModel.Address, @registrationModel.City</dd>

                                        <dt class="col-sm-4">Tipo:</dt>
                                        <dd class="col-sm-8">@(string.IsNullOrEmpty(registrationModel.BuildingType) ? "No especificado" : registrationModel.BuildingType)</dd>

                                        <dt class="col-sm-4">Departamentos:</dt>
                                        <dd class="col-sm-8">@registrationModel.TotalApartments</dd>

                                        <dt class="col-sm-4">Rol asignado:</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-success">Administrador</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Importante:</strong> Como administrador, tendrás control total sobre el edificio
                            y podrás gestionar los permisos de otros usuarios.
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="PreviousStep">
                                <i class="fas fa-arrow-left me-2"></i> Atrás
                            </button>
                            <button type="button"
                                    class="btn btn-success"
                                    @onclick="CompleteRegistration"
                                    disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                <i class="fas fa-check-circle me-2"></i>
                                Completar Registro
                            </button>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<RegistrationResult> OnRegistrationComplete { get; set; }

    private RegistrationModel registrationModel = new();
    private int currentStep = 1;
    private bool isLoading = false;
    private bool showPassword = false;
    private Dictionary<string, string> errors = new();

    private void CloseModal()
    {
        OnClose.InvokeAsync();
    }

    private void ChangeStep(int step)
    {
        currentStep = step;
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private void NextStep()
    {
        if (ValidateCurrentStep())
        {
            if (currentStep < 3)
            {
                currentStep++;
            }
        }
    }

    private bool ValidateCurrentStep()
    {
        errors.Clear();

        if (currentStep == 1)
        {
            // Validar información personal
            if (string.IsNullOrWhiteSpace(registrationModel.FirstName))
                errors["FirstName"] = "El nombre es requerido";

            if (string.IsNullOrWhiteSpace(registrationModel.LastName))
                errors["LastName"] = "El apellido es requerido";

            if (string.IsNullOrWhiteSpace(registrationModel.Email))
                errors["Email"] = "El correo electrónico es requerido";
            else if (!IsValidEmail(registrationModel.Email))
                errors["Email"] = "Ingresa un correo electrónico válido";

            if (string.IsNullOrWhiteSpace(registrationModel.Password))
                errors["Password"] = "La contraseña es requerida";
            else if (registrationModel.Password.Length < 8)
                errors["Password"] = "La contraseña debe tener al menos 8 caracteres";
            else if (!HasUpperCase(registrationModel.Password) || !HasLowerCase(registrationModel.Password) || !HasNumber(registrationModel.Password))
                errors["Password"] = "Debe incluir mayúsculas, minúsculas y números";

            if (registrationModel.Password != registrationModel.ConfirmPassword)
                errors["ConfirmPassword"] = "Las contraseñas no coinciden";

            if (!registrationModel.AcceptTerms)
                errors["Terms"] = "Debes aceptar los términos y condiciones";
        }
        else if (currentStep == 2)
        {
            // Validar información del edificio
            if (string.IsNullOrWhiteSpace(registrationModel.BuildingName))
                errors["BuildingName"] = "El nombre del edificio es requerido";

            if (string.IsNullOrWhiteSpace(registrationModel.Address))
                errors["Address"] = "La dirección es requerida";

            if (string.IsNullOrWhiteSpace(registrationModel.City))
                errors["City"] = "La ciudad es requerida";

            if (registrationModel.TotalApartments <= 0)
                registrationModel.TotalApartments = 1;

            if (registrationModel.Floors <= 0)
                registrationModel.Floors = 1;
        }

        return !errors.Any();
    }

    private async Task CompleteRegistration()
    {
        isLoading = true;

        try
        {
            // Aquí iría la lógica para registrar al usuario y el edificio
            // Simulación de registro exitoso

            await Task.Delay(1000); // Simular llamada API

            var result = new RegistrationResult
            {
                Success = true,
                Message = "Registro completado exitosamente",
                Email = registrationModel.Email,
                Password = registrationModel.Password,
                BuildingName = registrationModel.BuildingName
            };

            await OnRegistrationComplete.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            errors["General"] = $"Error al registrar: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private bool HasUpperCase(string str) => str.Any(char.IsUpper);
    private bool HasLowerCase(string str) => str.Any(char.IsLower);
    private bool HasNumber(string str) => str.Any(char.IsDigit);
}