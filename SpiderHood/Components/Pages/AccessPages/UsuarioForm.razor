@using SpiderHood.Models

<EditForm Model="@Model" OnValidSubmit="@Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="row g-3">
        <div class="col-md-6">
            <label for="firstName" class="form-label">Nombre *</label>
            <InputText id="firstName" class="form-control" @bind-Value="Model.FirstName" />
            <ValidationMessage For="@(() => Model.FirstName)" />
        </div>

        <div class="col-md-6">
            <label for="lastName" class="form-label">Apellido *</label>
            <InputText id="lastName" class="form-control" @bind-Value="Model.LastName" />
            <ValidationMessage For="@(() => Model.LastName)" />
        </div>

        <div class="col-md-6">
            <label for="email" class="form-label">Correo Electrónico *</label>
            <InputText id="email" class="form-control" @bind-Value="Model.Email" disabled="@Model.IsEdit" />
            <ValidationMessage For="@(() => Model.Email)" />
            @if (Model.IsEdit)
            {
                <small class="text-muted">El email no se puede modificar.</small>
            }
        </div>

        <div class="col-md-6">
            <label for="telefono" class="form-label">Teléfono</label>
            <InputText id="telefono" class="form-control" @bind-Value="Model.PhoneNumber" />
        </div>

        <div class="col-md-6">
            <label for="rol" class="form-label">Rol</label>
            <select class="form-select" id="rol" @bind="RolSeleccionado">
                <option value="">Sin rol asignado</option>
                @foreach (var rol in AvailableRoles)
                {
                    <option value="@rol.IdRole">@rol.RoleName</option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label for="estado" class="form-label">Estado</label>
            <select class="form-select" id="estado" @bind="EstadoSeleccionado">
                <option value="true">Activo</option>
                <option value="false">Inactivo</option>
            </select>
        </div>

        <div class="col-md-6">
            <label for="password" class="form-label">
                Contraseña @(Model.IsEdit ? "" : "*")
            </label>
            <div class="input-group">
                <input type="@(mostrarPassword ? "text" : "password")" class="form-control" id="password"
                       @bind="Model.Password"
                       @bind:event="oninput" />
                <button class="btn btn-outline-secondary" type="button"
                        @onclick="TogglePasswordVisibility">
                    <i class="fas @(mostrarPassword ? "fa-eye-slash" : "fa-eye")"></i>
                </button>
            </div>
            @if (Model.IsEdit)
            {
                <small class="text-muted">Dejar en blanco para no editar el usuario.</small>
            }
            @if (!string.IsNullOrEmpty(_passwordError))
            {
                <div class="text-danger small">@_passwordError</div>
            }
        </div>

        <div class="col-12 mt-4">
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public UsuarioFormModel Model { get; set; } = new();

    [Parameter]
    public List<Role> AvailableRoles { get; set; } = new();

    [Parameter]
    public EventCallback<UsuarioFormModel> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool mostrarPassword = false;
    private string? _passwordError;

    private string RolSeleccionado
    {
        get => Model.IdRole?.ToString() ?? string.Empty;
        set => Model.IdRole = string.IsNullOrEmpty(value) ? null : Guid.Parse(value);
    }

    private string EstadoSeleccionado
    {
        get => Model.IsActive.ToString();
        set => Model.IsActive = bool.Parse(value);
    }

    private void Guardar()
    {
        _passwordError = null;

        if (!Model.IsEdit && string.IsNullOrWhiteSpace(Model.Password))
        {
            _passwordError = "La contraseña es obligatoria para un usuario nuevo";
            return;
        }

        OnSave.InvokeAsync(Model);
    }

    private void TogglePasswordVisibility()
    {
        mostrarPassword = !mostrarPassword;
    }
}
