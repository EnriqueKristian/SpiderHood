@page "/budgetgenerator/"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using SpiderHood.Components.Pages.Components
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@inject IExpenseService ExpenseService
@inject SpiderHood.Services.IExceptionService _exceptionService

<link href="/budget.css" rel="stylesheet" />

<div class="expense-calculation">
    <!-- Header -->
    <BudgetHeaderComponent _budgetState="_BudgetState"
                           OnNewCalculation="ShowNewCalculationModal"
                           OnLoadTemplate="LoadSampleData"
                           OnSave="SaveCalculation"
                           OnGenerateReport="GenerateReport"
                           OnServiceReading="ShowServiceReadingModal" />

    <div class="row">
        <!-- Expenses Table -->
        <div class="@(showorNot ? "col-md-8" : "col-md-11") transition-all">
            <div class="card card-hover">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@_textCabecera</h5>
                    <div style="width:20%"></div>

                    @if (_BudgetState.Budget.IdBudgetHeader != Guid.Empty)
                    {
                        <div class="d-flex gap-2">
                            @if (_BudgetState.AddNewSection)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="AddNewSection">
                                    <i class="bi bi-plus-lg me-1"></i>Nueva Sección
                                </button>
                            }
                            @if (_BudgetState.PublishBudget())
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="PublishBudget">
                                    <i class="@_icon"></i>&nbsp@_msjButtonWorflow
                                </button>
                            }
                            @if (_Status == BudgetStatus.Check)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="RejectBudget">
                                    <i class="fa-solid fa-ban"></i>&nbspRechazar
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="card-body">
                    @if (_BudgetState.Budget.Details.Any())
                    {
                        <div class="table-responsive">
                            <table class="expense-table">
                                <thead>
                                    <tr>
                                        <th style="width: 5%">Item</th>
                                        <th style="width: 28%">Descripción</th>
                                        <th style="width: 15%">Costo Mensual</th>
                                        <th style="width: 15%">Costo Anual</th>
                                        <th style="width: 15%">Frecuencia</th>
                                        <th style="width: 12%">Tipo</th>
                                        <th style="width: 10%">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var section in GetSections())
                                    {
                                        var sectionItems = _BudgetState.Budget.Details.Where(x => x.IdSection == section.Id).ToList();
                                        var hasItems = sectionItems.Any(x => !x.IsHeader);

                                        <!-- Section Header -->
                                        <tr class="section-header-row">
                                            <td colspan="7">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <strong>@GetSectionName(section.Id)</strong>
                                                    @if (_BudgetState.AddNewSection)
                                                    {
                                                        var _disable = !_BudgetState.AddNewSection;
                                                        <button class="btn btn-sm btn-outline-primary add-item-btn" disabled="@_disable"
                                                                @onclick="() => AddExpenseItemToSection(section.Id)">
                                                            <i class="bi bi-plus me-1"></i>Agregar Item
                                                        </button>
                                                    }

                                                </div>
                                            </td>
                                        </tr>

                                        @if (!hasItems)
                                        {
                                            <tr>
                                                <td colspan="7">
                                                    <div class="empty-section">
                                                        No hay items en esta sección
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in sectionItems.Where(x => !x.IsHeader))
                                            {
                                                <tr>
                                                    <td>
                                                        <span>@item.ItemNumber</span>
                                                    </td>
                                                    <td>
                                                        <InputText @bind-Value="item.Description" readonly="@_BudgetState.IsReadOnly"
                                                                   class="form-control form-control-sm"
                                                                   @onchange="CalculateTotals" />
                                                    </td>
                                                    <td>
                                                        <div class="currency-input">
                                                            <span class="currency-symbol" style="font-size:0.6em">S/</span>
                                                            <input @bind="item.MonthlyAmount" readonly="@_BudgetState.IsReadOnly"
                                                                   class="form-control form-control-sm"
                                                                   step="0.01"
                                                                   style="justify-items:right"
                                                                   @bind:event="onchange"
                                                                   @bind:after="() => CalculateTotals()" />
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="currency-input">
                                                            <span class="currency-symbol" style="font-size:0.6em">S/</span>
                                                            <InputNumber @bind-Value="item.AnnualAmount"
                                                                         class="form-control form-control-sm"
                                                                         step="0.01" readonly
                                                                         style="justify-items:right" />
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <select @bind="item.Frequency" disabled="@_BudgetState.IsReadOnly"
                                                                @bind:event="onchange"
                                                                @bind:after="() => UpdateFrequency(item)"
                                                                class="form-select form-select-sm">
                                                            <!--    PARAMETRO PADRE    -->
                                                            @foreach (var frec in filteredParameters.Where(c => c.IdParent == 38))
                                                            {
                                                                <option value="@frec.Value">@frec.ShortDescription</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select @bind="item.Type" @bind:event="onchange" disabled="@_BudgetState.IsReadOnly"
                                                                @bind:after="() => CalculateTotals()"
                                                                class="form-select form-select-sm">
                                                            @foreach (var frec in filteredParameters.Where(c => c.IdParent == 8))
                                                            {
                                                                <option value="@int.Parse(frec.Value.ToString())">@frec.ShortDescription</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm" role="group">
                                                            @{
                                                                var _RemoveExpenseItem = !_BudgetState.AddNewSection;
                                                            }
                                                            <button class="btn btn-outline-danger" disabled="@_RemoveExpenseItem"
                                                                    @onclick="() => RemoveExpenseItem(item.IdBudgetDetail)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }

                                            <!-- Section Total -->
                                            var sectionTotal = GetSectionTotal(section.Id);
                                            <tr class="section-total">
                                                <td colspan="2">
                                                    <strong>Total @GetSectionName(section.Id).Substring(0, Math.Min(GetSectionName(section.Id).Length, 26))</strong>
                                                </td>
                                                <td align="right"><strong><span class="currency-symbol" style="font-size:0.7em">S/</span> @sectionTotal.Monthly.ToString("N2")</strong></td>
                                                <td align="right"><strong><label style="font-size:0.8em">S/&nbsp;</label>@sectionTotal.Annual.ToString("N2")</strong></td>
                                                <td></td>
                                                <td></td>
                                                <td>
                                                    @{
                                                        var _RemoveSection = !_BudgetState.AddNewSection;
                                                    }
                                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_RemoveSection"
                                                            @onclick="() => RemoveSection(section.Id)"
                                                            title="Eliminar sección">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }

                                    <!-- Grand Total -->
                                    <tr class="grand-total">
                                        <td colspan="2">
                                            <strong>TOTAL MENSUAL PRESUPUESTADO</strong>
                                        </td>
                                        <td><strong>S/ @_BudgetState.TotalMonthly.ToString("N2")</strong></td>
                                        <td><strong>S/ @_BudgetState.TotalAnnual.ToString("N2")</strong></td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Calculation Formula -->
                        <!--<div class="mt-4">
                            <h6 class="mb-2">Fórmula de Cálculo:</h6>
                            <div class="calculation-formula">
                                Cuota por Departamento = (Total Mensual / N° de Departamentos)
                                <br />
                                <strong>S/ @_BudgetState.TotalMonthly.ToString("N2") / @_BudgetState.TotalApartments = S/ @_BudgetState.QuotaPerApartment.ToString("N2")</strong>
                            </div>
                        </div>-->
                    }
                    else
                    {
                        <div class="no-data">
                            <i class="bi bi-calculator"></i>
                            <h4 class="mb-2">No se ha creado aun el Presupuesto</h4>
                            <p class="text-muted mb-3">Comienza agregando una sección o cargando la Plantilla</p>
                            @if (_BudgetState.Budget.IdBudgetHeader != Guid.Empty)
                            {
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-primary" style="border-radius: 40px;" @onclick="LoadSampleData">
                                        <i class="bi bi-upload me-2"></i>Cargar Plantilla
                                    </button>
                                    <button class="btn btn-outline-primary" style="border-radius: 40px;" @onclick="AddNewSection">
                                        <i class="bi bi-plus-lg me-2"></i>Crear Primera Sección
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span>Primero debe Crear el Presupuesto</span>
                                <p />
                                <button class="btn btn-primary btn-lg" style="border-radius: 50px;" @onclick="ShowNewCalculationModal">
                                    <i class="bi bi-plus-circle me-2"></i>Nuevo Cálculo
                                </button>
                            }

                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Configuration and Distribution -->
        <InformatioPanelComponent TotalMonthly="_BudgetState.TotalMonthly"
                                  QuotaPerApartment="_BudgetState.QuotaPerApartment"
                                  TotalInstallments="_BudgetState.TotalInstallments"
                                  OccupiedApartments="_BudgetState.OccupiedApartments"
                                  TotalApartments="_BudgetState.TotalApartments"
                                  showorNot="@showorNot"
                                  class2="@class2"
                                  class5="@class5"
                                  OnCopyToClipboard="CopyToClipboard"
                                  OnClearAllData="ClearAllData"
                                  SectionTotals="GetSectionTotals()"
                                  OnShoworNot="ShoworNot" />

    </div>
</div>

<!-- Modal for New Calculation -->
<Modal @ref="_newCalcModal"
       Title="Nuevo Cálculo de Gastos"
       Size="ModalSize.Regular"
       ShowCloseButton="false">
    <!-- Cambiado a false -->

    <BodyTemplate>
        <EditForm Model="_newCalculation" OnValidSubmit="CreateNewCalculation">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Periodo *</label>
                        <select class="form-select"
                                @bind="_selectedPeriod"
                                @bind:event="onchange"
                                @bind:after="() => OnSelectedCalculationChanged()">
                            @foreach (var item in _periods.Where(c => c.StartDate > _ultimoPeriodo))
                            {
                                <option value="@item.StartDate">@item.StartDate.ToString("MMM-yy")</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => _newCalculation.Month)" />
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label class="form-label">Descripción</label>
                        <textarea @bind="_newCalculation.Description"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Plantilla Base</label>
                        <select @bind-Value="_newCalculation.Template"
                                @bind-Value:event="oninput"
                                class="form-select">
                            <option value="">Sin plantilla</option>
                            <option value="basic">Plantilla Básica</option>
                            <option value="complete">Plantilla Completa</option>
                            <option value="previous">Copiar mes anterior</option>
                        </select>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="CreateNewCalculation">
            <i class="bi bi-check me-1"></i>Crear
        </button>
        <button class="btn btn-secondary" @onclick="() => _newCalcModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal for New Section -->
<Modal @ref="_newSectionModal" Title="Nueva Sección" Size="ModalSize.Regular">
    <BodyTemplate>
        <EditForm Model="_newSection" OnValidSubmit="AddNewSectionFromModal">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Categorías disponibles -->
            <div class="mb-3">
                <label class="form-label"><strong>Categorías Disponibles</strong></label>

                <div class="list-group mb-3">
                    @foreach (var categoria in _Categories)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                @onclick="() => SeleccionarCategoria(categoria)">
                            @categoria.Description
                        </button>
                    }
                </div>
            </div>

            @if (_Categories.Count == 0)
            {
                <div class="form-group mb-3">
                    <label class="form-label"><strong>Nombre de la Sección *</strong></label>
                    <InputText @bind-Value="_newSection.Name" class="form-control" />
                    <ValidationMessage For="@(() => _newSection.Name)" />
                </div>
            }

            <div class="form-group mb-3">
                <label class="form-label"><strong>Posición</strong></label>
                <select @bind-Value="_newSection.Position" @bind-Value:event="oninput" class="form-select">
                    <option value="last">Al final</option>
                    @foreach (var section in GetSections())
                    {
                        <option value="section.Id">Después de: @GetSectionName(section.Id)</option>
                    }
                </select>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="AddNewSectionFromModal">
            <i class="bi bi-check me-1"></i>Agregar
        </button>
        <button class="btn btn-secondary" @onclick="() => _newSectionModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<ServiceReadingModal ShowModal="@ShowModalServiceRegistration" _period="_BudgetState.Budget.BudgetDate" ShowModalChanged="LoadServiceCalculation" OnSaveReading="LoadTotalConsumtion" />

<p></p>

@if (_BudgetState.IsWaterReadingReady && _BudgetState.Status > BudgetStatus.Created)
{
    <InstallmentTable Installments="@_BudgetState.Installments"
                      Budget="@_BudgetState.Budget"
                      WaterReadings="@_BudgetState.WaterReadings"
                      TotalBudget="_BudgetState.TotalMonthly"
                      Exonerations="@_BudgetState.Exonerations" />
}

<!-- Agregar al final del componente -->
<ConfirmationModal @ref="_confirmationModal"
                   OnClose="OnConfirmationResult" />

@code {

    [Inject] private IBudgetService presupuestoService { get; set; } = null!;
    [Inject] private IInstallmentService InstallmentService { get; set; } = default!;
    [Inject] private IServiceReadingService ServiceReadingService { get; set; } = default!;
    [Inject] private ICategoryService CategoryService { get; set; } = default!;

    private BudgetStatus _Status = BudgetStatus.Created;

    private NewCalculation _newCalculation = new();
    private NewSection _newSection = new();
    private Modal _newCalcModal = null!;
    private Modal _newSectionModal = null!;
    private bool ShowModalServiceRegistration = false;

    private ConfirmationModal? _confirmationModal;
    private ConfirmationUtil util = new ConfirmationUtil();

    //private string class1 = "card card-hover mb-4";
    private string class2 = "card card-hover";
    private string class5 = "bi bi-arrow-bar-right";
    private bool showorNot = true;
    private string _msjButtonWorflow = "Sol. Aprob.";
    private string _icon = "fa-solid fa-list-check";
    private string _textCabecera = "Detalle de Gastos - ";

    private List<SelectListItem> _availableMonths = new();
    private List<Models.Parameter> filteredParameters = new();
    private List<Category> filteredCategories = new();
    private List<Category> _Categories = new();

    private List<Period> _periods = new();
    private Period _currentPeriod = new();
    private DateTime _ultimoPeriodo;
    private DateTime _selectedPeriod;

    private BudgetState _BudgetState = new();

    private BudgetStatus ValidateParameter(BudgetStatus value)
    {
        switch (value)
        {
            case BudgetStatus.Created or BudgetStatus.Rejected:
                break;
            case BudgetStatus.Check:
                SetWorkflowState("Aprobar", "fa-solid fa-file", true);
                break;
            case BudgetStatus.Approved:
                SetWorkflowState("Publicar", "fa-solid fa-upload", true);
                break;
            case BudgetStatus.Active:
                SetWorkflowState("Cerrar", "fa-solid fa-folder-closed", true);
                break;
            case BudgetStatus.Closed:
                SetWorkflowState("Cerrado", "fa-solid fa-lock", true);
                break;
            case BudgetStatus.All:
                value = BudgetStatus.Created;
                break;
        }
        return value;
    }

    private void SetWorkflowState(string message, string icon, bool isReadonly)
    {
        _msjButtonWorflow = message;
        _icon = icon;
    }

    protected override async Task OnInitializedAsync()
    {
        // ParameterService.CurrentBuilding se asigna en HeaderMainLayout.OnAfterRenderAsync,
        // que corre DESPUÉS de este OnInitializedAsync en el primer render del circuito
        // (mismo problema que tenía Index.razor / la lista de presupuestos: sin esperar,
        // esta página se quedaba sin inicializar nada — sin periodos, sin categorías, sin
        // BudgetState — la primera vez que se entraba tras el login).
        var attempts = 0;
        while (ParameterService.CurrentBuilding == null && attempts < 20)
        {
            await Task.Delay(150);
            attempts++;
        }

        if (ParameterService.CurrentBuilding == null)
            return;

        //Obtiene el presupuesto de la pagina de lista de presupuestos
        _Status = ValidateParameter(presupuestoService._SelectedBudget.Status);

        await Task.WhenAll(
            LoadDataDefault(),
            ShoworNot()
        );

        presupuestoService._SelectedBudget.IdBuilding = ParameterService.CurrentBuilding.IdBuilding;

        _BudgetState = await presupuestoService.InitializeBudgetStateAsync(presupuestoService._SelectedBudget!);
        _BudgetState.TotalArea = ParameterService.CurrentBuilding.TotalArea;
        _BudgetState.Configuration = ParameterService.CurrentBuilding.Configuration;


        if (_BudgetState.IsNewBudget)
            await ShowNewCalculationModal();
        else
        {
            _textCabecera = _BudgetState.Budget.BudgetName;
            //Cargar Lectura de Agua
            _BudgetState.WaterReadings = await ServiceReadingService.GetServiceReadingDetailbyPeriodAsync(_BudgetState.Budget.BudgetDate);
            bool isActiveOrClosed = _BudgetState.Status == BudgetStatus.Active || _BudgetState.Status == BudgetStatus.Closed;

            _BudgetState.Exonerations = isActiveOrClosed
                ? await presupuestoService.GetExonerationByBudgetHeaderAsync(_BudgetState.Budget.IdBudgetHeader)
                : await presupuestoService.GetExonerationsByBuildingAsync(_BudgetState.Budget.IdBuilding);

            _BudgetState.Installments = await InstallmentService.GetInstallmentsByBudgetAsync(_BudgetState.Budget.IdBudgetHeader);
            _BudgetState.CalculateTotals();
        }
    }

    /*  SECCION LOAD DATA   */

    private async Task LoadSampleData()
    {
        await presupuestoService.LoadDefaultBudgetDetailsAsync(_BudgetState);
        //await CalculateTotals();
    }

    private async Task LoadDataDefault()
    {
        // Cargar periodos desde BD
        _periods = await ParameterService.GetPeriodsAsync(ParameterService.CurrentBuilding.IdBuilding);
        //Cargar Categoria
        filteredCategories = await CategoryService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding);
        //Caargar lista de Parametros
        filteredParameters = @ParameterService.ListParameters.ToList();
        //Cargar Meses por Culura
        _availableMonths = await ParameterService.GetMonthList("es-PE");
    }

    /*  SECCION CALCULOS   */
    #region CALCULOS

    private async Task CalculateTotals()
    {
        _BudgetState.CalculateTotals();
        StateHasChanged();
    }

    private decimal GetAnnualMultiplier(int frequency)
    {
        return frequency switch
        {
            1 => 12,  // Anual
            2 => 6,   // Semestral
            3 => 4,   // Trimestral
            4 => 3,   // Cuatrimestral
            _ => 1    // Mensual u otros
        };
    }

    private async Task CalculateQuota()
    {
        _BudgetState.CalculateQuota();
        StateHasChanged();
    }

    private void UpdateFrequency(BudgetDetail item)
    {
        var annualMultiplier = GetAnnualMultiplier(item.Frequency);
        item.AnnualAmount = item.MonthlyAmount * annualMultiplier;

        _ = CalculateTotals();
    }
    #endregion

    /*  SECCION MANAGE SECTIONS   */
    #region SECCION MANAGE SECTIONS

    private string GetMonthName(int monthNumber) =>
     _availableMonths?.FirstOrDefault(m => m.Value == monthNumber.ToString())?.Text
     ?? "Mes Desconocido";

    private string GetSectionName(int sectionId) =>
        _BudgetState.Budget.Details.FirstOrDefault(x => x.IdSection == sectionId && x.IsHeader)?.Description
        ?? $"Sección {sectionId}";

    private List<SectionInfo> GetSections() =>
        _BudgetState.Budget.Details
            .Where(x => x.IsHeader)
            .Select(x => new SectionInfo
            {
                Id = x.IdSection,
                Name = x.Description,
                IdCategory = x.IdCategory
            })
            .OrderBy(x => x.Id)
            .ToList();

    private bool IsLastItemInSection(Guid itemId, int sectionId)
    {
        var sectionItems = _BudgetState.Budget.Details
            .Where(x => x.IdSection == sectionId && !x.IsHeader)
            .ToList();

        return sectionItems.LastOrDefault()?.IdBudgetDetail == itemId;
    }

    private (decimal Monthly, decimal Annual) GetSectionTotal(int sectionId)
    {
        var sectionItems = _BudgetState.Budget.Details.Where(x => x.IdSection == sectionId && !x.IsHeader).ToList();
        return (
            Monthly: sectionItems.Sum(x => x.MonthlyAmount),
            Annual: sectionItems.Sum(x => x.AnnualAmount)
        );
    }

    private List<SectionTotal> GetSectionTotals()
    {
        var sections = new List<SectionTotal>();

        foreach (var section in GetSections())
        {
            var total = GetSectionTotal(section.Id);
            if (total.Monthly > 0 || total.Annual > 0)
            {
                sections.Add(new SectionTotal
                {
                    Id = section.Id,
                    Name = GetSectionName(section.Id),
                    Monthly = total.Monthly,
                    Annual = total.Annual
                });
            }
        }
        return sections;
    }

    private void AddExpenseItemToSection(int sectionId)
    {
        var sectionItems = _BudgetState.Budget.Details.Where(x => x.IdSection == sectionId && !x.IsHeader).ToList();
        var lastItemNumber = sectionItems.Any()
            ? sectionItems.Max(x => x.ItemNumber)
            : Math.Floor(GetNextSectionItemNumber(sectionId));

        var newItem = new BudgetDetail
        {
            IdBudgetDetail = Guid.NewGuid(),
            IdSection = sectionId,
            IdCategory = Guid.NewGuid(),
            ItemNumber = lastItemNumber + 0.01m,
            Description = "Nuevo Item",
            MonthlyAmount = 0,
            AnnualAmount = 0,
            Frequency = 1,
            Type = 1,
            IsNewItem = true,
            IdBudgetHeader = _BudgetState.Budget.IdBudgetHeader
        };

        // Insertar después del último item de la sección
        var lastItemIndex = _BudgetState.Budget.Details.FindLastIndex(x => x.IdSection == sectionId && !x.IsHeader);
        if (lastItemIndex >= 0)
        {
            _BudgetState.Budget.Details.Insert(lastItemIndex + 1, newItem);
        }
        else
        {
            // Si no hay items en la sección, insertar después del header
            var headerIndex = _BudgetState.Budget.Details.FindIndex(x => x.IdSection == sectionId && x.IsHeader);
            if (headerIndex >= 0)
            {
                _BudgetState.Budget.Details.Insert(headerIndex + 1, newItem);
            }
            else
            {
                _BudgetState.Budget.Details.Add(newItem);
            }
        }

        _ = CalculateTotals();
    }

    private void AddExpenseItemToFirstSection()
    {
        var firstSection = GetSections().FirstOrDefault();
        if (firstSection != null)
        {
            AddExpenseItemToSection(firstSection.Id);
        }
        else
        {
            // Si no hay secciones, crear una primero
            _ = AddNewSection();
        }
    }

    private async Task AddNewSection()
    {
        //Filtrar Categorias de Nivel 0
        var existingSections = GetSections();

        _Categories = filteredCategories
