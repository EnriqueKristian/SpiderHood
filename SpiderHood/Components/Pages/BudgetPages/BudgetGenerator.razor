    private async Task PublishBudget(MouseEventArgs args)
    {
        UpdateBudgetStatus();
        _BudgetState.Status = _Status;
        await SaveCalculation();
        StateHasChanged();
    }

    private void UpdateBudgetStatus()
    {
        switch (_Status)
        {
            case BudgetStatus.Created or BudgetStatus.Rejected:
                _Status = BudgetStatus.Check;
                SetWorkflowState("Aprobar", "fa-solid fa-file", true);
                break;
            case BudgetStatus.Check:
                _Status = BudgetStatus.Approved;
                SetWorkflowState("Publicar", "fa-solid fa-upload", true);
                break;
            case BudgetStatus.Approved:
                _Status = BudgetStatus.Active;
                SetWorkflowState("Cerrar", "fa-solid fa-folder-closed", true);
                break;
            case BudgetStatus.Active:
                _Status = BudgetStatus.Closed;
                SetWorkflowState("Cerrado", "fa-solid fa-lock", true);
                break;
        }
    }

    private async Task RejectBudget(MouseEventArgs args)
    {
        SetWorkflowState("Sol. Aprob.", "fa-solid fa-list-check", false);
        _Status = BudgetStatus.Created;

        _BudgetState.Status = _Status;
        await SaveCalculation();
        StateHasChanged();
    }
