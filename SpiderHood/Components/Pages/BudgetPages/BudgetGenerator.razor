    private async Task AddNewSectionFromModal1()
    {
        bool isNewCategory = false;

        if (string.IsNullOrWhiteSpace(_newSection.Name))
            return;

        // Determinar el ID de la nueva sección
        var existingSections = GetSections();
        var newSectionId = existingSections.Any()
            ? existingSections.Max(x => x.Id) + 1
            : 1;

        //Obtener el IdCategory correspondiente
        var newCategoryId = filteredCategories
            .FirstOrDefault(c => c.Description == _newSection.Name)?.IdCategory ?? Guid.NewGuid();


        //Verificar si la categoría ya existe
        if (filteredCategories.Where(c => c.Description == _newSection.Name).Count() == 0)
        {
            //Crear nueva categoria
            isNewCategory = true;
        }

        // Crear el header de la sección
        var sectionHeader = new BudgetDetail
        {
            IdBudgetDetail = Guid.NewGuid(),
            IdSection = newSectionId,
            ItemNumber = newSectionId,
            IdCategory = newCategoryId,
            Description = _newSection.Name.ToUpper(),
            IsHeader = true,
            IsNewItem = isNewCategory,
            IdBudgetHeader = _BudgetState.Budget.IdBudgetHeader
        };


        // Determinar dónde insertar la sección
        if (_newSection.Position == "last" || !int.TryParse(_newSection.Position, out int afterSectionId))
        {
            _BudgetState.Budget.Details.Add(sectionHeader);
        }
        else
        {
            // Insertar después de la sección especificada
            var sectionIndex = _BudgetState.Budget.Details.FindLastIndex(x => x.IdSection == afterSectionId);
            if (sectionIndex >= 0)
            {
                _BudgetState.Budget.Details.Insert(sectionIndex + 1, sectionHeader);
            }
            else
            {
                _BudgetState.Budget.Details.Add(sectionHeader);
            }
        }

        if (!isNewCategory)
        {
            //Obtener el IdCategory correspondiente
            int oldIdSection = _BudgetState.ListDefault
            .FirstOrDefault(c => c.Description == _newSection.Name)?.IdSection ?? 1;

            decimal SequentialNumber = (decimal)oldIdSection + 0.01m;

            foreach (var newItem in _BudgetState.ListDefault.Where(c => c.IdSection == oldIdSection && !c.IsHeader))
            {
                BudgetDetail detail = new BudgetDetail();
                detail.IdBudgetDetail = newItem.IdBudgetDetail;
                detail.IdCategory = newItem.IdCategory;
                detail.IdSection = newSectionId;
                detail.ItemNumber = SequentialNumber ;
                detail.Description = newItem.Description;
                detail.MonthlyAmount = newItem.MonthlyAmount == 0
                          ? _BudgetState.ExpensesList.Where(c => c.IdCategory == newItem.IdCategory).Sum(x => x.Amount)
                          : newItem.MonthlyAmount;
                detail.AnnualAmount = newItem.AnnualAmount;
                detail.Frequency = newItem.Frequency;
                detail.Type = newItem.Type;
                detail.IsHeader = newItem.IsHeader;
                detail.IdBudgetHeader = _BudgetState.Budget.IdBudgetHeader;

                _BudgetState.Budget.Details.Add(detail);
                SequentialNumber = SequentialNumber + 0.01m;

            }
        }

        await _newSectionModal.HideAsync();
        StateHasChanged();
    }

    private async Task AddNewSectionFromModal()
    {
        if (string.IsNullOrWhiteSpace(_newSection.Name))
            return;

        var existingSections = GetSections();
        var newSectionId = existingSections.Any()
            ? existingSections.Max(x => x.Id) + 1
            : 1;

        var existingCategory = filteredCategories
            .FirstOrDefault(c => c.Description == _newSection.Name);

        var isNewCategory = existingCategory == null;
        var categoryId = existingCategory?.IdCategory ?? Guid.NewGuid();

        var sectionHeader = CreateSectionHeader(newSectionId, categoryId, isNewCategory);
        InsertSectionInPosition(sectionHeader);

        if (!isNewCategory)
        {
            await AddTemplateItemsToSection(newSectionId, existingCategory!.IdCategory);
        }

        await _newSectionModal.HideAsync();
        StateHasChanged();
    }

    private BudgetDetail CreateSectionHeader(int sectionId, Guid categoryId, bool isNew)
    {
        return new BudgetDetail
        {
            IdBudgetDetail = Guid.NewGuid(),
            IdSection = sectionId,
            ItemNumber = sectionId,
            IdCategory = categoryId,
            Description = _newSection.Name.ToUpper(),
            IsHeader = true,
            IsNewItem = isNew,
            IdBudgetHeader = _BudgetState.Budget.IdBudgetHeader
        };
    }

    private void InsertSectionInPosition(BudgetDetail sectionHeader)
    {
        if (_newSection.Position == "last" || !int.TryParse(_newSection.Position, out int afterSectionId))
        {
            _BudgetState.Budget.Details.Add(sectionHeader);
            return;
        }

        var sectionIndex = _BudgetState.Budget.Details.FindLastIndex(x => x.IdSection == afterSectionId);
        _BudgetState.Budget.Details.Insert(sectionIndex >= 0 ? sectionIndex + 1 : _BudgetState.Budget.Details.Count, sectionHeader);
    }

    private async Task AddTemplateItemsToSection(int newSectionId, Guid categoryId)
    {
        var oldIdSection = _BudgetState.ListDefault
            .FirstOrDefault(c => c.IdCategory == categoryId)?.IdSection ?? 1;

        var sequentialNumber = (decimal)newSectionId + 0.01m;
        var templateItems = _BudgetState.ListDefault
            .Where(c => c.IdSection == oldIdSection && !c.IsHeader);

        foreach (var templateItem in templateItems)
        {
            var categoryAmount = _BudgetState.ExpensesList
                .Where(c => c.IdCategory == templateItem.IdCategory)
                .Sum(x => x.Amount);

            var detail = new BudgetDetail
            {
                IdBudgetDetail = templateItem.IdBudgetDetail,
                IdCategory = templateItem.IdCategory,
                IdSection = newSectionId,
                ItemNumber = sequentialNumber,
                Description = templateItem.Description,
                MonthlyAmount = templateItem.MonthlyAmount == 0 ? categoryAmount : templateItem.MonthlyAmount,
                AnnualAmount = templateItem.AnnualAmount,
                Frequency = templateItem.Frequency,
                Type = templateItem.Type,
                IsHeader = templateItem.IsHeader,
                IdBudgetHeader = _BudgetState.Budget.IdBudgetHeader
            };

            _BudgetState.Budget.Details.Add(detail);
            sequentialNumber += 0.01m;
        }
    }

    private void RemoveExpenseItem(Guid id)
    {
        var item = _BudgetState.Budget.Details.FirstOrDefault(x => x.IdBudgetDetail == id);
