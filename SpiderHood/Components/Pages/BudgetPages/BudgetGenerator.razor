    private decimal GetAnnualMultiplier(int frequency)
    {
        return frequency switch
        {
            1 => 12,  // Anual
            2 => 6,   // Semestral
            3 => 4,   // Trimestral
            4 => 3,   // Cuatrimestral
            _ => 1    // Mensual u otros
        };
    }

