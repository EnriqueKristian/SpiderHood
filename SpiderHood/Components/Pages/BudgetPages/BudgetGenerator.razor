    // Valida el CONTENIDO del presupuesto (secciones con items, montos, lectura de agua
    // completa). blocked=true corta el flujo de una vez (ya se mostró el toast de error);
    // blocked=false con warnings.Any() son problemas "blandos" que el Administrador puede
    // decidir ignorar vía el modal de confirmación. Se usa tanto al enviar a aprobación
    // como, de nuevo, al publicar (último resguardo antes de generar cuotas reales en BD).
    private async Task<(bool blocked, List<string> warnings)> ValidarPresupuestoParaAprobacion()
    {
        // 1. Validar que haya secciones en el presupuesto
        if (_BudgetState.Budget!.Details == null || !_BudgetState.Budget.Details.Any())
        {
            await ShowToast("Error", "El presupuesto no tiene detalles. Agregue secciones e items primero.", "danger");
            return (true, new());
        }

        // 2. Obtener secciones únicas (headers)
        var sections = _BudgetState.Budget.Details
            .Where(x => x.IsHeader)
            .Select(x => new { x.IdSection, x.Description })
            .Distinct()
            .ToList();

        if (!sections.Any())
        {
            await ShowToast("Error", "El presupuesto no tiene secciones definidas.", "danger");
            return (true, new());
        }

        // 3. Validar que cada sección tenga al menos un item
        var sectionsWithoutItems = new List<string>();
        var sectionsWithZeroAmount = new List<string>();

        foreach (var section in sections)
        {
            var sectionItems = _BudgetState.Budget.Details
                .Where(x => x.IdSection == section.IdSection && !x.IsHeader)
                .ToList();

            // Verificar si la sección tiene items
            if (!sectionItems.Any())
            {
                sectionsWithoutItems.Add(section.Description);
                continue;
            }

            // Verificar si los items tienen montos válidos
            var totalSectionAmount = sectionItems.Sum(x => x.MonthlyAmount);
            if (totalSectionAmount <= 0)
            {
                sectionsWithZeroAmount.Add(section.Description);
            }
        }

        // 4. Validar lectura de agua
        var waterCategoryId = Guid.Parse("CB42DE58-8C94-4CAA-82CF-4E5D0F6B2B8C");
        var hasWaterSection = sections.Any(s =>
            _BudgetState.Budget.Details.Any(d => d.IdSection == s.IdSection &&
                                  d.IdCategory == waterCategoryId &&
                                  !d.IsHeader));

        bool waterReadingValid = false;
        string waterReadingMessage = string.Empty;

        if (hasWaterSection)
        {
            // Validar que existan lecturas de agua
            if (_BudgetState.WaterReadings == null || !_BudgetState.WaterReadings.Any())
            {
                waterReadingValid = false;
                waterReadingMessage = "No hay lecturas de agua cargadas para el mes actual.";
            }
            else
            {
                // Validar que todas las unidades tengan lectura
                var unitsWithoutReading = new List<string>();
                var readingsWithErrors = new List<string>();

                foreach (var reading in _BudgetState.WaterReadings)
                {
                    // Validar lecturas válidas
                    /*if (reading.CurrentReading <= reading.PreviousReading)
                    {
                        readingsWithErrors.Add($"Unidad {reading.GroupNumber}: Lectura actual debe ser mayor a la anterior");
                        }*/

                    if (reading.Consumption <= 0)
                    {
                        readingsWithErrors.Add($"Unidad {reading.GroupNumber}: Consumo inválido");
                    }
                }

                // Verificar unidades sin lectura
                var allUnits = Installments?.Select(i => i.IdGroupUnit).Distinct().ToList() ?? new List<Guid>();
                var unitsWithReading = _BudgetState.WaterReadings.Select(r => r.IdGroupUnit).Distinct().ToList();
                var missingUnits = allUnits.Except(unitsWithReading).ToList();

                if (missingUnits.Any())
                {
                    var unitNames = Installments?
                        .Where(i => missingUnits.Contains(i.IdGroupUnit))
                        .Select(i => i.UnitName)
                        .ToList() ?? new List<string>();

                    waterReadingMessage = $"Faltan lecturas para: {string.Join(", ", unitNames)}";
                    waterReadingValid = false;
                }
                else if (readingsWithErrors.Any())
                {
                    waterReadingMessage = $"Errores en lecturas: {string.Join("; ", readingsWithErrors)}";
                    waterReadingValid = false;
                }
                else
                {
                    waterReadingValid = true;
                }
            }
        }
        else
        {
            // No hay sección de agua, no es necesario validar lecturas
            waterReadingValid = true;
        }

        // 5. Validar montos totales
        var totalBudgetAmount = _BudgetState.Budget.Details
            .Where(x => !x.IsHeader)
            .Sum(x => x.MonthlyAmount);

        if (totalBudgetAmount <= 0)
        {
            await ShowToast("Error", "El presupuesto total debe ser mayor a cero.", "danger");
            return (true, new());
        }

        // 6. Preparar mensajes de advertencia combinados
        var warnings = new List<string>();

        if (sectionsWithoutItems.Any())
        {
            warnings.Add($"Secciones sin items: {string.Join(", ", sectionsWithoutItems)}");
        }

        if (sectionsWithZeroAmount.Any())
        {
            warnings.Add($"Secciones con monto cero: {string.Join(", ", sectionsWithZeroAmount)}");
        }

        if (!waterReadingValid)
        {
            warnings.Add($"Lectura de agua: {waterReadingMessage}");
        }

        return (false, warnings);
    }

    // Muestra el modal de confirmación cuando hay advertencias "blandas", o procede
    // directamente si el presupuesto está limpio. Reusado por Enviar a Aprobación y Publicar.
    private async Task ConfirmarYProceder(List<string> warnings, Func<Task> proceed)
    {
        if (warnings.Any())
        {
            var errorDetails = string.Join("\n• ", warnings);
            var message = $"Se encontraron los siguientes problemas:\n\n• {errorDetails}\n\n¿Desea continuar de todos modos?";
            // isCancelOnly=false (antes estaba en true por error): ConfirmationModal
            // esconde el botón de confirmar cuando IsCancelOnly=true, así que este
            // diálogo preguntaba "¿Desea continuar de todos modos?" pero sólo ofrecía
            // "Cancelar" -- de hecho bloqueaba el envío a aprobación/publicación
            // siempre que hubiera cualquier advertencia "blanda" (típicamente, falta
            // de lectura de agua), en vez de dejarlo a criterio del Administrador
            // como documenta el comentario de ConfirmarYProceder.
            await util.ExecuteWithConfirmation(proceed, "actionName", _confirmationModal, message, "danger", false);
        }
        else
        {
            await proceed();
        }
    }

    // El Administrador envía a aprobación: Created/Rejected -> Check.
    private async Task EnviarAAprobacion()
    {
        if (!_canSubmitBudget || !(_Status == BudgetStatus.Created || _Status == BudgetStatus.Rejected)) return;

        try
        {
            var (blocked, warnings) = await ValidarPresupuestoParaAprobacion();
            if (blocked) return;

            await ConfirmarYProceder(warnings, async () =>
            {
                try
                {
                    await ShowLoading("Enviando a aprobación...");
                    _Status = BudgetStatus.Check;
                    _BudgetState.Status = _Status;
                    await SaveCalculation();
                    await WorkflowAuditService.LogAsync("Budget", _BudgetState.Budget.IdBudgetHeader, WorkflowAction.Submitted, currentUser.Email, _BudgetState.Budget.IdBuilding);
                    await HideLoading();
                    await ShowToast("Éxito", $"Presupuesto{getStatusNameMessage(_Status)} correctamente", "success");
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    await HideLoading();
                    await ShowToast("Error", $"Error al enviar a aprobación: {ex.Message}", "danger");
                }
            });
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al enviar a aprobación: {ex.Message}", "danger");
        }
    }

    // El Administrador publica: Approved -> Active. Recién acá se generan las cuotas en
    // BD (SaveBudgetAsync ya lo hace automáticamente al ver Status == Active) y se
    // generan/descargan todos los recibos (PDF) en un solo ZIP.
    private async Task PublicarPresupuesto()
    {
        if (!_canPublishBudget || _Status != BudgetStatus.Approved) return;

        try
        {
            var (blocked, warnings) = await ValidarPresupuestoParaAprobacion();
            if (blocked) return;

            await ConfirmarYProceder(warnings, async () =>
            {
                try
                {
                    await ShowLoading("Publicando presupuesto...");

                    _Status = BudgetStatus.Active;
                    _BudgetState.Status = _Status;

                    // Guarda el presupuesto y genera las Installment en BD (SaveBudgetAsync
                    // las persiste porque el estado ya quedó en Active).
                    await SaveCalculation();
                    await WorkflowAuditService.LogAsync("Budget", _BudgetState.Budget.IdBudgetHeader, WorkflowAction.Published, currentUser.Email, _BudgetState.Budget.IdBuilding);

                    // ParameterService.CurrentBuilding.Configuration viene del login
                    // (GET_AllBuildingsConfig), que NO trae BankAccounts ni AdminContact
                    // (se cargan aparte, solo cuando se visita y guarda Configuración del
                    // Edificio) — por eso el pie del recibo a veces salía con
                    // {Banco}/{Titular}/{CorreoADM} vacíos. Se refresca acá con la config
                    // completa antes de generar los recibos.
                    ParameterService.CurrentBuilding!.Configuration =
                        await BuildingService.GetConfigurationAsync(ParameterService.CurrentBuilding.IdBuilding);

                    // Cuotas Extraordinarias/Multas/Mora de las unidades de este lote —
                    // normalmente vacío en este punto (recién se está publicando el
                    // presupuesto), pero se consulta igual para que el recibo salga
                    // consistente con "Ver Detalle" si ya hubiera cargos generados.
                    var cargosAdicionales = await ExtraChargeService.GetCargosAdicionalesAsync(
                        ParameterService.CurrentBuilding!.IdBuilding, _BudgetState.Installments);

                    // Genera el recibo (PDF) de cada unidad y los descarga en un solo ZIP.
                    var exportService = new InstallmentExportService(
                        _BudgetState.Installments,
                        _BudgetState.Budget,
                        _BudgetState.WaterReadings,
                        _BudgetState.Exonerations,
                        ParameterService.CurrentBuilding!,
                        filteredCategories,
                        cargosAdicionales);

                    var zipBytes = exportService.GenerateAllReceiptsZip();
                    await JSRuntime.InvokeVoidAsync("downloadFile",
                        Convert.ToBase64String(zipBytes),
                        $"Recibos_{_BudgetState.Budget.BudgetDate:yyyyMM}.zip",
                        "application/zip");

                    await RegisterAuditLog();

                    await HideLoading();
                    await ShowToast("Éxito", $"Presupuesto{getStatusNameMessage(_Status)} correctamente", "success");
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    await HideLoading();
                    await ShowToast("Error", $"Error al procesar la publicación: {ex.Message}", "danger");
                }
            });
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al publicar presupuesto: {ex.Message}", "danger");
        }
    }

    private string getStatusNameMessage(BudgetStatus status)
    {
        string _mensaje = "guardado";

        switch (status)
        {
            case BudgetStatus.Check:
                _mensaje = " enviardo a aprobacion";
                break;
            case BudgetStatus.Rejected:
                _mensaje = " rechazado";
                break;
            case BudgetStatus.Approved:
                _mensaje = " aprobado";
                break;
            case BudgetStatus.Active:
                _mensaje = " publicado";
                break;
            case BudgetStatus.Closed:
                _mensaje = " cerrado";
                break;
        }
        return _mensaje;
    }



    private decimal GetCategoryWeight(Guid categoryId)
    {
        // Peso de la categoría en la distribución total
        // Categorías con mayor monto tienen mayor peso
        var categoryAmount = _BudgetState.Budget!.Details
            .Where(x => x.IdCategory == categoryId && !x.IsHeader)
            .Sum(x => x.MonthlyAmount);

        var totalAmount = _BudgetState.Budget!.Details
            .Where(x => !x.IsHeader)
            .Sum(x => x.MonthlyAmount);

        return totalAmount > 0 ? categoryAmount / totalAmount : 0;
    }

