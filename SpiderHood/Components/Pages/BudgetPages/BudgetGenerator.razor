    private async Task ShowNewCalculationModal()
    {
        if (_newCalcModal == null) return;

        // Si el edificio todavía no tiene ningún periodo (típico en un edificio recién
        // creado), _periods viene vacío: FirstOrDefault()! y Max() de más abajo tronaban
        // con NullReferenceException/InvalidOperationException en cuanto alguien intentaba
        // crear su primer presupuesto. Si no hay periodos, arrancamos desde hoy y dejamos
        // que CrearNuevoPeriodo cree el primero.
        _ultimoPeriodo = presupuestoService._Budgets.Count > 0
    ? presupuestoService._Budgets.Max(c => c.BudgetDate)
    : (_periods.Any() ? _periods.First().StartDate : DateTime.Now);

        //NOTE: Deberia validar que el presupuesto que se quiere crear no exista
        if (!_periods.Any() || _ultimoPeriodo >= _periods.Max(p => p.StartDate))
        {
            await CrearNuevoPeriodo(_periods.Any() ? _ultimoPeriodo.AddMonths(1) : _ultimoPeriodo);
        }

        _newCalculation = new NewCalculation
        {
            Month = _currentPeriod.StartDate.Month,
            Year = _currentPeriod.StartDate.Year,
            TotalApartments = _BudgetState.TotalApartments,
            Description = "Presupuesto - " + @GetMonthName(_currentPeriod.StartDate.Month) + " " + _currentPeriod.StartDate.Year
        };

        await _newCalcModal.ShowAsync();
    }

