    /*  SECCION MODALES   */

    private async Task ShowNewCalculationModal()
    {
        // Requiere create_budget — la Junta sólo aprueba/rechaza los que ya están en
        // revisión (ver approve_budget más abajo).
        if (!_canCreateBudget) return;
        if (_newCalcModal == null) return;

        // Edificio sin NINGÚN periodo todavía: no hay nada de qué partir para "sugerir
        // el siguiente", y menos aún asumir el mes en curso — esa elección (desde
        // cuándo arranca a operar el edificio, ej. Marzo si hay data desde ahí) es la
        // del periodo inicial y le corresponde al usuario en /periods, no a este modal.
        if (!_periods.Any())
        {
            // Un toast justo antes de navegar no es confiable (la transición de página
            // puede llevárselo antes de que el usuario lo vea) — el aviso se muestra en
            // /periods al llegar, vía el query string ?sinPeriodos=1.
            Navigation.NavigateTo("/periods?sinPeriodos=1");
            return;
        }

        // Ya existe al menos un periodo, pero todos tienen presupuesto Ordinario
        // (típico justo después de crear el último disponible): acá sí se sugiere
        // automáticamente el siguiente en la secuencia — el usuario igual puede crear
        // otro distinto con el botón "+" si este no es el que necesita.
        if (!PeriodosDisponibles().Any())
        {
            var siguiente = _periods.Max(p => p.StartDate).AddMonths(1);
            await CrearNuevoPeriodo(siguiente);
        }

        // Arranca sin periodo elegido: la Descripción (y el botón Crear) quedan
        // deshabilitados hasta que el usuario seleccione uno explícitamente —
        // OnSelectedCalculationChanged es quien la completa recién ahí.
        _selectedPeriodKey = string.Empty;
        _selectedPeriod = DateTime.MinValue;
        _newCalculation = new NewCalculation
        {
            TotalApartments = _BudgetState.TotalApartments,
            Description = string.Empty
        };

        await _newCalcModal.ShowAsync();
    }

    // Periodos que todavía no tienen un presupuesto Ordinario creado — los únicos que
    // tiene sentido ofrecer en "Nuevo Presupuesto" (evita crear dos presupuestos para
    // el mismo mes). No filtra por fecha "mayor a la última" (ese criterio excluía por
    // error el periodo recién auto-creado cuando su StartDate, normalizado al día 1,
    // quedaba antes que la marca de tiempo exacta usada para crearlo).
    private List<Period> PeriodosDisponibles() =>
        _periods.Where(p => !presupuestoService._Budgets.Any(b =>
            string.IsNullOrEmpty(b.BudgetType) && b.BudgetDate.Date == p.StartDate.Date)).ToList();

    // Se persiste al toque vía PeriodService.CreatePeriodAsync — el mismo servicio que
    // usa /periods — en vez de solo agregarlo a la lista _periods en memoria. Antes el
    // periodo quedaba "fantasma": existía únicamente en el estado de esta página hasta
    // que se guardaba el presupuesto completo (SaveBudgetAsync es quien insertaba los
    // periodos IsNewPeriod recién ahí), así que /periods no lo mostraba y, si se volvía
    // a abrir el modal sin guardar, se ofrecía crear el mismo mes de nuevo.
    private async Task<bool> CrearNuevoPeriodo(DateTime newperiod)
    {
        Period newPeriod = await ParameterService.CreateNewPeriod(newperiod, ParameterService.CurrentBuilding.IdBuilding);

        var creado = await PeriodService.CreatePeriodAsync(newPeriod);
        if (!creado)
        {
            await ShowToast("Error", "No se pudo crear el periodo (puede que se superponga con uno existente). Revisa /periods.", "danger");
            return false;
        }

        // Ya quedó insertado — que SaveBudgetAsync no lo vuelva a insertar al guardar
        // el presupuesto (ver BudgetService.SaveBudgetAsync: solo inserta los periodos
        // con IsNewPeriod = true).
        newPeriod.IsNewPeriod = false;

        _periods.Add(newPeriod);
        _currentPeriod = newPeriod;
        return true;
    }

    // Botón "+" junto a Periodo: crea el siguiente periodo después del más reciente que
    // ya exista (tenga o no presupuesto) y lo deja seleccionado — para cuando el
    // sugerido automáticamente al abrir el modal no es el que se necesita.
    private async Task CrearYSeleccionarNuevoPeriodo()
    {
        var siguiente = _periods.Any() ? _periods.Max(p => p.StartDate).AddMonths(1) : DateTime.Today;
        if (!await CrearNuevoPeriodo(siguiente))
            return;

        _selectedPeriodKey = ClavePeriodo(_currentPeriod.StartDate);
        await OnSelectedCalculationChanged();
    }

    private async Task CreateNewCalculation()
    {
        if (!_canCreateBudget) return;
        if (_selectedPeriod == DateTime.MinValue) return;

        // Implementar lógica para crear nuevo cálculo
        _BudgetState.Budget = new BudgetHeader
        {
            IdBudgetHeader = Guid.NewGuid(),
            IdBuilding = ParameterService.CurrentBuilding.IdBuilding,
            BudgetDate = _selectedPeriod, //new DateTime(_selectedYear, _selectedMonth, 1),
            BudgetName = $"Presupuesto {GetMonthName(_selectedPeriod.Month)} {_selectedPeriod.Year}",
            Status = BudgetStatus.Created,
            CreatedBy = "Admin",
            IdPeriod = _periods.Where(c => c.StartDate == _selectedPeriod).FirstOrDefault()!.IdPeriod
        };

        //_BudgetState.IsDisabled = false;
        _BudgetState.Status = BudgetStatus.Created;
        _textCabecera = "Detalle de Gastos - " + @GetMonthName(_selectedPeriod.Month) + " " + _selectedPeriod.Year;

        // Si se eligió una plantilla (o copiar el mes anterior) en el modal, cargar los
        // datos ahora — antes quedaba el presupuesto vacío y había que acordarse de
        // apretar "Cargar Plantilla" aparte, un paso extra que no tenía por qué existir
        // si ya se había elegido la plantilla al crear.
        switch (_newCalculation.Template)
        {
            case "basic":
            case "complete":
                await LoadSampleData();
                break;
            case "previous":
                await CopiarPresupuestoMesAnterior();
                break;
        }

        await _newCalcModal.HideAsync();
        StateHasChanged();
    }

    // "Copiar mes anterior": trae el desglose del último presupuesto Ordinario previo al
    // periodo seleccionado y lo clona como punto de partida (nuevos IdBudgetDetail, sin
    // IsNewItem para no recrear categorías que ya existen).
    private async Task CopiarPresupuestoMesAnterior()
    {
        var anterior = presupuestoService._Budgets
            .Where(b => string.IsNullOrEmpty(b.BudgetType) && b.BudgetDate < _selectedPeriod)
            .OrderByDescending(b => b.BudgetDate)
            .FirstOrDefault();

        if (anterior == null)
        {
            await ShowToast("Sin mes anterior",
                "No hay un presupuesto anterior para copiar. Usa una plantilla o crea las secciones manualmente.",
                "warning");
            return;
        }

        var detallesAnteriores = await presupuestoService.GetBudgetDetailAsync(anterior.IdBudgetHeader);

        _BudgetState.Budget.Details = detallesAnteriores.Select(d => new BudgetDetail
        {
            IdBudgetDetail = Guid.NewGuid(),
            IdCategory = d.IdCategory,
            IdSection = d.IdSection,
            ItemNumber = d.ItemNumber,
            Description = d.Description,
            MonthlyAmount = d.MonthlyAmount,
            AnnualAmount = d.AnnualAmount,
            Frequency = d.Frequency,
            Type = d.Type,
            IsHeader = d.IsHeader,
            IdBudgetHeader = _BudgetState.Budget.IdBudgetHeader,
            IsNewItem = false,
            IdParent = d.IdParent
        }).ToList();

        _BudgetState.CalculateTotals();
    }

    /*  SECCION SAVE   */
    #region SAVE
    public async Task SaveCalculation()
    {
        await presupuestoService.SaveBudgetAsync(_BudgetState, _periods);
        await ReloadBudgetData();
    }

    private async Task ReloadBudgetData()
    {
        _BudgetState.IsNewBudget = false;
        _BudgetState.Budget.Details.Clear();
        _BudgetState.Budget.Details = await presupuestoService.GetBudgetDetailAsync(_BudgetState.Budget.IdBudgetHeader);
        _periods.Clear();
        _periods = await ParameterService.GetPeriodsAsync(ParameterService.CurrentBuilding.IdBuilding);
    }

    // La Junta aprueba: Check -> Approved. No vuelve a correr las validaciones de
    // contenido (secciones/montos/agua) — eso ya se validó al enviar a aprobación, y la
    // Junta no edita el presupuesto.
    private async Task AprobarPresupuesto()
    {
        if (!_canApproveBudget || _Status != BudgetStatus.Check) return;

        _Status = BudgetStatus.Approved;
        _BudgetState.Status = _Status;
        await SaveCalculation();
        await WorkflowAuditService.LogAsync("Budget", _BudgetState.Budget.IdBudgetHeader, WorkflowAction.Approved, currentUser.Email, _BudgetState.Budget.IdBuilding);
        await ShowToast("Éxito", $"Presupuesto{getStatusNameMessage(_Status)} correctamente", "success");
        StateHasChanged();
    }

    // La Junta rechaza: Check -> Rejected (antes volvía directo a Created, perdiendo el
    // registro de que había sido rechazado). Rejected se trata igual que Created para
    // edición (ver CanEdit), así que el Administrador puede corregirlo y reenviarlo a
    // aprobación.
    private async Task RechazarPresupuesto()
    {
        if (!_canApproveBudget || _Status != BudgetStatus.Check) return;

        _Status = BudgetStatus.Rejected;
        _BudgetState.Status = _Status;
        await SaveCalculation();
        await WorkflowAuditService.LogAsync("Budget", _BudgetState.Budget.IdBudgetHeader, WorkflowAction.Rejected, currentUser.Email, _BudgetState.Budget.IdBuilding);
        await ShowToast("Info", $"Presupuesto{getStatusNameMessage(_Status)}", "warning");
        StateHasChanged();
    }

    // El Administrador cierra: Active -> Closed. Sin cambios de fondo respecto al
    // comportamiento anterior, solo se le agrega el gate de rol.
    private async Task CerrarPresupuesto()
    {
        if (!_canCloseBudget || _Status != BudgetStatus.Active) return;

        _Status = BudgetStatus.Closed;
        _BudgetState.Status = _Status;
        await SaveCalculation();
        await WorkflowAuditService.LogAsync("Budget", _BudgetState.Budget.IdBudgetHeader, WorkflowAction.Closed, currentUser.Email, _BudgetState.Budget.IdBuilding);
        await ShowToast("Éxito", $"Presupuesto{getStatusNameMessage(_Status)} correctamente", "success");
        StateHasChanged();
    }
