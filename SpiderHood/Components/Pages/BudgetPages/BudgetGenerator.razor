    private decimal CalculateInstallmentAmountWithExceptions(Installment unit, decimal areaPercentage,
        List<InstallmentException> exceptions)
    {
        decimal totalAmount = 0;

        // 1. Agrupar items del presupuesto por categoría
        var itemsByCategory = _BudgetState.Budget!.Details
            .Where(x => !x.IsHeader)
            .GroupBy(x => x.IdCategory)
            .ToDictionary(g => g.Key, g => g.ToList());

        // 2. Para cada categoría, calcular la distribución
        foreach (var categoryGroup in itemsByCategory)
        {
            var categoryId = categoryGroup.Key;
            var categoryItems = categoryGroup.Value;
            var totalCategoryAmount = categoryItems.Sum(x => x.MonthlyAmount);

            // Verificar si este departamento tiene excepción para esta categoría
            var unitException = exceptions.FirstOrDefault(e =>
                e.IdGroupUnit == unit.IdGroupUnit &&
                e.IdCategory == categoryId &&
                e.IsActive);

            if (unitException != null)
            {
                // El departamento tiene excepción para esta categoría
                var excludedAmount = totalCategoryAmount * (unitException.PercentageExcluded / 100);
                var applicableAmount = totalCategoryAmount - excludedAmount;

                /*if (applicableAmount > 0)
                {
                    // Redistribuir el monto excluido entre los demás departamentos
                    var redistributedAmount = await RedistributeExcludedAmount(
                        excludedAmount, categoryId, unit.IdGroupUnit, exceptions);

                    // Calcular participación de este departamento en el monto redistribuido
                    var redistributionShare = CalculateRedistributionShare(unit, categoryId, exceptions);
                    totalAmount += (applicableAmount * (areaPercentage / 100)) +
                                  (redistributedAmount * redistributionShare);
                }*/
            }
            else
            {
                // Sin excepción, distribución normal
                // Para categorías específicas (ej: agua), cálculo individual
                if (categoryId == _idAgua && _BudgetState.WaterReadings?.Any() == true)
                {
                    var waterItem = _BudgetState.WaterReadings.FirstOrDefault(w => w.IdGroupUnit == unit.IdGroupUnit);
                    if (waterItem != null)
                    {
                        totalAmount += waterItem.CalculatedAmount;
                    }
                }
                else
                {
                    // Distribución proporcional al área
                    totalAmount += totalCategoryAmount * (areaPercentage / 100);
                }
            }
        }

        return totalAmount;
    }

    private async Task<decimal> RedistributeExcludedAmount(decimal excludedAmount, Guid categoryId,
        Guid excludedUnitId, List<InstallmentException> exceptions)
    {
        // Encontrar departamentos que SÍ deben pagar esta categoría
        var payingUnits = Installments!
            .Where(u => u.IdGroupUnit != excludedUnitId)
            .ToList();

        if (!payingUnits.Any())
            return 0;

        // Calcular nueva distribución considerando excepciones de otros departamentos
        var totalApplicableArea = 0m;
        var applicableUnits = new List<(Guid UnitId, decimal Area, bool HasException)>();

        foreach (var unit in payingUnits)
        {
            var hasException = exceptions.Any(e =>
                e.IdGroupUnit == unit.IdGroupUnit &&
                e.IdCategory == categoryId &&
                e.IsActive);

            if (!hasException)
            {
                applicableUnits.Add((unit.IdGroupUnit, unit.TotalArea, false));
                totalApplicableArea += unit.TotalArea;
            }
            else
            {
                var exception = exceptions.First(e =>
                    e.IdGroupUnit == unit.IdGroupUnit &&
                    e.IdCategory == categoryId);

                // Si tiene excepción parcial, considerar solo el porcentaje que sí paga
                var applicablePercentage = (100 - exception.PercentageExcluded) / 100;
                var effectiveArea = unit.TotalArea * applicablePercentage;

                applicableUnits.Add((unit.IdGroupUnit, effectiveArea, true));
                totalApplicableArea += effectiveArea;
            }
        }

        // Redistribuir proporcionalmente entre los departamentos aplicables
        var redistributedAmount = 0m;

        foreach (var unit in applicableUnits)
        {
            var share = unit.Area / totalApplicableArea;
            redistributedAmount += excludedAmount * share;
        }

        return redistributedAmount;
    }

    private decimal CalculateAdjustedPercentage(Installment unit, decimal areaPercentage,
        List<InstallmentException> exceptions)
    {
        // Calcular porcentaje ajustado considerando excepciones
        var totalWeightedArea = 0m;
        var unitEffectiveArea = unit.TotalArea;

        // Ajustar el área efectiva del departamento basado en sus excepciones
        var unitExceptions = exceptions
            .Where(e => e.IdGroupUnit == unit.IdGroupUnit && e.IsActive)
            .ToList();

        if (unitExceptions.Any())
        {
            // Reducir el área efectiva proporcionalmente a las excepciones
            var exceptionFactor = 1m;
            foreach (var exception in unitExceptions)
            {
                // Cada excepción reduce la participación en la distribución
                exceptionFactor -= (exception.PercentageExcluded / 100) * GetCategoryWeight(exception.IdCategory);
            }

            unitEffectiveArea *= Math.Max(exceptionFactor, 0);
        }

        // Calcular áreas efectivas de todos los departamentos
        var effectiveAreas = new Dictionary<Guid, decimal>();

        foreach (var u in Installments!)
        {
            var effectiveArea = u.TotalArea;
            var uExceptions = exceptions
                .Where(e => e.IdGroupUnit == u.IdGroupUnit && e.IsActive)
                .ToList();

            if (uExceptions.Any())
            {
                var exceptionFactor = 1m;
                foreach (var exception in uExceptions)
                {
                    exceptionFactor -= (exception.PercentageExcluded / 100) * GetCategoryWeight(exception.IdCategory);
                }

                effectiveArea *= Math.Max(exceptionFactor, 0);
            }

            effectiveAreas[u.IdGroupUnit] = effectiveArea;
            totalWeightedArea += effectiveArea;
        }

        // Calcular porcentaje ajustado
        var adjustedPercentage = totalWeightedArea > 0
            ? (unitEffectiveArea / totalWeightedArea) * 100
            : areaPercentage;

        return adjustedPercentage;
    }

    private decimal GetCategoryWeight(Guid categoryId)
    {
        // Peso de la categoría en la distribución total
        // Categorías con mayor monto tienen mayor peso
        var categoryAmount = _BudgetState.Budget!.Details
            .Where(x => x.IdCategory == categoryId && !x.IsHeader)
            .Sum(x => x.MonthlyAmount);

        var totalAmount = _BudgetState.Budget!.Details
            .Where(x => !x.IsHeader)
            .Sum(x => x.MonthlyAmount);

        return totalAmount > 0 ? categoryAmount / totalAmount : 0;
    }

    private decimal CalculateRedistributionShare(Installment unit, Guid categoryId,
        List<InstallmentException> exceptions)
    {
        // Calcular cuánto le corresponde de los montos redistribuidos
        var unitException = exceptions.FirstOrDefault(e =>
            e.IdGroupUnit == unit.IdGroupUnit &&
            e.IdCategory == categoryId &&
            e.IsActive);

        if (unitException != null && unitException.PercentageExcluded < 100)
        {
            // Si tiene excepción parcial, puede recibir redistribución
            return (100 - unitException.PercentageExcluded) / 100;
        }

        // Sin excepción o excepción total = no recibe redistribución
        return 0;
    }

    private decimal CalculateInstallmentAmount(decimal percentage)
    {
        // Calcular monto base del presupuesto (sin agua)
        var baseAmount = _BudgetState.Budget!.Details
            .Where(x => !x.IsHeader && x.IdCategory != _idAgua)
            .Sum(x => x.MonthlyAmount);

        // Calcular agua si existe
        decimal waterAmount = 0;
        if (_BudgetState.WaterReadings?.Any() == true)
        {
            waterAmount = _BudgetState.WaterReadings.Sum(x => x.CalculatedAmount);
        }

        // Distribuir monto base según porcentaje y agregar agua individual
        var baseDistribution = (baseAmount * percentage) / 100;
        // Nota: El agua se calcula individualmente por departamento

        return baseDistribution;
    }

