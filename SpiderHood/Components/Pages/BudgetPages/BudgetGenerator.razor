@code {

    [Inject] private IPresupuestoService presupuestoService { get; set; } = null!;

    private int _selectedMonth = DateTime.Now.Month; // Mes actual
    private int _selectedYear = DateTime.Now.Year;   // Año actual
    private BudgetStatus _Status = BudgetStatus.Created;

    private decimal _totalMonthly = 0;
    private decimal _totalAnnual = 0;
    private int _totalApartments = 30;
    private int _occupiedApartments = 30;
    private decimal _quotaPerApartment = 0;
    private bool _useProportionalDistribution = false;
    private bool _isNewBudet = false;
    private bool _isDisable = true;
    private bool _readonly = false;

    private NewCalculation _newCalculation = new();
    private NewSection _newSection = new();
    private Modal _newCalcModal = null!;
    private Modal _newSectionModal = null!;

    private string class1 = "card card-hover mb-4";
    private string class2 = "card card-hover";
    private string class5 = "bi bi-arrow-bar-right";
    private bool showorNot = true;
    private string _msjButtonWorflow = "Sol. Aprob.";
    private string _icon = "fa-solid fa-list-check";
    private string _textCabecera = "Detalle de Gastos - ";

    private List<SelectListItem> _availableMonths = new();
    private List<ViewBudgetDetail> _budgetDetailTemplate = new();
    private List<Models.Parameter> filteredParameters = new();
    public List<ViewExpense> gastosPendientes = new();
    private List<Category> filteredCategories = new();
    private List<Category> _Categories = new();
    private BudgetHeader _Budget = new();
    //private List<BudgetHeader> budgets = new();
    private BudgetHeader budget = new();

    private List<OwnerUnitView> Owners = new();
    private List<OwnerUnitView> GroupOwners = new();
    private List<Installment> Installments = new();

    private Guid IdBudgetHeader = Guid.Empty;

    private BudgetStatus ValidateParameter(BudgetStatus value)
    {
        switch (value)
        {
            case BudgetStatus.Created or BudgetStatus.Rejected:
                _readonly = false;
                break;
            case BudgetStatus.Check:
                SetWorkflowState("Aprobar", "fa-solid fa-file", true);
                break;
            case BudgetStatus.Approved:
                SetWorkflowState("Publicar", "fa-solid fa-upload", true);
                break;
            case BudgetStatus.Active:
                SetWorkflowState("Cerrar", "fa-solid fa-folder-closed", true);
                break;
            case BudgetStatus.Closed:
                SetWorkflowState("Cerrado", "fa-solid fa-lock", true);
                break;
        }
        return value;
    }

    private void SetWorkflowState(string message, string icon, bool isReadonly)
    {
        _msjButtonWorflow = message;
        _icon = icon;
        _readonly = isReadonly;
    }

    protected override async Task OnInitializedAsync()
    {
        if (ParameterService.IdBuilding == Guid.Empty)
            return;

        //budgets = presupuestoService._Budgets;
        _Budget = presupuestoService._SelectedBudget;
        _Status = ValidateParameter(_Budget.Status);

        await Task.WhenAll(
            LoadDataDefault(),
            ShoworNot()
        );

        if (_Budget != null && _Budget!.IdBudgetHeader != Guid.Empty )
        {
            IdBudgetHeader = _Budget.IdBudgetHeader;
            _isNewBudet = false;
            _isDisable = false;
            _selectedMonth = _Budget.Month;
            _selectedYear = _Budget.Year;
            _textCabecera = "Detalle de Gastos - " + @GetMonthName(_selectedMonth) + " " + _selectedYear;
            await LoadData();
        }
        else 
        {
            _isNewBudet = true;
            _isDisable = true;
            _Status = BudgetStatus.Created;

            // Mostrar modal por defecto
            await ShowNewCalculationModal();
        }
    }

    /*  SECCION LOAD DATA   */

    private async Task LoadData()
    {
        _Budget.Details = await ParameterService.ec.GetBudgetDetail(IdBudgetHeader);
        await CalculateTotals();
    }

    private async Task LoadSampleData()
    {
        var sequentialNumber = 0.0m;
        _Budget.Details.Clear();

        foreach (var detail in _budgetDetailTemplate)
        {
            if (detail.IsHeader)
                sequentialNumber = 0.00m;

            var categoryAmount = gastosPendientes
                .Where(c => c.IdCategory == detail.IdCategory)
                .Sum(x => x.Amount);

            var newItem = new BudgetDetail
            {
                IdBudgetDetail = detail.IdBudgetDetail,
                IdCategory = detail.IdCategory,
                IdSection = detail.IdSection,
                ItemNumber = detail.IdSection + sequentialNumber,
                Description = detail.Description,
                MonthlyAmount = detail.MonthlyAmount == 0 ? categoryAmount : detail.MonthlyAmount,
                AnnualAmount = detail.AnnualAmount,
                Frequency = detail.Frequency,
                Type = detail.Type,
                IsHeader = detail.IsHeader
            };

            _Budget.Details.Add(newItem);
            sequentialNumber += 0.01m;
        }

        await CalculateTotals();
    }

    private async Task LoadDataDefault()
    {
        DateTime startDate = new DateTime(_selectedYear, _selectedMonth, 1);

        //Cargar Template Default
        _budgetDetailTemplate = await ParameterService.ec.GetBudgetDetailDefault(ParameterService.IdBuilding);

        //Cargar los gastos pendientes en rango de fecha
        gastosPendientes = await ExpenseService.ObtenerGastosPendientesConciliacionAsync(ParameterService.ec, ParameterService.IdBuilding, startDate.AddMonths(-1), startDate.AddMonths(1));

        //Cargar Categoria
        filteredCategories = ParameterService.ec.GetCategories(ParameterService.IdBuilding);

        //Caargar lista de Parametros
        filteredParameters = @ParameterService.ListParameters.ToList();

        //Cargar Lista de Propietarios 
        Owners = ParameterService.ec.GetOwnersByBuilding(ParameterService.IdBuilding);
        GroupOwners = Owners.Where(c => c.Role == 1 && c.TypeUnit == 1).ToList();

        //Cargar Meses por Culura
        _availableMonths = await ParameterService.GetMonthList("es-PE");

    }

    /*  SECCION CALCULOS   */
    #region CALCULOS

    private async Task CalculateTotals()
    {
        _totalMonthly = 0;
        _totalAnnual = 0;

        var nonHeaderItems = _Budget.Details.Where(x => !x.IsHeader).ToList();

        foreach (var item in nonHeaderItems)
        {
            var annualMultiplier = GetAnnualMultiplier(item.Frequency);
            var annualValue = item.MonthlyAmount * annualMultiplier;

            if (item.AnnualAmount != annualValue)
            {
                item.AnnualAmount = Math.Round(annualValue, 2);
            }

            _totalMonthly += item.MonthlyAmount;
            _totalAnnual += item.AnnualAmount;
        }

        await CalculateQuota();

        StateHasChanged();
    }

    private decimal GetAnnualMultiplier(int frequency)
    {
        return frequency switch
        {
            1 => 12,  // Anual
            2 => 6,   // Semestral
            3 => 4,   // Trimestral
            4 => 3,   // Cuatrimestral
            _ => 1    // Mensual u otros
        };
    }

    private async Task CalculateQuota()
    {
        _quotaPerApartment = _totalApartments > 0
            ? Math.Round(_totalMonthly / _totalApartments, 2)
            : 0;

        Installments.Clear();

        foreach (var unit in GroupOwners)
        {
            Installment _dpto = new Installment();
            _dpto.IdInstallment = Guid.NewGuid();
            _dpto.IdBudgetHeader = IdBudgetHeader;
            _dpto.CreationDate = DateTime.Now; //_Budget.BudgetDate;
            _dpto.TotalArea = unit.TotalArea;
            _dpto.UnitName = unit.UnitNumber;
            _dpto.OwnerName = unit.FirstName;
            _dpto.IdGroupUnit = unit.IdGroupUnit;
            _dpto.CreatedBy = ParameterService.UserName;
            _dpto.DueDate = DateTime.Now.AddDays(ParameterService.DueDay);
            _dpto.Status = 1; //Created

            decimal _total = 0;
            int _nroAparments = ParameterService.nroGroupUnit;
            decimal _distr = unit.TotalArea / ParameterService.TotalAera;

            foreach (var item in _Budget.Details)
            {
                _total += item.Type == 1 ? item.MonthlyAmount / _nroAparments : item.MonthlyAmount * _distr;
            }

            _dpto.Amount = _total;
            _dpto.Percent = 100 * _distr;

            Installments.Add(_dpto);
        }

        StateHasChanged();
    }

    private void UpdateFrequency(BudgetDetail item)
    {
        var annualMultiplier = GetAnnualMultiplier(item.Frequency);
        item.AnnualAmount = item.MonthlyAmount * annualMultiplier;

        _ = CalculateTotals();
    }
    #endregion

    /*  SECCION MANAGE SECTIONS   */
    #region SECCION MANAGE SECTIONS
    private string GetMonthName(int monthNumber) =>
     _availableMonths?.FirstOrDefault(m => m.Value == monthNumber.ToString())?.Text
     ?? "Mes Desconocido";

    private string GetSectionName(int sectionId) =>
        _Budget.Details.FirstOrDefault(x => x.IdSection == sectionId && x.IsHeader)?.Description
        ?? $"Sección {sectionId}";

    private List<SectionInfo> GetSections() =>
        _Budget.Details
            .Where(x => x.IsHeader)
            .Select(x => new SectionInfo
            {
                Id = x.IdSection,
                Name = x.Description,
                IdCategory = x.IdCategory
            })
            .OrderBy(x => x.Id)
            .ToList();
    
    private bool IsLastItemInSection(Guid itemId, int sectionId)
    {
        var sectionItems = _Budget.Details
            .Where(x => x.IdSection == sectionId && !x.IsHeader)
            .ToList();

        return sectionItems.LastOrDefault()?.IdBudgetDetail == itemId;
    }

    private (decimal Monthly, decimal Annual) GetSectionTotal(int sectionId)
    {
        var sectionItems = _Budget.Details.Where(x => x.IdSection == sectionId && !x.IsHeader).ToList();
        return (
            Monthly: sectionItems.Sum(x => x.MonthlyAmount),
            Annual: sectionItems.Sum(x => x.AnnualAmount)
        );
    }

    private List<SectionTotal> GetSectionTotals()
    {
        var sections = new List<SectionTotal>();

        foreach (var section in GetSections())
        {
            var total = GetSectionTotal(section.Id);
            if (total.Monthly > 0 || total.Annual > 0)
            {
                sections.Add(new SectionTotal
                {
                    Id = section.Id,
                    Name = GetSectionName(section.Id),
                    Monthly = total.Monthly,
                    Annual = total.Annual
                });
            }
        }
        return sections;
    }

    private void AddExpenseItemToSection(int sectionId)
    {
        var sectionItems = _Budget.Details.Where(x => x.IdSection == sectionId && !x.IsHeader).ToList();
        var lastItemNumber = sectionItems.Any()
            ? sectionItems.Max(x => x.ItemNumber)
            : Math.Floor(GetNextSectionItemNumber(sectionId));

        var newItem = new BudgetDetail
        {
            IdBudgetDetail = Guid.NewGuid(),
            IdSection = sectionId,
            IdCategory = Guid.NewGuid(),
            ItemNumber = lastItemNumber + 0.01m,
            Description = "Nuevo Item",
            MonthlyAmount = 0,
            AnnualAmount = 0,
            Frequency = 1,
            Type = 1,
            IsNewItem = true,
            IdBudgetHeader = IdBudgetHeader
        };

        // Insertar después del último item de la sección
        var lastItemIndex = _Budget.Details.FindLastIndex(x => x.IdSection == sectionId && !x.IsHeader);
        if (lastItemIndex >= 0)
        {
            _Budget.Details.Insert(lastItemIndex + 1, newItem);
        }
        else
        {
            // Si no hay items en la sección, insertar después del header
            var headerIndex = _Budget.Details.FindIndex(x => x.IdSection == sectionId && x.IsHeader);
            if (headerIndex >= 0)
            {
                _Budget.Details.Insert(headerIndex + 1, newItem);
            }
            else
            {
                _Budget.Details.Add(newItem);
            }
        }

        _ = CalculateTotals();
    }

    private void AddExpenseItemToFirstSection()
    {
        var firstSection = GetSections().FirstOrDefault();
        if (firstSection != null)
        {
            AddExpenseItemToSection(firstSection.Id);
        }
        else
        {
            // Si no hay secciones, crear una primero
            _ = AddNewSection();
        }
    }

    private async Task AddNewSection()
    {
        //Filtrar Categorias de Nivel 0
        var existingSections = GetSections();

        _Categories = filteredCategories
            .Where(c => c.Nivel == 0 && !existingSections.Select(x => x.IdCategory).Contains(c.IdCategory))
            .ToList();

        _newSection = new NewSection
        {
            Name = "",
            Position = "last",
            IdCategory = Guid.Empty
        };

        await _newSectionModal.ShowAsync();
    }

    private async Task AddNewSectionFromModal1()
    {
        bool isNewCategory = false;

        if (string.IsNullOrWhiteSpace(_newSection.Name))
            return;

        // Determinar el ID de la nueva sección
        var existingSections = GetSections();
        var newSectionId = existingSections.Any()
            ? existingSections.Max(x => x.Id) + 1
            : 1;

        //Obtener el IdCategory correspondiente
        var newCategoryId = filteredCategories
            .FirstOrDefault(c => c.Description == _newSection.Name)?.IdCategory ?? Guid.NewGuid();


        //Verificar si la categoría ya existe
        if (filteredCategories.Where(c => c.Description == _newSection.Name).Count() == 0)
        {
            //Crear nueva categoria
            isNewCategory = true;
        }

        // Crear el header de la sección
        var sectionHeader = new BudgetDetail
        {
            IdBudgetDetail = Guid.NewGuid(),
            IdSection = newSectionId,
            ItemNumber = newSectionId,
            IdCategory = newCategoryId,
            Description = _newSection.Name.ToUpper(),
            IsHeader = true,
            IsNewItem = isNewCategory,
            IdBudgetHeader = IdBudgetHeader
        };


        // Determinar dónde insertar la sección
        if (_newSection.Position == "last" || !int.TryParse(_newSection.Position, out int afterSectionId))
        {
            _Budget.Details.Add(sectionHeader);
        }
        else
        {
            // Insertar después de la sección especificada
            var sectionIndex = _Budget.Details.FindLastIndex(x => x.IdSection == afterSectionId);
            if (sectionIndex >= 0)
            {
                _Budget.Details.Insert(sectionIndex + 1, sectionHeader);
            }
            else
            {
                _Budget.Details.Add(sectionHeader);
            }
        }

        if (!isNewCategory)
        {
            //Obtener el IdCategory correspondiente
            int oldIdSection = _budgetDetailTemplate
            .FirstOrDefault(c => c.Description == _newSection.Name)?.IdSection ?? 1;

            decimal SequentialNumber = (decimal)oldIdSection + 0.01m;

            foreach (var newItem in _budgetDetailTemplate.Where(c => c.IdSection == oldIdSection && !c.IsHeader))
            {
                BudgetDetail detail = new BudgetDetail();
                detail.IdBudgetDetail = newItem.IdBudgetDetail;
                detail.IdCategory = newItem.IdCategory;
                detail.IdSection = newSectionId;
                detail.ItemNumber = SequentialNumber ;
                detail.Description = newItem.Description;
                detail.MonthlyAmount = newItem.MonthlyAmount == 0
                          ? gastosPendientes.Where(c => c.IdCategory == newItem.IdCategory).Sum(x => x.Amount)
                          : newItem.MonthlyAmount;
                detail.AnnualAmount = newItem.AnnualAmount;
                detail.Frequency = newItem.Frequency;
                detail.Type = newItem.Type;
                detail.IsHeader = newItem.IsHeader;
                detail.IdBudgetHeader = IdBudgetHeader;

                _Budget.Details.Add(detail);
                SequentialNumber = SequentialNumber + 0.01m;

            }
        }

        await _newSectionModal.HideAsync();
        StateHasChanged();
    }

    private async Task AddNewSectionFromModal()
    {
        if (string.IsNullOrWhiteSpace(_newSection.Name))
            return;

        var existingSections = GetSections();
        var newSectionId = existingSections.Any()
            ? existingSections.Max(x => x.Id) + 1
            : 1;

        var existingCategory = filteredCategories
            .FirstOrDefault(c => c.Description == _newSection.Name);

        var isNewCategory = existingCategory == null;
        var categoryId = existingCategory?.IdCategory ?? Guid.NewGuid();

        var sectionHeader = CreateSectionHeader(newSectionId, categoryId, isNewCategory);
        InsertSectionInPosition(sectionHeader);

        if (!isNewCategory)
        {
            await AddTemplateItemsToSection(newSectionId, existingCategory!.IdCategory);
        }

        await _newSectionModal.HideAsync();
        StateHasChanged();
    }

    private BudgetDetail CreateSectionHeader(int sectionId, Guid categoryId, bool isNew)
    {
        return new BudgetDetail
        {
            IdBudgetDetail = Guid.NewGuid(),
            IdSection = sectionId,
            ItemNumber = sectionId,
            IdCategory = categoryId,
            Description = _newSection.Name.ToUpper(),
            IsHeader = true,
            IsNewItem = isNew,
            IdBudgetHeader = IdBudgetHeader
        };
    }

    private void InsertSectionInPosition(BudgetDetail sectionHeader)
    {
        if (_newSection.Position == "last" || !int.TryParse(_newSection.Position, out int afterSectionId))
        {
            _Budget.Details.Add(sectionHeader);
            return;
        }

        var sectionIndex = _Budget.Details.FindLastIndex(x => x.IdSection == afterSectionId);
        _Budget.Details.Insert(sectionIndex >= 0 ? sectionIndex + 1 : _Budget.Details.Count, sectionHeader);
    }

    private async Task AddTemplateItemsToSection(int newSectionId, Guid categoryId)
    {
        var oldIdSection = _budgetDetailTemplate
            .FirstOrDefault(c => c.IdCategory == categoryId)?.IdSection ?? 1;

        var sequentialNumber = (decimal)newSectionId + 0.01m;
        var templateItems = _budgetDetailTemplate
            .Where(c => c.IdSection == oldIdSection && !c.IsHeader);

        foreach (var templateItem in templateItems)
        {
            var categoryAmount = gastosPendientes
                .Where(c => c.IdCategory == templateItem.IdCategory)
                .Sum(x => x.Amount);

            var detail = new BudgetDetail
            {
                IdBudgetDetail = templateItem.IdBudgetDetail,
                IdCategory = templateItem.IdCategory,
                IdSection = newSectionId,
                ItemNumber = sequentialNumber,
                Description = templateItem.Description,
                MonthlyAmount = templateItem.MonthlyAmount == 0 ? categoryAmount : templateItem.MonthlyAmount,
                AnnualAmount = templateItem.AnnualAmount,
                Frequency = templateItem.Frequency,
                Type = templateItem.Type,
                IsHeader = templateItem.IsHeader,
                IdBudgetHeader = IdBudgetHeader
            };

            _Budget.Details.Add(detail);
            sequentialNumber += 0.01m;
        }
    }

    private void RemoveExpenseItem(Guid id)
    {
        var item = _Budget.Details.FirstOrDefault(x => x.IdBudgetDetail == id);
        if (item != null)
        {
            _Budget.Details.Remove(item);
            _ = CalculateTotals();
        }
    }

    private void RemoveSection(int sectionId)
    {
        var itemsToRemove = _Budget.Details.Where(x => x.IdSection == sectionId).ToList();
        foreach (var item in itemsToRemove)
        {
            _Budget.Details.Remove(item);
        }

        _ = CalculateTotals();
    }

    private decimal GetNextSectionItemNumber(int sectionId) => sectionId;
    #endregion

    /*  SECCION FILTER   */

    private void ChangeYear(int delta)
    {
        _selectedYear += delta;
        StateHasChanged();
    }

    /*  SECCION MODALES   */

    private async Task ShowNewCalculationModal()
    {
        if (_newCalcModal == null ) return;

        _newCalculation = new NewCalculation
        {
            Month = _selectedMonth,
            Year = _selectedYear,
            TotalApartments = _totalApartments,
            Description = "Presupuesto - " + @GetMonthName(_selectedMonth) + " " +_selectedYear
        };

        await _newCalcModal.ShowAsync();
    }

    private async Task CreateNewCalculation()
    {
        // Implementar lógica para crear nuevo cálculo
        IdBudgetHeader = Guid.NewGuid();

        _Budget = new BudgetHeader
        {
            IdBudgetHeader = IdBudgetHeader,
            IdBuilding = ParameterService.IdBuilding,
            BudgetDate = new DateTime(_selectedYear, _selectedMonth, 1),
            BudgetName = $"Presupuesto {GetMonthName(_selectedMonth)} {_selectedYear}",
            Status = BudgetStatus.Created,
            CreatedBy = "Admin"
        };

        _isDisable = false;
        _textCabecera = "Detalle de Gastos - " + @GetMonthName(_selectedMonth) + " " + _selectedYear;
        await _newCalcModal.HideAsync();
        StateHasChanged();
    }

    /*  SECCION SAVE   */
    #region SAVE
    public async Task SaveCalculation()
    {
        using var transaction = await ParameterService.context.Database.BeginTransactionAsync();

        try
        {
            if (_Status == BudgetStatus.Created || _Status == BudgetStatus.Rejected)
            {
                await SaveCategories();

                if (_isNewBudet)
                {
                    await CreateNewBudget();
                }
                else
                {
                    await UpdateExistingBudget();
                }
            }
            else
            {
                await ParameterService.ec.UpdateRecordAsync(_Budget);

                if( _Status == BudgetStatus.Active  ){

                    foreach( var item in Installments)
                    {
                        await ParameterService.ec.AddNewRecordAsync(item);
                    }
                }

            }

            await transaction.CommitAsync();
            await ReloadBudgetData();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Console.WriteLine($"Error al guardar cálculo: {ex.Message}");
        }
    }

    private async Task SaveCategories()
    {
        foreach (var header in _Budget.Details.Where(c => c.IsHeader && c.IsNewItem))
        {
            await SaveCategory(header, Guid.Empty);

            foreach (var subItem in _Budget.Details.Where(c => c.IdSection == header.IdSection && !c.IsHeader && c.IsNewItem))
            {
                await SaveCategory(subItem, header.IdCategory);
            }
        }
    }

    private async Task SaveCategory(BudgetDetail item, Guid parentId)
    {
        var category = new Category
        {
            IdCategory = item.IdCategory,
            Description = item.Description,
            ShortDescript = item.Description,
            Color = "#FFFFFF",
            Icon = "fa-solid fa-droplet",
            IdBuilding = ParameterService.IdBuilding,
            Nivel = parentId == Guid.Empty ? 0 : item.IdSection,
            ParentId = parentId
        };

        await ParameterService.ec.AddNewRecordAsync(category);
    }

    private async Task CreateNewBudget()
    {
        _Budget.Amount = _totalMonthly;
        _Budget.AnnualAmount = _totalAnnual;

        await ParameterService.ec.AddNewRecordAsync(_Budget);

        foreach (var item in _Budget.Details.Where(c => c.IsHeader || c.MonthlyAmount > 0))
        {
            item.IdBudgetHeader = IdBudgetHeader;
            await ParameterService.ec.AddNewRecordAsync(item);
        }

        _isNewBudet = false;
    }

    private async Task UpdateExistingBudget()
    {
        await ParameterService.ec.DelBudgetDetailByHeaderAsync(IdBudgetHeader);

        foreach (var item in _Budget.Details.Where(c => c.IsHeader || c.MonthlyAmount > 0))
        {
            item.IdBudgetHeader = IdBudgetHeader;
            await ParameterService.ec.AddNewRecordAsync(item);
        }

        _Budget.Amount = _totalMonthly;
        _Budget.AnnualAmount = _totalAnnual;
        await ParameterService.ec.UpdateRecordAsync(_Budget);
    }

    private async Task ReloadBudgetData()
    {
        _isNewBudet = false;
        _Budget.Details.Clear();
        //_expenseItems = await ParameterService.ec.GetBudgetDetailAsync(IdBudgetHeader);
        _Budget.Details = await ParameterService.ec.GetBudgetDetail(IdBudgetHeader);
    }

    private async Task PublishBudget(MouseEventArgs args)
    {
        UpdateBudgetStatus();

        if (_Status != BudgetStatus.Closed)
        {
            _Budget.Status = _Status;
            await SaveCalculation();
        }
    }

    private void UpdateBudgetStatus()
    {
        switch (_Status)
        {
            case BudgetStatus.Created or BudgetStatus.Rejected:
                _Status = BudgetStatus.Check;
                SetWorkflowState("Aprobar", "fa-solid fa-file", true);
                break;
            case BudgetStatus.Check:
                _Status = BudgetStatus.Approved;
                SetWorkflowState("Publicar", "fa-solid fa-upload", true);
                break;
            case BudgetStatus.Approved:
                _Status = BudgetStatus.Active;
                SetWorkflowState("Cerrar", "fa-solid fa-folder-closed", true);
                break;
            case BudgetStatus.Active:
                _Status = BudgetStatus.Closed;
                SetWorkflowState("Cerrado", "fa-solid fa-lock", true);
                break;
        }
    }

    private async Task PublishBudgetR(MouseEventArgs args)
    {
        SetWorkflowState("Sol. Aprob.", "fa-solid fa-list-check", false);
        _Status = BudgetStatus.Created;
    }
