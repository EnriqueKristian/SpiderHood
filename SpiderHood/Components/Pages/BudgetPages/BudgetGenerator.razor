        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando toast: {ex.Message}");
            // Fallback a console
            Console.WriteLine($"{type.ToUpper()}: {title} - {message}");
        }
    }

    private async Task ShowLoading(string message)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showLoading", message);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando loading: {ex.Message}");
        }
    }

    private async Task HideLoading()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("hideLoading");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error ocultando loading: {ex.Message}");
        }
    }

