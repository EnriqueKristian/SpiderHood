<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Cálculo de Presupuesto Mensual</h1>
        <p class="text-muted mb-0">Calcule los gastos mensuales y determine la cuota por departamento</p>
    </div>
    <div class="d-flex gap-2">
        @if (IdBudgetHeader != Guid.Empty)
        {
            @if (SampleData)
            {
                <button class="btn btn-outline-primary" @onclick="() => OnLoadTemplate.InvokeAsync()">
                    <i class="bi bi-upload me-1"></i>Cargar Plantilla
                </button>
            }
        }
        <button class="btn btn-primary btn-lg" style="border-radius: 50px;" @onclick="() => OnNewCalculation.InvokeAsync()">
            <i class="bi bi-plus-circle me-2"></i>Nuevo Cálculo
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small">Total Mensual</h6>
                        <h2 class="mb-0">S/ @TotalMonthly.ToString("N2")</h2>
                    </div>
                    <div style="color: #3b82f6;">
                        <i class="bi bi-calculator-fill" style="font-size: 1.2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small">Total Anual</h6>
                        <h2 class="mb-0">S/ @TotalAnnual.ToString("N2")</h2>
                    </div>
                    <div style="color: #10b981;">
                        <i class="bi bi-calendar-check-fill" style="font-size: 1.2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small">Departamentos</h6>
                        <h2 class="mb-0">@TotalApartments</h2>
                    </div>
                    <div style="color: #f59e0b;">
                        <i class="bi bi-building-fill" style="font-size: 1.2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-2">
                        @if (SaveBudget)
                        {
                            <button disabled="@IsDisabled" class="btn btn-outline-success" @onclick="() => OnSave.InvokeAsync()">
                                <i class="bi bi-save me-1"></i>Guardar
                            </button>
                        }
                        <button disabled="@IsDisabled" class="btn btn-outline-success" @onclick="() => OnGenerateReport.InvokeAsync()">
                            <i class="bi bi-file-pdf me-1"></i>Generar Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnNewCalculation { get; set; }

    [Parameter]
    public EventCallback OnLoadTemplate { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnGenerateReport { get; set; }

    [Parameter]
    public Models.BudgetStatus Status { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }
    [Parameter]
    public bool SaveBudget { get; set; }
    [Parameter]
    public bool SampleData { get; set; }
    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public Guid IdBudgetHeader { get; set; }

    // Parámetros para binding de dos vías
    [Parameter]
    public decimal TotalMonthly { get; set; }

    [Parameter]
    public EventCallback<decimal> TotalMonthlyChanged { get; set; }

    [Parameter]
    public decimal TotalAnnual { get; set; }

    [Parameter]
    public EventCallback<decimal> TotalAnnualChanged { get; set; }

    [Parameter]
    public decimal TotalApartments { get; set; }

    [Parameter]
    public EventCallback<decimal> TotalApartmentsChanged { get; set; }

    // Métodos para actualizar los valores
    private async Task UpdateTotalMonthly(decimal value)
    {
        TotalMonthly = value;
        await TotalMonthlyChanged.InvokeAsync(value);
    }

    private async Task UpdateTotalAnnual(decimal value)
    {
        TotalAnnual = value;
        await TotalAnnualChanged.InvokeAsync(value);
    }

    private async Task UpdateTotalApartments(decimal value)
    {
        TotalApartments = value;
        await TotalApartmentsChanged.InvokeAsync(value);
    }
}