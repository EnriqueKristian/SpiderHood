<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-calculator-fill"></i>Cálculo de Presupuesto Mensual</h1>
        <p class="text-muted mb-0">Calcule los gastos mensuales y determine la cuota por departamento</p>
    </div>
    <div class="d-flex gap-2">
        @if (_budgetState!.Budget.IdBudgetHeader != Guid.Empty)
        {
            @if (_budgetState!.AddSampleData && !TieneDetalles)
            {
                <!-- Solo mientras el presupuesto está realmente vacío: una vez cargados
                     los datos (por plantilla, copia del mes anterior o a mano) este botón
                     desaparece — repetirlo acá quedaba confuso al lado del que ya ofrece
                     el estado vacío de la tabla más abajo. -->
                <button class="btn btn-outline-primary" @onclick="() => OnLoadTemplate.InvokeAsync()">
                    <i class="bi bi-upload me-1"></i>Cargar Plantilla
                </button>
            }
            else if (!_budgetState!.AddSampleData)
            {
                <button disabled="@_budgetState!.GenerateReport" class="btn btn-outline-success" @onclick="() => OnGenerateReport.InvokeAsync()">
                    <i class="bi bi-file-pdf me-1"></i>Generar Reporte
                </button>
            }
        }
        @if (!OcultarNuevoPresupuesto)
        {
            <button class="btn btn-primary btn-lg" style="border-radius: 50px;" @onclick="() => OnNewCalculation.InvokeAsync()">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Presupuesto
            </button>
        }
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small">Total Mensual</h6>
                        <h2 class="mb-0">S/ @_budgetState!.TotalMonthly.ToString("N2")</h2>
                    </div>
                    <div style="color: #3b82f6;">
                        <i class="bi bi-calculator-fill" style="font-size: 1.2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small">Total Anual</h6>
                        <h2 class="mb-0">S/ @_budgetState!.TotalAnnual.ToString("N2")</h2>
                    </div>
                    <div style="color: #10b981;">
                        <i class="bi bi-calendar-check-fill" style="font-size: 1.2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small">Departamentos</h6>
                        <h2 class="mb-0">@_budgetState!.TotalApartments</h2>
                    </div>
                    <div style="color: #f59e0b;">
                        <i class="bi bi-building-fill" style="font-size: 1.2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-hover">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex flex-column gap-1">
                        <div class="d-flex gap-2">
                            @if (_budgetState!.SaveBudget())
                            {
                                <button class="btn btn-outline-success" @onclick="() => OnSave.InvokeAsync()">
                                    <i class="bi bi-save me-1"></i>Guardar
                                </button>
                            }
                            <button disabled="@_budgetState!.LoadServiceReading" class="btn btn-outline-success" @onclick="() => OnServiceReading.InvokeAsync()">
                                <i class="bi bi-droplet-fill"></i>&nbsp;Cal. Agua
                                </button>
                        </div>
                        @if (_budgetState!.SaveBudget())
                        {
                            <!-- Hasta acá todo vive solo en memoria (BudgetState) — nada se
                                 escribe en la base de datos hasta apretar Guardar. -->
                            <small class="text-warning">
                                <i class="bi bi-exclamation-circle me-1"></i>Sin guardar todavía
                            </small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Models.BudgetState? _budgetState { get; set; }

    [Parameter]
    public EventCallback OnNewCalculation { get; set; }

    [Parameter]
    public EventCallback OnLoadTemplate { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnGenerateReport { get; set; }

    [Parameter]
    public EventCallback OnServiceReading { get; set; }

    private bool TieneDetalles => _budgetState!.Budget.Details.Any(d => !d.IsHeader);

    // Mientras se está creando/editando un presupuesto en borrador (Created/Rejected),
    // "Nuevo Presupuesto" desaparece del header — abrir otro sin haber guardado o
    // terminado este era justo la confusión reportada. Reaparece una vez que el
    // presupuesto ya está publicado (Active) o en cualquier otro estado posterior, para
    // poder arrancar el siguiente ciclo.
    private bool OcultarNuevoPresupuesto =>
        _budgetState!.Budget.IdBudgetHeader != Guid.Empty &&
        (_budgetState.Status == Models.BudgetStatus.Created || _budgetState.Status == Models.BudgetStatus.Rejected);
}