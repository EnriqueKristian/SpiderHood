@page "/ReconcileInstallments/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation

@code {
    // La conciliación de Ingresos (cuotas) se consolidó en /ReconcileExpenses.
    // Se mantiene esta ruta solo para no romper enlaces/favoritos existentes.
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/ReconcileExpenses", replace: true);
    }
}