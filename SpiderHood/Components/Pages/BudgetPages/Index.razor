                </div>

                <div class="card-body p-0">
 <!-- Tabla de Presupuestos -->
    <div class="table-section">
        @if (isLoading)
        {
            <div class="loading-table">
                <div class="spinner"></div>
                <p>Cargando presupuestos...</p>
            </div>
        }
                        else if (!filteredbudgets.Any())
        {
            <div class="empty-state">
                <i class="fas fa-file-invoice-dollar fa-3x"></i>
                <h3>No hay presupuestos</h3>
                <p>No se encontraron presupuestos con los filtros aplicados.</p>
                <button class="btn btn-primary" @onclick="NuevoPresupuesto">
                    <i class="fas fa-plus"></i> Crear Primer Presupuesto
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="presupuestos-table">
                    <thead>
                        <tr>
                            <!--<th class="col-codigo">CÓDIGO</th>-->
                            <th class="col-mes">MES</th>
                            <th class="col-descripcion">DESCRIPCIÓN</th>
                            
                            <!-- Columnas dinámicas de categorías -->
                            @foreach (var categoria in categoriasActivas.OrderBy(c => c.Nivel))
                            {
                                <th class="col-categoria" style="color: @categoria.Color">
                                    @categoria.ShortDescript.ToUpper()
                                </th>
                            }
                            
                            <th class="col-total">TOTAL</th>
                            <th class="col-estado">ESTADO</th>
                            <th class="col-acciones">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var presupuesto in presupuestosPaginados)
                        {
                            <tr @onclick="() => SeleccionarPresupuesto(presupuesto)" 
                                class="@(selectedBudget?.IdBudgetHeader == presupuesto.IdBudgetHeader ? "selected" : "")">
                                <!--<td class="col-codigo">
                                    <strong>@presupuesto.Codigo</strong>
                                </td>-->
                                <td class="col-mes">@presupuesto.Mes</td>
                                <td class="col-descripcion">@presupuesto.BudgetName</td>
                                
                                <!-- Montos por categoría -->
                                @foreach (var categoria in categoriasActivas.OrderBy(c => c.Nivel))
                                {
                                    var monto = GetMontoCategoria(presupuesto, categoria.IdCategory);
                                    <td class="col-categoria text-right">
                                        <span>S/ @monto.ToString("N2")</span>
                                    </td>
                                }
                                
                                <td class="col-total text-right">
                                    <strong>S/ @presupuesto.Amount.ToString("N2")</strong>
                                </td>
                                <td class="col-estado">
                                    <span class="estado-badge estado-@presupuesto.Status"> <!-- PARAMETRO PADRE -->
                                                    @ParameterService.GetChildParameterDescription(45, (int)presupuesto.Status)
                                    </span>
                                </td>
                                <td class="col-acciones">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary"
                                                            title="Ver Presupuesto"
                                                            @onclick:stopPropagation @onclick="() => VerDetalle(presupuesto)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-secondary"
                                                            title="Editar Presupuesto"
                                                            @onclick:stopPropagation @onclick="() => EditarPresupuesto(presupuesto)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                        @if ( presupuesto.Status == BudgetStatus.Created || presupuesto.Status == BudgetStatus.Rejected || presupuesto.Status == BudgetStatus.Check )
                                                        {
                                                            <button class="btn btn-outline-danger"
                                                                    title="Elimnar Presupuesto"
                                                                    @onclick:stopPropagation @onclick="() => EliminarPresupuesto(presupuesto)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }

                                                    
                                                    <button class="btn btn-outline-success"
                                                            title="Clonar Presupuesto"
                                                            @onclick:stopPropagation @onclick="() => ClonarPresupuesto(presupuesto)">
                                                        <i class="bi bi-copy"></i>
                                                    </button>
                                                </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td colspan="2" class="text-right"><strong>TOTALES:</strong></td>
                            
                            <!-- Totales por categoría -->
                            @foreach (var categoria in categoriasActivas.OrderBy(c => c.Nivel))
                            {
                                var totalCategoria = GetTotalCategoria(categoria.IdCategory);
                                <td class="text-right">
                                    <strong>S/ @totalCategoria.ToString("N2")</strong>
                                </td>
                            }
                            
                            <td class="text-right">
                                <strong class="total-general">S/ @TotalGeneral.ToString("N2")</strong>
                            </td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
                </div>

                <!-- Paginación -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-transparent border-top py-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center">
                            <!-- Información de página -->
                            <div class="text-muted">
                                Página @currentPage de @totalPages •
                                @budgetService._Budgets.Count presupuestos encontrados
                            </div>

                            <!-- Controles de paginación -->
                            <nav aria-label="Paginación de propietarios">
                                <ul class="pagination pagination-sm mb-0">
                                    <!-- Primera página -->
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToFirstPage"
                                           title="Primera página">
                                            <i class="bi bi-chevron-double-left"></i>
                                        </a>
                                    </li>

                                    <!-- Página anterior -->
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToPreviousPage"
                                           title="Página anterior">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Páginas numeradas -->
                                    @foreach (var pageNum in GetPageNumbers())
                                    {
                                        if (pageNum == -1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                                <a class="page-link" @onclick="() => GoToPage(pageNum)">
                                                    @pageNum
                                                </a>
                                            </li>
                                        }
                                    }

                                    <!-- Página siguiente -->
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToNextPage"
                                           title="Página siguiente">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Última página -->
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToLastPage"
                                           title="Última página">
                                            <i class="bi bi-chevron-double-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>

                            <!-- Salto a página -->
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Ir a:</span>
                                <input type="number" class="form-control form-control-sm"
                                       style="width: 70px;"
                                       min="1" max="@totalPages"
                                       @bind="jumpToPage"
                                       @bind:event="oninput" />
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="JumpToPage"
                                        disabled="@((jumpToPage < 1 || jumpToPage > totalPages))">
                                    Ir
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

</div>

<!-- Modal de Detalle de Presupuesto -->
@if (mostrarModalDetalle )
{
    <PresupuestoDetalleModal Presupuesto="budgetDetail"
        Categorias="categoriasActivas"
        OnClose="CerrarModalDetalle"
        OnSave="GuardarCambiosDetalle" />
