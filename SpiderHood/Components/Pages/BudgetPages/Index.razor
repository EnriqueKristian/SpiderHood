<!--    MODAL PARA ELIMINACION DE PRESUPUESTOS   -->
<Modal @ref="modal" Title="Eliminar Presupuesto" UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true">
    <BodyTemplate>
        ¿Esta seguro que desea eliminar el Presupuesto?.
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="DeleteItem">Aceptar</Button>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cancelar</Button>
    </FooterTemplate>
</Modal>


@code {

    // Servicios inyectados
    [Inject] private IBudgetService budgetService { get; set; } = null!;

    // Variables de estado
    private bool isLoading = true;
    private List<Category> categoriasActivas = new();
    private BudgetHeader? selectedBudget = null;
    private BudgetHeader? budgetDetail = null;
    private List<SelectListItem> _availableMonths = new();
    private int _selectedMonth = DateTime.Now.Month; // Mes actual
    private int _selectedYear = DateTime.Now.Year;   // Año actual
    private List<BudgetHeader> filteredbudgets = new();

    // Filtros
    private string searchTerm = "";
    private BudgetStatus selectedEstado = BudgetStatus.All;

    // Variables de paginación
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalRecords = 0;
    private int startRecord = 0;
    private int endRecord = 0;
    private int jumpToPage = 1;
    private List<BudgetHeader> currentPageData = new();

    // Modales
    private bool mostrarModalDetalle = false;
    private Modal modal = default!;

    // Datos calculados
    private List<BudgetHeader> presupuestosPaginados => 
        filteredbudgets.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private decimal TotalGeneral => filteredbudgets.Sum(p => p.Amount);
    private int TotalActivos => filteredbudgets.Count(p => p.Status == BudgetStatus.Active);

    private List<BudgetSumCategory> SumCategory = new();

    private async Task LoadMonths()
    {
        _availableMonths = await ParameterService.GetMonthList("es-PE");
    }

    private void ChangeYear(int delta)
    {
        _selectedYear += delta;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (ParameterService.CurrentBuilding == null)
            return;

        await CargarDatos();
        await LoadMonths();
        UpdatePagination();
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            budgetService._SelectedBudget = new();

            // Cargar categorías activas
            categoriasActivas = await budgetService.GetCategoriasAsync(ParameterService.CurrentBuilding.IdBuilding, true);

            // Cargar presupuestos
            budgetService._Budgets = await budgetService.GetPresupuestosAsync(ParameterService.CurrentBuilding.IdBuilding);

            
            // Calcular totales por categoría para cada presupuesto
            SumCategory = await budgetService.GetPresupuestosSumAsync(ParameterService.CurrentBuilding.IdBuilding);

            //Aplicar Filtros
            await FiltrarPresupuestos();

            //Calcular Totales
            await CalcularTotales();
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al cargar datos: {ex.Message}");
            Console.WriteLine($"Error al guardar cálculo: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CalcularTotales()
    {
        foreach (var presupuesto in filteredbudgets)
        {
            // Cargar detalles del presupuesto
            var detalles = SumCategory.Where(c => c.IdBudgetHeader == presupuesto.IdBudgetHeader);

            // Calcular total por categoría
            presupuesto.Amount = detalles.Sum(d => d.SumCategory);
        }
    }

    private decimal GetMontoCategoria(BudgetHeader _budget, Guid categoriaId)
    {
        var detallesCategoria = SumCategory.Where(c => c.IdBudgetHeader == _budget.IdBudgetHeader && c.IdParent == categoriaId);
        return detallesCategoria.Sum(d => d.SumCategory);
    }

    private decimal GetTotalCategoria(Guid categoriaId)
    {
        // Calcular total de todos los presupuestos para esta categoría
        decimal total = 0;
        foreach (var presupuesto in filteredbudgets)
        {
            total += GetMontoCategoria(presupuesto, categoriaId);
        }
        return total;
    }

    /*  SECCION PAGINACION   */
    #region Paginacion 

    private void UpdatePagination()
    {
        totalRecords = filteredbudgets.Count;
        totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

        // Ajustar página actual si es necesario
        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }
        else if (currentPage < 1 && totalPages > 0)
        {
            currentPage = 1;
        }

        // Calcular registros a mostrar
        startRecord = totalRecords > 0 ? ((currentPage - 1) * pageSize) + 1 : 0;
        endRecord = Math.Min(currentPage * pageSize, totalRecords);

        // Obtener datos de la página actual
        currentPageData = filteredbudgets
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        // Actualizar jumpToPage
        jumpToPage = currentPage;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            UpdatePagination();
        }
    }

    private void GoToFirstPage() => GoToPage(1);
    private void GoToPreviousPage() => GoToPage(currentPage - 1);
    private void GoToNextPage() => GoToPage(currentPage + 1);
    private void GoToLastPage() => GoToPage(totalPages);
    private void JumpToPage() => GoToPage(jumpToPage);

    private void ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        UpdatePagination();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        int maxPagesToShow = 5;

        if (totalPages <= maxPagesToShow)
        {
            // Mostrar todas las páginas
            for (int i = 1; i <= totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Lógica para mostrar páginas con elipsis
            if (currentPage <= 3)
            {
                // Primeras páginas
                for (int i = 1; i <= 4; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
            else if (currentPage >= totalPages - 2)
            {
                // Últimas páginas
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = totalPages - 3; i <= totalPages; i++)
                {
                    pages.Add(i);
                }
            }
            else
            {
                // En medio
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = currentPage - 1; i <= currentPage + 1; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
        }

        return pages;
    }

    #endregion

    // Métodos de acciones
    private void NuevoPresupuesto()
    {
        Navigation.NavigateTo($"/budgetgenerator");
    }

    private async void VerDetalle(BudgetHeader _budget)
    {
        try
        {
            // Cargar presupuesto completo con detalles
            budgetDetail = await budgetService.GetPresupuestoByIdAsync(_budget.IdBudgetHeader);
            //if (presupuestoDetalle != null)
            //{
            mostrarModalDetalle = true;
            StateHasChanged(); // Forzar renderizado inmedia
            //}
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al cargar detalles: {ex.Message}");
            Console.WriteLine($"Error al ver detalle presupuesto: {ex.Message}");
            throw new Exception();
        }
    }

    private void EditarPresupuesto(BudgetHeader _budget)
    {
        budgetService._SelectedBudget = _budget;
        Navigation.NavigateTo($"/budgetgenerator");
    }

    private async Task DeleteItem()
    {
        // Lógica adicional después de cerrar el modal, si es necesario
        try
        {
            await budgetService.DeletePresupuestoAsync(selectedBudget!.IdBudgetHeader);
            //await toastService.ShowSuccessAsync("Presupuesto eliminado correctamente");
            await CargarDatos();
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al eliminar: {ex.Message}");
            Console.WriteLine($"Error al eliminar presupuesto : {ex.Message}");
        }

        await modal.HideAsync();
        //OnInitialized();
        return;
    }

    private async void EliminarPresupuesto(BudgetHeader _budget)
    {
        selectedBudget = _budget;
        await modal.ShowAsync();
    }

    private async void ClonarPresupuesto(BudgetHeader _budget)
    {
        try
        {
            // Crear nuevo presupuesto basado en el existente
            var nuevoPresupuesto = new BudgetHeader
            {
                BudgetDate = _budget.BudgetDate,
                BudgetName = $"{_budget.BudgetName} (Copia)",
                Status = BudgetStatus.Created,//"Activo",
                CreatedBy = "UsuarioActual" // Obtener del sistema de autenticación
            };

            var creado = await budgetService.CreatePresupuestoAsync(nuevoPresupuesto);

            // Clonar detalles
            foreach (var detalle in _budget.Details)
            {
                var nuevoDetalle = new BudgetDetail
                {
                    IdBudgetHeader = creado.IdBudgetHeader,
                    IdCategory = detalle.IdCategory,
                    Description = detalle.Description,
                    MonthlyAmount = detalle.MonthlyAmount
                    //No = detalle.Notas
                };
                await budgetService.AddDetalleToPresupuestoAsync(nuevoDetalle);
            }

            //await toastService.ShowSuccessAsync("Presupuesto clonado correctamente");
            await CargarDatos();
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al clonar: {ex.Message}");
            Console.WriteLine($"Error al Clonar Presupuesto: {ex.Message}");
        }
    }

    private void SeleccionarPresupuesto(BudgetHeader _budget)
    {
        selectedBudget = _budget;
    }

    // Métodos de modales
    #region Modales
    private void CerrarModalDetalle()
    {
        mostrarModalDetalle = false;
        budgetDetail = null;
    }

    private async Task GuardarCambiosDetalle()
    {
        if (budgetDetail != null)
        {
            try
            {
                await budgetService.UpdatePresupuestoAsync(budgetDetail);
                //await toastService.ShowSuccessAsync("Cambios guardados correctamente");
                await CargarDatos();
            }
            catch (Exception ex)
            {
                //await toastService.ShowErrorAsync($"Error al guardar: {ex.Message}");
                Console.WriteLine($"Error al guardar Cambios Detalle: {ex.Message}");
            }
        }
        CerrarModalDetalle();
    }

    private async Task ExportarPresupuestos()
    {
        try
        {
            // Lógica de exportación
            //await toastService.ShowInfoAsync("Exportación iniciada...");
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al exportar: {ex.Message}");
            Console.WriteLine($"Error al Exportar Presupuesto: {ex.Message}");
        }
    }

    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }
    #endregion

    // Métodos de filtrado
    #region Filtros
    private async Task FiltrarPresupuestos()
    {
        try
        {
            filteredbudgets = budgetService._Budgets
             .Where(p => string.IsNullOrEmpty(searchTerm) ||
                        p.BudgetName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                        p.Mes.Contains(searchTerm, StringComparison.CurrentCultureIgnoreCase))
             .Where(p => selectedEstado == BudgetStatus.All || p.Status == selectedEstado)
             .ToList();

            currentPage = 1; // Volver a primera página
            await CalcularTotales();
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al filtrar: {ex.Message}");
            Console.WriteLine($"Error al guardar cálculo: {ex.Message}");
        }
    }
    // Observadores de cambios en filtros
    private async Task OnSearchTermChanged()
    {
        await FiltrarPresupuestos();
    }

    private async Task OnSelectedMonthChanged()
    {
        await FiltrarPresupuestos();
    }

    private async Task OnSelectedEstadoChanged(string value)
    {
        if (Enum.TryParse<BudgetStatus>(value, out var estado))
        {
            selectedEstado = estado;
            await FiltrarPresupuestos();
        }
        else
        {
            // Manejo de error si el valor no coincide con el enum
            Console.WriteLine($"Valor inválido: {value}");
        }
    }
    #endregion
}