@page "/budgetlist"
@using SpiderHood.Models
@using SpiderHood.Services
@inject ParameterService ParameterService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>SpiderHood - Gestión de Presupuestos</PageTitle>

<style>

    /* Estilos específicos para el sistema de presupuestos */
.presupuestos-container {
    /*background: #f8f9fa;*/
    min-height: 100vh;
}

/* Tabla con columnas dinámicas */
.presupuestos-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

.presupuestos-table th {
    background: #f1f5f9;
    padding: 12px;
    font-weight: 600;
    color: #2c3e50;
    border-bottom: 2px solid #dee2e6;
    position: sticky;
    top: 0;
    z-index: 10;
}

.presupuestos-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #eee;
}

.presupuestos-table tr:hover {
    background-color: rgba(52, 152, 219, 0.05);
}

.presupuestos-table tr.selected {
    background-color: rgba(52, 152, 219, 0.1);
    border-left: 3px solid #3498db;
}

/* Columnas específicas */
.col-codigo { width: 120px; }
.col-mes { width: 150px; }
.col-descripcion { min-width: 260px; }
.col-categoria { min-width: 120px; }
.col-total { min-width: 110px; }
.col-estado { width: 120px; }
.col-acciones { width: 100px; }

/* Badges de estado */
.estado-badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

    .estado-Active {
        background-color: rgba(39, 174, 96, 0.1);
        color: #27ae60;
    }

    .estado-Closed {
        background-color: rgba(52, 152, 219, 0.1);
        color: #3498db;
    }

    .estado-Created {
    background-color: rgba(243, 156, 18, 0.1);
    color: #f39c12;
    }

/* Botones de acción */

.btn-icon {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-view { color: #3498db; }
.btn-view:hover { background-color: rgba(52, 152, 219, 0.1); }

.btn-edit { color: #f39c12; }
.btn-edit:hover { background-color: rgba(243, 156, 18, 0.1); }

.btn-delete { color: #e74c3c; }
.btn-delete:hover { background-color: rgba(231, 76, 60, 0.1); }

.btn-clone { color: #9b59b6; }
.btn-clone:hover { background-color: rgba(155, 89, 182, 0.1); }

.btn-edit-sm, .btn-delete-sm {
    width: 28px;
    height: 28px;
    font-size: 12px;
}

/* Tarjetas de categorías en modal */


    .categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .category-card {
        background-color: #f9fafc;
        border-radius: 12px;
        transition: transform 0.3s, box-shadow 0.3s;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.03);
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
        }

        .category-card:nth-child(1) {
            border-color: #4a6fa5;
        }

        .category-card:nth-child(2) {
            border-color: #6a8eae;
        }

        .category-card:nth-child(3) {
            border-color: #8fb8de;
        }

        .category-card:nth-child(4) {
            border-color: #b8d4e3;
        }

        .category-card:nth-child(5) {
            border-color: #1e3c72;
        }

    .category-header {
        
        padding: 10px;
        color: white;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .category-name {
        font-weight: 600;
        color: #2c3e50;
        font-size: 1.1rem;
    }

    .category-percentage {
        background-color: rgba(30, 60, 114, 0.1);
        color: #1e3c72;
        padding: 4px 12px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .category-amount {
        font-size: 1.8rem;
        font-weight: 700;
        color: #1e3c72;
        margin-bottom: 10px;
    }

    .progress-bar {
        height: 8px;
        background-color: #eef2f7;
        border-radius: 4px;
        overflow: hidden;
        margin-top: 15px;
    }

    .progress-fill {
        height: 100%;
        border-radius: 4px;
    }

    .category-card:nth-child(1) .progress-fill {
        width: 24.1%;
        background-color: #4a6fa5;
    }

    .total-summary {
        background: linear-gradient(to right, #f8fafd, #eef2f7);
        border-radius: 12px;
        padding: 25px;
        margin-top: 30px;
        text-align: center;
        border: 1px solid #e1e8f0;
    }

    .total-label {
        font-size: 1.1rem;
        color: #5a6c7d;
        margin-bottom: 10px;
    }

    .total-amount {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1e3c72;
    }

    /*
.category-card {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    overflow: hidden;
}

.category-header {
    padding: 10px;
    color: white;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.category-body {
    padding: 15px;
    text-align: center;
}

.category-amount {
    font-size: 20px;
    font-weight: 700;
    color: #2c3e50;
}

.category-percentage {
    font-size: 14px;
    color: #7f8c8d;
}

