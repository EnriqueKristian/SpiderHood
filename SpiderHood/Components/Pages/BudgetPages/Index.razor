@page "/budgetlist"
@using SpiderHood.Models
@using SpiderHood.Services
@inject ParameterService ParameterService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>SpiderHood - Gestión de Presupuestos</PageTitle>


<div class="presupuestos-container">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Lista de Presupuestos </h1>
            <p class="text-muted mb-0">Listado de Presupuestos</p>
        </div>
        <!-- Botones de Acción -->
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="ExportarPresupuestos">
                <i class="bi bi-upload me-1"></i>Exportar
            </button>
            <button class="btn btn-primary btn-lg" style="border-radius: 50px;" @onclick="NuevoPresupuesto">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Presupuesto
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card card-hover">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small">Total Presupuestos:</h6>
                            <h2 class="mb-0">@filteredbudgets.Count</h2>
                        </div>
                        <div style="color: #3b82f6;">
                            <i class="bi bi-calculator-fill" style="font-size: 1.2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-hover">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small">Total Cerrados</h6>
                            <h2 class="mb-0">@TotalActivos</h2>
                        </div>
                        <div style="color: #10b981;">
                            <i class="bi bi-calendar-check-fill" style="font-size: 1.2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-hover">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small">Total General</h6>
                            <h2 class="mb-0">S/ @TotalGeneral.ToString("N2")</h2>
                        </div>
                        <div style="color: #f59e0b;">
                            <i class="bi bi-building-fill" style="font-size: 1.2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">
                                <i class="bi bi-list-columns me-2"></i>Lista de Presupuestos
                            </h5>
                            <p class="text-muted mb-0 small">
                                Mostrando @startRecord - @endRecord de @totalRecords registros
                            </p>
                        </div>
                        <div class="search-box">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="search-input"
                                   placeholder="Buscar presupuesto por código o descripción..."
                                   @bind="searchTerm"
                                   @bind:event="oninput"
                                   @onchange="OnSearchTermChanged" />
                        </div>
                        <div class="d-flex gap-2">
                            <!-- Selector de página -->
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-muted">Estado:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => OnSelectedEstadoChanged(e.Value!.ToString()!)">
                                    <option value=@BudgetStatus.All>Todos</option>
                                    <!--  PARAMETRO PADRE  -->
                                    @foreach (var item in ParameterService.ListParameters.Where(c => c.IdParent == 45))
                                    {
                                        <option value="@item.Value">@item.ShortDescription</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <!-- Selector de página -->
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-muted">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                    <!option value="10" selected="@(pageSize == 10)">10</!option>
                                    <!option value="25" selected="@(pageSize == 25)">25</!option>
                                    <!option value="50" selected="@(pageSize == 50)">50</!option>
                                    <!option value="100" selected="@(pageSize == 100)">100</!option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <!-- Tabla de Presupuestos -->
                    <div class="table-section">
                        @if (isLoading)
                        {
                            <div class="loading-table">
                                <div class="spinner"></div>
                                <p>Cargando presupuestos...</p>
                            </div>
                        }
                        else if (!filteredbudgets.Any())
                        {
                            <div class="empty-state">
                                <i class="bi bi-receipt bi-3x"></i>
                                <h3>No hay presupuestos</h3>
                                <p>No se encontraron presupuestos con los filtros aplicados.</p>
                                <button class="btn btn-primary" @onclick="NuevoPresupuesto">
                                    <i class="bi bi-plus"></i> Crear Primer Presupuesto
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="presupuestos-table">
                                    <thead>
                                        <tr>
                                            <!--<th class="col-codigo">CÓDIGO</th>-->
                                            <th class="col-mes">MES</th>
                                            <th class="col-descripcion">DESCRIPCIÓN</th>

                                            <!-- Columnas dinámicas de categorías -->
                                            @foreach (var categoria in categoriasActivas.OrderBy(c => c.Nivel))
                                            {
                                                <th class="col-categoria" style="color: @categoria.Color">
                                                    @categoria.ShortDescript.ToUpper()
                                                </th>
                                            }

                                            <th class="col-total">TOTAL</th>
                                            <th class="col-estado">ESTADO</th>
                                            <th class="col-acciones">ACCIONES</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var presupuesto in presupuestosPaginados)
                                        {
                                            <tr @onclick="() => SeleccionarPresupuesto(presupuesto)"
                                                class="@(selectedBudget?.IdBudgetHeader == presupuesto.IdBudgetHeader ? "selected" : "")">
                                                <!--<td class="col-codigo">
                                    <strong>@presupuesto.Codigo</strong>
                                </td>-->
                                                <td class="col-mes">@presupuesto.Mes</td>
                                                <td class="col-descripcion">@presupuesto.BudgetName</td>

                                                <!-- Montos por categoría -->
                                                @foreach (var categoria in categoriasActivas.OrderBy(c => c.Nivel))
                                                {
                                                    var monto = GetMontoCategoria(presupuesto, categoria.IdCategory);
                                                    <td class="col-categoria text-right">
                                                        <span>S/ @monto.ToString("N2")</span>
                                                    </td>
                                                }

                                                <td class="col-total text-right">
                                                    <strong>S/ @presupuesto.Amount.ToString("N2")</strong>
                                                </td>
                                                <td class="col-estado">
                                                    <span class="estado-badge estado-@presupuesto.Status">
                                                        <!-- PARAMETRO PADRE -->
                                                        @ParameterService.GetChildParameterDescription(45, (int)presupuesto.Status)
                                                    </span>
                                                </td>
                                                <td class="col-acciones">
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-secondary"
                                                                title="Ver Presupuesto"
                                                                @onclick:stopPropagation @onclick="() => VerDetalle(presupuesto)">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button class="btn btn-outline-secondary"
                                                                title="Editar Presupuesto"
                                                                @onclick:stopPropagation @onclick="() => EditarPresupuesto(presupuesto)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        @if (presupuesto.Status == BudgetStatus.Created || presupuesto.Status == BudgetStatus.Rejected || presupuesto.Status == BudgetStatus.Check)
                                                        {
                                                            <button class="btn btn-outline-danger"
                                                                    title="Elimnar Presupuesto"
                                                                    @onclick:stopPropagation @onclick="() => EliminarPresupuesto(presupuesto)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }

                                                    
                                                        <button class="btn btn-outline-success"
                                                                title="Clonar Presupuesto"
                                                                @onclick:stopPropagation @onclick="() => ClonarPresupuesto(presupuesto)">
                                                            <i class="bi bi-copy"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="total-row">
                                            <td colspan="2" class="text-right"><strong>TOTALES:</strong></td>

                                            <!-- Totales por categoría -->
                                            @foreach (var categoria in categoriasActivas.OrderBy(c => c.Nivel))
                                            {
                                                var totalCategoria = GetTotalCategoria(categoria.IdCategory);
                                                <td class="text-right">
                                                    <strong>S/ @totalCategoria.ToString("N2")</strong>
                                                </td>
                                            }

                                            <td class="text-right">
                                                <strong class="total-general">S/ @TotalGeneral.ToString("N2")</strong>
                                            </td>
                                            <td colspan="2"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- Paginación -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-transparent border-top py-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center">
                            <!-- Información de página -->
                            <div class="text-muted">
                                Página @currentPage de @totalPages •
                                @budgetService._Budgets.Count presupuestos encontrados
                            </div>

                            <!-- Controles de paginación -->
                            <nav aria-label="Paginación de propietarios">
                                <ul class="pagination pagination-sm mb-0">
                                    <!-- Primera página -->
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToFirstPage"
                                           title="Primera página">
                                            <i class="bi bi-chevron-double-left"></i>
                                        </a>
                                    </li>

                                    <!-- Página anterior -->
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToPreviousPage"
                                           title="Página anterior">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Páginas numeradas -->
                                    @foreach (var pageNum in GetPageNumbers())
                                    {
                                        if (pageNum == -1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                                <a class="page-link" @onclick="() => GoToPage(pageNum)">
                                                    @pageNum
                                                </a>
                                            </li>
                                        }
                                    }

                                    <!-- Página siguiente -->
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToNextPage"
                                           title="Página siguiente">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Última página -->
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToLastPage"
                                           title="Última página">
                                            <i class="bi bi-chevron-double-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>

                            <!-- Salto a página -->
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Ir a:</span>
                                <input type="number" class="form-control form-control-sm"
                                       style="width: 70px;"
                                       min="1" max="@totalPages"
                                       @bind="jumpToPage"
                                       @bind:event="oninput" />
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="JumpToPage"
                                        disabled="@((jumpToPage < 1 || jumpToPage > totalPages))">
                                    Ir
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

</div>

<!-- Modal de Detalle de Presupuesto -->
@if (mostrarModalDetalle)
{
    <PresupuestoDetalleModal Presupuesto="budgetDetail"
                             Categorias="categoriasActivas"
                             OnClose="CerrarModalDetalle"
                             OnSave="GuardarCambiosDetalle" />
}


<!--    MODAL PARA ELIMINACION DE PRESUPUESTOS   -->
<Modal @ref="modal" Title="Eliminar Presupuesto" UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true">
    <BodyTemplate>
        ¿Esta seguro que desea eliminar el Presupuesto?.
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="DeleteItem">Aceptar</Button>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cancelar</Button>
    </FooterTemplate>
</Modal>


@code {

    // Servicios inyectados
    [Inject] private IBudgetService budgetService { get; set; } = null!;

    // Variables de estado
    private bool isLoading = true;
    private List<Category> categoriasActivas = new();
    private BudgetHeader? selectedBudget = null;
    private BudgetHeader? budgetDetail = null;
    private List<SelectListItem> _availableMonths = new();
    private int _selectedMonth = DateTime.Now.Month; // Mes actual
    private int _selectedYear = DateTime.Now.Year;   // Año actual
    private List<BudgetHeader> filteredbudgets = new();

    // Filtros
    private string searchTerm = "";
    private BudgetStatus selectedEstado = BudgetStatus.All;

    // Variables de paginación
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalRecords = 0;
    private int startRecord = 0;
    private int endRecord = 0;
    private int jumpToPage = 1;
    private List<BudgetHeader> currentPageData = new();

    // Modales
    private bool mostrarModalDetalle = false;
    private Modal modal = default!;

    // Datos calculados
    private List<BudgetHeader> presupuestosPaginados =>
        filteredbudgets.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private decimal TotalGeneral => filteredbudgets.Sum(p => p.Amount);
    private int TotalActivos => filteredbudgets.Count(p => p.Status == BudgetStatus.Active);

    private List<BudgetSumCategory> SumCategory = new();

    private async Task LoadMonths()
    {
        _availableMonths = await ParameterService.GetMonthList("es-PE");
    }

    private void ChangeYear(int delta)
    {
        _selectedYear += delta;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // ParameterService.CurrentBuilding se asigna en HeaderMainLayout.OnAfterRenderAsync,
        // que corre DESPUÉS de este OnInitializedAsync en el primer render del circuito.
        // Sin esperar, esta página se quedaba con el spinner de carga para siempre en la
        // primera navegación tras el login. Reintentamos brevemente antes de rendirnos.
        //
        // El prerenderizado estático (SSR) corre este método completo — reintentos incluidos
        // — ANTES de mandar el primer HTML al navegador, y en esa pasada CurrentBuilding
        // nunca se llega a setear (HeaderMainLayout.OnAfterRenderAsync no corre durante
        // prerenderizado). O sea que el HTML inicial ya llega en el estado "sin datos", no
        // en el spinner. Forzamos un render aquí para que, en la pasada interactiva real, el
        // usuario vea "Cargando presupuestos..." desde el primer instante en vez de quedarse
        // viendo el HTML prerenderizado sin cambios durante los ~3s que dura el retry.
        isLoading = true;
        StateHasChanged();
        var attempts = 0;
        while (ParameterService.CurrentBuilding == null && attempts < 20)
        {
            await Task.Delay(10);
            attempts++;
            Console.WriteLine($"Index razor. Intento nro: {attempts}");
        }

        if (ParameterService.CurrentBuilding == null)
        {
            isLoading = false;
            return;
        }
        // ParameterService._listParameters (de donde sale la descripción de ESTADO, vía
        // GetChildParameterDescription) solo se carga hoy desde Home.razor, Owners.razor o
        // ParameterPage.razor — ninguna de las tres corre necesariamente antes que esta
        // página. Si el usuario llega aquí sin haber pasado antes por el Dashboard en este
        // mismo circuito, _listParameters queda vacío y CADA fila de la tabla muestra "No se
        // encontro coincidencia", sin importar el estado real. Lo cargamos explícitamente
        // acá (usa caché si Home ya lo hizo, así que no duplica la consulta en ese caso).
        await ParameterService.LoadParametersAsync(ParameterService.CurrentBuilding.IdBuilding);

        await CargarDatos();
        await LoadMonths();
        UpdatePagination();
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            budgetService._SelectedBudget = new();

            // Cargar categorías activas
            categoriasActivas = await budgetService.GetCategoriasAsync(ParameterService.CurrentBuilding.IdBuilding, true);

            // Cargar presupuestos
            budgetService._Budgets = await budgetService.GetPresupuestosAsync(ParameterService.CurrentBuilding.IdBuilding);

            
            // Calcular totales por categoría para cada presupuesto
            SumCategory = await budgetService.GetPresupuestosSumAsync(ParameterService.CurrentBuilding.IdBuilding);

            //Aplicar Filtros
            await FiltrarPresupuestos();

            //Calcular Totales
            await CalcularTotales();
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al cargar datos: {ex.Message}");
            Console.WriteLine($"Error al guardar cálculo: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CalcularTotales()
    {
        foreach (var presupuesto in filteredbudgets)
        {
            // Cargar detalles del presupuesto
            var detalles = SumCategory.Where(c => c.IdBudgetHeader == presupuesto.IdBudgetHeader);

            // Calcular total por categoría
            presupuesto.Amount = detalles.Sum(d => d.SumCategory);
        }
    }

    private decimal GetMontoCategoria(BudgetHeader _budget, Guid categoriaId)
    {
        var detallesCategoria = SumCategory.Where(c => c.IdBudgetHeader == _budget.IdBudgetHeader && c.IdParent == categoriaId);
        return detallesCategoria.Sum(d => d.SumCategory);
    }

    private decimal GetTotalCategoria(Guid categoriaId)
    {
        // Calcular total de todos los presupuestos para esta categoría
        decimal total = 0;
        foreach (var presupuesto in filteredbudgets)
        {
            total += GetMontoCategoria(presupuesto, categoriaId);
        }
        return total;
    }

    /*  SECCION PAGINACION   */
    #region Paginacion

    private void UpdatePagination()
    {
        totalRecords = filteredbudgets.Count;
        totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

        // Ajustar página actual si es necesario
        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }
        else if (currentPage < 1 && totalPages > 0)
        {
            currentPage = 1;
        }

        // Calcular registros a mostrar
        startRecord = totalRecords > 0 ? ((currentPage - 1) * pageSize) + 1 : 0;
        endRecord = Math.Min(currentPage * pageSize, totalRecords);

        // Obtener datos de la página actual
        currentPageData = filteredbudgets
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        // Actualizar jumpToPage
        jumpToPage = currentPage;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            UpdatePagination();
        }
    }

    private void GoToFirstPage() => GoToPage(1);
    private void GoToPreviousPage() => GoToPage(currentPage - 1);
    private void GoToNextPage() => GoToPage(currentPage + 1);
    private void GoToLastPage() => GoToPage(totalPages);
    private void JumpToPage() => GoToPage(jumpToPage);

    private void ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        UpdatePagination();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        int maxPagesToShow = 5;

        if (totalPages <= maxPagesToShow)
        {
            // Mostrar todas las páginas
            for (int i = 1; i <= totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Lógica para mostrar páginas con elipsis
            if (currentPage <= 3)
            {
                // Primeras páginas
                for (int i = 1; i <= 4; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
            else if (currentPage >= totalPages - 2)
            {
                // Últimas páginas
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = totalPages - 3; i <= totalPages; i++)
                {
                    pages.Add(i);
                }
            }
            else
            {
                // En medio
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = currentPage - 1; i <= currentPage + 1; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
        }

        return pages;
    }

    #endregion

    // Métodos de acciones
    private void NuevoPresupuesto()
    {
        Navigation.NavigateTo($"/budgetgenerator");
    }

    private async void VerDetalle(BudgetHeader _budget)
    {
        try
        {
            // Cargar presupuesto completo con detalles
            budgetDetail = await budgetService.GetPresupuestoByIdAsync(_budget.IdBudgetHeader);
            //if (presupuestoDetalle != null)
            //{
            mostrarModalDetalle = true;
            StateHasChanged(); // Forzar renderizado inmedia
            //}
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al cargar detalles: {ex.Message}");
            Console.WriteLine($"Error al ver detalle presupuesto: {ex.Message}");
            throw new Exception();
        }
    }

    private void EditarPresupuesto(BudgetHeader _budget)
    {
        budgetService._SelectedBudget = _budget;
        Navigation.NavigateTo($"/budgetgenerator");
    }

    private async Task DeleteItem()
    {
        // Lógica adicional después de cerrar el modal, si es necesario
        try
        {
            await budgetService.DeletePresupuestoAsync(selectedBudget!.IdBudgetHeader);
            //await toastService.ShowSuccessAsync("Presupuesto eliminado correctamente");
            await CargarDatos();
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al eliminar: {ex.Message}");
            Console.WriteLine($"Error al eliminar presupuesto : {ex.Message}");
        }

        await modal.HideAsync();
        //OnInitialized();
        return;
    }

    private async void EliminarPresupuesto(BudgetHeader _budget)
    {
        selectedBudget = _budget;
        await modal.ShowAsync();
    }

    private async void ClonarPresupuesto(BudgetHeader _budget)
    {
        try
        {
            // Crear nuevo presupuesto basado en el existente
            var nuevoPresupuesto = new BudgetHeader
            {
                BudgetDate = _budget.BudgetDate,
                BudgetName = $"{_budget.BudgetName} (Copia)",
                Status = BudgetStatus.Created,//"Activo",
                IdBuilding = _budget.IdBuilding,
                CreatedBy = "UsuarioActual" // Obtener del sistema de autenticación
            };

            var creado = await budgetService.CreatePresupuestoAsync(nuevoPresupuesto);

            // La fila viene de la lista paginada, que no trae los detalles cargados;
            // hay que pedirlos aparte para poder clonarlos.
            var detallesOrigen = _budget.Details.Any()
                ? _budget.Details
                : await budgetService.GetBudgetDetailAsync(_budget.IdBudgetHeader);

            // Clonar detalles
            foreach (var detalle in detallesOrigen)
            {
                var nuevoDetalle = new BudgetDetail
                {
                    IdBudgetHeader = creado.IdBudgetHeader,
                    IdCategory = detalle.IdCategory,
                    IdSection = detalle.IdSection,
                    ItemNumber = detalle.ItemNumber,
                    Description = detalle.Description,
                    MonthlyAmount = detalle.MonthlyAmount,
                    AnnualAmount = detalle.AnnualAmount,
                    Frequency = detalle.Frequency,
                    Type = detalle.Type,
                    IsHeader = detalle.IsHeader
                };
                await budgetService.AddDetalleToPresupuestoAsync(nuevoDetalle);
            }

            //await toastService.ShowSuccessAsync("Presupuesto clonado correctamente");
            await CargarDatos();
        }
        catch (Exception ex)
        {
            //await toastService.ShowErrorAsync($"Error al clonar: {ex.Message}");
            Console.WriteLine($"Error al Clonar Presupuesto: {ex.Message}");
        }
    }

