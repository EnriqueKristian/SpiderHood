@page "/installments-list"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@using SpiderHood.Components.Pages.Components
@inject ParameterService ParameterService
@inject IInstallmentService InstallmentService
@inject IBankAccountService BankAccountService
@inject IBudgetService BudgetService
@inject IServiceReadingService ServiceReadingService
@inject IJSRuntime JSRuntime
@inject IBuildingService BuildingService
@inject IExtraChargeService ExtraChargeService

<PageTitle>Listado de Cuotas</PageTitle>

<div class="container-fluid px-4 py-3">
    @* Cabecera + resumen estadístico + filtros pegados arriba al hacer scroll --
       top: 3.5rem porque el header global de la app (.top-row en MainLayout.razor.css)
       ya es sticky con esa altura mínima -- este header de página se pega justo
       debajo, no lo tapa. Mismo patrón usado en /movement/Index.razor. *@
    <div style="position: sticky; top: 3.5rem; z-index: 5; background: var(--sh-surface, #fff);">
        <div class="page-header mb-4">
            <div class="page-header-title">
                <div class="icon-badge">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Listado de Cuotas</h1>
                    <p class="text-muted mb-0">Cuotas de todos los periodos</p>
                </div>
            </div>
        </div>

        @if (!cargando)
        {
                        <!-- Resumen Estadístico -->
                        <div class="row g-0 summary-stats">
                            <div class="col-md-3">
                                <div class="stat-card border-end">
                                    <div class="stat-icon bg-info">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h6>Unidades</h6>
                                        <p class="stat-value">@allInstallments.Select(i => i.IdGroupUnit).Distinct().Count()</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card border-end">
                                    <div class="stat-icon bg-primary">
                                        <i class="bi bi-cash-coin"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h6>Total Cuotas</h6>
                                        <p class="stat-value">@Moneda(allInstallments.Sum(i => i.Amount))</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card border-end">
                                    <div class="stat-icon bg-success">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h6>Total Pagado</h6>
                                        <p class="stat-value">@Moneda(allInstallments.Sum(i => i.AmountPaid))</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card">
                                    <div class="stat-icon bg-warning">
                                        <i class="bi bi-exclamation-circle"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h6>Deuda Total</h6>
                                        <p class="stat-value">@Moneda(allInstallments.Sum(i => i.Debt))</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Filtros -->
                        <div class="table-header d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 border-bottom">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroPeriodoChanged">
                                    <option value="">Todos los periodos</option>
                                    @foreach (var periodo in PeriodosDisponibles())
                                    {
                                        <option value="@periodo.ToString("yyyy-MM-dd")" selected="@(filtroPeriodo == periodo)">
                                            @periodo.ToString("MMM-yy")
                                        </option>
                                    }
                                </select>

                                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroEstadoChanged">
                                    <option value="todos" selected="@(filtroEstado == "todos")">Todos los estados</option>
                                    <option value="pendiente" selected="@(filtroEstado == "pendiente")">Pendientes</option>
                                    <option value="parcial" selected="@(filtroEstado == "parcial")">Parciales</option>
                                    <option value="pagada" selected="@(filtroEstado == "pagada")">Pagadas</option>
                                </select>

                                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroTipoChanged">
                                    <option value="todos" selected="@(filtroTipo == "todos")">Todos los tipos</option>
                                    <option value="ordinaria" selected="@(filtroTipo == "ordinaria")">Ordinaria</option>
                                    <option value="extraordinaria" selected="@(filtroTipo == "extraordinaria")">Extraordinaria</option>
                                    <option value="multa" selected="@(filtroTipo == "multa")">Multa</option>
                                    <option value="mora" selected="@(filtroTipo == "mora")">Mora</option>
                                </select>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <div class="search-box">
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="Buscar unidad, propietario..."
                                           value="@searchTerm"
                                           @oninput="OnSearchInput" />
                                </div>
                                <label class="text-muted mb-0">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                                    <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                                    <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                                    <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                                    <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                                </select>
                            </div>
                        </div>
                    }
                </div>

                @if (cargando)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0">
                    <div class="table-container">
                        @if (!pagination.AllData.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                No hay cuotas registradas.
                            </div>
                        }
                        else if (!pagination.FilteredData.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-search display-4 d-block mb-3"></i>
                                No se encontraron cuotas con los filtros seleccionados.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Unidad</th>
                                            <th>Propietario</th>
                                            <th>Tipo</th>
                                            <th class="text-end">Periodo</th>
                                            <th class="text-end">Vencimiento</th>
                                            <th class="text-end">Total Cuota</th>
                                            <th class="text-end">Pagado</th>
                                            <th class="text-end">Deuda</th>
                                            <th class="text-center">Estado</th>
                                            <th class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in pagination.CurrentPageData)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="apartment-badge bg-primary-subtle text-primary rounded-circle me-2">
                                                            DPTO
                                                        </div>
                                                        <strong>@item.UnitName</strong>
                                                    </div>
                                                </td>
                                                <td>@item.OwnerName</td>
                                                <td>
                                                    <span class="@TipoBadgeClass(item)" title="@item.Concept">@TipoBadgeText(item)</span>
                                                </td>
                                                <td class="text-end">@item.Period.ToString("MMM-yy")</td>
                                                <td class="text-end">@item.DueDate.ToString("dd/MM/yyyy")</td>
                                                <td class="text-end">@Moneda(item.Amount)</td>
                                                <td class="text-end">@Moneda(item.AmountPaid)</td>
                                                <td class="text-end">
                                                    <span class="@GetDeudaClass(item)">@Moneda(item.Debt)</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="@EstadoBadgeClass(item)">@EstadoBadgeText(item)</span>
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetalle(item)">
                                                        <i class="bi bi-eye me-1"></i>Ver Detalle
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="5" class="text-end fw-bold">Totales de la página:</td>
                                            <td class="text-end fw-bold">@Moneda(pagination.CurrentPageData.Sum(i => i.Amount))</td>
                                            <td class="text-end fw-bold">@Moneda(pagination.CurrentPageData.Sum(i => i.AmountPaid))</td>
                                            <td class="text-end fw-bold text-primary">@Moneda(pagination.CurrentPageData.Sum(i => i.Debt))</td>
                                            <td colspan="2"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- Paginación -->
                            @if (pagination.TotalPages > 1)
                            {
                                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top">
                                    <div class="text-muted">
                                        Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords cuotas
                                    </div>

                                    <nav aria-label="Paginación de resultados">
                                        <ul class="pagination pagination-sm mb-0">
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                                    <i class="bi bi-chevron-double-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                                    <i class="bi bi-chevron-left"></i>
                                                </a>
                                            </li>

                                            @foreach (var pageNum in pagination.GetPageNumbers())
                                            {
                                                if (pageNum == -1)
                                                {
                                                    <li class="page-item disabled">
                                                        <span class="page-link">...</span>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                        <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">
                                                            @pageNum
                                                        </a>
                                                    </li>
                                                }
                                            }

                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                                    <i class="bi bi-chevron-double-right"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            }
                        }
                    </div>
                    </div>
                }
    </div>

<InstallmentDetailModal @ref="detalleModal" OnImprimir="ImprimirCuota" OnEnviarAlPropietario="EnviarAlPropietario">
    <ExtraContent>
        @if (selectedInstallment != null)
        {
            <hr />
            <p class="mb-3">
                <span class="text-muted me-2">Estado:</span>
                <span class="@EstadoBadgeClass(selectedInstallment)">@EstadoBadgeText(selectedInstallment)</span>
                <span class="text-muted ms-3 me-2">Deuda:</span>
                <span class="@GetDeudaClass(selectedInstallment)">@Moneda(selectedInstallment.Debt)</span>
            </p>
        }

        @if (selectedInstallment != null &&
             (selectedInstallment.Status == ConcilationType.Parcial || selectedInstallment.Status == ConcilationType.Conciliada))
        {
            <h6 class="mb-2"><i class="bi bi-link-45deg me-1"></i>Transacción asociada</h6>

            @if (cargandoTransacciones)
            {
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
            }
            else if (!transaccionesAsociadas.Any())
            {
                <p class="text-muted mb-0">No se encontró la transacción asociada.</p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th class="text-end">Monto aplicado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pago in transaccionesAsociadas)
                        {
                            <tr>
                                <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@pago.Descripcion</td>
                                <td class="text-end">@Moneda(pago.Monto)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </ExtraContent>
</InstallmentDetailModal>

@code {
    private string Moneda(decimal valor) => valor.FormatoMoneda(ParameterService.CurrentBuilding?.Configuration.Currency);

    private List<Installment> allInstallments = new();
    private InstallmentPagination pagination = new();
    private bool cargando = true;
    private string searchTerm = string.Empty;
    private string filtroEstado = "todos";
    private string filtroTipo = "todos";
    private DateTime? filtroPeriodo = null;

    private InstallmentDetailModal detalleModal = null!;
    private Installment? selectedInstallment;
    private bool cargandoTransacciones;
    private List<PagoAsociado> transaccionesAsociadas = new();

    // Presupuesto/lecturas/excepciones de la cuota actualmente abierta en el modal de
    // detalle — cargados on-demand en VerDetalle (acá no hay un único presupuesto
    // "activo": cada fila puede ser de un periodo distinto) y reusados por Imprimir para
    // no volver a pedirlos.
    private BudgetHeader? budgetActual;
    private List<ServiceReadingDetail> waterReadingsActual = new();
    private List<Exoneration> exonerationsActual = new();

    protected override async Task OnInitializedAsync()
    {
        pagination.OnPaginationChanged += StateHasChanged;
        await CargarCuotasAsync();
    }

    private async Task CargarCuotasAsync()
    {
        if (ParameterService.CurrentBuilding == null)
        {
            pagination.Initialize(new List<Installment>());
            cargando = false;
            return;
        }

        cargando = true;
        StateHasChanged();

        // GetDistributionType (usado por InstallmentDetailModal para la columna Tipo) lee
        // de ParameterService.ListParameters, que arranca vacía hasta que alguna página
        // llama a LoadParametersAsync — hoy lo hacen /budgetlist, Home, etc., pero no
        // /cuotas. Si el usuario entra directo acá sin haber pasado antes por una de esas
        // páginas en esta sesión, la columna Tipo del detalle mostraba "No se encontró
        // coincidencia". LoadParametersAsync ya cachea 5 min por edificio, así que llamarlo
        // de nuevo en cada visita es barato.
        await ParameterService.LoadParametersAsync(ParameterService.CurrentBuilding.IdBuilding);

        // GetInstallmentsByBuildingAsync (no GetPendingInstallmentsAsync): esta página
        // necesita listar y filtrar también por cuotas Pagadas, que GET_PendingInstallments
        // excluye a nivel de SQL (Status <> 1) -- con GetPendingInstallmentsAsync el filtro
        // "Pagadas" del combo de abajo nunca tenía nada que mostrar.
        allInstallments = await InstallmentService.GetInstallmentsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

        pagination.Initialize(allInstallments.OrderByDescending(i => i.Period).ThenBy(i => i.UnitName).ToList());
        AplicarFiltros();

        cargando = false;
    }

    // Resalta la deuda según los días de atraso desde el vencimiento, con los umbrales
    // configurados en el edificio (Configuración > Defaults, Multas y Mora).
    private string GetDeudaClass(Installment item)
    {
        if (item.Debt <= 0)
        {
            return "text-muted";
        }

        var diasAtraso = (DateTime.Today - item.DueDate.Date).Days;
        var config = ParameterService.CurrentBuilding?.Configuration;
        var diasAlerta = config?.DebtWarningDays ?? 30;
        var diasCritico = config?.DebtCriticalDays ?? 60;

        if (diasAtraso > diasCritico)
        {
            return "fw-bold text-debt-critical";
        }

        if (diasAtraso > diasAlerta)
        {
            return "fw-bold text-debt-warning";
        }

        return "fw-bold";
    }

    private IEnumerable<DateTime> PeriodosDisponibles() =>
        allInstallments.Select(i => i.Period.Date).Distinct().OrderByDescending(p => p);

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        pagination.Search(searchTerm);
    }

    private void OnFiltroPeriodoChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        filtroPeriodo = string.IsNullOrEmpty(value) ? null : DateTime.Parse(value);
        AplicarFiltros();
    }

    private void OnFiltroEstadoChanged(ChangeEventArgs e)
    {
        filtroEstado = e.Value?.ToString() ?? "todos";
        AplicarFiltros();
    }

    private void OnFiltroTipoChanged(ChangeEventArgs e)
    {
        filtroTipo = e.Value?.ToString() ?? "todos";
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        pagination.ApplyCustomFilter(item =>
            (filtroPeriodo == null || item.Period.Date == filtroPeriodo.Value.Date)
            && filtroEstado switch
            {
                "pendiente" => item.Status == ConcilationType.NoConciliada,
                "parcial" => item.Status == ConcilationType.Parcial,
                "pagada" => item.Status == ConcilationType.Conciliada,
                _ => true
            }
            && filtroTipo switch
            {
                "ordinaria" => item.Type == InstallmentType.Ordinaria,
                "extraordinaria" => item.Type == InstallmentType.Extraordinaria,
                "multa" => item.Type == InstallmentType.Multa,
                "mora" => item.Type == InstallmentType.Mora,
                _ => true
            });
    }

    private string TipoBadgeClass(Installment item) => item.Type switch
    {
        InstallmentType.Extraordinaria => "badge bg-primary",
        InstallmentType.Multa => "badge bg-danger",
        InstallmentType.Mora => "badge bg-warning text-dark",
        _ => "badge bg-secondary-subtle text-secondary-emphasis"
    };

    private string TipoBadgeText(Installment item) => item.Type switch
    {
        InstallmentType.Extraordinaria => "Extraordinaria",
        InstallmentType.Multa => "Multa",
        InstallmentType.Mora => "Mora",
        _ => "Ordinaria"
    };

    private string EstadoBadgeClass(Installment item) => item.Status switch
    {
        ConcilationType.Conciliada => "badge bg-success",
        ConcilationType.Parcial => "badge bg-info text-dark",
        _ => "badge bg-warning"
    };

    private string EstadoBadgeText(Installment item) => item.Status switch
    {
        ConcilationType.Conciliada => "Pagada",
        ConcilationType.Parcial => "Parcial",
        _ => "Pendiente"
    };

    private async Task VerDetalle(Installment item)
    {
        selectedInstallment = item;
        transaccionesAsociadas = new();

        var tieneConciliacion = item.Status == ConcilationType.Parcial || item.Status == ConcilationType.Conciliada;
        cargandoTransacciones = tieneConciliacion;

        // El desglose por item del presupuesto (tarjeta de propietario + tabla de items +
        // consumo de agua) lo pinta InstallmentDetailModal, el mismo componente que usa
        // Generación de Presupuesto — acá solo se le pasa el presupuesto/lecturas/
        // excepciones del periodo de ESTA cuota puntual (cargados on-demand: a diferencia
        // de esa pantalla, aquí no hay un único presupuesto "activo", cada fila puede ser
        // de un periodo distinto).
        var budget = await BudgetService.GetPresupuestoByIdAsync(item.IdBudgetHeader);
        var waterReadings = await ServiceReadingService.GetServiceReadingDetailbyPeriodAsync(item.Period, ParameterService.CurrentBuilding!.IdBuilding);
        var exonerations = await BudgetService.GetExonerationByBudgetHeaderAsync(item.IdBudgetHeader);

        budgetActual = budget;
        waterReadingsActual = waterReadings;
        exonerationsActual = exonerations;

        await detalleModal.ShowAsync(item, budget, waterReadings, exonerations);

        if (tieneConciliacion && ParameterService.CurrentBuilding != null)
        {
            var pagos = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
            var pagosDeEstaCuota = pagos.Where(p => p.IdInstallment == item.IdInstallment).ToList();

            if (pagosDeEstaCuota.Any())
            {
                // GetStatementDetailsByBuildingAsync ya lo usa la pestaña Detalle de /movement
                // para resolver la transacción bancaria detrás de un pago (no hay un
                // "GetTransactionByIdAsync" suelto en el servicio).
                var detalles = await BankAccountService.GetStatementDetailsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding, null);

                transaccionesAsociadas = pagosDeEstaCuota
                    .Select(p => new PagoAsociado(
                        p.PaymentDate,
                        detalles.FirstOrDefault(d => d.IdStatementDetail == p.IdTransaction)?.Description ?? "Transacción no encontrada",
                        p.Amount))
                    .OrderByDescending(p => p.Fecha)
                    .ToList();
            }

            cargandoTransacciones = false;
            StateHasChanged();
        }
    }

    private async Task ImprimirCuota(Installment item)
    {
        if (budgetActual == null || ParameterService.CurrentBuilding == null)
        {
            return;
        }

        try
        {
            // ParameterService.CurrentBuilding.Configuration viene del login (GET_AllBuildingsConfig),
            // que NO trae BankAccounts ni AdminContact (se cargan aparte, solo cuando se
            // visita y guarda Configuración del Edificio) — por eso el pie del recibo a
            // veces salía con {Banco}/{Titular}/{CorreoADM} vacíos. Se refresca acá con la
            // config completa (BuildingService.GetConfigurationAsync ya arma BankAccounts +
            // contactos + ReceiptFooterText en un solo lugar, mismo método que usa
            // Configuración del Edificio) para que el recibo siempre tenga los datos reales.
            ParameterService.CurrentBuilding.Configuration =
                await BuildingService.GetConfigurationAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Categorías raíz (secciones) del edificio — el generador de recibos las usa
            // para saber si una sección se imprime con detalle o colapsada (ShowDetailInReceipt).
            var categorias = await BudgetService.GetCategoriasAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Cuotas Extraordinarias/Multas/Mora de esta unidad, para que el recibo
            // muestre lo mismo que "Ver Detalle" (solo aplica sobre cuotas Ordinarias).
            var cargosAdicionales = item.Type == InstallmentType.Ordinaria
                ? await ExtraChargeService.GetCargosAdicionalesAsync(ParameterService.CurrentBuilding.IdBuilding, new List<Installment> { item })
                : new List<Installment>();

            var exportService = new InstallmentExportService(
                new List<Installment> { item },
                budgetActual,
                waterReadingsActual,
                exonerationsActual,
                ParameterService.CurrentBuilding,
                categorias,
                cargosAdicionales);

            var pdfBytes = exportService.GenerateReceipt(item);

            await JSRuntime.InvokeVoidAsync("downloadFile",
                Convert.ToBase64String(pdfBytes),
                $"Recibo_{item.UnitName}_{item.Period:yyyyMM}.pdf",
                "application/pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar el recibo: {ex.Message}");
        }
    }

    private void EnviarAlPropietario(Installment item)
    {
        Console.WriteLine($"Enviando cuota al propietario: {item.OwnerName}");
        // Lógica para enviar por email pendiente de implementación (igual que en InstallmentTable.razor).
    }

    private record PagoAsociado(DateTime Fecha, string Descripcion, decimal Monto);
}