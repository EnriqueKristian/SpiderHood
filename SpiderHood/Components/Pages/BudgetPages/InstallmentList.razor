    // Botón "Condonar Deuda" -- solo abre el modal pidiendo motivo; la condonación real
    // ocurre en OnCondonarClose recién si se confirma con un motivo no vacío.
    private void CondonarDeuda(Installment item)
    {
        _cuotaACondonar = item;
        _mensajeCondonar = $"Vas a condonar (perdonar) la deuda de {Moneda(item.Debt)} de la unidad {item.UnitName}, " +
            $"periodo {item.Period:MMM-yy}. La cuota quedará marcada como Condonada, sin registrar ningún pago real. Esta acción no se puede deshacer desde la pantalla.";
        _condonarModal.Show();
    }

    private async Task OnCondonarClose(string? motivo)
    {
        if (motivo == null || _cuotaACondonar == null || ParameterService.CurrentBuilding == null) return;

        var item = _cuotaACondonar;
        _cuotaACondonar = null;

        await InstallmentService.CondonarDeudaAsync(item.IdInstallment);

        var currentUser = await AuthService.GetCurrentUserAsync();
        var performedBy = string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser?.Email ?? "Sistema" : currentUser.FullName;
        await WorkflowAuditService.LogAsync("Installment", item.IdInstallment, WorkflowAction.Waived,
            performedBy, ParameterService.CurrentBuilding.IdBuilding,
            $"Se condonó la deuda de {Moneda(item.Debt)} de la unidad {item.UnitName}, periodo {item.Period:MMM-yy}. Motivo: {motivo}");

        await CargarCuotasAsync();
    }

    private async Task AbrirModalCuotaManual()
    {
        if (ParameterService.CurrentBuilding == null) return;

        var idBuilding = ParameterService.CurrentBuilding.IdBuilding;
        var owners = await BuildingService.GetOwnersByBuildingAsync(idBuilding);
        _grupoInmobiliaria = owners.FirstOrDefault(o => o.IsRealEstateCompanyOwner);

        // Solo presupuestos Ordinarios (BudgetType vacío) -- mismo criterio que
        // ExtraChargeService.GetActiveBudgetAsync -- Extraordinarios/Cargos no aplican acá.
        var presupuestos = await BudgetService.GetBudgetsAsync(idBuilding);
        _budgetsOrdinarios = presupuestos
            .Where(b => string.IsNullOrEmpty(b.BudgetType))
            .OrderByDescending(b => b.BudgetDate)
            .ToList();

        _cuotaManualIdBudgetHeader = string.Empty;
        _cuotaManualMonto = 0;
        _cuotaManualVencimiento = DateTime.Today;
        _cuotaManualMotivo = string.Empty;
        _cuotaManualError = string.Empty;
        _mostrarModalCuotaManual = true;
    }

    private void CerrarModalCuotaManual()
    {
        _mostrarModalCuotaManual = false;
    }

    private async Task GuardarCuotaManual()
    {
        if (_grupoInmobiliaria == null || ParameterService.CurrentBuilding == null) return;

        if (!Guid.TryParse(_cuotaManualIdBudgetHeader, out var idBudgetHeader))
        {
            _cuotaManualError = "Elegí el periodo al que corresponde esta cuota.";
            return;
        }

        if (_cuotaManualMonto <= 0)
        {
            _cuotaManualError = "El monto debe ser mayor a cero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_cuotaManualMotivo))
        {
            _cuotaManualError = "Indicá un motivo -- queda guardado en el historial.";
            return;
        }

        var budget = _budgetsOrdinarios.First(b => b.IdBudgetHeader == idBudgetHeader);
        var currentUser = await AuthService.GetCurrentUserAsync();
        var performedBy = string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser?.Email ?? "Sistema" : currentUser.FullName;

        var cuota = new Installment
        {
            IdInstallment = Guid.NewGuid(),
            IdBudgetHeader = idBudgetHeader,
            Number = _grupoInmobiliaria.GroupNumber,
            UnitName = "Inmobiliaria",
            OwnerName = _grupoInmobiliaria.FirstName,
            CreationDate = DateTime.Now,
            Amount = Math.Round(_cuotaManualMonto, 2),
            Percent = 0,
            TotalArea = _grupoInmobiliaria.TotalArea,
            Period = budget.BudgetDate,
            CreatedBy = performedBy,
            Status = ReconciliationType.NoConciliada,
            IdGroupUnit = _grupoInmobiliaria.IdGroupUnit,
            DueDate = _cuotaManualVencimiento,
            Type = InstallmentType.Ordinaria
        };

        await InstallmentService.AddInstallmentAsync(cuota);

        await WorkflowAuditService.LogAsync("Installment", cuota.IdInstallment, WorkflowAction.ManualCharge,
            performedBy, ParameterService.CurrentBuilding.IdBuilding,
            $"Cuota manual de {Moneda(cuota.Amount)} para Inmobiliaria, periodo {budget.BudgetDate:MMM-yy}. Motivo: {_cuotaManualMotivo}");

        _mostrarModalCuotaManual = false;
        await CargarCuotasAsync();
    }

    private async Task VerDetalle(Installment item)
    {
        selectedInstallment = item;
        transaccionesAsociadas = new();

        var tieneConciliacion = item.Status == ReconciliationType.Parcial || item.Status == ReconciliationType.Conciliada;
        cargandoTransacciones = tieneConciliacion;

        // El desglose por item del presupuesto (tarjeta de propietario + tabla de items +
        // consumo de agua) lo pinta InstallmentDetailModal, el mismo componente que usa
        // Generación de Presupuesto — acá solo se le pasa el presupuesto/lecturas/
        // excepciones del periodo de ESTA cuota puntual (cargados on-demand: a diferencia
        // de esa pantalla, aquí no hay un único presupuesto "activo", cada fila puede ser
        // de un periodo distinto).
        var budget = await BudgetService.GetBudgetByIdAsync(item.IdBudgetHeader);

        // ParameterService.CurrentBuilding.Configuration se hidrata UNA SOLA VEZ al
        // iniciar el circuito (ver comentario en IAuthService.RefreshCurrentUserBuildingsAsync)
        // y de ahí en más solo se refresca en memoria si se visita Configuración del
        // Edificio -- por eso "Agua áreas comunes" podía usar un WaterReadingDefault
        // desactualizado (categoría de agua vieja o recién cambiada) hasta que el
        // usuario entrara a Edificios en la misma sesión. Se refresca acá con la config
        // real, igual que ya hace ImprimirCuota más abajo.
        ParameterService.CurrentBuilding!.Configuration =
            await BuildingService.GetConfigurationAsync(ParameterService.CurrentBuilding.IdBuilding);

        var waterReadings = await ServiceReadingService.GetServiceReadingDetailbyPeriodAsync(item.Period, ParameterService.CurrentBuilding.IdBuilding);
        // Ver el mismo comentario y fix en MyReceipts.razor.VerDetalle.
        var exonerations = await BudgetService.GetExonerationsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

        budgetActual = budget;
        waterReadingsActual = waterReadings;
        exonerationsActual = exonerations;

        await detalleModal.ShowAsync(item, budget, waterReadings, exonerations);

        if (tieneConciliacion && ParameterService.CurrentBuilding != null)
        {
            var pagos = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
            var pagosDeEstaCuota = pagos.Where(p => p.IdInstallment == item.IdInstallment).ToList();

            if (pagosDeEstaCuota.Any())
            {
                // GetStatementDetailsByBuildingAsync ya lo usa la pestaña Detalle de /movement
                // para resolver la transacción bancaria detrás de un pago (no hay un
                // "GetTransactionByIdAsync" suelto en el servicio).
                var detalles = await BankAccountService.GetStatementDetailsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding, null);

                transaccionesAsociadas = pagosDeEstaCuota
                    .Select(p => new PagoAsociado(
                        p.PaymentDate,
                        detalles.FirstOrDefault(d => d.IdStatementDetail == p.IdTransaction)?.Description ?? "Transacción no encontrada",
                        p.Amount))
                    .OrderByDescending(p => p.Fecha)
                    .ToList();
            }

            cargandoTransacciones = false;
            StateHasChanged();
        }
    }

    private async Task ImprimirCuota(Installment item)
    {
        if (budgetActual == null || ParameterService.CurrentBuilding == null)
        {
            return;
        }

        try
        {
            // ParameterService.CurrentBuilding.Configuration viene del login (GET_AllBuildingsConfig),
            // que NO trae BankAccounts ni AdminContact (se cargan aparte, solo cuando se
            // visita y guarda Configuración del Edificio) — por eso el pie del recibo a
            // veces salía con {Banco}/{Titular}/{CorreoADM} vacíos. Se refresca acá con la
            // config completa (BuildingService.GetConfigurationAsync ya arma BankAccounts +
            // contactos + ReceiptFooterText en un solo lugar, mismo método que usa
            // Configuración del Edificio) para que el recibo siempre tenga los datos reales.
            ParameterService.CurrentBuilding.Configuration =
                await BuildingService.GetConfigurationAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Categorías raíz (secciones) del edificio — el generador de recibos las usa
            // para saber si una sección se imprime con detalle o colapsada (ShowDetailInReceipt).
            var categorias = await BudgetService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Cuotas Extraordinarias/Multas/Mora de esta unidad, para que el recibo
            // muestre lo mismo que "Ver Detalle" (solo aplica sobre cuotas Ordinarias).
            var cargosAdicionales = item.Type == InstallmentType.Ordinaria
                ? await ExtraChargeService.GetAdditionalChargesAsync(ParameterService.CurrentBuilding.IdBuilding, new List<Installment> { item })
                : new List<Installment>();

            // Deudas Anteriores: cuotas de periodos previos de esta misma unidad que
            // siguen sin conciliarse, igual que en "Ver Detalle" en pantalla.
            var deudasAnteriores = item.Type == InstallmentType.Ordinaria
                ? await InstallmentService.GetPendingInstallmentsAsync(ParameterService.CurrentBuilding.IdBuilding)
                : new List<Installment>();

            // Docs/Pendientes-Negocio-Consolidado.md #28 -- necesario para no
            // subestimar el desglose Fijo/Agua de cuotas que agrupan más de 1 unidad.
            var owners = await BuildingService.GetOwnersByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Docs/Pendientes-Negocio-Consolidado.md #30, puntos d/e -- logo del
            // encabezado (Edificio o, de respaldo, Account) + nombre de la
            // administradora para la franja "Administrado por...".
            var (logoBytes, _, administradoraName) = await BuildingService.GetReceiptBrandingAsync(ParameterService.CurrentBuilding);

            // Mismo aviso que ya muestra "Ver Detalle" en pantalla -- ver SaldoAFavorCalculator.
            var saldoAFavorNoAplicado = 0m;
            if (item.Type == InstallmentType.Ordinaria)
            {
                var todasLasCuotasUnidad = allInstallments.Where(i => i.IdGroupUnit == item.IdGroupUnit).ToList();
                var pagosCuotasUnidad = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
                var transaccionesEdificio = await BankAccountService.GetStatementDetailsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding, null);
                saldoAFavorNoAplicado = SaldoAFavorCalculator.CalcularNoAplicado(
                    item.IdGroupUnit, todasLasCuotasUnidad, pagosCuotasUnidad, transaccionesEdificio);
            }

            var exportService = new InstallmentExportService(
                new List<Installment> { item },
                budgetActual,
                waterReadingsActual,
                exonerationsActual,
                ParameterService.CurrentBuilding,
                categorias,
                owners,
                cargosAdicionales,
                deudasAnteriores,
                logoBytes,
                administradoraName,
                saldoAFavorNoAplicado);

            // Docs/Pendientes-Negocio-Consolidado.md #18b -- si ya se generó antes,
            // sirve el mismo PDF guardado (no lo recalcula con la configuración
            // vigente hoy del edificio).
            var currentUser = await AuthService.GetCurrentUserAsync();
            var pdfBytes = await ReceiptStorageService.GetOrGenerateReceiptAsync(
                exportService, item, ParameterService.CurrentBuilding.IdBuilding, currentUser?.Email ?? "Sistema");

            await JSRuntime.InvokeVoidAsync("downloadFile",
                Convert.ToBase64String(pdfBytes),
                $"Recibo_{item.UnitName}_{item.Period:yyyyMM}.pdf",
                "application/pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar el recibo: {ex.Message}");
        }
    }

