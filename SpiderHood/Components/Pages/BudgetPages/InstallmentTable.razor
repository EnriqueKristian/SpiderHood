﻿﻿@using SpiderHood.Models
@using System.Globalization
@using SpiderHood.Components.Pages.Components
@using SpiderHood.Utilities
@using Microsoft.AspNetCore.Components.Forms;
@inject SpiderHood.Services.ParameterService ParameterService
@inject IJSRuntime JSRuntime
@inject Services.IBankAccountService BankService
@inject Services.ICategoryService CategoryService
@inject Services.IBuildingService BuildingService

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            @if (!Conciliar)
            {
                <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h5 class="mb-0">
                            <i class="bi bi-calendar3 me-2"></i>
                            Cuota Mensual: @GetNombreMes(Budget!.BudgetDate.Month) @Budget.BudgetDate.Year
                        </h5>
                        <small class="opacity-75">Distribución de gastos por departamento</small>
                    </div>
                    <div class="btn-group" role="group">
                        <button class="btn btn-light btn-sm px-3" @onclick="ExportarPDF" title="Exportar a PDF">
                            <i class="bi bi-file-earmark-pdf text-danger me-1"></i> PDF
                        </button>
                        <button class="btn btn-light btn-sm px-3 ms-2" @onclick="ExportarExcel" title="Exportar a Excel">
                            <i class="bi bi-file-earmark-excel text-success me-1"></i> Excel
                        </button>
                    </div>
                </div>
            }
            <div class="card-body p-0">
                @if (!Conciliar)
                {
                    <!-- Resumen Estadístico -->
                    <div class="row g-0 summary-stats">
                        <div class="col-md-3">
                            <div class="stat-card border-end">
                                <div class="stat-icon bg-info">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Departamentos</h6>
                                    <p class="stat-value">@Installments!.Count</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card border-end">
                                <div class="stat-icon bg-success">
                                    <i class="bi bi-calculator"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Total Presupuesto</h6>
                                    <p class="stat-value">S/ @TotalBudget.ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card border-end">
                                <div class="stat-icon bg-warning">
                                    <i class="bi bi-droplet-fill"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Consumo Agua</h6>
                                    <p class="stat-value">@_totalWaterConsumption.ToString("N2") m³</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card">
                                <div class="stat-icon bg-primary">
                                    <i class="bi bi-cash-coin"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Total Cuotas</h6>
                                    <p class="stat-value">S/ @_TotalInstallments.ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                
                <div class="table-container">
                    <!-- Tabla de Filtros -->
                    <div class="table-header d-flex justify-content-between align-items-center p-3 border-bottom">
                        <h6 class="mb-0 text-muted">
                            <i class="bi bi-list me-2"></i>Cuotas por Unidad
                        </h6>
                        <div class="search-box">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   placeholder="Buscar unidad, dpto..."
                                   @bind="searchTerm"
                                   @oninput="OnSearch" />
                        </div>
                        <!-- Selector de página -->
                        <div class="d-flex align-items-center">
                            <label class="me-2 text-muted">Mostrar:</label>
                            <select class="form-select form-select-sm" style="width: auto;"
                                    @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                <!option value="10" selected="@(pageSize == 10)">10</!option>
                                <!option value="25" selected="@(pageSize == 25)">25</!option>
                                <!option value="50" selected="@(pageSize == 50)">50</!option>
                                <!option value="100" selected="@(pageSize == 100)">100</!option>
                            </select>
                        </div>
                    </div>
                    <!-- Tabla de Cuotas -->
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th width="12%" class="ps-3">
                                        <i class="bi bi-door-closed me-1"></i>Unidad
                                    </th>
                                    <th>
                                        <i class="bi bi-person me-1"></i>Propietario
                                    </th>
                                    @if (Conciliar)
                                    {
                                        <th width="10%" class="text-end">
                                            <i class="bi bi-calendar3"></i>
                                            Periodo
                                        </th>
                                        <th width="14%" class="text-end">
                                            <i class="bi bi-cash me-1"></i>Total Cuota
                                        </th>
                                        <th width="14%" class="text-end">
                                            <i class="bi bi-cash me-1"></i>Deuda
                                        </th>
                                    }
                                    else
                                    {
                                        <th width="10%" class="text-end">
                                            <i class="bi bi-rulers me-1"></i>Área (m²)
                                        </th>
                                        <th width="10%" class="text-end">

                                            <i class="bi bi-percent me-1"></i>
                                            % Área
                                        </th>
                                        <th width="14%" class="text-end">
                                            <i class="bi bi-cash me-1"></i>Total Cuota
                                        </th>
                                    }
                                    <th width="15%" class="text-center">
                                        <i class="bi bi-gear-fill me-1"></i>Acciones
                                    </th>
                                    <th width="8%" class="text-center">
                                        <i class="bi bi-gear-fill me-1"></i>Excep
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (filteredInstallments?.Any() != true)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <i class="bi bi-inbox bi-3x text-muted mb-3"></i>
                                            <p class="text-muted">No se encontraron departamentos</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in _pagination.CurrentPageData!)
                                    {
                                        <tr @onclick="() => installementSelected(item)"
                                            class="@GetRowClass(item)"
                                            style="cursor: pointer;">
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="apartment-badge bg-primary-subtle text-primary rounded-circle  me-2">
                                                        DPTO
                                                    </div>
                                                    <div>
                                                        <strong>@item.UnitName</strong>
                                                        <!--<small class="d-block text-muted">Unidad @item.UnitName</small>-->
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="owner-info">
                                                    <strong>@item.OwnerName</strong>
                                                    @*if (!string.IsNullOrEmpty(item.OwnerEmail))
                                                {
                                                    <small class="d-block text-muted">
                                                        <i class="bi bi-envelope me-1"></i>@item.OwnerEmail
                                                    </small>
                                                }*@
                                                </div>
                                            </td>
                                            @if (!Conciliar)
                                            {
                                                <td class="text-end">
                                                    <span class="badge bg-light text-dark fs-6">
                                                        @item.TotalArea.ToString("N2")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <div class="progress-wrapper">
                                                        <div class="progress" style="height: 18px;">
                                                            <div class="progress-bar bg-info"
                                                                 style="width: @item.Percent%;"
                                                                 role="progressbar">
                                                            </div>
                                                            <small class="text-muted">@item.Percent.ToString("N2") %</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <span class="amount-badge">
                                                        S/ @item.Amount.ToString("N2")
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group" role="group">
                                                        <button class="btn btn-outline-primary btn-sm px-3"
                                                                title="Ver detalles de la cuota"
                                                                @onclick:stopPropagation
                                                                @onclick="() => VerDetalle(item)">
                                                            <i class="bi bi-eye me-1"></i>Detalles
                                                        </button>
                                                        @if (item.IsPaid)
                                                        {
                                                            <span class="badge bg-success ms-2">
                                                                <i class="bi bi-check me-1"></i>Pagado
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @if (HasExceptions(item.IdGroupUnit))
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning"
                                                                title="Ver excepciones"
                                                                @onclick:stopPropagation
                                                                @onclick="() => ShowExceptions(item)">
                                                            <i class="bi bi-exclamation-triangle"></i>
                                                            <span class="badge bg-warning ms-1">
                                                                @GetExceptionCount(item.IdGroupUnit)
                                                            </span>
                                                        </button>
                                                    }
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="text-end">
                                                    <div class="progress-wrapper">
                                                        <small class="text-muted">@item.Period.ToString("MMM-yy")</small>
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <span>
                                                        S/ @item.Amount.ToString("N2")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <span class="amount-badge">
                                                        S/ @item.Debt.ToString("N2")
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    @if (item.PosiblesMatches.Any())
                                                    {
                                                        var cuotasIds = new HashSet<Guid>(transacciones!.Select(g => g.IdStatementHeader));

                                                        @if (item.PosiblesMatches.Where(c => cuotasIds.Contains(c.IdStatementHeader)).Count() > 0)
                                                        {
                                                            <div class="dropdown">
                                                                <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                                                        type="button"
                                                                        data-bs-toggle="dropdown">
                                                                    @item.PosiblesMatches.Where(c => cuotasIds.Contains(c.IdStatementHeader)).Count() posibles matches
                                                                </button>
                                                                <ul class="dropdown-menu">
                                                                    @foreach (var paid in item.PreviousPaid)
                                                                    {
                                                                        <a class="dropdown-item"
                                                                           @onclick="() => ConciliarConCuota(item, paid)">
                                                                            <div class="d-flex justify-content-between">
                                                                                <span>@paid.Description</span>
                                                                                <span class="text-muted">@paid.Balance.ToString("C")</span>
                                                                            </div>
                                                                            <small class="text-muted">@paid.StatementDate.ToString("MMM-dd-yy")</small>
                                                                        </a>
                                                                    }
                                                                    @if (item.PreviousPaid.Count > 0)
                                                                    {
                                                                        <li><hr class="dropdown-divider"></li>
                                                                    }
                                                                    @foreach (var match in item.PosiblesMatches.Where(c => cuotasIds.Contains(c.IdStatementHeader)))
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item"
                                                                               @onclick="() => ConciliarConCuota(item, match)">
                                                                                <div class="d-flex justify-content-between">
                                                                                    <span>@match.Description</span>
                                                                                    <span class="text-muted">@match.Balance.ToString("C")</span>
                                                                                </div>
                                                                                <small class="text-muted">@match.StatementDate.ToString("MMM-dd-yy")</small>
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        @if (item.Status == ConcilationType.NoConciliada)
                                                        {
                                                            <button class="btn btn-outline-primary"
                                                                    title="Conciliar manualmente"
                                                                    disabled="@isDisableSelected"
                                                                    @onclick="() => ShowConciliationModal(item)">
                                                                <i class="bi bi-link-45deg"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-outline-info"
                                                                title="Ver detalles"
                                                                disabled="@isDisableSelected"
                                                                @onclick="() => InstallmentViewDetails(item)">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        @if (item.Status == ConcilationType.Parcial)
                                                        {
                                                            <button class="btn btn-outline-danger"
                                                                    title="Desconciliar"
                                                                    disabled="@isDisableSelected"
                                                                    @onclick="() => UnConciliationModal(item)">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Totales:</td>
                                    <td class="text-end fw-bold">
                                        @Installments!.Sum(x => x.Percent).ToString("N2")%
                                    </td>
                                    <td class="text-end fw-bold text-primary">
                                        S/ @_TotalInstallments.ToString("N2")
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <PaginationControls _pagination="@_pagination" />

                </div>
            </div>
        </div>
    </div>
</div>

<InstallmentDetailModal @ref="viewinstallment" OnImprimir="PrintSingleInstallment" OnEnviarAlPropietario="SendToOwner" />

@if (ShowModalManual)
{
    <ManualIntalmentConciliation cuota="selectedInstallment" transacciones="transacciones!.Where(x => x.Balance > 0).ToList()" ShowModalChanged="CloseModalManual" OnSaveReading="OnSaveManualConciliation" />
}

@code {

    private void CloseModalManual()
    {
        ShowModalManual = false;
        StateHasChanged();
    }

    private void ShowConciliationModal(Installment item)
    {
        ShowModalManual = true;
        StateHasChanged();
    }

    private void InstallmentViewDetails(Installment item)
    {
    }

    private void UnConciliationModal(Installment item)
    {
    }

    private bool isDisableSelected => selectedInstallment == null ? true : false;


    [Parameter] public List<Installment>? Installments { get; set; }
    [Parameter] public List<InstallmentPaid>? InstallmentsPaid { get; set; }
    [Parameter] public BudgetHeader? Budget { get; set; }
    [Parameter] public List<ServiceReadingDetail>? WaterReadings { get; set; }
    [Parameter] public List<Exoneration>? Exonerations { get; set; }
    [Parameter] public decimal TotalBudget { get; set; }
    [Parameter] public bool Conciliar { get; set; } = false;
    [Parameter] public Guid cuentaSeleccionadaId { get; set; }
    [Parameter] public List<TransactionBankDetail>? transacciones { get; set; }

    [Inject]
    public Services.IInstallmentService InstallmentService { get; set; } = default!;

    private Installment? selectedInstallment = null;
    private InstallmentDetailModal viewinstallment = null!;
    private decimal _TotalInstallments => Installments!.Sum(x => x.Amount);
    private decimal _totalWaterConsumption => WaterReadings!.Sum(x => x.CalculatedAmount);

    private string searchTerm = string.Empty;
    private List<Installment> filteredInstallments = new();
    private InstallmentExportService? _exportService;
    private int totalCoincidencias = 0;

    private bool ShowModalManual = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Inicialización de datos si es necesario
            base.OnInitialized();
            filteredInstallments = Installments ?? new List<Installment>();
            _pagination.Initialize(filteredInstallments);
            // Suscribirse a cambios en la paginación
            _pagination.OnPaginationChanged += StateHasChanged;

            if (Conciliar) await BuscarCoincidencias();

            // ParameterService.CurrentBuilding.Configuration viene del login (GET_AllBuildingsConfig),
            // que NO trae BankAccounts ni AdminContact (se cargan aparte, solo cuando se
            // visita y guarda Configuración del Edificio) — por eso el pie del recibo a
            // veces salía con {Banco}/{Titular}/{CorreoADM} vacíos. Se refresca acá con la
            // config completa (BuildingService.GetConfigurationAsync ya arma BankAccounts +
            // contactos + ReceiptFooterText en un solo lugar, mismo método que usa
            // Configuración del Edificio) para que el recibo siempre tenga los datos reales.
            if (ParameterService.CurrentBuilding != null)
            {
                ParameterService.CurrentBuilding.Configuration =
                    await BuildingService.GetConfigurationAsync(ParameterService.CurrentBuilding.IdBuilding);
            }

            // Categorías raíz (secciones) del edificio — el generador de recibos las usa
            // para saber si una sección se imprime con detalle o colapsada (ShowDetailInReceipt).
            var categorias = ParameterService.CurrentBuilding != null
                ? await CategoryService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding)
                : new List<Category>();

            // Inicializar servicio de exportación
            _exportService = new InstallmentExportService(
            Installments!,
            Budget!,
            WaterReadings!,
            Exonerations!,
            ParameterService.CurrentBuilding!,
            categorias
        );


        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during initialization: {ex.Message}");
        }

    }

    private string GetNombreMes(int mes)
    {
        return CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(mes);
    }

    private void PrintSingleInstallment(Installment item)
    {
        // Lógica para exportar a PDF
        //_ = ExportToExcel();
        _ = ExportToSinglePdf(item);
        Console.WriteLine("Exportando a PDF...");
    }

    private async Task ExportToSinglePdf(Installment item)
    {
        try
        {
            // Crear PDF resumen
            var pdfBytes = _exportService!.GenerateReceipt(item);

            await JSRuntime.InvokeVoidAsync("downloadFile",
                Convert.ToBase64String(pdfBytes),
                $"Resumen_Cuotas_{DateTime.Now:yyyyMMdd}.pdf",
                "application/pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar PDF: {ex.Message}");
        }
    }

    private void ExportarExcel()
    {
        // Lógica para exportar a Excel
        Console.WriteLine("Exportando a Excel...");
    }

    private void VerDetalle(Installment _installment)
    {
        selectedInstallment = _installment;
        _ = viewinstallment.ShowAsync(_installment, Budget, WaterReadings, Exonerations);
    }

    private void installementSelected(Installment item)
    {
        selectedInstallment = item;
        StateHasChanged();
    }

    private string GetRowClass(Installment item)
    {
        //var classes = new List<string> { "table-row-hover" };
        var classes = new List<string> { "" };

        if (selectedInstallment?.IdInstallment == item.IdInstallment)
        {
            classes.Add("table-row-selected");
        }

        return string.Join(" ", classes);
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        _pagination.Search(searchTerm);
    }

    private void SendToOwner(Installment item)
    {
        Console.WriteLine($"Enviando cuota al propietario: {item.OwnerName}");
        // Lógica para enviar por email
    }

    private async Task BuscarCoincidencias()
    {
        totalCoincidencias = await InstallmentService.BuscarCoincidencias(Installments!, transacciones!);
    }

    private async Task ConciliarConCuota(Installment cuota, TransactionBankDetail transaccion, bool automatico = false)
    {
        try
        {
            await InstallmentService.ConciliarConCuota(filteredInstallments!, transacciones!, BankService, transaccion, cuota, automatico);

            // Actualizar UI y estado
            await ActualizarEstadoPostConciliacion(automatico);
        }
        catch (Exception ex)
        {
            //await ManejarErrorConciliacion(ex);
            throw new Exception(ex.Message);
        }
    }

    private async Task ActualizarEstadoPostConciliacion(bool automatico)
    {
        // Recalcular estadísticas
        //CalcularEstadisticas();

        // Actualizar listas pendientes
        await ActualizarListasPendientes();

        // Cerrar modal si no es automático
        if (!automatico)
        {
            //CerrarModalConciliar();
            // Mostrar mensaje de éxito
            //MostrarMensajeExito("Transacción conciliada exitosamente");
        }

        // Forzar actualización de UI
        StateHasChanged();
    }

    private async Task ActualizarListasPendientes()
    {
        // Remover transacción conciliada de pendientes
        var cuotaConciliada = filteredInstallments!
                    .FirstOrDefault(t => t.Status == ConcilationType.Conciliada);

        if (cuotaConciliada != null)
        {
            filteredInstallments!.Remove(cuotaConciliada);
        }

        var transacionConciliada = transacciones!
            .FirstOrDefault(t => t.ReconciliationStatus == ConcilationType.Conciliada);

        if (transacionConciliada != null)
        {
            transacciones!.Remove(transacionConciliada);
        }

        _pagination.Initialize(filteredInstallments);
        _pagination.OnPaginationChanged += StateHasChanged;

        await BuscarCoincidencias();

        // Opcional: Recargar cuotas pendientes desde el servidor
        // cuotaspendientes = await InstallmentService.ObtenerCuotasPendientesAsync();
    }

    #region Paginación

    private InstallmentPagination _pagination = new InstallmentPagination();
    //private string searchTerm1 = "";
    private int pageSize = 25;

    private void SortColumn(string column)
    {
        _pagination.SortByColumn(column);
    }

    private void SelectReading(Installment installment)
    {
        // Lógica para seleccionar una lectura
        Console.WriteLine($"Seleccionada lectura: {installment.OwnerName}");
    }

    private void OnPageSizeChanged()
    {
        _pagination.ChangePageSize(pageSize);
    }

    public void Dispose()
    {
        _pagination.OnPaginationChanged -= StateHasChanged;
    }

    private void ChangePageSize(int newSize)
    {
        pageSize = newSize;
        OnPageSizeChanged();
    }

    #endregion

    public bool HasExceptions(Guid idGroupUnit)
    {
        // Lógica para determinar si hay excepciones para el grupo de unidad dado
        // Por ejemplo, podrías verificar en una lista de excepciones
        return false; // Cambiar según la lógica real
    }

    public int GetExceptionCount(Guid idGroupUnit)
    {
        // Lógica para obtener el conteo de excepciones para el grupo de unidad dado
        return 0; // Cambiar según la lógica real
    }

    public void ShowExceptions(Installment installment)
    {
        // Lógica para mostrar las excepciones relacionadas con la cuota
        Console.WriteLine($"Mostrando excepciones para: {installment.OwnerName}");
    }

    private Task ExportarPDF(MouseEventArgs args)
    {
        throw new NotImplementedException();
    }

    private MemoryStream? excelStream;

    private async Task ExportToExcel()
    {
        try
        {
            var excelBytes = _exportService!.ExportToExcel();
            excelStream = new MemoryStream(
                excelBytes
            );

            // Descargar el archivo
            await JSRuntime.InvokeVoidAsync("downloadFile",
                Convert.ToBase64String(excelBytes),
                $"Cuotas_{DateTime.Now:yyyyMMdd}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al exportar a Excel: {ex.Message}");
        }
    }

    private async Task DownloadFileAsync()
    {
        //await JSRuntime.InvokeVoidAsync("downloadFile", /* your parameters here */);
    }

    private async Task OnSaveManualConciliation(TransactionBankDetail _transaction)
    {
        await ConciliarConCuota(selectedInstallment!, _transaction, false);
    }
}