    private decimal CalculateQuote(BudgetDetail item, Installment _selectedInstallment)
    {
        var _total = 0m;

        if (item.IdCategory == ParameterService.CurrentBuilding.Configuration.WaterReadingDefault && _waterReadingsCount > 0)
        {
            _total += Math.Abs(item.MonthlyAmount - _totalWaterConsumption) * _inverseNroGroupUnit;//wateritem!.CalculatedAmount;
        }
        else
        {
            var _nroException = Exonerations!.Count(c => c.IdCategory == item.IdCategory);

            if (_selectedInstallment!.IdGroupUnit == Exonerations!.Where(c => c.IdCategory == item.IdCategory).Select(c => c.IdGroupUnit).FirstOrDefault())
            {
                _total += 0;
            }
            else
            {
                _total += item.Type == 1 ? item.MonthlyAmount / (ParameterService.CurrentBuilding.Apartments - _nroException) : item.MonthlyAmount * _distr;
            }
        }
        return Math.Round(_total,2);
        //return _total;

    }

