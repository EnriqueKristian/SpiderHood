    private async Task ActualizarListasPendientes()
    {
        // Remover transacción conciliada de pendientes
        var cuotaConciliada = filteredInstallments!
                    .FirstOrDefault(t => t.Status == ConcilationType.Conciliada);

        if (cuotaConciliada != null)
        {
            filteredInstallments!.Remove(cuotaConciliada);
        }

        var transacionConciliada = transacciones!
            .FirstOrDefault(t => t.ReconciliationStatus == ConcilationType.Conciliada);

        if (transacionConciliada != null)
        {
            transacciones!.Remove(transacionConciliada);
        }

        _pagination.Initialize(filteredInstallments);
        _pagination.OnPaginationChanged += StateHasChanged;

        await BuscarCoincidencias();

        // Opcional: Recargar cuotas pendientes desde el servidor
