@page "/cuotas"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@inject ParameterService ParameterService
@inject IInstallmentService InstallmentService
@inject IBankAccountService BankAccountService
@inject IBudgetService BudgetService
@inject IServiceReadingService ServiceReadingService

<PageTitle>Listado de Cuotas</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-12 col-xl-11">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-receipt display-6 me-2"></i>
                        <div>
                            <h1 class="h3 mb-1">Listado de Cuotas</h1>
                            <p class="mb-0 opacity-75">Cuotas pendientes de pago de todos los periodos</p>
                        </div>
                    </div>
                </div>

                @if (cargando)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Resumen Estadístico -->
                    <div class="row g-0 summary-stats">
                        <div class="col-md-3">
                            <div class="stat-card border-end">
                                <div class="stat-icon bg-info">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Unidades</h6>
                                    <p class="stat-value">@allInstallments.Select(i => i.IdGroupUnit).Distinct().Count()</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card border-end">
                                <div class="stat-icon bg-primary">
                                    <i class="bi bi-cash-coin"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Total Cuotas</h6>
                                    <p class="stat-value">S/ @allInstallments.Sum(i => i.Amount).ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card border-end">
                                <div class="stat-icon bg-success">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Total Pagado</h6>
                                    <p class="stat-value">S/ @allInstallments.Sum(i => i.AmountPaid).ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card">
                                <div class="stat-icon bg-warning">
                                    <i class="bi bi-exclamation-circle"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>Deuda Total</h6>
                                    <p class="stat-value">S/ @allInstallments.Sum(i => i.Debt).ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-container">
                        <!-- Filtros -->
                        <div class="table-header d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 border-bottom">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroPeriodoChanged">
                                    <option value="">Todos los periodos</option>
                                    @foreach (var periodo in PeriodosDisponibles())
                                    {
                                        <option value="@periodo.ToString("yyyy-MM-dd")" selected="@(filtroPeriodo == periodo)">
                                            @periodo.ToString("MMM-yy")
                                        </option>
                                    }
                                </select>

                                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroEstadoChanged">
                                    <option value="todos" selected="@(filtroEstado == "todos")">Todos los estados</option>
                                    <option value="pendiente" selected="@(filtroEstado == "pendiente")">Pendientes</option>
                                    <option value="parcial" selected="@(filtroEstado == "parcial")">Parciales</option>
                                    <option value="pagada" selected="@(filtroEstado == "pagada")">Pagadas</option>
                                </select>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <div class="search-box">
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="Buscar unidad, propietario..."
                                           value="@searchTerm"
                                           @oninput="OnSearchInput" />
                                </div>
                                <label class="text-muted mb-0">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                                    <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                                    <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                                    <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                                    <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                                </select>
                            </div>
                        </div>

                        @if (!pagination.AllData.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                No hay cuotas registradas.
                            </div>
                        }
                        else if (!pagination.FilteredData.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-search display-4 d-block mb-3"></i>
                                No se encontraron cuotas con los filtros seleccionados.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Unidad</th>
                                            <th>Propietario</th>
                                            <th class="text-end">Periodo</th>
                                            <th class="text-end">Vencimiento</th>
                                            <th class="text-end">Total Cuota</th>
                                            <th class="text-end">Pagado</th>
                                            <th class="text-end">Deuda</th>
                                            <th class="text-center">Estado</th>
                                            <th class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in pagination.CurrentPageData)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="apartment-badge bg-primary-subtle text-primary rounded-circle me-2">
                                                            DPTO
                                                        </div>
                                                        <strong>@item.UnitName</strong>
                                                    </div>
                                                </td>
                                                <td>@item.OwnerName</td>
                                                <td class="text-end">@item.Period.ToString("MMM-yy")</td>
                                                <td class="text-end">@item.DueDate.ToString("dd/MM/yyyy")</td>
                                                <td class="text-end">S/ @item.Amount.ToString("N2")</td>
                                                <td class="text-end">S/ @item.AmountPaid.ToString("N2")</td>
                                                <td class="text-end">
                                                    <span class="@GetDeudaClass(item)">S/ @item.Debt.ToString("N2")</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="@EstadoBadgeClass(item)">@EstadoBadgeText(item)</span>
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetalle(item)">
                                                        <i class="bi bi-eye me-1"></i>Ver Detalle
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="4" class="text-end fw-bold">Totales de la página:</td>
                                            <td class="text-end fw-bold">S/ @pagination.CurrentPageData.Sum(i => i.Amount).ToString("N2")</td>
                                            <td class="text-end fw-bold">S/ @pagination.CurrentPageData.Sum(i => i.AmountPaid).ToString("N2")</td>
                                            <td class="text-end fw-bold text-primary">S/ @pagination.CurrentPageData.Sum(i => i.Debt).ToString("N2")</td>
                                            <td colspan="2"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- Paginación -->
                            @if (pagination.TotalPages > 1)
                            {
                                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top">
                                    <div class="text-muted">
                                        Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords cuotas
                                    </div>

                                    <nav aria-label="Paginación de resultados">
                                        <ul class="pagination pagination-sm mb-0">
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                                    <i class="bi bi-chevron-double-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                                    <i class="bi bi-chevron-left"></i>
                                                </a>
                                            </li>

                                            @foreach (var pageNum in pagination.GetPageNumbers())
                                            {
                                                if (pageNum == -1)
                                                {
                                                    <li class="page-item disabled">
                                                        <span class="page-link">...</span>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                        <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">
                                                            @pageNum
                                                        </a>
                                                    </li>
                                                }
                                            }

                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                                    <i class="bi bi-chevron-double-right"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<Modal @ref="detalleModal" Title="Detalle de Cuota" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        @if (cargandoDetalle)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (selectedInstallment != null)
        {
            <!-- Resumen del propietario, igual que el modal de Generación de Presupuesto -->
            <div class="owner-summary p-3 rounded mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <h6><i class="bi bi-person me-2"></i>Propietario</h6>
                        <p class="fs-5 fw-bold mb-1">@selectedInstallment.OwnerName</p>
                        <span class="@EstadoBadgeClass(selectedInstallment)">@EstadoBadgeText(selectedInstallment)</span>
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="info-card">
                                    <small class="text-muted">Área Total</small>
                                    <p class="fw-bold mb-0">@selectedInstallment.TotalArea.ToString("N2") m²</p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-card">
                                    <small class="text-muted">% Distribución</small>
                                    <p class="fw-bold mb-0">@selectedInstallment.Percent.ToString("N2")%</p>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="info-card bg-primary-subtle">
                                    <small class="text-muted">Total Cuota</small>
                                    <p class="fs-4 fw-bold text-primary mb-0">S/ @selectedInstallment.Amount.ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (selectedBudget == null)
            {
                <p class="text-muted">No se encontró el presupuesto de este periodo para desglosar la cuota.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 40%">Descripción</th>
                                <th style="width: 15%" class="text-end">Presupuesto</th>
                                <th style="width: 15%" class="text-end">Cuota</th>
                                <th style="width: 15%" class="text-center">Tipo</th>
                                <th style="width: 10%" class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ decimal totalCuotaCalculada = 0; }

                            @foreach (var section in GetSecciones())
                            {
                                var sectionItems = selectedBudget!.Details.Where(x => x.IdSection == section.Id && !x.IsHeader).ToList();

                                @if (sectionItems.Any())
                                {
                                    <tr class="section-header">
                                        <td colspan="6">
                                            <div class="d-flex align-items-center py-1">
                                                <i class="bi bi-folder me-2 text-primary"></i>
                                                <strong class="text-primary">@section.Name</strong>
                                                <span class="badge bg-secondary ms-2">@sectionItems.Count items</span>
                                            </div>
                                        </td>
                                    </tr>

                                    @foreach (var item in sectionItems)
                                    {
                                        var itemAmount = CalcularCuotaItem(item);
                                        totalCuotaCalculada += itemAmount;

                                        <tr>
                                            <td class="text-center"><span class="badge bg-secondary">@item.ItemNumber</span></td>
                                            <td><strong>@item.Description</strong></td>
                                            <td class="text-end">S/ @item.MonthlyAmount.ToString("N2")</td>
                                            <td class="text-end"><span class="fw-bold text-success">S/ @itemAmount.ToString("N2")</span></td>
                                            <td class="text-center">
                                                <span class="badge @GetTipoBadgeClass(item.Type)">@GetDistributionType(item.Type)</span>
                                            </td>
                                            <td class="text-center"><i class="bi bi-check-circle text-success"></i></td>
                                        </tr>

                                        @if (item.IdCategory == ParameterService.CurrentBuilding!.Configuration.WaterReadingDefault)
                                        {
                                            var waterReading = selectedWaterReadings?.FirstOrDefault(c => c.IdGroupUnit == selectedInstallment.IdGroupUnit);
                                            if (waterReading != null)
                                            {
                                                totalCuotaCalculada += waterReading.CalculatedAmount;

                                                <tr class="water-reading-row bg-info-subtle">
                                                    <td></td>
                                                    <td colspan="2">
                                                        <div class="water-consumption">
                                                            <h6 class="mb-2"><i class="bi bi-droplet-fill me-2"></i>Consumo de Agua</h6>
                                                            <div class="row">
                                                                <div class="col-4">
                                                                    <small class="text-muted">Lectura Anterior</small>
                                                                    <p class="fw-bold mb-0">@waterReading.PreviousReading</p>
                                                                </div>
                                                                <div class="col-4">
                                                                    <small class="text-muted">Lectura Actual</small>
                                                                    <p class="fw-bold mb-0">@waterReading.CurrentReading</p>
                                                                </div>
                                                                <div class="col-4">
                                                                    <small class="text-muted">Consumo</small>
                                                                    <p class="fw-bold mb-0">@waterReading.Consumption m³</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-end" valign="middle">
                                                        <span class="fw-bold">S/ @waterReading.CalculatedAmount.ToString("N2")</span>
                                                    </td>
                                                    <td class="text-center" valign="middle">
                                                        <span class="badge bg-info"><i class="bi bi-droplet-fill me-1"></i>Agua</span>
                                                    </td>
                                                    <td></td>
                                                </tr>
                                            }
                                        }
                                    }
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold py-2"><i class="bi bi-calculator me-2"></i>TOTAL CUOTA:</td>
                                <td class="text-end py-2"><span class="fs-5 fw-bold text-primary">S/ @totalCuotaCalculada.ToString("N2")</span></td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @if (selectedInstallment.Status == ConcilationType.Parcial || selectedInstallment.Status == ConcilationType.Conciliada)
            {
                <hr />
                <h6 class="mb-2"><i class="bi bi-link-45deg me-1"></i>Transacción asociada</h6>

                @if (cargandoTransacciones)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                }
                else if (!transaccionesAsociadas.Any())
                {
                    <p class="text-muted mb-0">No se encontró la transacción asociada.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Descripción</th>
                                <th class="text-end">Monto aplicado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in transaccionesAsociadas)
                            {
                                <tr>
                                    <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@pago.Descripcion</td>
                                    <td class="text-end">S/ @pago.Monto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="() => detalleModal.HideAsync()">
            <i class="bi bi-x-lg me-1"></i>Cerrar
        </button>
    </FooterTemplate>
</Modal>

@code {
    private List<Installment> allInstallments = new();
    private InstallmentPagination pagination = new();
    private bool cargando = true;
    private string searchTerm = string.Empty;
    private string filtroEstado = "todos";
    private DateTime? filtroPeriodo = null;

    private Modal detalleModal = null!;
    private Installment? selectedInstallment;
    private BudgetHeader? selectedBudget;
    private List<ServiceReadingDetail>? selectedWaterReadings;
    private List<Exoneration> selectedExonerations = new();
    private bool cargandoDetalle;
    private bool cargandoTransacciones;
    private List<PagoAsociado> transaccionesAsociadas = new();

    // Usados por CalcularCuotaItem, igual que InstallmentTable.razor (BudgetGenerator).
    private decimal _distr;
    private int _waterReadingsCount;
    private decimal _inverseNroGroupUnit;
    private decimal _totalWaterConsumption => selectedWaterReadings?.Sum(w => w.CalculatedAmount) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        pagination.OnPaginationChanged += StateHasChanged;
        await CargarCuotasAsync();
    }

    private async Task CargarCuotasAsync()
    {
        if (ParameterService.CurrentBuilding == null)
        {
            pagination.Initialize(new List<Installment>());
            cargando = false;
            return;
        }

        cargando = true;
        StateHasChanged();

        allInstallments = await InstallmentService.GetPendingInstallmentsAsync(ParameterService.CurrentBuilding.IdBuilding);

        pagination.Initialize(allInstallments.OrderByDescending(i => i.Period).ThenBy(i => i.UnitName).ToList());
        AplicarFiltros();

        cargando = false;
    }

    // Resalta la deuda según los días de atraso desde el vencimiento, con los umbrales
    // configurados en el edificio (Configuración > Defaults, Multas y Mora).
    private string GetDeudaClass(Installment item)
    {
        if (item.Debt <= 0)
        {
            return "text-muted";
        }

        var diasAtraso = (DateTime.Today - item.DueDate.Date).Days;
        var config = ParameterService.CurrentBuilding?.Configuration;
        var diasAlerta = config?.DebtWarningDays ?? 30;
        var diasCritico = config?.DebtCriticalDays ?? 60;

        if (diasAtraso > diasCritico)
        {
            return "fw-bold text-debt-critical";
        }

        if (diasAtraso > diasAlerta)
        {
            return "fw-bold text-debt-warning";
        }

        return "fw-bold";
    }

    private IEnumerable<DateTime> PeriodosDisponibles() =>
        allInstallments.Select(i => i.Period.Date).Distinct().OrderByDescending(p => p);

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        pagination.Search(searchTerm);
    }

    private void OnFiltroPeriodoChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        filtroPeriodo = string.IsNullOrEmpty(value) ? null : DateTime.Parse(value);
        AplicarFiltros();
    }

    private void OnFiltroEstadoChanged(ChangeEventArgs e)
    {
        filtroEstado = e.Value?.ToString() ?? "todos";
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        pagination.ApplyCustomFilter(item =>
            (filtroPeriodo == null || item.Period.Date == filtroPeriodo.Value.Date)
            && filtroEstado switch
            {
                "pendiente" => item.Status == ConcilationType.NoConciliada,
                "parcial" => item.Status == ConcilationType.Parcial,
                "pagada" => item.Status == ConcilationType.Conciliada,
                _ => true
            });
    }

    private string EstadoBadgeClass(Installment item) => item.Status switch
    {
        ConcilationType.Conciliada => "badge bg-success",
        ConcilationType.Parcial => "badge bg-info text-dark",
        _ => "badge bg-warning"
    };

    private string EstadoBadgeText(Installment item) => item.Status switch
    {
        ConcilationType.Conciliada => "Pagada",
        ConcilationType.Parcial => "Parcial",
        _ => "Pendiente"
    };

    private async Task VerDetalle(Installment item)
    {
        selectedInstallment = item;
        selectedBudget = null;
        selectedWaterReadings = null;
        selectedExonerations = new();
        transaccionesAsociadas = new();
        cargandoDetalle = true;

        var tieneConciliacion = item.Status == ConcilationType.Parcial || item.Status == ConcilationType.Conciliada;
        cargandoTransacciones = tieneConciliacion;

        await detalleModal.ShowAsync();

        // Desglose de la cuota: el mismo presupuesto/lecturas/excepciones que usa el modal
        // "Detalle de Cuota" de Generación de Presupuesto (InstallmentTable.razor), pero
        // cargados on-demand para el periodo de ESTA cuota puntual (acá no hay un único
        // presupuesto "activo" como en esa pantalla, cada fila puede ser de un periodo
        // distinto).
        selectedBudget = await BudgetService.GetPresupuestoByIdAsync(item.IdBudgetHeader);
        selectedWaterReadings = await ServiceReadingService.GetServiceReadingDetailbyPeriodAsync(item.Period);
        selectedExonerations = await BudgetService.GetExonerationByBudgetHeaderAsync(item.IdBudgetHeader);

        _distr = item.Percent / 100;
        _waterReadingsCount = selectedWaterReadings?.Count ?? 0;
        _inverseNroGroupUnit = ParameterService.CurrentBuilding!.Apartments > 0
            ? 1m / ParameterService.CurrentBuilding.Apartments
            : 0;

        cargandoDetalle = false;

        if (tieneConciliacion)
        {
            var pagos = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
            var pagosDeEstaCuota = pagos.Where(p => p.IdInstallment == item.IdInstallment).ToList();

            if (pagosDeEstaCuota.Any())
            {
                // GetStatementDetailsByBuildingAsync ya lo usa la pestaña Detalle de /movement
                // para resolver la transacción bancaria detrás de un pago (no hay un
                // "GetTransactionByIdAsync" suelto en el servicio).
                var detalles = await BankAccountService.GetStatementDetailsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding, null);

                transaccionesAsociadas = pagosDeEstaCuota
                    .Select(p => new PagoAsociado(
                        p.PaymentDate,
                        detalles.FirstOrDefault(d => d.IdStatementDetail == p.IdTransaction)?.Description ?? "Transacción no encontrada",
                        p.Amount))
                    .OrderByDescending(p => p.Fecha)
                    .ToList();
            }

            cargandoTransacciones = false;
        }

        StateHasChanged();
    }

    private List<SectionInfo> GetSecciones()
    {
        if (selectedBudget?.Details == null)
        {
            return new();
        }

        return selectedBudget.Details
            .Where(x => x.IsHeader)
            .Select(x => new SectionInfo { Id = x.IdSection, Name = x.Description, IdCategory = x.IdCategory })
            .OrderBy(x => x.Id)
            .ToList();
    }

    // Misma fórmula que InstallmentTable.CalculateQuote (BudgetGenerator): distribución fija
    // (Type 1) o por porcentaje de área (Type 2), con excepción total si la unidad está
    // exonerada de esa categoría, y la categoría de agua se calcula aparte (ver el bloque
    // de "Consumo de Agua" en el markup).
    private decimal CalcularCuotaItem(BudgetDetail item)
    {
        if (selectedInstallment == null)
        {
            return 0;
        }

        if (item.IdCategory == ParameterService.CurrentBuilding!.Configuration.WaterReadingDefault && _waterReadingsCount > 0)
        {
            return Math.Round(Math.Abs(item.MonthlyAmount - _totalWaterConsumption) * _inverseNroGroupUnit, 2);
        }

        var idGroupUnitExonerado = selectedExonerations
            .Where(c => c.IdCategory == item.IdCategory)
            .Select(c => c.IdGroupUnit)
            .FirstOrDefault();

        if (selectedInstallment.IdGroupUnit == idGroupUnitExonerado)
        {
            return 0;
        }

        var nroExcepciones = selectedExonerations.Count(c => c.IdCategory == item.IdCategory);
        var total = item.Type == 1
            ? item.MonthlyAmount / (ParameterService.CurrentBuilding.Apartments - nroExcepciones)
            : item.MonthlyAmount * _distr;

        return Math.Round(total, 2);
    }

    private string GetTipoBadgeClass(int type) => type switch
    {
        1 => "bg-success",
        2 => "bg-primary",
        3 => "bg-warning text-dark",
        4 => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private string GetDistributionType(int value) => ParameterService.GetChildParameterDescription(8, value);

    private record PagoAsociado(DateTime Fecha, string Descripcion, decimal Monto);
}
