@using SpiderHood.Components.Pages.Components
@using SpiderHood.Models
@inherits LayoutComponentBase

@if (ShowModal)
{
<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg">
            <div class="modal-header">
                    <i class="fas fa-water mr-2"></i><h5 class="modal-title">Lectura de Agua: @_period.ToString("MMMM-yy")</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                    <SpiderHood.Components.Pages.WaterCalculationPages.BlockWaterReading @ref="LecturaBloqueRef" _period="_period" OnSaveReady="UpdateStatus" />
            </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary" @onclick="CerrarModal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary"
                            @onclick='() => ExecuteWithConfirmation(SaveData, "Guardar Lectura", "¿Guardar las lecturas procesadas?", "info")'
                            disabled="@IsDisabledToSave">
                        Save
                    </button>
                </div>
            
        </div>
    </div>
</div>
}

<!-- Agregar al final del componente -->
<ConfirmationModal @ref="_confirmationModal" 
                   OnClose="OnConfirmationResult" />

@code {

    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public DateTime _period { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    [Parameter] public EventCallback<List<ServiceReadingDetail>> OnSaveReading { get; set; }

    private bool IsDisabledToSave = true;
    private WaterCalculationPages.BlockWaterReading? LecturaBloqueRef;
    private ConfirmationModal? _confirmationModal;
    private decimal TotalAmount = 0;
    private ConfirmationUtil util = new ConfirmationUtil();
    private List<Models.ServiceReadingDetail> WaterReadingDetail = [];

    private async Task CerrarModal()
    {
        ShowModal = false;
        await ShowModalChanged.InvokeAsync(ShowModal);
    }

    private Task SaveData()
    {
        // Aquí procesas lo que el modal envió
        LecturaBloqueRef?.GuardarLectura();
        ShowModal = false;
        OnSaveReading.InvokeAsync(WaterReadingDetail);
        return Task.CompletedTask;
    }

    private Task UpdateStatus(Models.ServiceReadingState value)
    {
        IsDisabledToSave = !value.ShowSaveReadings;
        WaterReadingDetail = value.CurrentReadingDetail;
        return Task.CompletedTask;
    }

    private async Task ExecuteWithConfirmation(Func<Task> action, string actionName, string message = "", string type = "warning")
    {
        await util.ExecuteWithConfirmation(action, actionName, _confirmationModal, message, type);
    }

    private async Task OnConfirmationResult(bool confirmed)
    {
        await util.OnConfirmationResult(confirmed);
    }
}