@page "/buildings/{IdBuilding:guid}/config"
@rendermode InteractiveServer
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using SpiderHood.Models
@inject Services.AuthService AuthService
@inject NavigationManager Navigation
@inject Services.ParameterService ParameterService
@inject Services.IPermissionService PermissionService
@inject IJSRuntime JSRuntime

<div class="building-management">
    @if (SelectedBuilding == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="page-header">
            <div class="page-header-title">
                <div class="icon-badge">
                    <i class="bi bi-building-gear"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Configuración: @SelectedBuilding.Name</h1>
                    <p class="text-muted mb-0">Edificio #@SelectedBuilding.Number -- @SelectedBuilding.Location</p>
                </div>
            </div>
            <div class="page-header-actions">
                @if (_canEditBuilding)
                {
                    <button class="btn btn-outline-secondary me-2" @onclick="() => ShowQuickConfig(SelectedBuilding)">
                        <i class="bi bi-copy me-1"></i>Configuración Rápida
                    </button>
                }
                <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/buildings")'>
                    <i class="bi bi-arrow-left me-1"></i>Volver a Edificios
                </button>
            </div>
        </div>

        <div class="card card-hover building-active">
            <div class="card-body">
                <EditForm Model="SelectedBuilding.Configuration" OnValidSubmit="SaveConfiguration">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <!-- Tabs -- la configuración de un edificio se está extendiendo, y con todo
                         apilado en una sola columna se hacía difícil de navegar y de notar qué
                         faltaba. Cada pestaña mantiene su misma lógica interna de edición por
                         sección (StartEditSection/SaveSection/CancelEdit) sin cambios. -->
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "currency" ? "active" : "")" @onclick='() => ActiveTab = "currency"'>
                                <i class="bi bi-currency-exchange me-2"></i>Moneda y Cuentas
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "payments" ? "active" : "")" @onclick='() => ActiveTab = "payments"'>
                                <i class="bi bi-credit-card me-2"></i>Pagos
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "fines" ? "active" : "")" @onclick='() => ActiveTab = "fines"'>
                                <i class="bi bi-exclamation-triangle me-2"></i>Defaults, Multas y Mora
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "admin" ? "active" : "")" @onclick='() => ActiveTab = "admin"'>
                                <i class="bi bi-person-lines-fill me-2"></i>Administración
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "realty" ? "active" : "")" @onclick='() => ActiveTab = "realty"'>
                                <i class="bi bi-building me-2"></i>Inmobiliaria
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "maintenance" ? "active" : "")" @onclick='() => ActiveTab = "maintenance"'>
                                <i class="bi bi-tools me-2"></i>Mantenimiento
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "category" ? "active" : "")" @onclick='() => ActiveTab = "category"'>
                                <i class="bi bi-tags me-2"></i>Categorías Default
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "exception" ? "active" : "")" @onclick='() => ActiveTab = "exception"'>
                                <i class="bi bi-shield-exclamation me-2"></i>Excepciones de Pago
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(ActiveTab == "areacomun" ? "active" : "")" @onclick='() => ActiveTab = "areacomun"'>
                                <i class="bi bi-calendar-check me-2"></i>Áreas Comunes
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content pt-3">
                        @if (ActiveTab == "currency")
                        {
                            <!-- Sección Moneda y Bancos -->
                            <div class="card card-hover config-card @(_editingSection == "currency" ? "edit-mode" : "")">
                                <div class="card-body">
                                    @if (_canEditBuilding)
                                    {
                                        <div class="edit-button">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    @onclick='() => StartEditSection("currency")'>
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    }

                                    <h6 class="section-title">
                                        <i class="bi bi-currency-exchange me-2"></i>Moneda y Cuentas
                                    </h6>

                                    @if (_editingSection == "currency")
                                    {
                                        <div class="form-compact">
                                            <div class="form-group">
                                                <label class="form-label">Moneda Principal</label>
                                                <div class="d-flex gap-2">
                                                    @foreach (var currency in _currencies)
                                                    {
                                                        <div class="currency-selector @(SelectedBuilding.Configuration.Currency == currency.Code ? "selected" : "")"
                                                             @onclick="() => SelectedBuilding.Configuration.Currency = currency.Code">
                                                            <span class="fw-semibold">@currency.Symbol</span>
                                                            <span class="text-muted">@currency.Name</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Cuentas Bancarias</label>
                                                <div>
                                                    @for (int i = 0; i < SelectedBuilding.Configuration.BankAccounts.Count; i++)
                                                    {
                                                        var index = i;
                                                        <div class="d-flex align-items-center mb-2">
                                                            <InputText @bind-Value="SelectedBuilding.Configuration.BankAccounts[index].BankName"
                                                                       class="form-control form-control-sm me-2"
                                                                       placeholder="Nombre del banco" />
                                                            <InputText @bind-Value="SelectedBuilding.Configuration.BankAccounts[index].AccountNumber"
                                                                       class="form-control form-control-sm me-2"
                                                                       placeholder="Número de cuenta" />
                                                            <InputText @bind-Value="SelectedBuilding.Configuration.BankAccounts[index].AccountName"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Titular de la cuenta" />
                                                            <button type="button" class="btn btn-outline-secondary"
                                                                    @onclick="() => EditBankAccount(index)"
                                                                    title="Editar (incluye marcar Activa/Inactiva)">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                            @if (SelectedBuilding.Configuration.BankAccounts.Count > 1)
                                                            {
                                                                <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                                                                        @onclick="() => RemoveBankAccount(index)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                                            @onclick="AddBankAccount">
                                                        <i class="bi bi-plus"></i> Agregar cuenta
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="action-buttons">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("currency")'>
                                                    <i class="bi bi-check"></i> Guardar
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-3">
                                            <label class="form-label small text-muted">Moneda Principal</label>
                                            <div class="fw-semibold">
                                                @(SelectedBuilding.Configuration.Currency == "PEN" ? "S/ (Soles)" :
                                                  SelectedBuilding.Configuration.Currency == "USD" ? "$ (Dólares)" : SelectedBuilding.Configuration.Currency)
                                            </div>
                                        </div>
                                        <div>
                                            <label class="form-label small text-muted">Cuentas Bancarias</label>
                                            <div>
                                                @foreach (var account in SelectedBuilding.Configuration.BankAccounts)
                                                {
                                                    <div class="d-flex align-items-center mb-2">
                                                        <i class="bi bi-bank text-primary me-2"></i>
                                                        <div>
                                                            <div class="fw-semibold">
                                                                @account.BankName
                                                                @if (account.Status == 1)
                                                                {
                                                                    <span class="badge bg-success ms-1">Activa</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary ms-1">Inactiva</span>
                                                                }
                                                            </div>
                                                            <div class="text-muted small">Cuenta: @account.AccountNumber</div>
                                                            @if (!string.IsNullOrWhiteSpace(account.AccountName))
                                                            {
                                                                <div class="text-muted small">Titular: @account.AccountName</div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(account.CCI))
                                                            {
                                                                <div class="text-muted small">CCI: @account.CCI</div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (ActiveTab == "payments")
                        {
                            <!-- Sección Pagos -->
                            <div class="card card-hover config-card @(_editingSection == "payments" ? "edit-mode" : "")">
                                <div class="card-body">
                                    @if (_canEditBuilding)
                                    {
                                        <div class="edit-button">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    @onclick='() => StartEditSection("payments")'>
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    }

                                    <h6 class="section-title">
                                        <i class="bi bi-credit-card me-2"></i>Configuración de Pagos
                                    </h6>

                                    @if (_editingSection == "payments")
                                    {
                                        <div class="form-compact">
                                            <div class="form-group">
                                                <label class="form-label">Métodos de Pago</label>
                                                <div class="payment-methods">
                                                    @foreach (var method in _paymentMethods)
                                                    {
                                                        <div class="payment-method-tag @(SelectedBuilding.Configuration.PaymentMethods.Contains(method) ? "selected" : "")"
                                                             @onclick="() => TogglePaymentMethod(method)">
                                                            @method
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Periodo de Pago</label>
                                                        <select @bind-Value="SelectedBuilding.Configuration.PaymentPeriod" @bind-Value:event="oninput" class="form-select form-select-sm">
                                                            <option value=1>Mensual</option>
                                                            <option value=2>Bimestral</option>
                                                            <option value=3>Trimestral</option>
                                                            <option value=4>Semestral</option>
                                                            <option value=5>Anual</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Día de Vencimiento</label>
                                                        <InputNumber @bind-Value="SelectedBuilding.Configuration.DueDay"
                                                                    class="form-control form-control-sm"
                                                                    min="1" max="31" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="action-buttons">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("payments")'>
                                                    <i class="bi bi-check"></i> Guardar
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label class="form-label small text-muted">Métodos de Pago</label>
                                                <div>
                                                    @foreach (var method in SelectedBuilding.Configuration.PaymentMethods)
                                                    {
                                                        <span class="badge bg-success me-2 mb-1">@method</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Periodo de Pago</label>
                                                <div class="fw-semibold">@SelectedBuilding.Configuration.PaymentPeriod</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Día de Vencimiento</label>
                                                <div class="fw-semibold">@SelectedBuilding.Configuration.DueDay de cada mes</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (ActiveTab == "fines")
                        {
                            <!-- Sección Multas y Mora -->
                            <div class="card card-hover config-card @(_editingSection == "fines" ? "edit-mode" : "")">
                                <div class="card-body">
                                    @if (_canEditBuilding)
                                    {
                                        <div class="edit-button">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    @onclick='() => StartEditSection("fines")'>
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    }

                                    <h6 class="section-title">
                                        <i class="bi bi-exclamation-triangle me-2"></i>Defaults, Multas y Mora
                                    </h6>

                                    @if (_editingSection == "fines")
                                    {
                                        <div class="form-compact">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Consumo Mínimo</label>
                                                        <div class="input-group input-group-sm">
                                                            <InputNumber @bind-Value="SelectedBuilding.Configuration.MinWaterConsumtion"
                                                                         class="form-control"
                                                                         step="0.01" />
                                                            <span class="input-group-text"> m³</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Cargo Fijo</label>
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text">@(SelectedBuilding.Configuration.Currency.ToCurrencySymbol())</span>
                                                            <InputNumber @bind-Value="SelectedBuilding.Configuration.DefaultFixedCharge"
                                                                         class="form-control"
                                                                         step="0.01" />
                                                            <span class="input-group-text">M3</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Monto de Multa</label>
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text">@(SelectedBuilding.Configuration.Currency.ToCurrencySymbol())</span>
                                                            <InputNumber @bind-Value="SelectedBuilding.Configuration.FineAmount"
                                                                        class="form-control"
                                                                        step="0.01" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Tasa de Interés Mora</label>
                                                        <div class="input-group input-group-sm">
                                                            <InputNumber @bind-Value="SelectedBuilding.Configuration.LateInterestRate"
                                                                        class="form-control"
                                                                        step="0.01" />
                                                            <span class="input-group-text">% mensual</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-group">
                                                        <label class="form-label">Día de Emisión Recibos</label>
                                                        <InputNumber @bind-Value="SelectedBuilding.Configuration.InvoiceDay"
                                                                    class="form-control form-control-sm"
                                                                    min="1" max="31" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Días para alerta de deuda (naranja)</label>
                                                        <div class="input-group input-group-sm">
                                                            <InputNumber @bind-Value="SelectedBuilding.Configuration.DebtWarningDays"
                                                                        class="form-control"
                                                                        min="1" />
                                                            <span class="input-group-text">días</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Días para deuda crítica (rojo)</label>
                                                        <div class="input-group input-group-sm">
                                                            <InputNumber @bind-Value="SelectedBuilding.Configuration.DebtCriticalDays"
                                                                        class="form-control"
                                                                        min="1" />
                                                            <span class="input-group-text">días</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-group">
                                                        <label class="form-label">Texto del pie del recibo</label>
                                                        <textarea class="form-control form-control-sm" rows="2"
                                                                  placeholder="Ej: Depositar en {Banco} Cta. {NroCta} - Titular: {Titular}. Consultas: {CorreoADM}"
                                                                  @bind="SelectedBuilding.Configuration.ReceiptFooterText"></textarea>
                                                        <small class="text-muted">
                                                            Placeholders disponibles: {DPTO}, {Propietario}, {NroCta}, {Banco}, {Titular}, {Administrador}, {CorreoADM}.
                                                        </small>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Monto de Aprobación de Gastos (Junta)</label>
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text">@(SelectedBuilding.Configuration.Currency.ToCurrencySymbol())</span>
                                                            <InputNumber @bind-Value="SelectedBuilding.Configuration.ExpenseApprovalThreshold"
                                                                         class="form-control"
                                                                         step="0.01" />
                                                        </div>
                                                        <small class="text-muted">
                                                            Un gasto manual por encima de este monto queda pendiente de aprobación de la Junta. Vacío = nunca requiere aprobación.
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="action-buttons">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("fines")'>
                                                    <i class="bi bi-check"></i> Guardar
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Comsumo Mínimo </label>
                                                <div class="fw-semibold">
                                                    @SelectedBuilding.Configuration.MinWaterConsumtion.ToString("N2") m³
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Cargo Fijo</label>
                                                <div class="fw-semibold">
                                                    @SelectedBuilding.Configuration.Currency.ToCurrencySymbol() @SelectedBuilding.Configuration.DefaultFixedCharge.ToString("N2")
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Monto de Multa</label>
                                                <div class="fw-semibold">
                                                    @SelectedBuilding.Configuration.Currency.ToCurrencySymbol() @SelectedBuilding.Configuration.FineAmount.ToString("N2")
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Tasa de Interés Mora</label>
                                                <div class="fw-semibold">@SelectedBuilding.Configuration.LateInterestRate.ToString("N2")% mensual</div>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small text-muted">Día de Emisión Recibos</label>
                                                <div class="fw-semibold">@SelectedBuilding.Configuration.InvoiceDay de cada mes</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Alerta de deuda (naranja)</label>
                                                <div class="fw-semibold">Después de @SelectedBuilding.Configuration.DebtWarningDays días</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Deuda crítica (rojo)</label>
                                                <div class="fw-semibold">Después de @SelectedBuilding.Configuration.DebtCriticalDays días</div>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small text-muted">Texto del pie del recibo</label>
                                                <div class="fw-semibold">
                                                    @(string.IsNullOrWhiteSpace(SelectedBuilding.Configuration.ReceiptFooterText) ? "(sin configurar)" : SelectedBuilding.Configuration.ReceiptFooterText)
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-muted">Monto de Aprobación de Gastos (Junta)</label>
                                                <div class="fw-semibold">
                                                    @(SelectedBuilding.Configuration.ExpenseApprovalThreshold.HasValue
                                                        ? $"{SelectedBuilding.Configuration.Currency.ToCurrencySymbol()} {SelectedBuilding.Configuration.ExpenseApprovalThreshold.Value:N2}"
                                                        : "Nunca requiere aprobación")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (ActiveTab == "admin")
                        {
                            <!-- Sección Contactos -->
                            <div class="card card-hover config-card @(_editingSection == "admin" ? "edit-mode" : "")">
                                <div class="card-body">
                                    @if (_canEditBuilding)
                                    {
                                        <div class="edit-button">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    @onclick='() => StartEditSection("admin")'>
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    }

                                    <h6 class="section-title">
                                        <i class="bi bi-person-lines-fill me-2"></i>Contacto Administración
                                    </h6>

                                    @if (_editingSection == "admin")
                                    {
                                        <div class="form-compact">
                                            <div class="form-group">
                                                <label class="form-label">Nombre</label>
                                                <InputText @bind-Value="SelectedBuilding.Configuration.AdminContact.Name"
                                                          class="form-control form-control-sm" />
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Teléfono</label>
                                                        <InputText @bind-Value="SelectedBuilding.Configuration.AdminContact.Phone"
                                                                  class="form-control form-control-sm" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="form-label">Email</label>
                                                        <InputText @bind-Value="SelectedBuilding.Configuration.AdminContact.Email"
                                                                  type="email"
                                                                  class="form-control form-control-sm" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Dirección</label>
                                                <InputText @bind-Value="SelectedBuilding.Configuration.AdminContact.Address"
                                                          class="form-control form-control-sm" />
                                            </div>

                                            <div class="action-buttons">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("admin")'>
                                                    <i class="bi bi-check"></i> Guardar
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                    Cancelar
                                                </button>
