<!-- Modal de configuración rápida -->
<Modal @ref="_quickConfigModal" Title="Configuración Rápida" Size="ModalSize.Regular">
    <BodyTemplate>
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Esta configuración se aplicará solo al edificio seleccionado.
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Copiar configuración de:</label>
            <select @bind-Value="_sourceBuildingId" @bind-Value:event="oninput" class="form-select">
                <option value="">-- Seleccionar edificio --</option>
                @foreach (var building in Buildings.Where(b => b.IdBuilding != _quickConfigBuilding?.IdBuilding))
                {
                    <option value="@building.IdBuilding">@building.Name (Edificio #@building.Number)</option>
                }
            </select>
        </div>
        <div class="form-group mb-3">

            <label class="form-label">¿Qué configuraciones copiar?</label>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyCurrency" class="form-check-input" />
                <label class="form-check-label">Moneda y cuentas bancarias</label>
            </div>

            <div class="form-check">
                <InputCheckbox @bind-Value="_copyPayments" class="form-check-input" />
                <label class="form-check-label">Configuración de pagos</label>
            </div>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyFines" class="form-check-input" />
                <label class="form-check-label">Multas y mora</label>
            </div>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyContacts" class="form-check-input" />
                <label class="form-check-label">Contactos</label>
            </div>

            <div class="form-check">
                <InputCheckbox id="copyAll" class="form-check-input" @bind-Value="_copyAll" />
                <label class="form-check-label" for="copyAll">Todas las configuraciones</label>
            </div>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="ApplyQuickConfig" disabled="@(_sourceBuildingId == null)">
            <i class="bi bi-copy me-1"></i>Aplicar Configuración
        </button>
        <button class="btn btn-secondary" @onclick="() => _quickConfigModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal para crear/editar Cuentas Bancarias -->
<Modal @ref="_bankAccount" Title="@(_isEditingBanckAccount ? "Editar Cta." : "Nuevo Cta.")" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="_editingBankAccout" OnValidSubmit="SaveBankAccout" method="post" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Banco *</label>
                        <InputText @bind-Value="_editingBankAccout.BankName" class="form-control" min="1" />
                        <ValidationMessage For="@(() => _editingBankAccout.BankName)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Nro. de cuenta *</label>
                        <InputText @bind-Value="_editingBankAccout.AccountNumber" class="form-control" maxlength="30" />
                        <ValidationMessage For="@(() => _editingBankAccout.AccountNumber)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Titular</label>
                        <InputText @bind-Value="_editingBankAccout.AccountName" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">CCI</label>
                        <InputText @bind-Value="_editingBankAccout.CCI" class="form-control" maxlength="30" />
                        <ValidationMessage For="@(() => _editingBankAccout.CCI)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tipo *</label>
                        <select @bind-Value="_editingBankAccout.AccountType" @bind-Value:event="oninput" class="form-select">
                            <!--    PARAMETRO_PADRE     -->
                            @foreach (var type in filteredParameters!.Where(c => c.IdParent == 31))
                            {
                                <option value="@type.Value">@type.ShortDescription</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Saldo Inicial *</label>
                        <InputNumber @bind-Value="_editingBankAccout.InitialBalance" class="form-control" min="0" disabled="@_isEditingBanckAccount" />
                        <ValidationMessage For="@(() => _editingBankAccout.InitialBalance)" />
                        @if (_isEditingBanckAccount)
                        {
                            <small class="text-muted">No se puede modificar después de creada la cuenta.</small>
                        }
                    </div>
                </div>
                @if (_isEditingBanckAccount)
                {
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Saldo Actual</label>
                            <InputNumber @bind-Value="_editingBankAccout.CurrentBalance" class="form-control" disabled="true" />
                            <small class="text-muted">Se actualiza automáticamente con cada conciliación.</small>
                        </div>
                    </div>
                }
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <div class="form-check">
                            <InputCheckbox @bind-Value="BankAccountIsActive" class="form-check-input" />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveBankAccout">
            <i class="bi bi-check me-1"></i>@(_isEditingBanckAccount ? "Actualizar" : "Crear")
        </button>
        <button class="btn btn-secondary" @onclick="() => CloseBankModal()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal para crear/editar Exoneraciones -->
<Modal @ref="_exoneration" Title="Agregar Exoneracion"  Size="ModalSize.Regular">
    <BodyTemplate>
        @if (!string.IsNullOrEmpty(_errorExoneracion))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @_errorExoneracion
                <button type="button" class="btn-close" @onclick='() => _errorExoneracion = string.Empty'></button>
            </div>
        }
        <EditForm Model="_Exoneration" OnValidSubmit="SaveExoneration" method="post" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Departamento *</label>
                        <select @bind-Value="_Exoneration.IdGroupUnit" @bind-Value:event="oninput" class="form-select">
                            <option value="@Guid.Empty">Seleccionar departamento</option>
                            <!--    PARAMETRO_PADRE     -->
                            @foreach (var type in filteredUnits)
                            {
                                <option value="@type.IdGroupUnit">DPTO @type.UnitNumber </option>
                            }
                        </select>
                        <ValidationMessage For="@(() => _Exoneration.IdGroupUnit)" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Categoria de Gasto *</label>
                        <select @bind-Value="_Exoneration.IdCategory" @bind-Value:event="oninput" class="form-select">
                            <!--    PARAMETRO_PADRE     -->
                            <option value="">Seleccionar categoría</option>
                            @foreach (var item in filteredCategory.Where(c => c.Nivel == 0))
                            {
                                <optgroup label="@item.ShortDescript">
                                    @foreach (var subitem in filteredCategory.Where(c => c.ParentId == item.IdCategory))
                                    {
                                        <option value="@subitem.IdCategory">@subitem.ShortDescript</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <ValidationMessage For="@(() => _Exoneration.IdCategory)" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Motivo Exoneración  *</label>
                        <InputTextArea @bind-Value="_Exoneration.Description" class="form-control" Rows="2" />
                        <ValidationMessage For="@(() => _Exoneration.Description)" />
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveExoneration">
            <i class="bi bi-check me-1"></i>Crear
        </button>
        <button class="btn btn-secondary" @onclick="() => CloseExonerationModal()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal para crear/editar Áreas Comunes -->
<Modal @ref="_areaComunModal" Title="@(_editingAreaComun.IdAreaComun == Guid.Empty ? "Nueva Área Común" : "Editar Área Común")" Size="ModalSize.Large" UseStaticBackdrop="true" CloseOnEscape="false">
    <BodyTemplate>
        @if (!string.IsNullOrEmpty(_errorAreaComun))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @_errorAreaComun
                <button type="button" class="btn-close" @onclick='() => _errorAreaComun = string.Empty'></button>
            </div>
        }
        <EditForm Model="_editingAreaComun" OnValidSubmit="SaveAreaComun">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-8">
                    <div class="form-group">
                        <label class="form-label">Nombre *</label>
                        <InputText @bind-Value="_editingAreaComun.Nombre" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Aforo Máximo</label>
                        <InputNumber @bind-Value="_editingAreaComun.AforoMaximo" class="form-control" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Descripción</label>
                        <InputTextArea @bind-Value="_editingAreaComun.Descripcion" class="form-control" Rows="2" />
                    </div>
                </div>

                <div class="col-12"><hr class="my-1" /><h6 class="text-muted small text-uppercase">Reglas de disponibilidad</h6></div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Duración mín. (min)</label>
                        <InputNumber @bind-Value="_editingAreaComun.DuracionMinMinutos" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Duración máx. (min)</label>
                        <InputNumber @bind-Value="_editingAreaComun.DuracionMaxMinutos" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Buffer entre reservas (min)</label>
                        <InputNumber @bind-Value="_editingAreaComun.BufferMinutos" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Tope reservas activas/unidad</label>
                        <InputNumber @bind-Value="_editingAreaComun.TopeReservasActivasPorUnidad" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Anticipación mínima (horas)</label>
                        <InputNumber @bind-Value="_editingAreaComun.AnticipacionMinHoras" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Anticipación máxima (días)</label>
                        <InputNumber @bind-Value="_editingAreaComun.AnticipacionMaxDias" class="form-control" />
                    </div>
                </div>

                <div class="col-12"><hr class="my-1" /><h6 class="text-muted small text-uppercase">Costos (@SelectedBuilding?.Configuration.Currency)</h6></div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Garantía Internos</label>
                        <InputNumber @bind-Value="_editingAreaComun.GarantiaInternos" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Garantía Externos</label>
                        <InputNumber @bind-Value="_editingAreaComun.GarantiaExternos" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Alquiler Internos</label>
                        <InputNumber @bind-Value="_editingAreaComun.AlquilerInternos" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Alquiler Externos</label>
                        <InputNumber @bind-Value="_editingAreaComun.AlquilerExternos" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Limpieza</label>
                        <InputNumber @bind-Value="_editingAreaComun.Limpieza" class="form-control" />
                    </div>
                </div>

                <div class="col-12"><hr class="my-1" /><h6 class="text-muted small text-uppercase">Penalidades</h6></div>
                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="_editingAreaComun.PenalidadCancelacionHabilitada" class="form-check-input" />
                        <label class="form-check-label">Penalidad por cancelación tardía</label>
                    </div>
                    @if (_editingAreaComun.PenalidadCancelacionHabilitada)
                    {
                        <div class="form-group mt-1">
                            <label class="form-label small">Días mínimos sin penalidad</label>
                            <InputNumber @bind-Value="_editingAreaComun.DiasMinimosSinPenalidad" class="form-control form-control-sm" />
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="_editingAreaComun.PenalidadNoPresentadoHabilitada" class="form-check-input" />
                        <label class="form-check-label">Penalidad por no presentarse</label>
                    </div>
                </div>

                @if (_editingAreaComun.IdAreaComun != Guid.Empty)
                {
                    <div class="col-md-6">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="_editingAreaComun.Activo" class="form-check-input" />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                }
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveAreaComun">
            <i class="bi bi-check me-1"></i>Guardar
        </button>
        <button class="btn btn-secondary" @onclick="() => _areaComunModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>
