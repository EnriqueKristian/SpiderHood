@page "/buildings"
@rendermode InteractiveServer
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using SpiderHood.Models
@using SpiderHood.Components.Pages.Components
@inject Services.AuthService AuthService
@inject NavigationManager Navigation
@inject Services.ParameterService ParameterService
@inject Services.IPermissionService PermissionService
@inject IJSRuntime JSRuntime

<div class="building-management">
    <!-- Header -->
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Administración de Edificios</h1>
                <p class="text-muted mb-0">Gestión completa de propiedades y configuraciones por edificio</p>
            </div>
        </div>
        <div class="page-header-actions">
            @if (_canCreateBuilding)
            {
                <button class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="bi bi-building-add me-2"></i>Nuevo Edificio
                </button>
            }
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Total Edificios</div>
                        <div class="stat-value">@Buildings.Count</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-success">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Departamentos Totales</div>
                        <div class="stat-value">@Buildings.Sum(b => b.Apartments)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-warning">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Estacionamientos</div>
                        <div class="stat-value">@Buildings.Sum(b => b.Parkings)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-info">
                        <i class="bi bi-rulers"></i>
                    </div>
                    <div>
                        <div class="stat-label">Área Total</div>
                        <div class="stat-value">@Buildings.Sum(b => b.TotalArea) m²</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <!-- Lista de Edificios -->
        <div class="col-12">
            <div class="card card-hover">
                <div class="card-header">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <h5 class="mb-0">Edificios</h5>
                        @if (Buildings.Any())
                        {
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div style="min-width: 240px;">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Buscar por nombre o ubicación..."
                                           value="@searchTerm"
                                           @oninput="OnSearch" />
                                </div>
                                <div class="d-flex align-items-center">
                                    <label class="me-2 text-muted small">Mostrar:</label>
                                    <select class="form-select form-select-sm" style="width: auto;"
                                            @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                        <option value="10" selected="@(pageSize == 10)">10</option>
                                        <option value="25" selected="@(pageSize == 25)">25</option>
                                        <option value="50" selected="@(pageSize == 50)">50</option>
                                        <option value="100" selected="@(pageSize == 100)">100</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_pagination.TotalRecords > 0)
                    {
                        <p class="text-muted small mb-0 mt-1">
                            Mostrando @_pagination.StartRecord - @_pagination.EndRecord de @_pagination.TotalRecords edificios
                        </p>
                    }
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (Buildings.Any() && _pagination.TotalRecords == 0)
                    {
                        <div class="empty-state">
                            <i class="bi bi-search"></i>
                            <h4 class="mb-2">Sin resultados</h4>
                            <p class="text-muted mb-0">Ningún edificio coincide con "@searchTerm"</p>
                        </div>
                    }
                    else if (Buildings.Any())
                    {
                        @foreach (var building in _pagination.CurrentPageData)
                        {
                            <div class="building-selector @(SelectedBuilding?.IdBuilding == building.IdBuilding ? "active" : "")"
                                 @onclick="() => GoToConfig(building)">
                                <div class="building-number">@building.Number</div>
                                <div class="building-info">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@building.Name</h6>
                                            <p class="text-muted small mb-1">@building.Location</p>
                                            <div class="d-flex gap-2">
                                                <span class="badge bg-info">@ParameterService.GetChildParameterDescription(34,building.Type)</span>
                                                <span class="status-badge @(building.IsActive ? "status-active" : "status-inactive")">
                                                    @(building.IsActive ? "Activo" : "Inactivo")
                                                </span>
                                                @if (building.IsTemplate)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="bi bi-stars me-1"></i>Template
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex flex-wrap gap-1">
                                                <span class="info-chip">
                                                    <i class="bi bi-building"></i> @building.Floors Pisos
                                                </span>
                                                <span class="info-chip">
                                                    <i class="bi bi-door-closed"></i> @building.Apartments Dptos
                                                </span>
                                                <span class="info-chip">
                                                    <i class="bi bi-car-front"></i> @building.Parkings Estac.
                                                </span>
                                                @if (building.Basements > 0)
                                                {
                                                    <span class="info-chip">
                                                        <i class="bi bi-arrow-down-square"></i> @building.Basements Sót.
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="building-actions">
                                            @if (_canEditBuilding)
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        title="Editar"
                                                        @onclick="() => EditBuilding(building)"
                                                        @onclick:stopPropagation>
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    title="Configuración"
                                                    @onclick="() => GoToConfig(building)"
                                                    @onclick:stopPropagation>
                                                <i class="bi bi-gear"></i>
                                            </button>
                                            @if (currentUser.Role == "SysAdmin")
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        title="Eliminar (sólo edificios de prueba vacíos)"
                                                        @onclick="() => ShowDeleteBuildingModal(building)"
                                                        @onclick:stopPropagation>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-buildings"></i>
                            <h4 class="mb-2">No hay edificios registrados</h4>
                            <p class="text-muted mb-3">Comienza agregando tu primer edificio</p>
                            @if (_canCreateBuilding)
                            {
                                <button class="btn btn-primary" style="border-radius: 50px;" @onclick="ShowCreateModal">
                                    <i class="bi bi-building-add me-2"></i>Crear Primer Edificio
                                </button>
                            }
                        </div>
                    }
                </div>
                @if (_pagination.TotalPages > 1)
                {
                    <div class="card-footer bg-transparent border-top py-3">
                        <PaginationControls _pagination="@_pagination" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal MEJORADO para crear/editar edificio -->
<Modal @ref="_buildingModal" Title="@(_isEditingBuilding ? "Editar Edificio" : "Nuevo Edificio")" Size="ModalSize.ExtraLarge" IsScrollable="true">
    <BodyTemplate>
        <EditForm id="editBuildingForm" Model="_editingBuilding" OnValidSubmit="SaveBuilding">
            <DataAnnotationsValidator />
            
            <!-- Tabs de navegación -->
            <div class="mb-4">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == 1 ? "active" : "")" 
                                @onclick="() => activeTab = 1" 
                                type="button" role="tab">
                            <i class="bi bi-building me-2"></i>Información Básica
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == 2 ? "active" : "")" 
                                @onclick="() => activeTab = 2" 
                                type="button" role="tab">
                            <i class="bi bi-grid-3x3-gap me-2"></i>Estructura
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == 3 ? "active" : "")" 
                                @onclick="() => activeTab = 3" 
                                type="button" role="tab">
                            <i class="bi bi-stars me-2"></i>Servicios
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == 4 ? "active" : "")"
                                @onclick="() => activeTab = 4"
                                type="button" role="tab">
                            <i class="bi bi-people me-2"></i>Contacto
                        </button>
                    </li>
                    @if (_isEditingBuilding)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == 5 ? "active" : "")"
                                    @onclick="() => activeTab = 5"
                                    type="button" role="tab">
                                <i class="bi bi-person-badge me-2"></i>Junta Directiva
                            </button>
                        </li>
                    }
                </ul>
            </div>

            <!-- TAB 1: Información Básica -->
            @if (activeTab == 1)
            {
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <div>Complete la información básica del edificio. Los campos marcados con * son obligatorios.</div>
                        </div>
                    </div>

                    @if (_isEditingBuilding)
                    {
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-image me-1 text-primary"></i>Logo / Foto del Edificio
                                </label>
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    @if (_buildingLogoDataUri != null)
                                    {
                                        <img src="@_buildingLogoDataUri" alt="Logo del edificio" style="max-height:70px;max-width:180px;object-fit:contain;" class="border rounded p-1" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin logo cargado -- se usa el de la Cuenta de Facturación en el recibo, si tiene uno.</span>
                                    }
                                </div>
                                @if (_buildingLogoError != null)
                                {
                                    <div class="alert alert-danger py-2">@_buildingLogoError</div>
                                }
                                @if (_canEditBuilding)
                                {
                                    <InputFile OnChange="SubirLogoEdificioAsync" accept="image/png,image/jpeg,image/webp"
                                               class="form-control" disabled="@_subiendoLogoEdificio" />
                                    <div class="form-text">JPG, PNG o WEBP -- máximo 2 MB. Se usa en el encabezado del recibo de mantenimiento.</div>
                                }
                            </div>
                        </div>
                    }

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-building me-1 text-primary"></i>Nombre del Edificio *
                            </label>
                            <InputText @bind-Value="_editingBuilding.Name" 
                                       class="form-control" 
                                       placeholder="Ej: Los Geranios de SJ" />
                            <ValidationMessage For="@(() => _editingBuilding.Name)" 
                                              class="text-danger small" />
                            <div class="form-text">Nombre comercial o razón social del edificio</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-geo-alt me-1 text-primary"></i>Ubicación *
                            </label>
                            <InputText @bind-Value="_editingBuilding.Location" 
                                       class="form-control" 
                                       placeholder="Ej: AV. del Este 2345" />
                            <ValidationMessage For="@(() => _editingBuilding.Location)" 
                                              class="text-danger small" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-building-check me-1 text-primary"></i>Tipo *
                            </label>
                            <select @bind-value="_editingBuilding.Type" 
                                    @bind-value:event="onchange" 
                                    class="form-select">
                                @foreach (var tipo in ParameterService.ListParameters
                                    .Where(p => p.IdParent == 34)
                                    .OrderBy(p => p.ShortDescription))
                                {
                                    <option value="@tipo.Value">@tipo.ShortDescription</option>
                                }
                            </select>
                            <ValidationMessage For="@(() => _editingBuilding.Type)" 
                                              class="text-danger small" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-calendar me-1 text-primary"></i>Año de Construcción
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.ConstructionYear" 
                                        class="form-control" 
                                        min="1900" 
                                        max="@DateTime.Now.Year"
                                        placeholder="Ej: 2015" />
                            <div class="form-text">Año en que se construyó el edificio</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-rulers me-1 text-primary"></i>Área Total (m²) *
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.TotalArea" 
                                        class="form-control" 
                                        step="0.01" 
                                        min="0" 
                                        placeholder="Ej: 2861.90" />
                            <ValidationMessage For="@(() => _editingBuilding.TotalArea)" 
                                              class="text-danger small" />
                            <div class="form-text">Suma del área de todas las unidades + áreas comunes</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-telephone me-1 text-primary"></i>Teléfono del Edificio
                            </label>
                            <InputText @bind-Value="_editingBuilding.Phone" 
                                       class="form-control" 
                                       placeholder="Ej: +506 2234-5678" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-envelope me-1 text-primary"></i>Email Institucional
                            </label>
                            <InputText @bind-Value="_editingBuilding.Email" 
                                       class="form-control" 
                                       placeholder="admin@edificio.com" />
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="_editingBuilding.IsActive" 
                                              class="form-check-input" 
                                              id="isActive" />
                                <label class="form-check-label" for="isActive">
                                    <i class="bi bi-toggle-on me-1"></i>Edificio Activo
                                </label>
                            </div>
                            <div class="form-text">Los edificios inactivos no aparecen en la app móvil</div>
                        </div>
                    </div>

                    @if (currentUser.Role == "SysAdmin")
                    {
                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="_editingBuilding.IsTemplate" 
                                                  class="form-check-input" 
                                                  id="isTemplate" />
                                    <label class="form-check-label" for="isTemplate">
                                        <i class="bi bi-stars me-1 text-warning"></i>Edificio Template
                                    </label>
                                </div>
                                <div class="form-text">
                                    Sus valores de configuración se usan como default al crear edificios nuevos. 
                                    Sólo visible para SysAdmin.
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- TAB 2: Estructura -->
            @if (activeTab == 2)
            {
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <div>Defina la estructura física del edificio</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-building me-1 text-primary"></i>Número de Pisos *
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.Floors" 
                                        class="form-control" 
                                        min="1" 
                                        max="100"
                                        placeholder="Ej: 11" />
                            <ValidationMessage For="@(() => _editingBuilding.Floors)" 
                                              class="text-danger small" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-door-closed me-1 text-primary"></i>Departamentos *
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.Apartments" 
                                        class="form-control" 
                                        min="0"
                                        placeholder="Ej: 30" />
                            <ValidationMessage For="@(() => _editingBuilding.Apartments)" 
                                              class="text-danger small" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-arrow-down-square me-1 text-primary"></i>Sótanos
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.Basements" 
                                        class="form-control" 
                                        min="0"
                                        placeholder="Ej: 2" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-car-front me-1 text-primary"></i>Estacionamientos
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.Parkings" 
                                        class="form-control" 
                                        min="0"
                                        placeholder="Ej: 21" />
                            <div class="form-text">Total de espacios de estacionamiento</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-box me-1 text-primary"></i>Depósitos
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.Deposits" 
                                        class="form-control" 
                                        min="0"
                                        placeholder="Ej: 10" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-grid me-1 text-primary"></i>Otros Espacios
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.Others" 
                                        class="form-control" 
                                        min="0"
                                        placeholder="Ej: 2" />
                            <div class="form-text">Bodegas, cuartos técnicos, etc.</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-elevator me-1 text-primary"></i>Número de Ascensores
                            </label>
                            <InputNumber @bind-Value="_editingBuilding.Elevators" 
                                        class="form-control" 
                                        min="0"
                                        max="20"
                                        placeholder="Ej: 2" />
                        </div>
                    </div>
                </div>
            }

            <!-- TAB 3: Servicios y Amenidades -->
            @if (activeTab == 3)
            {
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <div>Seleccione los servicios y amenidades disponibles</div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <h6 class="mb-3"><i class="bi bi-water me-2"></i>Áreas Recreativas</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasPool" 
                                                  class="form-check-input" 
                                                  id="hasPool" />
                                    <label class="form-check-label" for="hasPool">
                                        <i class="bi bi-water me-1"></i>Piscina
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasGym" 
                                                  class="form-check-input" 
                                                  id="hasGym" />
                                    <label class="form-check-label" for="hasGym">
                                        <i class="bi bi-dumbbell me-1"></i>Gimnasio
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasBBQ" 
                                                  class="form-check-input" 
                                                  id="hasBBQ" />
                                    <label class="form-check-label" for="hasBBQ">
                                        <i class="bi bi-fire me-1"></i>Zona BBQ
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasEventRoom" 
                                                  class="form-check-input" 
                                                  id="hasEventRoom" />
                                    <label class="form-check-label" for="hasEventRoom">
                                        <i class="bi bi-calendar-event me-1"></i>Salón de Eventos
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasPetArea" 
                                                  class="form-check-input" 
                                                  id="hasPetArea" />
                                    <label class="form-check-label" for="hasPetArea">
                                        <i class="bi bi-paw me-1"></i>Zona de Mascotas
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasGreenAreas" 
                                                  class="form-check-input" 
                                                  id="hasGreenAreas" />
                                    <label class="form-check-label" for="hasGreenAreas">
                                        <i class="bi bi-tree me-1"></i>Zonas Verdes
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12 mt-4">
                        <h6 class="mb-3"><i class="bi bi-shield-check me-2"></i>Seguridad</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.Has247Security" 
                                                  class="form-check-input" 
                                                  id="has247Security" />
                                    <label class="form-check-label" for="has247Security">
                                        <i class="bi bi-shield-check me-1"></i>Seguridad 24/7
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasPorter" 
                                                  class="form-check-input" 
                                                  id="hasPorter" />
                                    <label class="form-check-label" for="hasPorter">
                                        <i class="bi bi-person-badge me-1"></i>Portería
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_editingBuilding.HasCameras" 
                                                  class="form-check-input" 
                                                  id="hasCameras" />
                                    <label class="form-check-label" for="hasCameras">
                                        <i class="bi bi-camera-video me-1"></i>Cámaras de Seguridad
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- TAB 4: Contacto -->
            @if (activeTab == 4)
            {
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <div>Información de contacto del edificio</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-person me-1 text-primary"></i>Administrador Principal
                            </label>
                            <InputText @bind-Value="_editingBuilding.AdminName"
                                       class="form-control"
                                       placeholder="@(_effectiveContact.AdminName ?? "Nombre completo")" />
                            @if (!string.IsNullOrWhiteSpace(_effectiveContact.AdminName) && string.IsNullOrWhiteSpace(_editingBuilding.AdminName))
                            {
                                <div class="form-text">Vacío = se usa el de tu Cuenta: @_effectiveContact.AdminName</div>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-telephone me-1 text-primary"></i>Teléfono Administrador
                            </label>
                            <InputText @bind-Value="_editingBuilding.AdminPhone"
                                       class="form-control"
                                       placeholder="@(_effectiveContact.AdminPhone ?? "Ej: +506 8765-4321")" />
                            @if (!string.IsNullOrWhiteSpace(_effectiveContact.AdminPhone) && string.IsNullOrWhiteSpace(_editingBuilding.AdminPhone))
                            {
                                <div class="form-text">Vacío = se usa el de tu Cuenta: @_effectiveContact.AdminPhone</div>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-phone me-1 text-primary"></i>Teléfono Emergencias
                            </label>
                            <InputText @bind-Value="_editingBuilding.EmergencyPhone"
                                       class="form-control"
                                       placeholder="Ej: +506 2234-5678" />
                            <div class="form-text">Teléfono de emergencias 24 horas -- propio de este edificio, no se completa con el de la Cuenta</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-clock me-1 text-primary"></i>Horario de Atención
                            </label>
                            <InputText @bind-Value="_editingBuilding.OfficeHours"
                                       class="form-control"
                                       placeholder="@(_effectiveContact.OfficeHours ?? "Ej: Lunes a Viernes 8:00 - 17:00")" />
                            @if (!string.IsNullOrWhiteSpace(_effectiveContact.OfficeHours) && string.IsNullOrWhiteSpace(_editingBuilding.OfficeHours))
                            {
                                <div class="form-text">Vacío = se usa el de tu Cuenta: @_effectiveContact.OfficeHours</div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- TAB 5: Junta Directiva -->
            @if (activeTab == 5 && _isEditingBuilding)
            {
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <div>
                                Presidente, Secretario, Tesorero y Vocales de este edificio. Sólo se
                                pueden elegir usuarios con Rol "Junta" ya asignado en
                                <a href="/settings/userroles" target="_blank">Configuración &gt; Roles</a>.
                            </div>
                        </div>
                    </div>

                    @if (_boardError != null)
                    {
                        <div class="col-md-12"><div class="alert alert-danger py-2 mb-0">@_boardError</div></div>
                    }

                    @if (_activeBoard is null)
                    {
                        <div class="col-md-12">
                            <p class="text-muted">Este edificio todavía no tiene una Junta Directiva constituida.</p>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label fw-semibold">Fecha de Inicio</label>
                                <input type="date" class="form-control" @bind="_newBoardFechaInicio" />
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button type="button" class="btn btn-primary" disabled="@_savingBoard" @onclick="ConstituirNuevaJuntaAsync">
                                <i class="bi bi-check-circle me-1"></i>Constituir Junta
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-12">
                            <p class="text-muted mb-2">
                                Junta activa desde el <strong>@_activeBoard.FechaInicio.ToString("dd/MM/yyyy")</strong>.
                            </p>
                        </div>

                        <div class="col-md-12">
                            @if (_boardMembers.Count == 0)
                            {
                                <p class="text-muted fst-italic">Todavía no se agregó ningún miembro.</p>
                            }
                            else
                            {
                                <ul class="list-group mb-3">
                                    @foreach (var miembro in _boardMembers)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                <strong>@miembro.Cargo@(miembro.Cargo == BoardMemberRole.Otro && !string.IsNullOrWhiteSpace(miembro.OtroDescripcion) ? $" ({miembro.OtroDescripcion})" : "")</strong>
                                                -- @miembro.FullName (@miembro.Email)
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarMiembroJuntaAsync(miembro.IdBuildingBoardMember)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="col-md-12"><hr /></div>

                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="form-label fw-semibold">Usuario (con Rol Junta)</label>
                                <select class="form-select" @onchange="OnMemberUserSelectedAsync">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var u in _eligibleBoardUsers)
                                    {
                                        <option value="@u.IdUser">@u.UserName (@u.UserEmail)</option>
                                    }
                                </select>
                                @if (_newMemberOwnerWarning == true)
                                {
                                    <div class="form-text text-warning">
                                        <i class="bi bi-exclamation-triangle me-1"></i>No se encontró un
                                        propietario con este email en este edificio -- se puede agregar
                                        igual, esto es sólo un aviso.
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label fw-semibold">Cargo</label>
                                <select class="form-select" @bind="_newMemberCargo">
                                    @foreach (var cargo in Enum.GetValues<BoardMemberRole>())
                                    {
                                        <option value="@cargo">@cargo</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @if (_newMemberCargo == BoardMemberRole.Otro)
                        {
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Describir cargo</label>
                                    <input class="form-control" @bind="_newMemberOtroDescripcion" placeholder="Ej: Vocal Suplente" />
                                </div>
                            </div>
                        }
                        <div class="col-md-12">
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(_savingBoard || _newMemberIdUser is null)" @onclick="AgregarMiembroJuntaAsync">
                                <i class="bi bi-person-plus me-1"></i>Agregar miembro
                            </button>
                        </div>

                        <div class="col-md-12"><hr /></div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label fw-semibold">Fecha de Inicio (nueva Junta)</label>
                                <input type="date" class="form-control" @bind="_newBoardFechaInicio" />
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary" disabled="@_savingBoard" @onclick="ConstituirNuevaJuntaAsync">
                                <i class="bi bi-arrow-repeat me-1"></i>Cerrar esta Junta y constituir una nueva
                            </button>
                        </div>
                    }
                </div>
            }
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex justify-content-between w-100">
            <div>
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="PreviousTab"
                        disabled="@(activeTab == 1)">
                    <i class="bi bi-arrow-left me-1"></i>Anterior
                </button>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="() => _buildingModal.HideAsync()">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </button>

                @if (activeTab < MaxTab)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="NextTab">
                        Siguiente<i class="bi bi-arrow-right ms-1"></i>
                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-success"
                            form="editBuildingForm">
                        <i class="bi bi-check-circle me-1"></i>@(_isEditingBuilding ? "Actualizar" : "Crear")
                    </button>
                }
            </div>
        </div>
    </FooterTemplate>
</Modal>

<!-- Eliminar edificio (sólo SysAdmin) -->
<Modal @ref="_deleteBuildingModal"
       Title="Eliminar Edificio"
       UseStaticBackdrop="true"
       CloseOnEscape="false"
       IsVerticallyCentered="true">
    <BodyTemplate>
        @if (_buildingToDelete != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Esta acción es <strong>permanente</strong> y no se puede deshacer. Sólo
                funciona si el edificio está vacío (sin unidades, propietarios, cuentas
                bancarias, categorías u otros datos) -- pensado para limpiar edificios de
                <strong>prueba</strong>, no para borrar un edificio con actividad real.
            </div>
            <p>
                Para confirmar, escriba el nombre del edificio
                (<strong>@_buildingToDelete.Name</strong>) exactamente como aparece:
            </p>
            <input class="form-control"
                   @bind="_deleteBuildingConfirmText"
                   @bind:event="oninput"
                   placeholder="@_buildingToDelete.Name" />
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-danger"
                disabled="@(_buildingToDelete == null || _deleteBuildingConfirmText != _buildingToDelete.Name)"
                @onclick="DeleteBuildingConfirmed">
            <i class="bi bi-trash me-1"></i>Eliminar definitivamente
        </button>
        <button class="btn btn-secondary" @onclick="() => HideDeleteBuildingModal()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>