@page "/buildings"
@rendermode InteractiveServer
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using SpiderHood.Models
@using SpiderHood.Components.Pages.Components
@inject Services.AuthService AuthService
@inject NavigationManager Navigation
@inject Services.ParameterService ParameterService
@inject Services.IPermissionService PermissionService
@inject IJSRuntime JSRuntime

<div class="building-management">
    <!-- Header -->
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Administración de Edificios</h1>
                <p class="text-muted mb-0">Gestión completa de propiedades y configuraciones por edificio</p>
            </div>
        </div>
        <div class="page-header-actions">
            @if (_canCreateBuilding)
            {
                <button class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="bi bi-building-add me-2"></i>Nuevo Edificio
                </button>
            }
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Total Edificios</div>
                        <div class="stat-value">@Buildings.Count</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-success">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Departamentos Totales</div>
                        <div class="stat-value">@Buildings.Sum(b => b.Apartments)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-warning">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Estacionamientos</div>
                        <div class="stat-value">@Buildings.Sum(b => b.Parkings)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-info">
                        <i class="bi bi-rulers"></i>
                    </div>
                    <div>
                        <div class="stat-label">Área Total</div>
                        <div class="stat-value">@Buildings.Sum(b => b.TotalArea) m²</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <!-- Lista de Edificios -->
        <div class="col-12">
            <div class="card card-hover">
                <div class="card-header">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <h5 class="mb-0">Edificios</h5>
                        @if (Buildings.Any())
                        {
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div style="min-width: 240px;">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Buscar por nombre o ubicación..."
                                           value="@searchTerm"
                                           @oninput="OnSearch" />
                                </div>
                                <div class="d-flex align-items-center">
                                    <label class="me-2 text-muted small">Mostrar:</label>
                                    <select class="form-select form-select-sm" style="width: auto;"
                                            @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                        <option value="10" selected="@(pageSize == 10)">10</option>
                                        <option value="25" selected="@(pageSize == 25)">25</option>
                                        <option value="50" selected="@(pageSize == 50)">50</option>
                                        <option value="100" selected="@(pageSize == 100)">100</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_pagination.TotalRecords > 0)
                    {
                        <p class="text-muted small mb-0 mt-1">
                            Mostrando @_pagination.StartRecord - @_pagination.EndRecord de @_pagination.TotalRecords edificios
                        </p>
                    }
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (Buildings.Any() && _pagination.TotalRecords == 0)
                    {
                        <div class="empty-state">
                            <i class="bi bi-search"></i>
                            <h4 class="mb-2">Sin resultados</h4>
                            <p class="text-muted mb-0">Ningún edificio coincide con "@searchTerm"</p>
                        </div>
                    }
                    else if (Buildings.Any())
                    {
                        @foreach (var building in _pagination.CurrentPageData)
                        {
                            <div class="building-selector @(SelectedBuilding?.IdBuilding == building.IdBuilding ? "active" : "")"
                                 @onclick="() => GoToConfig(building)">
                                <div class="building-number">@building.Number</div>
                                <div class="building-info">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@building.Name</h6>
                                            <p class="text-muted small mb-1">@building.Location</p>
                                            <div class="d-flex gap-2">
                                                <!--    PARAMETRO_PADRE     -->
                                                <span class="badge bg-info">@ParameterService.GetChildParameterDescription(34,building.Type)</span>
                                                <span class="status-badge @(building.IsActive ? "status-active" : "status-inactive")">
                                                    @(building.IsActive ? "Activo" : "Inactivo")
                                                </span>
                                                @if (building.IsTemplate)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="bi bi-stars me-1"></i>Template
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex flex-wrap gap-1">
                                                <span class="info-chip">
                                                    <i class="bi bi-building"></i> @building.Floors Pisos
                                                </span>
                                                <span class="info-chip">
                                                    <i class="bi bi-door-closed"></i> @building.Apartments Dptos
                                                </span>
                                                <span class="info-chip">
                                                    <i class="bi bi-car-front"></i> @building.Parkings Estac.
                                                </span>
                                                @if (building.Basements > 0)
                                                {
                                                    <span class="info-chip">
                                                        <i class="bi bi-arrow-down-square"></i> @building.Basements Sót.
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="building-actions">
                                            @if (_canEditBuilding)
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        title="Editar"
                                                        @onclick="() => EditBuilding(building)"
                                                        @onclick:stopPropagation>
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    title="Configuración"
                                                    @onclick="() => GoToConfig(building)"
                                                    @onclick:stopPropagation>
                                                <i class="bi bi-gear"></i>
                                            </button>
                                            @if (currentUser.Role == "SysAdmin")
                                            {
                                                <!-- Docs/Pendientes-Negocio-Migracion.md #6.3 -- sólo SysAdmin, sólo
                                                     para edificios de PRUEBA vacíos (falla si tiene datos asociados). -->
                                                <button class="btn btn-sm btn-outline-danger"
                                                        title="Eliminar (sólo edificios de prueba vacíos)"
                                                        @onclick="() => ShowDeleteBuildingModal(building)"
                                                        @onclick:stopPropagation>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-buildings"></i>
                            <h4 class="mb-2">No hay edificios registrados</h4>
                            <p class="text-muted mb-3">Comienza agregando tu primer edificio</p>
                            @if (_canCreateBuilding)
                            {
                                <button class="btn btn-primary" style="border-radius: 50px;" @onclick="ShowCreateModal">
                                    <i class="bi bi-building-add me-2"></i>Crear Primer Edificio
                                </button>
                            }
                        </div>
                    }
                </div>
                @if (_pagination.TotalPages > 1)
                {
                    <div class="card-footer bg-transparent border-top py-3">
                        <PaginationControls _pagination="@_pagination" />
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<!-- Modal para crear/editar edificio -->
<Modal @ref="_buildingModal" Title="@(_isEditingBuilding ? "Editar Edificio" : "Nuevo Edificio")" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="_editingBuilding" OnValidSubmit="SaveBuilding">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Nombre del Edificio *</label>
                        <InputText @bind-Value="_editingBuilding.Name" class="form-control" />
                        <ValidationMessage For="@(() => _editingBuilding.Name)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Ubicación *</label>
                        <InputText @bind-Value="_editingBuilding.Location" class="form-control" />
                        <ValidationMessage For="@(() => _editingBuilding.Location)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tipo *</label>
                        @* Building.Type es int (Parameter.Value del grupo Sistema "Tipo Edificio",
                           IdParent=34, ver Docs/Design-Defaults-Sistema-Mixto.md §5.4). Antes el
                           select tenía las 3 opciones hardcodeadas con el NOMBRE como value
                           ("Familiar"/"Comercial"/"Mixto"), que nunca podía parsear a un int: la
                           selección nunca se guardaba de verdad, Type quedaba siempre en 0 sin
                           importar qué se eligiera (por eso el badge de Tipo mostraba "No se
                           encontró coincidencia" en cualquier edificio nuevo). Ahora sale de
                           ParameterService.ListParameters, con el Value real como option value. *@
                         <select @bind-value="_editingBuilding.Type" @bind-value:event="onchange" class="form-select">
                            @foreach (var tipo in ParameterService.ListParameters.Where(p => p.IdParent == 34).OrderBy(p => p.Value))
                            {
                                <option value="@tipo.Value">@tipo.ShortDescription</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Número de Pisos *</label>
                        <InputNumber @bind-Value="_editingBuilding.Floors" class="form-control" min="1" />
                        <ValidationMessage For="@(() => _editingBuilding.Floors)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Sótanos</label>
                        <InputNumber @bind-Value="_editingBuilding.Basements" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Departamentos *</label>
                        <InputNumber @bind-Value="_editingBuilding.Apartments" class="form-control" min="0" />
                        <ValidationMessage For="@(() => _editingBuilding.Apartments)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estacionamientos</label>
                        <InputNumber @bind-Value="_editingBuilding.Parkings" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Depósitos</label>
                        <InputNumber @bind-Value="_editingBuilding.Deposits" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Otros</label>
                        <InputNumber @bind-Value="_editingBuilding.Others" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Área Total (m²) *</label>
                        <InputNumber @bind-Value="_editingBuilding.TotalArea" class="form-control" step="0.01" min="0" />
                        <ValidationMessage For="@(() => _editingBuilding.TotalArea)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <div class="form-check">
                            <InputCheckbox @bind-Value="_editingBuilding.IsActive" class="form-check-input" />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
                @if (currentUser.Role == "SysAdmin")
                {
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Edificio Template
                                <i class="bi bi-info-circle text-muted" title="Sus valores de Configuración se usan como default al crear un edificio nuevo. Sólo lo ve/edita SysAdmin."></i>
                            </label>
                            <div class="form-check">
                                <InputCheckbox @bind-Value="_editingBuilding.IsTemplate" class="form-check-input" />
                                <label class="form-check-label">Es edificio template</label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveBuilding">
            <i class="bi bi-check me-1"></i>@(_isEditingBuilding ? "Actualizar" : "Crear")
        </button>
        <button class="btn btn-secondary" @onclick="() => _buildingModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Eliminar edificio (sólo SysAdmin) -- Docs/Pendientes-Negocio-Migracion.md #6.3 -->
<Modal @ref="_deleteBuildingModal"
       Title="Eliminar Edificio"
       UseStaticBackdrop="true"
       CloseOnEscape="false"
       IsVerticallyCentered="true">
    <BodyTemplate>
        @if (_buildingToDelete != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Esta acción es <strong>permanente</strong> y no se puede deshacer. Sólo
                funciona si el edificio está vacío (sin unidades, propietarios, cuentas
                bancarias, categorías u otros datos) -- pensado para limpiar edificios de
                <strong>prueba</strong>, no para borrar un edificio con actividad real.
            </div>
            <p>
                Para confirmar, escriba el nombre del edificio
                (<strong>@_buildingToDelete.Name</strong>) exactamente como aparece:
            </p>
            <input class="form-control"
                   @bind="_deleteBuildingConfirmText"
                   @bind:event="oninput"
                   placeholder="@_buildingToDelete.Name" />
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-danger"
                disabled="@(_buildingToDelete == null || _deleteBuildingConfirmText != _buildingToDelete.Name)"
                @onclick="DeleteBuildingConfirmed">
            <i class="bi bi-trash me-1"></i>Eliminar definitivamente
        </button>
        <button class="btn btn-secondary" @onclick="() => HideDeleteBuildingModal()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>