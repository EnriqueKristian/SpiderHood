<!-- Modal para crear/editar edificio -->
<Modal @ref="_buildingModal" Title="@(_isEditingBuilding ? "Editar Edificio" : "Nuevo Edificio")" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="_editingBuilding" OnValidSubmit="SaveBuilding">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Nombre del Edificio *</label>
                        <InputText @bind-Value="_editingBuilding.Name" class="form-control" />
                        <ValidationMessage For="@(() => _editingBuilding.Name)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Ubicación *</label>
                        <InputText @bind-Value="_editingBuilding.Location" class="form-control" />
                        <ValidationMessage For="@(() => _editingBuilding.Location)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tipo *</label>
                        @* Building.Type es int (Parameter.Value del grupo Sistema "Tipo Edificio",
                           IdParent=34, ver Docs/Design-Defaults-Sistema-Mixto.md §5.4). Antes el
                           select tenía las 3 opciones hardcodeadas con el NOMBRE como value
                           ("Familiar"/"Comercial"/"Mixto"), que nunca podía parsear a un int: la
                           selección nunca se guardaba de verdad, Type quedaba siempre en 0 sin
                           importar qué se eligiera (por eso el badge de Tipo mostraba "No se
                           encontró coincidencia" en cualquier edificio nuevo). Ahora sale de
                           ParameterService.ListParameters, con el Value real como option value. *@
                         <select @bind-value="_editingBuilding.Type" @bind-value:event="onchange" class="form-select">
                            @foreach (var tipo in ParameterService.ListParameters.Where(p => p.IdParent == 34).OrderBy(p => p.Value))
                            {
                                <option value="@tipo.Value">@tipo.ShortDescription</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Número de Pisos *</label>
                        <InputNumber @bind-Value="_editingBuilding.Floors" class="form-control" min="1" />
                        <ValidationMessage For="@(() => _editingBuilding.Floors)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Sótanos</label>
                        <InputNumber @bind-Value="_editingBuilding.Basements" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Departamentos *</label>
                        <InputNumber @bind-Value="_editingBuilding.Apartments" class="form-control" min="0" />
                        <ValidationMessage For="@(() => _editingBuilding.Apartments)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estacionamientos</label>
                        <InputNumber @bind-Value="_editingBuilding.Parkings" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Depósitos</label>
                        <InputNumber @bind-Value="_editingBuilding.Deposits" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Otros</label>
                        <InputNumber @bind-Value="_editingBuilding.Others" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Área Total (m²) *</label>
                        <InputNumber @bind-Value="_editingBuilding.TotalArea" class="form-control" step="0.01" min="0" />
                        <ValidationMessage For="@(() => _editingBuilding.TotalArea)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <div class="form-check">
                            <InputCheckbox @bind-Value="_editingBuilding.IsActive" class="form-check-input" />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
                @if (currentUser.Role == "SysAdmin")
                {
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                Edificio Template
                                <i class="bi bi-info-circle text-muted" title="Sus valores de Configuración se usan como default al crear un edificio nuevo. Sólo lo ve/edita SysAdmin."></i>
                            </label>
                            <div class="form-check">
                                <InputCheckbox @bind-Value="_editingBuilding.IsTemplate" class="form-check-input" />
                                <label class="form-check-label">Es edificio template</label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveBuilding">
            <i class="bi bi-check me-1"></i>@(_isEditingBuilding ? "Actualizar" : "Crear")
        </button>
        <button class="btn btn-secondary" @onclick="() => _buildingModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal de configuración rápida -->
<Modal @ref="_quickConfigModal" Title="Configuración Rápida" Size="ModalSize.Regular">
    <BodyTemplate>
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Esta configuración se aplicará solo al edificio seleccionado.
        </div>
         <div class="form-group mb-3">
            <label class="form-label">Copiar configuración de:</label>
            <select @bind-Value="_sourceBuildingId" @bind-Value:event="oninput" class="form-select">
                <option value="">-- Seleccionar edificio --</option>
                @foreach (var building in Buildings.Where(b => b.IdBuilding != _quickConfigBuilding?.IdBuilding))
                {
                    <option value="@building.IdBuilding">@building.Name (Edificio #@building.Number)</option>
                }
            </select>
        </div>
        <div class="form-group mb-3">
            
            <label class="form-label">¿Qué configuraciones copiar?</label>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyCurrency" class="form-check-input" />
                <label class="form-check-label">Moneda y cuentas bancarias</label>
            </div>
            
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyPayments" class="form-check-input" />
                <label class="form-check-label">Configuración de pagos</label>
            </div>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyFines" class="form-check-input" />
                <label class="form-check-label">Multas y mora</label>
            </div>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyContacts" class="form-check-input" />
                <label class="form-check-label">Contactos</label>
            </div>
            
            <div class="form-check">
                <InputCheckbox id="copyAll" class="form-check-input" @bind-Value="_copyAll"  />
                <label class="form-check-label" for="copyAll">Todas las configuraciones</label>
            </div>
            
            <!--
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyAll" class="form-check-input"
                               @onchange="(e) => _copyAll = (bool)e.Value; if (_copyAll) { _copyCurrency = _copyPayments = _copyFines = _copyContacts = true; }" />
                <label class="form-check-label">Todas las configuraciones</label>
            </div>
            -->
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="ApplyQuickConfig" disabled="@(_sourceBuildingId == null)">
            <i class="bi bi-copy me-1"></i>Aplicar Configuración
        </button>
        <button class="btn btn-secondary" @onclick="() => _quickConfigModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal para crear/editar Cuentas Bancarias -->
<Modal @ref="_bankAccount" Title="@(_isEditingBanckAccount ? "Editar Cta." : "Nuevo Cta.")" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="_editingBankAccout" OnValidSubmit="SaveBankAccout" method="post" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Banco *</label>
                        <InputText @bind-Value="_editingBankAccout.BankName" class="form-control" min="1" />
                        <ValidationMessage For="@(() => _editingBankAccout.BankName)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Nro. de cuenta *</label>
                        <InputText @bind-Value="_editingBankAccout.AccountNumber" class="form-control" maxlength="30" />
                        <ValidationMessage For="@(() => _editingBankAccout.AccountNumber)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Titular</label>
                        <InputText @bind-Value="_editingBankAccout.AccountName" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">CCI</label>
                        <InputText @bind-Value="_editingBankAccout.CCI" class="form-control" maxlength="30" />
                        <ValidationMessage For="@(() => _editingBankAccout.CCI)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tipo *</label>
                        <select @bind-Value="_editingBankAccout.AccountType" @bind-Value:event="oninput" class="form-select">
                            <!--    PARAMETRO_PADRE     -->
                            @foreach( var type in filteredParameters!.Where(c => c.IdParent == 31))
                            {
                                <option value="@type.Value">@type.ShortDescription</option>    
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Saldo Inicial *</label>
                        <InputNumber @bind-Value="_editingBankAccout.ReconciledBalance" class="form-control" min="0" />
                        <ValidationMessage For="@(() => _editingBankAccout.ReconciledBalance)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <div class="form-check">
                            <InputCheckbox @bind-Value="BankAccountIsActive" class="form-check-input" />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveBankAccout">
            <i class="bi bi-check me-1"></i>@(_isEditingBanckAccount ? "Actualizar" : "Crear")
        </button>
        <button class="btn btn-secondary" @onclick="() => CloseBankModal()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal para crear/editar Exoneraciones -->
<Modal @ref="_exoneration" Title="Agregar Exoneracion"  Size="ModalSize.Regular">
    <BodyTemplate>
        <EditForm Model="_editingBankAccout" OnValidSubmit="SaveExoneration" method="post" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Departamento *</label>
                        <select @bind-Value="_Exoneration.IdGroupUnit" @bind-Value:event="oninput" class="form-select">
                            <!--    PARAMETRO_PADRE     -->
                            @foreach (var type in filteredUnits)
                            {
                                <option value="@type.IdGroupUnit">DPTO @type.UnitNumber </option>
                            }
                        </select>
                        <ValidationMessage For="@(() => _Exoneration.IdGroupUnit)" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Categoria de Gasto *</label>
                        <select @bind-Value="_Exoneration.IdCategory" @bind-Value:event="oninput" class="form-select">
                            <!--    PARAMETRO_PADRE     -->
                            <option value="">Seleccionar categoría</option>
                            @foreach (var item in filteredCategory.Where(c => c.Nivel == 0))
                            {
                                <optgroup label="@item.ShortDescript">
                                    @foreach (var subitem in filteredCategory.Where(c => c.ParentId == item.IdCategory))
                                    {
                                        <option value="@subitem.IdCategory">@subitem.ShortDescript</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <ValidationMessage For="@(() => _Exoneration.IdCategory)" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Motivo Exoneración  *</label>
                        <InputTextArea @bind-Value="_Exoneration.Description" class="form-control" Rows="2" />
                        <ValidationMessage For="@(() => _Exoneration.Description)" />
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveExoneration">
            <i class="bi bi-check me-1"></i>Crear
        </button>
        <button class="btn btn-secondary" @onclick="() => CloseExonerationModal()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>