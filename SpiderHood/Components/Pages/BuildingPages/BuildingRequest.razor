@page "/building-request"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using SpiderHood.Services
@inject Services.AuthService AuthService
@inject Services.IBuildingService BuildingService
@inject NavigationManager Navigation

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-door-open me-2"></i>
                        Solicitar Acceso a Edificio
                    </h4>
                </div>

                <div class="card-body">
                    @if (_loading)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    }
                    else if (currentUser == null)
                    {
                        <div class="alert alert-warning">Debés iniciar sesión para solicitar acceso a un edificio.</div>
                    }
                    else
                    {
                        @if (currentUser.Buildings.Any(b => !b.IsApproved))
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                Tenés @currentUser.Buildings.Count(b => !b.IsApproved)
                                solicitud(es) pendiente(s) de aprobación.
                            </div>
                        }

                        @if (!availableBuildings.Any())
                        {
                            <div class="alert alert-secondary">
                                Ya tenés una solicitud o membresía como Residente en todos los edificios disponibles.
                            </div>
                        }
                        else
                        {
                            <EditForm Model="@request" OnValidSubmit="@SubmitRequest">
                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label class="form-label">Edificio</label>
                                    <InputSelect class="form-control" @bind-Value="request.BuildingId">
                                        <option value="">-- Seleccionar edificio --</option>
                                        @foreach (var building in availableBuildings)
                                        {
                                            <option value="@building.IdBuilding">@building.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => request.BuildingId)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Rol solicitado</label>
                                    <input class="form-control" value="Residente" disabled />
                                    <small class="text-muted">
                                        Sólo se puede solicitar acceso como Residente. Otros roles (Administrador,
                                        Junta) los otorga manualmente el administrador del edificio.
                                    </small>
                                </div>

                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Enviando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send me-2"></i>
                                        <span>Enviar Solicitud</span>
                                    }
                                </button>
                            </EditForm>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success mt-3">
                                <i class="bi bi-check-circle me-2"></i>
                                @successMessage
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-3">
                                <i class="bi bi-exclamation-circle me-2"></i>
                                @errorMessage
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private BuildingRequestModel request = new();
    private List<Models.Building> availableBuildings = new();
    private bool isLoading;
    private bool _loading = true;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private Models.UserSession? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;

            await LoadAvailableBuildings();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAvailableBuildings()
    {
        var allBuildings = await BuildingService.GetAllBuildingsPublicAsync();

        // No tiene sentido ofrecer un edificio donde ya sos Residente (aprobado o pendiente).
        var yaSolicitados = currentUser!.Buildings
            .Where(b => b.Role == "Residente" && b.Building != null)
            .Select(b => b.Building!.IdBuilding)
            .ToHashSet();

        // El Edificio Template (Docs/Design-Defaults-Sistema-Mixto.md) no es un
        // edificio real -- nadie puede pedir acceso a él.
        availableBuildings = allBuildings
            .Where(b => !yaSolicitados.Contains(b.IdBuilding) && !b.IsTemplate)
            .ToList();
    }

    private async Task SubmitRequest()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        try
        {
            isLoading = true;
            var result = await AuthService.RequestBuildingAccess(request.BuildingId, "Residente");

            if (result)
            {
                successMessage = "Solicitud enviada correctamente. Esperá la aprobación del administrador.";
                request = new();
                await LoadAvailableBuildings();
            }
            else
            {
                errorMessage = "No se pudo enviar la solicitud (puede que ya tengas una para ese edificio).";
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private class BuildingRequestModel
    {
        [Required(ErrorMessage = "Selecciona un edificio")]
        public Guid BuildingId { get; set; }
    }
}