@page "/building-request"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using SpiderHood.Services
@inject Services.AuthService AuthService
@inject Services.IBuildingService BuildingService
@inject NavigationManager Navigation

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-door-open me-2"></i>
                        Solicitar Acceso a Edificio
                    </h4>
                </div>

                <div class="card-body">
                    @if (_loading)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    }
                    else if (currentUser == null)
                    {
                        <div class="alert alert-warning">Debes iniciar sesión para solicitar acceso a un edificio.</div>
                    }
                    else
                    {
                        @if (currentUser.Buildings.Any(b => !b.IsApproved))
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                Tienes @currentUser.Buildings.Count(b => !b.IsApproved)
                                solicitud(es) pendiente(s) de aprobación.
                            </div>
                        }

                        @if (!availableBuildings.Any())
                        {
                            <div class="alert alert-secondary">
                                Ya tienes una solicitud o membresía como Residente en todos los edificios disponibles.
                            </div>
                        }
                        else
                        {
                            <EditForm Model="@request" OnValidSubmit="@SubmitRequest">
                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label class="form-label">Edificio</label>
                                    <select class="form-control" value="@(request.BuildingId == Guid.Empty ? "" : request.BuildingId.ToString())" @onchange="OnBuildingChangedAsync">
                                        <option value="">-- Seleccionar edificio --</option>
                                        @foreach (var building in availableBuildings)
                                        {
                                            <option value="@building.IdBuilding">@building.Name</option>
                                        }
                                    </select>
                                    <ValidationMessage For="@(() => request.BuildingId)" />
                                </div>

                                @if (request.BuildingId != Guid.Empty)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">DPTO / Unidad</label>
                                        @if (_loadingUnits)
                                        {
                                            <div class="text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Cargando unidades...</div>
                                        }
                                        else if (!_units.Any())
                                        {
                                            <div class="text-muted small">
                                                Este edificio todavía no tiene unidades cargadas -- el administrador te
                                                la va a asignar al aprobar tu solicitud.
                                            </div>
                                        }
                                        else
                                        {
                                            <InputSelect class="form-control" @bind-Value="request.IdGroupUnit">
                                                <option value="">-- Seleccionar tu unidad --</option>
                                                @foreach (var unit in _units)
                                                {
                                                    <option value="@unit.IdGroupUnit">Grupo @unit.GroupNumber — @unit.FirstName @unit.LastName</option>
                                                }
                                            </InputSelect>
                                            @if (_showUnitRequiredError)
                                            {
                                                <div class="text-danger small mt-1">Selecciona tu unidad para continuar.</div>
                                            }
                                        }
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label">Rol solicitado</label>
                                    <input class="form-control" value="Residente" disabled />
                                    <small class="text-muted">
                                        Sólo se puede solicitar acceso como Residente. Otros roles (Administrador,
                                        Junta) los otorga manualmente el administrador del edificio.
                                    </small>
                                </div>

                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Enviando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send me-2"></i>
                                        <span>Enviar Solicitud</span>
                                    }
                                </button>
                            </EditForm>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success mt-3">
                                <i class="bi bi-check-circle me-2"></i>
                                @successMessage
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-3">
                                <i class="bi bi-exclamation-circle me-2"></i>
                                @errorMessage
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private BuildingRequestModel request = new();
    private List<Models.Building> availableBuildings = new();
    private List<Models.OwnerUnitView> _units = new();
    private bool _loadingUnits;
    private bool _showUnitRequiredError;
    private bool isLoading;
    private bool _loading = true;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private Models.UserSession? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;

            await LoadAvailableBuildings();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAvailableBuildings()
    {
        var allBuildings = await BuildingService.GetAllBuildingsPublicAsync();

        // No tiene sentido ofrecer un edificio donde ya sos Residente (aprobado o pendiente).
        var yaSolicitados = currentUser!.Buildings
            .Where(b => b.Role == "Residente" && b.Building != null)
            .Select(b => b.Building!.IdBuilding)
            .ToHashSet();

        // El Edificio Template (Docs/Design-Defaults-Sistema-Mixto.md) no es un
        // edificio real -- nadie puede pedir acceso a él.
        availableBuildings = allBuildings
            .Where(b => !yaSolicitados.Contains(b.IdBuilding) && !b.IsTemplate)
            .ToList();
    }

    private async Task OnBuildingChangedAsync(ChangeEventArgs e)
    {
        request.BuildingId = Guid.TryParse(e.Value?.ToString(), out var parsed) ? parsed : Guid.Empty;
        request.IdGroupUnit = null;
        _showUnitRequiredError = false;
        _units = new();

        if (request.BuildingId == Guid.Empty) return;

        _loadingUnits = true;
        try
        {
            _units = (await BuildingService.GetOwnersByBuildingAsync(request.BuildingId))
                .DistinctBy(u => u.IdGroupUnit)
                .OrderBy(u => u.GroupNumber)
                .ToList();
        }
        finally
        {
            _loadingUnits = false;
        }
    }

    private async Task SubmitRequest()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (_units.Any() && !request.IdGroupUnit.HasValue)
        {
            _showUnitRequiredError = true;
            return;
        }
        _showUnitRequiredError = false;

        try
        {
            isLoading = true;
            var result = await AuthService.RequestBuildingAccess(request.BuildingId, "Residente", request.IdGroupUnit);

            if (result)
            {
                successMessage = "Solicitud enviada correctamente. Espera la aprobación del administrador.";
                request = new();
                _units = new();
                await LoadAvailableBuildings();
            }
            else
            {
                errorMessage = "No se pudo enviar la solicitud (puede que ya tengas una para ese edificio).";
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private class BuildingRequestModel
    {
        [Required(ErrorMessage = "Selecciona un edificio")]
        public Guid BuildingId { get; set; }
        public Guid? IdGroupUnit { get; set; }
    }
}