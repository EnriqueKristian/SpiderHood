                                                        {
                                                            <optgroup label="@item.ShortDescript">
                                                                @foreach(var subitem in filteredCategory.Where(c => c.ParentId == item.IdCategory))
                                                            {
                                                                <option value="@subitem.IdCategory">@subitem.ShortDescript</option>
                                                            }
                                                            </optgroup>
                                                        }
                                                    </select>
                                                </div>
                                            
                                                <div class="action-buttons">
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("category")'>
                                                        <i class="bi bi-check"></i> Guardar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                            <p></p>
                                            <div class="form-compact">
                                                <div class="form-group">
                                                    <label class="form-label">Categoría para Calculo de Agua</label>
                                                    <select @bind-Value="SelectedBuilding.Configuration.WaterReadingDefault" @bind-Value:event="oninput" class="form-select form-select-sm">
                                                        <option value="">Seleccionar categoría</option>
                                                        @foreach (var item in filteredCategory.Where(c => c.Nivel == 0))
                                                        {
                                                            <optgroup label="@item.ShortDescript">
                                                                @foreach (var subitem in filteredCategory.Where(c => c.ParentId == item.IdCategory))
