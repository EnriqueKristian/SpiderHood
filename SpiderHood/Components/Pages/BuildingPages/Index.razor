                                                    <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("category")'>
                                                        <i class="bi bi-check"></i> Guardar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary rounded-circle p-3  me-2">
                                                    <i class="bi bi-tag-fill text-white"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@GetCategoryName(SelectedBuilding!.Configuration.DefaultCategory)</div>
                                                    <div class="text-muted small">Categoría de Gastos por defecto</div>
                                                </div>
                                                
                                            </div>
                                            <p></p>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary rounded-circle p-3  me-2">
                                                    <i class="fas fa-tint mr-3"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">Agua Potable</div>
                                                    <div class="text-muted small">Categoría de Agua</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                               <!-- Sección Excepciones de Pago -->
                                <div class="card card-hover config-card @(_editingSection == "exception" ? "edit-mode" : "")">
                                    <div class="card-body">
                                        <div class="edit-button">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    @onclick='() => StartEditSection("exception")'>
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>

                                        <h6 class="section-title">
                                            <i class="bi bi-currency-exchange me-2"></i>Excepciones de Pago
                                        </h6>

                                        @if (_editingSection == "exception")
                                        {
                                            <div class="form-compact">
                                                <div class="form-group">
                                                    <label class="form-label">Excepciones Configuradas</label>
                                                    <div>
                                                        @{
                                                            // Obtener excepciones ordenadas
                                                            var exonerationsList = SelectedBuilding.Configuration.Exonerations
                                                                .Where(c => !c.IsDeleted)
                                                                .OrderBy(c => c.IdGroupUnit)
                                                                .ThenBy(c => c.IdCategory)
                                                                .ToList();
                            
                                                            var groupedExonerations = exonerationsList
                                                                .GroupBy(c => c.IdGroupUnit);
                                                        }

                                                        @if (exonerationsList.Count == 0)
                                                        {
                                                            <div class="alert alert-info py-2">
                                                                <i class="bi bi-info-circle me-2"></i>
                                                                No hay excepciones configuradas
                                                            </div>
                                                        }

                                                        @foreach (var group in groupedExonerations)
                                                        {
                                                            <div class="row-md-3 mb-3">
                                                                <div class="card card-hover">
                                                                    <div class="card-body">
                                                                        <!-- Encabezado del departamento -->
                                                                        <div class="d-flex align-items-center mb-2">
                                                                            <i class="bi bi-building me-2"></i>
                                                                            <div class="fw-semibold">@GetGroupUnitName(group.Key)</div>
                                                                        </div>

                                                                        <!-- Lista de categorías exoneradas -->
                                                                        <div class="ms-4">
                                                                            @foreach (var item in group)
                                                                            {
                                                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                                                    <div class="text-muted small">
                                                                                        @GetCategoryName(item.IdCategory)
                                                                                    </div>
                                                                                    <button type="button" 
                                                                                            class="btn btn-sm btn-outline-danger ms-2"
                                                                                            @onclick="() => RemoveException(item)">
                                                                                        <i class="bi bi-trash"></i>
                                                                                    </button>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                        
                                                        <div class="mt-3">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                    @onclick="ShowAddExceptionModal">
                                                                <i class="bi bi-plus"></i> Agregar Exoneración
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="action-buttons mt-3">
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("exception")'>
                                                        <i class="bi bi-check"></i> Guardar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mb-3">
                                                <label class="form-label small text-muted">Categorías Exoneradas por Dpto</label>
                                                <div>
                                                    @if (SelectedBuilding.Configuration.Exonerations.Count == 0)
                                                    {
                                                        <div class="text-muted">No hay excepciones configuradas</div>
                                                    }
                                                    else
                                                    {
                                                        var groupedExonerations = SelectedBuilding.Configuration.Exonerations
                                                                .Where(c => !c.IsDeleted)
                                                                .OrderBy(c => c.IdGroupUnit)
                                                                .GroupBy(c => c.IdGroupUnit);
                                                        

                                                        @foreach (var group in groupedExonerations)
                                                        {
                                                            <div class="row-md-3 mb-3">
                                                                <div class="card card-hover">
                                                                    <div class="card-body">
                                                                        <!-- Encabezado del departamento -->
                                                                        <div class="d-flex align-items-center mb-2">
                                                                            <i class="bi bi-building me-2"></i>
                                                                            <div class="fw-semibold">@GetGroupUnitName(group.Key)</div>
                                                                        </div>

                                                                        <!-- Lista de categorías exoneradas -->
                                                                        <div class="ms-4">
                                                                            @foreach (var item in group)
                                                                            {
                                                                                <div class="text-muted small mb-1">@GetCategoryName(item.IdCategory)</div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else
            {
                <div class="card card-hover">
                    <div class="card-body">
                        <div class="empty-state">
                            <i class="bi bi-building-gear" style="font-size: 4rem;"></i>
                            <h4 class="mb-2">Selecciona un edificio</h4>
                            <p class="text-muted mb-3">Para ver y editar la configuración, selecciona un edificio de la lista</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para crear/editar edificio -->
<Modal @ref="_buildingModal" Title="@(_isEditingBuilding ? "Editar Edificio" : "Nuevo Edificio")" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="_editingBuilding" OnValidSubmit="SaveBuilding">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Nombre del Edificio *</label>
                        <InputText @bind-Value="_editingBuilding.Name" class="form-control" />
                        <ValidationMessage For="@(() => _editingBuilding.Name)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Ubicación *</label>
                        <InputText @bind-Value="_editingBuilding.Location" class="form-control" />
                        <ValidationMessage For="@(() => _editingBuilding.Location)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tipo *</label>
                        <select @bind-Value="_editingBuilding.Type" @bind-Value:event="oninput" class="form-select">
                            <option value="Familiar">Familiar</option>
                            <option value="Comercial">Comercial</option>
                            <option value="Mixto">Mixto</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Número de Pisos *</label>
                        <InputNumber @bind-Value="_editingBuilding.Floors" class="form-control" min="1" />
                        <ValidationMessage For="@(() => _editingBuilding.Floors)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Sótanos</label>
                        <InputNumber @bind-Value="_editingBuilding.Basements" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Departamentos *</label>
                        <InputNumber @bind-Value="_editingBuilding.Apartments" class="form-control" min="0" />
                        <ValidationMessage For="@(() => _editingBuilding.Apartments)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estacionamientos</label>
                        <InputNumber @bind-Value="_editingBuilding.Parkings" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Depósitos</label>
                        <InputNumber @bind-Value="_editingBuilding.Deposits" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Otros</label>
                        <InputNumber @bind-Value="_editingBuilding.Others" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Área Total (m²) *</label>
                        <InputNumber @bind-Value="_editingBuilding.TotalArea" class="form-control" step="0.01" min="0" />
                        <ValidationMessage For="@(() => _editingBuilding.TotalArea)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <div class="form-check">
                            <InputCheckbox @bind-Value="_editingBuilding.IsActive" class="form-check-input" />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="SaveBuilding">
            <i class="bi bi-check me-1"></i>@(_isEditingBuilding ? "Actualizar" : "Crear")
        </button>
        <button class="btn btn-secondary" @onclick="() => _buildingModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal de configuración rápida -->
<Modal @ref="_quickConfigModal" Title="Configuración Rápida" Size="ModalSize.Regular">
    <BodyTemplate>
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Esta configuración se aplicará solo al edificio seleccionado.
        </div>
         <div class="form-group mb-3">
            <label class="form-label">Copiar configuración de:</label>
            <select @bind-Value="_sourceBuildingId" @bind-Value:event="oninput" class="form-select">
                <option value="">-- Seleccionar edificio --</option>
                @foreach (var building in Buildings.Where(b => b.IdBuilding != _quickConfigBuilding?.IdBuilding))
                {
                    <option value="@building.IdBuilding">@building.Name (Edificio #@building.Number)</option>
                }
            </select>
        </div>
        <div class="form-group mb-3">
            
            <label class="form-label">¿Qué configuraciones copiar?</label>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyCurrency" class="form-check-input" />
                <label class="form-check-label">Moneda y cuentas bancarias</label>
            </div>
            
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyPayments" class="form-check-input" />
                <label class="form-check-label">Configuración de pagos</label>
            </div>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyFines" class="form-check-input" />
                <label class="form-check-label">Multas y mora</label>
            </div>
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyContacts" class="form-check-input" />
                <label class="form-check-label">Contactos</label>
            </div>
            
            <div class="form-check">
                <InputCheckbox id="copyAll" class="form-check-input" @bind-Value="_copyAll"  />
                <label class="form-check-label" for="copyAll">Todas las configuraciones</label>
            </div>
            
            <!--
            <div class="form-check">
                <InputCheckbox @bind-Value="_copyAll" class="form-check-input"
                               @onchange="(e) => _copyAll = (bool)e.Value; if (_copyAll) { _copyCurrency = _copyPayments = _copyFines = _copyContacts = true; }" />
                <label class="form-check-label">Todas las configuraciones</label>
            </div>
            -->
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="ApplyQuickConfig" disabled="@(_sourceBuildingId == null)">
            <i class="bi bi-copy me-1"></i>Aplicar Configuración
        </button>
        <button class="btn btn-secondary" @onclick="() => _quickConfigModal.HideAsync()">
            <i class="bi bi-x me-1"></i>Cancelar
        </button>
    </FooterTemplate>
</Modal>

<!-- Modal para crear/editar Cuentas Bancarias -->
<Modal @ref="_bankAccount" Title="@(_isEditingBanckAccount ? "Editar Cta." : "Nuevo Cta.")" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="_editingBankAccout" OnValidSubmit="SaveBankAccout" method="post" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Banco *</label>
                        <InputText @bind-Value="_editingBankAccout.BankName" class="form-control" min="1" />
                        <ValidationMessage For="@(() => _editingBankAccout.BankName)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Nro. de cuenta *</label>
                        <InputText @bind-Value="_editingBankAccout.AccountNumber" class="form-control" />
                        <ValidationMessage For="@(() => _editingBankAccout.AccountNumber)" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tipo *</label>
                        <select @bind-Value="_editingBankAccout.AccountType" @bind-Value:event="oninput" class="form-select">
                            <!--    PARAMETRO_PADRE     -->
                            @foreach( var type in filteredParameters!.Where(c => c.IdParent == 31))
                            {
                                <option value="@type.Value">@type.ShortDescription</option>    
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Saldo Inicial *</label>
