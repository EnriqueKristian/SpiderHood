                                                              class="form-control form-control-sm" />
                                                </div>
                                                
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label class="form-label">Teléfono Oficina</label>
                                                            <InputText @bind-Value="SelectedBuilding.Configuration.MaintenanceCompany.OfficePhone" 
                                                                      class="form-control form-control-sm" />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label class="form-label">Teléfono Celular</label>
                                                            <InputText @bind-Value="SelectedBuilding.Configuration.MaintenanceCompany.MobilePhone" 
                                                                      class="form-control form-control-sm" />
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="form-group">
                                                    <label class="form-label">Email</label>
                                                    <InputText @bind-Value="SelectedBuilding.Configuration.MaintenanceCompany.Email" 
                                                              type="email"
                                                              class="form-control form-control-sm" />
                                                </div>
                                                
                                                <div class="form-group">
                                                    <label class="form-label">Dirección</label>
                                                    <InputText @bind-Value="SelectedBuilding.Configuration.MaintenanceCompany.Address" 
                                                              class="form-control form-control-sm" />
                                                </div>
                                                
                                                <div class="action-buttons">
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick='() => SaveSection("maintenance")'>
                                                        <i class="bi bi-check"></i> Guardar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
