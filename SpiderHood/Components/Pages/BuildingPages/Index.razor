                                                <div class="fw-semibold mb-1">@SelectedBuilding.Configuration.MaintenanceCompany.Name</div>
                                                <div class="text-muted small">Contratista principal</div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="bi bi-telephone text-success me-2"></i>
                                                <div class="small">@SelectedBuilding.Configuration.MaintenanceCompany.OfficePhone</div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="bi bi-phone text-success me-2"></i>
                                                <div class="small">@SelectedBuilding.Configuration.MaintenanceCompany.MobilePhone</div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="bi bi-envelope text-warning me-2"></i>
                                                <div class="small">@SelectedBuilding.Configuration.MaintenanceCompany.Email</div>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-geo-alt text-danger me-2"></i>
