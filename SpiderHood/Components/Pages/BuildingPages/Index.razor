                                        @if (_editingSection == "category")
                                        {
                                            <div class="form-compact">
                                                <div class="form-group">
                                                    <label class="form-label">Categoría de Gastos Default</label>
                                                    <select @bind-Value="SelectedBuilding.Configuration.DefaultCategory" @bind-Value:event="oninput" class="form-select form-select-sm">
