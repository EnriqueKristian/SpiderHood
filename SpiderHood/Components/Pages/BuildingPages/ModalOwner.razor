﻿@using System.ComponentModel.DataAnnotations
@using SpiderHood.Services
@inherits LayoutComponentBase
@inject ParameterService ParameterService

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person me-2 text-primary"></i>@((OpenMode == Models.OpenType.Create) ? "Agregar Propietario" : "Actualizar Propietario")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <EditForm Id="create" Model="@ViewOwner" OnValidSubmit="@Guardar" method="post" FormName="create" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                    <div class="modal-body">
                        <table class="table-color">
                            <tr>
                                <td width="100px"><strong>Tipo Persona</strong></td>
                                <td colspan="3">
                                    <table width="60%">
                                        <tr>
                                            <td>
                                                <div class="radio-option">
                                                    <input type="radio"
                                                           id="Natural"
                                                           name="tipoPersona"
                                                           @onchange="CambiarPersona"
                                                           value="Natural"
                                                           checked />
                                                    <label for="distFijo" class="radio-label">
                                                        <span class="radio-title">Natural</span>
                                                    </label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="radio-option">
                                                    <input type="radio"
                                                           id="Juridica"
                                                           name="tipoPersona"
                                                           @onchange="CambiarPersona"
                                                           value="Juridica" />
                                                    <label for="distProporcional" class="radio-label">
                                                        <span class="radio-title">Jurídica</span>
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="text-danger">*</span>
                                    <label for="names" class="form-label"><strong>@((SelectedPersonType == "Natural") ? "Nombres" : "Razon Social"):</strong></label>
                                </td>
                                <td colspan="3">
                                    <div class="mb-3">
                                        <InputText id="names" @bind-Value="ViewOwner.Names" class="form-control" aria-required="true" />
                                        <ValidationMessage For="() => ViewOwner.Names" class="text-danger" />
                                    </div>
                                </td>
                            </tr>
                            @if (SelectedPersonType == "Natural")
                            {
                                <tr>
                                    <td>
                                        <label for="surnamem" class="form-label"><strong>Apellidos:</strong></label>
                                    </td>
                                    <td colspan="3">
                                        <div class="mb-1">
                                            <InputText id="surnamem" @bind-Value="ViewOwner.Surname" class="form-control" />
                                            <ValidationMessage For="() => ViewOwner.Surname" class="text-danger" />
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                ViewOwner.Surname = ViewOwner.Names;
                            }
                            <tr>
                                <td>
                                    <!--<span class="text-danger">*</span>-->
                                    <label for="typedoc" class="form-label"><strong>Tipo Doc:</strong></label>
                                </td>
                                <td>
                                    <div class="mb-3">
                                        <InputSelect id="typedoc" @bind-Value="ViewOwner.IdTypeIdNumber" class="form-select">

                                            @foreach (var param in ParameterService.ListParameters.Where(c => c.IdParent == Convert.ToInt32(Models.ParamParent.DocumentType)))
                                            {
                                                <option value="@param.Value" selected>@param.ShortDescription</option>
                                            }

                                        </InputSelect>
                                        <ValidationMessage For="() => ViewOwner.IdTypeIdNumber" class="text-danger" />
                                    </div>
                                </td>
                                <td>
                                    <!--<span class="text-danger">*</span>-->
                                    <label for="nrodoc" class="form-label"><strong>Doc:</strong></label>
                                </td>
                                <td>
                                    <div class="mb-3">
                                        <InputText id="nrodoc" @bind-Value="ViewOwner.IdNumber" class="form-control" aria-required="true" />
                                        <ValidationMessage For="() => ViewOwner.IdNumber" class="text-danger" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="text-danger">*</span>
                                    <label for="address" class="form-label"><strong>Direccion:</strong></label>
                                </td>
                                <td colspan="3">
                                    <div class="mb-3">
                                        <InputText id="address" @bind-Value="ViewOwner.Address" class="form-control" aria-required="true" />
                                        <ValidationMessage For="() => ViewOwner.Address" class="text-danger" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="phonenumber" class="form-label"><strong>Teléfono:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputText id="phonenumber" @bind-Value="ViewOwner.PhoneNumber" class="form-control" />
                                        <ValidationMessage For="() => ViewOwner.PhoneNumber" class="text-danger" />
                                    </div>
                                </td>
                                <td><label for="mobilephone" class="form-label"><strong>Celular:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputText id="mobilephone" @bind-Value="ViewOwner.MobilePhone" class="form-control" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="workphone" class="form-label"><strong>Tel. Trabajo:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputText id="workphone" @bind-Value="ViewOwner.WorkPhone" class="form-control" />
                                    </div>
                                </td>
                                <td><label for="email" class="form-label"><strong>Email:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputText id="email" @bind-Value="ViewOwner.Email" class="form-control" />
                                        <ValidationMessage For="() => ViewOwner.Email" class="text-danger" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="relationshiptype" class="form-label"><strong>Relación:</strong></label></td>
                                <td colspan="3">
                                    <div class="mb-1">
                                        <InputSelect id="relationshiptype" @bind-Value="ViewOwner.RelationshipType" class="form-select">
                                            <option value="">-- Seleccione --</option>
                                            <option value="Propietario">Propietario</option>
                                            <option value="Co-Propietario">Co-Propietario</option>
                                            <option value="Inquilino">Inquilino</option>
                                            <option value="Usufructuario">Usufructuario</option>
                                        </InputSelect>
                                    </div>
                                </td>
                            </tr>
                            @if (SelectedPersonType == "Juridica")
                            {
                                <tr>
                                    <td><label for="businessname" class="form-label"><strong>Razón Social:</strong></label></td>
                                    <td colspan="3">
                                        <div class="mb-1">
                                            <InputText id="businessname" @bind-Value="ViewOwner.BusinessName" class="form-control" />
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td><label for="legalrep" class="form-label"><strong>Repr. Legal:</strong></label></td>
                                    <td>
                                        <div class="mb-1">
                                            <InputText id="legalrep" @bind-Value="ViewOwner.LegalRepresentative" class="form-control" />
                                        </div>
                                    </td>
                                    <td><label for="ructype" class="form-label"><strong>Tipo RUC:</strong></label></td>
                                    <td>
                                        <div class="mb-1">
                                            <InputText id="ructype" @bind-Value="ViewOwner.RucType" class="form-control" />
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td><label for="nationality" class="form-label"><strong>Nacionalidad:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputText id="nationality" @bind-Value="ViewOwner.Nationality" class="form-control" />
                                    </div>
                                </td>
                                <td><label for="civilstatus" class="form-label"><strong>Est. Civil:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputSelect id="civilstatus" @bind-Value="ViewOwner.CivilStatus" class="form-select">
                                            <option value="">-- Seleccione --</option>
                                            <option value="Soltero">Soltero</option>
                                            <option value="Casado">Casado</option>
                                            <option value="Divorciado">Divorciado</option>
                                            <option value="Viudo">Viudo</option>
                                        </InputSelect>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="birthdate" class="form-label"><strong>Fecha Nac.:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputDate id="birthdate" @bind-Value="ViewOwner.BirthDate" class="form-control" />
                                    </div>
                                </td>
                                <td><label for="isactive" class="form-label"><strong>Activo:</strong></label></td>
                                <td>
                                    <div class="mb-1">
                                        <InputCheckbox id="isactive" @bind-Value="ViewOwner.IsActive" class="form-check-input" />
                                    </div>
                                </td>
                            </tr>
                        </table>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </button>
                        <button type="submit" form="create" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>@((OpenMode == Models.OpenType.Create) ? "Guardar" : "Actualizar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public Models.OpenType OpenMode { get; set; }
    [Parameter] public Models.Owner ViewOwner { get; set; }
    //[Parameter] public IQueryable<Models.Parameter> ListParameters { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    [Parameter] public EventCallback<SpiderHood.Models.Owner> OnSaveModal { get; set; }

    // Propiedad para el valor seleccionado
    private string SelectedUnitId { get; set; } = string.Empty;
    private string SelectedPersonType { get; set; } = "Natural";

    private async Task Guardar()
    {
        await OnSaveModal.InvokeAsync(ViewOwner);
        await CerrarModal();
    }

    private async Task CerrarModal()
    {
        ShowModal = false;
        await ShowModalChanged.InvokeAsync(ShowModal);
    }

    private void OnClickCheck()
    {
        //TypeOwner = int.Parse(e.Value.ToString());

    }
    private void CambiarPersona(ChangeEventArgs args)
    {
        SelectedPersonType = args.Value.ToString();
    }
}