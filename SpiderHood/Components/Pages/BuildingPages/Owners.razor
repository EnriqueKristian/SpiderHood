@page "/Owners"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpiderHood.Data
@using SpiderHood.Models
@using SpiderHood.Services
@inject NavigationManager Navigation // Inyecta el servicio de navegación
@inject ParameterService ParameterService
@inject IOwnerService OwnerService
@inject Services.AuthService AuthService
@inject IPermissionService PermissionService
@inject IInstallmentService InstallmentService
@using Microsoft.AspNetCore.Components
@using System.ComponentModel.DataAnnotations.Schema
@inject IJSRuntime JSRuntime


<!--    MODAL PARA NUEVO / MODIFICACION DE PROPIETARIOS   -->
<ModalOwner ShowModal="@MostrarModal"
                                                         ShowModalChanged="@((valor) => MostrarModal = valor)"
                                                         OpenMode="@OpenMode"
                                                   ViewOwner="@_Owner"
                                                   OnSaveModal="@((own) => SaveItem(own))" />


<!--    MODAL PARA NUEVO / MODIFICACION DE PROPIETARIOS   -->
<ModalOwnerUnit ShowModalUnit="@MostrarModalUnit"
                                                   ShowModalChanged="@((valor) => MostrarModalUnit = valor)"
                                                   OpenMode="@OpenMode"
                                                       ViewOwner="@_OwnerUnit"
                                                   FreeUnits="@FreeUnits"
                                                       OnSaveGroupUnit="@((unt) => SaveGroupUnit(unt))" />


<!--    MODAL PARA ELIMINACION DE PROPIETARIOS   -->
<Modal @ref="modal" Title="Eliminar Categoria" UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true">
    <BodyTemplate>
        ¿Esta seguro que desea eliminar al Propietario?.
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="DeleteItem">Aceptar</Button>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cancelar</Button>
    </FooterTemplate>
</Modal>

<PageTitle>Propietarios</PageTitle>

<div class="container-fluid px-4 py-3">
    <!-- Header principal -->
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Propietarios</h1>
                <p class="text-muted mb-0">Administra propietarios, residentes, inquilinos</p>
            </div>
        </div>

        <div class="page-header-actions">
            <button class="btn btn-outline-secondary" @onclick="ExportToExcel">
                <i class="bi bi-file-earmark-excel me-2"></i>Exportar
            </button>
            @if (_canCreateOwner)
            {
                <button class="btn btn-primary" @onclick="ShowAddOwnerModal">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Propietario
                </button>
            }
        </div>
    </div>

    <!-- Filtros y controles -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body py-3">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold mb-1">Tipo de Unidad</label>
                            <select class="form-select" @bind="selectedUnitType">
                                <option value="all">Todos los tipos</option>
                                <option value="DPTO">Departamento</option>
                                <option value="EST">Estacionamiento</option>
                                <option value="LOC">Local Comercial</option>
                                <option value="OFI">Oficina</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold mb-1">Torre/Piso</label>
                            <select class="form-select" @bind="selectedTower">
                                <option value="all">Todas las torres</option>
                                @foreach (var tower in availableTowers)
                                {
                                    <option value="@tower">@tower</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold mb-1">Estado</label>
                            <select class="form-select" @bind="selectedStatus">
                                <option value="all">Todos los estados</option>
                                <option value="Activo">Activo</option>
                                <option value="Inactivo">Inactivo</option>
                                <option value="Moroso">Moroso</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold mb-1">Búsqueda</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <InputText type="text" class="form-control border-start-0"
                                           placeholder="Buscar propietario o unidad..."
                                           @bind-Value="@searchTerm"
                                           @oninput="e => { searchTerm = ((ChangeEventArgs)e).Value?.ToString(); FilterOwners(); }" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas rápidas -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Total Propietarios</div>
                        <div class="stat-value">@totalOwners</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-success">
                        <i class="bi bi-house-door-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Unidades Ocupadas</div>
                        <div class="stat-value">@occupiedUnits/@totalUnits</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Propietarios Morosos</div>
                        <div class="stat-value">@delinquentOwners</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-info">
                        <i class="bi bi-calculator-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Área Promedio</div>
                        <div class="stat-value">@(averageArea.ToString("F1")) m²</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de propietarios -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">
                                <i class="bi bi-list-columns me-2"></i>Lista de Propietarios
                            </h5>
                            <p class="text-muted mb-0 small">
                                Mostrando @startRecord - @endRecord de @totalRecords registros
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <!-- Selector de página -->
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-muted">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                    <!option value="10" selected="@(pageSize == 10)">10</!option>
                                    <!option value="25" selected="@(pageSize == 25)">25</!option>
                                    <!option value="50" selected="@(pageSize == 50)">50</!option>
                                    <!option value="100" selected="@(pageSize == 100)">100</!option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (currentPageData.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="width: 60px;">#</th>
                                        <th>GRUPO (m²)</th>
                                        <th>PROPIETARIO(S)</th>
                                        <th style="width: 100px;">UNIDAD</th>
                                        <th style="width: 80px;">NRO.</th>
                                        <th style="width: 100px;">ÁREA (m²)</th>
                                        <th style="width: 120px;" class="text-center">ACCIÓN</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var owner in currentPageData)
                                    {
                                        <tr class="owner-row" @onclick="() => SelectOwner(owner)" style="cursor: pointer;">
                                            <td class="ps-3">
                                                <span class="badge bg-primary"> @ParameterService.GetChildParameterDescription(4, 1) @owner.GroupNumber</span>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-bold">Area Total</span>
                                                    <small class="text-muted">@owner.TotalArea.ToString("F2") m² total</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    @*foreach (var propietario in Owners.Where(c => c.IdOwner == owner.IdOwner && c.TypeUnit == 1))*@
                                                    @foreach (var propietario in owner.Owners)
                                                    {
                                                        <div class="mb-1">
                                                            <div class="fw-medium">@propietario.FullName</div>
                                                            <small class="text-muted">
                                                                <i class="bi bi-telephone me-1"></i>@propietario.PhoneNumber
                                                            </small>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @GetUnitTypeBadge(1)">
                                                    @ParameterService.GetChildParameterDescription(4, 1)
                                                </span>
                                            </td>
                                            <td align="center">
                                                <span class="fw-bold">@owner.GroupNumber</span>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold">@owner.Area.ToString("F2")<small class="text-muted"> m²</small></span>
                                                    @*  @if (owner.AreaEstacionamiento > 0)
                                                    {
                                                        <small class="text-muted">
                                                            + @owner.AreaEstacionamiento.ToString("F2") est.
                                                        </small>
                                                    }*@
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary"
                                                            title="Ver detalles"
                                                            @onclick:stopPropagation @onclick="() => ViewOwnerDetails(owner)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    @if (_canEditOwner)
                                                    {
                                                        <button class="btn btn-outline-secondary"
                                                                title="Editar"
                                                                @onclick:stopPropagation @onclick="() => EditOwner(owner)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                    }
                                                    @if (_canCreateOwner)
                                                    {
                                                        <button class="btn btn-outline-success"
                                                                title="Agregar residente"
                                                                @onclick:stopPropagation @onclick="() => AddResident(owner)">
                                                            <i class="bi bi-person-plus"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-outline-info"
                                                            title="Asignar unidades"
                                                            @onclick:stopPropagation @onclick="() => GoToAssignUnits(owner)">
                                                        <i class="bi bi-diagram-3"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <!-- Detalle de subunidades -->
                                    @*foreach (var subunidad in Owners.Where(c => c.IdOwner == owner.IdOwner && c.Role == 1 && c.TypeUnit != 1))*@
                                    @foreach (var subunidad in owner.Units.Where(c => c.TypeUnit != 1))
                                    {
                                        <tr class="table-group-child">
                                            <td class="ps-5">
                                                <i class="bi bi-arrow-return-right me-1 text-muted"></i>
                                            </td>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-arrow-right-short me-2 text-muted"></i>
                                                <span class="text-muted">@subunidad.TypeUnit @subunidad.UnitNumber</span>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(subunidad.UnitNumber))
                                                {
                                                    <div class="text-muted small">
                                                        <i class="bi bi-person me-1"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                    <span class="badge @GetUnitTypeBadge(subunidad.TypeUnit)">
                                                        @ParameterService.GetChildParameterDescription(4, subunidad.TypeUnit)
                                                    </span>
                                            </td>
                                            <td align="center">@subunidad.UnitNumber</td>
                                        <td>@subunidad.Area.ToString("F2")<small class="text-muted"> m²</small></td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        title="Gestionar subunidad"
                                                        @onclick:stopPropagation @onclick="() => ManageSubUnit(subunidad)">
                                                    <i class="bi bi-gear"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                        <!-- Separador -->
                                        <tr>
                                            <td colspan="7" class="p-0">
                                                <div class="border-bottom" style="height: 1px; background-color: #f0f0f0;"></div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="bi bi-people text-muted display-4"></i>
                            </div>
                            <h5 class="text-muted mb-2">No hay propietarios registrados</h5>
                            <p class="text-muted mb-3">Para los filtros seleccionados</p>
                            @if (_canCreateOwner)
                            {
                                <button class="btn btn-primary" @onclick="ShowAddOwnerModal">
                                    <i class="bi bi-plus-circle me-2"></i>Agregar Primer Propietario
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- Paginación -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-transparent border-top py-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center">
                            <!-- Información de página -->
                            <div class="text-muted">
                                Página @currentPage de @totalPages •
                                @filteredGroupUnits.SelectMany(g => g.Owners).Select(o => o.IdOwner).Distinct().Count() propietarios encontrados
                            </div>

                            <!-- Controles de paginación -->
                            <nav aria-label="Paginación de propietarios">
                                <ul class="pagination pagination-sm mb-0">
                                    <!-- Primera página -->
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToFirstPage"
                                           title="Primera página">
                                            <i class="bi bi-chevron-double-left"></i>
                                        </a>
                                    </li>

                                    <!-- Página anterior -->
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToPreviousPage"
                                           title="Página anterior">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Páginas numeradas -->
                                    @foreach (var pageNum in GetPageNumbers())
                                    {
                                        if (pageNum == -1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                                <a class="page-link" @onclick="() => GoToPage(pageNum)">
                                                    @pageNum
                                                </a>
                                            </li>
                                        }
                                    }

                                    <!-- Página siguiente -->
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToNextPage"
                                           title="Página siguiente">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Última página -->
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="GoToLastPage"
                                           title="Última página">
                                            <i class="bi bi-chevron-double-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>

                            <!-- Salto a página -->
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Ir a:</span>
                                <input type="number" class="form-control form-control-sm"
                                       style="width: 70px;"
                                       min="1" max="@totalPages"
                                       @bind="jumpToPage"
                                       @bind:event="oninput" />
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="JumpToPage"
                                        disabled="@(jumpToPage < 1 || jumpToPage > totalPages)">
                                    Ir
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {

    [Inject] private IBuildingService BuildingService { get; set; } = default!;

    // Variables de paginación
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalRecords = 0;
    private int startRecord = 0;
    private int endRecord = 0;
    private int jumpToPage = 1;

    // Variables de filtro
    private int selectedUnitType = 0;
    private int selectedTower = 0;
    private string selectedStatus = "all";
    private string searchTerm = string.Empty;

    // Datos auxiliares
    private List<int> availableTowers = new() { 1, 2, 3, 4, 5, 6, 7, 8, 9 };

    // Propiedades calculadas -- GroupUnits (no filteredGroupUnits) porque estas
    // tarjetas resumen son sobre TODO el edificio, no sobre el resultado de los
    // filtros/búsqueda de la grilla (mismo criterio que totalUnits/averageArea, que
    // ya usaban GroupUnits sin filtrar).
    private int totalOwners => GroupUnits.SelectMany(g => g.Owners).Select(o => o.IdOwner).Distinct().Count();
    private int totalUnits => GroupUnits.Count();
    private int occupiedUnits => GroupUnits.Count(g => g.Owners.Any());
    // Grupos con al menos una cuota vencida (Debt > 0) que además tengan propietario
    // asignado -- se carga en LoadDataAsync, ver _gruposMorosos.
    private int delinquentOwners => GroupUnits.Count(g => g.Owners.Any() && _gruposMorosos.Contains(g.IdGroupUnit));
    private decimal averageArea => GroupUnits.Any() ? GroupUnits.Average(o => o.TotalArea) : 0;



    /*  === DECLARACION DE VARIABLES    === */
    private Models.OwnerUnit _OwnerUnit = new Models.OwnerUnit();
    private Models.Owner _Owner = new Models.Owner();
    private List<Models.RealEstateUnit> FreeUnits = new();

    //public async ValueTask DisposeAsync() => await ParameterService.context.DisposeAsync();

    /*  === Parametros de la Ventana Modal  === */
    private bool MostrarModal = false;
    private Models.OpenType OpenMode = 0;   //Crear
    private Modal modal = default!;

    // Cuando se abre el modal de propietario para agregar un residente adicional
    // a un grupo ya existente, aquí queda el grupo destino (null = alta de propietario normal).
    private Guid? _residentGroupId = null;

    private bool MostrarModalUnit = false;


    private List<Models.OwnerUnitView> OwnerUnits = new();
    private HashSet<Guid> _gruposMorosos = new();


    public class GroupUnit1
    {
        public Guid IdGroupUnit { get; set; }
        public string GroupNumber { get; set; } = null!;
        [Precision(18, 2)]
        public decimal TotalArea { get; set; }
        public decimal Area { get; set; }
        public List<RealEstateUnit> Units { get; set; } = new();
        public List<ApartmentOwner> Owners { get; set; } = new();
    }

    public class RealEstateUnit
    {
        public Guid IdUnit { get; set; }
        public string UnitNumber { get; set; } = string.Empty;
        [Precision(18, 2)]
        public decimal Area { get; set; }
        public int TypeUnit { get; set; }
        public int Number { get; set; }
        public bool IsAvailable { get; set; } = true;
        public Guid IdGroupUnit { get; set; }
        public Guid IdBuilding { get; set; }
    }

    public class ApartmentOwner
    {
        public Guid IdOwner { get; set; }
        public string IdentityDocument { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string FirstName { get; set; }= string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
        public Guid IdBuilding { get; set; }
        public Guid IdGroupUnit { get; set; }
        public int IdTypeIdNumber { get; set; }
        [NotMapped]
        public string FullName => FirstName + " " +LastName;
    }

    private List<GroupUnit1> GroupUnits = new();
    private List<RealEstateUnit> Units = new();
    private List<ApartmentOwner> Owners1 = new();
    private List<GroupUnit1> filteredGroupUnits = new();

    private List<GroupUnit1> currentPageData = new();
    private UserSession? currentUser = new();

    private bool _canCreateOwner;
    private bool _canEditOwner;
    private bool _canDeleteOwner;
    private bool _canAssignUnits;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null) return;

        _canCreateOwner = await PermissionService.HasPermissionAsync(currentUser, "create_owner");
        _canEditOwner = await PermissionService.HasPermissionAsync(currentUser, "edit_owner");
        _canDeleteOwner = await PermissionService.HasPermissionAsync(currentUser, "delete_owner");
        _canAssignUnits = await PermissionService.HasPermissionAsync(currentUser, "assign_units");

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (currentUser == null) return;

        List<OwnerUnitView> ownerUnits = await BuildingService.GetOwnersByBuildingAsync(currentUser.CurrentBuildingId);

        var pendientes = await InstallmentService.GetPendingInstallmentsAsync(currentUser.CurrentBuildingId);
        _gruposMorosos = pendientes.Where(i => i.Debt > 0).Select(i => i.IdGroupUnit).ToHashSet();

        await ParameterService.LoadParametersAsync(currentUser.CurrentBuildingId, true);

        // Se recarga desde cero para no duplicar los grupos ya cargados en una ejecución previa.
        GroupUnits = new();

        // Diccionarios para lookup eficiente
        var unitsByGroup = new Dictionary<Guid, List<RealEstateUnit>>();
        var ownersByGroup = new Dictionary<Guid, List<ApartmentOwner>>();

        // Procesar todo en una sola pasada
        foreach (var ownerUnit in ownerUnits)
        {
            var groupId = ownerUnit.IdGroupUnit;

            // Procesar GroupUnits (solo si TypeUnit == 1 y Role == 1)
            if (ownerUnit.TypeUnit == 1 && ownerUnit.Role == 1)
            {
                GroupUnits.Add(new GroupUnit1
                {
                    IdGroupUnit = groupId,
                    GroupNumber = ownerUnit.GroupNumber.ToString(),
                    Area = ownerUnit.Area,
                    TotalArea = ownerUnit.TotalArea
                });
            }

            // Procesar Units (solo si Role == 1)
            if (ownerUnit.Role == 1)
            {
                if (!unitsByGroup.ContainsKey(groupId))
                    unitsByGroup[groupId] = new List<RealEstateUnit>();

                unitsByGroup[groupId].Add(new RealEstateUnit
                {
                    IdUnit = ownerUnit.IdUnit,
                    UnitNumber = ownerUnit.UnitNumber.ToString(),
                    Area = ownerUnit.Area,
                    TypeUnit = ownerUnit.TypeUnit,
                    Number = ownerUnit.Number,
                    IsAvailable = ownerUnit.IsAvailable,
                    IdGroupUnit = groupId,
                    IdBuilding = ownerUnit.IdBuilding
                });
            }

            // Procesar Owners (solo si TypeUnit == 1)
            if (ownerUnit.TypeUnit == 1)
            {
                if (!ownersByGroup.ContainsKey(groupId))
                    ownersByGroup[groupId] = new List<ApartmentOwner>();

                ownersByGroup[groupId].Add(new ApartmentOwner
                {
                    IdOwner = ownerUnit.IdOwner,
                    IdentityDocument = ownerUnit.IdentityDocument,
                    Address = ownerUnit.Address,
                    PhoneNumber = ownerUnit.PhoneNumber,
                    FirstName = ownerUnit.FirstName,
                    LastName = ownerUnit.LastName,
                    Email = ownerUnit.Email,
                    IsActive = ownerUnit.IsActive,
                    IdBuilding = ownerUnit.IdBuilding,
                    IdGroupUnit = groupId,
                    IdTypeIdNumber = ownerUnit.IdTypeIdNumber
                });
            }
        }

        // Asignar Units y Owners a cada GroupUnit
        foreach (var groupUnit in GroupUnits)
        {
            if (unitsByGroup.TryGetValue(groupUnit.IdGroupUnit, out var units))
                groupUnit.Units = units;

            if (ownersByGroup.TryGetValue(groupUnit.IdGroupUnit, out var owners))
                groupUnit.Owners = owners;
        }

        FilterOwners();
    }

    private void FilterOwners()
    {
        if (string.IsNullOrEmpty(searchTerm))
        {
            // Sin búsqueda - filtro simple
            filteredGroupUnits = GroupUnits
                .Where(group => selectedUnitType == 0 ||
                       group.Units.Any(u => u.TypeUnit == selectedUnitType))
                .Select(group => new GroupUnit1
                {
                    IdGroupUnit = group.IdGroupUnit,
                    GroupNumber = group.GroupNumber,
                    Area = group.Area,
                    TotalArea = group.TotalArea,
                    Owners = FilterOwnersInGroup(group),
                    Units = FilterUnitsInGroup(group)
                })
                .Where(group => group.Owners.Any() && group.Units.Any())
                .ToList();
        }
        else
        {
            // Con búsqueda - lógica especial
            filteredGroupUnits = GroupUnits
                .Where(group => GroupMatchesSearch(group))
                .Select(group => new GroupUnit1
                {
                    IdGroupUnit = group.IdGroupUnit,
                    GroupNumber = group.GroupNumber,
                    Area = group.Area,
                    TotalArea = group.TotalArea,
                    Owners = FilterOwnersInGroup(group, includeAllIfUnitMatches: true),
                    Units = FilterUnitsInGroup(group)
                })
                .Where(group => group.Owners.Any() || group.Units.Any())
                .ToList();
        }

        UpdatePagination();
    }

    private bool GroupMatchesSearch(GroupUnit1 group)
    {
        // Filtro por tipo
        if (selectedUnitType != 0 &&
            !group.Units.Any(u => u.TypeUnit == selectedUnitType))
            return false;

        // Verificar si hay matches en el grupo
        bool hasOwnerMatch = group.Owners.Any(owner =>
            (selectedStatus == "all" ||
             (selectedStatus == "active" && owner.IsActive) ||
             (selectedStatus == "inactive" && !owner.IsActive)) &&
            (owner.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             owner.IdentityDocument.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

        bool hasUnitMatch = group.Units.Any(unit =>
            (selectedUnitType == 0 || unit.TypeUnit == selectedUnitType) &&
            unit.UnitNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        return hasOwnerMatch || hasUnitMatch;
    }

    private List<ApartmentOwner> FilterOwnersInGroup(GroupUnit1 group, bool includeAllIfUnitMatches = false)
    {
        var unitsInGroup = group.Units
            .Where(u => selectedUnitType == 0 || u.TypeUnit == selectedUnitType)
            .ToList();

        bool shouldIncludeAllOwners = includeAllIfUnitMatches &&
            unitsInGroup.Any(u => u.UnitNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        return group.Owners
            .Where(owner =>
            {
                // Filtro por estado
                if (selectedStatus != "all")
                {
                    bool isActive = owner.IsActive;
                    if ((selectedStatus == "active" && !isActive) ||
                        (selectedStatus == "inactive" && isActive))
                        return false;
                }

                // Si buscamos por unidad y hay match, incluir todos los owners
                if (shouldIncludeAllOwners)
                    return true;

                // Búsqueda normal
                if (string.IsNullOrEmpty(searchTerm))
                    return true;

                return owner.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                       owner.IdentityDocument.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            })
            .ToList();
    }

    private List<RealEstateUnit> FilterUnitsInGroup(GroupUnit1 group)
    {
        return group.Units
            .Where(unit =>
            {
                // Filtro por tipo
                if (selectedUnitType != 0 && unit.TypeUnit != selectedUnitType)
                    return false;

                // Filtro por búsqueda
                if (string.IsNullOrEmpty(searchTerm))
                    return true;

                return unit.UnitNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            })
            .ToList();
    }

    /*  SECCION PAGINACION   */

    private void UpdatePagination()
    {
        totalRecords = filteredGroupUnits.Count;
        totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

        // Ajustar página actual si es necesario
        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }
        else if (currentPage < 1 && totalPages > 0)
        {
            currentPage = 1;
        }

        // Calcular registros a mostrar
        startRecord = totalRecords > 0 ? ((currentPage - 1) * pageSize) + 1 : 0;
        endRecord = Math.Min(currentPage * pageSize, totalRecords);

        // Obtener datos de la página actual
        currentPageData = filteredGroupUnits
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

        // Actualizar jumpToPage
        jumpToPage = currentPage;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            UpdatePagination();
        }
    }

    private void GoToFirstPage() => GoToPage(1);
    private void GoToPreviousPage() => GoToPage(currentPage - 1);
    private void GoToNextPage() => GoToPage(currentPage + 1);
    private void GoToLastPage() => GoToPage(totalPages);
    private void JumpToPage() => GoToPage(jumpToPage);

    private void ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        UpdatePagination();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        int maxPagesToShow = 5;

        if (totalPages <= maxPagesToShow)
        {
            // Mostrar todas las páginas
            for (int i = 1; i <= totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Lógica para mostrar páginas con elipsis
            if (currentPage <= 3)
            {
                // Primeras páginas
                for (int i = 1; i <= 4; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
            else if (currentPage >= totalPages - 2)
            {
                // Últimas páginas
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = totalPages - 3; i <= totalPages; i++)
                {
                    pages.Add(i);
                }
            }
            else
            {
                // En medio
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = currentPage - 1; i <= currentPage + 1; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
        }

        return pages;
    }

