@page "/select-building"
@inject Services.AuthService AuthService
@inject Services.IPermissionService PermissionService
@inject NavigationManager Navigation
@inject ILogger<SelectBuilding> Logger
@rendermode InteractiveServer

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-building me-2"></i>
                        Seleccionar Edificio
                    </h4>
                </div>

                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p>Cargando tus edificios...</p>
                        </div>
                    }
                    else if (!approvedBuildings.Any() && !pendingBuildings.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-building-exclamation bi-3x text-muted mb-3"></i>
                            @if (_canCreateBuilding)
                            {
                                @* Administrador recién registrado desde /register-admin (u otro
                                   que todavía no creó ninguno): acá no tiene sentido ofrecerle
                                   "Solicitar acceso" (eso es para Residente uniéndose a un
                                   edificio ajeno, ver Docs/Design-SelfService-Registro-Piloto.md).
                                   Lo suyo es crear el propio. /buildings ya abre el modal de
                                   "Nuevo Edificio" solo cuando detecta que no tiene ninguno. *@
                                <p class="mb-3">Todavía no creaste ningún edificio</p>
                                <a href="/buildings" class="btn btn-primary">
                                    <i class="bi bi-plus me-2"></i>Crear mi primer edificio
                                </a>
                            }
                            else
                            {
                                <p class="mb-3">No tienes acceso a ningún edificio</p>
                                <a href="/building-request" class="btn btn-primary">
                                    <i class="bi bi-plus me-2"></i>Solicitar acceso
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        @if (approvedBuildings.Any())
                        {
                            <p class="text-muted mb-4">
                                Tienes acceso a múltiples edificios. Selecciona uno para continuar:
                            </p>

                            <div class="building-list mb-4">
                                @foreach (var building in approvedBuildings)
                                {
                                    <div class="building-item @( (selectedBuilding == building.Building!.IdBuilding && selectedRole == building.Role) ? "selected" : "")"
                                         @onclick="() => SelectBuilding1(building)">
                                        <div class="building-info">
                                            <div class="building-icon">
                                                <i class="bi bi-building"></i>
                                            </div>
                                            <div class="building-details">
                                                <h5 class="mb-1">@building.Building!.Name</h5>
                                                <span class="badge bg-@GetRoleBadgeColor(building.Role)">@building.Role</span>
                                                @if (building.Building.Location != null)
                                                {
                                                    <small class="text-muted d-block mt-1">
                                                        <i class="bi bi-geo-alt me-1"></i>@building.Building.Location
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                        <div class="building-check">
                                            @if (selectedBuilding == building.Building!.IdBuilding && selectedRole == building.Role)
                                            {
                                                <i class="bi bi-check-circle text-primary bi-lg"></i>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (pendingBuildings.Any())
                        {
                            <div class="pending-buildings mt-3">
                                <hr />
                                <h6 class="text-warning mb-3">
                                    <i class="bi bi-clock me-2"></i>
                                    Edificios pendientes de aprobación
                                </h6>

                                @foreach (var building in pendingBuildings)
                                {
                                    <div class="pending-item">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-building text-muted me-2"></i>
                                            <span>@building.Building!.Name</span>
                                        </div>
                                        <span class="badge bg-warning">Pendiente</span>
                                    </div>
                                }

                                <div class="alert alert-info mt-3 mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Los administradores revisarán tu solicitud de acceso.
                                </div>
                            </div>
                        }

                        <div class="mt-4">
                            <button class="btn btn-primary w-100"
                                    disabled="@(selectedBuilding == null)"
                                    @onclick="ConfirmSelectionAsync">
                                @if (isSelecting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Seleccionando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-right me-2"></i>
                                    <span>Continuar</span>
                                }
                            </button>
                        </div>

                        <div class="mt-3 text-center">
                            <a href="/building-request" class="text-decoration-none">
                                <i class="bi bi-plus me-1"></i>Solicitar acceso a otro edificio
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Models.UserBuilding> approvedBuildings = new();
    private List<Models.UserBuilding> pendingBuildings = new();
    private Guid? selectedBuilding;
    private string? selectedRole;
    private bool isLoading = true;
    private bool isSelecting = false;
    private bool _canCreateBuilding;
    private Models.UserSession? currentUser;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserDataAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null) return;

        _canCreateBuilding = await PermissionService.HasPermissionAsync(currentUser, "create_building");

        //await LoadUserDataAsync();
    }

    private async Task LoadUserDataAsync()
    {
        try
        {
            isLoading = true;

            if (currentUser == null)
            {
                Logger.LogWarning("Usuario no autenticado, redirigiendo a login");
                var returnUrl = Uri.EscapeDataString(Navigation.Uri);
                Navigation.NavigateTo($"/login?returnUrl={returnUrl}", true);
                return;
            }

            // Separar edificios aprobados y pendientes
            approvedBuildings = currentUser.Buildings?
                .Where(b => b.IsApproved && b.Building != null)
                .ToList() ?? new();

            pendingBuildings = currentUser.Buildings?
                .Where(b => !b.IsApproved && b.Building != null)
                .ToList() ?? new();

            // Si hay un edificio actual en la sesión, preseleccionarlo (con su rol —
            // sin esto, la fila nunca aparecía marcada como "selected" porque ese
            // estado exige que building Y role coincidan).
            if (currentUser.CurrentBuildingId != Guid.Empty)
            {
                var currentBuilding = approvedBuildings
                    .FirstOrDefault(b => b.Building!.IdBuilding == currentUser.CurrentBuildingId
                        && b.Role == currentUser.Role);

                if (currentBuilding != null)
                {
                    selectedBuilding = currentBuilding.Building!.IdBuilding;
                    selectedRole = currentBuilding.Role;
                }
            }

            // Si solo hay un edificio aprobado, seleccionarlo automáticamente
            if (approvedBuildings.Count == 1 && selectedBuilding == null)
            {
                selectedBuilding = approvedBuildings.First().Building!.IdBuilding;
                selectedRole = approvedBuildings.First().Role;
                await ConfirmSelectionAsync();
            }

            // Si sigue sin haber nada seleccionado, preseleccionar (sin confirmar) la
            // combinación edificio+rol que el usuario haya guardado como default en un
            // ingreso anterior — así sólo tiene que hacer un clic en "Continuar" en vez
            // de tener que reconocer de nuevo cuál era su elección habitual.
            if (selectedBuilding == null)
            {
                var preferredBuildingId = await AuthService.GetDefaultBuildingAsync();
                var preferredRole = await AuthService.GetDefaultRoleAsync();

                if (preferredBuildingId.HasValue)
                {
                    var preferred = approvedBuildings.FirstOrDefault(b =>
                        b.Building!.IdBuilding == preferredBuildingId.Value &&
                        (preferredRole == null || b.Role == preferredRole));

                    if (preferred != null)
                    {
                        selectedBuilding = preferred.Building!.IdBuilding;
                        selectedRole = preferred.Role;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando datos de edificios");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SelectBuilding1(Models.UserBuilding building)
    {
        selectedBuilding = building.Building!.IdBuilding;
        selectedRole = building.Role;
        //StateHasChanged();
    }

    private async Task ConfirmSelectionAsync()
    {
        if (!selectedBuilding.HasValue || isSelecting) return;

        try
        {
            isSelecting = true;
            StateHasChanged();

            Logger.LogInformation($"Seleccionando edificio: {selectedBuilding.Value} y Rol {selectedRole}");

            // Establecer el edificio actual
            await AuthService.SetCurrentBuilding(selectedBuilding.Value, selectedRole!);

            // Recordar la elección. Si el edificio no tiene otros roles aprobados,
            // TryApplyDefaultBuildingAsync la aplicará sola la próxima vez; si sí los
            // tiene, esta pantalla se va a seguir mostrando, pero con esta combinación
            // ya preseleccionada (ver el bloque de preselección en LoadUserDataAsync).
            await AuthService.SetDefaultBuildingAsync(selectedBuilding.Value);
            await AuthService.SetDefaultRoleAsync(selectedRole!);

            // Pequeña pausa para dar feedback visual
            await Task.Delay(300);

            // Redirigir al dashboard (sin forceLoad — ver nota en Login.razor/HandleLogin
            // sobre por qué un forceLoad aquí rompe la autenticación tras el fix del bug
            // de sesión compartida).
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error seleccionando edificio");

            // Mostrar error al usuario (podrías agregar una variable de error)
            isSelecting = false;
            StateHasChanged();
        }
    }

    private string GetRoleBadgeColor(string role)
    {
        return role?.ToLower() switch
        {
            "admin" or "administrador" => "danger",
            "owner" or "propietario" => "warning",
            "tenant" or "inquilino" => "info",
            "security" or "seguridad" => "secondary",
            "maintenance" or "mantenimiento" => "primary",
            _ => "secondary"
        };
    }
}