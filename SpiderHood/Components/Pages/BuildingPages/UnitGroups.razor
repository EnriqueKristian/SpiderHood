@page "/UnitGroups"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Metadata
@using SpiderHood.Data
@using SpiderHood.Models
@using SpiderHood.Services
@inject NavigationManager Navigation // Inyecta el servicio de navegación
@inject ParameterService ParameterService
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime
@inject Services.AuthService AuthService
@inject IPermissionService PermissionService
@inject IInstallmentService InstallmentService

<PageTitle>Unidades Inmobiliarias</PageTitle>

<div class="container-fluid px-4 py-3">
    <!-- Header principal -->
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Unidades Inmobiliarias</h1>
                <p class="text-muted mb-0">Administra y gestiona todas las unidades del edificio</p>
            </div>
        </div>

        <div class="page-header-actions">
            @if (_canCreateUnit)
            {
                <button class="btn btn-primary d-flex align-items-center"
                        @onclick="() => AbrirModal(new Models.RealEstateUnit(), 0, Models.OpenType.Create)">
                    <i class="bi bi-plus-circle me-2"></i>Nueva Unidad
                </button>
            }
            <button class="btn btn-outline-secondary d-flex align-items-center">
                <i class="bi bi-download me-2"></i>Exportar
            </button>
        </div>
    </div>

    <!-- Card principal -->
    <div class="card shadow-sm border-0">
        <!-- Header de la card -->
        <div class="card-header bg-transparent border-bottom py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-0">
                        <i class="bi bi-grid-3x3-gap me-2"></i>Generador de Unidades
                    </h5>
                </div>
                <div class="d-flex gap-2">
                    <!-- Filtros -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item @(_selectedTypeFilter == 0 ? "active" : "")" @onclick="() => SetTypeFilter(0)"><i class="bi bi-check-circle me-2"></i>Todas las unidades</button></li>
                            <li><button type="button" class="dropdown-item @(_selectedTypeFilter == 1 ? "active" : "")" @onclick="() => SetTypeFilter(1)"><i class="bi bi-building me-2"></i>Departamentos</button></li>
                            <li><button type="button" class="dropdown-item @(_selectedTypeFilter == 4 ? "active" : "")" @onclick="() => SetTypeFilter(4)"><i class="bi bi-shop me-2"></i>Oficinas</button></li>
                            <li><button type="button" class="dropdown-item @(_selectedTypeFilter == 2 ? "active" : "")" @onclick="() => SetTypeFilter(2)"><i class="bi bi-car-front me-2"></i>Estacionamientos</button></li>
                            <li><button type="button" class="dropdown-item @(_selectedTypeFilter == 3 ? "active" : "")" @onclick="() => SetTypeFilter(3)"><i class="bi bi-box-seam me-2"></i>Depósitos</button></li>
                        </ul>
                    </div>

                    <!-- Buscador -->
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" placeholder="Buscar unidad o propietario..." />
                    </div>

                    <!-- Selector de página -->
                    <div class="d-flex align-items-center">
                        <label class="me-2 text-muted">Mostrar:</label>
                        <select class="form-select form-select-sm" style="width: auto;"
                                @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                            <!option value="10" selected="@(_unitPageSize == 10)">10</!option>
                            <!option value="25" selected="@(_unitPageSize == 25)">25</!option>
                            <!option value="50" selected="@(_unitPageSize == 50)">50</!option>
                            <!option value="100" selected="@(_unitPageSize == 100)">100</!option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cuerpo de la card -->
        <div class="card-body p-0">
            <!-- Tabla de unidades -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-nowrap">
                                <span class="text-dark d-flex align-items-center"
                                      style="cursor:pointer" @onclick="() => SortBy(UnitSortColumn.Tipo)">
                                    Tipo
                                    <i class="bi @SortIconClass(UnitSortColumn.Tipo) ms-1 text-muted"></i>
                                </span>
                            </th>
                            <th class="text-nowrap">
                                <span class="text-dark d-flex align-items-center"
                                      style="cursor:pointer" @onclick="() => SortBy(UnitSortColumn.UnitNumber)">
                                    N° Unidad
                                    <i class="bi @SortIconClass(UnitSortColumn.UnitNumber) ms-1 text-muted"></i>
                                </span>
                            </th>
                            <th class="text-nowrap">Ubicación</th>
                            <th class="text-nowrap">
                                <span class="text-dark d-flex align-items-center"
                                      style="cursor:pointer" @onclick="() => SortBy(UnitSortColumn.Area)">
                                    Área (m²)
                                    <i class="bi @SortIconClass(UnitSortColumn.Area) ms-1 text-muted"></i>
                                </span>
                            </th>
                            <th class="text-nowrap">Propietario/Inquilino</th>
                            <th class="text-nowrap">Estado</th>
                            <th class="text-nowrap text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unidad in PagedUnits)
                        {
                            <tr class="border-bottom">
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <span class="badge @GetTypeBadgeClass(unidad.TypeUnit) me-2">
                                            @ParameterService.GetChildParameterDescription(4, @unidad.TypeUnit)
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold">@unidad.UnitNumber</span>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(unidad.LocationCode) && string.IsNullOrWhiteSpace(unidad.Tower) && unidad.Floor == null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            @(string.Join(" · ", new[] { unidad.LocationCode, unidad.Tower, unidad.Floor.HasValue ? $"Piso {unidad.Floor}" : null }.Where(s => !string.IsNullOrWhiteSpace(s))))
                                        </small>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="me-2">@unidad.Area.ToString("F2")</span>
                                        <small class="text-muted">m²</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-light rounded-circle d-flex align-items-center justify-content-center me-2">
                                            <i class="bi bi-person text-muted"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium">@unidad.Names</div>
                                            <small class="text-muted">Propietario</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(unidad)">
                                        <i class="bi @GetStatusIcon(unidad) me-1"></i>
                                        @GetStatusText(unidad)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-primary"
                                                title="Ver detalles" @onclick="() => ViewDetails(unidad)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        @if (_canEditUnit)
                                        {
                                            <button type="button" class="btn btn-outline-secondary"
                                                    title="Editar" @onclick="() => EditUnit(unidad)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-success"
                                                title="Finanzas" @onclick="() => ViewFinances(unidad)">
                                            <i class="bi bi-cash-coin"></i>
                                        </button>
                                        @if (_canDeleteUnit)
                                        {
                                            <button type="button" class="btn btn-outline-danger"
                                                    title="Eliminar" @onclick="() => DeleteUnit(unidad)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sin resultados -->
            @if (units.Any() && !FilteredUnits.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-funnel text-muted display-4"></i>
                    </div>
                    <h5 class="text-muted mb-2">Ninguna unidad coincide con el filtro</h5>
                    <p class="text-muted mb-3">Probá con otro tipo de unidad</p>
                    <button class="btn btn-outline-secondary" @onclick="() => SetTypeFilter(0)">
                        <i class="bi bi-x-circle me-2"></i>Quitar filtro
                    </button>
                </div>
            }
            else if (!units.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-building text-muted display-4"></i>
                    </div>
                    <h5 class="text-muted mb-2">No hay unidades registradas</h5>
                    <p class="text-muted mb-3">Comienza agregando tu primera unidad inmobiliaria</p>
                    @if (_canCreateUnit)
                    {
                        <button class="btn btn-primary"
                                @onclick="() => AbrirModal(new Models.RealEstateUnit(), 0, Models.OpenType.Create)">
                            <i class="bi bi-plus-circle me-2"></i>Agregar Primera Unidad
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Footer de la card -->
        <div class="card-footer bg-transparent border-top py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Mostrando <strong>@PagedUnits.Count()</strong> de <strong>@FilteredUnits.Count</strong> unidades
                </div>

                <!-- Paginación -->
                @if (TotalUnitPages > 1)
                {
                    <nav aria-label="Paginación de unidades">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_unitPage == 1 ? "disabled" : "")">
                                <a class="page-link" style="cursor:pointer" @onclick="() => GoToUnitPage(_unitPage - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= TotalUnitPages; p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == _unitPage ? "active" : "")">
                                    <a class="page-link" style="cursor:pointer" @onclick="() => GoToUnitPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(_unitPage == TotalUnitPages ? "disabled" : "")">
                                <a class="page-link" style="cursor:pointer" @onclick="() => GoToUnitPage(_unitPage + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>

    <!-- Grupo de Unidades -->
    <div class="row mt-4">
        <!-- Resumen -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-diagram-3 me-2"></i>Grupo de Unidades
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Estadísticas -->
                        <div class="col-md-3">
                            <div class="stat-card text-center py-4">
                                <div class="icon-badge mx-auto mb-2">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="stat-value">@units.Count()</div>
                                <div class="stat-label">Total Unidades</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card text-center py-4">
                                <div class="icon-badge icon-badge-success mx-auto mb-2">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                <div class="stat-value">@units.Count(u => u.TypeUnit == 1)</div>
                                <div class="stat-label">Departamentos</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card text-center py-4">
                                <div class="icon-badge icon-badge-info mx-auto mb-2">
                                    <i class="bi bi-people"></i>
                                </div>
                                <div class="stat-value">@units.Where(u => !string.IsNullOrWhiteSpace(u.Names)).Select(u => u.Names).Distinct().Count()</div>
                                <div class="stat-label">Propietarios</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card text-center py-4">
                                <div class="icon-badge icon-badge-warning mx-auto mb-2">
                                    <i class="bi bi-calculator"></i>
                                </div>
                                <div class="stat-value">@units.Sum(u => u.Area).ToString("F1")</div>
                                <div class="stat-label">Área Total (m²)</div>
                            </div>
                        </div>

                        <!-- Gráfico de distribución -->
                        <div class="col-12 mt-2">
                            <div class="card border-0">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-3 text-muted">Distribución por Tipo</h6>
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            @if (units.Any())
                                            {
                                                <div class="progress" style="height: 25px;">
                                                    @if (UnitCountDepartamentos > 0)
                                                    {
                                                        <div class="progress-bar bg-primary" style="width: @(PctDepartamentos)%">
                                                            Departamentos (@(PctDepartamentos.ToString("0.#"))%)
                                                        </div>
                                                    }
                                                    @if (UnitCountOficinas > 0)
                                                    {
                                                        <div class="progress-bar bg-success" style="width: @(PctOficinas)%">
                                                            Oficinas (@(PctOficinas.ToString("0.#"))%)
                                                        </div>
                                                    }
                                                    @if (UnitCountEstacionamientos > 0)
                                                    {
                                                        <div class="progress-bar bg-info" style="width: @(PctEstacionamientos)%">
                                                            Estacionamientos (@(PctEstacionamientos.ToString("0.#"))%)
                                                        </div>
                                                    }
                                                    @if (UnitCountDepositos > 0)
                                                    {
                                                        <div class="progress-bar bg-warning" style="width: @(PctDepositos)%">
                                                            Depósitos (@(PctDepositos.ToString("0.#"))%)
                                                        </div>
                                                    }
                                                    @if (UnitCountOtros > 0)
                                                    {
                                                        <div class="progress-bar bg-secondary" style="width: @(PctOtros)%">
                                                            Otros (@(PctOtros.ToString("0.#"))%)
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="progress" style="height: 25px;">
                                                    <div class="progress-bar bg-secondary" style="width: 100%">Sin unidades</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones rápidas -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>Acciones Rápidas
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-file-earmark-plus  me-2"></i>
                                <div class="text-start">
                                    <div class="fw-medium">Generar Reporte</div>
                                    <small class="text-muted">Reporte mensual de unidades</small>
                                </div>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </button>

                        <button class="btn btn-outline-success d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-cash-stack  me-2"></i>
                                <div class="text-start">
                                    <div class="fw-medium">Cobrar Mantenimiento</div>
                                    <small class="text-muted">Generar recibos mensuales</small>
                                </div>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </button>

                        <button class="btn btn-outline-info d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-envelope  me-2"></i>
                                <div class="text-start">
                                    <div class="fw-medium">Notificar Propietarios</div>
                                    <small class="text-muted">Enviar comunicado general</small>
                                </div>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </button>

                        <button class="btn btn-outline-warning d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-check  me-2"></i>
                                <div class="text-start">
                                    <div class="fw-medium">Programar Reunión</div>
                                    <small class="text-muted">Convocar asamblea</small>
                                </div>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    // Paginación de la grilla de unidades -- todo en memoria, ya que `units` se carga
    // completo desde BuildingService.GetUnitsByBuildingAsync en InicializarPagina.
    private int _unitPageSize = 10;
    private int _unitPage = 1;
    private int TotalUnitPages => FilteredUnits.Count == 0 ? 1 : (int)Math.Ceiling(FilteredUnits.Count / (double)_unitPageSize);
    private IEnumerable<Models.RealEstateUnit> PagedUnits => SortedUnits.Skip((_unitPage - 1) * _unitPageSize).Take(_unitPageSize);

    private void GoToUnitPage(int page)
    {
        if (page < 1 || page > TotalUnitPages) return;
        _unitPage = page;
    }

    private void ChangePageSize(int newSize)
    {
        _unitPageSize = newSize;
        _unitPage = 1;
    }

    // Filtro por tipo de unidad -- el dropdown "Filtrar" antes eran <a href="#">
    // sin ningún @onclick: no filtraban nada y, al ser <a>, el clic lo interceptaba
    // la navegación mejorada de Blazor y mandaba al dashboard (mismo problema que
    // tenían los encabezados ordenables). 0 = todas las unidades.
    private int _selectedTypeFilter = 0;
    private List<Models.RealEstateUnit> FilteredUnits =>
        units.Where(u => _selectedTypeFilter == 0 || u.TypeUnit == _selectedTypeFilter).ToList();

    private void SetTypeFilter(int type)
    {
        _selectedTypeFilter = type;
        _unitPage = 1;
    }

    // Orden de la grilla de unidades -- los encabezados con flechita (Tipo, N°
    // Unidad, Área) antes no tenían ningún @onclick, así que la flechita no hacía
    // nada. Orden en memoria sobre FilteredUnits, igual que la paginación de arriba.
    private enum UnitSortColumn { None, Tipo, UnitNumber, Area }
    private UnitSortColumn _unitSortColumn = UnitSortColumn.None;
    private bool _unitSortAscending = true;

    private IEnumerable<Models.RealEstateUnit> SortedUnits => _unitSortColumn switch
    {
        UnitSortColumn.Tipo => _unitSortAscending ? FilteredUnits.OrderBy(u => u.TypeUnit) : FilteredUnits.OrderByDescending(u => u.TypeUnit),
        UnitSortColumn.UnitNumber => _unitSortAscending ? FilteredUnits.OrderBy(u => u.UnitNumber) : FilteredUnits.OrderByDescending(u => u.UnitNumber),
        UnitSortColumn.Area => _unitSortAscending ? FilteredUnits.OrderBy(u => u.Area) : FilteredUnits.OrderByDescending(u => u.Area),
        _ => FilteredUnits
    };

    private void SortBy(UnitSortColumn column)
    {
        if (_unitSortColumn == column)
        {
            _unitSortAscending = !_unitSortAscending;
        }
        else
        {
            _unitSortColumn = column;
            _unitSortAscending = true;
        }
        _unitPage = 1;
    }

    private string SortIconClass(UnitSortColumn column)
    {
        if (_unitSortColumn != column) return "bi-arrow-down-up";
        return _unitSortAscending ? "bi-sort-up" : "bi-sort-down";
    }

    // Métodos para clases CSS
    private string GetTypeBadgeClass(int type)
    {
        return type switch
        {
            1 => "bg-primary",
            4 => "bg-success",
            2 => "bg-info",
            3 => "bg-warning",
            _ => "bg-secondary"
        };
    }

    // "Estado" de la unidad: Ocupada cuando está asignada a un grupo de
    // propietario (IdGroupOwner viene del JOIN en GetUnitsByBuildingAsync, ver
    // AssignUnits.razor que usa el mismo criterio para "unidad libre"), Disponible
    // en caso contrario. Antes esta columna mostraba unidad.Names (el nombre del
    // propietario) en vez de un estado real.
    private bool IsUnitOccupied(Models.RealEstateUnit unidad) => unidad.IdGroupOwner != Guid.Empty;

    private string GetStatusBadgeClass(Models.RealEstateUnit unidad) =>
        IsUnitOccupied(unidad) ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary";

    private string GetStatusIcon(Models.RealEstateUnit unidad) =>
        IsUnitOccupied(unidad) ? "bi-house-check" : "bi-house";

    private string GetStatusText(Models.RealEstateUnit unidad) =>
        IsUnitOccupied(unidad) ? "Ocupada" : "Disponible";

    // Métodos de acciones
    private void ViewDetails(Models.RealEstateUnit unidad)
    {
        AbrirModal(unidad, unidad.TypeUnit, Models.OpenType.ReadOnly);
    }

    private void EditUnit(Models.RealEstateUnit unidad)
    {
        AbrirModal(unidad, unidad.TypeUnit, Models.OpenType.Update);
    }

    private Models.RealEstateUnit? _financesUnit;
    private List<Models.Installment> _financesDebts = new();
    private bool _loadingFinances;
    private Modal modalFinanzas = default!;

    private async Task ViewFinances(Models.RealEstateUnit unidad)
    {
        _financesUnit = unidad;
        _loadingFinances = true;
        _financesDebts = new();
        await modalFinanzas.ShowAsync();
        StateHasChanged();

        // IdGroupOwner en RealEstateUnit es el mismo grupo que Installment.IdGroupUnit
        // (el "grupo de unidades bajo un propietario" que genera y paga cuotas) --
        // distinto nombre, mismo valor, ver Classes/Budget/Installment.cs.
        var pendientes = await InstallmentService.GetPendingInstallmentsAsync(currentUser.CurrentBuildingId);
        _financesDebts = pendientes.Where(i => i.IdGroupUnit == unidad.IdGroupOwner && i.Debt > 0)
            .OrderBy(i => i.DueDate)
            .ToList();

        _loadingFinances = false;
        StateHasChanged();
    }

    private async Task CloseFinanzas()
    {
        await modalFinanzas.HideAsync();
    }

    private async Task DeleteUnit(Models.RealEstateUnit unidad)
    {
        if (!_canDeleteUnit) return;
        _Unit = unidad;
        await modal.ShowAsync();
    }
}

<!--    MODAL PARA CREAR / MODIFICAR UNIDADES -->
<ModalUnit ShowModal="@MostrarModal" ShowModalChanged="@((valor) => MostrarModal = valor)"
           OpenMode="@OpenMode"
           ListParameters="@ParameterService.ListParameters"
           View_Unit="@_Unit"
           OnSaveItem="@((item) => SaveItem(item))" />

<!--    MODAL PARA GENERAR UNIDADES -->
<Modal @ref="modalAll" Title="Generara Bloque de Unidades" UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true" IsScrollable="true">
    <BodyTemplate>
        <div class="modal-body">
            <EditForm Id="create" Model="_formCreateUnit" OnValidSubmit="@GenerateBlockUnits" method="post" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="NroUnidades" class="form-label">Nro. a Generar</label>
                    <InputNumber id="NroUnidades" class="form-control" @bind-Value="_formCreateUnit.NroUnits" />
                    <ValidationMessage For="() => _formCreateUnit.NroUnits" class="text-danger" />
                    <label for="NroUnidades" class="form-label">Nro. Pisos</label>
                    <InputNumber id="NroUnidades" class="form-control" @bind-Value="_formCreateUnit.NroPisos" />
                    <ValidationMessage For="() => _formCreateUnit.NroPisos" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="unittype_id" class="form-label">Tipo de Unidad</label>
                    <InputSelect id="unittype_id" @bind-Value="_formCreateUnit.IdUnitType" class="form-select">
                        @foreach (var x in ParameterService.ListParameters.Where(c => c.IdParent == 4))
                        {
                            <option value="@Convert.ToInt32(x.Value)">@x.Description</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="floorformat" class="form-label">Piso Inicio:</label>
                    <InputNumber id="floorformat" @bind-Value="_formCreateUnit.StarFloor" class="form-control" aria-required="true" placeHolder="1" />
                    <ValidationMessage For="() => _formCreateUnit.StarFloor" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="floorformat" class="form-label">Unidad Inicio:</label>
                    <InputNumber id="floorformat" @bind-Value="_formCreateUnit.StarUnit" class="form-control" aria-required="true" placeHolder="1" />
                    <ValidationMessage For="() => _formCreateUnit.StarUnit" class="text-danger" />

                    <label for="floorformat" class="form-label">Formato Unidad:</label>
                    <InputSelect id="unittype_id" @bind-Value="_formCreateUnit.formatUnit" class="form-select">
                        <option value="0x" selected>0x</option>
                        <option value="00x">0xx</option>
                    </InputSelect>
                    <ValidationMessage For="() => _formCreateUnit.formatUnit" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="shortdescription" class="form-label">Area:</label>
                    <InputNumber id="area" @bind-Value="_formCreateUnit.Area" class="form-control" />
                    <ValidationMessage For="() => _formCreateUnit.Area" class="text-danger" />
                </div>
            </EditForm>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" form="create" Type="ButtonType.Submit">Aceptar</Button>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalAllClick">Cancelar</Button>
    </FooterTemplate>
</Modal>

<!--    MODAL PARA ELIMINAR UNIDADES -->
<Modal @ref="modal" Title="Eliminar Unidad" UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true">
    <BodyTemplate>
        ¿Esta seguro que desea eliminar la Unidad @(_Unit.UnitNumber)?.
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="DeleteItem">Aceptar</Button>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cancelar</Button>
    </FooterTemplate>
</Modal>

<!--    MODAL DE FINANZAS -- CUOTAS PENDIENTES DE LA UNIDAD -->
<Modal @ref="modalFinanzas" Title="@($"Deudas pendientes - {_financesUnit?.UnitNumber}")" UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true">
    <BodyTemplate>
        @if (_loadingFinances)
        {
            <p class="text-muted mb-0">Cargando...</p>
        }
        else if (_financesDebts.Count == 0)
        {
            <p class="text-muted mb-0">Esta unidad no tiene cuotas pendientes.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Vencimiento</th><th>Concepto</th><th class="text-end">Deuda</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cuota in _financesDebts)
                        {
                            <tr>
                                <td>@cuota.DueDate.ToString("dd/MM/yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(cuota.Concept) ? cuota.Type.ToString() : cuota.Concept)</td>
                                <td class="text-end">@cuota.Debt.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="2">Total</td>
                            <td class="text-end">@_financesDebts.Sum(c => c.Debt).ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CloseFinanzas">Cerrar</Button>
    </FooterTemplate>
</Modal>

@code {

    [Inject]
    private IBuildingService BuildingService { get; set; } = default!;

    private Modal modal = default!;
    private Modal modalAll = default!;

    private async Task OnShowCreateGroupUnit()
    {
        //_Unit.IdUnit = IdUnit;
        await modalAll.ShowAsync();
    }

    private async Task OnShowModalDelete(Guid IdCategory)
    {
        //Usuarios.Add(nuevo);
        _Unit = new Models.RealEstateUnit();
        //_Unit.IdUnit = IdUnit;
        await modalAll.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

    private async Task OnHideModalAllClick()
    {
        await modalAll.HideAsync();
    }

    private async Task GenerateBlockUnits()
    {
        if (!_canCreateUnit) return;
        // Lógica adicional después de cerrar el modal, si es necesario

        if (_formCreateUnit is not null)
        {
            for (int i = 1; i <= _formCreateUnit.NroPisos; i++)
            {
                int StarUnitLocal = _formCreateUnit.StarUnit;

                for (int j = 1; j <= _formCreateUnit.NroUnits; j++)
                {
                    Models.RealEstateUnit _blockunit = new Models.RealEstateUnit();

                    _blockunit.IdBuilding = currentUser.CurrentBuildingId;
                    //_blockunit.IdGroupOwner = IdOwner;
                    _blockunit.TypeUnit = _formCreateUnit.IdUnitType;
                    _blockunit.Area = _formCreateUnit.Area;
                    string cad1 = _formCreateUnit.formatUnit.Substring(0, _formCreateUnit.formatUnit.Length - 1);
                    _blockunit.UnitNumber = _formCreateUnit.StarFloor.ToString() + cad1 + StarUnitLocal.ToString();

                    await BuildingService.AddUnitAsync(_blockunit);

                    StarUnitLocal += 1;
                }
                _formCreateUnit.StarFloor += 1;
                //_formCreateUnit.StarUnit = 1;
            }
        }

        _formCreateUnit = new UnidadModel();

        await modalAll.HideAsync();
        await InicializarPagina();
        return;
    }

    private async Task DeleteItem()
    {
        var result = await BuildingService.DeleteUnitAsync(_Unit);
        await modal.HideAsync();

        if (!result.IsSuccess)
        {
            await ShowToast("Error", result.ErrorMessage ?? "No se pudo eliminar la unidad", "danger");
            return;
        }

        await InicializarPagina();
    }

    // Mismo patrón que BuildingSelection.razor/PeriodForm.razor/etc. -- showToast
    // (wwwroot/js/utilidades.js) es la "ventana de mensajes" del sistema, en vez
    // de un alert() nativo del navegador.
    private async Task ShowToast(string title, string message, string type)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showToast", title, message, type);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando toast: {ex.Message}");
            Console.WriteLine($"{type.ToUpper()}: {title} - {message}");
        }
    }

    private List<Models.RealEstateUnit> units = new();
    private List<Models.RealEstateUnit> list_units = new();

    // Distribución por tipo (tarjeta "Grupo de Unidades") -- antes era una barra
    // fija en 70/20/10 sin relación con los datos reales. Departamentos (1),
    // Estacionamientos (2) y Depósitos (3) van cada uno por separado -- son los
    // tres tipos que va a tener la mayoría de edificios -- y Oficinas (4) aparte
    // ya que no todos los edificios los tienen. "Otros" es un colchón para
    // cualquier TypeUnit fuera de esos cuatro, para que la barra siempre sume 100%.
    private int UnitCountDepartamentos => units.Count(u => u.TypeUnit == 1);
    private int UnitCountEstacionamientos => units.Count(u => u.TypeUnit == 2);
    private int UnitCountDepositos => units.Count(u => u.TypeUnit == 3);
    private int UnitCountOficinas => units.Count(u => u.TypeUnit == 4);
    private int UnitCountOtros => units.Count - UnitCountDepartamentos - UnitCountEstacionamientos - UnitCountDepositos - UnitCountOficinas;
    private double PctDepartamentos => units.Count == 0 ? 0 : Math.Round(UnitCountDepartamentos * 100.0 / units.Count, 1);
    private double PctEstacionamientos => units.Count == 0 ? 0 : Math.Round(UnitCountEstacionamientos * 100.0 / units.Count, 1);
    private double PctDepositos => units.Count == 0 ? 0 : Math.Round(UnitCountDepositos * 100.0 / units.Count, 1);
    private double PctOficinas => units.Count == 0 ? 0 : Math.Round(UnitCountOficinas * 100.0 / units.Count, 1);
    private double PctOtros => units.Count == 0 ? 0 : Math.Round(UnitCountOtros * 100.0 / units.Count, 1);

    /*  === Parametros de la Ventana Modal  === */
    private bool MostrarModal = false;
    private Models.OpenType OpenMode;

    private Models.RealEstateUnit _Unit = new Models.RealEstateUnit();
    private UnidadModel _formCreateUnit = new UnidadModel();
    private UserSession currentUser = new();

    private bool _canCreateUnit;
    private bool _canEditUnit;
    private bool _canDeleteUnit;

    //  CLASE PARA GENERAR UNIDADES EN BLOQUE
    public class UnidadModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "El número de unidades debe ser mayor a 0")]
        public int NroUnits { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "El número de Pisos debe ser mayor a 0")]
        public int NroPisos { get; set; }


        public int IdUnitType { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "El Piso de inicio debe ser mayor a 0")]
        public int StarFloor { get; set; }


        [Range(1, int.MaxValue, ErrorMessage = "El número de unidades debe ser mayor a 0")]
        public int StarUnit { get; set; }

        [RegularExpression(@"^0+[0-9A-Za-z]$", ErrorMessage = "Formato inválido. Ejemplos válidos: 0x, 00x")]
        public string formatUnit { get; set; } = string.Empty;

        [Range(1, double.MaxValue, ErrorMessage = "El número de unidades debe ser mayor a 1")]
        public decimal Area { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // currentUser puede seguir null aquí: la sesión se restaura de forma asíncrona
            // (localStorage vía CustomAuthenticationStateProvider) y ese proceso no tiene
            // garantía de haber terminado antes de este primer OnAfterRenderAsync. Sin este
            // reintento, InicializarPagina() dereferenciaba currentUser.CurrentBuildingId
            // con currentUser en null y tiraba NullReferenceException, tumbando el circuito
            // (mismo patrón ya solucionado en Index.razor/BudgetGenerator.razor).
            var attempts = 0;
            while (currentUser == null && attempts < 20)
            {
                await Task.Delay(150);
                currentUser = await AuthService.GetCurrentUserAsync();
                attempts++;
            }

            if (currentUser == null)
            {
                return;
            }

            _canCreateUnit = await PermissionService.HasPermissionAsync(currentUser, "create_unit");
            _canEditUnit = await PermissionService.HasPermissionAsync(currentUser, "edit_unit");
            _canDeleteUnit = await PermissionService.HasPermissionAsync(currentUser, "delete_unit");
            StateHasChanged();
            await InicializarPagina();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
    }

    private async Task InicializarPagina()
    {
        // ParameterService.ListParameters (de donde sale la descripción del tipo de unidad,
        // vía GetChildParameterDescription) solo se carga hoy desde Home.razor, Owners.razor
        // o ParameterPage.razor — ninguna corre necesariamente antes que esta página. Si el
        // usuario llega aquí sin haber pasado antes por esas páginas en este mismo circuito,
        // ListParameters queda vacío y CADA fila muestra "No se encontro coincidencia", sin
        // importar el tipo real (mismo patrón ya solucionado en BudgetPages/Index.razor).
        await ParameterService.LoadParametersAsync(currentUser.CurrentBuildingId);

        units = await BuildingService.GetUnitsByBuildingAsync(currentUser.CurrentBuildingId);
        list_units = units.Where(c => c.TypeUnit == 1).ToList();
        if (_unitPage > TotalUnitPages) _unitPage = 1;
        //_loaded = true;
        StateHasChanged();
    }

    private void AbrirModal(Models.RealEstateUnit _cat, int type, Models.OpenType mode)
    {
        if (mode == Models.OpenType.Create && !_canCreateUnit) return;
        if (mode == Models.OpenType.Update && !_canEditUnit) return;

        MostrarModal = true;
        OpenMode = mode;

        _Unit = mode switch
        {
            OpenType.Create => new Models.RealEstateUnit { IdBuilding = currentUser.CurrentBuildingId },
            OpenType.Update or OpenType.ReadOnly => _cat,
            _ => throw new ArgumentOutOfRangeException(nameof(mode), $"Valor inesperado: {mode}")
        };
    }

    private async Task SaveItem(SpiderHood.Models.RealEstateUnit item)
    {
        if (OpenMode == Models.OpenType.Create && !_canCreateUnit) return;
        if (OpenMode == Models.OpenType.Update && !_canEditUnit) return;

        switch (OpenMode)
        {
            case Models.OpenType.Create:
                await AddItem(item);
                break;

            case Models.OpenType.Update:
                await UpdateItem(item);
                break;

            default:
                throw new ArgumentOutOfRangeException(nameof(OpenMode), $"Valor inesperado: {OpenMode}");
        }

        await InicializarPagina();
        return;

    }

    private async Task AddItem(SpiderHood.Models.RealEstateUnit item)
    {
        //Usuarios.Add(nuevo);
        item.IdBuilding = currentUser.CurrentBuildingId;
        await BuildingService.AddUnitAsync(_Unit);
    }

    private async Task UpdateItem(SpiderHood.Models.RealEstateUnit item)
    {
        await BuildingService.UpdateUnitAsync(item);
    }

