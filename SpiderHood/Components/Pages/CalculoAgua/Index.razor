@page "/agua"
@rendermode InteractiveServer

<PageTitle>Sistema de Cálculo de Agua</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="jumbotron bg-gradient-primary text-white p-4 rounded">
                <!--
                <h1 class="display-4">
                    <i class="fas fa-tint mr-3"></i>SISTEMA DE CÁLCULO DE CONSUMO DE AGUA
                </h1>
                <p class="lead">Sistema para cálculo individual y en bloque con importación desde Excel</p>
                <hr class="my-4 bg-white">-->
                <div class="row">
                    <div class="col-md-4">
                        <div class="text-center">
                            <i class="fas fa-file-import fa-2x mb-2"></i>
                            <h5>Importación Excel</h5>
                            <small>Carga masiva de lecturas</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center">
                            <i class="fas fa-calculator fa-2x mb-2"></i>
                            <h5>Cálculo Automático</h5>
                            <small>Según tarifas configurables</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center">
                            <i class="fas fa-history fa-2x mb-2"></i>
                            <h5>Histórico</h5>
                            <small>Registro por período</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestañas para diferentes modos -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="bloque-tab" data-bs-toggle="tab" 
                            data-bs-target="#bloque" type="button" role="tab">
                        <i class="fas fa-building mr-2"></i>Lectura en Bloque
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="individual-tab" data-bs-toggle="tab" 
                            data-bs-target="#individual" type="button" role="tab">
                        <i class="fas fa-home mr-2"></i>Cálculo Individual
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="historico-tab" data-bs-toggle="tab" 
                            data-bs-target="#historico" type="button" role="tab">
                        <i class="fas fa-chart-bar mr-2"></i>Histórico
                    </button>
                </li>
            </ul>
            
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="bloque" role="tabpanel">
                    <LecturaBloque />
                </div>
                <div class="tab-pane fade" id="individual" role="tabpanel">
                    <CalculoAgua />
                </div>
                <div class="tab-pane fade" id="historico" role="tabpanel">
                    <!-- Componente de histórico -->
                    <div class="text-center py-5">
                        <h4 class="text-muted">Histórico de Consumo</h4>
                        <p class="text-muted">En desarrollo...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Código para manejar pestañas si es necesario
}