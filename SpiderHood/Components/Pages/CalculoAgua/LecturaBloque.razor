@using SpiderHood.Models
@using SpiderHood.Services
@using System.Globalization
@inject ICalculoService CalculoService
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@using ClosedXML.Excel
@inject IJSRuntime JSRuntime

<script src="/js/fileDownload.js"></script>

<div class="lectura-bloque-container">
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h3><i class="fas fa-water mr-2"></i>LECTURA DE AGUA EN BLOQUE</h3>
        </div>
        <div class="card-body">
            <!-- Selector de período -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label"><strong>Período:</strong></label>
                            <select @bind="_ultimoPeriodo" class="form-select" @bind:event="onchange" @bind:after="() => CargarPeriodo(_ultimoPeriodo)">
                                @foreach (var item in _periods.OrderBy(c => c.StartDate))
                                {
                                    <option value="@item.StartDate">@item.StartDate.ToString("MMM-yy")</option>
                                }
                            </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label"><strong>Cargo Fijo:</strong></label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <InputNumber @bind-Value="_cargoFijo" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button @onclick="() => ExportarPlantillaVacia()" class="btn btn-primary w-100">
                        <i class="fas fa-search mr-2"></i>Descargar Plantilla
                    </button>
                </div>
            </div>

            <!-- Importación desde Excel -->
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5><i class="fas fa-file-excel mr-2"></i>&nbsp;Importar desde Excel</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label"><strong>Seleccionar archivo Excel:</strong></label>
                                <InputFile Onchange="CargarArchivoExcel"
                                           accept=".xlsx,.xls,.csv"
                                           class="form-control" disabled="@(_lecturaActual.Status != 1)" />
                            </div>
                            @if (!string.IsNullOrEmpty(_archivoNombre))
                            {
                                <div class="alert alert-success">
                                    <i class="fas fa-check-circle mr-2"></i>
                                    Archivo cargado: @_archivoNombre (@_lecturasCargadas.Count registros)
                                    <button @onclick="ProcesarLecturasCargadas"
                                            class="btn btn-success btn-sm float-end">
                                        Procesar Todas
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="text-center">
                        <div class="display-6 text-primary">@_lecturasProcesadas.Count</div>
                        <div class="text-muted">Lecturas procesadas</div>
                        @if (_esPrimeraCarga)
                        {
                            <div class="text-muted"><strong>Primera Carga</strong></div>
                        }
                    </div>
                </div>
            </div>

            <!-- Mensajes de estado -->
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(mensaje.Contains("éxito") ? "alert-success" : mensaje.Contains("Error") ? "alert-danger" : "alert-warning") alert-dismissible fade show">
                    <div class="d-flex align-items-center">
                        <i class="bi @(mensaje.Contains("éxito") ? "bi-check-circle-fill" : mensaje.Contains("Error") ? "bi-exclamation-triangle-fill" : "bi-info-circle-fill") me-2"></i>
                        <div>
                            <strong>@mensaje</strong>
                            <br />
                            @foreach (var error in _lecturaActual.errors)
                            {
                                <label>@error</label><br />
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
                </div>
            }

            <!-- Tabla de lecturas -->
            @if (_lecturasProcesadas.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-hover table-striped">
                        <thead>
                            <tr>
                                <th>Dpto</th>
                                <th>Período</th>
                                <th>ID Lectura</th>
                                <th>Lectura Anterior</th>
                                <th>Lectura Actual</th>
                                <th>Consumo (m³)</th>
                                <th>Monto Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lectura in _lecturasProcesadas)
                            {
                                <tr class="@(!lectura.Minimum ? "table-success" : "table-warning")">
                                    <td>@lectura.GroupNumber</td>
                                    <td>@lectura.Period.ToString("MMMM-yy", new CultureInfo("es-ES"))</td>
                                    <td><small class="text-muted">@lectura.Code</small></td>
                                    <td align="right">@lectura.PreviousReading.ToString("F3")</td>
                                    <td align="right">
                                        <strong>@lectura.CurrentReading.ToString("F3")</strong>
                                    </td>
                                    <td align="right">
                                        @if (lectura.Procesed)
                                        {
                                            <span class="badge @(!lectura.Minimum ? "bg-primary" : "bg-danger")">
                                                @lectura.Consumption.ToString("F2") m³
                                            </span>
                                        }
                                        else{
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-danger dropdown-toggle"
                                                        type="button"
                                                        data-bs-toggle="dropdown">
                                                    Posibles Actions
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <a class="dropdown-item"
                                                           @onclick="() => ApplyMinimun(lectura)">
                                                            <div class="d-flex justify-content-between">
                                                                <span>Minimo</span>
                                                                <span class="text-muted">@ParameterService.MinAgua</span>
                                                            </div>
                                                            <small class="text-muted">Aplicar Minimo</small>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item">
                                                            <div class="d-flex justify-content-between">
                                                                <span>Otro</span>
                                                                <span class="text-muted">@_anotherValue</span>
                                                            </div>
                                                            <InputNumber @bind-Value="_anotherValue" class="form-control" @onkeypress="async (e) => await onKeyPress(lectura, e)" />
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                            }
                                    </td>
                                    <td align="right">
                                            <strong class="text-success">
                                            S/ @lectura.CalculatedAmount.ToString("F2")
                                            </strong>
                                    </td>
                                    <td>
                                        <button @onclick="() => SeleccionarLectura(lectura)"
                                                class="btn btn-info btn-sm mr-1"
                                                title="Ver detalle">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="6" class="text-end"><strong>TOTAL GENERAL:</strong></td>
                                <td colspan="2">
                                    <strong class="text-primary">
                                        S/ @TotalGeneral.ToString("F2")
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Botones de acción -->
                <div class="d-flex justify-content-between">
                    <button @onclick="ExportarAExcel" class="btn btn-success">
                        <i class="fas fa-file-excel mr-2"></i>Exportar a Excel
                    </button>
                    @if (_lecturaActual.Status == 1 && !_error && !_pending)
                    {
                        <button @onclick="GuardarLecturas" class="btn btn-primary">
                            <i class="fas fa-save mr-2"></i>Guardar Lecturas
                        </button>
                    }
                    <button @onclick="LimpiarDatos" class="btn btn-danger">
                        <i class="fas fa-trash mr-2"></i>Limpiar Todo
                    </button>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-file-import fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No hay lecturas cargadas</h4>
                    <p class="text-muted">Importe un archivo Excel o ingrese lecturas manualmente</p>
                </div>
            }
        </div>
    </div>

    <!-- Modal para detalle de cálculo -->
    @if (_lecturaSeleccionada != null && _lecturaSeleccionada.CalculationDetail != null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5)">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="fas fa-calculator mr-2"></i>
                            Detalle de Cálculo - Dpto @_lecturaSeleccionada.GroupNumber
                        </h5>
                        <button @onclick="CerrarModalDetalle" class="btn-close btn-close-white"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Consumo:</strong> @_lecturaSeleccionada.Consumption.ToString("F2") m³
                            </div>
                            <div class="col-md-6">
                                <strong>Período:</strong> @_lecturaActual.Period.ToString("MMMM yy")
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr class="table-secondary">
                                        <th align="center">Rango</th>
                                        <th align="center">Consumo (m³)</th>
                                        <th align="center">Tarifa Unit.</th>
                                        <th align="center">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in _lecturaSeleccionada.CalculationDetail.Detalles)
                                    {
                                        <tr>
                                            <td>@detalle.Rango</td>
                                            <td align="right">@detalle.Consumo.ToString("F2")</td>
                                            <td align="right">S/ @detalle.Tarifa.ToString("F3")</td>
                                            <td align="right">S/ @detalle.Monto.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end">Subtotal:</td>
                                        <td align="right">S/ @_lecturaSeleccionada.CalculationDetail.Subtotal.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end">Cargo Fijo:</td>
                                        <td align="right">S/ @_lecturaSeleccionada.CalculationDetail.CargoFijo.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end">Total sin IGV:</td>
                                        <td align="right">S/ @_lecturaSeleccionada.CalculationDetail.TotalSinIGV.ToString("F2")</td>
                                    </tr>
                                    <tr class="table-primary">
                                        <td colspan="3" class="text-end"><strong>TOTAL + IGV:</strong></td>
                                        <td align="right"><strong>S/ @_lecturaSeleccionada.CalculationDetail.TotalConIGV.ToString("F2")</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button @onclick="CerrarModalDetalle" class="btn btn-secondary">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Constantes y configuración
    private const decimal CARGO_FIJO_DEFAULT = 5.04m;

    // Estado del componente
    private DateTime _periodoActual = DateTime.Now;
    private decimal _cargoFijo = CARGO_FIJO_DEFAULT;
    private List<ServiceReadingDetail> _lecturasProcesadas = new();
    private List<ServiceReadingDetail> _lecturasCargadas = new();
    private ServiceReading _lecturaActual = new();
    private ServiceReadingDetail? _lecturaSeleccionada;
    private string _archivoNombre = string.Empty;
    private IBrowserFile? _archivoExcel;
    private DateTime _ultimoPeriodo;
    
    private List<ServiceReadingDetail> _detallesPeriodoAnterior = new();
    private bool _esPrimeraCarga = false;
    private string mensaje = "";
    private bool _error = false;
    private double _anotherValue = 0;
    private bool _pending = true;

    private List<Period> _periods = new();
    private Period _currentPeriod = new();

    // Selectores de fecha
//    private List<SelectListItem> _mesesDisponibles = new();
  //  private List<SelectListItem> _aniosDisponibles = new();
    private int _anioInicio = DateTime.Now.Year;
    private int _mesInicio= DateTime.Now.Month;

    // Propiedades calculadas
    private decimal TotalGeneral => _lecturasProcesadas
        .Sum(l => l.CalculatedAmount);

    private bool HayLecturasCargadas => _lecturasCargadas.Any();
    private bool HayLecturasProcesadas => _lecturasProcesadas.Any();
    private bool PuedeGuardar => HayLecturasProcesadas && _lecturasProcesadas.All(l => l.Procesed);

    private async Task onKeyPress(ServiceReadingDetail lectura, KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Task.Delay(500); // Asegurar que cambiara el valor
            _ = RecalcularLectura(lectura, _anotherValue);
            _anotherValue = 0;
            await CountTotal();
        }
    }

    private async Task ApplyMinimun(ServiceReadingDetail lectura)
    {
        _ = RecalcularLectura(lectura, ParameterService.MinAgua);
        await CountTotal();
    }

    protected override async Task OnInitializedAsync()
    {
        if (ParameterService.IdBuilding == Guid.Empty) return;

        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        try
        {
            // Cargar periodos desde BD
            _periods = await ParameterService.GetPeriodsAsync();

            // Determinar si es primera carga
            _esPrimeraCarga = _periods.Count == 0;

            // Configurar periodo inicial
            await ConfigurarPeriodoInicial();

            // Cargar lecturas del periodo anterior
            await CargarPeriodo(_periodoActual);
        }
        catch (Exception ex)
        {
            // TODO: Implementar logging de errores
            Console.WriteLine($"Error al cargar datos iniciales: {ex.Message}");
        }
    }

    private async Task ConfigurarPeriodoInicial()
    {
        _ultimoPeriodo = new DateTime(_anioInicio, _mesInicio, 1);

        if (!_periods.Any(p => p.StartDate == _ultimoPeriodo))
        {
            await CrearNuevoPeriodo();
        }
        _periodoActual = _ultimoPeriodo;
    }

    private async Task CrearNuevoPeriodo()
    {
        var nuevoPeriodo = new ServiceReading
        {
            IdServiceReading = Guid.NewGuid(),
            Status = 1,
            IdBuilding = ParameterService.IdBuilding,
            Period = _ultimoPeriodo,
            CreatedOn = DateTime.Now
        };

        Period newPeriod = ParameterService.CreateNewPeriod(_ultimoPeriodo).Result;
        _periods.Add(newPeriod);
        _lecturaActual = nuevoPeriodo;
        _currentPeriod = newPeriod;
    }

    private async Task CargarLecturasPeriodoAnterior()
    {
        if (_esPrimeraCarga)
        {
            _detallesPeriodoAnterior = await CalculoService.GetFirstWaterReadingDetailList(
                ParameterService.ec,
                ParameterService.IdBuilding
            );
        }
        else
        {
            var periodoAnterior = _periods
                .FirstOrDefault(p => p.StartDate == _ultimoPeriodo.AddMonths(-1));

            if (periodoAnterior != null)
            {
                _detallesPeriodoAnterior = await CalculoService
                    .ObtenerLecturasPorPeriodoAsync(ParameterService.ec, periodoAnterior.StartDate);
            }
        }
    }

    private async Task CargarPeriodo(DateTime periodo)
    {
        try
        {
            _error = false;
            mensaje = string.Empty;
            _periodoActual = periodo;

            _periods = _periods.OrderBy(c => c.StartDate).ToList();

            var periodoExistente = _periods.FirstOrDefault(p => p.StartDate == periodo);

            if (periodoExistente != null)
            {
                _lecturasProcesadas = await CalculoService.ObtenerLecturasPorPeriodoAsync(
                    ParameterService.ec,
                    periodo
                );

                MarcarTodasComoProcesadas();
                await RecalcularTodas();

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // TODO: Mostrar mensaje de error al usuario
            Console.WriteLine($"Error al cargar periodo: {ex.Message}");
        }
    }

    private async Task CargarArchivoExcel(InputFileChangeEventArgs e)
    {
        try
        {
            _archivoExcel = e.File;
            _archivoNombre = _archivoExcel.Name;
            mensaje = string.Empty;
            _error = false;
            _pending = true;

            if (_archivoExcel.Size > 10 * 1024 * 1024) // 10MB límite
            {
                // TODO: Mostrar error de archivo muy grande
                return;
            }

            using var stream = _archivoExcel.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            if (_esPrimeraCarga)
            {
                _periodoActual = new DateTime(_anioInicio, _mesInicio, 1);
            }

            //await SincronizarConPeriodoAnterior();
            await CargarLecturasPeriodoAnterior();

            _lecturaActual = await CalculoService.ImportarDesdeExcelAsync(
                memoryStream,
                ParameterService.IdBuilding,
                _periodoActual,
                _detallesPeriodoAnterior, _archivoNombre, ParameterService.ec 
            );

            _lecturasCargadas = _lecturaActual.WaterReadingDetail ?? new List<ServiceReadingDetail>();

            if (_lecturaActual.errors.Count > 0)
            {
                int erroresEncontrados = _lecturaActual.errors.Count;

                mensaje = $"Archivo '{_archivoNombre}' con errores. "
                    + Environment.NewLine
                    + $"Se encontraron ({erroresEncontrados}) errores."
                    + Environment.NewLine
                    + "El formato debe ser: DPTO | Periodo | Lectura Actual | Fecha Lectura";

                _error = true;
            }

            //errorProcesamiento = _lecturaActual.errors;
            await ProcesarLecturasCargadas();
        }
        catch (Exception ex)
        {
            // TODO: Mostrar mensaje de error al usuario
            Console.WriteLine($"Error al cargar archivo: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ProcesarLecturasCargadas()
    {
        if (!_lecturasCargadas.Any()) return;

        if (_esPrimeraCarga)
        {
            _lecturasProcesadas = _lecturasCargadas;
            MarcarTodasComoProcesadas();
        }
        else
        {
            _lecturasProcesadas = await CalculoService.ProcesarLecturasBloqueAsync(
                _lecturasCargadas,
                _cargoFijo
            );
        }

        StateHasChanged();
    }

    private void MarcarTodasComoProcesadas()
    {
        foreach (var lectura in _lecturasProcesadas)
        {
            lectura.Procesed = true;
            lectura.Minimum = lectura.Consumption <= 0;
        }
    }

    private async Task RecalcularLectura(ServiceReadingDetail lectura, double value)
    {
        try
        {
            var consumo = lectura.Consumption == 0 ?
                                value : lectura.Consumption;

            var calculo = await CalculoService.CalcularConsumoAsync(consumo, _cargoFijo);

            lectura.CalculationDetail = calculo;
            lectura.CalculatedAmount = calculo.TotalConIGV;
            lectura.Minimum = lectura.Consumption <= 0;
            lectura.Consumption = consumo;
            lectura.Procesed = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            // TODO: Mostrar error al recalcular
            Console.WriteLine($"Error al recalcular: {ex.Message}");
        }
    }

    private async Task RecalcularTodas()
    {
        foreach (var lectura in _lecturasProcesadas.Where(l => l.Procesed))
        {
            await RecalcularLectura(lectura, ParameterService.MinAgua);
        }
    }

    private void SeleccionarLectura(ServiceReadingDetail lectura)
    {
        _lecturaSeleccionada = lectura;
        StateHasChanged();
    }

    private void CerrarModalDetalle()
    {
        _lecturaSeleccionada = null;
        StateHasChanged();
    }

    private async Task GuardarLecturas()
    {
        using var transaction = await ParameterService.context.Database.BeginTransactionAsync();
        try
        {
            if (!PuedeGuardar)
            {
                // TODO: Mostrar mensaje de que faltan procesar lecturas
                return;
            }

            //agregar periodo
            if (_periods.Where(c => c.IsNewPeriod).Count() > 0)
            {
                await ParameterService.ec.AddNewRecordAsync(_currentPeriod);
            }

            // Asignar detalles procesados a la lectura actual
            _lecturaActual.WaterReadingDetail = _lecturasProcesadas;
            _lecturaActual.TotalAmount = TotalGeneral;
            _lecturaActual.IdPeriod = _currentPeriod.IdPeriod;

            // Guardar en base de datos
            await ParameterService.ec.AddNewRecordAsync(_lecturaActual);

            // Guardar en base de datos
            await ParameterService.ec.AddNewRecordAsync(_lecturaActual.WaterReadingDetail);

            await transaction.CommitAsync();

            _esPrimeraCarga = false;

            await MostrarMensajeExito("Lecturas guardadas exitosamente");

            LimpiarDatos();

            _periods = await ParameterService.GetPeriodsAsync();

            await ConfigurarPeriodoInicial();

            await CargarPeriodo(_periodoActual);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            // TODO: Mostrar mensaje de error
            await transaction.RollbackAsync();
            await MostrarMensajeError($"Error al guardar lecturas: {ex.Message}");
        }
    }

    private void LimpiarDatos()
    {
        _lecturasProcesadas.Clear();
        _lecturasCargadas.Clear();
        _archivoNombre = string.Empty;
        _archivoExcel = null;
        _lecturaSeleccionada = null;
        _error = false;
        mensaje = string.Empty;

        StateHasChanged();
    }

    private async Task MostrarMensajeExito(string _mensaje)
    {
        // TODO: Implementar notificación de éxito (usar Toast, Snackbar, etc.)
        mensaje = _mensaje;
        Console.WriteLine($"Éxito: {mensaje}");
        await Task.CompletedTask;
    }

    private async Task MostrarMensajeError(string _mensaje)
    {
        // TODO: Implementar notificación de error
        mensaje = _mensaje;
        Console.WriteLine($"Error: {mensaje}");
        await Task.CompletedTask;
    }

    private async Task CountTotal()
    {
        int Total = _lecturasProcesadas.Count(c => !c.Procesed);

        if (Total == 0) _pending = false;
    }

    // FUNCIONES FALTANTES DESARROLLADAS

    private async Task EliminarLectura(ServiceReadingDetail lectura)
    {
        try
        {
    _lecturasProcesadas.Remove(lectura);
    StateHasChanged();

    await MostrarMensajeExito("Lectura eliminada");
        }
        catch (Exception ex)
        {
    await MostrarMensajeError($"Error al eliminar: {ex.Message}");
        }
    }

    private async Task EditarLecturaManual()
    {
        // TODO: Implementar modal o formulario para edición manual
        await Task.CompletedTask;
    }

    private async Task ValidarConsistenciaDatos()
    {
        try
        {
    var inconsistencias = new List<string>();

    foreach (var lectura in _lecturasProcesadas)
    {
        // Validar consumo negativo
        if (lectura.Consumption < 0)
        {
            inconsistencias.Add($"Lectura {lectura.Code} tiene consumo negativo");
        }

        // Validar que si hay consumo debe tener monto calculado
        if (lectura.Consumption > 0 && lectura.CalculatedAmount > 0)
        {
            inconsistencias.Add($"Lectura {lectura.Code} tiene consumo pero no monto calculado");
        }
    }

    if (inconsistencias.Any())
    {
        // TODO: Mostrar advertencias
        foreach (var inc in inconsistencias)
        {
            Console.WriteLine($"Advertencia: {inc}");
        }
    }
        }
        catch (Exception ex)
        {
    Console.WriteLine($"Error en validación: {ex.Message}");
        }
    }

    private async Task GenerarReporteConsumo()
    {
        try
        {
    if (!HayLecturasProcesadas) return;

