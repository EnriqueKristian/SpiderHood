@page "/category"
@rendermode InteractiveServer
@using System.Threading.Tasks
@using SpiderHood.Data
@using SpiderHood.Models
@using SpiderHood.Services
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@inject Services.AuthService AuthService
@inject Services.IPermissionService PermissionService
@inject IJSRuntime JSRuntime

@implements IDisposable

<div class="container-fluid px-4 py-3">
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-tags"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Administración de Categorías</h1>
                <p class="text-muted mb-0">Organiza tus gastos y mantenimientos con categorías personalizadas</p>
            </div>
        </div>
        <div class="page-header-actions">
            @if (_canManageCategories)
            {
                <button class="btn btn-primary" type="button"
                        @onclick="() => OpenModal(new Category(), 0, OpenType.Create)">
                    <i class="bi bi-plus-circle me-2"></i>Agregar Categoría
                </button>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-folder2"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Categorías</div>
                        <div class="h4 fw-bold mb-0">@CatParent.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-list-ul"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Subcategorías</div>
                        <div class="h4 fw-bold mb-0">@TotalSubcategoriasCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-bar-chart"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Promedio por Categoría</div>
                        <div class="h4 fw-bold mb-0">@PromedioPorCategoria.ToString("0.0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="main-content">
        <div class="categories-section">
            <h4>Categorías Existentes</h4>

            @if (!Categories.Any())
            {
                <div class="alert alert-info">
                    No hay categorías registradas. ¡Comienza agregando una!
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var categoria in CatParent)
                    {
                        <div class="col-md-6 mb-4">
                            <CategoryCard Category="categoria" 
                                          Categories="_categories"
                                          OnEdit="ShowModal"
                                         OnDelete="ShowDeleteModal"
                                         OnAddSubcategory="() => OpenModal(new Category { ParentId = categoria.IdCategory }, 1, OpenType.Create)" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="footer-note">
        <p>El tipo de distribución seleccionado para cada categoría o subcategoría se aplicará automáticamente a los gastos que se registren con ellas.</p>
    </div>
</div>

<!-- MODAL PARA NUEVO / MODIFICACION DE CATEGORIAS -->
<SpiderHood.Components.Pages.CategoryPages.ModalCategory 
    ShowModal="@_mostrarModal"
    ShowModalChanged="@((valor) => _mostrarModal = valor)"
    OpenMode="@_openMode"
    ViewCategory="@_currentCategory"
    TypeCategory="@_typeCategory"
    OnSaveItem="@SaveItem" />

<!-- MODAL PARA ELIMINACION DE CATEGORIAS -->
<Modal @ref="_deleteModal" 
       Title="Eliminar Categoria" 
       UseStaticBackdrop="true" 
       CloseOnEscape="false" 
       IsVerticallyCentered="true">
    <BodyTemplate>
        ¿Está seguro que desea eliminar la categoría?
        @if (_currentCategory != null)
        {
            <div class="mt-2 fw-bold">@_currentCategory.ShortDescript</div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Danger" @onclick="DeleteItem">Eliminar</Button>
        <Button Color="ButtonColor.Secondary" @onclick="HideDeleteModal">Cancelar</Button>
    </FooterTemplate>
</Modal>

@code {
    // Variables privadas
    private Category _currentCategory = null!;
    private List<Category> _categories = new();
    private List<Category> _catParent = new();
    private bool _mostrarModal = false;
    private int _typeCategory = 0; // 0 Categoria | 1 Sub Categoria
    private OpenType _openMode;
    private Modal _deleteModal = null!;

    [Inject]
    public Services.ICategoryService CategoryService { get; set; } = default!;

    // Propiedades calculadas
    private List<Category> Categories => _categories;
    private List<Category> CatParent => _catParent;

    private int TotalSubcategoriasCount => _categories.Count(c => c.Nivel != 0);
    private double PromedioPorCategoria => _catParent.Count == 0 ? 0 : (double)TotalSubcategoriasCount / _catParent.Count;

    private bool _canManageCategories;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _canManageCategories = await PermissionService.HasPermissionAsync(currentUser, "manage_categories");

        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        if (ParameterService.CurrentBuilding == null) return;
        try
        {
            _categories = await CategoryService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding);

            _catParent = _categories
                .Where(c => c.Nivel == 0)
                .ToList();
        }
        catch (Exception ex)
        {
            // En producción, loguear el error
            Console.Error.WriteLine($"Error cargando categorías: {ex.Message}");
        }
    }

    private async Task ShowModal(Models.Category category)
    {
        // El tipo se deriva del propio dato (¿tiene padre?), no se asume: de lo contrario
        // editar una subcategoría abría el modal en modo "categoría" (mostrando el selector
        // de color que las subcategorías no usan — ver ModalCategory).
        var type = category.ParentId == Guid.Empty ? 0 : 1;
        OpenModal(category, type, OpenType.Update);
    }

    private void OpenModal(Category item, int type, OpenType mode)
    {
        if (!_canManageCategories) return;
        _currentCategory = item;
        _typeCategory = type;
        _openMode = mode;
        _mostrarModal = true;
    }

    private async Task ShowDeleteModal(Guid idCategory)
    {
        if (!_canManageCategories) return;
        _currentCategory = _categories.FirstOrDefault(c => c.IdCategory == idCategory)
            ?? new Category { IdCategory = idCategory };
        await _deleteModal.ShowAsync();
    }

    private async Task HideDeleteModal()
    {
        await _deleteModal.HideAsync();
    }

    private async Task SaveItem(Category item)
    {
        if (!_canManageCategories) return;
        try
        {
            if (_openMode == OpenType.Create)
            {
                await AddItem(item);
            }
            else if (_openMode == OpenType.Update)
            {
                await UpdateItem(item);
            }

            await LoadCategories();
        }
        catch (Exception ex)
        {
            // Manejar el error apropiadamente
            Console.Error.WriteLine($"Error guardando categoría: {ex.Message}");
        }
        finally
        {
            _mostrarModal = false;
        }
    }

    private async Task AddItem(Models.Category item)
    {
        item.IdCategory = Guid.NewGuid();
        item.IdBuilding = ParameterService.CurrentBuilding.IdBuilding;
        // Nivel nunca se seteaba al crear una subcategoría (quedaba en el default 0, igual
        // que una categoría de nivel superior), así que cada subcategoría nueva también se
        // renderizaba como su propia tarjeta duplicada en la vista de nivel superior
        // (CategoryPage.LoadCategories filtra _catParent por Nivel == 0).
        item.Nivel = item.ParentId == Guid.Empty ? 0 : 1;

        // INS_Category recibía item.Nivel en el lugar de @Sort (bug de BDLayout.Add.cs,
        // ya corregido) -- como Nivel de una categoría raíz siempre es 0, TODA categoría
        // raíz terminaba con Sort = 0 en BD, y GET_BudgetDetailDefault (usado por "Nueva
        // Plantilla" en Presupuesto) las mostraba a todas colapsadas en una sola sección.
        // Sólo importa un valor único por categoría RAÍZ (ver Category.Sort) -- las
        // subcategorías heredan el de su padre porque así arma la sección view_categories.
        item.Sort = item.ParentId == Guid.Empty
            ? (_catParent.Any() ? _catParent.Max(c => c.Sort) + 1 : 1)
            : (_categories.FirstOrDefault(c => c.IdCategory == item.ParentId)?.Sort ?? 0);

        await CategoryService.AddCategoryAsync(item);
        //await ParameterService.Context.SaveChangesAsync();
    }

    private async Task UpdateItem(Category item)
    {
        try
        {
            await CategoryService.UpdateCategoryAsync(item);
            //await ParameterService.Context.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error actualizando categoría: {ex.Message}");
            if (!await ItemExists(item.IdCategory))
            {
                Navigation.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
    }

    private async Task DeleteItem()
    {
        if (!_canManageCategories) { await HideDeleteModal(); return; }
        try
        {
            var result = await CategoryService.DeleteCategoryAsync(_currentCategory);
            if (!result.IsSuccess)
            {
                await JSRuntime.InvokeVoidAsync("alert", result.ErrorMessage ?? "No se pudo eliminar la categoría");
                return;
            }

            //await ParameterService.Context.SaveChangesAsync();
            await LoadCategories();
        }
        catch (Exception ex)
        {
            // Manejar el error apropiadamente
            Console.Error.WriteLine($"Error eliminando categoría: {ex.Message}");
        }
        finally
        {
            await _deleteModal.HideAsync();
        }
    }

    private async Task<bool> ItemExists(Guid id)
    {
        return false;
        /*return await Task.Run(() => 
            ParameterService.Context.Building.Any(e => e.IdBuilding == id));*/
    }

    private string GetDistributionClass(TypeDistribution tipo)
    {
        return tipo == TypeDistribution.Fija 
            ? "distribution-fixed" 
            : "distribution-percentage";
    }

    public void Dispose()
    {
        // Liberar recursos si es necesario
    }
}