@page "/category/details"
@using Microsoft.EntityFrameworkCore
@using SpiderHood.Models
@inject IDbContextFactory<SpiderHood.Data.SpiderHoodContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Detail</h1>
<div>
    <h2>Sub Category</h2>
    <hr />
    @if (view_category is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@view_category.Description</dd>
            <dt class="col-sm-2">Short Description</dt>
            <dd class="col-sm-10">@view_category.ShortDescript</dd>
            <dt class="col-sm-2">Icono</dt>
            <dd class="col-sm-10">@view_category.Icon</dd>
            <dt class="col-sm-2">Color</dt>
            <dd class="col-sm-10">@view_category.Color</dd>
        </dl>
        <div>
            <a href="@($"/category/edit?id={view_category.IdCategory}")">Edit</a> |
            <a href="@($"/category")">Back to List</a>
        </div>
    }
</div>

@code {

    private Category? view_category;
    private IQueryable<Models.Category> boardCategory = Enumerable.Empty<Models.Category>().AsQueryable();

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        /*
        using var context = DbFactory.CreateDbContext();
        view_category = await context.Category.FirstOrDefaultAsync(m => m.IdCategory == Id);

        if (view_category is null)
        {
            NavigationManager.NavigateTo("notfound");
        }*/

        using var context = DbFactory.CreateDbContext();
        //view_category = await context.Category.FirstOrDefaultAsync(m => m.Id == Id);
        //view_category.IdBuilding = new Guid("C574A553-1573-48C8-F85E-08DE3426C28E");

        SpiderHood.Data.BDLayout ec = new SpiderHood.Data.BDLayout(context);
        view_category = ec.GetCategoryById(Id);

        if (view_category is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

}
