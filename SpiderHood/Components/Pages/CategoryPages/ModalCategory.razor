@using System.ComponentModel.DataAnnotations

@inherits LayoutComponentBase

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-tag me-2 text-primary"></i>@((OpenMode == Models.OpenType.Create) ? "Agregar Categoria" : "Actualizar Categoria")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <EditForm Model="@ViewCategory" OnValidSubmit="@Guardar" method="post" FormName="create" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                <div class="modal-body">
                        <div class="mb-3">
                            <label for="description" class="form-label">@((TypeCategory == 1) ? "Nombre de la Sub Categoria" : "Nombre de la Categoria"):</label>
                            <InputText id="description" @bind-Value="ViewCategory.Description" class="form-control" aria-required="true" placeholder="@NombrePlaceholder" />
                            <ValidationMessage For="() => ViewCategory.Description" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label for="shortdescription" class="form-label">Descripción Corta:</label>
                            <InputText id="shortdescription" @bind-Value="ViewCategory.ShortDescript" class="form-control" placeholder="@DescripcionPlaceholder" />
                            <ValidationMessage For="() => ViewCategory.ShortDescript" class="text-danger" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label">Icono</label>
                            <div class="icon-grid">
                                @foreach (var icon in IconosDisponibles)
                                {
                                    var isSelected = icon == ViewCategory.Icon;
                                    <button type="button"
                                            class="icon-item @(isSelected ? "selected" : "")"
                                            title="@icon"
                                            @onclick="@(() => SeleccionarIcono(icon))">
                                        <i class="@icon"></i>
                                    </button>
                                }
                            </div>
                            <ValidationMessage For="() => ViewCategory.Icon" class="text-danger" />
                        </div>
                        @if (TypeCategory == 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">Color</label>
                                <div class="color-grid">
                                    @foreach (var color in ColoresDisponibles)
                                    {
                                        var isSelected = color == ViewCategory.Color;
                                        <button type="button"
                                        class="color-item @(isSelected ? "selected" : "")"
                                        style="background-color:@color"
                                        title="@color"
                                        @onclick="@(() => SeleccionarColor(color))">
                                        </button>
                                    }
                                </div>
                                <ValidationMessage For="@(() => ViewCategory.Color)" />
                            </div>
                        }
                        else
                        {
                            ViewCategory.Color = "#FFFFFF";    
                        }
                        <div class="form-group">
                            <label class="form-label">Tipo de Distribución:</label>
                            <div class="distribution-options">
                                <div class="distribution-option @(ViewCategory.Distribution == Models.TypeDistribution.Fija ? "selected" : "")"
                                     @onclick="() => SeleccionarDistribucion(Models.TypeDistribution.Fija)">
                                    Fija
                                </div>
                                <div class="distribution-option @(ViewCategory.Distribution == Models.TypeDistribution.Proporcional ? "selected" : "")"
                                     @onclick="() => SeleccionarDistribucion(Models.TypeDistribution.Proporcional)">
                                    Porcentaje
                                </div>
                            </div>
                            <p class="form-description">@DistribucionDescripcion</p>
                        </div>
                </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>@((OpenMode == Models.OpenType.Create) ? "Guardar" : "Actualizar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public int TypeCategory { get; set; }
    [Parameter] public Models.OpenType OpenMode { get; set; }
    [Parameter] public Models.Category ViewCategory { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    [Parameter] public EventCallback<SpiderHood.Models.Category> OnSaveItem { get; set; }

    private bool isCategoryMode = true;

    private string NombrePlaceholder => isCategoryMode ? "Ej: Servicios Básicos" : "Ej: Luz, Agua, Mantenimiento";
    private string NombreLabel => isCategoryMode ? "Nombre de la Categoría:" : "Nombre de la Sub Categoría:";

    private string DescripcionPlaceholder => isCategoryMode
        ? "Ej: Gastos de servicios esenciales"
        : "Ej: Consumo eléctrico mensual";
    public string DescripcionDescripcion => isCategoryMode
        ? "Una breve descripción de la categoría"
        : "Una breve descripción de la subcategoría";

    private string DistribucionDescripcion => isCategoryMode
    ? "Este valor se heredará a los gastos cuando selecciones esta categoría"
    : "Este valor se heredará a los gastos cuando selecciones esta subcategoría";

    private void SeleccionarDistribucion(Models.TypeDistribution tipo)
    {
        ViewCategory.Distribution = tipo;
    }

    private async Task Guardar()
    {
        await OnSaveItem.InvokeAsync(ViewCategory);
        await CerrarModal();
    }

    private async Task CerrarModal()
    {
        ShowModal = false;
        await ShowModalChanged.InvokeAsync(ShowModal);
    }

    private void SeleccionarColor(string color) => ViewCategory.Color = color;
    private void SeleccionarIcono(string icono) => ViewCategory.Icon = icono;

    // Paleta de 24 colores (puedes ajustar a tu guía de estilos)
    private readonly string[] ColoresDisponibles =
    [
        "#0d6efd","#6610f2","#6f42c1","#d63384",
        "#dc3545","#fd7e14","#ffc107","#198754",
        "#20c997","#0dcaf0","#6c757d","#343a40",
        "#4e79a7","#f28e2b","#e15759","#76b7b2",
        "#59a14f","#edc948","#b07aa1","#ff9da7",
        "#9c755f","#bab0ab","#2c3e50","#27ae60"
    ];

    // Fuente de iconos (puedes cambiar por tus clases de iconos: Bootstrap Icons, FontAwesome, etc.)
    private readonly string[] IconosDisponibles =
        [
        "bi bi-droplet",
        "bi bi-tools",
        "bi bi-inbox",
        "bi bi-lightbulb",
        "bi bi-lock",
        "bi bi-paperclip",
        "bi bi-tools",
        "bi bi-tree",
        "bi bi-people",
        "bi bi-people",
        "bi bi-person-vcard",
        "bi bi-bell",
        "bi bi-archive",
        "bi bi-building-check",
        "bi bi-calendar-week",
        "bi bi-graph-up",
        "bi bi-tree",
        "bi bi-flower1",
        "bi bi-shield-check",
        "bi bi-sliders"
    ];
}
