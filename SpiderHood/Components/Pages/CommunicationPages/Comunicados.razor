@page "/comunicados"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Components.Pages.Components
@inject Services.AuthService AuthService
@inject Services.IComunicadoService ComunicadoService
@inject Services.IPermissionService PermissionService
@inject Services.ParameterService ParameterService
@inject Services.IBuildingService BuildingService

<PageTitle>Comunicados</PageTitle>

@if (_loading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!_canPublicar)
{
    <div class="container-fluid px-4 py-3">
        <div class="alert alert-danger">
            <i class="bi bi-shield-lock me-1"></i>
            No tenés permiso para publicar Comunicados en este edificio.
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="page-header mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="page-header-title">
                <div class="icon-badge">
                    <i class="bi bi-megaphone"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Comunicados</h1>
                    <p class="text-muted mb-0">
                        Avisos oficiales al edificio -- Público (todos), Reservado (un rol)
                        o Privado (unidad o grupo puntual). Se manda por WhatsApp
                        (Simulado si no hay credenciales de Twilio) y, si se marca, también
                        por correo. Siempre queda registrado acá.
                    </p>
                </div>
            </div>
            <button class="btn btn-primary" @onclick="AbrirNuevo">
                <i class="bi bi-plus-lg me-1"></i>Nuevo Comunicado
            </button>
        </div>

        @if (_resultado is not null)
        {
            <div class="alert @(_resultadoOk ? "alert-success" : "alert-danger") alert-dismissible fade show">
                @_resultado
                <button type="button" class="btn-close" @onclick="() => _resultado = null"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h6 class="mb-0">Publicados</h6>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div style="min-width: 240px;">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Buscar por título o contenido..."
                                   value="@_searchTerm"
                                   @oninput="OnSearch" />
                        </div>
                        <div class="d-flex align-items-center">
                            <label class="me-2 text-muted small">Mostrar:</label>
                            <select class="form-select form-select-sm" style="width: auto;"
                                    @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                <option value="10" selected="@(_pageSize == 10)">10</option>
                                <option value="25" selected="@(_pageSize == 25)">25</option>
                                <option value="50" selected="@(_pageSize == 50)">50</option>
                            </select>
                        </div>
                    </div>
                </div>
                @if (_pagination.TotalRecords > 0)
                {
                    <p class="text-muted small mb-0 mt-1">
                        Mostrando @_pagination.StartRecord - @_pagination.EndRecord de @_pagination.TotalRecords comunicados
                    </p>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Título</th>
                            <th>Categoría</th>
                            <th>Alcance</th>
                            <th>Publicado por</th>
                            <th>Fecha</th>
                            <th class="text-center">Destinatarios</th>
                            <th class="text-center">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comunicado in _pagination.CurrentPageData)
                        {
                            <tr>
                                <td>@comunicado.Titulo</td>
                                <td>@ParameterService.GetChildParameterDescription(_idCategoriaComunicado, comunicado.IdCategoria)</td>
                                <td>@DescripcionAlcance(comunicado)</td>
                                <td>@comunicado.CreatedByName</td>
                                <td>@comunicado.CreatedOn.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">@comunicado.TotalDestinatarios</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" title="Ver destinatarios"
                                            @onclick="() => VerDetalle(comunicado)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!_pagination.CurrentPageData.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    @(string.IsNullOrWhiteSpace(_searchTerm) ? "No hay comunicados publicados todavía." : "Ningún comunicado coincide con la búsqueda.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_pagination.TotalPages > 1)
            {
                <div class="card-footer bg-transparent border-top py-3">
                    <PaginationControls _pagination="@_pagination" />
                </div>
            }
        </div>
    </div>
}

<ConfirmationModal @ref="_confirmationModal" OnClose="OnConfirmationResult" />

<!-- Modal: Nuevo Comunicado -->
<Modal @ref="_nuevoModal" Title="Nuevo Comunicado" Size="ModalSize.Large" UseStaticBackdrop="true" CloseOnEscape="false">
    <BodyTemplate>
        @if (_errorModal is not null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @_errorModal
                <button type="button" class="btn-close" @onclick="() => _errorModal = null"></button>
            </div>
        }
        <EditForm Model="_form" OnValidSubmit="ConfirmarPublicar">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Título *</label>
                <InputText @bind-Value="_form.Titulo" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Cuerpo *</label>
                <InputTextArea @bind-Value="_form.Cuerpo" class="form-control" rows="4" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Categoría *</label>
                    <select @bind-value="_form.IdCategoria" @bind-value:event="onchange" class="form-select">
                        @foreach (var cat in _categorias)
                        {
                            <option value="@cat.Value">@cat.ShortDescription</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Alcance *</label>
                    <select @bind-value="_form.Alcance" @bind-value:event="onchange" class="form-select">
                        <option value="@AlcanceComunicado.Publico">Público (todo el edificio)</option>
                        <option value="@AlcanceComunicado.Reservado">Reservado (un rol)</option>
                        <option value="@AlcanceComunicado.Privado">Privado (unidad o grupo)</option>
                    </select>
                </div>
            </div>

            @if (_form.Alcance == AlcanceComunicado.Reservado)
            {
                <div class="mb-3">
                    <label class="form-label">¿A qué rol le llega? *</label>
                    <select @bind="_form.RolReservado" class="form-select">
                        <option value="">Seleccionar rol...</option>
                        <option value="Administrador">Administrador</option>
                        <option value="Junta">Junta</option>
                        <option value="Residente">Residente</option>
                    </select>
                </div>
            }

            @if (_form.Alcance == AlcanceComunicado.Privado)
            {
                <div class="mb-3">
                    <label class="form-label">¿A qué unidad(es) le llega? *</label>
                    <div class="border rounded p-2" style="max-height: 180px; overflow-y: auto;">
                        @foreach (var unidad in _unidades)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@("u_" + unidad.IdGroupUnit)"
                                       checked="@_unidadesSeleccionadas.Contains(unidad.IdGroupUnit!.Value)"
                                       @onchange="(e) => ToggleUnidad(unidad.IdGroupUnit!.Value, (bool)e.Value!)" />
                                <label class="form-check-label" for="@("u_" + unidad.IdGroupUnit)">DPTO @unidad.UnitNumber</label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="form-check">
                <InputCheckbox @bind-Value="_form.EnviarPorCorreo" class="form-check-input" id="enviarCorreo" />
                <label class="form-check-label" for="enviarCorreo">Enviar también por correo</label>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-primary" @onclick="ConfirmarPublicar" disabled="@_publicando">
            @if (_publicando)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-send me-1"></i>Publicar
        </button>
        <button class="btn btn-secondary" @onclick="() => _nuevoModal.HideAsync()">Cancelar</button>
    </FooterTemplate>
</Modal>

<!-- Modal: detalle de destinatarios -->
<Modal @ref="_detalleModal" Title="@(_comunicadoSeleccionado?.Titulo ?? "Detalle del Comunicado")" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_comunicadoSeleccionado is not null)
        {
            <div class="mb-3">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge bg-secondary">@ParameterService.GetChildParameterDescription(_idCategoriaComunicado, _comunicadoSeleccionado.IdCategoria)</span>
                    <span class="badge bg-light text-dark border">@DescripcionAlcance(_comunicadoSeleccionado)</span>
                </div>
                <p style="white-space: pre-wrap;">@_comunicadoSeleccionado.Cuerpo</p>
                <p class="text-muted small mb-0">
                    Publicado por @_comunicadoSeleccionado.CreatedByName el @_comunicadoSeleccionado.CreatedOn.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
            <hr />
        }
        <h6 class="mb-2">Destinatarios</h6>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>WhatsApp</th>
                        <th>Correo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var destinatario in _destinatarios)
                    {
                        <tr>
                            <td>@destinatario.NombreDestinatario</td>
                            <td>@EtiquetaEstadoWhatsApp(destinatario.EstadoWhatsApp)</td>
                            <td>@EtiquetaEstadoCorreo(destinatario.EstadoCorreo)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="() => _detalleModal.HideAsync()">Cerrar</button>
    </FooterTemplate>
</Modal>
