@* Components/ConfirmationModal.razor *@
<div class="modal @(_isVisible ? "show d-block" : "d-none")" style="background-color: rgba(0,0,0,0.5)">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-@(_type == "danger" ? "danger" : "warning") text-white">
                <h5 class="modal-title">
                    <i class="@GetIcon() me-2"></i>
                    @Title
                </h5>
            </div>
            <div class="modal-body">
                <div class="alert alert-@_type">
                    @Message
                </div>
                @if (!string.IsNullOrEmpty(Details))
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <small class="text-muted">@Details</small>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                    <i class="fas fa-times me-1"></i> Cancelar
                </button>
                @if ( !IsCancelOnly )
                {
                <button type="button" class="btn btn-@(_type == "danger" ? "danger" : "warning")" @onclick="Confirm">
                    <i class="@GetConfirmIcon() me-1"></i> @ConfirmText
                </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Confirmación";
    [Parameter] public string Message { get; set; } = "¿Está seguro de realizar esta acción?";
    [Parameter] public string Details { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public string Type { get; set; } = "warning";
    [Parameter] public bool IsCancelOnly { get; set; } = false;
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private bool _isVisible = false;
    private string _type = "warning";

    public void Show(string type = "warning")
    {
        _isVisible = true;
        _type = type;
        StateHasChanged();
    }

    public void Hide()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        Hide();
        await OnClose.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        Hide();
        await OnClose.InvokeAsync(false);
    }

    private string GetIcon() => _type switch
    {
        "danger" => "fas fa-exclamation-triangle",
        "warning" => "fas fa-exclamation-circle",
        "info" => "fas fa-info-circle",
        _ => "fas fa-question-circle"
    };

    private string GetConfirmIcon() => _type switch
    {
        "danger" => "fas fa-trash-alt",
        _ => "fas fa-check"
    };
}