﻿@* Modal "Detalle de Cuota": desglose por item del presupuesto para una unidad puntual.
   Extraído de InstallmentTable.razor (Generación de Presupuesto) para que también lo use
   ListadoCuotas.razor (/cuotas) sin duplicar la lógica de cálculo. *@
@using SpiderHood.Models
@inject SpiderHood.Services.ParameterService ParameterService
@inject SpiderHood.Services.IBuildingService BuildingService
@inject SpiderHood.Services.IExtraChargeService ExtraChargeService

<Modal @ref="_modal" Title="@TituloModal" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <div class="modal-body p-0">
            <!-- Información del Propietario: una sola franja compacta, no una tarjeta grande -->
            <div class="owner-summary d-flex flex-column gap-1 px-4 py-2 border-bottom">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary">DPTO @_installment?.UnitName</span>
                        <span class="badge bg-secondary-subtle text-secondary">
                            <i class="bi bi-calendar3 me-1"></i>@_installment?.Period.ToString("MMMM yyyy")
                        </span>
                        <span class="fw-bold"><i class="bi bi-person me-1"></i>@_installment?.OwnerName</span>
                    </div>
                    <div class="d-flex align-items-center gap-4">
                        <div class="text-center">
                            <small class="text-muted d-block">Área</small>
                            <span class="fw-semibold">@_installment?.TotalArea.ToString("N2") m²</span>
                        </div>
                        <div class="text-center">
                            <small class="text-muted d-block">% Distr.</small>
                            <span class="fw-semibold">@_installment?.Percent.ToString("N2")%</span>
                        </div>
                        <div class="text-center">
                            <small class="text-muted d-block">Total Cuota</small>
                            <span class="fw-bold text-primary fs-5">S/ @(_installment?.Amount.ToString("N2"))</span>
                        </div>
                    </div>
                </div>

                @* El Área de arriba es la suma del grupo (DPTO + cochera + depósito, etc.) —
                   se lista de qué unidades sale, igual que la columna Unidad de Residentes. *@
                @if (_unidadesGrupo.Count > 1)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <small class="text-muted">Área compuesta por:</small>
                        @foreach (var unidad in _unidadesGrupo)
                        {
                            <span class="badge @GetUnitTypeBadge(unidad.TypeUnit)">
                                @ParameterService.GetChildParameterDescription(4, unidad.TypeUnit) @unidad.UnitNumber
                                · @unidad.Area.ToString("N2") m²
                            </span>
                        }
                    </div>
                }
            </div>

            @if (_installment != null && _installment.Type != InstallmentType.Ordinaria)
            {
                @* Extraordinaria/Multa/Mora no vienen de un desglose de BudgetDetail por
                   categoría — el "Total Cuota" de arriba ya es el monto completo, acá solo
                   se explica el concepto en vez de mostrar una tabla vacía. *@
                <div class="p-4">
                    <div class="alert alert-light border mb-0">
                        <span class="@TipoBadgeClass(_installment) me-2">@TipoBadgeText(_installment)</span>
                        @(string.IsNullOrWhiteSpace(_installment.Concept) ? "Sin concepto adicional." : _installment.Concept)
                    </div>
                </div>
            }
            else if (_budget == null)
            {
                <p class="text-muted p-4 mb-0">No se encontró el presupuesto de este periodo para desglosar la cuota.</p>
            }
            else
            {
                <!-- Tabla de Detalles -->
                <div class="table-container p-4">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%">#</th>
                                    <th style="width: 40%">Descripción</th>
                                    <th style="width: 15%" class="text-end">Presupuesto</th>
                                    <th style="width: 15%" class="text-end">Cuota</th>
                                    <th style="width: 15%" class="text-center">Tipo</th>
                                    <th style="width: 10%" class="text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    decimal _TotalAmount = 0;
                                }

                                @foreach (var budgetSection in GetSections())
                                {
                                    var sectionItems = _budget.Details
                                    .Where(x => x.IdSection == budgetSection.Id && !x.IsHeader)
                                    .ToList();

                                    @if (sectionItems.Any())
                                    {
                                        <!-- Section Header -->
                                        <tr class="section-header">
                                            <td colspan="6" class="bg-light">
                                                <div class="d-flex align-items-center py-2">
                                                    <i class="bi bi-folder me-2 text-primary"></i>
                                                    <strong class="text-primary">@budgetSection.Name</strong>
                                                    <span class="badge bg-secondary ms-2">
                                                        @sectionItems.Count items
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>

                                        @foreach (var item in sectionItems)
                                        {
                                            var itemAmount = CalculateQuote(item);
                                            _TotalAmount += itemAmount;

                                            <tr class="item-row">
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">@item.ItemNumber</span>
                                                </td>
                                                <td>
                                                    <div class="item-description">
                                                        <strong>@item.Description</strong>
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <span class="budget-amount">S/ @item.MonthlyAmount.ToString("N2")</span>
                                                </td>
                                                <td class="text-end">
                                                    <span class="quote-amount fw-bold">S/ @itemAmount.ToString("N2")</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @GetTypeBadgeClass(item.Type)">
                                                        @GetDistributionType(item.Type)
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <i class="bi bi-check-circle text-success"></i>
                                                </td>
                                            </tr>

                                            @if (item.IdCategory == ParameterService.CurrentBuilding!.Configuration.WaterReadingDefault)
                                            {
                                                var waterReading = _waterReadings?
                                                .FirstOrDefault(c => c.IdGroupUnit == _installment!.IdGroupUnit);

                                                if (waterReading != null)
                                                {
                                                    _TotalAmount += waterReading.CalculatedAmount;

                                                    <tr class="water-reading-row bg-info-subtle">
                                                        <td></td>
                                                        <td colspan="2">
                                                            <div class="water-consumption">
                                                                <h6 class="mb-2"><i class="bi bi-droplet-fill me-2"></i>Consumo de Agua</h6>
                                                                <div class="row">
                                                                    <div class="col-4">
                                                                        <small class="text-muted">Lectura Anterior</small>
                                                                        <p class="fw-bold mb-0">@waterReading.PreviousReading</p>
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <small class="text-muted">Lectura Actual</small>
                                                                        <p class="fw-bold mb-0">@waterReading.CurrentReading</p>
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <small class="text-muted">Consumo</small>
                                                                        <p class="fw-bold mb-0">@waterReading.Consumption m³</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="text-end" valign="middle">
                                                            <span class="water-amount fw-bold">
                                                                S/ @waterReading.CalculatedAmount.ToString("N2")
                                                            </span>
                                                        </td>
                                                        <td class="text-center" valign="middle">
                                                            <span class="badge bg-info">
                                                                <i class="bi bi-droplet-fill me-1"></i>Agua
                                                            </span>
                                                        </td>
                                                        <td></td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold py-3">
                                        <i class="bi bi-calculator me-2"></i>TOTAL CUOTA ORDINARIA:
                                    </td>
                                    <td class="text-end py-3">
                                        <span class="total-amount fs-5 fw-bold text-primary">
                                            S/ @_TotalAmount.ToString("N2")
                                        </span>
                                    </td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }

            @* Cuotas Extraordinarias / Multas / Mora asociadas a esta misma unidad —
               solo aplica cuando se ve el detalle de una cuota Ordinaria (ShowAsync las
               carga vía ExtraChargeService.GetCargosAdicionalesAsync); se listan aparte
               del desglose de arriba y se suman a un Total General. *@
            @if (_cargosAdicionales.Any())
            {
                <div class="table-container px-4 pb-4">
                    <h6 class="mb-2"><i class="bi bi-plus-circle me-1"></i>Cuotas Extraordinarias, Multas y Mora</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%">Tipo</th>
                                    <th>Concepto</th>
                                    <th style="width: 20%" class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cargo in _cargosAdicionales)
                                {
                                    <tr>
                                        <td><span class="@TipoBadgeClass(cargo)">@TipoBadgeText(cargo)</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(cargo.Concept) ? TipoBadgeText(cargo) : cargo.Concept)</td>
                                        <td class="text-end">S/ @cargo.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="2" class="text-end fw-bold py-2">Total Adicionales:</td>
                                    <td class="text-end fw-bold py-2">S/ @_cargosAdicionales.Sum(c => c.Amount).ToString("N2")</td>
                                </tr>
                                <tr class="table-primary">
                                    <td colspan="2" class="text-end fw-bold py-3">
                                        <i class="bi bi-calculator me-2"></i>TOTAL GENERAL (Ordinaria + Adicionales):
                                    </td>
                                    <td class="text-end py-3">
                                        <span class="fs-5 fw-bold">
                                            S/ @((_installment!.Amount + _cargosAdicionales.Sum(c => c.Amount)).ToString("N2"))
                                        </span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }

            @if (ExtraContent != null)
            {
                <div class="p-4 pt-0">
                    @ExtraContent
                </div>
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="modal-footer bg-light">
            <button class="btn btn-secondary" @onclick="() => _modal.HideAsync()">
                <i class="bi bi-x-lg me-1"></i>Cerrar
            </button>
            <button class="btn btn-outline-primary" @onclick="HandleImprimirClick">
                <i class="bi bi-printer me-1"></i>Imprimir
            </button>
            <button class="btn btn-primary" @onclick="HandleEnviarClick">
                <i class="bi bi-send me-1"></i>Enviar al Propietario
            </button>
        </div>
    </FooterTemplate>
</Modal>

@code {
    // Contenido extra que agrega el llamador debajo del desglose (ej. la sección
    // "Transacción asociada" que muestra ListadoCuotas.razor).
    [Parameter] public RenderFragment? ExtraContent { get; set; }

    // Ninguno de los dos tiene implementación real todavía (ver PrintSingleInstallment/
    // SendToOwner original en InstallmentTable.razor) — quien use el modal decide si los
    // conecta a algo; si no hay handler, el botón simplemente no hace nada.
    [Parameter] public EventCallback<Installment> OnImprimir { get; set; }
    [Parameter] public EventCallback<Installment> OnEnviarAlPropietario { get; set; }

    private string TipoBadgeClass(Installment? item) => item?.Type switch
    {
        InstallmentType.Extraordinaria => "badge bg-primary",
        InstallmentType.Multa => "badge bg-danger",
        InstallmentType.Mora => "badge bg-warning text-dark",
        _ => "badge bg-secondary"
    };

    private string TipoBadgeText(Installment? item) => item?.Type switch
    {
        InstallmentType.Extraordinaria => "Extraordinaria",
        InstallmentType.Multa => "Multa",
        InstallmentType.Mora => "Mora",
        _ => "Ordinaria"
    };

    private Modal _modal = null!;
    private Installment? _installment;
    private BudgetHeader? _budget;
    private List<ServiceReadingDetail>? _waterReadings;
    private List<Exoneration> _exonerations = new();
    // Cuotas Extraordinarias/Multas/Mora de esta misma unidad — vacía salvo cuando el
    // detalle mostrado es de una cuota Ordinaria (ver ShowAsync).
    private List<Installment> _cargosAdicionales = new();

    private decimal _distr;
    private int _waterReadingsCount;
    private decimal _inverseNroGroupUnit;
    private decimal _totalWaterConsumption => _waterReadings?.Sum(w => w.CalculatedAmount) ?? 0;

    // Unidades que componen el grupo (DPTO + cochera + depósito, etc.) — el Área Total de
    // arriba es la suma de todas, así que se listan para que sea informativo de dónde sale.
    private List<OwnerUnitView> _unidadesGrupo = new();

    // Modal (BlazorBootstrap) solo pinta el header a partir de Title — un HeaderTemplate
    // custom se ignora — así que el DPTO va acá.
    private string TituloModal => _installment != null
        ? $"Detalle de Cuota - DPTO {_installment.UnitName}"
        : "Detalle de Cuota";

    public async Task ShowAsync(
        Installment installment,
        BudgetHeader? budget,
        List<ServiceReadingDetail>? waterReadings,
        List<Exoneration>? exonerations)
    {
        _installment = installment;
        _budget = budget;
        _waterReadings = waterReadings;
        _exonerations = exonerations ?? new();

        _distr = installment.Percent / 100;
        _waterReadingsCount = waterReadings?.Count ?? 0;
        _inverseNroGroupUnit = ParameterService.CurrentBuilding!.Apartments > 0
            ? 1m / ParameterService.CurrentBuilding.Apartments
            : 0;

        _unidadesGrupo = new();
        _cargosAdicionales = new();
        if (ParameterService.CurrentBuilding != null)
        {
            // Misma fuente que Owners.razor (Residentes): una fila por unidad del grupo,
            // Role == 1 evita traer una fila repetida por cada propietario asociado.
            var unidadesDelEdificio = await BuildingService.GetOwnersByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);
            _unidadesGrupo = unidadesDelEdificio
                .Where(u => u.IdGroupUnit == installment.IdGroupUnit && u.Role == 1)
                .OrderBy(u => u.TypeUnit)
                .ToList();

            if (installment.Type == InstallmentType.Ordinaria)
            {
                _cargosAdicionales = await ExtraChargeService.GetCargosAdicionalesAsync(
                    ParameterService.CurrentBuilding.IdBuilding, new List<Installment> { installment });
            }
        }

        await _modal.ShowAsync();
    }

    public Task HideAsync() => _modal.HideAsync();

    private string GetUnitTypeBadge(int tipoUnidad) => tipoUnidad switch
    {
        1 => "bg-primary",
        2 => "bg-success",
        3 => "bg-warning",
        4 => "bg-info",
        _ => "bg-secondary"
    };

    private List<SectionInfo> GetSections()
    {
        if (_budget?.Details == null)
        {
            return new();
        }

        return _budget.Details
            .Where(x => x.IsHeader)
            .Select(x => new SectionInfo { Id = x.IdSection, Name = x.Description, IdCategory = x.IdCategory })
            .OrderBy(x => x.Id)
            .ToList();
    }

    // Misma fórmula que el CalculateQuote original de InstallmentTable.razor.
    private decimal CalculateQuote(BudgetDetail item)
    {
        if (_installment == null)
        {
            return 0;
        }

        if (item.IdCategory == ParameterService.CurrentBuilding!.Configuration.WaterReadingDefault && _waterReadingsCount > 0)
        {
            return Math.Round(Math.Abs(item.MonthlyAmount - _totalWaterConsumption) * _inverseNroGroupUnit, 2);
        }

        var idGroupUnitExonerado = _exonerations
            .Where(c => c.IdCategory == item.IdCategory)
            .Select(c => c.IdGroupUnit)
            .FirstOrDefault();

        if (_installment.IdGroupUnit == idGroupUnitExonerado)
        {
            return 0;
        }

        var nroExcepciones = _exonerations.Count(c => c.IdCategory == item.IdCategory);
        var total = item.Type == 1
            ? item.MonthlyAmount / (ParameterService.CurrentBuilding.Apartments - nroExcepciones)
            : item.MonthlyAmount * _distr;

        return Math.Round(total, 2);
    }

    private string GetTypeBadgeClass(int type) => type switch
    {
        1 => "type-1",
        2 => "type-2",
        3 => "type-3",
        4 => "type-4",
        _ => "bg-secondary"
    };

    private string GetDistributionType(int value) => ParameterService.GetChildParameterDescription(8, value);

    private async Task HandleImprimirClick()
    {
        if (_installment != null && OnImprimir.HasDelegate)
        {
            await OnImprimir.InvokeAsync(_installment);
        }
    }

    private async Task HandleEnviarClick()
    {
        if (_installment != null && OnEnviarAlPropietario.HasDelegate)
        {
            await OnEnviarAlPropietario.InvokeAsync(_installment);
        }
    }
}