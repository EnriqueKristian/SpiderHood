@using SpiderHood.Utilities
@typeparam T where T : class

 <!-- Paginación -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        <span class="text-muted">
                            @_pagination.GetPaginationInfo()
                        </span>
                    </div>
        
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(_pagination.CurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="_pagination.GoToFirstPage" title="Primera">
                                    «
                                </button>
                            </li>
                
                            <li class="page-item @(_pagination.CurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="_pagination.GoToPreviousPage" title="Anterior">
                                    ‹
                                </button>
                            </li>
                
                            @foreach (var page in _pagination.GetPageNumbers())
                            {
                                @if (page == -1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item @(page == _pagination.CurrentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => _pagination.GoToPage(page)">
                                            @(page)
                                        </button>
                                    </li>
                                }
                            }
                
                            <li class="page-item @(_pagination.CurrentPage == _pagination.TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="_pagination.GoToNextPage" title="Siguiente">
                                    ›
                                </button>
                            </li>
                
                            <li class="page-item @(_pagination.CurrentPage == _pagination.TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="_pagination.GoToLastPage" title="Última">
                                    »
                                </button>
                            </li>
                        </ul>
                    </nav>
                </div>

@code {
    [Parameter]
    public PaginationClass<T> _pagination { get; set; }
}