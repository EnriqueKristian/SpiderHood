@if (IsVisible)
{
    <div class="progress-bar-overlay">
        <div class="progress-bar-container">
            <h5 class="mb-3">@Title</h5>

            <div class="progress mb-3" style="height: 20px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: @(Progress)%"
                     aria-valuenow="@Progress"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    @Progress%
                </div>
            </div>

            <div class="progress-details">
                <small class="text-muted">@CurrentItem</small>
                <br />
                <small class="text-muted">@ItemsProcessed de @TotalItems procesados</small>
            </div>

            @if (ShowCancelButton)
            {
                <div class="mt-3">
                    <button @onclick="OnCancel" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Procesando...";
    [Parameter] public int Progress { get; set; }
    [Parameter] public string CurrentItem { get; set; } = "";
    [Parameter] public int ItemsProcessed { get; set; }
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public bool ShowCancelButton { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}