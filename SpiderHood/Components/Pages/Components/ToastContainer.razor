@inject Services.ToastService ToastService

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    @foreach (var toast in _toasts)
    {
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-@toast.Type.ToString().ToLower() text-white">
                <i class="@GetIcon(toast.Type) me-2"></i>
                <strong class="me-auto">@toast.Title</strong>
                <small>@DateTime.Now.ToString("HH:mm")</small>
                <button type="button" class="btn-close btn-close-white ms-2"
                        @onclick="() => RemoveToast(toast.Id)"></button>
            </div>
            <div class="toast-body">
                @toast.Message
            </div>
        </div>
    }
</div>

@code {
    private List<ToastItem> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private void ShowToast(Models.ToastMessage message)
    {
        var toast = new ToastItem
        {
            Id = Guid.NewGuid(),
            Title = message.Title,
            Message = message.Message,
            Type = message.Type
        };

        _toasts.Add(toast);
        StateHasChanged();

        // Auto-remover después de la duración
        var timer = new System.Timers.Timer(message.Duration);
        timer.Elapsed += (sender, args) =>
        {
            InvokeAsync(() =>
            {
                RemoveToast(toast.Id);
                timer.Dispose();
            });
        };
        timer.AutoReset = false;
        timer.Start();
    }

    private void RemoveToast(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private string GetIcon(Models.ToastType type) => type switch
    {
        Models.ToastType.Success => "bi bi-check-circle",
        Models.ToastType.Error => "bi bi-exclamation-circle",
        Models.ToastType.Warning => "bi bi-exclamation-triangle",
        Models.ToastType.Info => "bi bi-info-circle",
        _ => "bi bi-bell"
    };

    public class ToastItem : Models.ToastMessage
    {
        public Guid Id { get; set; }
    }
}