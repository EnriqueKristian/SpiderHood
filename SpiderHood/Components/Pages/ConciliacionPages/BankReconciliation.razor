                                    <dt class="col-sm-4">Descripción:</dt>
                                    <dd class="col-sm-8">@transaccionSeleccionada.Description</dd>
                                    
                                    <dt class="col-sm-4">Referencia:</dt>
                                    <dd class="col-sm-8">@transaccionSeleccionada.Reference</dd>
                                    
                                    <dt class="col-sm-4">Monto:</dt>
