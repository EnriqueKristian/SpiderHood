@page "/conciliacion"
@page "/conciliacion/{accountId:int}"
@using SpiderHood.Models
@using SpiderHood.Services
@inject IExpenseService ExpenseService
@inject IBankAccountService BankService
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer
@inject ParameterService ParameterService

<PageTitle>SpiderHood - Conciliación Bancaria</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-file-invoice-dollar me-2"></i>Conciliación Bancaria
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                            <li class="breadcrumb-item"><a href="/finanzas">Finanzas</a></li>
                            <li class="breadcrumb-item active">Conciliación</li>
                        </ol>
                    </nav>
                </div>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" @onclick="ExportarConciliacion">
                        <i class="fas fa-file-export me-1"></i> Exportar
                    </button>
                    <button class="btn btn-primary" @onclick="MostrarModalCargarEstado">
                        <i class="fas fa-upload me-1"></i> Cargar Estado
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <!-- Selector de Cuenta y Período -->
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Cuenta Bancaria</label>
                            <select class="form-select" @onchange="CambiarCuenta">
                                <option value="">Seleccionar cuenta...</option>
                                @foreach (var cuenta in cuentasBancarias)
                                {
                                    <option value="@cuenta.IdBankAccount">@cuenta.BankName (@cuenta.AccountNumber)</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label">Período</label>
                            <select class="form-select" @bind="periodoSeleccionado">
                                <!-- @onchange="CambiarPeriodo"-->
                                <option value="mesActual">Mes Actual</option>
                                <option value="mesAnterior">Mes Anterior</option>
                                <option value="trimestreActual">Trimestre Actual</option>
                                <option value="personalizado">Personalizado</option>
                            </select>
                        </div>
                        
                        @if (periodoSeleccionado == "personalizado")
                        {
                            <div class="col-md-2">
                                <label class="form-label">Desde</label>
                                <input type="date" class="form-control" @bind="fechaDesde" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Hasta</label>
                                <input type="date" class="form-control" @bind="fechaHasta" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Resumen Conciliación</h6>
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-value text-primary">@totalTransacciones</div>
                                <div class="stat-label">Transacciones</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-value @(totalPendiente > 0 ? "text-warning" : "text-success")">
                                    @totalPendiente.ToString("C")
                                </div>
                                <div class="stat-label">Pendiente</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (cuentaSeleccionadaId == Guid.Empty)
    {
        <div class="text-center py-5">
            <i class="fas fa-university fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">Selecciona una cuenta bancaria para comenzar</h5>
            <p class="text-muted">O carga un nuevo estado de cuenta</p>
        </div>
    }
    else if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3">Cargando transacciones...</p>
        </div>
    }
    else
    {
        <!-- Filtros y Búsqueda -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-3 align-items-center">
                                <div class="form-check">
                                    <input class="form-check-input" 
                                           type="checkbox" 
                                           id="showOnlyUnmatched"
                                           @bind="mostrarSoloNoConciliados" />
                                    <label class="form-check-label" for="showOnlyUnmatched">
                                        Mostrar solo no conciliados
                                    </label>
                                </div>
                                
                                <div class="vr"></div>
                                
                                <!--    BOTONES DE FILTRO   -->
                                <div class="btn-group" role="group">
                                    <button class="btn @(filtroTipo == null ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => FiltrarPorTipo(null)">
                                        Todas (@totalTransacciones)
                                    </button>
                                    <button class="btn @(filtroTipo == "Gasto" ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => FiltrarPorTipo(Gasto)">
                                        Gastos (@transacciones.Count(t => t.Tipo == "Gasto"))
                                    </button>
                                    <button class="btn @(filtroTipo == "Ingreso" ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => FiltrarPorTipo(Ingreso)">
                                        Ingresos (@transacciones.Count(t => t.Tipo == "Ingreso"))
                                    </button>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-2">
                                <div class="input-group" style="width: 300px;">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" 
                                           class="form-control" 
                                           placeholder="Buscar descripción, referencia..."
                                           @bind="textoBusqueda"
                                           @bind:event="oninput" />
                                </div>
                                
                                <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pestañas de Transacciones -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "noConciliados" ? "active" : "")" 
                                        @onclick="() => CambiarTab(noConciliados)">
                                    <i class="fas fa-question-circle me-2"></i>
                                    No Conciliados
                                    <span class="badge bg-warning ms-2">@transaccionesNoConciliadas.Count</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "conciliados" ? "active" : "")" 
                                        @onclick="() => CambiarTab(conciliados)">
                                    <i class="fas fa-check-circle me-2"></i>
                                    Conciliados
                                    <span class="badge bg-success ms-2">@transaccionesConciliadas.Count</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "todos" ? "active" : "")" 
                                        @onclick="() => CambiarTab(todos)">
                                    <i class="fas fa-list me-2"></i>
                                    Todas las Transacciones
                                    <span class="badge bg-secondary ms-2">@transacciones.Count</span>
                                </button>
                            </li>
                        </ul>
                        
                        <div class="tab-content">
                            <!-- Tabla de Transacciones -->
                            <div class="table-responsive" style="max-height: 600px;">
                                <table class="table table-hover mb-0">
                                    <thead class="sticky-top bg-white" style="top: 0; z-index: 1;">
                                        <tr>
                                            <th width="40">
                                                <input type="checkbox" 
                                                       class="form-check-input" 
                                                       @onchange="SeleccionarTodosTransacciones">
                                            </th>
                                            <th width="60">Fecha</th>
                                            <th>Descripción</th>
                                            <th width="80">Referencia</th>
                                            <th width="100" class="text-end">Monto</th>
                                            <th width="80">Tipo</th>
                                            <th width="150">Conciliado Con</th>
                                            <th width="100">Estado</th>
                                            <th width="120" class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var transaccion in transaccionesFiltradas)
                                        {
                                            <tr class="@(transaccion.Selected ? "table-primary" : "")">
                                                <td>
                                                    @if (transaccion.ReconciliationStatus == 0)
                                                    {
                                                        <input type="checkbox" 
                                                               class="form-check-input" 
                                                               @bind="transaccion.Selected" />
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark">
                                                        @transaccion.StatementDate.ToString("dd/MM/yy")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                        {
                                                            <i class="fas fa-check-circle text-success me-2"></i>
                                                        }
                                                        <div>
                                                            <div class="fw-bold">@transaccion.Description</div>
                                                            @if (!string.IsNullOrEmpty(transaccion.Notes))
                                                            {
                                                                <small class="text-muted">@transaccion.Notes</small>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <code>@transaccion.Reference</code>
                                                </td>
                                                <td class="text-end fw-bold @(transaccion.Amount  < 0 ? "text-danger" : "text-success")">
                                                    @Math.Abs(transaccion.Amount).ToString("C")
                                                </td>
                                                <td>
                                                    <span class="badge @(transaccion.Amount < 0 ? "bg-danger" : "bg-success")">
                                                        @transaccion.Tipo
                                                    </span>
                                                </td>
                                                <td>
                                                    @if( transaccion.Tipo == "Gasto") { 
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                    {
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-link text-primary me-2"></i>
                                                            <div>
                                                                <div class="small">@transaccion.GastoConciliado?.Category</div>
                                                                <div class="text-muted small">@transaccion.GastoConciliado?.Description</div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (transaccion.PosiblesMatches.Any())
                                                    {
                                                        var gastosIds = new HashSet<Guid>(gastosPendientes.Select(g => g.IdExpense));

                                                        @if(transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)).Count() > 0 ){
                                                            
                                                            <div class="dropdown">
                                                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" 
                                                                        type="button" 
                                                                        data-bs-toggle="dropdown">
                                                                    @transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)).Count() posibles matches
                                                                </button>
                                                                <ul class="dropdown-menu">
                                                                @foreach (var match in transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" 
                                                                            @onclick="() => ConciliarConGasto(transaccion, match)">
                                                                            <div class="d-flex justify-content-between">
                                                                                <span>@match.Category</span>
                                                                                <span class="text-muted">@match.Amount.ToString("C")</span>
                                                                            </div>
                                                                            <small class="text-muted">@match.Description</small>
                                                                        </a>
                                                                    </li>
                                                                }
                                                                </ul>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                        {
                                                            <div class="d-flex align-items-center">
                                                                <i class="fas fa-link text-primary me-2"></i>
                                                                <div>
                                                                    <div class="small">@transaccion.GastoConciliado?.Category</div>
                                                                    <div class="text-muted small">@transaccion.GastoConciliado?.Description</div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (transaccion.IPosiblesMatches.Any())
                                                        {
                                                            var cuotasIds = new HashSet<Guid>(cuotaspendientes.Select(g => g.IdInstallment));

                                                            @if (transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)).Count() > 0)
                                                            {
                                                                <div class="dropdown">
                                                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                                                            type="button"
                                                                            data-bs-toggle="dropdown">
                                                                        @transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)).Count() posibles matches
                                                                    </button>
                                                                    <ul class="dropdown-menu">
                                                                        @foreach (var match in transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)))
                                                                        {
                                                                            <li>
                                                                                <a class="dropdown-item"
                                                                                   @onclick="() => ConciliarConCuota(transaccion, match)">
                                                                                    <div class="d-flex justify-content-between">
                                                                                        <span>@match.OwnerName</span>
                                                                                        <span class="text-muted">@match.Amount.ToString("C")</span>
                                                                                    </div>
                                                                                    <small class="text-muted">@match.Number</small>
                                                                                </a>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">No encontrado</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-check me-1"></i> Conciliado
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">
                                                            <i class="fas fa-clock me-1"></i> Pendiente
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.NoConciliada)
                                                        {
                                                            <button class="btn btn-outline-primary" 
                                                                    title="Conciliar manualmente"
                                                                    @onclick="() => MostrarModalConciliar(transaccion)">
                                                                <i class="fas fa-link"></i>
                                                            </button>
                                                            <button class="btn btn-outline-success" 
                                                                    title="Crear gasto desde transacción"
                                                                    @onclick="() => CrearGastoDesdeTransaccion(transaccion)">
                                                                <i class="fas fa-plus-circle"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-outline-info" 
                                                                title="Ver detalles"
                                                                @onclick="() => VerDetallesTransaccion(transaccion)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                        {
                                                            <button class="btn btn-outline-danger" 
                                                                    title="Desconciliar"
                                                                    @onclick="() => DesconciliarTransaccion(transaccion)">
                                                                <i class="fas fa-unlink"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                
                                @if (!transaccionesFiltradas.Any())
                                {
                                    <div class="text-center py-5">
                                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                                        <h5 class="text-muted">No se encontraron transacciones</h5>
                                        <p class="text-muted">Intenta cambiar los filtros o cargar un nuevo estado de cuenta</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <!-- Pie de tabla con acciones masivas -->
                    @if (transaccionesNoConciliadas.Any(t => t.Selected))
                    {
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted">
                                        @transaccionesNoConciliadas.Count(t => t.Selected) transacciones seleccionadas
                                    </span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary" @onclick="DeseleccionarTodo">
                                        Deseleccionar todo
                                    </button>
                                    <div class="dropdown">
                                        <button class="btn btn-primary dropdown-toggle" 
                                                type="button" 
                                                data-bs-toggle="dropdown">
                                            <i class="fas fa-bolt me-2"></i>Acciones masivas
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item" @onclick="ConciliarSeleccionadas">
                                                    <i class="fas fa-link me-2"></i>Conciliar seleccionadas
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" @onclick="GenerarGastosSeleccionados">
                                                    <i class="fas fa-plus-circle me-2"></i>Generar gastos
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" @onclick="IgnorarSeleccionadas">
                                                    <i class="fas fa-ban me-2"></i>Ignorar transacciones
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                
                </div>
            </div>
        </div>

        <!-- Panel de Resumen -->
        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Resumen de Conciliación</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Estado Actual</h6>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Saldo Inicial:</span>
                                        <span class="fw-bold">@saldoInicial.ToString("C")</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Total Gastos:</span>
                                        <span class="fw-bold text-danger">@totalGastos.ToString("C")</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Total Ingresos:</span>
                                        <span class="fw-bold text-success">@totalIngresos.ToString("C")</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Saldo Final (Calculado):</span>
                                        <span class="fw-bold @(saldoFinalCalculado < 0 ? "text-danger" : "text-success")">
                                            @saldoFinalCalculado.ToString("C")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <h6>Conciliación</h6>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Conciliados:</span>
                                        <span class="badge bg-success">@transaccionesConciliadas.Count</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Pendientes:</span>
                                        <span class="badge bg-warning">@transaccionesNoConciliadas.Count</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Coincidencias encontradas:</span>
                                        <span class="badge bg-info">@totalCoincidencias</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Diferencia:</span>
                                        <span class="fw-bold @(diferenciaConciliacion < 0 ? "text-danger" : "text-success")">
                                            @diferenciaConciliacion.ToString("C")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-4">
                            <div class="progress" style="height: 25px;">
                                @{
                                    var porcentajeConciliado = totalTransacciones > 0 ? 
                                        (transaccionesConciliadas.Count * 100 / totalTransacciones) : 0;
                                }
                                <div class="progress-bar bg-success" 
                                     role="progressbar" 
                                     style="width: @porcentajeConciliado%">
                                    @porcentajeConciliado% Conciliado
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Acciones Rápidas</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-success" @onclick="FinalizarConciliacion">
                                <i class="fas fa-check-double me-2"></i>Finalizar Conciliación
                            </button>
                            <button class="btn btn-outline-primary" @onclick="BuscarCoincidenciasAutomaticas">
                                <i class="fas fa-search me-2"></i>Buscar Coincidencias Automáticas
                            </button>
                            <button class="btn btn-outline-warning" @onclick="MostrarReporteDiferencias">
                                <i class="fas fa-chart-bar me-2"></i>Ver Reporte de Diferencias
                            </button>
                        </div>
                        
                        <hr />
                        
                        <div class="mt-3">
                            <h6>Última Conciliación</h6>
                            @if (ultimaConciliacion != null)
                            {
                                <div class="alert alert-info">
