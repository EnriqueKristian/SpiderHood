@code {
    [Parameter]
    public Guid AccountId { get; set; }

    [Inject]
    public ICategoryService CategoryService { get; set; } = default!;

    [Inject]
    public IBudgetService BudgetService { get; set; } = default!;

    [Inject]
    public InstallmentService InstallmentService { get; set; } = default!;

    // Servicios y datos
    private List<BankAccount> cuentasBancarias = new();
    private List<TransactionBankDetail> transacciones = new();
    public List<ViewExpense> gastosPendientes = new();
    public List<Installment> cuotaspendientes = new();
    private List<TransactionBankDetail> transaccionesPendientes = new();
    private List<Models.Category> FilteredCategory = new();

    // Filtros y estado
    private Guid cuentaSeleccionadaId = Guid.Empty;
    private string periodoSeleccionado = "mesActual";
    private DateTime fechaDesde = DateTime.Now.AddMonths(-1);
    private DateTime fechaHasta = DateTime.Now;
    private string tabActiva = "noConciliados";
    private bool mostrarSoloNoConciliados = true;
    private string? filtroTipo = null;
    private string textoBusqueda = "";
    private bool seleccionarTodos = false;
    private bool cargando = false;

    // Modales
    private bool mostrarModalCargarEstado = false;
    private bool mostrarModalConciliar = false;
    private bool mostrarModalCrearGasto = false;
    private TransactionBankDetail? transaccionSeleccionada = null;
    private TransactionBankDetail? transaccionParaGasto = null;
    private List<ViewExpense> gastosParaConciliar = new();

    // Mensajes
    private string? mensajeExito = null;
    private string? mensajeError = null;

    // Estadísticas
    private decimal saldoInicial = 0;
    private decimal saldoFinalCalculado = 0;
    private decimal totalGastos = 0;
    private decimal totalIngresos = 0;
    private decimal diferenciaConciliacion = 0;
    private decimal totalPendiente = 0;
    private int totalTransacciones = 0;
    private int totalCoincidencias = 0;
    private int totalCoincidenciasI = 0;
    private Conciliacion? ultimaConciliacion = null;

    private string conciliados = "conciliados";
    private string noConciliados = "noConciliados";
    private string todos = "todos";
    private string Gasto = "Gasto";
    private string Ingreso = "Ingreso";

    // Propiedades calculadas
    private List<TransactionBankDetail> transaccionesFiltradas => GetTransaccionesFiltradas();
    private List<TransactionBankDetail> transaccionesConciliadas =>
        transacciones.Where(t => t.ReconciliationStatus == ConcilationType.Conciliada).ToList();
    private List<TransactionBankDetail> transaccionesNoConciliadas =>
        transacciones.Where(t => t.ReconciliationStatus == ConcilationType.NoConciliada).ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosIniciales();
        //AccountId = 1;

        if (AccountId != Guid.Empty)
        {
            cuentaSeleccionadaId = AccountId;
            await CargarTransacciones();
        }
    }

    private async Task CargarDatosIniciales()
    {
        if (ParameterService.CurrentBuilding == null) return;

        cargando = true;

        try
        {
            // Cargar cuentas bancarias
            cuentasBancarias = await BankService.ObtenerCuentasBancariasAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Cargar categorías de gastos
            //categoriasGastos = await ExpenseService.ObtenerCategoriasAsync();

            // Cargar última conciliación
            ultimaConciliacion = await BankService.ObtenerUltimaConciliacionAsync();

            FilteredCategory = await CategoryService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarTransacciones()
    {
        cargando = true;

        try
        {
            // Cargar transacciones del período seleccionado
            var (fechaInicio, fechaFin) = ObtenerFechasPeriodo();
            transacciones = await BankService.ObtenerTransaccionesAsync(cuentaSeleccionadaId, fechaInicio, fechaFin);

            // Cargar gastos pendientes del mismo período
            gastosPendientes = await ExpenseService.ObtenerGastosPendientesConciliacionAsync( ParameterService.CurrentBuilding.IdBuilding, fechaInicio, fechaFin);

            // Cargar Cuotas pendientes del mismo período
            cuotaspendientes = await InstallmentService.GetPendingInstallmentsAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Buscar coincidencias automáticas
            await BuscarCoincidencias();

            // Calcular estadísticas
            CalcularEstadisticas();

            mensajeExito = $"Cargadas {transacciones.Count} transacciones";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar transacciones: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarCoincidencias()
    {
        totalCoincidencias = 0;
        totalCoincidenciasI = 0;

        foreach (var transaccion in transacciones.Where(t => t.ReconciliationStatus == ConcilationType.NoConciliada && t.Amount < 0))
        {
            // Buscar gastos con monto similar (±10%)
            var montoTransaccion = Math.Abs(transaccion.Amount);
            var posiblesMatches = gastosPendientes
                .Where(g => Math.Abs(g.Amount - montoTransaccion) / montoTransaccion <= 0.1m)
                .OrderBy(g => Math.Abs(g.Amount - montoTransaccion))
                .Take(3)
                .ToList();

            transaccion.PosiblesMatches = posiblesMatches;

            // Si hay coincidencia exacta, conciliar automáticamente
            //Colocar logica cuando haay mas de 2
            var matchExacto = posiblesMatches.FirstOrDefault(g => g.Amount == montoTransaccion);
            if (matchExacto != null)
            {
                await ConciliarConGasto(transaccion, matchExacto, automatico: true);
            }

            totalCoincidencias += posiblesMatches.Count;
        }

        foreach (var transaccion in transacciones.Where(t => t.ReconciliationStatus == ConcilationType.NoConciliada && t.Amount > 0))
        {
            // Buscar gastos con monto similar (±10%)
            var montoTransaccion = Math.Abs(transaccion.Amount);
            var posiblesMatches = cuotaspendientes
                .Where(g => Math.Abs(g.Amount - montoTransaccion) / montoTransaccion <= 0.1m)
                .OrderBy(g => Math.Abs(g.Amount - montoTransaccion))
                .Take(3)
                .ToList();

            transaccion.IPosiblesMatches = posiblesMatches;

            // Si hay coincidencia exacta, conciliar automáticamente
            //Colocar logica cuando haay mas de 2
            var matchExacto = posiblesMatches.FirstOrDefault(g => g.Amount == montoTransaccion);
            if (matchExacto != null)
            {
                await ConciliarConCuota(transaccion, matchExacto, automatico: true);
            }

            totalCoincidenciasI += posiblesMatches.Count;
        }
    }

    private async Task ConciliarConGasto(TransactionBankDetail transaccion, ViewExpense gasto, bool automatico = false)
    {
        try
        {
            // Conciliar transacción con gasto
            transaccion.ReconciliationStatus = ConcilationType.Conciliada;
            transaccion.GastoConciliado = gasto;
            transaccion.ReconciliationDate = DateTime.Now;

            // Marcar gasto como conciliado
            gasto.Reconciled = true;
            gasto.ReconciledTransactionId = transaccion.IdStatementDetail;
            gasto.AutoReconcile = automatico;

            // Actualizar en base de datos
            //await BankService.ConciliarTransaccionAsync(transaccion.IdStatementDetail, gasto.IdExpense);
            //await ExpenseService.MarcarGastoComoConciliadoAsync(gasto.IdExpense, transaccion.IdStatementDetail);

            // Remover de listas pendientes
            gastosPendientes.Remove(gasto);

            // Recalcular estadísticas
            CalcularEstadisticas();

            if (!automatico)
            {
                mensajeExito = $"Transacción conciliada con gasto: {gasto.Description}";
                CerrarModalConciliar();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al conciliar: {ex.Message}";
        }
    }

    private async Task ConciliarConCuota(TransactionBankDetail transaccion, Installment cuota, bool automatico = false)
    {
        try
        {
            // Validaciones iniciales
            if (transaccion == null) throw new ArgumentNullException(nameof(transaccion));
            if (cuota == null) throw new ArgumentNullException(nameof(cuota));

            // Calcular saldo pendiente de la cuota
            var saldoCuotaPendiente = cuota.Amount - cuota.Paids?.Sum(p => p.Amount) ?? 0;
            var montoTransaccion = Math.Abs(transaccion.Amount);

            // Caso 1: Montos iguales - Conciliación total
            if (Math.Abs(montoTransaccion - saldoCuotaPendiente) < 0.01m)
            {
                await ConciliarTotalmente(transaccion, cuota, montoTransaccion, automatico);
            }
            // Caso 2: Transacción menor a cuota - Conciliación parcial
            else if (montoTransaccion < saldoCuotaPendiente)
            {
                await ConciliarParcialmente(transaccion, cuota, montoTransaccion, automatico);
            }
            // Caso 3: Transacción mayor a cuota - Conciliación con sobrante
            else
            {
                await ConciliarConSobrante(transaccion, cuota, saldoCuotaPendiente, automatico);
            }

            // Actualizar UI y estado
            await ActualizarEstadoPostConciliacion(automatico);
        }
        catch (Exception ex)
        {
            await ManejarErrorConciliacion(ex);
        }
    }

    private async Task ConciliarTotalmente(TransactionBankDetail transaccion, Installment cuota, decimal monto, bool automatico)
    {
        // Crear registro de pago
        var pago = new InstallmentPaid
        {
            IdInstallment = cuota.IdInstallment,
            Amount = monto,
            PaymentDate = DateTime.Now,
            IdTransaction = transaccion.IdStatementDetail,
            IsAutoReconcile = automatico
        };

        // Actualizar estado de la transacción
        transaccion.ReconciliationStatus = ConcilationType.Conciliada;

        //transaccion.IdInstallment = cuota.IdInstallment;

        transaccion.ReconciliationDate = DateTime.Now;

        // Actualizar estado de la cuota
        cuota.Reconciled = true;
        cuota.ReconciledTransactionId = transaccion.IdStatementDetail;
        cuota.AutoReconcile = automatico;

        // Guardar en base de datos
        await InstallmentService.AgregarPagoAsync(pago);
        //await BankService.ConciliarTransaccionAsync(transaccion, cuota);
    }

    private async Task ConciliarParcialmente(TransactionBankDetail transaccion, Installment cuota, decimal monto, bool automatico)
    {
        // Crear registro de pago parcial
        var pagoParcial = new InstallmentPaid
        {
            IdPaid = Guid.NewGuid(),
            IdInstallment = cuota.IdInstallment,
            Amount = monto,
            PaymentDate = DateTime.Now,
            IdTransaction = transaccion.IdStatementDetail,
            IsAutoReconcile = automatico,
            IsPartialPayment = true,
            Status = ConcilationType.Conciliada
        };

        // Actualizar estado de la transacción (totalmente conciliada)
        transaccion.ReconciliationStatus = ConcilationType.Conciliada;
        //transaccion.IdInstallment = cuota.IdInstallment;
        transaccion.ReconciliationDate = DateTime.Now;

        // Cuota queda parcialmente pagada (no marcamos como Reconciled = true)
        cuota.LastPartialPaymentDate = DateTime.Now;
        cuota.AutoReconcile = automatico;
        cuota.Status = ConcilationType.Parcial;

        // Guardar en base de datos
        await InstallmentService.AgregarPagoAsync(pagoParcial);
        //await BankService.ConciliarTransaccionAsync(transaccion, cuota);
    }

    private async Task ConciliarConSobrante(TransactionBankDetail transaccion, Installment cuota, decimal saldoCuota, bool automatico)
    {
        // 1. Conciliar el saldo pendiente de la cuota
        var pagoCompleto = new InstallmentPaid
        {
            IdPaid = Guid.NewGuid(),
            IdInstallment = cuota.IdInstallment,
            Amount = saldoCuota,
            PaymentDate = DateTime.Now,
            IdTransaction = transaccion.IdStatementDetail,
            IsAutoReconcile = automatico,
            Status = ConcilationType.Conciliada
        };

        // 2. Actualizar cuota como totalmente conciliada
        transaccion.ReconciliationStatus = ConcilationType.Parcial;
        //transaccion.IdInstallment = cuota.IdInstallment;
        transaccion.ReconciliationDate = DateTime.Now;
        cuota.Status = ConcilationType.Conciliada;

        cuota.Reconciled = true;
        cuota.ReconciledTransactionId = transaccion.IdStatementDetail;
        cuota.AutoReconcile = automatico;

        // 3. Crear transacción sobrante
        var montoSobrante = Math.Abs(transaccion.Amount) - saldoCuota;
        var transaccionSobrante = new TransactionBankDetail
        {
            Amount = transaccion.Amount > 0 ? montoSobrante : -montoSobrante,
            StatementDate = transaccion.StatementDate,
            Description = $"Sobrante de conciliación: {transaccion.Description}",
            //OriginalDescription = transaccion.OriginalDescription,
            ReconciliationStatus = ConcilationType.NoConciliada,
            IdStatementHeader = transaccion.IdStatementHeader,
            IdStatementDetail = Guid.NewGuid(), // Nuevo ID para la transacción sobrante
            IdParent = transaccion.IdStatementDetail,
            Origen = TransactionOrigen.ExcessPayment,
            SequenceNumber = transaccion.SequenceNumber + 1,
            Currency = transaccion.Currency
            // Copiar otras propiedades relevantes
        };

        // 4. Guardar en base de datos
        await InstallmentService.AgregarPagoAsync(pagoCompleto);
        //await BankService.ConciliarTransaccionAsync(transaccion, cuota);
        //await BankService.CrearTransaccionSobranteAsync(transaccionSobrante);

        // 5. Agregar transacción sobrante a la lista pendiente
        transaccionesPendientes.Add(transaccionSobrante);
        transacciones.Add(transaccionSobrante);
    }

    private async Task ActualizarEstadoPostConciliacion(bool automatico)
    {
        // Recalcular estadísticas
        CalcularEstadisticas();

        // Actualizar listas pendientes
        await ActualizarListasPendientes();

        // Cerrar modal si no es automático
        if (!automatico)
        {
            CerrarModalConciliar();
            // Mostrar mensaje de éxito
            MostrarMensajeExito("Transacción conciliada exitosamente");
        }

        // Forzar actualización de UI
        StateHasChanged();
    }

    private async Task ActualizarListasPendientes()
    {
        // Remover transacción conciliada de pendientes
        var transaccionConciliada = transaccionesPendientes
            .FirstOrDefault(t => t.ReconciliationStatus == ConcilationType.Conciliada);

        if (transaccionConciliada != null)
        {
            transaccionesPendientes.Remove(transaccionConciliada);
        }

        // Opcional: Recargar cuotas pendientes desde el servidor
        // cuotaspendientes = await InstallmentService.ObtenerCuotasPendientesAsync();
    }

    private async Task ManejarErrorConciliacion(Exception ex)
    {
        // Log del error
        //logger.LogError(ex, "Error al conciliar transacción con cuota");

        // Mostrar mensaje al usuario
        mensajeError = $"Error al conciliar: {ex.Message}";

        // Opcional: Revertir cambios si es necesario
        await RevertirCambiosEnCasoDeError();

        // Forzar actualización de UI
        StateHasChanged();
    }

    private async Task RevertirCambiosEnCasoDeError()
    {
        try
        {
            // Implementar lógica de rollback si es necesario
            // Esto depende de cómo maneje tu aplicación las transacciones
        }
        catch (Exception rollbackEx)
        {
            //logger.LogError(rollbackEx, "Error al revertir cambios después de falla en conciliación");
        }
    }

    private void MostrarMensajeExito(string mensaje)
    {
        // Usar toast, snackbar o modal de éxito según tu UI framework
        // Ejemplo con Blazor: mostrar componente de notificación
    }

    private async Task DesconciliarTransaccion(TransactionBankDetail transaccion)
    {
        if (transaccion.GastoConciliado == null) return;

        if (await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Desconciliar transacción '{transaccion.Description}' con gasto '{transaccion.GastoConciliado.Description}'?"))
        {
            try
            {
                // Desconciliar
                transaccion.ReconciliationStatus = ConcilationType.NoConciliada;
                transaccion.GastoConciliado.Reconciled = false;
                transaccion.GastoConciliado.ReconciledTransactionId = null;

                // Agregar gasto de vuelta a pendientes
                gastosPendientes.Add(transaccion.GastoConciliado);
                //transaccion.GastoConciliado = null;

                // Actualizar en base de datos
                //await BankService.DesconciliarTransaccionAsync(transaccion.IdStatementDetail);
                //await ExpenseService.DesconciliarGastoAsync(transaccion.GastoConciliado?.IdExpense ?? Guid.Empty);

                mensajeExito = "Transacción desconciliada";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                mensajeError = $"Error al desconciliar: {ex.Message}";
            }
        }
    }

    private void MostrarModalConciliar(TransactionBankDetail transaccion)
    {
        transaccionSeleccionada = transaccion;

        // Filtrar gastos pendientes para esta transacción
        gastosParaConciliar = gastosPendientes
            .Where(g => Math.Abs(g.Amount - Math.Abs(transaccion.Amount)) / Math.Abs(transaccion.Amount) <= 0.2m)
            .OrderBy(g => Math.Abs(g.Amount - Math.Abs(transaccion.Amount)))
            .ToList();

        //gastosParaConciliar = gastosPendientes;

        mostrarModalConciliar = true;
    }

    private void CerrarModalConciliar()
    {
        mostrarModalConciliar = false;
        transaccionSeleccionada = null;
        gastosParaConciliar.Clear();
    }

    private void CrearGastoDesdeTransaccion(TransactionBankDetail transaccion)
    {
        transaccionParaGasto = transaccion;
        mostrarModalCrearGasto = true;
    }

    private void CerrarModalCrearGasto()
    {
        mostrarModalCrearGasto = false;
        transaccionParaGasto = null;
    }

    private async Task GastoCreadoExitosamente(ViewExpense nuevoGasto)
    {
        nuevoGasto.IdBuilding = ParameterService.CurrentBuilding.IdBuilding;
        await ParameterService.ec.AddNewRecordAsync(nuevoGasto);

        // Conciliar automáticamente con la transacción
        if (transaccionParaGasto != null)
        {
            await ConciliarConGasto(transaccionParaGasto, nuevoGasto);
        }

        CerrarModalCrearGasto();
        mensajeExito = "Gasto creado y conciliado exitosamente";
    }

    private async Task GenerarGastosSeleccionados()
    {
        var transaccionesSeleccionadas = transaccionesNoConciliadas.Where(t => t.Selected).ToList();

        if (!transaccionesSeleccionadas.Any())
        {
            mensajeError = "No hay transacciones seleccionadas";
            return;
        }

        // Aquí se podría abrir un modal para crear múltiples gastos a la vez
        // Por ahora, crear uno por uno
        foreach (var transaccion in transaccionesSeleccionadas)
        {
            // Crear gasto básico desde transacción
            var nuevoGasto = new ViewExpense
            {
                Description = transaccion.Description,
                Amount = Math.Abs(transaccion.Amount),
                ExpenseDate = transaccion.StatementDate,
                IdCategory = ParameterService.CurrentBuilding.Configuration.DefaultCategory,
                IdBuilding = ParameterService.CurrentBuilding.IdBuilding,
                Distribution = TypeDistribution.Fija,
                Status = StatusExpense.Approved,
                PaymentMethod = PaymentMethod.BankTransfer
                //Reconciled = false
            };

            // Guardar gasto
            var gastoCreado = await ExpenseService.CrearGastoAsync(nuevoGasto);

            // Conciliar
            await ConciliarConGasto(transaccion, gastoCreado);
        }

        DeseleccionarTodo();
        mensajeExito = $"Se generaron {transaccionesSeleccionadas.Count} gastos nuevos";
    }

    private async Task ConciliarSeleccionadas()
    {
        var transaccionesSeleccionadas = transaccionesNoConciliadas.Where(t => t.Selected).ToList();

        if (!transaccionesSeleccionadas.Any())
        {
            mensajeError = "No hay transacciones seleccionadas";
            return;
        }

        // Conciliar con el primer match disponible
        foreach (var transaccion in transaccionesSeleccionadas)
        {
            if (transaccion.PosiblesMatches.Any())
            {
                await ConciliarConGasto(transaccion, transaccion.PosiblesMatches.First());
            }
        }

        DeseleccionarTodo();
        mensajeExito = $"Conciliadas {transaccionesSeleccionadas.Count} transacciones";
    }

    private async Task IgnorarSeleccionadas()
    {
        var transaccionesSeleccionadas = transaccionesNoConciliadas.Where(t => t.Selected).ToList();

        if (!transaccionesSeleccionadas.Any())
        {
            mensajeError = "No hay transacciones seleccionadas";
            return;
        }

        if (await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Ignorar {transaccionesSeleccionadas.Count} transacciones seleccionadas?"))
        {
            foreach (var transaccion in transaccionesSeleccionadas)
            {
                transaccion.Ignored = true;
                await BankService.MarcarTransaccionComoIgnoradaAsync(transaccion);
            }

            DeseleccionarTodo();
            mensajeExito = $"Se ignoraron {transaccionesSeleccionadas.Count} transacciones";
            StateHasChanged();
        }
    }

    private void SeleccionarTodosTransacciones(ChangeEventArgs e)
    {
        seleccionarTodos = (bool)e.Value; 

