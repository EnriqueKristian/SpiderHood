                                                        <span class="ms-2">@gasto.Supplier</span>
                                                    }
                                                </small>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold @(gasto.Amount < 0 ? "text-danger" : "text-success")">
                                                    @Math.Abs(gasto.Amount).ToString("C")
                                                </div>
                                                <small class="text-muted">
                                                    @gasto.ExpenseDate.ToString("dd/MM/yy")
                                                </small>
                                            </div>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                No se encontraron gastos pendientes de conciliar
                            </div>
                        }
                        
                        <div class="text-center mt-3">
