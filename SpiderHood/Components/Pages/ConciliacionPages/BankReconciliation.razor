    private async Task EstadoCuentaCargado(List<TransactionBankDetail> nuevasTransacciones)
    {
        if (cuentaSeleccionadaId == Guid.Empty && cuentasBancarias.Any())
        {
            cuentaSeleccionadaId = cuentasBancarias.First().IdBankAccount;
        }

        // Agregar nuevas transacciones
        transacciones.AddRange(nuevasTransacciones);

        // Buscar coincidencias con las nuevas transacciones
        await BuscarCoincidencias();

        // Recalcular estadísticas
        CalcularEstadisticas();

        mensajeExito = $"Se cargaron {nuevasTransacciones.Count} nuevas transacciones";
        CerrarModalCargarEstado();
    }

