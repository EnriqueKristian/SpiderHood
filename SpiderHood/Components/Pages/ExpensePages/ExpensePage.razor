@page "/expense"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@using SpiderHood.Components.Pages.Components
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@inject SpiderHood.Services.AuthService AuthService
@inject SpiderHood.Services.IPermissionService PermissionService
@inject IJSRuntime JSRuntime

<PageTitle>Resumen de Gastos</PageTitle>

<div class="container-fluid px-4 py-3">
    @* Mismo patrón sticky que /cuotas (InstallmentList.razor) y /movement --
       top: 3.5rem por el header global sticky de MainLayout.razor.css. *@
    <div style="position: sticky; top: 3.5rem; z-index: 5; background: var(--sh-surface, #fff);">
        <div class="page-header mb-4 d-flex justify-content-between align-items-center">
            <div class="page-header-title">
                <div class="icon-badge">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Resumen de Gastos</h1>
                    <p class="text-muted mb-0">Gastos registrados del edificio</p>
                </div>
            </div>
            @if (_canCreateExpense)
            {
                <button class="btn btn-primary" type="button" @onclick="() => AbrirModal(new Models.ViewExpense(), OpenType.Create)">
                    <i class="bi bi-plus-lg me-1"></i>Agregar Gasto
                </button>
            }
        </div>

        @if (!cargando)
        {
            <!-- Resumen -->
            <div class="row g-3 mb-3">
                <ExpenseCard Title="Total Gastos" TotalCount="@TotalCount" TotalExpenses="@TotalExpenses" Class="h5 mb-1" ClassBorder="card shadow-sm h-100" Icon="bi bi-cash-coin" IconBg="bg-primary"></ExpenseCard>
                <ExpenseCard Title="Gastos Fijos" TotalCount="@FixedCount" TotalExpenses="@FixedExpenses" Class="h6 mb-1" ClassBorder="card shadow-sm h-100" Icon="bi bi-lock-fill" IconBg="bg-info"></ExpenseCard>
                <ExpenseCard Title="Gastos Proporcionales" TotalCount="@ProportionalCount" TotalExpenses="@ProportionalExpenses" Class="h6 mb-1" ClassBorder="card shadow-sm h-100" Icon="bi bi-pie-chart-fill" IconBg="bg-warning"></ExpenseCard>
            </div>

            <!-- Filtros -->
            <div class="table-header d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 border-bottom bg-white shadow-sm">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroMesChanged">
                        <option value="" selected="@(filtroMes == null)">Todos los meses</option>
                        @foreach (var mes in MesesDisponibles())
                        {
                            <option value="@mes.ToString("yyyy-MM")" selected="@(filtroMes == mes.ToString("yyyy-MM"))">
                                @mes.ToString("MMM-yy")
                            </option>
                        }
                    </select>

                    <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroCategoriaChanged">
                        <option value="all" selected="@(filtroCategoria == "all")">Todas las categorías</option>
                        @foreach (var item in FilteredCategory.Where(c => c.Nivel == 0))
                        {
                            <option value="@item.IdCategory" selected="@(filtroCategoria == item.IdCategory.ToString())">@item.ShortDescript</option>
                        }
                    </select>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="search-box">
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Buscar descripción, categoría, proveedor..."
                               value="@searchTerm"
                               @oninput="OnSearchInput" />
                    </div>
                    <label class="text-muted mb-0">Mostrar:</label>
                    <select class="form-select form-select-sm" style="width: auto;"
                            @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                        <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                        <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                        <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                        <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                    </select>
                </div>
            </div>
        }
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-container">
                @if (!pagination.AllData.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox display-4 d-block mb-3"></i>
                        No hay gastos registrados.
                    </div>
                }
                else if (!pagination.FilteredData.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-search display-4 d-block mb-3"></i>
                        No se encontraron gastos con los filtros seleccionados.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Grupo</th>
                                    <th>Categoría</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Fecha</th>
                                    <th>Distribución</th>
                                    <th class="text-end">Monto</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in pagination.CurrentPageData)
                                {
                                    <tr>
                                        <td class="ps-3 text-muted">@GetGrupo(item.IdCategory)</td>
                                        <td>@item.Category</td>
                                        <td>@item.Description</td>
                                        <td class="text-end">@item.ExpenseDate.ToString("dd-MMM-yy")</td>
                                        <td>@(item.Distribution?.ToString() ?? "-")</td>
                                        <td class="text-end">@Moneda(item.Amount)</td>
                                        <td class="text-center">
                                            @if (_canEditExpense)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        title="Editar"
                                                        @onclick="@(() => AbrirModal(item, OpenType.Update))">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger"
                                                    title="Eliminar"
                                                    @onclick="@(() => DeleteItem(item))">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="5" class="text-end fw-bold">Total de la página:</td>
                                    <td class="text-end fw-bold">@Moneda(pagination.CurrentPageData.Sum(i => i.Amount))</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Paginación -->
                    @if (pagination.TotalPages > 1)
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top">
                            <div class="text-muted">
                                Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords gastos
                            </div>

                            <nav aria-label="Paginación de resultados">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                            <i class="bi bi-chevron-double-left"></i>
                                        </a>
                                    </li>
                                    <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>

                                    @foreach (var pageNum in pagination.GetPageNumbers())
                                    {
                                        if (pageNum == -1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">
                                                    @pageNum
                                                </a>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                    <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                        <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                            <i class="bi bi-chevron-double-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<!--    MODAL PARA NUEVO / MODIFICACION DE GASTOS   -->
<SpiderHood.Components.Pages.ExpensePages.ModalExpense ShowModal="@MostrarModal"
                                                       ShowModalChanged="@((valor) => MostrarModal = valor)"
                                                       OpenMode="@OpenMode"
                                                       ExpenseView="@_newExpense"
                                                       FilteredCategory="@FilteredCategory"
                                                       OnSaveItem="@((item) => SaveItem(item))" />

<!--    CONFIRMACIÓN PARA ELIMINAR GASTO   -->
<ConfirmationModal @ref="_confirmationModal" OnClose="OnDeleteConfirmed" />

@code {
    private string Moneda(decimal valor) => valor.FormatoMoneda(ParameterService.CurrentBuilding?.Configuration.Currency);

    [Inject] private IExpenseService ExpenseService { get; set; } = default!;
    [Inject] private ICategoryService CategoryService { get; set; } = default!;

    // ViewExpense, no Expense -- ver el hallazgo grande de esta sesión: Classes/Expense.cs
    // no coincide con ninguna columna real de dbo.Expense (confirmado con
    // INFORMATION_SCHEMA.COLUMNS); ViewExpense sí. Ver IExpenseService.GetExpensesByBuildingAsync.
    private Models.ViewExpense _newExpense = new Models.ViewExpense();
    private List<Models.ViewExpense> allExpenses = new();
    private ExpensePagination pagination = new();
    private List<Models.Category> FilteredCategory = new();

    private bool cargando = true;
    private bool MostrarModal = false;
    private Models.OpenType OpenMode = OpenType.ReadOnly;

    private string searchTerm = string.Empty;
    private string filtroCategoria = "all";
    private string? filtroMes = null;

    private bool _canCreateExpense;
    private bool _canEditExpense;

    // Totales generales -- sobre TODO el dataset del edificio, no sobre lo filtrado/
    // paginado (mismo criterio que las tarjetas de resumen en /cuotas).
    private decimal TotalExpenses => allExpenses.Sum(e => e.Amount);
    private int TotalCount => allExpenses.Count;

    private decimal FixedExpenses => allExpenses
        .Where(e => e.Distribution == Models.TypeDistribution.Fija)
        .Sum(e => e.Amount);

    private int FixedCount => allExpenses
        .Count(e => e.Distribution == Models.TypeDistribution.Fija);

    private decimal ProportionalExpenses => allExpenses
        .Where(e => e.Distribution == Models.TypeDistribution.Proporcional)
        .Sum(e => e.Amount);

    private int ProportionalCount => allExpenses
        .Count(e => e.Distribution == Models.TypeDistribution.Proporcional);

    protected override async Task OnInitializedAsync()
    {
        pagination.OnPaginationChanged += StateHasChanged;

        var currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _canCreateExpense = await PermissionService.HasPermissionAsync(currentUser, "create_expense");
        _canEditExpense = await PermissionService.HasPermissionAsync(currentUser, "edit_expense");

        await LoadData();
    }

    private async Task LoadData()
    {
        if (ParameterService.CurrentBuilding == null || ParameterService.CurrentBuilding.IdBuilding == Guid.Empty)
        {
            pagination.Initialize(new List<Models.ViewExpense>());
            cargando = false;
            return;
        }

        cargando = true;
        StateHasChanged();

        allExpenses = await ExpenseService.GetExpensesByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);
        FilteredCategory = await CategoryService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding);

        pagination.Initialize(allExpenses.OrderByDescending(e => e.ExpenseDate).ToList());
        AplicarFiltros();

        cargando = false;
    }

    private IEnumerable<DateTime> MesesDisponibles() =>
        allExpenses.Select(e => new DateTime(e.ExpenseDate.Year, e.ExpenseDate.Month, 1)).Distinct().OrderByDescending(m => m);

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        pagination.Search(searchTerm);
    }

    private void OnFiltroMesChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        filtroMes = string.IsNullOrEmpty(value) ? null : value;
        AplicarFiltros();
    }

    private void OnFiltroCategoriaChanged(ChangeEventArgs e)
    {
        filtroCategoria = e.Value?.ToString() ?? "all";
        AplicarFiltros();
    }

    // Cada gasto siempre guarda la SUBcategoría (hoja) -- el modal de crear/editar
    // sólo deja elegir una hoja, nunca la categoría raíz (ver ModalExpense.razor,
    // el <optgroup> no es seleccionable). El filtro de arriba lista las raíces
    // (Nivel == 0) para no repetir 10 opciones sueltas -- comparar IdCategory
    // directo contra esa raíz nunca matcheaba nada, porque ningún gasto tiene
    // realmente la raíz como su categoría. Se resuelve a través de FilteredCategory
    // (ya cargada para el dropdown/modal) subiendo un nivel por ParentId.
    private bool CoincideConCategoriaFiltro(Guid idCategoriaGasto)
    {
        if (idCategoriaGasto.ToString() == filtroCategoria) return true;

        var categoria = FilteredCategory.FirstOrDefault(c => c.IdCategory == idCategoriaGasto);
        return categoria != null && categoria.ParentId.ToString() == filtroCategoria;
    }

    // "Grupo" = la categoría raíz (Nivel == 0) de la que cuelga la subcategoría real
    // del gasto -- Category.ParentName ya trae ese nombre resuelto (no hace falta
    // buscar la fila padre a mano).
    private string GetGrupo(Guid idCategoria)
    {
        var categoria = FilteredCategory.FirstOrDefault(c => c.IdCategory == idCategoria);
        if (categoria == null) return "-";
        if (categoria.Nivel == 0) return categoria.ShortDescript;
        return string.IsNullOrEmpty(categoria.ParentName) ? categoria.ShortDescript : categoria.ParentName;
    }

    private void AplicarFiltros()
    {
        pagination.ApplyCustomFilter(item =>
            (filtroMes == null || item.ExpenseDate.ToString("yyyy-MM") == filtroMes)
            && (filtroCategoria == "all" || CoincideConCategoriaFiltro(item.IdCategory)));
    }

    private void AbrirModal(Models.ViewExpense item, OpenType mode)
    {
        if (mode == Models.OpenType.Create && !_canCreateExpense) return;
        if (mode == Models.OpenType.Update && !_canEditExpense) return;

        MostrarModal = true;
        OpenMode = mode;

        switch (mode)
        {
            case Models.OpenType.Create:
                // INS_Expense exige varios campos que este formulario no expone --
                // se completan acá con defaults razonables para un gasto cargado a
                // mano (no conciliado, no viene de una transacción bancaria).
                _newExpense = new Models.ViewExpense();
                _newExpense.IdExpense = Guid.NewGuid();
                _newExpense.IdBuilding = ParameterService.CurrentBuilding.IdBuilding;
                _newExpense.ExpenseDate = DateTime.Now;
                _newExpense.Status = Models.StatusExpense.Approved;
                _newExpense.PaymentMethod = Models.PaymentMethod.Other;
                _newExpense.Distribution = Models.TypeDistribution.Fija;
                break;

            case Models.OpenType.Update:
                _newExpense = item;
                break;

            default:
                throw new ArgumentOutOfRangeException(nameof(mode), $"Valor inesperado: {mode}");
        }
    }

    private async Task SaveItem(Models.ViewExpense item)
    {
        switch (OpenMode)
        {
            case Models.OpenType.Create:
                if (!_canCreateExpense) return;
                await AddItem(item);
                break;

            case Models.OpenType.Update:
                if (!_canEditExpense) return;
                await UpdateItem(item);
                break;

            default:
                throw new ArgumentOutOfRangeException(nameof(OpenMode), $"Valor inesperado: {OpenMode}");
        }

        await LoadData();
    }

    private async Task AddItem(Models.ViewExpense item)
    {
        item.IdBuilding = ParameterService.CurrentBuilding.IdBuilding;
        await ExpenseService.AddExpenseAsync(item);
    }

    private async Task UpdateItem(Models.ViewExpense item)
    {
        await ExpenseService.UpdateExpenseAsync(item);
    }

    private ConfirmationModal? _confirmationModal;
    private Models.ViewExpense? _expenseToDelete;

    private void DeleteItem(Models.ViewExpense item)
    {
        // Un gasto ya conciliado con una transacción bancaria no se puede borrar sin
        // dejar esa transacción apuntando a un IdExpense inexistente -- se corta acá,
        // antes de siquiera intentar el DELETE (que además puede fallar por FK si hay
        // otra referencia que este chequeo no cubra, ver DeleteExpenseAsync).
        if (item.Reconciled)
        {
            _ = ShowToast("Error", "No se puede eliminar un gasto ya conciliado con una transacción bancaria.", "danger");
            return;
        }

        _expenseToDelete = item;

        // Message/Title/ConfirmText ANTES de Show(): Show() ya dispara su propio
        // render adentro del componente, así que fijarlos después podía dejar el
        // primer render con el texto de una invocación anterior (o el default) --
        // mismo bug ya corregido en ReconciliationWorkspace.ConfirmarAsync, ver
        // Docs/Pendientes-Negocio-Conciliacion.md #4. OJO: el helper compartido
        // ConfirmationUtil.ExecuteWithConfirmation (Classes/Utilities.cs) todavía
        // tiene este mismo bug sin corregir para las otras pantallas que lo usan --
        // acá no se usa ese helper a propósito, se controla el modal directo.
        if (_confirmationModal != null)
        {
            _confirmationModal.Title = "Eliminar Gasto";
            _confirmationModal.Message = $"¿Seguro que querés eliminar el gasto \"{item.Description}\" por {Moneda(item.Amount)}? Esta acción no se puede deshacer.";
            _confirmationModal.ConfirmText = "Eliminar";
            _confirmationModal.Show("danger");
        }
    }

    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (!confirmed || _expenseToDelete == null)
        {
            _expenseToDelete = null;
            return;
        }

        var item = _expenseToDelete;
        _expenseToDelete = null;

        var result = await ExpenseService.DeleteExpenseAsync(item);

        if (!result.IsSuccess)
        {
            await ShowToast("Error", result.ErrorMessage ?? "No se pudo eliminar el gasto", "danger");
            return;
        }

        await ShowToast("Listo", "Gasto eliminado.", "success");
        await LoadData();
    }

    // Mismo patrón que BuildingPages/UnitGroups.razor -- showToast (wwwroot/js/utilidades.js)
    // es la "ventana de mensajes" del sistema, en vez de un alert() nativo del navegador.
    private async Task ShowToast(string title, string message, string type)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showToast", title, message, type);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando toast: {ex.Message}");
            Console.WriteLine($"{type.ToUpper()}: {title} - {message}");
        }
    }
}
