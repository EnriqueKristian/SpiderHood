@using System.ComponentModel.DataAnnotations
@using SpiderHood.Models

@inherits LayoutComponentBase
@inject SpiderHood.Services.ParameterService ParameterService

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-cash-coin me-2 text-primary"></i>@((OpenMode == Models.OpenType.Create) ? "Agregar Gasto" : "Actualizar Gasto")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <EditForm Model="@ExpenseView" OnValidSubmit="@Guardar" method="post" FormName="create" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="modal-body">
                        @if (ExpenseView.Reconciled)
                        {
                            <div class="alert alert-info py-2 mb-3">
                                <i class="bi bi-info-circle me-1"></i>
                                Este gasto ya está conciliado con una transacción bancaria -- el monto y la fecha no se pueden modificar acá (harían que dejen de coincidir con lo que realmente se movió en el banco).
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Categoría</label>
                            <select class="form-select" @bind="ExpenseView.IdCategory" @bind:after="ActualizarDistribucionDesdeCategoria">
                                <option value="">Seleccionar categoría</option>
                                @foreach (var item in FilteredCategory.Where(c => c.Nivel == 0))
                                {
                                    <optgroup label="@item.ShortDescript">
                                        @foreach (var subitem in FilteredCategory.Where(c => c.ParentId == item.IdCategory))
                                        {
                                            <option value="@subitem.IdCategory">@subitem.ShortDescript</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <input class="form-control"
                                   placeholder="Ej: Consumo Enero 2025"
                                   @bind="ExpenseView.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Monto</label>
                            <div class="input-group">
                                <span class="input-group-text">@(ParameterService.CurrentBuilding?.Configuration.Currency.ToCurrencySymbol() ?? "S/")</span>
                                <input type="number"
                                       class="form-control"
                                       step="0.01"
                                       min="0"
                                       disabled="@ExpenseView.Reconciled"
                                       @bind="ExpenseView.Amount" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fecha</label>
                            <input type="date" class="form-control" disabled="@ExpenseView.Reconciled" @bind="ExpenseView.ExpenseDate" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label d-block">Tipo de Distribución</label>
                            <!-- Ya no es un select manual -- hereda siempre de la categoría elegida
                                 arriba (Category.Distribution, ver ActualizarDistribucionDesdeCategoria).
                                 Pedido explícito del usuario: no tiene sentido que alguien elija acá
                                 algo distinto a lo que ya define la categoría. -->
                            <div>
                                <span class="badge @(DistribucionSeleccionada == Models.TypeDistribution.Fija ? "bg-secondary" : "bg-primary")">
                                    @(DistribucionSeleccionada == Models.TypeDistribution.Fija ? "Fijo" : "Proporcional")
                                </span>
                                <div class="form-text">
                                    @if (DistribucionSeleccionada == Models.TypeDistribution.Fija)
                                    {
                                        <label>Se divide en partes iguales entre todos</label>
                                    }
                                    else
                                    {
                                        <label>Se divide de manera proporcional </label>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>@((OpenMode == Models.OpenType.Create) ? "Guardar" : "Actualizar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public Models.OpenType OpenMode { get; set; }
    [Parameter] public Models.ViewExpense ExpenseView { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    [Parameter] public EventCallback<Models.ViewExpense> OnSaveItem { get; set; }
    [Parameter] public List<Models.Category> FilteredCategory { get; set; }

    // ExpenseView.Distribution es nullable (la columna real dbo.Expense.Distribution
    // admite NULL) -- Blazor no soporta bindear un <select> directo contra un enum
    // nullable de forma confiable, así que se pasa por esta propiedad intermedia:
    // muestra Fija cuando todavía no hay nada elegido (gasto nuevo, o uno viejo sin
    // distribución guardada), pero el set siempre deja un valor concreto.
    private Models.TypeDistribution DistribucionSeleccionada
    {
        get => ExpenseView.Distribution ?? Models.TypeDistribution.Fija;
        set => ExpenseView.Distribution = value;
    }

    private async Task Guardar()
    {
        await OnSaveItem.InvokeAsync(ExpenseView);
        await CerrarModal();
    }

    private async Task CerrarModal()
    {
        ShowModal = false;
        await ShowModalChanged.InvokeAsync(ShowModal);
    }

    // "Tipo de Distribución" quedaba fijo en lo que trajera ExpenseView (Fija por default
    // al crear) sin importar la categoría elegida -- cada categoría ya tiene su propio
    // Distribution configurado (Classes/Category.cs), que es lo que debería definir cómo
    // se reparte el gasto entre las unidades.
    private void ActualizarDistribucionDesdeCategoria()
    {
        var categoria = FilteredCategory?.FirstOrDefault(c => c.IdCategory == ExpenseView.IdCategory);
        if (categoria != null)
        {
            ExpenseView.Distribution = categoria.Distribution;
        }
    }

}
