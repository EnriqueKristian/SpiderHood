@page "/forgot-password"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject IPasswordResetService PasswordResetService

<PageTitle>SpiderHood - Restablecer contraseña</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 L12 21 M4 7 L20 7 M4 17 L20 17 M6 4 L18 20 M18 4 L6 20" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.55" />
                    <path d="M12 12 L12 5.2 M12 12 L18.2 8.6 M12 12 L18.2 15.4 M12 12 L12 18.8 M12 12 L5.8 15.4 M12 12 L5.8 8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                    <path d="M12 5.2 L15.4 6.6 L18.2 8.6 L19.4 12 L18.2 15.4 L15.4 17.4 L12 18.8 L8.6 17.4 L5.8 15.4 L4.6 12 L5.8 8.6 L8.6 6.6 Z" stroke="currentColor" stroke-width="1.1" opacity="0.6" fill="none" />
                </svg>
                <h2>SpiderHood</h2>
            </div>
            <p class="text-muted">¿Olvidaste tu contraseña?</p>
        </div>

        <div class="login-body">
            @if (resultMessage != null)
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@resultMessage
                </div>
                <div class="text-center mt-3">
                    <a href="/login" class="text-decoration-none">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Volver a Iniciar Sesión
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted mb-4">
                    Ingresá el email con el que te registraste y te vamos a mandar un enlace para elegir una nueva contraseña.
                </p>

                <EditForm Model="@model" OnValidSubmit="@HandleSubmit" FormName="forgotPasswordForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="form-group mb-3">
                        <label for="email" class="form-label">
                            <i class="bi bi-envelope me-2"></i>Email
                        </label>
                        <InputText id="email" class="form-control" @bind-Value="model.Email" placeholder="example@outlook.com" disabled="@isSubmitting" />
                        <ValidationMessage For="@(() => model.Email)" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-send me-2"></i>
                        <span>Enviar enlace</span>
                    </button>
                </EditForm>

                <div class="login-footer mt-4">
                    <p>
                        <a href="/login" class="text-decoration-none small">
                            <i class="bi bi-arrow-left me-1"></i>Volver a Iniciar Sesión
                        </a>
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel model = new();
    private bool isSubmitting = false;
    private string? resultMessage;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            var result = await PasswordResetService.RequestPasswordResetAsync(model.Email);
            resultMessage = result.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
