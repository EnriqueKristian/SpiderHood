@page "/governance/meetings/{Id:guid}"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Components.Pages.Components
@inject IMeetingService MeetingService
@inject SpiderHood.Services.AuthService AuthService
@inject SpiderHood.Services.IPermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>Reunión</PageTitle>

<div class="container-fluid px-4 py-3">
    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_reunion == null)
    {
        <div class="alert alert-danger">No se encontró la reunión.</div>
    }
    else
    {
        <div class="page-header d-flex justify-content-between align-items-center mb-3">
            <div class="page-header-title">
                <button class="btn btn-sm btn-outline-secondary me-3" @onclick="Volver"><i class="bi bi-arrow-left"></i></button>
                <div>
                    <h1 class="h4 fw-bold mb-0">@_reunion.Titulo</h1>
                    <div class="text-muted small">@(_reunion.Tipo == MeetingType.Ordinaria ? "Ordinaria" : "Extraordinaria") -- @_reunion.FechaMeeting.ToString("dd/MM/yyyy HH:mm") -- @_reunion.Modalidad</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (_reunion.Estado == MeetingStatus.Finalizada || _reunion.Estado == MeetingStatus.QuorumNoAlcanzado)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo($"/governance/meetings/{Id}/minutes")'>
                        <i class="bi bi-file-earmark-text me-1"></i>Ver Acta
                    </button>
                }
                <span class="badge @BadgeClase(_reunion.Estado) fs-6">@TraducirEstado(_reunion.Estado)</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_mensaje))
        {
            <div class="alert @(_mensajeEsError ? "alert-danger" : "alert-success")">@_mensaje</div>
        }

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card mb-3">
                    <div class="card-header">Convocatoria</div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Lugar / Enlace:</strong> @(_reunion.LugarOVinculo ?? "--")</p>
                        <p class="mb-1"><strong>Quórum requerido:</strong> @_reunion.QuorumRequerido.ToString("0.##")%</p>
                        @if (_reunion.QuorumAlcanzado != null)
                        {
                            <p class="mb-1"><strong>Quórum alcanzado:</strong> @_reunion.QuorumAlcanzado.Value.ToString("0.##")%</p>
                        }
                        <p class="mb-0 text-muted small">Convocada el @_reunion.FechaConvocatoria.ToString("dd/MM/yyyy") por @_reunion.CreatedByName</p>
                    </div>
                    @if (_puedeGestionar && _reunion.Estado == MeetingStatus.Convocada)
                    {
                        <div class="card-footer d-flex gap-2">
                            <button class="btn btn-sm btn-success" @onclick="IniciarClick"><i class="bi bi-play-fill me-1"></i>Iniciar Reunión</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="Cancelar"><i class="bi bi-x-lg me-1"></i>Cancelar</button>
                        </div>
                    }
                    @if (_puedeGestionar && _reunion.Estado == MeetingStatus.EnCurso)
                    {
                        <div class="card-footer">
                            <button class="btn btn-sm btn-primary" @onclick="Finalizar"><i class="bi bi-check2-circle me-1"></i>Finalizar Reunión</button>
                        </div>
                    }
                    @if (_puedeGestionar && _reunion.Estado == MeetingStatus.QuorumNoAlcanzado)
                    {
                        <div class="card-footer">
                            <button class="btn btn-sm btn-warning" @onclick="AbrirSegundaConvocatoria"><i class="bi bi-arrow-repeat me-1"></i>Crear Segunda Convocatoria</button>
                        </div>
                    }
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Asistencia (@_reunion.Asistentes.Count unidades, @_reunion.Asistentes.Sum(a => a.Alicuota).ToString("0.##")% de alícuota)</span>
                        @if (_puedeGestionar && (_reunion.Estado == MeetingStatus.Convocada || _reunion.Estado == MeetingStatus.EnCurso))
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="AbrirRegistrarAttendance"><i class="bi bi-person-plus me-1"></i>Registrar</button>
                        }
                    </div>
                    <div class="card-body">
                        @if (_reunion.Asistentes.Count == 0)
                        {
                            <p class="text-muted mb-0">Todavía no se registró ninguna asistencia.</p>
                        }
                        else
                        {
                            <table class="table table-sm mb-0">
                                <thead><tr><th>Unidad</th><th class="text-end">Alícuota</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var a in _reunion.Asistentes)
                                    {
                                        <tr>
                                            <td>@a.NombreUnidad</td>
                                            <td class="text-end">@a.Alicuota.ToString("0.####")%</td>
                                            <td class="text-end">
                                                @if (_puedeGestionar && _reunion.Estado == MeetingStatus.Convocada)
                                                {
                                                    <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => QuitarAttendance(a.IdGroupUnit)" title="Quitar">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Agenda</span>
                        @if (_puedeGestionar && _reunion.Estado == MeetingStatus.Convocada)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="AbrirAgregarPunto"><i class="bi bi-plus-lg"></i></button>
                        }
                    </div>
                    <div class="card-body">
                        @if (_reunion.Agenda.Count == 0)
                        {
                            <p class="text-muted mb-0">Sin puntos de agenda.</p>
                        }
                        else
                        {
                            @foreach (var item in _reunion.Agenda.OrderBy(a => a.Orden))
                            {
                                <div class="border rounded p-2 mb-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@item.Orden. @item.Titulo</strong>
                                            @if (!string.IsNullOrEmpty(item.Descripcion))
                                            {
                                                <div class="text-muted small">@item.Descripcion</div>
                                            }
                                            <div class="mt-1">
                                                <span class="badge bg-light text-dark border me-1">@(item.Tipo == AgendaItemType.Informativo ? "Informativo" : "Sujeto a Votación")</span>
                                                @if (item.Tipo == AgendaItemType.SujetoAVotacion)
                                                {
                                                    <span class="badge bg-light text-dark border me-1">@item.VotingType</span>
                                                    <span class="badge bg-light text-dark border">@TraducirMayoria(item.MajorityType)</span>
                                                }
                                            </div>
                                            @if (_reunion.Estado != MeetingStatus.Convocada)
                                            {
                                                @if (NotasEditable)
                                                {
                                                    <div class="mt-2">
                                                        <textarea class="form-control form-control-sm" rows="2" placeholder="Notas de lo conversado en este punto..." @bind="item.Notas"></textarea>
                                                        <button class="btn btn-sm btn-outline-primary mt-1" @onclick="() => GuardarNotas(item)">
                                                            <i class="bi bi-floppy me-1"></i>Guardar nota
                                                        </button>
                                                    </div>
                                                }
                                                else if (!string.IsNullOrEmpty(item.Notas))
                                                {
                                                    <div class="mt-2 p-2 bg-light rounded small"><strong>Notas:</strong> @item.Notas</div>
                                                }
                                            }
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @BadgeAgendaClase(item.Estado)">@TraducirEstadoAgenda(item.Estado)</span>
                                            @if (_puedeGestionar && _reunion.Estado == MeetingStatus.Convocada)
                                            {
                                                <div class="mt-1">
                                                    <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => EliminarPunto(item.IdAgendaItem)" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                            @if (_puedeGestionar && _reunion.Estado == MeetingStatus.EnCurso && item.Tipo == AgendaItemType.Informativo && item.Estado == AgendaItemStatus.Pendiente)
                                            {
                                                <div class="mt-1">
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => MarcarInformado(item.IdAgendaItem)">Marcar informado</button>
                                                </div>
                                            }
                                            @if (_reunion.Estado == MeetingStatus.EnCurso && item.Tipo == AgendaItemType.SujetoAVotacion)
                                            {
                                                <div class="mt-1">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirVotingRound(item)">
                                                        <i class="bi bi-check2-square me-1"></i>@(item.Estado == AgendaItemStatus.Pendiente ? "Votar" : "Ver votación")
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (_showAttendanceModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar asistencia</h5>
                    <button type="button" class="btn-close" @onclick="() => _showAttendanceModal = false"></button>
                </div>
                <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                    @if (_reunion!.Estado == MeetingStatus.EnCurso && _reunion.FechaInicioReal != null)
                    {
                        var limite = _reunion.FechaInicioReal.Value.AddMinutes(_reunion.MinutosLimiteAsistenciaTardia).ToLocalTime();
                        <div class="alert alert-info py-2 px-3 mb-2">
                            <i class="bi bi-clock-history me-1"></i>Asistencia tardía -- disponible hasta las @limite.ToString("HH:mm") (@_reunion.MinutosLimiteAsistenciaTardia min. desde que arrancó la reunión).
                        </div>
                    }
                    @if (_roster.Count == 0)
                    {
                        <p class="text-muted mb-0">No hay unidades registradas en este edificio.</p>
                    }
                    else
                    {
                        @foreach (var u in _roster)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" checked="@u.Presente" disabled="@u.Presente"
                                       @onchange="() => MarcarPresente(u.IdGroupUnit)" id="chk_@u.IdGroupUnit" />
                                <label class="form-check-label" for="chk_@u.IdGroupUnit">
                                    @u.NombreUnidad <span class="text-muted small">(@u.Alicuota.ToString("0.####")%)</span>
                                </label>
                            </div>
                        }
                    }
                    @if (!string.IsNullOrEmpty(_errorAttendance))
                    {
                        <div class="alert alert-danger py-2 px-3 mt-2">@_errorAttendance</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CerrarRegistrarAttendance">Listo</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showAgendaModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar punto de agenda</h5>
                    <button type="button" class="btn-close" @onclick="() => _showAgendaModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input class="form-control" @bind="_nuevoPunto.Titulo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" rows="2" @bind="_nuevoPunto.Descripcion"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" @bind="_nuevoPunto.Tipo">
                            <option value="@AgendaItemType.Informativo">Informativo</option>
                            <option value="@AgendaItemType.SujetoAVotacion">Sujeto a Votación</option>
                        </select>
                    </div>
                    @if (_nuevoPunto.Tipo == AgendaItemType.SujetoAVotacion)
                    {
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Tipo de votación</label>
                                <select class="form-select" @bind="_nuevoPunto.VotingType">
                                    <option value="@AgendaVotingType.Nominal">Nominal</option>
                                    <option value="@AgendaVotingType.Secreta">Secreta</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Mayoría requerida</label>
                                <select class="form-select" @bind="_nuevoPunto.MajorityType">
                                    <option value="@MajorityType.Simple">Simple</option>
                                    <option value="@MajorityType.Calificada">Calificada</option>
                                    <option value="@MajorityType.Legal75">75% legal</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" @bind="_nuevoPunto.PermiteRevotacion" id="chkRevotacionNuevo" />
                            <label class="form-check-label" for="chkRevotacionNuevo">Permite revotación</label>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_errorAgenda))
                    {
                        <div class="alert alert-danger py-2 px-3 mt-2">@_errorAgenda</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _showAgendaModal = false">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarPunto">Agregar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showSegundaModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Crear Segunda Convocatoria</h5>
                    <button type="button" class="btn-close" @onclick="() => _showSegundaModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Se clona la misma agenda en una reunión nueva, con la fecha y el quórum que definas acá (según lo que permita el Reglamento Interno del edificio).</p>
                    <div class="mb-3">
                        <label class="form-label">Nueva fecha y hora</label>
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_segundaFecha" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nuevo quórum requerido (%)</label>
                        <input type="number" step="0.01" class="form-control" @bind="_segundaQuorum" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lugar / Enlace</label>
                        <input class="form-control" @bind="_segundaLugar" />
                    </div>
                    @if (!string.IsNullOrEmpty(_errorSegunda))
                    {
                        <div class="alert alert-danger py-2 px-3">@_errorSegunda</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _showSegundaModal = false">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmarSegundaConvocatoria">Convocar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showVotingRoundModal && _votacionItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Votación -- @_votacionItem.Titulo</h5>
                    <button type="button" class="btn-close" @onclick="() => _showVotingRoundModal = false"></button>
                </div>
                <div class="modal-body" style="max-height: 65vh; overflow-y: auto;">
                    <div class="mb-2">
                        <span class="badge bg-light text-dark border me-1">@_votacionItem.VotingType</span>
                        <span class="badge bg-light text-dark border">@TraducirMayoria(_votacionItem.MajorityType)</span>
                        @if (_votacionItem.PermiteRevotacion)
                        {
                            <span class="badge bg-light text-dark border">Permite revotación</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_mensajeVotingRound))
                    {
                        <div class="alert @(_mensajeVotingRoundEsError ? "alert-danger" : "alert-success") py-2 px-3">@_mensajeVotingRound</div>
                    }

                    @{ var rondaAbierta = _votaciones.FirstOrDefault(v => v.Estado == VotingRoundStatus.Abierta); }

                    @if (!_puedeGestionar && rondaAbierta != null)
                    {
                        @if (_miUnidadId != null && _reunion!.Asistentes.Any(a => a.IdGroupUnit == _miUnidadId))
                        {
                            <div class="alert alert-info py-2 px-3">
                                <i class="bi bi-check2-square me-1"></i>Podés votar en la fila resaltada de la tabla mientras la ronda siga abierta.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary py-2 px-3">
                                <i class="bi bi-info-circle me-1"></i>Tu unidad no está registrada como asistente de esta reunión, así que no podés votar en esta ronda.
                            </div>
                        }
                    }

                    @if (_puedeGestionar && rondaAbierta == null && _votacionItem.Estado == AgendaItemStatus.Pendiente)
                    {
                        <div class="text-center py-3 d-flex justify-content-center gap-2">
                            <button class="btn btn-primary" @onclick="IniciarVotingRound">
                                <i class="bi bi-play-fill me-1"></i>Iniciar Votación @(_votaciones.Count > 0 ? $"(Ronda {_votaciones.Count + 1})" : "")
                            </button>
                            @if (_votaciones.Count > 0)
                            {
                                <button class="btn btn-outline-danger" @onclick="RechazarSinMasRondas">
                                    <i class="bi bi-x-lg me-1"></i>Rechazar sin más rondas
                                </button>
                            }
                        </div>
                    }
                    else if (rondaAbierta == null && _votacionItem.Estado == AgendaItemStatus.Pendiente)
                    {
                        <p class="text-muted text-center py-3 mb-0">Todavía no se abrió una ronda de votación para este punto.</p>
                    }

                    @if (rondaAbierta != null)
                    {
                        <div class="card mb-3">
                            <div class="card-header">Ronda @rondaAbierta.NroRonda -- en curso</div>
                            <div class="card-body">
                                <table class="table table-sm mb-0">
                                    <thead><tr><th>Unidad</th><th class="text-end">Alícuota</th><th>Voto</th></tr></thead>
                                    <tbody>
                                        @foreach (var asistente in _reunion!.Asistentes)
                                        {
                                            var votoActual = rondaAbierta.Votes.FirstOrDefault(v => v.IdGroupUnit == asistente.IdGroupUnit);
                                            var esMiUnidad = !_puedeGestionar && _miUnidadId != null && asistente.IdGroupUnit == _miUnidadId;
                                            <tr class="@(esMiUnidad ? "table-primary" : "")">
                                                <td>@asistente.NombreUnidad @(esMiUnidad ? "(vos)" : "")</td>
                                                <td class="text-end">@asistente.Alicuota.ToString("0.####")%</td>
                                                <td>
                                                    @if (_puedeGestionar)
                                                    {
                                                        <select class="form-select form-select-sm" style="width:auto"
                                                                value="@(votoActual?.Opcion.ToString() ?? "")"
                                                                @onchange="(e) => RegistrarVote(rondaAbierta.IdVotingRound, asistente.IdGroupUnit, e.Value?.ToString())">
                                                            <option value="">-- sin votar --</option>
                                                            <option value="@VoteOption.AFavor">A favor</option>
                                                            <option value="@VoteOption.EnContra">En contra</option>
                                                            <option value="@VoteOption.Abstencion">Abstención</option>
                                                        </select>
                                                    }
                                                    else if (esMiUnidad)
                                                    {
                                                        <select class="form-select form-select-sm" style="width:auto"
                                                                value="@(votoActual?.Opcion.ToString() ?? "")"
                                                                @onchange="(e) => RegistrarVotoPropio(rondaAbierta.IdVotingRound, e.Value?.ToString())">
                                                            <option value="">-- sin votar --</option>
                                                            <option value="@VoteOption.AFavor">A favor</option>
                                                            <option value="@VoteOption.EnContra">En contra</option>
                                                            <option value="@VoteOption.Abstencion">Abstención</option>
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <span>@(votoActual != null ? TraducirOpcion(votoActual.Opcion) : "--")</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (_puedeGestionar)
                            {
                                <div class="card-footer">
                                    <button class="btn btn-sm btn-primary" @onclick="() => CerrarVotingRound(rondaAbierta.IdVotingRound)">
                                        <i class="bi bi-check2-circle me-1"></i>Cerrar Votación
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (_votaciones.Any(v => v.Estado == VotingRoundStatus.Cerrada))
                    {
                        <h6>Historial de rondas</h6>
                        @foreach (var v in _votaciones.Where(v => v.Estado == VotingRoundStatus.Cerrada).OrderByDescending(v => v.NroRonda))
                        {
                            <div class="border rounded p-2 mb-2">
                                <div class="d-flex justify-content-between">
                                    <strong>Ronda @v.NroRonda</strong>
                                    <span class="badge @(v.MayoriaAlcanzada == true ? "bg-success" : "bg-danger")">@(v.MayoriaAlcanzada == true ? "Mayoría alcanzada" : "Mayoría no alcanzada")</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    A favor: @v.AlicuotaAFavor?.ToString("0.##")% -- En contra: @v.AlicuotaEnContra?.ToString("0.##")% -- Abstención: @v.AlicuotaAbstencion?.ToString("0.##")%
                                </div>
                                @if (_votacionItem.VotingType == AgendaVotingType.Nominal)
                                {
                                    <ul class="small mb-0 mt-1">
                                        @foreach (var voto in v.Votes)
                                        {
                                            <li>@voto.NombreUnidad: @TraducirOpcion(voto.Opcion)</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _showVotingRoundModal = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmationModal @ref="_confirmationModal" OnClose="OnConfirmationResult" />

@code {
    [Parameter] public Guid Id { get; set; }

    private UserSession _currentUser = new();
    private bool _loading = true;
    private bool _puedeGestionar;
    private Meeting? _reunion;
    private string? _mensaje;
    private bool _mensajeEsError;

    private ConfirmationModal? _confirmationModal;
    private ConfirmationUtil util = new ConfirmationUtil();

    private async Task OnConfirmationResult(bool confirmed) => await util.OnConfirmationResult(confirmed);

    private bool _showAttendanceModal;
    private List<UnitWithShare> _roster = new();
    private string? _errorAttendance;

    private bool _showAgendaModal;
    private AgendaItem _nuevoPunto = new();
    private string? _errorAgenda;

    private bool _showSegundaModal;
    private DateTime _segundaFecha = DateTime.Today.AddDays(7).AddHours(19);
    private decimal _segundaQuorum = 25m;
    private string? _segundaLugar;
    private string? _errorSegunda;

    private bool _showVotingRoundModal;
    private AgendaItem? _votacionItem;
    private List<VotingRound> _votaciones = new();
    private string? _mensajeVotingRound;
    private bool _mensajeVotingRoundEsError;

    // Resuelto server-side (mismo mecanismo que Mis Recibos/Mis Deudas, ver
    // AuthService.GetCurrentUnitIdAsync) -- nunca viene de un valor que el cliente
    // pueda manipular, así que sirve como identidad confiable de "mi unidad" para
    // habilitar el voto self-service sin depender de nada que mande el navegador.
    private Guid? _miUnidadId;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _puedeGestionar = await PermissionService.HasPermissionAsync(_currentUser, "manage_meetings");
        _miUnidadId = await AuthService.GetCurrentUnitIdAsync();
        await CargarAsync();
        _loading = false;
    }

    private async Task CargarAsync()
    {
        _reunion = await MeetingService.GetMeetingByIdAsync(Id);
        _meetingMinutes = await MeetingService.GetMeetingMinutesAsync(Id);
    }

    private MeetingMinutes? _meetingMinutes;

    // Las notas quedan cerradas junto con el resto del Acta una vez Firmada --
    // mismo criterio que ActualizarNotasAgendaItemAsync del lado del servidor.
    private bool NotasEditable => _puedeGestionar && _meetingMinutes?.Estado != MeetingMinutesStatus.Firmada;

    private async Task GuardarNotas(AgendaItem item)
    {
        try
        {
            await MeetingService.ActualizarNotasAgendaItemAsync(item.IdAgendaItem, item.Notas);
            _mensaje = "Nota guardada.";
            _mensajeEsError = false;
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _mensajeEsError = true;
        }
    }

    private void Volver() => Navigation.NavigateTo("/governance/meetings");

    // Antes "Iniciar Reunión" llamaba directo a IniciarMeetingAsync -- si la alícuota
    // registrada todavía no alcanza el quórum, el servicio pasa la reunión a
    // QuorumNoAlcanzado en el mismo click, sin ningún aviso previo (ver comentario en
    // IMeetingService.IniciarMeetingAsync). Se avisa acá antes de arrancar cuando la
    // asistencia registrada no alcanza el quórum, para que quien dirige la reunión no
    // se entere recién después de hacer click.
    private async Task IniciarClick()
    {
        if (_reunion == null) return;

        var alicuotaRegistrada = _reunion.Asistentes.Sum(a => a.Alicuota);
        if (alicuotaRegistrada < _reunion.QuorumRequerido)
        {
            var mensaje = _reunion.Asistentes.Count == 0
                ? "Todavía no registraste ninguna asistencia. Si iniciás la reunión ahora, no se alcanzará el quórum y pasará directo a Segunda Convocatoria. ¿Continuar?"
                : $"La asistencia registrada ({alicuotaRegistrada.ToString("0.##")}%) no alcanza el quórum requerido ({_reunion.QuorumRequerido.ToString("0.##")}%). Si iniciás la reunión ahora, pasará directo a Segunda Convocatoria. ¿Continuar?";
            await util.ExecuteWithConfirmation(Iniciar, "Iniciar Reunión", _confirmationModal, mensaje, "warning", false);
            return;
        }

        await Iniciar();
    }

    private async Task Iniciar()
    {
        try
        {
            var resultado = await MeetingService.IniciarMeetingAsync(Id);
            _mensaje = resultado.Mensaje;
            _mensajeEsError = !resultado.Exito;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _mensajeEsError = true;
        }
    }

    private async Task Finalizar()
    {
        try
        {
            await MeetingService.FinalizarMeetingAsync(Id);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _mensajeEsError = true;
        }
    }

    private async Task Cancelar()
    {
        try
        {
            await MeetingService.CancelarMeetingAsync(Id);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _mensajeEsError = true;
        }
    }

    private async Task AbrirRegistrarAttendance()
    {
        _roster = await MeetingService.GetRosterAlicuotasAsync(_reunion!.IdBuilding, Id);
        _errorAttendance = null;
        _showAttendanceModal = true;
    }

    // Puede fallar si el estado de la Meeting cambió por fuera de esta pestaña
    // (otro operador ya inició/finalizó/canceló la reunión mientras este modal
    // seguía abierto con la lista vieja) -- IMeetingService.RegistrarAttendanceAsync
    // valida Estado=Convocada del lado del servidor, no sólo ocultando el botón acá.
    // Sin este try/catch, la excepción no atrapada terminaba todo el circuito de
    // Blazor (mismo patrón de bug ya visto y corregido en Administrar Menú).
    private async Task MarcarPresente(Guid idGroupUnit)
    {
        try
        {
            await MeetingService.RegistrarAttendanceAsync(Id, idGroupUnit, _currentUser.IdUser);
            var unidad = _roster.FirstOrDefault(u => u.IdGroupUnit == idGroupUnit);
            if (unidad != null) unidad.Presente = true;
            _errorAttendance = null;
        }
        catch (InvalidOperationException ex)
        {
            _errorAttendance = ex.Message;
        }
    }

    private async Task CerrarRegistrarAttendance()
    {
        _showAttendanceModal = false;
        await CargarAsync();
    }

    private async Task QuitarAttendance(Guid idGroupUnit)
    {
        try
        {
            await MeetingService.QuitarAttendanceAsync(Id, idGroupUnit);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _mensajeEsError = true;
        }
    }

    private void AbrirAgregarPunto()
    {
        // VotingType/MajorityType arrancan en el primer valor de cada <select>
        // (no null) -- ver la misma nota en Meetings.razor.NuevoPuntoAgenda.
        _nuevoPunto = new AgendaItem
        {
            IdMeeting = Id,
            Tipo = AgendaItemType.Informativo,
            VotingType = AgendaVotingType.Nominal,
            MajorityType = MajorityType.Simple
        };
        _errorAgenda = null;
        _showAgendaModal = true;
    }

    private async Task GuardarPunto()
    {
        _errorAgenda = null;
        if (string.IsNullOrWhiteSpace(_nuevoPunto.Titulo))
        {
            _errorAgenda = "El título es obligatorio.";
            return;
        }

        try
        {
            await MeetingService.AgregarAgendaItemAsync(_nuevoPunto);
            _showAgendaModal = false;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorAgenda = ex.Message;
        }
    }

    private async Task EliminarPunto(Guid idAgendaItem)
    {
        try
        {
            await MeetingService.EliminarAgendaItemAsync(idAgendaItem);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _mensajeEsError = true;
        }
    }

    private async Task MarcarInformado(Guid idAgendaItem)
    {
        try
        {
            await MeetingService.MarcarAgendaItemEstadoAsync(idAgendaItem, AgendaItemStatus.Informado);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _mensajeEsError = true;
        }
    }

    private void AbrirSegundaConvocatoria()
    {
        _segundaFecha = DateTime.Today.AddDays(7).AddHours(19);
        _segundaQuorum = 25m;
        _segundaLugar = _reunion?.LugarOVinculo;
        _errorSegunda = null;
        _showSegundaModal = true;
    }

    private async Task ConfirmarSegundaConvocatoria()
    {
        _errorSegunda = null;
        var resultado = await MeetingService.CrearSegundaConvocatoriaAsync(Id, _segundaFecha, _segundaQuorum, _segundaLugar);
        if (!resultado.Exito)
        {
            _errorSegunda = resultado.Mensaje;
            return;
        }

        _showSegundaModal = false;
        Navigation.NavigateTo($"/governance/meetings/{resultado.IdMeeting}");
    }

    private async Task AbrirVotingRound(AgendaItem item)
    {
        _votacionItem = item;
        _mensajeVotingRound = null;
        _votaciones = await MeetingService.GetVotingRoundsAsync(item.IdAgendaItem);
        _showVotingRoundModal = true;
    }

    private async Task IniciarVotingRound()
    {
        if (_votacionItem == null || !_puedeGestionar) return;
        try
        {
            await MeetingService.IniciarVotingRoundAsync(_votacionItem.IdAgendaItem, _currentUser.IdUser);
            _votaciones = await MeetingService.GetVotingRoundsAsync(_votacionItem.IdAgendaItem);
        }
        catch (InvalidOperationException ex)
        {
            _mensajeVotingRound = ex.Message;
            _mensajeVotingRoundEsError = true;
        }
    }

    private async Task RechazarSinMasRondas()
    {
        if (_votacionItem == null || !_puedeGestionar) return;
        try
        {
            await MeetingService.MarcarAgendaItemEstadoAsync(_votacionItem.IdAgendaItem, AgendaItemStatus.Rechazado);
            _mensajeVotingRound = "Punto rechazado -- no se abrirán más rondas.";
            _mensajeVotingRoundEsError = false;
            await CargarAsync();
            _votacionItem = _reunion?.Agenda.FirstOrDefault(a => a.IdAgendaItem == _votacionItem.IdAgendaItem) ?? _votacionItem;
        }
        catch (InvalidOperationException ex)
        {
            _mensajeVotingRound = ex.Message;
            _mensajeVotingRoundEsError = true;
        }
    }

    private async Task RegistrarVote(Guid idVotingRound, Guid idGroupUnit, string? opcionTexto)
    {
        if (_votacionItem == null || string.IsNullOrEmpty(opcionTexto)) return;
        var opcion = Enum.Parse<VoteOption>(opcionTexto);
        try
        {
            await MeetingService.RegistrarVoteAsync(idVotingRound, idGroupUnit, opcion, _currentUser.IdUser);
            _votaciones = await MeetingService.GetVotingRoundsAsync(_votacionItem.IdAgendaItem);
        }
        catch (InvalidOperationException ex)
        {
            _mensajeVotingRound = ex.Message;
            _mensajeVotingRoundEsError = true;
        }
    }

    // Feedback del usuario: hoy solo quien dirige la reunión carga los votos --
    // se habilita que cada residente vote por su propia unidad mientras la ronda
    // siga Abierta. _miUnidadId se resuelve server-side (AuthService.GetCurrentUnitIdAsync,
    // nunca un valor que mande el cliente), así que no hace falta un método de
    // servicio aparte: RegistrarVoteAsync ya valida que la unidad esté registrada
    // como Attendance, y la Junta sigue pudiendo corregir cualquier voto después
    // (mismo upsert de siempre -- decisión confirmada con el usuario).
    private async Task RegistrarVotoPropio(Guid idVotingRound, string? opcionTexto)
    {
        if (_votacionItem == null || string.IsNullOrEmpty(opcionTexto) || _miUnidadId == null) return;
        var opcion = Enum.Parse<VoteOption>(opcionTexto);
        try
        {
            await MeetingService.RegistrarVoteAsync(idVotingRound, _miUnidadId.Value, opcion, _currentUser.IdUser);
            _votaciones = await MeetingService.GetVotingRoundsAsync(_votacionItem.IdAgendaItem);
        }
        catch (InvalidOperationException ex)
        {
            _mensajeVotingRound = ex.Message;
            _mensajeVotingRoundEsError = true;
        }
    }

    private async Task CerrarVotingRound(Guid idVotingRound)
    {
        if (_votacionItem == null) return;
        var resultado = await MeetingService.CerrarVotingRoundAsync(idVotingRound);
        _mensajeVotingRound = resultado.Mensaje;
        _mensajeVotingRoundEsError = !resultado.Exito;
        _votaciones = await MeetingService.GetVotingRoundsAsync(_votacionItem.IdAgendaItem);
        await CargarAsync();
        _votacionItem = _reunion?.Agenda.FirstOrDefault(a => a.IdAgendaItem == _votacionItem.IdAgendaItem) ?? _votacionItem;
    }

    private static string TraducirOpcion(VoteOption opcion) => opcion switch
    {
        VoteOption.AFavor => "A favor",
        VoteOption.EnContra => "En contra",
        VoteOption.Abstencion => "Abstención",
        _ => opcion.ToString()
    };

    private static string TraducirEstado(MeetingStatus estado) => estado switch
    {
        MeetingStatus.Convocada => "Convocada",
        MeetingStatus.EnCurso => "En Curso",
        MeetingStatus.QuorumNoAlcanzado => "Quórum No Alcanzado",
        MeetingStatus.Finalizada => "Finalizada",
        MeetingStatus.Cancelada => "Cancelada",
        _ => estado.ToString()
    };

    private static string BadgeClase(MeetingStatus estado) => estado switch
    {
        MeetingStatus.Convocada => "bg-primary",
        MeetingStatus.EnCurso => "bg-success",
        MeetingStatus.QuorumNoAlcanzado => "bg-warning text-dark",
        MeetingStatus.Finalizada => "bg-secondary",
        MeetingStatus.Cancelada => "bg-danger",
        _ => "bg-secondary"
    };

    private static string TraducirEstadoAgenda(AgendaItemStatus estado) => estado switch
    {
        AgendaItemStatus.Pendiente => "Pendiente",
        AgendaItemStatus.Informado => "Informado",
        AgendaItemStatus.Aprobado => "Aprobado",
        AgendaItemStatus.Rechazado => "Rechazado",
        _ => estado.ToString()
    };

    private static string BadgeAgendaClase(AgendaItemStatus estado) => estado switch
    {
        AgendaItemStatus.Pendiente => "bg-light text-dark border",
        AgendaItemStatus.Informado => "bg-info text-dark",
        AgendaItemStatus.Aprobado => "bg-success",
        AgendaItemStatus.Rechazado => "bg-danger",
        _ => "bg-secondary"
    };

    private static string TraducirMayoria(MajorityType? tipo) => tipo switch
    {
        MajorityType.Simple => "Mayoría simple",
        MajorityType.Calificada => "Mayoría calificada",
        MajorityType.Legal75 => "75% legal",
        _ => "--"
    };
}
