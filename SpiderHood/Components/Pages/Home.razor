@page "/"
@page "/DashBoard"
@rendermode InteractiveServer

@layout MainLayout
@using Microsoft.AspNetCore.Components
@using SpiderHood.Models
@using SpiderHood.Services
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject Services.AuthService AuthService

<PageTitle>Dashboard - AdminEdificios</PageTitle>

<div class="dashboard-container">
    <!-- Header principal -->
    <div class="dashboard-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="d-flex align-items-center">
                    <div class="avatar-icon  me-2">
                        <i class="bi bi-building"></i>
                    </div>
                    <div>
                        <h1 class="h3 mb-1 fw-bold">Bienvenido, Administrador</h1>
                        <p class="text-muted mb-0">
                            <i class="bi bi-calendar-check me-1"></i>
                            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-primary">
                        <i class="bi bi-bell me-1"></i>
                        <span class="badge bg-danger">3</span>
                    </button>
                    <button class="btn btn-outline-secondary">
                        <i class="bi bi-question-circle me-1"></i> Ayuda
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen rápido -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card summary-card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Ingresos Mensuales</h6>
                            <h3 class="card-title mb-0">S/. 45,280</h3>
                            <span class="small"><i class="bi bi-arrow-up me-1"></i>12% vs mes anterior</span>
                        </div>
                        <div class="summary-icon">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card summary-card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Unidades Ocupadas</h6>
                            <h3 class="card-title mb-0">42/50</h3>
                            <span class="small">84% de ocupación</span>
                        </div>
                        <div class="summary-icon">
                            <i class="bi bi-house-door"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card summary-card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Pendientes</h6>
                            <h3 class="card-title mb-0">18</h3>
                            <span class="small">5 urgentes</span>
                        </div>
                        <div class="summary-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card summary-card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Morosidad</h6>
                            <h3 class="card-title mb-0">4.2%</h3>
                            <span class="small"><i class="bi bi-arrow-down me-1"></i>2% vs mes anterior</span>
                        </div>
                        <div class="summary-icon">
                            <i class="bi bi-graph-down"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="row">
        <!-- Columna izquierda - Gráficos y actividad -->
        <div class="col-lg-8">
            <!-- Gráfico de ingresos -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-graph-up me-2"></i>Ingresos 2024
                    </h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown">
                            Este Año
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Este Mes</a></li>
                            <li><a class="dropdown-item" href="#">Últimos 3 Meses</a></li>
                            <li><a class="dropdown-item" href="#">Este Año</a></li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 300px;">
                        <!-- Aquí iría tu gráfico (Chart.js, etc.) -->
                        <div class="placeholder-chart d-flex align-items-center justify-content-center">
                            <div class="text-center">
                                <i class="bi bi-bar-chart display-4 text-muted mb-3"></i>
                                <p class="text-muted">Gráfico de ingresos mensuales</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actividad reciente -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clock-history me-2"></i>Actividad Reciente
                    </h5>
                </div>
                <div class="card-body">
                    <div class="activity-timeline">
                        @foreach (var activity in recentActivities)
                        {
                            <div class="activity-item @(activity.IsImportant ? "important" : "")">
                                <div class="activity-icon @activity.IconColor">
                                    <i class="bi @activity.Icon"></i>
                                </div>
                                <div class="activity-content">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-1">@activity.Title</h6>
                                        <small class="text-muted">@activity.Time</small>
                                    </div>
                                    <p class="mb-0 text-muted">@activity.Description</p>
                                    @if (!string.IsNullOrEmpty(activity.User))
                                    {
                                        <small class="text-muted">
                                            <i class="bi bi-person me-1"></i>@activity.User
                                        </small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna derecha - Accesos rápidos y estado -->
        <div class="col-lg-4">
            <!-- Accesos rápidos -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>Accesos Rápidos
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var quickAction in quickActions)
                        {
                            <div class="col-6">
                                <a href="@quickAction.Url" class="quick-action-card @quickAction.Color">
                                    <div class="text-center py-3">
                                        <i class="bi @quickAction.Icon display-5 mb-2"></i>
                                        <h6 class="mb-0">@quickAction.Title</h6>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Estado del edificio -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-building me-2"></i>Estado del Edificio
                    </h5>
                </div>
                <div class="card-body">
                    <div class="building-status">
                        <div class="status-item">
                            <div class="status-indicator bg-success"></div>
                            <div class="status-content">
                                <span>Electricidad</span>
                                <small class="text-muted">Normal</small>
                            </div>
                        </div>
                        <div class="status-item">
                            <div class="status-indicator bg-success"></div>
                            <div class="status-content">
                                <span>Agua</span>
                                <small class="text-muted">Normal</small>
                            </div>
                        </div>
                        <div class="status-item">
                            <div class="status-indicator bg-warning"></div>
                            <div class="status-content">
                                <span>Ascensores</span>
                                <small class="text-muted">1 en mantenimiento</small>
                            </div>
                        </div>
                        <div class="status-item">
                            <div class="status-indicator bg-danger"></div>
                            <div class="status-content">
                                <span>Seguridad</span>
                                <small class="text-muted">Cámara 3 offline</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Próximos vencimientos -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-calendar-event me-2"></i>Próximos Vencimientos
                    </h5>
                </div>
                <div class="card-body">
                    <div class="upcoming-due-list">
                        @foreach (var due in upcomingDues)
                        {
                            <div class="due-item @(due.IsUrgent ? "urgent" : "")">
                                <div class="due-date @due.DateColor">
                                    <span class="day">@due.Day</span>
                                    <span class="month">@due.Month</span>
                                </div>
                                <div class="due-content">
                                    <h6 class="mb-1">@due.Title</h6>
                                    <p class="mb-0 text-muted">@due.Description</p>
                                    <small class="text-muted">
                                        <i class="bi bi-building me-1"></i>@due.Unit
                                    </small>
                                </div>
                                <div class="due-amount">
                                    <span class="badge bg-light text-dark">@due.Amount</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección inferior - Tabla de últimos pagos -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-cash-coin me-2"></i>Últimos Pagos Registrados
                    </h5>
                    <a href="/pagos" class="btn btn-sm btn-outline-primary">Ver todos</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Unidad</th>
                                    <th>Propietario</th>
                                    <th>Concepto</th>
                                    <th>Monto</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in recentPayments)
                                {
                                    <tr>
                                        <td>@payment.Date.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge bg-primary">@payment.Unit</span>
                                        </td>
                                        <td>@payment.Owner</td>
                                        <td>@payment.Concept</td>
                                        <td class="fw-bold @(payment.Amount >= 0 ? "text-success" : "text-danger")">
                                            @payment.Amount.ToString("C")
                                        </td>
                                        <td>
                                            <span class="badge @payment.StatusClass">
                                                @payment.Status
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" title="Ver recibo">
                                                <i class="bi bi-receipt"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>