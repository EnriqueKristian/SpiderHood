    private string _userName = "";


    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🏠 Home.OnInitializedAsync - Iniciando");

        try
        {
            // Intentar obtener usuario varias veces
            UserSession? currentUser = null;
            int intentos = 0;
            const int maxIntentos = 5;

            while (currentUser == null && intentos < maxIntentos)
            {
                currentUser = await AuthService.GetCurrentUserAsync();

                if (currentUser == null)
                {
                    intentos++;
                    Console.WriteLine($"⚠️ Intento {intentos}/{maxIntentos} - Usuario no autenticado, esperando 500ms...");
                    await Task.Delay(500);
                }
                else
                {
                    Console.WriteLine($"✅ Usuario encontrado en intento {intentos}: {currentUser.Email}");
                    break;
                }
            }

            if (currentUser == null)
            {
                Console.WriteLine($"❌ Usuario no autenticado después de {maxIntentos} intentos - Redirigiendo a login");
                Navigation.NavigateTo("/login", true);
                return;
            }

            _userName = currentUser.FullName?.Split(' ')[0] ?? "Usuario";
            Console.WriteLine($"✅ Usuario autenticado: {_userName}");

            if (!currentUser.CurrentBuildingId.HasValue)
            {
                Console.WriteLine("⚠️ No hay edificio seleccionado - Redirigiendo a select-building");
                Navigation.NavigateTo("/select-building", true);
                return;
            }

            IdBuilding = currentUser.CurrentBuildingId.Value;
            Console.WriteLine($"🏢 Edificio seleccionado: {IdBuilding}");

            await LoadDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en OnInitializedAsync: {ex.Message}");
            _isLoading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();

            if (currentUser?.CurrentBuildingId != null &&
                currentUser.CurrentBuildingId.Value != IdBuilding)
            {
                Console.WriteLine($"🔄 Cambio de edificio detectado: {IdBuilding} -> {currentUser.CurrentBuildingId}");

                IdBuilding = currentUser.CurrentBuildingId.Value;
                _isDataLoaded = false;
                await LoadDashboardDataAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en OnParametersSetAsync: {ex.Message}");
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        // Prevenir múltiples cargas simultáneas
        if (_isLoading || _isDataLoaded)
        {
            Console.WriteLine($"⏭️ Carga omitida - _isLoading: {_isLoading}, _isDataLoaded: {_isDataLoaded}");
            return;
        }

        try
        {
            _isLoading = true;
            Console.WriteLine($"📊 Iniciando carga de datos para edificio: {IdBuilding}");

            // Cargar parámetros del edificio
            if (ParameterService.CurrentBuilding == null ||
                ParameterService.CurrentBuilding.IdBuilding != IdBuilding)
            {
                Console.WriteLine("📦 Cargando parámetros del edificio...");
                await ParameterService.LoadParametersAsync(IdBuilding);
                Console.WriteLine("✅ Parámetros cargados");
            }

            // Cargar estadísticas del dashboard
            Console.WriteLine("📈 Cargando estadísticas...");
            await LoadDashboardStatsAsync();
            Console.WriteLine("✅ Estadísticas cargadas");

            _isDataLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en LoadDashboardDataAsync: {ex.Message}");
            // Aquí podrías mostrar un mensaje de error al usuario
        }
        finally
        {
            _isLoading = false;
            Console.WriteLine("🏁 Carga de datos completada");
            StateHasChanged();
        }
    }

    private async Task LoadDashboardStatsAsync()
