@page "/incidents/{Id:guid}"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject IIncidentService IncidentService
@inject IWorkflowAuditService WorkflowAuditService
@inject SpiderHood.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Incidente</PageTitle>

<div class="container-fluid px-4 py-3">
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick='() => Navigation.NavigateTo("/incidents")'>
        <i class="bi bi-arrow-left me-1"></i>Volver
    </button>

    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@_incident.Title</h5>
                <span class="badge @StatusBadgeClass(_incident.Status)">@_incident.Status</span>
            </div>
            <div class="card-body">
                <p>@_incident.Description</p>
                <div class="row g-3 text-muted small">
                    <div class="col-md-3"><strong>Tipo:</strong> @(_incident.TypeName ?? "-")</div>
                    <div class="col-md-3"><strong>Prioridad:</strong> @(_incident.PriorityName ?? _incident.Priority.ToString())</div>
                    <div class="col-md-3"><strong>Unidad:</strong> @(_incident.UnitName ?? "Área común")</div>
                    <div class="col-md-3"><strong>Reportado por:</strong> @_incident.ReportedByName</div>
                    <div class="col-md-3"><strong>Asignado a:</strong> @(_incident.AssignedToName ?? "-")</div>
                    <div class="col-md-3"><strong>Reportado:</strong> @_incident.CreatedOn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    @if (_incident.ResolvedOn.HasValue)
                    {
                        <div class="col-md-3"><strong>Resuelto:</strong> @_incident.ResolvedOn.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    }
                    @if (_incident.ClosedOn.HasValue)
                    {
                        <div class="col-md-3"><strong>Cerrado:</strong> @_incident.ClosedOn.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    }
                </div>

                @if (_acciones.Count > 0)
                {
                    <hr />
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var accion in _acciones)
                        {
                            <button class="btn btn-sm @accion.CssClass" @onclick="() => IniciarAccion(accion.Status)">
                                @accion.Label
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h6 class="mb-0">Fotos / Videos</h6>
            </div>
            <div class="card-body">
                @if (_attachments.Count == 0)
                {
                    <p class="text-muted mb-3">Todavía no hay archivos adjuntos.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        @foreach (var adjunto in _attachments)
                        {
                            <div class="text-center" style="width: 140px;">
                                @{ var dataUri = DataUri(adjunto); }
                                @if (dataUri is null)
                                {
                                    <div class="border rounded d-flex align-items-center justify-content-center mb-1 bg-light" style="width:140px;height:140px;">
                                        <i class="bi bi-exclamation-triangle text-muted"></i>
                                    </div>
                                }
                                else if (EsImagen(adjunto.ContentType))
                                {
                                    <!-- Abre un lightbox EN LA MISMA página (no navega a la
                                         data: URI en una pestaña nueva) -- Chrome/Edge tienen
                                         un límite de tamaño para NAVEGAR a una URL data:, aunque
                                         mostrarla en un <img> inline funciona sin problema; hacer
                                         click en la miniatura navegando directo dejaba la pestaña
                                         nueva en blanco para cualquier foto de celular real. -->
                                    <img src="@dataUri" class="img-thumbnail mb-1" style="width:140px;height:140px;object-fit:cover;cursor:pointer;" alt="@adjunto.FileName" @onclick="() => AbrirLightbox(adjunto)" />
                                }
                                else if (EsVideo(adjunto.ContentType))
                                {
                                    <video src="@dataUri" class="img-thumbnail mb-1" style="width:140px;height:140px;object-fit:cover;" controls></video>
                                }
                                else
                                {
                                    <a href="@dataUri" download="@adjunto.FileName" class="d-block border rounded d-flex align-items-center justify-content-center mb-1 bg-light text-decoration-none" style="width:140px;height:140px;">
                                        <i class="bi bi-file-earmark-arrow-down fs-1 text-muted"></i>
                                    </a>
                                }
                                <div class="small text-truncate" title="@adjunto.FileName">@adjunto.FileName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    @adjunto.UploadedByName<br />
                                    @adjunto.UploadedOn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        }
                    </div>
                }

                <InputFile OnChange="SubirAdjunto" accept="image/*,video/mp4,video/quicktime" class="form-control" disabled="@_subiendoAdjunto" />
                <div class="form-text">Fotos (JPG, PNG, WEBP, HEIC) o video corto (MP4, MOV) -- máximo @(_maxAdjuntoMb) MB por archivo.</div>
                @if (_subiendoAdjunto)
                {
                    <div class="mt-2 text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Subiendo...</div>
                }
                @if (!string.IsNullOrWhiteSpace(_errorAdjunto))
                {
                    <div class="alert alert-danger mt-2 mb-0 py-2 px-3">@_errorAdjunto</div>
                }
            </div>
        </div>

        @if (_history.Count > 0)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h6 class="mb-0">Línea de tiempo</h6>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var entry in _history)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <span>
                                <strong>@HistoryActionLabel(entry.Action)</strong>
                                por @entry.PerformedBy
                                @if (!string.IsNullOrWhiteSpace(entry.Comment))
                                {
                                    <span class="text-muted"> — @entry.Comment</span>
                                }
                            </span>
                            <span class="text-muted small text-nowrap ms-2">@entry.PerformedOn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0">Comentarios</h6>
            </div>
            <div class="card-body">
                @if (_comments.Count == 0)
                {
                    <p class="text-muted mb-3">Todavía no hay comentarios.</p>
                }
                else
                {
                    <div class="mb-3">
                        @foreach (var comment in _comments)
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <div class="d-flex justify-content-between">
                                    <strong>@comment.AuthorName</strong>
                                    <span class="text-muted small">
                                        @comment.CreatedOn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (comment.IsInternal)
                                        {
                                            <span class="badge bg-secondary ms-1">Interno</span>
                                        }
                                    </span>
                                </div>
                                <p class="mb-0">@comment.Text</p>
                            </div>
                        }
                    </div>
                }

                <div class="mb-2">
                    <textarea class="form-control" rows="2" placeholder="Escribir un comentario..." @bind="_nuevoComentario"></textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    @if (_isStaff)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isInternal" @bind="_esInterno" />
                            <label class="form-check-label" for="isInternal">Nota interna (el residente no la ve)</label>
                        </div>
                    }
                    else
                    {
                        <span></span>
                    }
                    <button class="btn btn-sm btn-primary" @onclick="AgregarComentario" disabled="@string.IsNullOrWhiteSpace(_nuevoComentario)">
                        <i class="bi bi-send me-1"></i>Comentar
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@if (_showReasonModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Motivo del rechazo</h5>
                    <button type="button" class="btn-close" @onclick="CancelarAccion"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">¿Por qué se rechaza este incidente? (duplicado, no corresponde, etc.)</label>
                    <textarea class="form-control" rows="3" @bind="_motivoAccion"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelarAccion">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarAccionConMotivo" disabled="@string.IsNullOrWhiteSpace(_motivoAccion)">
                        Rechazar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_lightboxAdjunto is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85);" @onclick="CerrarLightbox">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0" @onclick:stopPropagation="true">
                <div class="modal-header border-0">
                    <span class="text-white">@_lightboxAdjunto.FileName</span>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarLightbox"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="@DataUri(_lightboxAdjunto)" class="img-fluid rounded" style="max-height: 80vh;" alt="@_lightboxAdjunto.FileName" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private record IncidentAction(IncidentStatus Status, string Label, string CssClass);

    private UserSession _currentUser = new();
    private bool _isStaff;
    private bool _isSysAdmin;
    private bool _loading = true;
    private Incident _incident = new();
    private List<IncidentComment> _comments = new();
    private List<WorkflowAuditEntry> _history = new();
    private string _nuevoComentario = string.Empty;
    private bool _esInterno;
    private List<IncidentAction> _acciones = new();
    private bool _showReasonModal;
    private string _motivoAccion = string.Empty;
    private IncidentStatus _accionPendiente;

    // Docs/Pendientes-Negocio-Consolidado.md #18a
    private List<IncidentAttachment> _attachments = new();
    // Bytes ya en base64 (data: URI) por adjunto -- se resuelven una vez al
    // cargar la página (CargarAsync), no en cada render. Simple para el piloto
    // (evita construir un endpoint HTTP autenticado aparte, ver comentario en
    // IIncidentService), a costa de mandar los bytes por el circuito de Blazor
    // Server -- aceptable mientras los adjuntos sean pocos y livianos (límite
    // configurado más abajo).
    private Dictionary<Guid, string> _attachmentDataUris = new();
    private bool _subiendoAdjunto;
    private string? _errorAdjunto;
    private int _maxAdjuntoMb => (Configuration.GetValue<int?>("IncidentAttachments:MaxSizeBytes") ?? 15 * 1024 * 1024) / 1024 / 1024;
    private IncidentAttachment? _lightboxAdjunto;

    // Bug real encontrado por el usuario probando adjuntos: navegar de un
    // incidente a OTRO (ej. Volver a la lista, entrar a uno distinto) reusaba
    // este mismo componente -- misma ruta "/incidents/{Id}" -- y como
    // OnInitializedAsync sólo corre UNA VEZ por instancia, la pantalla se
    // quedaba mostrando título/comentarios/fotos del incidente anterior
    // aunque el Id de la URL ya fuera otro (el archivo en disco del incidente
    // nuevo era el correcto -- lo que no se refrescaba era la pantalla).
    // OnParametersSetAsync sí corre en cada cambio de parámetro -- se
    // compara contra el último Id cargado para no recargar de más en el
    // primer render (OnParametersSetAsync también corre una vez justo
    // después de OnInitializedAsync).
    private Guid _loadedId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _isSysAdmin = _currentUser.Roles.Contains("SysAdmin");
        _isStaff = _currentUser.Roles.Contains("Administrador") || _isSysAdmin;

        await CargarAsync();
        _loadedId = Id;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _loadedId)
        {
            await CargarAsync();
            _loadedId = Id;
        }
    }

    private async Task CargarAsync()
    {
        _loading = true;
        _incident = await IncidentService.GetByIdAsync(Id);
        _comments = await IncidentService.GetCommentsAsync(Id);
        _history = await WorkflowAuditService.GetHistoryAsync("Incident", Id);
        await CargarAdjuntosAsync();

        // Un residente no ve las notas internas del staff.
        if (!_isStaff)
            _comments = _comments.Where(c => !c.IsInternal).ToList();

        CalcularAcciones();
        _loading = false;
    }

    private async Task CargarAdjuntosAsync()
    {
        _attachments = await IncidentService.GetAttachmentsAsync(Id);
        _attachmentDataUris.Clear();
        foreach (var adjunto in _attachments)
        {
            var bytes = await IncidentService.GetAttachmentContentAsync(adjunto);
            if (bytes is not null)
                _attachmentDataUris[adjunto.IdAttachment] = $"data:{adjunto.ContentType};base64,{Convert.ToBase64String(bytes)}";
        }
    }

    private string? DataUri(IncidentAttachment adjunto)
        => _attachmentDataUris.TryGetValue(adjunto.IdAttachment, out var uri) ? uri : null;

    private static bool EsImagen(string contentType) => contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    private static bool EsVideo(string contentType) => contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);

    private void AbrirLightbox(IncidentAttachment adjunto) => _lightboxAdjunto = adjunto;
    private void CerrarLightbox() => _lightboxAdjunto = null;

    private async Task SubirAdjunto(InputFileChangeEventArgs e)
    {
        _errorAdjunto = null;
        var file = e.File;
        if (file is null)
            return;

        _subiendoAdjunto = true;
        StateHasChanged();

        try
        {
            // Techo duro de transporte (50 MB) -- el límite real de negocio,
            // configurable, se valida adentro de IncidentService.UploadAttachmentAsync
            // (default 15 MB, ver _maxAdjuntoMb arriba). Sin esto, OpenReadStream
            // usa un default de sólo 512 KB y cualquier foto real fallaría antes
            // de llegar a la validación de negocio.
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            await IncidentService.UploadAttachmentAsync(
                Id, _incident.IdBuilding, file.Name, file.ContentType, memoryStream.ToArray(), _currentUser.IdUser);

            await CargarAdjuntosAsync();
        }
        catch (ArgumentException ex)
        {
            // Validación de negocio (tipo/tamaño) -- mensaje pensado para
            // mostrarse tal cual al usuario.
            _errorAdjunto = ex.Message;
        }
        catch (Exception ex)
        {
            _errorAdjunto = $"Error al subir el archivo: {ex.Message}";
        }
        finally
        {
            _subiendoAdjunto = false;
            StateHasChanged();
        }
    }

    // El ciclo de vida operativo (revisar/asignar/resolver) lo lleva
    // Administrador/SysAdmin, pero el CIERRE queda reservado para quien reportó
    // -- es quien confirma que el problema realmente se solucionó, mismo criterio
    // que usan la mayoría de sistemas de tickets (Zendesk, Jira Service Desk).
    // SysAdmin tiene un "Cerrar (administrativo)" aparte para el caso borde de
    // que el residente nunca responda. Junta (y cualquier otro rol) queda de
    // solo lectura, como se definió para este módulo.
    private void CalcularAcciones()
    {
        _acciones.Clear();
        var esReportante = _incident.ReportedBy == _currentUser.IdUser;

        if (_isStaff)
        {
            switch (_incident.Status)
            {
                case IncidentStatus.Reported:
                    _acciones.Add(new(IncidentStatus.InReview, "Revisar", "btn-info"));
                    _acciones.Add(new(IncidentStatus.Rejected, "Rechazar", "btn-outline-danger"));
                    break;
                case IncidentStatus.InReview:
                    _acciones.Add(new(IncidentStatus.InProgress, "Asignarme y comenzar", "btn-warning"));
                    _acciones.Add(new(IncidentStatus.Rejected, "Rechazar", "btn-outline-danger"));
                    break;
                case IncidentStatus.InProgress:
                    _acciones.Add(new(IncidentStatus.Resolved, "Marcar Resuelto", "btn-primary"));
                    break;
                case IncidentStatus.Reopened:
                    _acciones.Add(new(IncidentStatus.InProgress, "Reasignarme y continuar", "btn-warning"));
                    break;
                // Resolved: sin acciones para el staff -- queda esperando que el
                // reportante confirme o reabra (ver más abajo), salvo el override
                // de SysAdmin.
            }

            if (_isSysAdmin && (_incident.Status == IncidentStatus.Resolved || _incident.Status == IncidentStatus.Reopened))
            {
                _acciones.Add(new(IncidentStatus.Closed, "Cerrar (administrativo)", "btn-outline-success"));
            }
        }
        else if (esReportante && _incident.Status == IncidentStatus.Resolved)
        {
            _acciones.Add(new(IncidentStatus.Closed, "Confirmar cierre", "btn-success"));
            _acciones.Add(new(IncidentStatus.Reopened, "No está resuelto, reabrir", "btn-outline-danger"));
        }
    }

    private static string HistoryActionLabel(WorkflowAction action) => action switch
    {
        WorkflowAction.Submitted => "Reportado",
        WorkflowAction.Reviewed => "Revisado",
        WorkflowAction.Assigned => "Asignado",
        WorkflowAction.Resolved => "Resuelto",
        WorkflowAction.Closed => "Cerrado",
        WorkflowAction.Rejected => "Rechazado",
        WorkflowAction.Reopened => "Reabierto",
        _ => action.ToString()
    };

    // Rechazar pide motivo (se guarda en la línea de tiempo); el resto de las
    // transiciones se ejecutan directo, sin frenar al usuario con un modal.
    private async Task IniciarAccion(IncidentStatus nuevoEstado)
    {
        if (nuevoEstado == IncidentStatus.Rejected)
        {
            _accionPendiente = nuevoEstado;
            _motivoAccion = string.Empty;
            _showReasonModal = true;
            return;
        }

        await EjecutarAccion(nuevoEstado);
    }

    private void CancelarAccion()
    {
        _showReasonModal = false;
        _motivoAccion = string.Empty;
    }

    private async Task ConfirmarAccionConMotivo()
    {
        if (string.IsNullOrWhiteSpace(_motivoAccion))
            return;

        _showReasonModal = false;
        await EjecutarAccion(_accionPendiente, _motivoAccion);
    }

    private async Task EjecutarAccion(IncidentStatus nuevoEstado, string? comentario = null)
    {
        Guid? assignedTo = nuevoEstado == IncidentStatus.InProgress ? _currentUser.IdUser : null;

        await IncidentService.ChangeStatusAsync(
            Id, nuevoEstado, assignedTo, _currentUser.Email, _incident.IdBuilding, comentario);

        await CargarAsync();
    }

    private async Task AgregarComentario()
    {
        if (string.IsNullOrWhiteSpace(_nuevoComentario))
            return;

        await IncidentService.AddCommentAsync(Id, _currentUser.IdUser, _nuevoComentario, _isStaff && _esInterno);
        _nuevoComentario = string.Empty;
        _esInterno = false;
        await CargarAsync();
    }

    private static string StatusBadgeClass(IncidentStatus status) => status switch
    {
        IncidentStatus.Reported => "bg-secondary",
        IncidentStatus.InReview => "bg-info text-dark",
        IncidentStatus.InProgress => "bg-warning text-dark",
        IncidentStatus.Resolved => "bg-primary",
        IncidentStatus.Closed => "bg-success",
        IncidentStatus.Rejected => "bg-dark",
        IncidentStatus.Reopened => "bg-danger",
        _ => "bg-secondary"
    };
}
