@page "/incidents"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject IIncidentService IncidentService
@inject SpiderHood.Services.AuthService AuthService
@inject SpiderHood.Services.ParameterService ParameterService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Incidentes</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h1 class="h3 fw-bold mb-0">@(_isStaff ? "Incidentes" : "Mis Incidentes")</h1>
        </div>
        <button class="btn btn-primary" @onclick="AbrirNuevo">
            <i class="bi bi-plus-lg me-1"></i>Nuevo Incidente
        </button>
    </div>

    @if (_isStaff)
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <select class="form-select" @bind="_filtroEstado">
                    <option value="">Todos los estados</option>
                    @foreach (var status in Enum.GetValues<IncidentStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (IncidentesFiltrados.Count == 0)
    {
        <p class="text-muted">No hay incidentes para mostrar.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Tipo</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Unidad</th>
                        @if (_isStaff)
                        {
                            <th>Reportado por</th>
                            <th>Asignado a</th>
                        }
                        <th>Fecha</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incident in IncidentesFiltrados)
                    {
                        <tr style="cursor:pointer" @onclick="() => VerDetalle(incident.IdIncident)">
                            <td>@incident.Title</td>
                            <td>@(incident.TypeName ?? "-")</td>
                            <td><span class="badge @PriorityBadgeClass(incident.Priority)">@(incident.PriorityName ?? incident.Priority.ToString())</span></td>
                            <td><span class="badge @StatusBadgeClass(incident.Status)">@incident.Status</span></td>
                            <td>@(incident.UnitName ?? "Área común")</td>
                            @if (_isStaff)
                            {
                                <td>@incident.ReportedByName</td>
                                <td>@(incident.AssignedToName ?? "-")</td>
                            }
                            <td>@incident.CreatedOn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick:stopPropagation="true" @onclick="() => VerDetalle(incident.IdIncident)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2 text-primary"></i>Nuevo Incidente</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <EditForm Model="@_nuevo" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Título</label>
                            <InputText class="form-control" @bind-Value="_nuevo.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_nuevo.Description" />
                        </div>
                        @if (_tiposIncidenteWarning != null || _prioridadesIncidenteWarning != null)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                @if (_tiposIncidenteWarning != null)
                                {
                                    <div>@_tiposIncidenteWarning</div>
                                }
                                @if (_prioridadesIncidenteWarning != null)
                                {
                                    <div>@_prioridadesIncidenteWarning</div>
                                }
                            </div>
                        }
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tipo</label>
                                <InputSelect class="form-select" @bind-Value="_nuevo.Type" disabled="@(_tiposIncidente.Count == 0)">
                                    @foreach (var tipo in _tiposIncidente)
                                    {
                                        <option value="@tipo.Value">@tipo.ShortDescription</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Prioridad</label>
                                <InputSelect class="form-select" @bind-Value="_nuevo.Priority" disabled="@(_prioridadesIncidente.Count == 0)">
                                    @foreach (var prioridad in _prioridadesIncidente)
                                    {
                                        <option value="@prioridad.Value">@prioridad.ShortDescription</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fotos / Video (opcional)</label>
                            <InputFile OnChange="SeleccionarAdjuntosNuevos" multiple accept="image/*,video/mp4,video/quicktime" class="form-control" />
                            <div class="form-text">Fotos (JPG, PNG, WEBP, HEIC) o video corto (MP4, MOV) -- máximo @_maxAdjuntoMb MB por archivo.</div>
                            @if (!string.IsNullOrWhiteSpace(_errorAdjuntoNuevo))
                            {
                                <div class="alert alert-danger mt-2 mb-0 py-2 px-3">@_errorAdjuntoNuevo</div>
                            }
                            @if (_adjuntosNuevos.Count > 0)
                            {
                                <ul class="list-group mt-2">
                                    @foreach (var adjunto in _adjuntosNuevos)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                            <span class="text-truncate">
                                                @adjunto.FileName
                                                <span class="text-muted small">(@(adjunto.Content.Length / 1024) KB)</span>
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => QuitarAdjuntoNuevo(adjunto)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@(_tiposIncidente.Count == 0 || _prioridadesIncidente.Count == 0)">
                            <i class="bi bi-check-lg me-1"></i>Reportar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private UserSession _currentUser = new();
    private bool _isStaff;
    private bool _loading = true;
    private bool _showModal;
    private string _filtroEstado = string.Empty;
    private List<Incident> _incidents = new();
    private Incident _nuevo = new();

    // Docs/Pendientes-Negocio-Consolidado.md #18a -- adjuntos elegidos ANTES de
    // que el incidente exista de verdad en BD. Se guardan en memoria (no se
    // suben todavía) y recién se mandan a IncidentService.UploadAttachmentAsync
    // después de que ReportAsync confirma la creación (ver Guardar()) -- así,
    // si el usuario cierra el modal sin completar "Reportar", no queda ningún
    // archivo huérfano en storage.
    private record StagedAttachment(string FileName, string ContentType, byte[] Content);
    private List<StagedAttachment> _adjuntosNuevos = new();
    private string? _errorAdjuntoNuevo;
    private int _maxAdjuntoMb => (Configuration.GetValue<int?>("IncidentAttachments:MaxSizeBytes") ?? 15 * 1024 * 1024) / 1024 / 1024;

    // Tipo/Prioridad de Incidente ya no son enums fijos -- salen de la tabla
    // Parametros (grupos "Tipo Incidente"/"Prioridad Incidente", ver
    // Database/Scripts/2026-09-02_14_Seed_IncidentTypeAndPriorityParameters.sql),
    // así un Administrador puede agregar/desactivar valores sin tocar código.
    private List<Models.Parameter> _tiposIncidente = new();
    private List<Models.Parameter> _prioridadesIncidente = new();
    private string? _tiposIncidenteWarning;
    private string? _prioridadesIncidenteWarning;

    private List<Incident> IncidentesFiltrados =>
        string.IsNullOrEmpty(_filtroEstado)
            ? _incidents
            : _incidents.Where(i => i.Status.ToString() == _filtroEstado).ToList();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        // Junta tiene solo visibilidad (ve todo, igual que Administrador/SysAdmin, pero
        // sin botones de acción -- eso se resuelve en IncidentDetail.razor).
        _isStaff = _currentUser.Roles.Contains("Administrador") || _currentUser.Roles.Contains("Junta") || _currentUser.Roles.Contains("SysAdmin");

        await ParameterService.LoadParametersAsync(_currentUser.CurrentBuildingId);

        _tiposIncidente = ResolveGroupChildren("Tipo Incidente", out _tiposIncidenteWarning);
        _prioridadesIncidente = ResolveGroupChildren("Prioridad Incidente", out _prioridadesIncidenteWarning);

        await CargarAsync();
    }

    // Busca el grupo raíz de Parametros por ShortDescription y devuelve sus hijos
    // ACTIVOS. El match ignora mayúsculas/minúsculas y espacios de más -- si desde
    // /parameter alguien retocó el nombre del grupo (p.ej. "tipo incidente " con un
    // espacio de más), antes se perdía en silencio y el combo quedaba vacío sin dar
    // ninguna pista.
    //
    // Si hay más de un grupo con ese nombre (ej. el seed se corrió más de una vez),
    // entre los candidatos se prefiere el que realmente tenga hijos activos cargados
    // (y entre esos, el más reciente por IdTabla) -- no depende de que la BD esté
    // prolija.
    //
    // Si ningún candidato tiene hijos activos, devuelve la lista vacía y en
    // `warning` un mensaje explicando el motivo, para mostrarlo en el modal en vez
    // de dejar el combo vacío sin explicación.
    private List<Models.Parameter> ResolveGroupChildren(string groupShortDescription, out string? warning)
    {
        var candidatos = ParameterService.ListParameters
            .Where(p => p.IdParent == 0
                && p.ShortDescription != null
                && p.ShortDescription.Trim().Equals(groupShortDescription, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => p.IdTabla);

        foreach (var grupo in candidatos)
        {
            var hijosActivos = ParameterService.ListParameters
                .Where(p => p.IdParent == grupo.IdTabla && p.Estado == ParameterEstado.Activo)
                .OrderBy(p => p.Sort)
                .ToList();

            if (hijosActivos.Count > 0)
            {
                warning = null;
                return hijosActivos;
            }
        }

        warning = $"No se encontró el grupo de Parámetros \"{groupShortDescription}\" (o no tiene valores activos). " +
            "Revisa /parameter -- puede haberse renombrado o desactivado.";
        return new List<Models.Parameter>();
    }

    private async Task CargarAsync()
    {
        _loading = true;
        _incidents = _isStaff
            ? await IncidentService.GetIncidentsByBuildingAsync(_currentUser.CurrentBuildingId)
            : await IncidentService.GetMyIncidentsAsync(_currentUser.IdUser);
        _loading = false;
    }

    private void AbrirNuevo()
    {
        // Si quien reporta es Residente, se asocia automáticamente a SU unidad
        // (UserBuilding.IdGroupUnit) -- sin esto todo incidente quedaba marcado
        // como "Área común" sin importar quién lo reportara. Administrador/Junta/
        // SysAdmin no tienen una unidad propia, así que queda null (área común)
        // salvo que en el futuro se agregue un selector de unidad para ellos.
        var currentUserBuilding = _currentUser.Buildings
            .FirstOrDefault(b => b.Building?.IdBuilding == _currentUser.CurrentBuildingId);

        // Type/Priority necesitan arrancar en un Value real de la lista cargada --
        // si quedan en el 0 default de Incident y el usuario nunca toca esos
        // combos, se guardaría un valor que no matchea ninguna Categoría/Parámetro.
        _nuevo = new Incident
        {
            IdBuilding = _currentUser.CurrentBuildingId,
            ReportedBy = _currentUser.IdUser,
            IdGroupUnit = _isStaff ? null : currentUserBuilding?.IdGroupUnit,
            Type = _tiposIncidente.FirstOrDefault()?.Value ?? 0,
            Priority = _prioridadesIncidente.FirstOrDefault(p => p.ShortDescription == "Media")?.Value
                ?? _prioridadesIncidente.FirstOrDefault()?.Value ?? 0
        };
        _adjuntosNuevos.Clear();
        _errorAdjuntoNuevo = null;
        _showModal = true;
    }

    private void CerrarModal()
    {
        _showModal = false;
        _adjuntosNuevos.Clear();
        _errorAdjuntoNuevo = null;
    }

    // Sólo LEE los archivos elegidos y los guarda en memoria -- no sube nada
    // todavía (ver StagedAttachment arriba). Valida tipo/tamaño acá también
    // para dar feedback inmediato, pero la validación real (fuente de verdad)
    // es la de IncidentService.UploadAttachmentAsync al confirmar "Reportar".
    private async Task SeleccionarAdjuntosNuevos(InputFileChangeEventArgs e)
    {
        _errorAdjuntoNuevo = null;
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
        {
            try
            {
                // Techo duro de transporte -- el límite real y configurable se
                // aplica recién en IncidentService.UploadAttachmentAsync.
                using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                _adjuntosNuevos.Add(new StagedAttachment(file.Name, file.ContentType, memoryStream.ToArray()));
            }
            catch (Exception ex)
            {
                _errorAdjuntoNuevo = $"No se pudo leer \"{file.Name}\": {ex.Message}";
            }
        }
    }

    private void QuitarAdjuntoNuevo(StagedAttachment adjunto) => _adjuntosNuevos.Remove(adjunto);

    private async Task Guardar()
    {
        _nuevo.CreatedBy = _currentUser.Email;
        var incidenteCreado = await IncidentService.ReportAsync(_nuevo);

        // Los adjuntos se suben recién ACÁ, después de que el incidente ya
        // existe de verdad en BD (ver comentario de StagedAttachment arriba).
        // Un adjunto que falle la validación real no aborta la creación del
        // incidente, que ya quedó confirmada -- se manda al detalle para que
        // el usuario vea el error puntual y pueda reintentar desde ahí (mismo
        // uploader que ya tiene IncidentDetail.razor).
        var huboErrorAdjunto = false;
        foreach (var adjunto in _adjuntosNuevos)
        {
            try
            {
                await IncidentService.UploadAttachmentAsync(
                    incidenteCreado.IdIncident, incidenteCreado.IdBuilding,
                    adjunto.FileName, adjunto.ContentType, adjunto.Content, _currentUser.IdUser);
            }
            catch (Exception)
            {
                huboErrorAdjunto = true;
            }
        }

        _showModal = false;
        _adjuntosNuevos.Clear();

        if (huboErrorAdjunto)
        {
            Navigation.NavigateTo($"/incidents/{incidenteCreado.IdIncident}");
            return;
        }

        await CargarAsync();
    }

    private void VerDetalle(Guid id) => Navigation.NavigateTo($"/incidents/{id}");

    // Prioridad ya no es un enum -- es Parameter.Value dentro del grupo
    // "Prioridad Incidente" (seed: 1=Baja, 2=Media, 3=Alta, 4=Urgente). El
    // color asume ese orden ascendente de severidad -- si en /parameter se
    // reordenan los Value de este grupo, este mapeo se desincroniza.
    private static string PriorityBadgeClass(int priority) => priority switch
    {
        >= 4 => "bg-danger",
        3 => "bg-warning text-dark",
        2 => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private static string StatusBadgeClass(IncidentStatus status) => status switch
    {
        IncidentStatus.Reported => "bg-secondary",
        IncidentStatus.InReview => "bg-info text-dark",
        IncidentStatus.InProgress => "bg-warning text-dark",
        IncidentStatus.Resolved => "bg-primary",
        IncidentStatus.Closed => "bg-success",
        IncidentStatus.Rejected => "bg-dark",
        IncidentStatus.Reopened => "bg-danger",
        _ => "bg-secondary"
    };
}