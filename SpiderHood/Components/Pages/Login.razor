@page "/login"
@using SpiderHood.Models
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject Services.AuthService AuthService
@inject Services.ISessionRevocationService SessionRevocationService
@inject NavigationManager Navigation
@* Sin @rendermode: esta página se renderiza en modo estático (SSR), no interactivo.
   Es lo que permite que el submit sea una request HTTP real (no un evento de SignalR)
   y que HttpContext esté disponible como cascading parameter para poder hacer
   HttpContext.SignInAsync — eso es imposible desde un circuito InteractiveServer ya
   conectado, porque para ese entonces la respuesta HTTP original ya se cerró. *@

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 L12 21 M4 7 L20 7 M4 17 L20 17 M6 4 L18 20 M18 4 L6 20" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.55" />
                    <path d="M12 12 L12 5.2 M12 12 L18.2 8.6 M12 12 L18.2 15.4 M12 12 L12 18.8 M12 12 L5.8 15.4 M12 12 L5.8 8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                    <path d="M12 5.2 L15.4 6.6 L18.2 8.6 L19.4 12 L18.2 15.4 L15.4 17.4 L12 18.8 L8.6 17.4 L5.8 15.4 L4.6 12 L5.8 8.6 L8.6 6.6 Z" stroke="currentColor" stroke-width="1.1" opacity="0.6" fill="none" />
                </svg>
                <h2>SpiderHood</h2>
            </div>
            <p class="text-muted">Sistema de Administración de Edificios</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            <EditForm Model="@loginModel"
                      OnValidSubmit="@HandleLogin"
                      OnInvalidSubmit="@HandleInvalidSubmit"
                      FormName="loginForm">
                <!-- Mensajes de validación resumidos -->
                <div class="validation-summary-errors text-danger mb-3">
                    <ValidationSummary />
                </div>

                <!-- Campo Email -->
                <div class="form-group mb-3">
                    <label for="email" class="form-label">
                        <i class="bi bi-envelope me-2"></i>Email
                    </label>

                    <InputText id="email"
                               class="@(isEmailValid ? "form-control" : "form-control is-invalid")"
                               @bind-Value="loginModel!.Email"
                               placeholder="admin@spiderhood.com" />


                    <!-- Mensaje de error individual -->
                    <ValidationMessage For="@(() => loginModel.Email)" />
                </div>

                <!-- Campo Contraseña -->
                <div class="form-group mb-3">
                    <label for="password" class="form-label">
                        <i class="bi bi-lock me-2"></i>Contraseña
                    </label>
                    <InputText id="password"
                               type="password"
                               class="@(isPasswordValid ? "form-control" : "form-control is-invalid")"
                               @bind-Value="loginModel.Password"
                               placeholder="••••••••" />

                    <!-- Mensaje de error individual -->
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <!-- Checkbox Recordar sesión -->
                <div class="form-group mb-4">
                    <div class="form-check">
                        <InputCheckbox id="remember"
                                       class="form-check-input"
                                       @bind-Value="loginModel.RememberMe" />
                        <label for="remember" class="form-check-label">
                            Recordar sesión
                        </label>
                    </div>
                </div>

                <!-- Botón de envío -->
                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    <span>Iniciar Sesión</span>
                </button>
            </EditForm>

            <!-- Enlaces adicionales -->
            <div class="login-footer mt-4">
                <p class="mb-2">
                    <a href="/register" class="text-decoration-none">
                        <i class="bi bi-person-plus me-1"></i>¿No tienes cuenta? Regístrate
                    </a>
                </p>
                <p>
                    <a href="/forgot-password" class="text-decoration-none small">
                        <i class="bi bi-key me-1"></i>¿Olvidaste tu contraseña?
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    // [SupplyParameterFromForm] es lo que permite que, en el POST de este formulario
    // (procesado en modo estático, sin circuito), Blazor reconstruya loginModel a
    // partir de los valores enviados — no hay un circuito vivo que retenga el estado
    // entre el GET inicial y el POST.
    [SupplyParameterFromForm]
    private LoginModel? loginModel { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string errorMessage = string.Empty;

    // Flags para validación visual
    private bool isEmailValid => string.IsNullOrEmpty(loginModel?.Email) ||
                                 new EmailAddressAttribute().IsValid(loginModel.Email);

    private bool isPasswordValid => string.IsNullOrEmpty(loginModel?.Password) ||
                                     loginModel.Password.Length >= 6;

    protected override void OnInitialized()
    {
        // En el GET inicial no hay datos de formulario que "suplir"; en el POST,
        // [SupplyParameterFromForm] ya lo llenó antes de que esto corra.
        loginModel ??= new LoginModel();

        // Si ya hay una cookie de sesión válida, no tiene sentido mostrar el login --
        // por ejemplo, alguien que vino de la landing (plan de Suscripción),
        // /register-admin le mandó "ya tenés cuenta, iniciá sesión" con
        // ?returnUrl=/Settings, y hace click ya logueado.
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(GetSafeReturnUrl());
        }
    }

    // Sólo rutas locales ("/algo") -- nunca una URL externa ("https://...", "//evil.com")
    // que un link armado a mano pudiera intentar colar como open redirect.
    private string GetSafeReturnUrl()
    {
        var returnUrl = HttpContext.Request.Query["returnUrl"].ToString();
        return !string.IsNullOrEmpty(returnUrl) && returnUrl.StartsWith('/') && !returnUrl.StartsWith("//")
            ? returnUrl
            : "/dashboard";
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        var result = await AuthService.LoginAsync(loginModel!);

        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        var session = result.UserSession!;

        // Firmar la cookie de autenticación: esto SÍ funciona acá porque esta página
        // corre en modo estático — la request de este POST todavía tiene una respuesta
        // HTTP abierta donde escribir el Set-Cookie. Desde un circuito InteractiveServer
        // ya conectado (como era antes) esto no es posible.
        // "security_stamp": lo revalida Program.cs (OnValidatePrincipal) contra el
        // PasswordHash actual del usuario en cada verificación periódica — si no
        // coinciden, la contraseña cambió después de este login y la cookie se invalida.
        // Ver AuthService.GetSecurityStampAsync / RevokeAllSessions.
        var securityStamp = await AuthService.GetSecurityStampAsync(session.IdUser);

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, session.IdUser.ToString()),
            new(ClaimTypes.Email, session.Email),
            new(ClaimTypes.Name, session.FullName),
            new("security_stamp", securityStamp ?? string.Empty),
        };
        claims.AddRange(session.Roles.Select(role => new Claim(ClaimTypes.Role, role)));

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal, new AuthenticationProperties
        {
            IsPersistent = loginModel!.RememberMe,
            ExpiresUtc = DateTimeOffset.UtcNow.AddHours(8),
        });

        // El circuito que se cree al cargar "/" reconstruye el resto de la sesión
        // (edificios, edificio actual) desde la base de datos a partir de esta cookie
        // — ver CustomAuthenticationStateProvider / UserSessionLoader. Si el usuario no
        // tiene ningún edificio aprobado, o tiene varios, Home.razor.cs ya lo redirige
        // a /select-building (que a su vez ofrece /building-request si no tiene ninguno).
        Navigation.NavigateTo(GetSafeReturnUrl());
    }

    private void HandleInvalidSubmit()
    {
        errorMessage = "Por favor, corrige los errores del formulario.";
    }
}