@page "/login"
@using SpiderHood.Models
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel
@inject Services.AuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <i class="fas fa-building"></i>
                <h2>SpiderHood</h2>
            </div>
            <p class="text-muted">Sistema de Administración de Edificios</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (successMessage != null && successMessage.Length > 0 )
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>@successMessage
                </div>
            }

            <EditForm Model="@loginModel"
                      OnValidSubmit="@HandleLogin"
                      OnInvalidSubmit="@HandleInvalidSubmit"
                      Formname="loginForm">
                <!-- ← IMPORTANTE -->
                <!-- Mensajes de validación resumidos -->
                <div class="validation-summary-errors text-danger mb-3">
                    <ValidationSummary />
                </div>

                <!-- Campo Email -->
                <div class="form-group mb-3">
                    <label for="email" class="form-label">
                        <i class="fas fa-envelope me-2"></i>Email
                    </label>

                    <InputText id="email"
                               class="@(isEmailValid ? "form-control" : "form-control is-invalid")"
                               @bind-Value="loginModel.Email"
                               placeholder="admin@spiderhood.com" />


                    <!-- Mensaje de error individual -->
                    <ValidationMessage For="@(() => loginModel.Email)" />
                </div>

                <!-- Campo Contraseña -->
                <div class="form-group mb-3">
                    <label for="password" class="form-label">
                        <i class="fas fa-lock me-2"></i>Contraseña
                    </label>
                    <InputText id="password"
                               type="password"
                               class="@(isPasswordValid ? "form-control" : "form-control is-invalid")"
                               @bind-Value="loginModel.Password"
                               placeholder="••••••••" />

                    <!-- Mensaje de error individual -->
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <!-- Checkbox Recordar sesión -->
                <div class="form-group mb-4">
                    <div class="form-check">
                        <InputCheckbox id="remember"
                                       class="form-check-input"
                                       @bind-Value="loginModel.RememberMe" />
                        <label for="remember" class="form-check-label">
                            Recordar sesión
                        </label>
                    </div>
                </div>

                <!-- Botón de envío -->
                <button type="submit"
                        class="btn btn-primary w-100 py-2"
                        disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Iniciando sesión...</span>
                    }
                    else
                    {
                        <i class="fas fa-sign-in-alt me-2"></i>
                        <span>Iniciar Sesión</span>
                    }
                </button>
            </EditForm>

            <!-- Enlaces adicionales -->
            <div class="login-footer mt-4">
                <p class="mb-2">
                    <a href="/register" class="text-decoration-none">
                        <i class="fas fa-user-plus me-1"></i>¿No tienes cuenta? Regístrate
                    </a>
                </p>
                <p>
                    <a href="/forgot-password" class="text-decoration-none small">
                        <i class="fas fa-key me-1"></i>¿Olvidaste tu contraseña?
                    </a>
                </p>
            </div>
        </div>

        <div class="login-demo">
            <small class="text-muted">Demo: admin@spiderhood.com / Admin123!</small>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading;

    // Flags para validación visual
    private bool isEmailValid => string.IsNullOrEmpty(loginModel.Email) ||
                                 new EmailAddressAttribute().IsValid(loginModel.Email);

    private bool isPasswordValid => string.IsNullOrEmpty(loginModel.Password) ||
                                     loginModel.Password.Length >= 6;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var currentUser = AuthService.GetCurrentUserAsync();

            // Verificar si ya hay sesión activa
            if (currentUser.Result != null)
            {
                Navigation.NavigateTo("/dashboard");
            }

            // Limpiar modelo
            loginModel = new LoginModel();
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var result = await AuthService.LoginAsync(loginModel);

            if (result.Success)
            {
                successMessage = "¡Login exitoso! Redirigiendo...";
                StateHasChanged();

                await Task.Delay(100);

                // 🔴 FORZAR RECARGA COMPLETA Y LIMPIAR PRERENDERING
                Navigation.NavigateTo("/dashboard", true);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al iniciar sesión. Intenta nuevamente.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        errorMessage = "Por favor, corrige los errores del formulario.";
    }

    private async Task HandlePostLogin(UserSession session)
    {
        var approvedBuildings = session.Buildings.Where(b => b.IsApproved).ToList();

        if (!approvedBuildings.Any())
        {
            Navigation.NavigateTo("/building-request");
        }
        else if (approvedBuildings.Count == 1)
        {
            await AuthService.SetCurrentBuilding(approvedBuildings.First().Building!.IdBuilding);
            Navigation.NavigateTo("/dashboard", true);
        }
        else
        {
            Navigation.NavigateTo("/select-building");
        }
    }
}