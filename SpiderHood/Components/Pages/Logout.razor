@page "/logout"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@* Sin @rendermode: igual que Login.razor, necesita correr en modo estático para que
   HttpContext.SignOutAsync pueda escribir el Set-Cookie que borra la sesión — eso no
   es posible desde un circuito InteractiveServer ya conectado. *@

<div class="logout-container">
    <div class="logout-card">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Cerrando sesión...</span>
            </div>
            <h4 class="mb-0">Cerrando sesión...</h4>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        Navigation.NavigateTo("/login");
    }
}