@page "/migracion/plantillas"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject IMigrationTemplateService MigrationTemplateService
@inject IMigrationImportService MigrationImportService
@inject Services.ParameterService ParameterService
@inject Services.AuthService AuthService
@inject Services.IPermissionService PermissionService
@inject IJSRuntime JSRuntime

<div class="container-fluid px-4 py-3">
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-file-earmark-arrow-down"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Plantillas de Carga Histórica</h1>
                <p class="text-muted mb-0">
                    Para migrar el historial de un edificio que llevaba su control en Excel u otro sistema.
                    Cada plantilla ya trae, en sus listas desplegables, las unidades, cuentas bancarias y
                    categorías registradas en <strong>@(ParameterService.CurrentBuilding?.Name ?? "este edificio")</strong>.
                </p>
            </div>
        </div>
    </div>

    @if (!_canManage)
    {
        <div class="alert alert-warning">
            <i class="bi bi-lock me-2"></i>No tiene permiso para descargar plantillas de migración.
        </div>
    }
    else
    {
        <div class="alert alert-light border mb-3 small">
            <i class="bi bi-signpost-split me-2"></i>
            Empiece por <strong>Unidades y Propietarios</strong> -- las otras 4 plantillas asumen que las unidades y
            propietarios de este edificio ya están cargados, y jalan sus datos para armar los desplegables.
        </div>

        <div class="row g-3">

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 border-primary">
                    <div class="card-body d-flex flex-column">
                        <div class="icon-badge icon-badge-sm mb-3"><i class="bi bi-people"></i></div>
                        <h5 class="card-title">Unidades y Propietarios</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Departamentos, oficinas, estacionamientos, depósitos y sus propietarios -- el punto de partida.
                        </p>
                        <button class="btn btn-primary" @onclick="DescargarUnidadesYPropietarios" disabled="@_descargando">
                            <i class="bi bi-download me-2"></i>Descargar plantilla
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="icon-badge icon-badge-sm mb-3"><i class="bi bi-receipt"></i></div>
                        <h5 class="card-title">Cuotas y Pagos</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Cuotas ordinarias y extraordinarias generadas históricamente, con sus pagos.
                        </p>
                        <button class="btn btn-outline-primary" @onclick="DescargarCuotasYPagos" disabled="@_descargando">
                            <i class="bi bi-download me-2"></i>Descargar plantilla
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="icon-badge icon-badge-sm mb-3"><i class="bi bi-bank"></i></div>
                        <h5 class="card-title">Estado de Cuenta</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Movimientos bancarios históricos (ingresos y egresos) de todas las cuentas del edificio.
                        </p>
                        <button class="btn btn-outline-primary" @onclick="DescargarEstadoDeCuenta" disabled="@_descargando">
                            <i class="bi bi-download me-2"></i>Descargar plantilla
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="icon-badge icon-badge-sm mb-3"><i class="bi bi-droplet"></i></div>
                        <h5 class="card-title">Lecturas de Agua</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Historial de lecturas del medidor de agua por unidad y periodo.
                        </p>
                        <button class="btn btn-outline-primary" @onclick="DescargarLecturasAgua" disabled="@_descargando">
                            <i class="bi bi-download me-2"></i>Descargar plantilla
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="icon-badge icon-badge-sm mb-3"><i class="bi bi-pie-chart"></i></div>
                        <h5 class="card-title">Presupuesto Histórico</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Ítems de presupuesto por periodo (mes), la base de cada cuota generada.
                        </p>
                        <button class="btn btn-outline-primary" @onclick="DescargarPresupuestoHistorico" disabled="@_descargando">
                            <i class="bi bi-download me-2"></i>Descargar plantilla
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <div class="alert alert-light border mt-4 small">
            <i class="bi bi-info-circle me-2"></i>
            Estas plantillas son solo para <strong>carga inicial de historial</strong>. Para el día a día
            (un estado de cuenta o una lectura de agua por periodo) use los importadores habituales de cada módulo.
        </div>

        <h5 class="mt-4 mb-2">Importar</h5>
        @foreach (var imp in _importadores)
        {
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-upload"></i>
                    <strong>@imp.Titulo</strong>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Suba el archivo <code>@imp.NombrePlantilla</code> ya completado. Se valida todo primero --
                        si hay algún error, no se guarda nada de esta plantilla.
                    </p>

                    <InputFile id="@imp.InputId" OnChange="@(e => CargarArchivo(imp, e))" accept=".xlsx" style="display:none;" />
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <button class="btn btn-outline-secondary" @onclick="@(() => AbrirSelectorArchivo(imp.InputId))" disabled="@imp.Importando">
                            <i class="bi bi-folder2-open me-2"></i>Seleccionar archivo
                        </button>
                        <span class="text-muted small">@(imp.ArchivoNombre ?? "Ningún archivo seleccionado")</span>
                        <button class="btn btn-success ms-auto" @onclick="@(() => EjecutarImport(imp))" disabled="@(imp.Archivo == null || imp.Importando)">
                            @if (imp.Importando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-check2-circle me-2"></i>Importar
                        </button>
                    </div>

                    @if (imp.Resultado != null)
                    {
                        <div class="alert @(imp.Resultado.Success ? "alert-success" : "alert-danger") mb-2">
                            <div class="fw-bold mb-1">@(imp.Resultado.Success ? imp.MensajeExito(imp.Resultado) : "No se importó nada -- corrija los errores y vuelva a intentar.")</div>
                            @if (imp.Resultado.Errores.Count > 0)
                            {
                                <ul class="mb-0 small">
                                    @foreach (var e in imp.Resultado.Errores)
                                    {
                                        <li>@e</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                    @if (imp.Resultado?.Advertencias.Count > 0)
                    {
                        <div class="alert alert-warning small mb-0">
                            <ul class="mb-0">
                                @foreach (var a in imp.Resultado.Advertencias)
                                {
                                    <li>@a</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _canManage;
    private bool _descargando;
    private List<ImportadorState> _importadores = new();

    private class ImportadorState
    {
        public string Titulo { get; set; } = "";
        public string NombrePlantilla { get; set; } = "";
        public string InputId { get; set; } = "";
        public IBrowserFile? Archivo { get; set; }
        public string? ArchivoNombre { get; set; }
        public bool Importando { get; set; }
        public MigrationImportResult? Resultado { get; set; }
        public Func<Guid, Stream, Task<MigrationImportResult>> Importar { get; set; } = default!;
        public Func<MigrationImportResult, string> MensajeExito { get; set; } = default!;
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        _canManage = await PermissionService.HasPermissionAsync(currentUser, "edit_building");

        _importadores = new List<ImportadorState>
        {
            new()
            {
                Titulo = "Unidades y Propietarios",
                NombrePlantilla = "Plantilla_UnidadesYPropietarios",
                InputId = "fileInputUnidades",
                Importar = MigrationImportService.ImportarUnidadesYPropietariosAsync,
                MensajeExito = r => $"Importado: {r.UnidadesCreadas} unidad(es), {r.PropietariosCreados} propietario(s)."
            },
            new()
            {
                Titulo = "Lecturas de Agua",
                NombrePlantilla = "Plantilla_LecturasAgua",
                InputId = "fileInputLecturas",
                Importar = MigrationImportService.ImportarLecturasAguaAsync,
                MensajeExito = r => $"Importado: {r.LecturasCreadas} lectura(s)."
            },
            new()
            {
                Titulo = "Presupuesto Histórico",
                NombrePlantilla = "Plantilla_PresupuestoHistorico",
                InputId = "fileInputPresupuesto",
                Importar = MigrationImportService.ImportarPresupuestoHistoricoAsync,
                MensajeExito = r => $"Importado: {r.PresupuestosCreados} presupuesto(s), {r.ItemsPresupuestoCreados} ítem(s)."
            },
            new()
            {
                Titulo = "Cuotas y Pagos",
                NombrePlantilla = "Plantilla_CuotasYPagos",
                InputId = "fileInputCuotas",
                Importar = MigrationImportService.ImportarCuotasYPagosAsync,
                MensajeExito = r => $"Importado: {r.CuotasCreadas} cuota(s), {r.PagosCreados} pago(s)."
            },
            new()
            {
                Titulo = "Estado de Cuenta",
                NombrePlantilla = "Plantilla_EstadoDeCuenta",
                InputId = "fileInputEstadoCuenta",
                Importar = MigrationImportService.ImportarEstadoDeCuentaAsync,
                MensajeExito = r => $"Importado: {r.MovimientosCreados} movimiento(s)."
            }
        };
    }

    private Guid IdBuilding => ParameterService.CurrentBuilding?.IdBuilding ?? Guid.Empty;

    private async Task AbrirSelectorArchivo(string inputId)
    {
        await JSRuntime.InvokeVoidAsync("clickElement", inputId);
    }

    private void CargarArchivo(ImportadorState imp, InputFileChangeEventArgs e)
    {
        imp.Archivo = e.File;
        imp.ArchivoNombre = e.File.Name;
        imp.Resultado = null;
    }

    private async Task EjecutarImport(ImportadorState imp)
    {
        if (imp.Archivo == null) return;

        if (IdBuilding == Guid.Empty)
        {
            await ShowToast("Sin edificio seleccionado", "Seleccione un edificio antes de importar.", "warning");
            return;
        }

        try
        {
            imp.Importando = true;
            imp.Resultado = null;

            using var stream = imp.Archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            imp.Resultado = await imp.Importar(IdBuilding, memoryStream);

            if (imp.Resultado.Success)
                await ShowToast("Importación completada", imp.MensajeExito(imp.Resultado), "success");
            else
                await ShowToast("La importación no se aplicó", "Hay errores de validación -- revise el detalle debajo del botón.", "danger");
        }
        catch (Exception ex)
        {
            await ShowToast("Error al importar", ex.Message, "danger");
        }
        finally
        {
            imp.Importando = false;
        }
    }

    private async Task DescargarUnidadesYPropietarios()
        => await Descargar(() => MigrationTemplateService.GenerarPlantillaUnidadesYPropietariosAsync(IdBuilding));

    private async Task DescargarCuotasYPagos()
        => await Descargar(() => MigrationTemplateService.GenerarPlantillaCuotasYPagosAsync(IdBuilding));

    private async Task DescargarEstadoDeCuenta()
        => await Descargar(() => MigrationTemplateService.GenerarPlantillaEstadoDeCuentaAsync(IdBuilding));

    private async Task DescargarLecturasAgua()
        => await Descargar(() => MigrationTemplateService.GenerarPlantillaLecturasAguaAsync(IdBuilding));

    private async Task DescargarPresupuestoHistorico()
        => await Descargar(() => MigrationTemplateService.GenerarPlantillaPresupuestoHistoricoAsync(IdBuilding));

    private async Task Descargar(Func<Task<(string FileName, byte[] Bytes)>> generar)
    {
        if (IdBuilding == Guid.Empty)
        {
            await ShowToast("Sin edificio seleccionado", "Seleccione un edificio antes de descargar una plantilla.", "warning");
            return;
        }

        try
        {
            _descargando = true;
            var (fileName, bytes) = await generar();
            await JSRuntime.InvokeVoidAsync("descargarArchivo", fileName, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            await ShowToast("Error al generar plantilla", ex.Message, "danger");
        }
        finally
        {
            _descargando = false;
        }
    }

    private async Task ShowToast(string title, string message, string type)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showToast", title, message, type);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando toast: {ex.Message}");
        }
    }
}
