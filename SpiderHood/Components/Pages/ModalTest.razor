
<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.45);
        /*display: none;*/
        justify-content: center;
        align-items: center;
        display: flex;
        z-index: 1050;
    }

    /* Contenedor principal del modal */
    .modal-container {
        background-color: #ffffff;
        border-radius: 12px;
        padding: 16px 18px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
        max-height: 90vh;
        overflow: hidden;
        box-sizing: border-box;
        /* Para pantallas grandes: tamaño tipo “card” centrada */
        width: 130%;
        max-width: 680px;
    }

    /* Header, body y footer */
    .modal-header {
        margin-bottom: 10px;
    }

        .modal-header h2 {
            font-size: 1.2rem;
            margin: 0;
        }

    .modal-body {
        flex: 1;
        overflow-y: auto;
        padding-right: 4px;
        margin-bottom: 12px;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    /* Formulario */
    .form-group {
        margin-bottom: 12px;
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

    .input-control {
        width: 100%;
        box-sizing: border-box;
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid #d0d0d0;
        font-size: 0.95rem;
    }

    /* Monto */
    .monto-wrapper {
        display: flex;
        align-items: center;
        border-radius: 6px;
        border: 1px solid #d0d0d0;
        padding: 4px 8px;
        box-sizing: border-box;
    }

    .moneda {
        margin-right: 6px;
        font-weight: 600;
        font-size: 1rem;
    }

    .monto-input {
        border: none;
        padding: 4px 0;
        outline: none;
    }

    /* Opciones de radio */
    .radio-option {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 6px;
    }

        .radio-option input[type="radio"] {
            margin-top: 4px;
        }

    .radio-label {
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

    .radio-title {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .radio-subtitle {
        font-size: 0.8rem;
        color: #666;
    }

    /* Botones (puedes ajustarlos a tu estilo) */
    .btn {
        border-radius: 6px;
        border: none;
        padding: 8px 14px;
        font-size: 0.9rem;
        cursor: pointer;
    }

    .btn-primary {
        background-color: #2563eb;
        color: white;
    }

        .btn-primary:disabled {
            background-color: #9ca3af;
            cursor: not-allowed;
        }

    .btn-secondary {
        background-color: #e5e7eb;
        color: #111827;
    }

    /* RESPONSIVE */
    /* Móviles: modal ocupa casi toda la pantalla */
    /*
    media (max-width: 600px) {
        .modal-container {
            width: 100%;
            height: 100%;
            max-width: none;
            max-height: none;
            border-radius: 0;
            margin: 0;
        }

        .modal-body {
            padding-right: 2px;
        }
    }*/

    /* Tablets / pantallas medianas */
    /*
    media (min-width: 601px) and (max-width: 1024px) {
        .modal-container {
            width: 90%;
            max-width: 540px;
            max-height: 90vh;
        }
    }
    */

</style>

@* Modal de Agregar Gasto, responsive *@
@if(IsOpen){
<div class="modal-backdrop">
    <div class="modal-container">
        <div class="modal-header">
            <h2>Agregar Gasto</h2>
        </div>

        <div class="modal-body">
            <div class="form-group">
                <label for="categoria">Categoría</label>
                <select id="categoria" class="input-control" @bind="Categoria">
                    <option value="">Seleccionar categoría</option>
                    <option value="servicios">Servicios</option>
                    <option value="alimentos">Alimentos</option>
                    <option value="otros">Otros</option>
                </select>
            </div>

            <div class="form-group">
                <label for="descripcion">Descripción</label>
                <input id="descripcion"
                       class="input-control"
                       placeholder="Ej: Consumo Enero 2025"
                       @bind="Descripcion" />
            </div>

            <div class="form-group">
                <label for="monto">Monto</label>
                <div class="monto-wrapper">
                    <span class="moneda">$</span>
                    <input id="monto"
                           type="number"
                           step="0.01"
                           class="input-control monto-input"
                           @bind="Monto" />
                </div>
            </div>

            <div class="form-group">
                <label for="fecha">Fecha</label>
                <input id="fecha"
                       type="date"
                       class="input-control"
                       @bind="Fecha" />
            </div>

            <div class="form-group">
                <label>Tipo de Distribución</label>

                <div class="radio-option">
                    <input type="radio"
                           id="distFijo"
                           name="tipoDistribucion"
                           @bind="TipoDistribucion" />
                    <label for="distFijo" class="radio-label">
                        <span class="radio-title">Fijo</span>
                        <span class="radio-subtitle">Se divide en partes iguales entre todos</span>
                    </label>
                </div>

                <div class="radio-option">
                    <input type="radio"
                           id="distProporcional"
                           name="tipoDistribucion"
                           @bind="TipoDistribucion" />
                    <label for="distProporcional" class="radio-label">
                        <span class="radio-title">Proporcional</span>
                        <span class="radio-subtitle">Según el porcentaje de área</span>
                    </label>
                </div>
            </div>

            <div class="radio-option">
                    <input type="radio"
                           id="distProporcional"
                           name="tipoDistribucion"
                           @bind="TipoDistribucion" />
                    <label for="distProporcional" class="radio-label">
                        <span class="radio-title">Proporcional</span>
                        <span class="radio-subtitle">Según el porcentaje de área</span>
                    </label>
            </div>

        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="Cancelar">
                Cancelar
            </button>
            <button class="btn btn-primary" @onclick="Agregar" disabled="@(!FormularioValido)">
                Agregar
            </button>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public EventCallback OnAgregar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    public string? Categoria { get; set; }
    public string? Descripcion { get; set; }
    public decimal Monto { get; set; }
    public DateTime Fecha { get; set; } = DateTime.Today;
    public string TipoDistribucion { get; set; } = "Fijo";

    bool FormularioValido =>
        !string.IsNullOrWhiteSpace(Categoria)
        && !string.IsNullOrWhiteSpace(Descripcion)
        && Monto > 0;

    private async Task Cancelar()
    {
        await IsOpenChanged.InvokeAsync(false);
        if (OnCancelar.HasDelegate)
            await OnCancelar.InvokeAsync();
    }

    private async Task Agregar()
    {
        if (!FormularioValido)
            return;

        if (OnAgregar.HasDelegate)
            await OnAgregar.InvokeAsync();

        await IsOpenChanged.InvokeAsync(false);
    }
}
