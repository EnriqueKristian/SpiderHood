@page "/movement/detail/{IdStatementHeader:guid}"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@inject IBankAccountService BankAccountService
@inject IInstallmentService InstallmentService
@inject IExpenseService ExpenseService
@inject IWorkflowAuditService WorkflowAuditService
@inject SpiderHood.Services.AuthService AuthService
@inject IPermissionService PermissionService
@using SpiderHood.Components.Pages.Components

<PageTitle>Detalle de Estado de Cuenta</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="page-header mb-4">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-file-earmark-excel"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">@(header?.FileName ?? "Detalle de Carga")</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/movement">Estados de Cuenta</a></li>
                        <li class="breadcrumb-item active">
                            @if (header != null)
                            {
                                @($"{GetNombreCuenta(header.IdBankAccount)} · Cargado {header.UploadDate:dd/MM/yyyy HH:mm}")
                            }
                            else
                            {
                                @:Detalle
                            }
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-outline-secondary" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    @if (cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (accesoDenegado)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-shield-lock display-4 d-block mb-3"></i>
                            No se encontró ese estado de cuenta para el edificio actual.
                        </div>
                    }
                    else if (!detallesCompletos.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-3"></i>
                            No hay movimientos para este estado de cuenta
                        </div>
                    }
                    else
                    {
                        @if (_puedeRevertirMasivo && UnidadesConciliadasEnArchivo.Any())
                        {
                            @* Deshacer Conciliación en Masa -- permiso nuevo y separado del que ya
                               gatea el "Corregir" de a una fila (Database/Scripts/2026-09-24_144_
                               CondonarDeuda_Feature.sql). Solo afecta Ingresos (cuotas) -- los Gastos
                               conciliados de este mismo archivo se deshacen aparte, a mano, fila por
                               fila, como ya se podía hacer antes. *@
                            <div class="card border-danger-subtle mb-4">
                                <div class="card-body py-2">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _mostrarPanelMasivo = !_mostrarPanelMasivo">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Deshacer Conciliación en Masa
                                        </button>
                                        @if (_mostrarPanelMasivo)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="SeleccionarTodasLasUnidadesMasivo">
                                                    Seleccionar todo el archivo
                                                </button>
                                                <button class="btn btn-sm btn-danger" disabled="@(!_unidadesSeleccionadasMasivo.Any())"
                                                        @onclick="AbrirRevertirMasivo">
                                                    Deshacer @_unidadesSeleccionadasMasivo.Count unidad(es) seleccionada(s)
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    @if (_mostrarPanelMasivo)
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            @foreach (var unidad in UnidadesConciliadasEnArchivo)
                                            {
                                                <div class="form-check form-check-inline border rounded px-2 py-1">
                                                    <input class="form-check-input" type="checkbox" id="@($"unidad-masivo-{unidad}")"
                                                           checked="@_unidadesSeleccionadasMasivo.Contains(unidad)"
                                                           @onchange="(e) => ToggleUnidadMasivo(unidad, (bool)e.Value!)" />
                                                    <label class="form-check-label" for="@($"unidad-masivo-{unidad}")">DPTO @unidad</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Filtros -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold mb-1">Estado</label>
                                <select class="form-select" @bind="filtroEstado" @bind:after="AplicarFiltros">
                                    <option value="">Todos los estados</option>
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Parcial">Parcial</option>
                                    <option value="Conciliado">Conciliado</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold mb-1">Monto mín.</label>
                                <input type="number" class="form-control" step="0.01"
                                       @bind="filtroMontoMin" @bind:event="oninput" @bind:after="AplicarFiltros" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold mb-1">Monto máx.</label>
                                <input type="number" class="form-control" step="0.01"
                                       @bind="filtroMontoMax" @bind:event="oninput" @bind:after="AplicarFiltros" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold mb-1">Descripción</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0">
                                        <i class="bi bi-search text-muted"></i>
                                    </span>
                                    <input type="text" class="form-control border-start-0"
                                           placeholder="Buscar por descripción..."
                                           @bind="filtroDescripcion" @bind:event="oninput" @bind:after="AplicarFiltros" />
                                </div>
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button class="btn btn-outline-secondary w-100" title="Limpiar filtros" @onclick="LimpiarFiltros">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>

                        @if (!pagination.AllData.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-search display-4 d-block mb-3"></i>
                                Ningún movimiento coincide con los filtros aplicados
                            </div>
                        }
                        else
                        {
                        <!-- Encabezado con estadísticas y selector de página -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                            <p class="text-muted mb-0">
                                Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords registros
                            </p>
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-muted">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                                    <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                                    <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                                    <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                                    <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                                </select>
                            </div>
                        </div>

                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Fecha</th>
                                        <th>Descripción</th>
                                        <th>Moneda</th>
                                        <th>Monto</th>
                                        <th>Estado</th>
                                        <th>Aplicado a</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in pagination.CurrentPageData)
                                    {
                                        <tr>
                                            <td class="ps-3">@item.StatementDate.ToString("dd/MM/yyyy")</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <span class="badge @(item.Currency == "USD" ? "bg-info" : "bg-success")">@item.Currency</span>
                                            </td>
                                            <td class="fw-semibold @(item.Amount >= 0 ? "text-success" : "text-danger")">
                                                @item.Amount.ToString("C",
                                                    System.Globalization.CultureInfo.CreateSpecificCulture(item.Currency == "USD" ? "en-US" : "es-PE"))
                                            </td>
                                            <td>
                                                @if (item.ReconciliationStatus == ReconciliationType.Conciliada)
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check me-1"></i>Conciliado</span>
                                                }
                                                else if (item.ReconciliationStatus == ReconciliationType.Parcial)
                                                {
                                                    <span class="badge bg-info text-dark"><i class="bi bi-hourglass-split me-1"></i>Parcial</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning"><i class="bi bi-clock me-1"></i>Pendiente</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@ResumenAplicacion(item)</td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    @if (item.ReconciliationStatus == ReconciliationType.Conciliada || item.ReconciliationStatus == ReconciliationType.Parcial)
                                                    {
                                                        <button class="btn btn-outline-info" title="Ver cómo se aplicó"
                                                                @onclick="() => VerDetalleAplicacion(item)">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                    }
                                                    @if (item.ReconciliationStatus == ReconciliationType.Conciliada && _puedeCorregir)
                                                    {
                                                        <button class="btn btn-outline-danger"
                                                                title="Corregir/Revertir (requiere motivo, queda en el log de auditoría)"
                                                                @onclick="() => RevertirConciliacion(item)">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        @if (pagination.TotalPages > 1)
                        {
                            <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top">
                                <div class="text-muted">
                                    Página @pagination.CurrentPage de @pagination.TotalPages
                                </div>

                                <nav aria-label="Paginación de resultados">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </a>
                                        </li>
                                        <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>

                                        @foreach (var pageNum in pagination.GetPageNumbers())
                                        {
                                            if (pageNum == -1)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                    <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">
                                                        @pageNum
                                                    </a>
                                                </li>
                                            }
                                        }

                                        <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                        <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>

                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Ir a:</span>
                                    <input type="number" class="form-control form-control-sm"
                                           style="width: 70px;"
                                           min="1" max="@pagination.TotalPages"
                                           @bind="jumpToPage"
                                           @bind:event="oninput" />
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="JumpToPage"
                                            disabled="@(jumpToPage < 1 || jumpToPage > pagination.TotalPages)">
                                        Ir
                                    </button>
                                </div>
                            </div>
                        }
                        }
                    }
                </div>
            </div>
</div>

@* Detalle de cómo quedó aplicada la conciliación: a qué cuota(s)/DPTO o a qué gasto. *@
@if (mostrarModalDetalle && transaccionDetalle != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-link-45deg me-2"></i>Detalle de conciliación</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalDetalle = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">
                        @transaccionDetalle.Description · @transaccionDetalle.StatementDate.ToString("dd/MM/yyyy")
                        · @transaccionDetalle.Amount.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture(transaccionDetalle.Currency == "USD" ? "en-US" : "es-PE"))
                    </p>
                    @{
                        var pagosDetalle = PagosDe(transaccionDetalle.IdStatementDetail);
                        var gastoDetalle = GastoDe(transaccionDetalle.IdStatementDetail);
                    }
                    @if (pagosDetalle.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>DPTO/Unidad</th>
                                    <th>Propietario</th>
                                    <th>Período</th>
                                    <th class="text-end">Monto aplicado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pago in pagosDetalle)
                                {
                                    <tr>
                                        <td>@pago.UnitName</td>
                                        <td>@pago.OwnerName</td>
                                        <td>@pago.Period.ToString("MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-PE"))</td>
                                        <td class="text-end">@pago.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-PE"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (gastoDetalle != null)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Gasto</dt>
                            <dd class="col-sm-8">@gastoDetalle.Description</dd>
                            <dt class="col-sm-4">Categoría</dt>
                            <dd class="col-sm-8">@gastoDetalle.Category</dd>
                            <dt class="col-sm-4">Monto</dt>
                            <dd class="col-sm-8">@gastoDetalle.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-PE"))</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No se encontró el detalle de aplicación (puede ser una carga migrada sin ese registro).</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => mostrarModalDetalle = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@* Mismo patrón de "motivo obligatorio" que Conciliación de Pagos (ReconciliationWorkspace.razor)
   -- "Corregir" acá revierte lo mismo que ahí, sólo que esta es la única pantalla donde una
   transacción YA conciliada es alcanzable (ver comentario en ReconciliationWorkspace.razor
   sobre por qué esa pantalla no lista lo ya confirmado). *@
@if (mostrarModalMotivo)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Motivo de la corrección</h5>
                    <button type="button" class="btn-close" @onclick="() => CerrarModalMotivo(null)"></button>
                </div>
                <div class="modal-body">
                    <p>@mensajeModalMotivo</p>
                    <textarea class="form-control" rows="3" @bind="textoModalMotivo" @bind:event="oninput" placeholder="Motivo (obligatorio)"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => CerrarModalMotivo(null)">Cancelar</button>
                    <button class="btn btn-danger" disabled="@string.IsNullOrWhiteSpace(textoModalMotivo)" @onclick="() => CerrarModalMotivo(textoModalMotivo)">
                        <i class="bi bi-check2 me-1"></i>Confirmar corrección
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<RejectionModal @ref="_revertirMasivoModal" Title="Deshacer Conciliación en Masa" Message="@_mensajeRevertirMasivo" OnClose="OnRevertirMasivoClose"
                ButtonText="Deshacer Conciliación" FieldLabel="Motivo"
                FieldPlaceholder="Explicá por qué se deshace esta conciliación -- quedará guardado en el historial." />

@code {
    [Parameter] public Guid IdStatementHeader { get; set; }

    private TransactionBankHeader? header;
    private List<BankAccount> cuentasBancarias = new();
    private bool cargando = true;
    private bool accesoDenegado = false;
    private string? mensajeExito;
    private string? mensajeError;

    // Datos para mostrar "a qué se aplicó" cada movimiento conciliado, y para poder
    // revertir sin ir a buscarlos de nuevo por cada fila.
    private List<InstallmentPaid> pagosCuotas = new();
    private List<ViewExpense> gastosDelEdificio = new();
    private UserSession _currentUser = new();
    // Mismo criterio que ReconciliationWorkspace.razor: corregir una conciliación ya
    // confirmada queda restringido a Administrador (pedido explícito del usuario), sin
    // depender del sistema de permisos por BD.
    private bool _puedeCorregir => _currentUser.Role == "Administrador";

    // Deshacer Conciliación en Masa -- permiso nuevo y separado (Database/Scripts/
    // 2026-09-24_144_CondonarDeuda_Feature.sql), sin asignar a ningún rol por defecto.
    // Solo Ingresos (cuotas): un Gasto conciliado de este archivo no se toca acá, se
    // deshace aparte con el botón de a una fila que ya existía.
    private bool _puedeRevertirMasivo;
    private bool _mostrarPanelMasivo;
    private HashSet<string> _unidadesSeleccionadasMasivo = new(StringComparer.OrdinalIgnoreCase);
    private RejectionModal _revertirMasivoModal = null!;
    private string _mensajeRevertirMasivo = string.Empty;

    // Filtros
    private string filtroEstado = "";
    private string filtroDescripcion = "";
    private decimal? filtroMontoMin;
    private decimal? filtroMontoMax;

    // Paginación reutilizando la clase genérica de Models/PaginationClass.cs
    private PaginationClass<AccountStatementDetailView> pagination = new();
    private List<AccountStatementDetailView> detallesCompletos = new();
    private int jumpToPage = 1;

    // Modal "Ver detalles de aplicación"
    private bool mostrarModalDetalle = false;
    private AccountStatementDetailView? transaccionDetalle;

    // Modal "Motivo de la corrección" -- mismo patrón que ReconciliationWorkspace.razor.
    private bool mostrarModalMotivo = false;
    private string mensajeModalMotivo = "";
    private string textoModalMotivo = "";
    private TaskCompletionSource<string?>? _motivoTcs;

    protected override void OnInitialized()
    {
        pagination.OnPaginationChanged += () => jumpToPage = pagination.CurrentPage;
    }

    // ParameterService.CurrentBuilding lo resuelve HeaderMainLayout en SU PROPIO
    // OnAfterRenderAsync (necesita IJSRuntime para leer localStorage, no disponible
    // antes del primer render) -- un round-trip real, más lento que el resto del árbol
    // de componentes. Leerlo desde OnInitializedAsync (como estaba antes) siempre lo
    // encontraba en null en la primera carga real de un circuito (F5, login, cualquier
    // navegación nueva): el nombre de la cuenta bancaria y el encabezado quedaban en
    // blanco y nunca reintentaba. Se reintenta en cada re-render (HeaderMainLayout
    // dispara StateHasChanged al resolver el edificio) hasta que esté listo, con un tope
    // para no reintentar para siempre si de verdad nunca se resuelve.
    private bool _dataLoaded = false;
    private int _renderAttempts = 0;
    private const int MaxRenderAttemptsBeforeGivingUp = 20;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dataLoaded) return;

        var edificioListo = ParameterService.CurrentBuilding != null && ParameterService.CurrentBuilding.IdBuilding != Guid.Empty;

        if (!edificioListo && _renderAttempts < MaxRenderAttemptsBeforeGivingUp)
        {
            _renderAttempts++;
            await Task.Delay(150);
            StateHasChanged();
            return;
        }

        _dataLoaded = true;

        if (ParameterService.CurrentBuilding != null)
        {
            _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
            _puedeRevertirMasivo = await PermissionService.HasPermissionAsync(_currentUser, "revertir_conciliacion_masivo");
            cuentasBancarias = await BankAccountService.GetBankAccountsAsync(ParameterService.CurrentBuilding.IdBuilding);

            // IDOR: GetStatementDetailsAsync(IdStatementHeader) trae el detalle de CUALQUIER
            // estado de cuenta de CUALQUIER edificio, sin importar a quién pertenece -- antes
            // se llamaba directo desde la ruta sin pasar por este chequeo. Ahora sólo se carga
            // el detalle si el header aparece entre los headers del edificio actualmente
            // seleccionado; si no aparece (de otro edificio, o no existe), se corta acá y se
            // muestra "acceso denegado" sin traer ni una fila de la tabla de detalle.
            var headers = await BankAccountService.GetMovementHeadersAsync(ParameterService.CurrentBuilding.IdBuilding, null);
            header = headers.FirstOrDefault(h => h.IdStatementHeader == IdStatementHeader);

            if (header == null)
            {
                accesoDenegado = true;
                cargando = false;
                StateHasChanged();
                return;
            }

            detallesCompletos = (await BankAccountService.GetStatementDetailsAsync(IdStatementHeader))
                .OrderBy(d => d.StatementDate)
                .ThenBy(d => d.SequenceNumber)
                .ToList();

            // Se cargan una sola vez para todo el edificio (no por transacción) -- de acá
            // sale tanto el resumen "Aplicado a" de cada fila como el detalle completo y el
            // Corregir/Revertir, sin ir a buscarlos de nuevo por cada fila ni por cada click.
            pagosCuotas = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
            gastosDelEdificio = await ExpenseService.GetExpensesByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

            pagination.Initialize(detallesCompletos);
        }

        cargando = false;
        StateHasChanged();
    }

    private List<InstallmentPaid> PagosDe(Guid idStatementDetail) =>
        pagosCuotas.Where(p => p.IdTransaction == idStatementDetail).ToList();

    private ViewExpense? GastoDe(Guid idStatementDetail) =>
        gastosDelEdificio.FirstOrDefault(g => g.ReconciledTransactionId == idStatementDetail);

    // Unidades con al menos una transacción Conciliada de este archivo con cuota(s)
    // asociada(s) -- lo que se puede elegir para "Deshacer Conciliación en Masa". Un pago
    // solo puede extenderse a cuotas de la MISMA unidad (ver ApplyPaymentAsync), así que
    // cada transacción aporta como mucho una unidad acá.
    private List<string> UnidadesConciliadasEnArchivo =>
        detallesCompletos
            .Where(d => d.ReconciliationStatus == ReconciliationType.Conciliada)
            .SelectMany(d => PagosDe(d.IdStatementDetail))
            .Select(p => p.UnitName)
            .Distinct()
            .OrderBy(u => u)
            .ToList();

    private void ToggleUnidadMasivo(string unidad, bool marcada)
    {
        if (marcada) _unidadesSeleccionadasMasivo.Add(unidad);
        else _unidadesSeleccionadasMasivo.Remove(unidad);
    }

    private void SeleccionarTodasLasUnidadesMasivo()
    {
        _unidadesSeleccionadasMasivo = new HashSet<string>(UnidadesConciliadasEnArchivo, StringComparer.OrdinalIgnoreCase);
    }

    private void AbrirRevertirMasivo()
    {
        var todoElArchivo = _unidadesSeleccionadasMasivo.Count == UnidadesConciliadasEnArchivo.Count;
        _mensajeRevertirMasivo = todoElArchivo
            ? $"Vas a deshacer la conciliación de TODO el archivo '{header?.FileName}' -- las {_unidadesSeleccionadasMasivo.Count} unidad(es) con pagos conciliados quedarán sin conciliar, sin borrar los montos, solo liberando las cuotas."
            : $"Vas a deshacer la conciliación de las {_unidadesSeleccionadasMasivo.Count} unidad(es) elegidas en este archivo -- sus cuotas quedarán sin conciliar, sin borrar los montos.";
        _revertirMasivoModal.Show();
    }

    // Mismo criterio que RevertirConciliacion (fila por fila) pero aplicado a todas las
    // transacciones Conciliadas de las unidades elegidas en este archivo -- un solo motivo
    // para todo el lote, un WorkflowAuditEntry por transacción (misma granularidad que ya
    // usa el resto de la auditoría de conciliación).
    private async Task OnRevertirMasivoClose(string? motivo)
    {
        if (motivo == null || ParameterService.CurrentBuilding == null || !_unidadesSeleccionadasMasivo.Any()) return;

        var transaccionesARevertir = detallesCompletos
            .Where(d => d.ReconciliationStatus == ReconciliationType.Conciliada)
            .Where(d => PagosDe(d.IdStatementDetail).Any(p => _unidadesSeleccionadasMasivo.Contains(p.UnitName)))
            .ToList();

        if (!transaccionesARevertir.Any())
        {
            mensajeError = "No se encontraron transacciones conciliadas para las unidades seleccionadas.";
            return;
        }

        var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;

        foreach (var item in transaccionesARevertir)
        {
            var pagos = PagosDe(item.IdStatementDetail);
            var pago = new TransactionBankDetail
            {
                IdStatementDetail = item.IdStatementDetail,
                Description = item.Description,
                Currency = item.Currency,
                ReconciliationStatus = ReconciliationType.NoConciliada
            };
            await InstallmentService.RevertPaymentAsync(pago, pagos, BankAccountService);

            var detalleAnterior = $"{pagos.Count} cuota(s): Unidad " + string.Join(", ", pagos.Select(p => p.UnitName).Distinct());
            await WorkflowAuditService.LogAsync("Reconciliation", item.IdStatementDetail, WorkflowAction.Corrected,
                performedBy, ParameterService.CurrentBuilding.IdBuilding,
                $"Deshecho en masa (archivo '{header?.FileName}') -- {detalleAnterior}. Motivo: {motivo}");

            pagosCuotas.RemoveAll(p => p.IdTransaction == item.IdStatementDetail);
            item.ReconciliationStatus = ReconciliationType.NoConciliada;
            item.ReconciliationDate = null;
        }

        var revertidas = transaccionesARevertir.Count;
        _unidadesSeleccionadasMasivo.Clear();
        _mostrarPanelMasivo = false;
        AplicarFiltros();
        mensajeExito = $"Se deshizo la conciliación de {revertidas} transacción(es).";
        StateHasChanged();
    }

    private string ResumenAplicacion(AccountStatementDetailView item)
    {
        if (item.ReconciliationStatus != ReconciliationType.Conciliada && item.ReconciliationStatus != ReconciliationType.Parcial)
            return "—";

        var pagos = PagosDe(item.IdStatementDetail);
        if (pagos.Any())
        {
            var unidades = pagos.Select(p => p.UnitName).Distinct().ToList();
            var resumen = "DPTO " + string.Join(", ", unidades.Take(2));
            if (unidades.Count > 2) resumen += $" +{unidades.Count - 2} más";
            return resumen;
        }

        var gasto = GastoDe(item.IdStatementDetail);
        return gasto != null ? $"Gasto: {gasto.Description}" : "—";
    }

    private void VerDetalleAplicacion(AccountStatementDetailView item)
    {
        transaccionDetalle = item;
        mostrarModalDetalle = true;
    }

    private void AplicarFiltros()
    {
        pagination.ApplyCustomFilter(item =>
            EstadoCoincide(item) &&
            (string.IsNullOrWhiteSpace(filtroDescripcion) ||
                item.Description.Contains(filtroDescripcion, StringComparison.OrdinalIgnoreCase)) &&
            (!filtroMontoMin.HasValue || item.Amount >= filtroMontoMin.Value) &&
            (!filtroMontoMax.HasValue || item.Amount <= filtroMontoMax.Value));
    }

    private bool EstadoCoincide(AccountStatementDetailView item) => filtroEstado switch
    {
        "Conciliado" => item.ReconciliationStatus == ReconciliationType.Conciliada,
        "Parcial" => item.ReconciliationStatus == ReconciliationType.Parcial,
        "Pendiente" => item.ReconciliationStatus != ReconciliationType.Conciliada && item.ReconciliationStatus != ReconciliationType.Parcial,
        _ => true
    };

    private void LimpiarFiltros()
    {
        filtroEstado = "";
        filtroDescripcion = "";
        filtroMontoMin = null;
        filtroMontoMax = null;
        pagination.ClearFilters();
    }

    private Task<string?> PedirMotivoAsync(string mensaje)
    {
        mensajeModalMotivo = mensaje;
        textoModalMotivo = "";
        mostrarModalMotivo = true;
        _motivoTcs = new TaskCompletionSource<string?>();
        return _motivoTcs.Task;
    }

    private void CerrarModalMotivo(string? motivo)
    {
        mostrarModalMotivo = false;
        _motivoTcs?.TrySetResult(string.IsNullOrWhiteSpace(motivo) ? null : motivo);
    }

    // Misma lógica que CorregirConciliacionIngreso/Gasto en ReconciliationWorkspace.razor
    // -- esta es la pantalla donde en verdad es alcanzable, porque acá sí se listan las
    // transacciones ya Conciliadas (ver comentario en esa pantalla).
    private async Task RevertirConciliacion(AccountStatementDetailView item)
    {
        if (!_puedeCorregir || ParameterService.CurrentBuilding == null) return;

        var pagos = PagosDe(item.IdStatementDetail);
        var gasto = GastoDe(item.IdStatementDetail);

        if (!pagos.Any() && gasto == null)
        {
            mensajeError = "Esta transacción no tiene una cuota ni un gasto conciliado asociado para corregir.";
            return;
        }

        var detalleParaMotivo = pagos.Any()
            ? $"y liberar {pagos.Count} cuota(s) asociada(s)"
            : $"con el gasto '{gasto!.Description}'";

        var motivo = await PedirMotivoAsync($"Vas a corregir la conciliación de '{item.Description}' {detalleParaMotivo}.");
        if (string.IsNullOrWhiteSpace(motivo))
        {
            return;
        }

        try
        {
            var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;

            if (pagos.Any())
            {
                var pago = new TransactionBankDetail
                {
                    IdStatementDetail = item.IdStatementDetail,
                    Description = item.Description,
                    Currency = item.Currency,
                    ReconciliationStatus = ReconciliationType.NoConciliada
                };
                await InstallmentService.RevertPaymentAsync(pago, pagos, BankAccountService);

                var detalleAnterior = $"{pagos.Count} cuota(s): Unidad " + string.Join(", ", pagos.Select(p => p.UnitName).Distinct());
                await WorkflowAuditService.LogAsync("Reconciliation", item.IdStatementDetail, WorkflowAction.Corrected,
                    performedBy, ParameterService.CurrentBuilding.IdBuilding,
                    $"Se liberó la conciliación con {detalleAnterior}. Motivo: {motivo}");

                pagosCuotas.RemoveAll(p => p.IdTransaction == item.IdStatementDetail);
            }
            else
            {
                await BankAccountService.UnreconcileExpenseAsync(item.IdStatementDetail, gasto!.IdExpense);

                await WorkflowAuditService.LogAsync("Reconciliation", item.IdStatementDetail, WorkflowAction.Corrected,
                    performedBy, ParameterService.CurrentBuilding.IdBuilding,
                    $"Se liberó la conciliación con gasto '{gasto.Description}'. Motivo: {motivo}");

                gasto.Reconciled = false;
                gasto.ReconciledTransactionId = null;
                gasto.AutoReconcile = false;
            }

            item.ReconciliationStatus = ReconciliationType.NoConciliada;
            item.ReconciliationDate = null;

            AplicarFiltros();
            mensajeExito = "Conciliación corregida y liberada.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al corregir: {ex.Message}";
        }
    }

    private string GetNombreCuenta(Guid idBankAccount)
    {
        var cuenta = cuentasBancarias.FirstOrDefault(c => c.IdBankAccount == idBankAccount);
        return cuenta != null ? $"{cuenta.BankName} ({cuenta.AccountNumber})" : "—";
    }

