    // En tu método SaveItemAsync, usa esto en lugar de AddRangeAsync genérico:
    private async Task<bool> SaveItemAsync(TransactionBankHeader item)
    {

        using var context = await ParameterService.ContextFactory().CreateDbContextAsync();
        using var transaction = await context.Database.BeginTransactionAsync();

        using (transaction)
        {
            try
            {
                // 1. Guardar header
                await BankAccountService.AddTransactionBankHeaderAsync(item);
                //await ParameterService.Context.SaveChangesAsync();

                // 2. Guardar detalles - USAR EL DBSET ESPECÍFICO
                var validDetails = item.Details?
                    .Where(d => d.Validation == "Ok")
                    .ToList();

                if (validDetails != null && validDetails.Any())
                {
                    // Establecer relaciones
                    foreach (TransactionBankDetail detail in item.Details!.Where(c => c.Validation == "Ok"))
                    {
                        detail.IdStatementHeader = item.IdStatementHeader;
                        await AddItem(detail);
                    }

                    //await ParameterService.Context.SaveChangesAsync();
                }

                await transaction.CommitAsync();
                return true;
            }
            catch (Exception ex)
            {
                await transaction.RollbackAsync();
                // Log del error
                Console.WriteLine($"Error: {ex.Message}");
                throw;
            }
        }
    }


    // Variables para paginación
    private List<TransactionBankDetail> filteredData = new();
    private List<TransactionBankDetail> currentPageData = new();
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalPages = 0;
    private int totalRecords = 0;
    private int startRecord = 0;
    private int endRecord = 0;
    private int jumpToPage = 1;

    // Variables para ordenamiento
    private string sortColumn = "MovDate";
    private bool sortAscending = true;

    // Variables para filtrado
    private string selectedFilter = "all";

    // Métodos de paginación
    private void InitializePagination()
    {
        currentPage = 1;
        UpdateFilteredData();
        UpdatePagination();
    }

    private void UpdateFilteredData()
    {
        if (datos == null || !datos.Any())
        {
            filteredData = new List<TransactionBankDetail>();
            return;
        }

        // Aplicar filtro
        filteredData = selectedFilter switch
        {
            "valid" => datos.Where(d => d.Validation == "Ok").ToList(),
            "duplicate" => datos.Where(d => d.Validation == "Duplicado").ToList(),
            "error" => datos.Where(d => d.Validation != "Ok" && d.Validation != "Duplicado").ToList(),
            _ => datos.ToList()
        };

        // Aplicar ordenamiento
        filteredData = sortColumn switch
        {
            "MovDate" => sortAscending
                ? filteredData.OrderBy(d => d.StatementDate).ToList()
                : filteredData.OrderByDescending(d => d.StatementDate).ToList(),
            "Description" => sortAscending
                ? filteredData.OrderBy(d => d.Description).ToList()
                : filteredData.OrderByDescending(d => d.Description).ToList(),
            "ITF" => sortAscending
                ? filteredData.OrderBy(d => d.ITF).ToList()
                : filteredData.OrderByDescending(d => d.ITF).ToList(),
            "Currency" => sortAscending
                ? filteredData.OrderBy(d => d.Currency).ToList()
                : filteredData.OrderByDescending(d => d.Currency).ToList(),
            "Amount" => sortAscending
                ? filteredData.OrderBy(d => d.Amount).ToList()
                : filteredData.OrderByDescending(d => d.Amount).ToList(),
            _ => filteredData
        };
    }

    private void UpdatePagination()
    {
        totalRecords = filteredData.Count;
        totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

        // Ajustar página actual si es necesario
        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }
        else if (currentPage < 1 && totalPages > 0)
        {
            currentPage = 1;
        }

        // Calcular registros a mostrar
        startRecord = totalRecords > 0 ? ((currentPage - 1) * pageSize) + 1 : 0;
        endRecord = Math.Min(currentPage * pageSize, totalRecords);

        // Obtener datos de la página actual
        currentPageData = filteredData
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        // Actualizar jumpToPage
        jumpToPage = currentPage;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            UpdatePagination();
        }
    }

    private void GoToFirstPage()
    {
        GoToPage(1);
    }

    private void GoToPreviousPage()
    {
        GoToPage(currentPage - 1);
    }

    private void GoToNextPage()
    {
        GoToPage(currentPage + 1);
    }

    private void GoToLastPage()
    {
        GoToPage(totalPages);
    }

    private void JumpToPage()
    {
        GoToPage(jumpToPage);
    }

    private void ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        UpdatePagination();
    }

    private void ChangeFilter(string filter)
    {
        selectedFilter = filter;
        InitializePagination();
    }

    private void SortByColumn(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        UpdateFilteredData();
        UpdatePagination();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        int maxPagesToShow = 5;

        if (totalPages <= maxPagesToShow)
        {
            // Mostrar todas las páginas
            for (int i = 1; i <= totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Lógica para mostrar páginas con elipsis
            if (currentPage <= 3)
            {
                // Primeras páginas
                for (int i = 1; i <= 4; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
            else if (currentPage >= totalPages - 2)
            {
                // Últimas páginas
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = totalPages - 3; i <= totalPages; i++)
                {
                    pages.Add(i);
                }
            }
            else
            {
                // En medio
                pages.Add(1);
                pages.Add(-1); // Elipsis
                for (int i = currentPage - 1; i <= currentPage + 1; i++)
                {
                    pages.Add(i);
                }
                pages.Add(-1); // Elipsis
                pages.Add(totalPages);
            }
        }

        return pages;
    }

