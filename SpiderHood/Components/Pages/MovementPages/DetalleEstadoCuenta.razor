@page "/movement/detalle/{IdStatementHeader:guid}"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@inject IBankAccountService BankAccountService

<PageTitle>Detalle de Estado de Cuenta</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-12 col-xl-10">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/movement">Estados de Cuenta</a></li>
                    <li class="breadcrumb-item active">Detalle</li>
                </ol>
            </nav>

            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-file-earmark-excel display-6 me-2"></i>
                            <div>
                                <h1 class="h3 mb-1">@(header?.FileName ?? "Detalle de Carga")</h1>
                                @if (header != null)
                                {
                                    <p class="mb-0 opacity-75">
                                        @GetNombreCuenta(header.IdBankAccount) &middot; Cargado @header.UploadDate.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                }
                            </div>
                        </div>
                        <button class="btn btn-light" @onclick="Volver">
                            <i class="bi bi-arrow-left me-2"></i>Volver
                        </button>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (!pagination.AllData.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-3"></i>
                            No hay movimientos para este estado de cuenta
                        </div>
                    }
                    else
                    {
                        <!-- Encabezado con estadísticas y selector de página -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                            <p class="text-muted mb-0">
                                Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords registros
                            </p>
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-muted">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                                    <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                                    <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                                    <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                                    <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                                </select>
                            </div>
                        </div>

                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Fecha</th>
                                        <th>Descripción</th>
                                        <th>Moneda</th>
                                        <th>Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in pagination.CurrentPageData)
                                    {
                                        <tr>
                                            <td class="ps-3">@item.StatementDate.ToString("dd/MM/yyyy")</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <span class="badge @(item.Currency == "USD" ? "bg-info" : "bg-success")">@item.Currency</span>
                                            </td>
                                            <td class="fw-semibold @(item.Amount >= 0 ? "text-success" : "text-danger")">
                                                @item.Amount.ToString("C",
                                                    System.Globalization.CultureInfo.CreateSpecificCulture(item.Currency == "USD" ? "en-US" : "es-PE"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        @if (pagination.TotalPages > 1)
                        {
                            <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top">
                                <div class="text-muted">
                                    Página @pagination.CurrentPage de @pagination.TotalPages
                                </div>

                                <nav aria-label="Paginación de resultados">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </a>
                                        </li>
                                        <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>

                                        @foreach (var pageNum in pagination.GetPageNumbers())
                                        {
                                            if (pageNum == -1)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                    <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">
                                                        @pageNum
                                                    </a>
                                                </li>
                                            }
                                        }

                                        <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                        <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>

                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Ir a:</span>
                                    <input type="number" class="form-control form-control-sm"
                                           style="width: 70px;"
                                           min="1" max="@pagination.TotalPages"
                                           @bind="jumpToPage"
                                           @bind:event="oninput" />
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="JumpToPage"
                                            disabled="@(jumpToPage < 1 || jumpToPage > pagination.TotalPages)">
                                        Ir
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid IdStatementHeader { get; set; }

    private TransactionBankHeader? header;
    private List<BankAccount> cuentasBancarias = new();
    private bool cargando = true;

    // Paginación reutilizando la clase genérica de Models/PaginationClass.cs
    private PaginationClass<AccountStatementDetailView> pagination = new();
    private int jumpToPage = 1;

    protected override async Task OnInitializedAsync()
    {
        pagination.OnPaginationChanged += () => jumpToPage = pagination.CurrentPage;

        if (ParameterService.CurrentBuilding != null)
        {
            cuentasBancarias = await BankAccountService.ObtenerCuentasBancariasAsync(ParameterService.CurrentBuilding.IdBuilding);

            var headers = await BankAccountService.GetMovementHeadersAsync(ParameterService.CurrentBuilding.IdBuilding, null);
            header = headers.FirstOrDefault(h => h.IdStatementHeader == IdStatementHeader);
        }

        var detalles = (await BankAccountService.GetStatementDetailsAsync(IdStatementHeader))
            .OrderBy(d => d.StatementDate)
            .ThenBy(d => d.SequenceNumber)
            .ToList();

        pagination.Initialize(detalles);
        cargando = false;
    }

    private string GetNombreCuenta(Guid idBankAccount)
    {
        var cuenta = cuentasBancarias.FirstOrDefault(c => c.IdBankAccount == idBankAccount);
        return cuenta != null ? $"{cuenta.BankName} ({cuenta.AccountNumber})" : "—";
    }

    private void Volver()
    {
        Navigation.NavigateTo("/movement");
    }

    private void JumpToPage()
    {
        pagination.GoToPage(jumpToPage);
    }
}
