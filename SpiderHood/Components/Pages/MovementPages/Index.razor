@page "/movement"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@inject IBankAccountService BankAccountService

<PageTitle>Estados de Cuenta</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-12 col-xl-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-bank display-6 me-2"></i>
                            <div>
                                <h1 class="h3 mb-1">Estados de Cuenta</h1>
                                <p class="mb-0 opacity-75">Historial de estados de cuenta cargados</p>
                            </div>
                        </div>
                        <button class="btn btn-light" @onclick="IrACargar">
                            <i class="bi bi-upload me-2"></i>Cargar Estado de Cuenta
                        </button>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Filtro por cuenta -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label">Cuenta Bancaria</label>
                            <select class="form-select" @bind="selectedBankAccountId" @bind:after="CargarEstadosDeCuentaAsync">
                                <option value="@Guid.Empty">Todos</option>
                                @foreach (var cuenta in cuentasBancarias)
                                {
                                    <option value="@cuenta.IdBankAccount">@cuenta.BankName (@cuenta.AccountNumber)</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (!pagination.AllData.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-3"></i>
                            No hay estados de cuenta cargados@(selectedBankAccountId == Guid.Empty ? "" : " para la cuenta seleccionada").
                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="IrACargar">
                                    <i class="bi bi-upload me-2"></i>Cargar Estado de Cuenta
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Encabezado con estadísticas y selector de página -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                            <p class="text-muted mb-0">
                                Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords registros
                            </p>
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-muted">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                                    <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                                    <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                                    <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                                    <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                                </select>
                            </div>
                        </div>

                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Archivo</th>
                                        <th>Cuenta Bancaria</th>
                                        <th>Fecha de Carga</th>
                                        <th class="text-center">Registros</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var header in pagination.CurrentPageData)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <i class="bi bi-file-earmark-excel text-success me-2"></i>@header.FileName
                                            </td>
                                            <td>@GetNombreCuenta(header.IdBankAccount)</td>
                                            <td>@header.UploadDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-center">@header.TotalRecords</td>
                                            <td class="text-center">
                                                @if (header.UploadState == 1)
                                                {
                                                    <span class="badge bg-success">Cargado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Estado @header.UploadState</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetalle(header.IdStatementHeader)">
                                                    <i class="bi bi-eye me-1"></i>Ver detalle
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        @if (pagination.TotalPages > 1)
                        {
                            <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top">
                                <div class="text-muted">
                                    Página @pagination.CurrentPage de @pagination.TotalPages
                                </div>

                                <nav aria-label="Paginación de resultados">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </a>
                                        </li>
                                        <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>

                                        @foreach (var pageNum in pagination.GetPageNumbers())
                                        {
                                            if (pageNum == -1)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                    <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">
                                                        @pageNum
                                                    </a>
                                                </li>
                                            }
                                        }

                                        <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                        <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                            <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>

                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Ir a:</span>
                                    <input type="number" class="form-control form-control-sm"
                                           style="width: 70px;"
                                           min="1" max="@pagination.TotalPages"
                                           @bind="jumpToPage"
                                           @bind:event="oninput" />
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="JumpToPage"
                                            disabled="@(jumpToPage < 1 || jumpToPage > pagination.TotalPages)">
                                        Ir
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<BankAccount> cuentasBancarias = new();
    private Guid selectedBankAccountId = Guid.Empty;
    private bool cargando = true;

    // Paginación reutilizando la clase genérica de Models/PaginationClass.cs
    private PaginationClass<TransactionBankHeader> pagination = new();
    private int jumpToPage = 1;

    protected override async Task OnInitializedAsync()
    {
        pagination.OnPaginationChanged += () => jumpToPage = pagination.CurrentPage;

        if (ParameterService.CurrentBuilding != null)
        {
            cuentasBancarias = await BankAccountService.ObtenerCuentasBancariasAsync(ParameterService.CurrentBuilding.IdBuilding);
        }

        await CargarEstadosDeCuentaAsync();
    }

    private async Task CargarEstadosDeCuentaAsync()
    {
        if (ParameterService.CurrentBuilding == null)
        {
            pagination.Initialize(new List<TransactionBankHeader>());
            cargando = false;
            return;
        }

        cargando = true;
        StateHasChanged();

        Guid? filtroCuenta = selectedBankAccountId == Guid.Empty ? null : selectedBankAccountId;
        var estadosDeCuenta = await BankAccountService.GetMovementHeadersAsync(ParameterService.CurrentBuilding.IdBuilding, filtroCuenta);

        pagination.Initialize(estadosDeCuenta.OrderByDescending(h => h.UploadDate).ToList());

        cargando = false;
    }

    private void JumpToPage()
    {
        pagination.GoToPage(jumpToPage);
    }

    private string GetNombreCuenta(Guid idBankAccount)
    {
        var cuenta = cuentasBancarias.FirstOrDefault(c => c.IdBankAccount == idBankAccount);
        return cuenta != null ? $"{cuenta.BankName} ({cuenta.AccountNumber})" : "—";
    }

    private void IrACargar()
    {
        Navigation.NavigateTo("/movement/cargar");
    }

    private void VerDetalle(Guid idStatementHeader)
    {
        Navigation.NavigateTo($"/movement/detalle/{idStatementHeader}");
    }
}
