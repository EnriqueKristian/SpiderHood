@using SpiderHood.Models
@inject SpiderHood.Services.ParameterService ParameterService
<div class="col-md-3">
    <div class="@ClassBorder">
        <div class="card-body">
            <h5 class="card-title">@Title</h5>
            <p class="@Class">
                @Moneda(TotalExpenses)
            </p>
            <small class="text-muted">@TotalCount gasto(s)</small>
        </div>
    </div>
</div>

@code {
    private string Moneda(decimal valor) => valor.FormatoMoneda(ParameterService.CurrentBuilding?.Configuration.Currency);

    [Parameter] public decimal TotalExpenses { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string ClassBorder { get; set; } = string.Empty;
}
