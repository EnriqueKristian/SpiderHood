@using System.ComponentModel.DataAnnotations
@using SpiderHood.Services
@inject ParameterService ParameterService

@inherits LayoutComponentBase

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((OpenMode == Models.OpenType.Create) ? "Agregar " : "Actualizar") Parámetro</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <EditForm Model="@ViewParameter" OnValidSubmit="Guardar" method="post" FormName="create" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                <div class="modal-body">
                        <table class="table-color">
                            <tr>
                                <td colspan="2">
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Parámetro Padre</strong></label>
                                        <InputSelect class="form-select" @bind-Value="ViewParameter.IdParent">
                                            <option value=0>-- Ninguno --</option>
                                            @foreach (var x in ParameterService.ListParameters.Where(c => c.IdParent == 0))
                                            {
                                                <option value=@x.IdTabla>@x.ShortDescription</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Descripción</strong></label>
                                        <InputText class="form-control" @bind-Value="ViewParameter.Description" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Descripción corta</strong></label>
                                        <InputText class="form-control" @bind-Value="ViewParameter.ShortDescription" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Valor</strong></label>
                                        <InputNumber class="form-control" @bind-Value="ViewParameter.Value" style="width:90%" />
                                    </div>
                                </td>
                                <td>
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Orden</strong></label>
                                        <InputNumber class="form-control" @bind-Value="ViewParameter.Sort" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Estado</strong></label>
                                        <InputSelect class="form-select" @bind-Value="ViewParameter.Estado">
                                            @foreach (var x in ParameterService.ListParameters.Where(c => c.IdParent == Convert.ToInt32(Models.ParamParent.State)))
                                            {
                                                <option value="@((Models.ParameterEstado)Convert.ToInt32(x.Value))">@x.ShortDescription</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </td>
                            </tr>
                        </table>
                </div>
                    <div class="modal-footer">
                        <Button Color="ButtonColor.Secondary" @onclick="CerrarModal">Close</Button>
                        <button type="submit" class="btn btn-primary">@((OpenMode == Models.OpenType.Create) ? "Save" : "Update")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public Models.OpenType OpenMode { get; set; }
    [Parameter] public Models.Parameter ViewParameter { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    [Parameter] public EventCallback<Models.Parameter> OnSaveItem { get; set; }
    //[Parameter] public IQueryable<Models.Parameter> ListParameters { get; set; }

    private async Task Guardar()
    {
        await OnSaveItem.InvokeAsync(ViewParameter);
        await CerrarModal();
    }

    private async Task CerrarModal()
    {
        ShowModal = false;
        await ShowModalChanged.InvokeAsync(ShowModal);
    }

    //private void SeleccionarColor(string color) => ViewCategory.Color = color;
}
