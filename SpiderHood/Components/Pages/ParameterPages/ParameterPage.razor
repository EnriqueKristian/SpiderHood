@page "/parameter"
@rendermode InteractiveServerNoPrerender
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using SpiderHood.Components.Pages.ParameterPages
@using SpiderHood.Data
@using SpiderHood.Models
@using SpiderHood.Services
@inject NavigationManager Navigation // Inyecta el servicio de navegación
@inject ParameterService ParameterService
@inject Services.AuthService AuthService
@inject Services.IPermissionService PermissionService

@layout MainLayout
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime

<PageTitle>Parámetros del Sistema</PageTitle>

<div class="container-fluid px-4 py-3">
    <!-- Header principal -->
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-gear"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Configuración de Parámetros</h1>
                <p class="text-muted mb-0">Administra los parámetros generales del sistema</p>
            </div>
        </div>

        <div class="page-header-actions">
            <button class="btn btn-outline-secondary" @onclick="ExportParameters">
                <i class="bi bi-download me-2"></i>Exportar
            </button>
            @if (_canManageParameters)
            {
                <button class="btn btn-primary" @onclick="ShowAddModal">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Parámetro
                </button>
            }
        </div>
    </div>

    <!-- Card principal -->
    <div class="card shadow-sm border-0">
        <!-- Header de la card -->
        <div class="card-header bg-transparent border-bottom py-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-list-columns me-2"></i>Parámetros del Sistema
                    </h5>
                    <p class="text-muted mb-0 small">Uso del Administrador</p>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-end gap-2">
                        <!-- Buscador -->
                        <div class="input-group input-group-sm" style="width: 250px;">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>


                            <InputText type="text" class="form-control border-start-0"
                                       placeholder="Buscar parámetro..."
                                       @bind-Value="@searchTerm"
                                       @oninput="e => { searchTerm = ((ChangeEventArgs)e).Value?.ToString(); FilterParameters(); }" />


                        </div>

                        <!-- Filtro de estado -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-funnel me-1"></i>
                                @(selectedStatus == null ? "Todos" : selectedStatus)
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" @onclick="() => FilterByStatus(null)">Todos los estados</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" @onclick="@(() => FilterByStatus(ParameterEstado.Activo))">
                                        <span class="badge bg-success me-2"></span>Activo
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" @onclick="@(() => FilterByStatus(ParameterEstado.Inactivo))">
                                        <span class="badge bg-danger me-2"></span>Inactivo
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cuerpo de la card -->
        <div class="card-body p-0">
            @if (filteredParameters.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 80px;">ID</th>
                                <th>DESCRIPCIÓN</th>
                                <th style="width: 150px;">VALOR</th>
                                <th style="width: 120px;">ESTADO</th>
                                <th style="width: 100px;">PADRE</th>
                                <th style="width: 150px;" class="text-center">ACCIÓN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in groupedParameters)
                            {
                                <!-- Grupo padre -->
                                <tr class="table-group-header" style="background-color: #f8f9fa;">
                                    <td class="ps-3 fw-bold">@group.Key.IdTabla</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-folder me-2 text-primary"></i>
                                            <span class="fw-semibold">@group.Key.Description</span>
                                        </div>
                                    </td>
                                    <td>-</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(group.Key.Estado)">
                                            <i class="bi @GetStatusIcon(group.Key.Estado) me-1"></i>
                                            @group.Key.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@group.Key.IdParent</span>
                                    </td>
                                    <td class="text-center">
                                        @if (_canManageParameters)
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-primary"
                                                        title="Agregar hijo" @onclick="() => ShowAddChildModal(group.Key)">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary"
                                                        title="Editar" @onclick="() => EditParameter(group.Key)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger"
                                                        title="Eliminar" @onclick="() => DeleteParameter(group.Key)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </td>
                                </tr>

                                <!-- Hijos del grupo -->
                                @foreach (var hijo in group.Value)
                                {
                                    <tr class="table-group-child">
                                        <td class="ps-5">
                                            <i class="bi bi-arrow-return-right me-1 text-muted"></i>
                                            <span class="text-muted">*</span>
                                        </td>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-file-earmark me-2 text-muted"></i>
                                                <span>@hijo.Description</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">@hijo.Value</span>
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(hijo.Estado)">
                                                <i class="bi @GetStatusIcon(hijo.Estado) me-1"></i>
                                                @hijo.Estado
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info bg-opacity-10 text-info">@hijo.IdParent</span>
                                        </td>
                                        <td class="text-center">
                                            @if (_canManageParameters)
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-secondary"
                                                            title="Editar" @onclick="() => EditParameter(hijo)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger"
                                                            title="Eliminar" @onclick="() => DeleteParameter(hijo)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }

                                <!-- Separador entre grupos -->
                                <tr>
                                    <td colspan="6" class="p-0">
                                        <div class="border-bottom" style="height: 1px; background-color: #f0f0f0;"></div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Estado vacío -->
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-gear text-muted display-4"></i>
                    </div>
                    <h5 class="text-muted mb-2">No hay parámetros configurados</h5>
                    <p class="text-muted mb-3">Comienza agregando tu primer parámetro del sistema</p>
                    @if (_canManageParameters)
                    {
                        <button class="btn btn-primary" @onclick="ShowAddModal">
                            <i class="bi bi-plus-circle me-2"></i>Agregar Primer Parámetro
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Footer de la card -->
        <div class="card-footer bg-transparent border-top py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Mostrando <strong>@filteredParameters.Count</strong> de <strong>@parameters.Count</strong> parámetros
                </div>

                <!-- Información del sistema -->
                <div class="text-end">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Los parámetros con asterisco (*) son valores hijos
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel lateral de información -->
    <div class="row mt-4">
        <div class="col-lg-8">
            <!-- Estadísticas -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-bar-chart me-2"></i>Estadísticas de Parámetros
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="stat-card text-center py-3">
                                <div class="icon-badge mx-auto mb-2">
                                    <i class="bi bi-diagram-3"></i>
                                </div>
                                <div class="stat-value">@totalGrupos</div>
                                <div class="stat-label">Grupos Principales</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card text-center py-3">
                                <div class="icon-badge icon-badge-success mx-auto mb-2">
                                    <i class="bi bi-list-nested"></i>
                                </div>
                                <div class="stat-value">@totalHijos</div>
                                <div class="stat-label">Parámetros Hijos</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card text-center py-3">
                                <div class="icon-badge icon-badge-info mx-auto mb-2">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <div class="stat-value">@totalActivos</div>
                                <div class="stat-label">Parámetros Activos</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card text-center py-3">
                                <div class="icon-badge icon-badge-warning mx-auto mb-2">
                                    <i class="bi bi-x-circle"></i>
                                </div>
                                <div class="stat-value">@totalInactivos</div>
                                <div class="stat-label">Parámetros Inactivos</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Ayuda rápida -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-question-circle me-2"></i>Ayuda Rápida
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 px-0 py-2">
                            <div class="d-flex">
                                <i class="bi bi-folder text-primary  me-2 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Grupos Principales</h6>
                                    <p class="mb-0 small text-muted">Son categorías que contienen parámetros hijos relacionados.</p>
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item border-0 px-0 py-2">
                            <div class="d-flex">
                                <i class="bi bi-arrow-return-right text-success  me-2 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Parámetros Hijos</h6>
                                    <p class="mb-0 small text-muted">Son valores específicos dentro de un grupo principal.</p>
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item border-0 px-0 py-2">
                            <div class="d-flex">
                                <i class="bi bi-toggle-on text-info  me-2 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Estado</h6>
                                    <p class="mb-0 small text-muted">Solo los parámetros activos estarán disponibles en el sistema.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar parámetro -->
@if (showModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditing ? "bi-pencil" : "bi-plus-circle") me-2"></i>
                        @(isEditing ? "Editar Parámetro" : "Nuevo Parámetro")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentParameter" OnValidSubmit="SaveParameter">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Descripción *</label>
                                <InputText class="form-control" @bind-Value="currentParameter.Description"
                                           placeholder="Ingrese descripción del parámetro" />
                                <ValidationMessage For="() => currentParameter.Description" class="text-danger" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Descripción Corta *</label>
                                <InputText class="form-control" @bind-Value="currentParameter.ShortDescription"
                                           placeholder="Ingrese descripción corta del parámetro" />
                                <ValidationMessage For="() => currentParameter.ShortDescription" class="text-danger" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Valor *</label>
                                <InputNumber class="form-control" @bind-Value="currentParameter.Value"
                                             placeholder="Valor del parámetro" />
                                <ValidationMessage For="() => currentParameter.Value" class="text-danger" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Orden</label>
                                <InputNumber class="form-control" @bind-Value="currentParameter.Sort"
                                             placeholder="Orden del parámetro" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Estado *</label>
                                <InputSelect class="form-select" @bind-Value="currentParameter.Estado">
                                    <option value="Activo">Activo</option>
                                    <option value="Inactivo">Inactivo</option>
                                </InputSelect>
                                <ValidationMessage For="() => currentParameter.Estado" class="text-danger" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Parámetro Padre</label>
                                <InputSelect class="form-select" @bind-Value="currentParameter.IdParent">
                                    <option value="0">(Ninguno - Grupo Principal)</option>
                                    @foreach (var parent in availableParents)
                                    {
                                        <option value="@parent.IdTabla">@parent.Description</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="modal-footer px-0 pb-0 border-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-2"></i>Guardar Parámetro
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {

    // Variables de estado
    private List<Models.Parameter> filteredParameters = new();
    private string searchTerm = string.Empty;
    private ParameterEstado? selectedStatus = null;
    private bool showModal = false;
    private bool isEditing = false;
    private Models.Parameter currentParameter = new();
    private List<Models.Parameter> availableParents = new();
    private List<Models.Parameter> parameters = new();

    // Estadísticas
    private int totalGrupos = 0;
    private int totalHijos = 0;
    private int totalActivos = 0;
    private int totalInactivos = 0;

    // Agrupación de parámetros
    private Dictionary<Models.Parameter, List<Models.Parameter>> groupedParameters = new();

    private bool _canManageParameters;

    protected override void OnInitialized()
    {
        // Carga "optimista": si ParameterService.ListParameters ya tiene datos porque otra
        // página (Home, Owners, ...) ya los cargó en este mismo circuito, los mostramos de
        // una. Si esta es la primera página con datos de parámetros que se visita en el
        // circuito, ListParameters todavía está vacío acá — OnAfterRenderAsync se encarga
        // de cargarlo explícitamente (no se puede hacer acá: ParameterService.CurrentBuilding,
        // que LoadParametersAsync necesita, recién se setea en el OnAfterRenderAsync de
        // HeaderMainLayout, que corre DESPUÉS del OnInitialized de todos los componentes).
        filteredParameters = @ParameterService.ListParameters.ToList();
        UpdateStatistics();
        GroupParameters();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var attempts = 0;
            while (ParameterService.CurrentBuilding == null && attempts < 20)
            {
                await Task.Delay(150);
                attempts++;
            }

            if (ParameterService.CurrentBuilding == null)
                return;

            var currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
            _canManageParameters = await PermissionService.HasPermissionAsync(currentUser, "manage_parameters");

            await ParameterService.LoadParametersAsync(ParameterService.CurrentBuilding.IdBuilding);
            OnInitialized();
            StateHasChanged();
        }
    }

    private void GroupParameters()
    {
        groupedParameters.Clear();

        // Obtener grupos principales (Padre = 0)
        var gruposPadre = @ParameterService.ListParameters
            .Where(p => p.IdParent == 0)
            .OrderBy(p => p.IdTabla)
            .ToList();

        foreach (var grupo in gruposPadre)
        {
            var hijos = filteredParameters
                .Where(p => p.IdParent == grupo.IdTabla)
                .OrderBy(p => p.IdTabla)
                .ToList();

            //if (hijos.Count > 0)
            groupedParameters.Add(grupo, hijos);
        }
    }

    private void UpdateStatistics()
    {
        parameters = @ParameterService.ListParameters.ToList();
        totalGrupos = parameters.Count(p => p.IdParent == 0);
        totalHijos = parameters.Count(p => p.IdParent > 0);
        totalActivos = parameters.Count(p => p.Estado == ParameterEstado.Activo);
        totalInactivos = parameters.Count(p => p.Estado == ParameterEstado.Inactivo);
    }

    private void FilterParameters()
    {
        filteredParameters = parameters
            .Where(p => string.IsNullOrEmpty(searchTerm) ||
                       p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .Where(p => selectedStatus == null || p.Estado == selectedStatus)
            .ToList();

        GroupParameters();
    }

    private void FilterByStatus(ParameterEstado? status)
    {
        selectedStatus = status;
        FilterParameters();
    }

    private string GetStatusBadgeClass(ParameterEstado estado)
    {
        return estado switch
        {
            ParameterEstado.Activo => "bg-success bg-opacity-10 text-success",
            ParameterEstado.Inactivo => "bg-danger bg-opacity-10 text-danger",
            _ => "bg-secondary bg-opacity-10 text-secondary"
        };
    }

    private string GetStatusIcon(ParameterEstado estado)
    {
        return estado switch
        {
            ParameterEstado.Activo => "bi-check-circle",
            ParameterEstado.Inactivo => "bi-x-circle",
            _ => "bi-question-circle"
        };
    }

    private void ShowAddModal()
    {
        if (!_canManageParameters) return;
        isEditing = false;
        currentParameter = new Parameter { Estado = ParameterEstado.Activo, IdParent = 0 };
        availableParents = parameters.Where(p => p.IdParent == 0).ToList();
        showModal = true;
    }

    private void ShowAddChildModal(Parameter parent)
    {
        if (!_canManageParameters) return;
        isEditing = false;
        currentParameter = new Parameter
        {
            Estado = ParameterEstado.Activo,
            IdParent = parent.IdTabla
        };
        availableParents = parameters.Where(p => p.IdParent == 0).ToList();
        showModal = true;
    }

    private void EditParameter(Parameter parameter)
    {
        if (!_canManageParameters) return;
        isEditing = true;
        currentParameter = new Parameter
        {
            IdTabla = parameter.IdTabla,
            Description = parameter.Description,
            ShortDescription = parameter.ShortDescription,
            Value = parameter.Value,
            Estado = parameter.Estado,
            Sort = parameter.Sort,
            IdParent = parameter.IdParent
        };
        availableParents = parameters.Where(p => p.IdParent == 0).ToList();
        showModal = true;
    }

    private async Task SaveParameter()
    {
        if (!_canManageParameters) return;
        if (isEditing)
        {
            var existing = parameters.FirstOrDefault(p => p.IdTabla == currentParameter.IdTabla);
            if (existing != null)
            {
                existing.Description = currentParameter.Description;
                existing.ShortDescription = currentParameter.ShortDescription;
                existing.Value = currentParameter.Value;
                existing.Estado = currentParameter.Estado;
                existing.Sort = currentParameter.Sort;
                existing.IdParent = currentParameter.IdParent;
            }
            await UpdateItem(existing!);
        }
        else
        {
            // Generar nuevo ID
            await AddItem(currentParameter);
        }
        await ParameterService.LoadParametersAsync(ParameterService.CurrentBuilding.IdBuilding, true);

        CloseModal();
        OnInitialized();
    }

    private async Task DeleteParameter(Parameter parameter)
    {
        if (!_canManageParameters) return;
        var children = parameters.Where(p => p.IdParent == parameter.IdTabla).ToList();

        var mensaje = children.Any()
            ? $"¿Está seguro que desea eliminar '{parameter.ShortDescription}'? También se eliminarán sus {children.Count} parámetro(s) hijo(s)."
            : $"¿Está seguro que desea eliminar '{parameter.ShortDescription}'?";

        if (!await JSRuntime.InvokeAsync<bool>("confirm", mensaje))
            return;

        foreach (var child in children)
        {
            var childResult = await ParameterService.DeleteParameterAsync(child.IdTabla);
            if (!childResult.IsSuccess)
            {
                await JSRuntime.InvokeVoidAsync("alert", childResult.ErrorMessage ?? "No se pudo eliminar un parámetro hijo");
                return;
            }
        }

        var result = await ParameterService.DeleteParameterAsync(parameter.IdTabla);
        if (!result.IsSuccess)
        {
            await JSRuntime.InvokeVoidAsync("alert", result.ErrorMessage ?? "No se pudo eliminar el parámetro");
            return;
        }

        await ParameterService.LoadParametersAsync(ParameterService.CurrentBuilding.IdBuilding, true);
        OnInitialized();
    }

    private void CloseModal()
    {
        showModal = false;
        currentParameter = new Parameter();
    }

    private async Task ExportParameters()
    {
        // Lógica para exportar parámetros
        await JSRuntime.InvokeVoidAsync("alert", "Función de exportación en desarrollo");
    }

    // Watchers
    private string _searchTerm = string.Empty;
    private ParameterEstado? _selectedStatus = null;

    protected override void OnParametersSet()
    {
        if (_searchTerm != searchTerm || _selectedStatus != selectedStatus)
        {
            _searchTerm = searchTerm;
            _selectedStatus = selectedStatus;
            FilterParameters();
        }
    }


    private async Task AddItem(SpiderHood.Models.Parameter item)
    {
        item.IdBuilding = ParameterService.CurrentBuilding.IdBuilding;
        await ParameterService.AddParameterAsync(item);
    }

    private async Task UpdateItem(SpiderHood.Models.Parameter _param)
    {
        await ParameterService.UpdateParameterAsync(_param);
    }
}