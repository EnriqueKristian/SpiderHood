@using SpiderHood.Models
<section>
        <div class="grid" id="myGridView" style="width:95%">
        
        <table class="table table-hover custom-grid" border="1">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Descripción</th>
                    <th>Valor</th>
                    <th>Estado</th>
                    <th>Padre</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    @if (@item.IdParent == 0)
                    {
                        <tr>
                            <td align="center"><strong>@item.IdTabla</strong></td>
                            <td colspan="4"><strong>@item.ShortDescription</strong></td>
                            <td align="center">
                                <button class="btn-list btn-icon" @onclick="() => OpenModal(item)">
                                    <i class="fa-solid fa-pen-to-square" aria-hidden="true" title="Editar Parametro"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="text-center">*</td>
                            <td><span style="margin-left: 20px;"><em>@item.ShortDescription</em></span></td>
                            <td align="center">@item.Value</td>
                            <td align="center">@(item.Estado == Models.ParameterEstado.Activo ? "Activo" : "Inactivo")</td>
                            <td align="center">@item.IdParent</td>
                            <td align="center">
                                <button class="btn-list btn-icon" @onclick="() => OpenModal(item)">
                                    <i class="fa-solid fa-pen-to-square" aria-hidden="true" title="Editar Parametro"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter] public IQueryable<Parameter> Items { get; set; }
    [Parameter] public EventCallback<Parameter> OnOpenParameter { get; set; }

    private async Task OpenModal(Parameter _param)
    {
        await OnOpenParameter.InvokeAsync(_param);
    }

}