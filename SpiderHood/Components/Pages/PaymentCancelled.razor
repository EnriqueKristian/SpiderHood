@page "/pago-cancelado"
@rendermode InteractiveServer

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 60vh;">
    <i class="bi bi-x-circle-fill text-danger" style="font-size: 3rem;"></i>
    <h3 class="mt-3">Pago cancelado</h3>
    <p class="text-muted" style="max-width: 480px;">
        No se realizó ningún cargo. Podés volver a intentarlo cuando quieras
        desde tu suscripción.
    </p>
    <a class="btn btn-primary mt-2" href="/Settings">Volver a mi suscripción</a>
</div>
