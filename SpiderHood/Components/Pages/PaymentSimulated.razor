@page "/pago-simulado"
@rendermode InteractiveServer
@using SpiderHood.Models
@inject Services.AuthService AuthService
@inject Services.ISubscriptionService SubscriptionService
@inject NavigationManager Navigation

@* Simulador de pago (Docs/Design-Subscripcion-Administrador.md): sólo existe para
   no bloquearse en la configuración de MercadoPago mientras se prueba el resto
   del flujo (activación, BD, /Settings). IPaymentService.CreateCheckoutSessionAsync
   sólo redirige acá cuando MercadoPago:Simulate está prendido -- si alguien entra
   directo con el flag apagado, o para el edificio de otro usuario, no hace nada. *@

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 60vh;">
    @if (!_allowed)
    {
        <p class="text-muted">Esta página no está disponible.</p>
    }
    else if (_resultado == null)
    {
        <h3>Simulador de pago (MercadoPago)</h3>
        <p class="text-muted" style="max-width: 480px;">
            Esto reemplaza el checkout real de MercadoPago mientras se prueba el
            resto del flujo. Tira 80% de éxito / 20% de rechazo y, si es éxito,
            activa la suscripción con el mismo código que usaría el webhook real.
        </p>
        @if (_plan != null)
        {
            <p><strong>@_plan.Name</strong> -- @(_plan.CurrencyId) @(_plan.Amount?.ToString("0.00"))/mes</p>
        }
        <button class="btn btn-primary mt-2" disabled="@_procesando" @onclick="SimularAsync">
            Simular Pago
        </button>
    }
    else if (_resultado == true)
    {
        <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
        <h3 class="mt-3">Pago simulado aprobado</h3>
        <p class="text-muted">Redirigiendo...</p>
    }
    else
    {
        <i class="bi bi-x-circle-fill text-danger" style="font-size: 3rem;"></i>
        <h3 class="mt-3">Pago simulado rechazado</h3>
        <button class="btn btn-primary mt-2" @onclick="Reintentar">Reintentar</button>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "u")]
    public string? IdUserRaw { get; set; }

    [SupplyParameterFromQuery(Name = "p")]
    public int? IdSubscriptionPlan { get; set; }

    private bool _allowed;
    private bool _procesando;
    private bool? _resultado;
    private Guid _idUser;
    private Models.SubscriptionPlan? _plan;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null || !Guid.TryParse(IdUserRaw, out _idUser) || IdSubscriptionPlan == null)
            return;

        // Sólo el dueño de la cuenta puede simular su propio pago -- nadie puede
        // activar la suscripción de otro adivinando/editando la URL.
        if (currentUser.IdUser != _idUser)
            return;

        _allowed = true;
        var plans = await SubscriptionService.GetAllPlansAsync();
        _plan = plans.FirstOrDefault(p => p.IdSubscriptionPlan == IdSubscriptionPlan);
    }

    private void Reintentar() => _resultado = null;

    private async Task SimularAsync()
    {
        _procesando = true;
        // 80% éxito / 20% rechazo, como pidió el usuario para poder seguir
        // probando el resto del flujo sin depender de MercadoPago.
        var aprobado = Random.Shared.NextDouble() < 0.8;
        _resultado = aprobado;

        if (aprobado)
        {
            // Mismo llamado que haría el webhook real (Program.cs) al confirmar
            // un pago -- así se prueba de verdad el camino de activación/BD.
            await SubscriptionService.ActivateSubscriptionAsync(_idUser, IdSubscriptionPlan!.Value, $"SIMULATED-{Guid.NewGuid()}");
            Navigation.NavigateTo("/pago-exitoso", forceLoad: true);
        }

        _procesando = false;
    }
}
