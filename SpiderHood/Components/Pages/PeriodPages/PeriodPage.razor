@page "/periods"
@page "/periods/{buildingId:guid}"
@implements IDisposable

@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@inject Services.IPeriodService PeriodService
@inject Services.ParameterService ParameterService
@inject IJSRuntime JSRuntime
@using SpiderHood.Components.Pages.Components
@rendermode InteractiveServer

<PageTitle>Administración de Periodos</PageTitle>

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-calendar3"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Lista de Periodos</h1>
                <p class="text-muted mb-0">Listado de Periodos por Edificio</p>
            </div>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Periodo
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm">
                        <i class="bi bi-calculator-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Total Periodos</div>
                        <div class="stat-value">@_pagination.TotalRecords</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-badge icon-badge-sm icon-badge-success">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div>
                        <div class="stat-label">Total Activos</div>
                        <div class="stat-value">@periods.Count(p => p.Status == 1)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Lista de periodos -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-bottom py-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h5 class="card-title mb-0">
                                <i class="bi bi-table me-2"></i>Vista previa de datos
                            </h5>
                            <p class="text-muted mb-0 small">
                                Mostrando @_pagination.StartRecord - @_pagination.EndRecord de @_pagination.TotalRecords registros
                            </p>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div style="min-width: 220px;">
                                <InputText type="text" class="form-control form-control-sm"
                                           placeholder="Buscar Periodos ..."
                                           @bind-Value="@searchTerm"
                                           @oninput="OnSearch" />
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-muted">Mostrar:</label>
                                <select class="form-select form-select-sm" style="width: auto;"
                                        @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                    <!option value="10" selected="@(pageSize == 10)">10</!option>
                                    <!option value="25" selected="@(pageSize == 25)">25</!option>
                                    <!option value="50" selected="@(pageSize == 50)">50</!option>
                                    <!option value="100" selected="@(pageSize == 100)">100</!option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (loading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (_pagination.TotalRecords == 0)
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="bi bi-calendar3 text-muted display-4"></i>
                            </div>
                            <h5 class="text-muted mb-2">No hay periodos registrados</h5>
                            <button class="btn btn-primary" @onclick="CreateNew">
                                <i class="bi bi-plus-circle me-2"></i>Nuevo Periodo
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Nombre</th>
                                        <th>Tipo</th>
                                        <th>Fecha Inicio</th>
                                        <th>Fecha Fin</th>
                                        <th>Fecha Cierre</th>
                                        <th>Estado</th>
                                        <th class="text-center">Periodo Actual</th>
                                        <th class="text-center" style="width: 150px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var period in _pagination.CurrentPageData)
                                    {
                                        <tr>
                                            <td class="ps-3">@period.Name</td>
                                            <td>@GetPeriodTypeDescription(period.PeriodType)</td>
                                            <td>@period.StartDate.ToString("dd/MM/yyyy")</td>
                                            <td>@period.EndDate.ToString("dd/MM/yyyy")</td>
                                            <td>@period.ClosingDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(period.Status)">
                                                    @GetStatusDescription(period.Status)
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (period.IsCurrentPeriod)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill text-secondary"></i>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" title="Editar"
                                                            @onclick="() => EditPeriod(period)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" title="Eliminar"
                                                            @onclick="() => DeletePeriod(period)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                    @if (!period.IsCurrentPeriod && period.Status == 1) // Active
                                                    {
                                                        <button class="btn btn-outline-success" title="Establecer como actual"
                                                                @onclick="() => SetAsCurrent(period.IdPeriod)">
                                                            <i class="bi bi-star-fill"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                @if (!loading && _pagination.TotalRecords > 0)
                {
                    <div class="card-footer bg-transparent border-top py-3">
                        <!-- Reutilizar el mismo componente de paginación -->
                        <PaginationControls _pagination="@_pagination" />
                    </div>
                }
            </div>
        </div>
    </div>

    <PeriodForm ShowModal="ShowModal" ShowModalChanged="@((valor) => ShowModal = valor)" isNew="@isNew" OnSave="SavePeriod" period="period" />
</div>

@code {
    [Parameter]
    public Guid BuildingId { get; set; }


    private bool ShowModal = false;
    private bool isNew = false;

    private List<Models.Period> periods = new();
    private Models.Period period = new();
    //private List<Models.Period> filteredPeriods = new();
    private bool loading = true;
    //private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Suscribirse una sola vez: LoadPeriods() se llama repetidas veces durante la vida
        // de la página (carga inicial, cambio de BuildingId, después de guardar/eliminar) y
        // volver a suscribirse ahí acumulaba handlers duplicados en OnPaginationChanged.
        _pagination.OnPaginationChanged += StateHasChanged;

        if (ParameterService.CurrentBuilding == null)
            return;

        await LoadPeriods();

        loading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (BuildingId != Guid.Empty)
        {
            await LoadPeriods();
        }
    }

    private async Task LoadPeriods()
    {
        periods = (await PeriodService.GetPeriodsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding)).ToList();
        _pagination.Initialize(periods);
    }

    private void CreateNew()
    {
        ShowModal = true;
        isNew = true;
        period = ParameterService.CreateNewPeriod(DateTime.Today, ParameterService.CurrentBuilding.IdBuilding).Result;
    }

    private void EditPeriod(Models.Period _period)
    {
        ShowModal = true;
        isNew = false;
        period = _period;
    }

    private async Task SavePeriod(Models.Period _period)
    {
        // PeriodForm ya confirmó con el usuario que la creación/actualización fue
        // exitosa antes de invocar OnSave (ver PeriodForm.HandleValidSubmit), así que acá
        // solo hace falta refrescar el listado y cerrar el modal.
        ShowModal = false;
        await LoadPeriods();
    }

    private async Task DeletePeriod(Models.Period period)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Desea eliminar el periodo {period.Name}?");
        if (!confirmed) return;

        var success = await PeriodService.DeletePeriodAsync(period.IdPeriod);
        if (success)
        {
            await LoadPeriods();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo eliminar el periodo");
        }
    }

    private async Task SetAsCurrent(Guid periodId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "¿Desea establecer este periodo como el periodo actual?");
        if (!confirmed) return;

        var success = await PeriodService.SetAsCurrentPeriodAsync(periodId, ParameterService.CurrentBuilding.IdBuilding);
        if (success)
        {
            await LoadPeriods();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo establecer el periodo como actual");
        }
    }

    private string GetPeriodTypeDescription(int periodType)
    {
        return periodType switch
        {
            1 => "Mensual",
            2 => "Bimestral",
            3 => "Trimestral",
            4 => "Semestral",
            5 => "Anual",
            _ => "Desconocido"
        };
    }

    private string GetStatusDescription(int status)
    {
        return status switch
        {
            0 => "Inactivo",
            1 => "Activo",
            2 => "Cerrado",
            _ => "Desconocido"
        };
    }

    private string GetStatusBadgeClass(int status)
    {
        return status switch
        {
            0 => "bg-secondary",
            1 => "bg-success",
            2 => "bg-info",
            _ => "bg-secondary"
        };
    }
    
    #region Paginación

    private Utilities.PeriodPagination _pagination = new Utilities.PeriodPagination();
    private string searchTerm = string.Empty;
    private string selectedFilter = "all";
    private int pageSize = 25;

    private void SortColumn(string column)
    {
        _pagination.SortByColumn(column);
    }

    private void SelectReading(Models.Period reading)
    {
        // Lógica para seleccionar una lectura
        Console.WriteLine($"Seleccionada lectura: {reading.Name}");
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        _pagination.Search(searchTerm);
    }

    private void OnFilterChanged()
    {
        // Aplicar filtro según la selección
        /*switch (selectedFilter)
        {
            case "processed":
                _pagination.FilterByProcessingStatus(true);
                break;
            case "unprocessed":
                _pagination.FilterByProcessingStatus(false);
                break;
            case "minimum":
                _pagination.FilterMinimumConsumption();
                break;
            default:
                _pagination.ClearFilters();
                break;
        }*/
    }

    private void OnPageSizeChanged()
    {
        _pagination.ChangePageSize(pageSize);
    }

    public void Dispose()
    {
        _pagination.OnPaginationChanged -= StateHasChanged;
    }

    private void ChangeFilter(string filter)
    {
        selectedFilter = filter;
        OnFilterChanged();
    }

    private void ChangePageSize(int newSize)
    {
        pageSize = newSize;
        OnPageSizeChanged();
    }

    private List<string> filters = new() { "all", "Procesadas", "Sin Procesar", "Consumo Mínimo" };

    private string GetFilterLabel(string filter) => filter switch
    {
        "all" => "Todos",
        "Procesadas" => "Procesadas",
        "Sin Procesar" => "Sin Procesar",
        "Consumo Mínimo" => "Consumo Mínimo",
        _ => filter
    };
    #endregion

}