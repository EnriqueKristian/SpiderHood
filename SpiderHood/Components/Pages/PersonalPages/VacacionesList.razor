@page "/personal/vacaciones"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject IPlanillaService PlanillaService
@inject IPersonalService PersonalService
@inject IAccountService AccountService
@inject SpiderHood.Services.AuthService AuthService

<PageTitle>Vacaciones</PageTitle>

<div class="container-fluid px-4 py-3">
    @if (!_loading && !_isStaff)
    {
        <div class="alert alert-warning">No tienes acceso a este módulo.</div>
    }
    else if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="page-header d-flex justify-content-between align-items-center">
            <div class="page-header-title">
                <div class="icon-badge"><i class="bi bi-airplane"></i></div>
                <h1 class="h3 fw-bold mb-0">Vacaciones</h1>
            </div>
            <button class="btn btn-primary" @onclick="AbrirNuevaSolicitud" disabled="@(_personal.Count == 0)">
                <i class="bi bi-plus-lg me-1"></i>Nueva solicitud
            </button>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-hourglass-split me-2"></i>Solicitudes pendientes de aprobación</div>
            <div class="card-body">
                @if (_pendientes.Count == 0)
                {
                    <p class="text-muted mb-0">No hay solicitudes pendientes.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Persona</th>
                                    <th>Período</th>
                                    <th>Días</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in _pendientes)
                                {
                                    <tr>
                                        <td>@v.Nombres @v.Apellidos</td>
                                        <td>@v.FechaInicio.ToString("dd/MM/yyyy") - @v.FechaFin.ToString("dd/MM/yyyy")</td>
                                        <td>@v.DiasSolicitados</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-success me-1" @onclick="() => Aprobar(v)">
                                                <i class="bi bi-check-lg"></i> Aprobar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Rechazar(v)">
                                                <i class="bi bi-x-lg"></i> Rechazar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-list-check me-2"></i>Saldo por persona</span>
                <select class="form-select form-select-sm" style="width:auto" @bind="_anioSaldo" @bind:after="CargarSaldosAsync">
                    @for (var y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <div class="card-body">
                @if (_saldos.Count == 0)
                {
                    <p class="text-muted mb-0">No hay personal registrado.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Persona</th>
                                    <th class="text-end">Ganados</th>
                                    <th class="text-end">Gozados</th>
                                    <th class="text-end">Pendientes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (persona, saldo) in _saldos)
                                {
                                    <tr>
                                        <td>@persona.NombreCompleto</td>
                                        <td class="text-end">@saldo.DiasGanados</td>
                                        <td class="text-end">@saldo.DiasGozados</td>
                                        <td class="text-end fw-bold">@saldo.DiasPendientes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva solicitud de vacaciones</h5>
                    <button type="button" class="btn-close" @onclick="() => _showModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Persona</label>
                        <select class="form-select" @bind="_form.IdPersonal">
                            @foreach (var p in _personal)
                            {
                                <option value="@p.IdPersonal">@p.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Desde</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaInicio" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Hasta</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaFin" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Días solicitados</label>
                        <InputNumber class="form-control" @bind-Value="_form.DiasSolicitados" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Año de período devengado</label>
                        <InputNumber class="form-control" @bind-Value="_form.Anio" />
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger py-2 px-3">@_error</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _showModal = false">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardar">Solicitar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private UserSession _currentUser = new();
    private bool _isStaff;
    private bool _loading = true;
    private Guid? _idAccount;

    private List<Models.Personal> _personal = new();
    private List<Models.Vacaciones> _pendientes = new();
    private int _anioSaldo = DateTime.Today.Year;
    private List<(Models.Personal Persona, Models.SaldoVacaciones Saldo)> _saldos = new();

    private bool _showModal;
    private Models.Vacaciones _form = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _isStaff = _currentUser.Roles.Contains("Administrador") || _currentUser.Roles.Contains("SysAdmin");

        if (_isStaff)
        {
            var account = await AccountService.GetAccountByUserAsync(_currentUser.IdUser);
            _idAccount = account?.IdAccount;
            if (_idAccount != null)
            {
                _personal = (await PersonalService.GetPersonalByAccountAsync(_idAccount.Value)).Where(p => p.IsActive).ToList();
                await CargarPendientesAsync();
                await CargarSaldosAsync();
            }
        }

        _loading = false;
    }

    private async Task CargarPendientesAsync()
    {
        if (_idAccount == null) return;
        _pendientes = await PlanillaService.GetVacacionesPendientesByAccountAsync(_idAccount.Value);
    }

    private async Task CargarSaldosAsync()
    {
        if (_idAccount == null) return;
        var lista = new List<(Models.Personal, Models.SaldoVacaciones)>();
        foreach (var p in _personal)
        {
            var saldo = await PlanillaService.GetSaldoVacacionesAsync(p.IdPersonal, _idAccount.Value, _anioSaldo);
            lista.Add((p, saldo));
        }
        _saldos = lista;
    }

    private void AbrirNuevaSolicitud()
    {
        _form = new Models.Vacaciones
        {
            IdPersonal = _personal.FirstOrDefault()?.IdPersonal ?? Guid.Empty,
            Anio = DateTime.Today.Year,
            FechaInicio = DateTime.Today,
            FechaFin = DateTime.Today.AddDays(7),
            DiasSolicitados = 7
        };
        _error = null;
        _showModal = true;
    }

    private async Task Guardar()
    {
        _error = null;
        var result = await PlanillaService.SolicitarVacacionesAsync(_form, _currentUser.Email);
        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _showModal = false;
        await CargarPendientesAsync();
    }

    private async Task Aprobar(Models.Vacaciones v)
    {
        await PlanillaService.AprobarVacacionesAsync(v.IdVacaciones, v.IdPersonal, _currentUser.IdUser, _currentUser.Email);
        await CargarPendientesAsync();
        await CargarSaldosAsync();
    }

    private async Task Rechazar(Models.Vacaciones v)
    {
        await PlanillaService.RechazarVacacionesAsync(v.IdVacaciones, v.IdPersonal, _currentUser.IdUser, _currentUser.Email, null);
        await CargarPendientesAsync();
    }
}
