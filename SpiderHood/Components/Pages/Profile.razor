@page "/Profile"
@using SpiderHood.Models
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@inject Services.AuthService AuthService
@inject Services.CustomAuthenticationStateProvider AuthStateProvider
@inject Services.IPreferenceService PreferenceService
@inject Services.IInstallmentService InstallmentService
@*@inject Services.ISessionService SessionService*@
@inject NavigationManager Navigation
@inject ILogger<Profile> Logger
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<style>
    /* Añadir a wwwroot/css/app.css o site.css */
    .profile-avatar {
        width: 100px;
        height: 100px;
        background: var(--bs-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: white;
    }

    .card {
        transition: box-shadow 0.2s ease-in-out;
    }

        .card:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .nav-tabs .nav-link {
        color: var(--bs-secondary);
    }

        .nav-tabs .nav-link.active {
            font-weight: 600;
            color: var(--bs-primary);
        }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
        cursor: default;
    }
</style>

<PageTitle>Mi Perfil - SpiderHood</PageTitle>

<div class="container-fluid">
    <!-- Encabezado con navegación tipo tabs -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-person me-2"></i>
            Mi Perfil
        </h2>
        <div class="btn-group" role="group">
            <button class="btn btn-outline-secondary" @onclick="() => _activeTab = Tab.Info">
                <i class="bi bi-person-vcard"></i> Personal
            </button>
            <button class="btn btn-outline-secondary" @onclick="() => _activeTab = Tab.Security">
                <i class="bi bi-shield-lock"></i> Seguridad
            </button>
            <button class="btn btn-outline-secondary" @onclick="() => _activeTab = Tab.Buildings">
                <i class="bi bi-building"></i> Edificios
            </button>
            <button class="btn btn-outline-secondary" @onclick="() => _activeTab = Tab.Finances">
                <i class="bi bi-wallet2"></i> Finanzas
            </button>
            <button class="btn btn-outline-secondary" @onclick="() => _activeTab = Tab.Preferences">
                <i class="bi bi-sliders"></i> Preferencias
            </button>
        </div>
    </div>

    <!-- Estado de carga -->
    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-muted">Cargando tu perfil...</p>
        </div>
    }
    else if (_user == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No se pudo cargar tu perfil. 
            <button class="btn btn-link p-0 ms-2" @onclick="LoadProfileAsync">Reintentar</button>
        </div>
    }
    else
    {
        <!-- Sistema de notificaciones -->
        @if (!string.IsNullOrEmpty(_notificationMessage))
        {
            <div class="alert alert-@_notificationType alert-dismissible fade show" role="alert">
                <i class="bi bi-@(_notificationType == "success" ? "check-circle" : "exclamation-circle") me-2"></i>
                @_notificationMessage
                <button type="button" class="btn-close" @onclick="() => ClearNotification()"></button>
            </div>
        }

        <!-- Tabs de contenido -->
        <div class="row">
            <div class="col-lg-12">
                @switch (_activeTab)
                {
                    case Tab.Info:
                        @RenderInfoTab()
                        break;
                    case Tab.Security:
                        @RenderSecurityTab()
                        break;
                    case Tab.Buildings:
                        @RenderBuildingsTab()
                        break;
                    case Tab.Finances:
                        @RenderFinancesTab()
                        break;
                    case Tab.Preferences:
                        @RenderPreferencesTab()
                        break;
                }
            </div>
        </div>
    }
</div>

@* ============================================================
   RENDER DE CADA TAB (Métodos para mejor organización)
   ============================================================ *@

@code {
    // =========================================================
    // 1. ESTADO Y MODELOS
    // =========================================================

    private bool _loading = true;
    private bool _savingProfile;
    private bool _savingPassword;
    private bool _savingPreferences;
    private bool _savingBuilding;
    private UserModel? _user;
    private UserSession? _session;
    private bool _initialized;

    // Estado de notificaciones
    private string _notificationMessage = string.Empty;
    private string _notificationType = "success";

    // Tab activa
    private Tab _activeTab = Tab.Info;
    private enum Tab { Info, Security, Buildings, Finances, Preferences }

    // Modelos de formularios
    private ProfileFormModel _profileForm = new();
    private ChangePasswordFormModel _passwordForm = new();
    private Services.Preferences _preferences = new();

    // Datos adicionales
    private List<PaymentHistory> _recentPayments = [];
    private decimal _accountBalance;
    private decimal _outstandingDebt;
    private DateTime _nextDueDate;
    private bool _is2FAEnabled;

    // =========================================================
    // 2. CICLO DE VIDA E INICIALIZACIÓN
    // =========================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadProfileAsync();
            StateHasChanged();
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _loading = true;
            ClearNotification();

            // 1. Inicializar cliente y obtener sesión
            await AuthStateProvider.InitializeClientAsync();
            _session = await AuthService.GetCurrentUserAsync();

            if (_session == null)
            {
                Logger.LogWarning("Intento de acceso a perfil sin sesión activa. Redirigiendo a login.");
                Navigation.NavigateTo("/login", true);
                return;
            }

            // 2. Cargar datos del usuario
            _user = await AuthService.GetUserProfileAsync(_session.IdUser);
            if (_user == null)
            {
                Logger.LogError("No se pudo cargar el perfil del usuario {UserId}", _session.IdUser);
                _notificationMessage = "No se pudieron cargar los datos de tu perfil. Por favor, intenta de nuevo.";
                _notificationType = "danger";
                return;
            }

            // 3. Mapear datos a formularios
            _profileForm.FirstName = _user.FirstName;
            _profileForm.LastName = _user.LastName;
            _profileForm.PhoneNumber = _user.PhoneNumber;

            // 4. Cargar datos adicionales
            await LoadAdditionalDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar el perfil para usuario {UserId}", _session?.IdUser);
            _notificationMessage = "Ocurrió un error al cargar tu perfil. Por favor, recarga la página.";
            _notificationType = "danger";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAdditionalDataAsync()
    {
        try
        {
            // Cargar datos financieros — misma fuente que Mis Recibos/Mis Deudas
            // (Installment/InstallmentPaid filtrados por la unidad del residente), no un
            // resumen aparte. Sólo aplica si el usuario tiene una unidad vinculada a su
            // rol actual (ver UserRoles.razor > "Unidad (Residente)"); si no, las
            // tarjetas quedan en 0 sin generar error — no todo usuario es residente.
            var idUnit = await AuthService.GetCurrentUnitIdAsync();
            if (idUnit != null && _session != null && _session.CurrentBuildingId != Guid.Empty)
            {
                var idBuilding = _session.CurrentBuildingId;
                var misCuotas = (await InstallmentService.GetPendingInstallmentsAsync(idBuilding))
                    .Where(c => c.IdGroupUnit == idUnit)
                    .ToList();

                _outstandingDebt = misCuotas.Sum(c => c.Debt);
                _accountBalance = misCuotas.Sum(c => c.AmountPaid);
                _nextDueDate = misCuotas.Where(c => c.Debt > 0).OrderBy(c => c.DueDate)
                    .Select(c => (DateTime?)c.DueDate).FirstOrDefault() ?? default;

                var buildingName = _session.Buildings
                    .FirstOrDefault(b => b.Building?.IdBuilding == idBuilding)?.Building?.Name ?? string.Empty;
                var cuotasPorId = misCuotas.ToDictionary(c => c.IdInstallment);

                _recentPayments = (await InstallmentService.GetInstallmentsPaidAsync(idBuilding))
                    .Where(p => cuotasPorId.ContainsKey(p.IdInstallment))
                    .OrderByDescending(p => p.PaymentDate)
                    .Take(5)
                    .Select(p => new PaymentHistory
                    {
                        Date = p.PaymentDate,
                        Concept = string.IsNullOrWhiteSpace(cuotasPorId[p.IdInstallment].Concept)
                            ? cuotasPorId[p.IdInstallment].Type.ToString()
                            : cuotasPorId[p.IdInstallment].Concept,
                        BuildingName = buildingName,
                        Amount = p.Amount,
                        Status = p.IsPartialPayment ? "Parcial" : "Pagado"
                    })
                    .ToList();
            }

            // Cargar preferencias (localStorage — ver PreferenceService). Durante el
            // prerender estático esto devuelve los valores por defecto porque todavía
            // no hay JS interop disponible; una vez conectado el circuito, este mismo
            // método vuelve a correr (ver OnAfterRenderAsync) y trae los reales.
            _preferences = await PreferenceService.GetPreferencesAsync(_user!.IdUser);

            // Verificar estado 2FA
            _is2FAEnabled = true; //await AuthService.Is2FAEnabledAsync(_user.IdUser);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar datos adicionales para usuario {UserId}", _user?.IdUser);
        }
    }

    // =========================================================
    // 3. RENDER DE CADA TAB (Métodos de UI)
    // =========================================================

    private RenderFragment RenderInfoTab() => @<div class="row">
        <div class="col-lg-4 mb-4">
            <!-- Tarjeta de perfil lateral -->
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <div class="profile-avatar mx-auto mb-3" style="width:100px;height:100px;background:var(--bs-primary);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2.5rem;color:white;">
                        @GetInitials()
                    </div>
                    <h5 class="mb-1">@_user.FirstName @_user.LastName</h5>
                    <p class="text-muted mb-2">@_user.Email</p>
                    @if (_session != null && _session.Roles.Any())
                    {
                        <div class="mb-2">
                            @foreach (var role in _session.Roles.Where(r => !string.IsNullOrWhiteSpace(r)).Distinct())
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        </div>
                    }
                    <p class="text-muted small mb-0">
                        <i class="bi bi-calendar3 me-1"></i>
                        Miembro desde @(_user.CreatedAt == default ? "—" : _user.CreatedAt.ToString("dd/MM/yyyy"))
                    </p>
                    @if (_is2FAEnabled)
                    {
                        <span class="badge bg-success mt-2">2FA Activado</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <!-- Información Personal -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person-vcard me-2"></i>Información Personal
                </div>
                <div class="card-body">
                    <EditForm Model="@_profileForm" OnValidSubmit="@HandleProfileSubmit" FormName="profileForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="firstName" class="form-label">Nombres</label>
                                <InputText id="firstName" class="form-control" @bind-Value="_profileForm.FirstName" />
                                <ValidationMessage For="@(() => _profileForm.FirstName)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="lastName" class="form-label">Apellidos</label>
                                <InputText id="lastName" class="form-control" @bind-Value="_profileForm.LastName" />
                                <ValidationMessage For="@(() => _profileForm.LastName)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label">Email</label>
                                <input id="email" class="form-control" value="@_user.Email" disabled />
                                <small class="text-muted">El email no se puede modificar directamente.</small>
                            </div>
                            <div class="col-md-6">
                                <label for="phone" class="form-label">Teléfono</label>
                                <InputText id="phone" class="form-control" @bind-Value="_profileForm.PhoneNumber" />
                                <ValidationMessage For="@(() => _profileForm.PhoneNumber)" class="text-danger small" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary mt-3" disabled="@_savingProfile">
                            @if (_savingProfile)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Guardar Cambios
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>;

    private RenderFragment RenderSecurityTab() => @<div class="row">
        <div class="col-lg-6">
            <!-- Cambiar Contraseña -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-lock me-2"></i>Cambiar Contraseña
                </div>
                <div class="card-body">
                    <EditForm Model="@_passwordForm" OnValidSubmit="@HandlePasswordSubmit" FormName="passwordForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label for="currentPassword" class="form-label">Contraseña Actual</label>
                                <InputText id="currentPassword" type="password" class="form-control" @bind-Value="_passwordForm.CurrentPassword" />
                                <ValidationMessage For="@(() => _passwordForm.CurrentPassword)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="newPassword" class="form-label">Nueva Contraseña</label>
                                <InputText id="newPassword" type="password" class="form-control" @bind-Value="_passwordForm.NewPassword" />
                                <ValidationMessage For="@(() => _passwordForm.NewPassword)" class="text-danger small" />
                                <small class="text-muted">Mínimo 8 caracteres.</small>
                            </div>
                            <div class="col-md-6">
                                <label for="confirmPassword" class="form-label">Confirmar Nueva Contraseña</label>
                                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="_passwordForm.ConfirmNewPassword" />
                                <ValidationMessage For="@(() => _passwordForm.ConfirmNewPassword)" class="text-danger small" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-secondary mt-3" disabled="@_savingPassword">
                            @if (_savingPassword)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Cambiar Contraseña
                        </button>
                    </EditForm>
                </div>
            </div>

            <!-- Autenticación de Dos Factores -->
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-shield-check me-2"></i>Autenticación en Dos Pasos (2FA)
                </div>
                <div class="card-body">
                    <p class="text-muted">Añade una capa extra de seguridad a tu cuenta.</p>
                    @if (_is2FAEnabled)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            2FA está <strong>activado</strong> para tu cuenta.
                        </div>
                        <button class="btn btn-outline-danger" @onclick="Disable2FA">
                            <i class="bi bi-x-circle me-1"></i> Desactivar 2FA
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            2FA está <strong>desactivado</strong>. Recomendamos activarlo.
                        </div>
                        <button class="btn btn-outline-success" @onclick="Enable2FA">
                            <i class="bi bi-shield-plus me-1"></i> Activar 2FA
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <!-- Sesiones Activas -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    <i class="bi bi-devices me-2"></i>Sesiones Activas
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Todavía no identificamos cada sesión individualmente (dispositivo, IP,
                        último acceso) — pero si sospechás que alguien más tiene acceso a tu
                        cuenta, esto cierra <strong>todas</strong> las sesiones activas de una:
                    </p>
                    <button class="btn btn-outline-warning" @onclick="LogoutAllSessions">
                        <i class="bi bi-power"></i> Cerrar sesión en todos los dispositivos
                    </button>
                    <small class="d-block text-muted mt-1">
                        Esto también cierra esta sesión — vas a tener que volver a iniciar sesión.
                    </small>
                </div>
            </div>

            <!-- Historial de Accesos -->
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-clock-history me-2"></i>Historial de Accesos Recientes
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>IP</th>
                                    <th>Dispositivo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var access in _recentAccessLogs.Take(5))
                                {
                                    <tr>
                                        <td>@access.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@access.IPAddress</td>
                                        <td>@access.Device</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_recentAccessLogs.Count() > 5)
                    {
                        <button class="btn btn-link btn-sm" @onclick="ViewFullAccessLog">Ver historial completo</button>
                    }
                </div>
            </div>
        </div>
    </div>;

    private RenderFragment RenderBuildingsTab() => @<div class="row">
        <div class="col-lg-7">
            <!-- Mis Edificios -->
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-building me-2"></i>Mis Edificios
                </div>
                <div class="card-body">
                    @if (_session?.Buildings?.Any() == true)
                    {
                        @foreach (var building in _session.Buildings.OrderBy(b => b.IsApproved ? 0 : 1))
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div>
                                    <strong>@building.Building?.Name</strong>
                                    <small class="d-block text-muted">@building.Building?.Floors</small>
                                    <div class="mt-1">
                                        <span class="badge bg-secondary me-1">@building.Role</span>
                                        @if (building.IsApproved)
                                        {
                                            <span class="badge bg-success">Aprobado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                    </div>
                                    @if (building.Building != null && building.IsApproved)
                                    {
                                        <small class="text-muted d-block">
                                            <i class="bi bi-people me-1"></i>@building.Building.Floors unidades
                                        </small>
                                    }
                                </div>
                                @if (building.IsApproved && building.Building != null)
                                {
                                    var isCurrent = _session.CurrentBuildingId == building.Building.IdBuilding
                                        && _session.Role == building.Role;
                                    <button class="btn btn-sm @(isCurrent ? "btn-success" : "btn-outline-primary")"
                                            @onclick="() => SetDefaultBuilding(building.Building.IdBuilding, building.Role)"
                                            disabled="@isCurrent">
                                        @(isCurrent ? "✓ Actual" : "Predeterminado")
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-building fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No tienes edificios asignados.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <!-- Solicitar Acceso -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-plus-circle me-2"></i>Solicitar Acceso a Edificio
                </div>
                <div class="card-body text-center">
                    <p class="text-muted">
                        ¿Necesitás acceso a otro edificio como Residente? Enviá una solicitud;
                        el administrador del edificio la revisa y aprueba.
                    </p>
                    <a href="/building-request" class="btn btn-primary">
                        <i class="bi bi-send me-2"></i>Solicitar Acceso a Edificio
                    </a>
                </div>
            </div>
        </div>
    </div>;

    private RenderFragment RenderFinancesTab() => @<div class="row">
        <div class="col-lg-12">
            <!-- Resumen Financiero -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-wallet2 me-2"></i>Resumen Financiero
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted">Total Pagado</small>
                                <h5 class="mb-0 text-success">
                                    @_accountBalance.ToString("C")
                                </h5>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted">Deuda Pendiente</small>
                                <h5 class="mb-0 text-danger">
                                    @_outstandingDebt.ToString("C")
                                </h5>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted">Próximo Vencimiento</small>
                                <h5 class="mb-0">
                                    @(_nextDueDate == default ? "Sin pendientes" : _nextDueDate.ToString("dd/MM/yyyy"))
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Historial de Pagos -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-clock-history me-2"></i>Historial de Pagos
                </div>
                <div class="card-body">
                    @if (_recentPayments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Concepto</th>
                                        <th>Edificio</th>
                                        <th>Monto</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in _recentPayments)
                                    {
                                        <tr>
                                            <td>@payment.Date.ToString("dd/MM/yyyy")</td>
                                            <td>@payment.Concept</td>
                                            <td>@payment.BuildingName</td>
                                            <td>@payment.Amount.ToString("C")</td>
                                            <td>
                                                <span class="badge bg-@(payment.Status == "Pagado" ? "success" : "warning")">
                                                    @payment.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ViewFullHistory">
                            <i class="bi bi-arrow-right"></i> Ver historial completo
                        </button>
                    }
                    else
                    {
                        <p class="text-muted">No hay movimientos recientes.</p>
                    }
                </div>
            </div>
        </div>
    </div>;

    private RenderFragment RenderPreferencesTab() => @<div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-sliders me-2"></i>Preferencias del Usuario
                </div>
                <div class="card-body">
                    <EditForm Model="@_preferences" OnValidSubmit="@SavePreferences">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-6">
