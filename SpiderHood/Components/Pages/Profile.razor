    // 4. MANEJADORES DE EVENTOS (Lógica de Negocio)
    // =========================================================

    private async Task HandleProfileSubmit()
    {
        if (_user == null) return;

        try
        {
            _savingProfile = true;
            ClearNotification();

            var result = await AuthService.UpdateProfileAsync(
                _user.IdUser,
                _profileForm.FirstName.Trim(),
                _profileForm.LastName.Trim(),
                _profileForm.PhoneNumber?.Trim() ?? string.Empty
            );

            if (result.Success)
            {
                _user.FirstName = _profileForm.FirstName.Trim();
                _user.LastName = _profileForm.LastName.Trim();
                _user.PhoneNumber = _profileForm.PhoneNumber?.Trim() ?? string.Empty;

                if (_session != null)
                {
                    _session.FullName = $"{_user.FirstName} {_user.LastName}";
                }

                _notificationMessage = result.Message;
                _notificationType = "success";
                Logger.LogInformation("Perfil actualizado exitosamente para usuario {UserId}", _user.IdUser);
            }
            else
            {
                _notificationMessage = result.Message;
                _notificationType = "danger";
                Logger.LogWarning("Error al actualizar perfil para usuario {UserId}: {Message}", _user.IdUser, result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar cambios de perfil para usuario {UserId}", _user.IdUser);
            _notificationMessage = "Ocurrió un error al guardar los cambios. Por favor, intenta de nuevo.";
            _notificationType = "danger";
        }
        finally
        {
            _savingProfile = false;
        }
    }

    private async Task HandlePasswordSubmit()
    {
        if (_user == null) return;

        if (_passwordForm.NewPassword != _passwordForm.ConfirmNewPassword)
        {
            _notificationMessage = "Las contraseñas no coinciden.";
            _notificationType = "danger";
            return;
        }

        try
        {
            _savingPassword = true;
            ClearNotification();

            var result = await AuthService.ChangePasswordAsync(
                _user.IdUser,
                _passwordForm.CurrentPassword,
                _passwordForm.NewPassword
            );

            if (result.Success)
            {
                _passwordForm = new();
                Logger.LogInformation("Contraseña cambiada exitosamente para usuario {UserId}", _user.IdUser);

                // ChangePasswordAsync ya invalidó toda cookie emitida para este usuario
                // (ver AuthService.RevokeAllSessions) — incluida esta misma, aunque no se
                // note hasta la próxima navegación real. En vez de dejar que eso pase
                // solo, más tarde y sin explicación, cerramos la sesión actual ahora
                // mismo y mandamos a loguearse de nuevo con la contraseña nueva.
                _notificationMessage = "Contraseña actualizada. Por seguridad, tenés que volver a iniciar sesión...";
                _notificationType = "success";
                StateHasChanged();
                await Task.Delay(1500);
                Navigation.NavigateTo("/Logout", forceLoad: true);
                return;
            }

            _notificationMessage = result.Message;
            _notificationType = "danger";
            Logger.LogWarning("Intento fallido de cambio de contraseña para usuario {UserId}: {Message}", _user.IdUser, result.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cambiar contraseña para usuario {UserId}", _user.IdUser);
            _notificationMessage = "Ocurrió un error al cambiar la contraseña. Por favor, intenta de nuevo.";
            _notificationType = "danger";
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private async Task SetDefaultBuilding(Guid buildingId, string role)
    {
        try
        {
            _savingBuilding = true;
            ClearNotification();

            // Usa el rol de la fila en la que se hizo clic, no el rol activo de la
            // sesión actual — antes usaba _session.Role, así que hacer clic en
            // "Predeterminado" sobre un edificio/rol distinto al que estabas usando en
            // ese momento igual aplicaba tu rol ACTUAL a ESE edificio, en vez del rol
            // que en realidad correspondía a la fila elegida.
            await AuthService.SetCurrentBuilding(buildingId, role);

            if (_session != null)
            {
                _session.CurrentBuildingId = buildingId;
                _session.Role = role;
                await AuthStateProvider.MarkUserAsAuthenticated(_session);
            }

            // Esto es lo que hace que la próxima vez que el usuario entre no se le
            // vuelva a preguntar por el edificio y rol — ver
            // AuthService.TryApplyDefaultBuildingAsync.
            await AuthService.SetDefaultBuildingAsync(buildingId);
            await AuthService.SetDefaultRoleAsync(role);

            _notificationMessage = "Edificio predeterminado actualizado exitosamente.";
            _notificationType = "success";
            Logger.LogInformation("Edificio predeterminado actualizado para usuario {UserId}", _user!.IdUser);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al establecer edificio predeterminado para usuario {UserId}", _user?.IdUser);
            _notificationMessage = "Error al actualizar el edificio predeterminado.";
            _notificationType = "danger";
        }
        finally
        {
            _savingBuilding = false;
        }
    }

    private async Task SavePreferences()
    {
        if (_user == null) return;

        try
        {
            _savingPreferences = true;
            ClearNotification();

            _preferences.UserId = _user.IdUser;
            var result = await PreferenceService.SavePreferencesAsync(_preferences);

            if (result.Success)
            {
                // Aplica el tema al instante (sin recargar) y lo deja en la clave simple
                // "theme" que lee el script anti-flash de App.razor — ver wwwroot/js/theme.js.
                await JSRuntime.InvokeVoidAsync("spiderHoodTheme.set", _preferences.Theme);

                _notificationMessage = "Preferencias guardadas exitosamente.";
                _notificationType = "success";
                Logger.LogInformation("Preferencias guardadas para usuario {UserId}", _user.IdUser);
            }
            else
            {
                _notificationMessage = result.Message;
                _notificationType = "danger";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar preferencias para usuario {UserId}", _user.IdUser);
            _notificationMessage = "Error al guardar las preferencias.";
            _notificationType = "danger";
        }
        finally
        {
            _savingPreferences = false;
        }
    }

