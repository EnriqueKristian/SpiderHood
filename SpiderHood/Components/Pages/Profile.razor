    private async Task LogoutAllSessions()
    {
        if (_user == null) return;

        try
        {
            // Invalida toda cookie ya emitida para este usuario (ver
            // ISessionRevocationService) — incluida esta misma pestaña: no hay forma de
            // "perdonar" la sesión actual sin reemitir su cookie, y eso sólo se puede
            // hacer desde una request HTTP real, no desde este circuito ya conectado
            // (ver Login.razor/HandleLogin). Por eso el redirect de abajo saca al
            // usuario también a él — tiene que volver a loguearse para confirmar que
            // sigue siendo dueño de la cuenta, igual que "cerrar todo" en la mayoría de
            // los servicios (Google, GitHub, etc.).
            AuthService.RevokeAllSessions(_user.IdUser);
            Logger.LogInformation("Sesiones cerradas por el usuario {UserId} desde Profile", _user.IdUser);

            Navigation.NavigateTo("/Logout", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cerrar todas las sesiones para usuario {UserId}", _user?.IdUser);
            _notificationMessage = "Error al cerrar las sesiones.";
            _notificationType = "danger";
        }
    }

    private void ClearNotification()
    {
        _notificationMessage = string.Empty;
    }

    private string GetInitials()
    {
        if (_user == null) return "U";
        var first = string.IsNullOrWhiteSpace(_user.FirstName) ? "" : _user.FirstName[0].ToString();
        var last = string.IsNullOrWhiteSpace(_user.LastName) ? "" : _user.LastName[0].ToString();
        var initials = $"{first}{last}".ToUpper();
        return string.IsNullOrEmpty(initials) ? "U" : initials;
    }

