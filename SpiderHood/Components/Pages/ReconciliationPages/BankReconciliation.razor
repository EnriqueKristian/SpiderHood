    // Único camino para conciliar un Ingreso contra una o varias cuotas: cubre pago menor,
    // igual y mayor (incluso cubriendo varias cuotas) con la misma lógica de
    // InstallmentService.AplicarPagoAsync, en vez de mantener una copia local divergente.
    private async Task ConciliarConCuota(TransactionBankDetail transaccion, Installment cuota, bool automatico = false)
    {
        await AplicarPagoACuotas(transaccion, new List<Installment> { cuota }, automatico);
    }

    private async Task<bool> AplicarPagoACuotas(TransactionBankDetail transaccion, List<Installment> cuotas, bool automatico = false)
    {
        if (!_canReconcileInstallments) return false;
        try
        {
            if (transaccion == null) throw new ArgumentNullException(nameof(transaccion));
            if (cuotas == null || !cuotas.Any()) throw new ArgumentException("Debe seleccionar al menos una cuota");

            await InstallmentService.AplicarPagoAsync(transaccion, cuotas, BankService, automatico);

            await ActualizarEstadoPostConciliacion(automatico);
            return true;
        }
        catch (Exception ex)
        {
            await ManejarErrorConciliacion(ex);
            return false;
        }
    }

    private async Task ActualizarEstadoPostConciliacion(bool automatico)
    {
        // Recalcular estadísticas
        CalcularEstadisticas();
        ActualizarPaginacion();

        // Actualizar listas pendientes
        await ActualizarListasPendientes();

        // Cerrar modal si no es automático
        if (!automatico)
        {
            CerrarModalConciliar();
            // Mostrar mensaje de éxito
            MostrarMensajeExito("Transacción conciliada exitosamente");
        }

        // Forzar actualización de UI
        StateHasChanged();
    }

