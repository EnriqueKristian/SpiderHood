    private async Task FinalizarConciliacion()
    {
        if (!_canReconcileExpenses) return;
        if (transaccionesNoConciliadas.Any())
        {
            if (!await JSRuntime.InvokeAsync<bool>("confirm", 
                "Hay transacciones pendientes de conciliar. ¿Deseas finalizar de todos modos?"))
            {
                return;
            }
        }

        try
        {

            foreach (var transaccion in transacciones.Where(c => c.ReconciliationStatus == ConcilationType.Conciliada && c.GastoConciliado != null))
            {
                ViewExpense gasto = transaccion.GastoConciliado!;
                Guid Id = transaccion.IdStatementDetail;

                // Actualizar en base de datos
                await BankService.ConciliarTransaccionAsync( transaccion, gasto);
                await ExpenseService.MarcarGastoComoConciliadoAsync(gasto.IdExpense, transaccion.IdStatementDetail);
            }

            foreach (var transaccion in transacciones.Where(c => c.ReconciliationStatus == ConcilationType.NoConciliada && c.GastoConciliado != null))
            {
                ViewExpense gasto = transaccion.GastoConciliado!;
                Guid Id = transaccion.IdStatementDetail;


                // Actualizar en base de datos
                await BankService.DesconciliarTransaccionAsync(transaccion);
                await ExpenseService.DesconciliarGastoAsync(transaccion.GastoConciliado?.IdExpense ?? Guid.Empty);
            }

            var conciliacion = new Conciliacion
            {
                CuentaBancariaId = cuentaSeleccionadaId,
                FechaInicio = fechaDesde,
                FechaFin = fechaHasta,
                TransaccionesProcesadas = transacciones.Count,
                TransaccionesConciliadas = transaccionesConciliadas.Count,
                Diferencia = diferenciaConciliacion,
                Completada = true,
                Fecha = DateTime.Now,
                Usuario = "Administrador" // En una app real, esto vendría del usuario autenticado
            };

            await BankService.GuardarConciliacionAsync(conciliacion);
            mensajeExito = "Conciliación finalizada exitosamente";

            await CargarTransacciones();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al finalizar conciliación: {ex.Message}";
        }
    }

