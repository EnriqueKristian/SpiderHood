@page "/ReconcileExpenses"
@page "/ReconcileExpenses/{accountId:guid}"
@using SpiderHood.Components.Pages.MovementPages
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@inject IExpenseService ExpenseService
@inject IBankAccountService BankService
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer
@inject ParameterService ParameterService
@inject SpiderHood.Services.AuthService AuthService
@inject SpiderHood.Services.IPermissionService PermissionService

<PageTitle>SpiderHood - Conciliación Bancaria</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header mb-0">
                <div class="page-header-title">
                    <div class="icon-badge">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <h1 class="h3 fw-bold mb-1">Conciliación Bancaria</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                                <li class="breadcrumb-item"><a href="/finanzas">Finanzas</a></li>
                                <li class="breadcrumb-item active">Conciliación</li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div class="page-header-actions">
                    <button class="btn btn-outline-primary" @onclick="ExportarConciliacion">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i> Exportar
                    </button>
                    <button class="btn btn-primary" @onclick="MostrarModalCargarEstado">
                        <i class="bi bi-upload me-1"></i> Cargar Estado
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <!-- Selector de Cuenta y Período -->
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Cuenta Bancaria</label>
                            <select class="form-select" @onchange="CambiarCuenta">
                                <option value="">Seleccionar cuenta...</option>
                                @foreach (var cuenta in cuentasBancarias)
                                {
                                    <option value="@cuenta.IdBankAccount">@cuenta.BankName (@cuenta.AccountNumber)</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label">Período</label>
                            <select class="form-select" @bind="periodoSeleccionado" @bind:after="CambiarPeriodo">
                                <option value="mesActual">Mes Actual</option>
                                <option value="mesAnterior">Mes Anterior</option>
                                <option value="trimestreActual">Trimestre Actual</option>
                                <option value="personalizado">Personalizado</option>
                            </select>
                        </div>

                        @if (periodoSeleccionado == "personalizado")
                        {
                            <div class="col-md-2">
                                <label class="form-label">Desde</label>
                                <input type="date" class="form-control" @bind="fechaDesde" @bind:after="CambiarPeriodo" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Hasta</label>
                                <input type="date" class="form-control" @bind="fechaHasta" @bind:after="CambiarPeriodo" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Resumen Conciliación</h6>
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-value text-primary">@totalTransacciones</div>
                                <div class="stat-label">Transacciones</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-value @(totalPendiente > 0 ? "text-warning" : "text-success")">
                                    @totalPendiente.ToString("C")
                                </div>
                                <div class="stat-label">Pendiente</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (cuentaSeleccionadaId == Guid.Empty)
    {
        <div class="text-center py-5">
            <i class="bi bi-bank bi-3x text-muted mb-3"></i>
            <h5 class="text-muted">Selecciona una cuenta bancaria para comenzar</h5>
            <p class="text-muted">O carga un nuevo estado de cuenta</p>
        </div>
    }
    else if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3">Cargando transacciones...</p>
        </div>
    }
    else
    {
        <!-- Filtros y Búsqueda -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-3 align-items-center">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="showOnlyUnmatched"
                                           @bind="mostrarSoloNoConciliados"
                                           @bind:after="ActualizarPaginacion" />
                                    <label class="form-check-label" for="showOnlyUnmatched">
                                        Mostrar solo no conciliados
                                    </label>
                                </div>
                                
                                <div class="vr"></div>
                                
                                <!--    BOTONES DE FILTRO   -->
                                <div class="btn-group" role="group">
                                    <button class="btn @(filtroTipo == null ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => FiltrarPorTipo(null)">
                                        Todas (@totalTransacciones)
                                    </button>
                                    <button class="btn @(filtroTipo == "Gasto" ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => FiltrarPorTipo(Gasto)">
                                        Gastos (@transacciones.Count(t => t.Tipo == "Gasto"))
                                    </button>
                                    <button class="btn @(filtroTipo == "Ingreso" ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => FiltrarPorTipo(Ingreso)">
                                        Ingresos (@transacciones.Count(t => t.Tipo == "Ingreso"))
                                    </button>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-2">
                                <div class="input-group" style="width: 300px;">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Buscar descripción, referencia..."
                                           @bind="textoBusqueda"
                                           @bind:event="oninput"
                                           @bind:after="ActualizarPaginacion" />
                                </div>
                                
                                <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pestañas de Transacciones -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "noConciliados" ? "active" : "")" 
                                        @onclick="() => CambiarTab(noConciliados)">
                                    <i class="bi bi-question-circle me-2"></i>
                                    No Conciliados
                                    <span class="badge bg-warning ms-2">@transaccionesNoConciliadas.Count</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "conciliados" ? "active" : "")" 
                                        @onclick="() => CambiarTab(conciliados)">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Conciliados
                                    <span class="badge bg-success ms-2">@transaccionesConciliadas.Count</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "todos" ? "active" : "")" 
                                        @onclick="() => CambiarTab(todos)">
                                    <i class="bi bi-list me-2"></i>
                                    Todas las Transacciones
                                    <span class="badge bg-secondary ms-2">@transacciones.Count</span>
                                </button>
                            </li>
                        </ul>
                        
                        <div class="tab-content">
                            <!-- Paginación: encabezado con estadísticas y selector de página -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center px-3 pt-3">
                                <p class="text-muted mb-0">
                                    Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords transacciones
                                </p>
                                <div class="d-flex align-items-center">
                                    <label class="me-2 text-muted">Mostrar:</label>
                                    <select class="form-select form-select-sm" style="width: auto;"
                                            @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                                        <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                                        <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                                        <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                                        <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Tabla de Transacciones -->
                            <div class="table-responsive" style="max-height: 600px;">
                                <table class="table table-hover mb-0">
                                    <thead class="sticky-top bg-white" style="top: 0; z-index: 1;">
                                        <tr>
                                            <th width="40">
                                                <input type="checkbox" 
                                                       class="form-check-input" 
                                                       @onchange="SeleccionarTodosTransacciones">
                                            </th>
                                            <th width="60">Fecha</th>
                                            <th>Descripción</th>
                                            <th width="80">Referencia</th>
                                            <th width="100" class="text-end">Monto</th>
                                            <th width="80">Tipo</th>
                                            <th width="150">Conciliado Con</th>
                                            <th width="100">Estado</th>
                                            <th width="120" class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var transaccion in pagination.CurrentPageData)
                                        {
                                            <tr class="@(transaccion.Selected ? "table-primary" : "")">
                                                <td>
                                                    @if (transaccion.ReconciliationStatus == 0)
                                                    {
                                                        <input type="checkbox" 
                                                               class="form-check-input" 
                                                               @bind="transaccion.Selected" />
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark">
                                                        @transaccion.StatementDate.ToString("dd/MM/yy")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                        {
                                                            <i class="bi bi-check-circle text-success me-2"></i>
                                                        }
                                                        <div>
                                                            <div class="fw-bold">@transaccion.Description</div>
                                                            @if (!string.IsNullOrEmpty(transaccion.Notes))
                                                            {
                                                                <small class="text-muted">@transaccion.Notes</small>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <code>@transaccion.Reference</code>
                                                </td>
                                                <td class="text-end fw-bold @(transaccion.Amount  < 0 ? "text-danger" : "text-success")">
                                                    @Math.Abs(transaccion.Amount).ToString("C")
                                                </td>
                                                <td>
                                                    <span class="badge @(transaccion.Amount < 0 ? "bg-danger" : "bg-success")">
                                                        @transaccion.Tipo
                                                    </span>
                                                </td>
                                                <td>
                                                    @if( transaccion.Tipo == "Gasto") { 
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                    {
                                                        <div class="d-flex align-items-center">
                                                            <i class="bi bi-link-45deg text-primary me-2"></i>
                                                            <div>
                                                                <div class="small">@transaccion.GastoConciliado?.Category</div>
                                                                <div class="text-muted small">@transaccion.GastoConciliado?.Description</div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (transaccion.PosiblesMatches.Any())
                                                    {
                                                        var gastosIds = new HashSet<Guid>(gastosPendientes.Select(g => g.IdExpense));

                                                        @if(transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)).Count() > 0 ){
                                                            
                                                            <div class="dropdown">
                                                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" 
                                                                        type="button" 
                                                                        data-bs-toggle="dropdown">
                                                                    @transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)).Count() posibles matches
                                                                </button>
                                                                <ul class="dropdown-menu">
                                                                @foreach (var match in transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" 
                                                                            @onclick="() => ConciliarConGasto(transaccion, match)">
                                                                            <div class="d-flex justify-content-between">
                                                                                <span>@match.Category</span>
                                                                                <span class="text-muted">@match.Amount.ToString("C")</span>
                                                                            </div>
                                                                            <small class="text-muted">@match.Description</small>
                                                                        </a>
                                                                    </li>
                                                                }
                                                                </ul>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                        {
                                                            <div class="d-flex align-items-center">
                                                                <i class="bi bi-link-45deg text-primary me-2"></i>
                                                                <div>
                                                                    <div class="small">@transaccion.GastoConciliado?.Category</div>
                                                                    <div class="text-muted small">@transaccion.GastoConciliado?.Description</div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (transaccion.IPosiblesMatches.Any())
                                                        {
                                                            var cuotasIds = new HashSet<Guid>(cuotaspendientes.Select(g => g.IdInstallment));

                                                            @if (transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)).Count() > 0)
                                                            {
                                                                <div class="dropdown">
                                                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                                                            type="button"
                                                                            data-bs-toggle="dropdown">
                                                                        @transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)).Count() posibles matches
                                                                    </button>
                                                                    <ul class="dropdown-menu">
                                                                        @foreach (var match in transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)))
                                                                        {
                                                                            <li>
                                                                                <a class="dropdown-item"
                                                                                   @onclick="() => ConciliarConCuota(transaccion, match)">
                                                                                    <div class="d-flex justify-content-between">
                                                                                        <span>@match.OwnerName</span>
                                                                                        <span class="text-muted">@match.Amount.ToString("C")</span>
                                                                                    </div>
                                                                                    <small class="text-muted">Unidad @match.UnitName &middot; Cuota #@match.Number</small>
                                                                                </a>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">No encontrado</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-check me-1"></i> Conciliado
                                                        </span>
                                                    }
                                                    else if (transaccion.ReconciliationStatus == ConcilationType.Parcial)
                                                    {
                                                        <span class="badge bg-info text-dark">
                                                            <i class="bi bi-hourglass-split me-1"></i> Conciliado Parcialmente
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">
                                                            <i class="bi bi-clock me-1"></i> Pendiente
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        @if (transaccion.Tipo == "Ingreso")
                                                        {
                                                            @if (_canReconcileInstallments && (transaccion.ReconciliationStatus == ConcilationType.NoConciliada || transaccion.ReconciliationStatus == ConcilationType.Parcial))
                                                            {
                                                                <button class="btn btn-outline-primary"
                                                                        title="Conciliar manualmente"
                                                                        @onclick="() => MostrarModalConciliarCuota(transaccion)">
                                                                    <i class="bi bi-link-45deg"></i>
                                                                </button>
                                                            }
                                                        }
                                                        else if (_canReconcileExpenses && transaccion.ReconciliationStatus == ConcilationType.NoConciliada)
                                                        {
                                                            <button class="btn btn-outline-primary"
                                                                    title="Conciliar manualmente"
                                                                    @onclick="() => MostrarModalConciliar(transaccion)">
                                                                <i class="bi bi-link-45deg"></i>
                                                            </button>
                                                            <button class="btn btn-outline-success"
                                                                    title="Crear gasto desde transacción"
                                                                    @onclick="() => CrearGastoDesdeTransaccion(transaccion)">
                                                                <i class="bi bi-plus-circle"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-outline-info"
                                                                title="Ver detalles"
                                                                @onclick="() => VerDetallesTransaccion(transaccion)">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada && ((transaccion.Tipo == "Ingreso" && _canReconcileInstallments) || (transaccion.Tipo != "Ingreso" && _canReconcileExpenses)))
                                                        {
                                                            <button class="btn btn-outline-danger"
                                                                    title="Desconciliar"
                                                                    @onclick="() => DesconciliarTransaccion(transaccion)">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                
                                @if (pagination.TotalRecords == 0)
                                {
                                    <div class="text-center py-5">
                                        <i class="bi bi-search bi-3x text-muted mb-3"></i>
                                        <h5 class="text-muted">No se encontraron transacciones</h5>
                                        <p class="text-muted">Intenta cambiar los filtros o cargar un nuevo estado de cuenta</p>
                                    </div>
                                }
                            </div>

                            <!-- Paginación: controles -->
                            @if (pagination.TotalPages > 1)
                            {
                                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top">
                                    <div class="text-muted">
                                        Página @pagination.CurrentPage de @pagination.TotalPages
                                    </div>
                                    <nav aria-label="Paginación de resultados">
                                        <ul class="pagination pagination-sm mb-0">
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                                    <i class="bi bi-chevron-double-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                                    <i class="bi bi-chevron-left"></i>
                                                </a>
                                            </li>
                                            @foreach (var pageNum in pagination.GetPageNumbers())
                                            {
                                                if (pageNum == -1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                                else
                                                {
                                                    <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                        <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">@pageNum</a>
                                                    </li>
                                                }
                                            }
                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                                    <i class="bi bi-chevron-double-right"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted">Ir a:</span>
                                        <input type="number" class="form-control form-control-sm" style="width: 70px;"
                                               min="1" max="@pagination.TotalPages"
                                               @bind="jumpToPage" @bind:event="oninput" />
                                        <button class="btn btn-sm btn-outline-primary" @onclick="JumpToPage"
                                                disabled="@(jumpToPage < 1 || jumpToPage > pagination.TotalPages)">
                                            Ir
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pie de tabla con acciones masivas -->
                    @if (transaccionesNoConciliadas.Any(t => t.Selected))
                    {
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted">
                                        @transaccionesNoConciliadas.Count(t => t.Selected) transacciones seleccionadas
                                    </span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary" @onclick="DeseleccionarTodo">
                                        Deseleccionar todo
                                    </button>
                                    @if (_canReconcileExpenses)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-primary dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown">
                                                <i class="bi bi-lightning-charge me-2"></i>Acciones masivas
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" @onclick="ConciliarSeleccionadas">
