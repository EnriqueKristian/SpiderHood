@page "/ReconcileExpenses"
@page "/ReconcileExpenses/{accountId:guid}"
@rendermode InteractiveServer

<!--
    Vista combinada (Pagos + Gastos en una sola pantalla, con el toggle Todas/Gastos/
    Ingresos visible). Se deja de mostrar en el menú a pedido de Enrique -- "para no
    confundirnos" -- a favor de las dos páginas dedicadas (ConciliacionPagos/
    ConciliacionGastos, mismo componente ReconciliationWorkspace con ModoFijo). Se
    mantiene esta ruta funcionando por si en el uso piden volver a la vista combinada,
    y para no romper enlaces/favoritos existentes a /ReconcileExpenses.
-->
<ReconciliationWorkspace AccountId="AccountId" />

@code {
    [Parameter]
    public Guid AccountId { get; set; }
}
