@page "/ConciliacionGastos"
@page "/ConciliacionGastos/{accountId:guid}"
@rendermode InteractiveServer

<!-- Conciliación de Gastos -- vista dedicada sobre el mismo motor de
     ReconciliationWorkspace que usa Conciliación de Pagos, sólo con el filtro de tipo
     trabado en "Gasto" para no mezclar ambos flujos en pantalla. -->
<ReconciliationWorkspace AccountId="AccountId" ModoFijo="Gasto" />

@code {
    [Parameter]
    public Guid AccountId { get; set; }
}
