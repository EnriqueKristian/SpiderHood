    private List<TransactionBankDetail> transaccionesNoConciliadas =>
        TransaccionesDelModo.Where(t => !t.Ignored &&
            (t.ReconciliationStatus == ConcilationType.NoConciliada || t.ReconciliationStatus == ConcilationType.Parcial)).ToList();
    private List<TransactionBankDetail> transaccionesIgnoradas =>
        TransaccionesDelModo.Where(t => t.Ignored).ToList();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _canReconcileExpenses = await PermissionService.HasPermissionAsync(_currentUser, "reconcile_expenses");
        _canReconcileInstallments = await PermissionService.HasPermissionAsync(_currentUser, "reconcile_installments");

        pagination.OnPaginationChanged += () => jumpToPage = pagination.CurrentPage;

        // Vista fija (Pagos o Gastos): arranca ya filtrada por ese tipo -- el toggle
        // Todas/Gastos/Ingresos queda oculto (ver ModoFijo más arriba), así que sin esto
        // se seguiría viendo la lista completa hasta que el usuario tocara algo.
        if (ModoFijo != null)
            filtroTipo = ModoFijo;

        await CargarDatosIniciales();
        //AccountId = 1;

        if (AccountId != Guid.Empty)
        {
            cuentaSeleccionadaId = AccountId;
            await CargarTransacciones();
        }
