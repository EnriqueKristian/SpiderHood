@using SpiderHood.Components.Pages.MovementPages
@using SpiderHood.Components.Pages.Components
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@inject IExpenseService ExpenseService
@inject IBankAccountService BankService
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer
@inject ParameterService ParameterService
@inject SpiderHood.Services.AuthService AuthService
@inject SpiderHood.Services.IPermissionService PermissionService
@inject NavigationManager Navigation
@inject SpiderHood.Services.IWorkflowAuditService WorkflowAuditService

<PageTitle>SpiderHood - @TituloPagina</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header mb-0">
                <div class="page-header-title">
                    <div class="icon-badge">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <h1 class="h3 fw-bold mb-1">@TituloPagina</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/dashboard">Inicio</a></li>
                                <li class="breadcrumb-item"><a href="/finanzas">Finanzas</a></li>
                                <li class="breadcrumb-item active">@TituloPagina</li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div class="page-header-actions">
                    @{ var totalPropuestas = transacciones.Count(t => t.PropuestaPendiente); }
                    @if (totalPropuestas > 0)
                    {
                        <button class="btn btn-success" @onclick="EnviarAConciliar">
                            <i class="bi bi-cloud-upload me-1"></i> Enviar a Conciliar (@totalPropuestas)
                        </button>
                    }
                    <button class="btn btn-outline-primary" @onclick="ExportarConciliacion">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i> Exportar
                    </button>
                    <!-- Antes abría un modal (UploadAccountStatementModal) que nunca llegó a
                         parsear el archivo real -- generaba transacciones de ejemplo al azar
                         (GenerarDatosEjemplo) y las agregaba solo en memoria, sin guardar nada
                         en la BD. La carga real (parseo de Excel + guardado) ya existe y
                         funciona en /movement/cargar (CargarEstadoCuentaConciliacion.razor) --
                         se enlaza ahí en vez de duplicar esa lógica acá. -->
                    <a href="@EnlaceCargarEstado" class="btn btn-primary">
                        <i class="bi bi-upload me-1"></i> Cargar Estado
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <!-- Selector de Cuenta y Período -->
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Cuenta Bancaria</label>
                            <select class="form-select" @onchange="CambiarCuenta">
                                <option value="">Seleccionar cuenta...</option>
                                @foreach (var cuenta in cuentasBancarias)
                                {
                                    <option value="@cuenta.IdBankAccount">@cuenta.BankName (@cuenta.AccountNumber)</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label">Período</label>
                            <select class="form-select" @bind="periodoSeleccionado" @bind:after="CambiarPeriodo">
                                <option value="todos">Todos</option>
                                <option value="mesActual">Mes Actual</option>
                                <option value="mesAnterior">Mes Anterior</option>
                                <option value="trimestreActual">Trimestre Actual</option>
                                <option value="personalizado">Personalizado</option>
                            </select>
                        </div>

                        @if (periodoSeleccionado == "personalizado")
                        {
                            <div class="col-md-2">
                                <label class="form-label">Desde</label>
                                <input type="date" class="form-control" @bind="fechaDesde" @bind:after="CambiarPeriodo" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Hasta</label>
                                <input type="date" class="form-control" @bind="fechaHasta" @bind:after="CambiarPeriodo" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Resumen Conciliación</h6>
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-value text-primary">@totalTransacciones</div>
                                <div class="stat-label">Transacciones</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-value @(totalPendiente > 0 ? "text-warning" : "text-success")">
                                    @Moneda(totalPendiente)
                                </div>
                                <div class="stat-label">Pendiente</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (cuentaSeleccionadaId == Guid.Empty)
    {
        <div class="text-center py-5">
            <i class="bi bi-bank bi-3x text-muted mb-3"></i>
            <h5 class="text-muted">Selecciona una cuenta bancaria para comenzar</h5>
            <p class="text-muted">O carga un nuevo estado de cuenta</p>
        </div>
    }
    else if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3">Cargando transacciones...</p>
        </div>
    }
    else
    {
        <!-- Filtros y Búsqueda -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-3 align-items-center">
                                @if (ModoFijo == null)
                                {
                                    <div class="vr"></div>

                                    <!--    BOTONES DE FILTRO   -->
                                    <div class="btn-group" role="group">
                                        <button class="btn @(filtroTipo == null ? "btn-primary" : "btn-outline-primary")"
                                                @onclick="() => FiltrarPorTipo(null)">
                                            Todas (@totalTransacciones)
                                        </button>
                                        <button class="btn @(filtroTipo == "Gasto" ? "btn-primary" : "btn-outline-primary")"
                                                @onclick="() => FiltrarPorTipo(Gasto)">
                                            Gastos (@transacciones.Count(t => t.Tipo == "Gasto"))
                                        </button>
                                        <button class="btn @(filtroTipo == "Ingreso" ? "btn-primary" : "btn-outline-primary")"
                                                @onclick="() => FiltrarPorTipo(Ingreso)">
                                            Ingresos (@transacciones.Count(t => t.Tipo == "Ingreso"))
                                        </button>
                                    </div>
                                }
                            </div>
                            
                            <div class="d-flex gap-2">
                                <div class="input-group" style="width: 300px;">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Buscar descripción, referencia..."
                                           @bind="textoBusqueda"
                                           @bind:event="oninput"
                                           @bind:after="ActualizarPaginacion" />
                                </div>
                                
                                <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pestañas de Transacciones -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        @* Esta pantalla es solo para TRABAJAR lo pendiente -- ya no tiene pestañas
                           "Conciliados"/"Todas las Transacciones": una vez confirmado (Enviar a
                           Conciliar), la transacción sale de acá; para consultar el historial real
                           (estado en BD, incluye lo ya confirmado) está /movement -> pestaña
                           "Detalle". *@
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "noConciliados" ? "active" : "")"
                                        @onclick="() => CambiarTab(noConciliados)">
                                    <i class="bi bi-question-circle me-2"></i>
                                    No Conciliados
                                    <span class="badge bg-warning ms-2">@TransaccionesDelModo.Count(t => !t.PropuestaPendiente && (t.ReconciliationStatus == ConcilationType.NoConciliada || t.ReconciliationStatus == ConcilationType.Parcial))</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "propuestosAuto" ? "active" : "")"
                                        @onclick="() => CambiarTab(propuestosAuto)">
                                    <i class="bi bi-robot me-2"></i>
                                    Auto
                                    <span class="badge bg-primary ms-2">@TransaccionesDelModo.Count(t => t.PropuestaPendiente && t.PropuestaAutomatica)</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabActiva == "propuestosManual" ? "active" : "")"
                                        @onclick="() => CambiarTab(propuestosManual)">
                                    <i class="bi bi-person me-2"></i>
                                    Manual
                                    <span class="badge bg-primary ms-2">@TransaccionesDelModo.Count(t => t.PropuestaPendiente && !t.PropuestaAutomatica)</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <!-- Docs/Pendientes-Negocio-Conciliacion.md #1 -->
                                <button class="nav-link @(tabActiva == "ignorados" ? "active" : "")"
                                        @onclick="() => CambiarTab(ignorados)">
                                    <i class="bi bi-eye-slash me-2"></i>
                                    Ignorados
                                    <span class="badge bg-secondary ms-2">@TransaccionesDelModo.Count(t => t.Ignored)</span>
                                </button>
                            </li>
                        </ul>

                        @if (transaccionesConciliadas.Any())
                        {
                            <!-- Antes esto sólo estaba explicado en un comentario de código (línea
                                 229 más arriba) -- invisible para quien usa la pantalla. Un usuario
                                 viendo "Cargadas 131 transacciones" y sólo 1 fila en estas pestañas
                                 no tiene forma de saber que las otras 130 existen a propósito en
                                 otro lado, no que se perdieron. -->
                            <div class="px-3 py-2 small text-muted border-top">
                                <i class="bi bi-info-circle me-1"></i>
                                @transaccionesConciliadas.Count transacción@(transaccionesConciliadas.Count != 1 ? "es" : "") ya conciliada@(transaccionesConciliadas.Count != 1 ? "s" : "") de este periodo no se muestra@(transaccionesConciliadas.Count != 1 ? "n" : "") acá --
                                <a href="/movement">ver en Estados de Cuenta</a>.
                            </div>
                        }

                        <div class="tab-content">
                            <!-- Paginación: encabezado con estadísticas y selector de página -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center px-3 pt-3">
                                <p class="text-muted mb-0">
                                    Mostrando @pagination.StartRecord - @pagination.EndRecord de @pagination.TotalRecords transacciones
                                </p>
                                <div class="d-flex align-items-center">
                                    <label class="me-2 text-muted">Mostrar:</label>
                                    <select class="form-select form-select-sm" style="width: auto;"
                                            @onchange="(e) => pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                                        <option value="10" selected="@(pagination.PageSize == 10)">10</option>
                                        <option value="25" selected="@(pagination.PageSize == 25)">25</option>
                                        <option value="50" selected="@(pagination.PageSize == 50)">50</option>
                                        <option value="100" selected="@(pagination.PageSize == 100)">100</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Tabla de Transacciones -->
                            <div class="table-responsive" style="max-height: 600px;">
                                <table class="table table-hover mb-0">
                                    <thead class="sticky-top table-light" style="top: 0; z-index: 1;">
                                        <tr>
                                            <th width="40">
                                                <input type="checkbox" 
                                                       class="form-check-input" 
                                                       @onchange="SeleccionarTodosTransacciones">
                                            </th>
                                            <th width="60">Fecha</th>
                                            <th>Descripción</th>
                                            <th width="100" class="text-end">Monto</th>
                                            <th width="100" class="text-end">Pendiente</th>
                                            <th width="80">Tipo</th>
                                            <th width="150">Conciliado Con</th>
                                            <th width="100">Estado</th>
                                            <th width="120" class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var transaccion in pagination.CurrentPageData)
                                        {
                                            <tr class="@(transaccion.Selected ? "table-primary" : "")">
                                                <td>
                                                    @if (transaccion.ReconciliationStatus == 0)
                                                    {
                                                        <input type="checkbox" 
                                                               class="form-check-input" 
                                                               @bind="transaccion.Selected" />
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark">
                                                        @transaccion.StatementDate.ToString("dd/MM/yy")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        @if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                        {
                                                            <i class="bi bi-check-circle text-success me-2"></i>
                                                        }
                                                        <div>
                                                            <div class="fw-bold">@transaccion.Description</div>
                                                            @if (!string.IsNullOrEmpty(transaccion.Notes))
                                                            {
                                                                <small class="text-muted">@transaccion.Notes</small>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-end fw-bold @(transaccion.Amount  < 0 ? "text-danger" : "text-success")">
                                                    @Moneda(Math.Abs(transaccion.Amount))
                                                </td>
                                                <td class="text-end @(transaccion.Tipo == "Ingreso" && Math.Abs(transaccion.Balance) > 0.01m ? "fw-bold text-warning" : "text-muted")">
                                                    @* Balance sale de VW_SUM_InstallmentPaidTransaction (pagos de cuota), que
                                                       no aplica a Gastos -- ahí Balance siempre queda igual a Amount sin
                                                       importar si ya se conciliό, así que mostrarlo confundiría "pendiente
                                                       de aplicar" con "gasto ya conciliado". Solo tiene sentido en Ingresos. *@
                                                    @(transaccion.Tipo == "Ingreso" ? Moneda(Math.Abs(transaccion.Balance)) : "—")
                                                </td>
                                                <td>
                                                    <span class="badge @(transaccion.Amount < 0 ? "bg-danger" : "bg-success")">
                                                        @transaccion.Tipo
                                                    </span>
                                                </td>
                                                <td>
                                                    @if( transaccion.Tipo == "Gasto") {
                                                        @if (transaccion.PropuestaPendiente && transaccion.GastoConciliado != null)
                                                    {
                                                        // Propuesta todavía sin confirmar -- antes esta rama solo se activaba
                                                        // con ReconciliationStatus == Conciliada, que ya no cambia hasta
                                                        // "Enviar a Conciliar", así que elegir un match de la lista de abajo
                                                        // seguía mostrando el mismo dropdown como si no hubiera pasado nada.
                                                        <div class="d-flex align-items-center">
                                                            <i class="bi bi-link-45deg text-primary me-2"></i>
                                                            <div>
                                                                <div class="small">@transaccion.GastoConciliado.Category</div>
                                                                <div class="text-muted small">@transaccion.GastoConciliado.Description</div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                    {
                                                        <div class="d-flex align-items-center">
                                                            <i class="bi bi-link-45deg text-primary me-2"></i>
                                                            <div>
                                                                <div class="small">@transaccion.GastoConciliado?.Category</div>
                                                                <div class="text-muted small">@transaccion.GastoConciliado?.Description</div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (transaccion.PosiblesMatches.Any())
                                                    {
                                                        var gastosIds = new HashSet<Guid>(gastosPendientes.Select(g => g.IdExpense));

                                                        @if(transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)).Count() > 0 ){
                                                            
                                                            <div class="dropdown">
                                                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" 
                                                                        type="button" 
                                                                        data-bs-toggle="dropdown">
                                                                    @transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)).Count() posibles matches
                                                                </button>
                                                                <ul class="dropdown-menu">
                                                                @foreach (var match in transaccion.PosiblesMatches.Where(c => gastosIds.Contains(c.IdExpense)))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" 
                                                                            @onclick="() => ConciliarConGasto(transaccion, match)">
                                                                            <div class="d-flex justify-content-between">
                                                                                <span>@match.Category</span>
                                                                                <span class="text-muted">@Moneda(match.Amount)</span>
                                                                            </div>
                                                                            <small class="text-muted">@match.Description</small>
                                                                        </a>
                                                                    </li>
                                                                }
                                                                </ul>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @if (transaccion.PropuestaPendiente && transaccion.CuotasPropuestas.Any())
                                                        {
                                                            // Mismo problema que en Gasto de arriba: sin este chequeo, la
                                                            // columna seguía mostrando el dropdown de "posibles matches" aunque
                                                            // ya hubiera una propuesta elegida (automática o manual), porque
                                                            // ReconciliationStatus no cambia hasta confirmar con "Enviar a
                                                            // Conciliar".
                                                            <div class="d-flex align-items-center">
                                                                <i class="bi bi-link-45deg text-primary me-2"></i>
                                                                <div>
                                                                    <div class="small">Unidad @string.Join(", ", transaccion.CuotasPropuestas.Select(c => c.UnitName).Distinct())</div>
                                                                    <div class="text-muted small">@transaccion.CuotasPropuestas.Count cuota@(transaccion.CuotasPropuestas.Count != 1 ? "s" : "")</div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (transaccion.ReconciliationStatus == ConcilationType.Conciliada || transaccion.ReconciliationStatus == ConcilationType.Parcial)
                                                        {
                                                            // Ingreso conciliado con cuota(s), NO con un Gasto -- GastoConciliado
                                                            // siempre es null acá (ese campo es para Gastos), así que esto se
                                                            // apoyaba en un valor que nunca existe y la columna quedaba vacía.
                                                            // pagosCuotas ya trae OwnerName/UnitName por transacción.
                                                            var pagosDeEsta = pagosCuotas.Where(p => p.IdTransaction == transaccion.IdStatementDetail).ToList();
                                                            <div class="d-flex align-items-center">
                                                                <i class="bi bi-link-45deg text-primary me-2"></i>
                                                                @if (pagosDeEsta.Any())
                                                                {
                                                                    <div>
                                                                        <div class="small">Unidad @string.Join(", ", pagosDeEsta.Select(p => p.UnitName).Distinct())</div>
                                                                        <div class="text-muted small">@pagosDeEsta.Count cuota@(pagosDeEsta.Count != 1 ? "s" : "")</div>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">&mdash;</span>
                                                                }
                                                            </div>
                                                        }
                                                        else if (transaccion.IPosiblesMatches.Any())
                                                        {
                                                            var cuotasIds = new HashSet<Guid>(cuotaspendientes.Select(g => g.IdInstallment));

                                                            @if (transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)).Count() > 0)
                                                            {
                                                                <div class="dropdown">
                                                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                                                            type="button"
                                                                            data-bs-toggle="dropdown">
                                                                        @transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)).Count() posibles matches
                                                                    </button>
                                                                    <ul class="dropdown-menu">
                                                                        @foreach (var match in transaccion.IPosiblesMatches.Where(c => cuotasIds.Contains(c.IdInstallment)))
                                                                        {
                                                                            <li>
                                                                                <a class="dropdown-item"
                                                                                   @onclick="() => ConciliarConCuota(transaccion, match)">
                                                                                    <div class="d-flex justify-content-between">
                                                                                        <span>@match.OwnerName</span>
                                                                                        <span class="text-muted">@Moneda(match.Amount)</span>
                                                                                    </div>
                                                                                    <small class="text-muted">Unidad @match.UnitName &middot; Cuota #@match.Number</small>
                                                                                </a>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">No encontrado</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No encontrado</span>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @if (transaccion.Ignored)
                                                    {
                                                        <!-- Docs/Pendientes-Negocio-Conciliacion.md #1 -->
                                                        <span class="badge bg-secondary" title="@transaccion.IgnoredReason">
                                                            <i class="bi bi-eye-slash me-1"></i> Ignorado@(transaccion.IgnoredType.HasValue ? $" ({DescribirTipoIgnorado(transaccion.IgnoredType.Value)})" : "")
                                                        </span>
                                                    }
                                                    else if (transaccion.PropuestaPendiente)
                                                    {
                                                        <span class="badge bg-primary" title="Todavía no se guardó en BD -- confirma con 'Enviar a Conciliar' o quítala con el botón de al lado">
                                                            <i class="bi bi-hourglass-top me-1"></i> Propuesto
                                                        </span>
                                                        <span class="badge bg-light text-dark border ms-1">
                                                            <i class="bi @(transaccion.PropuestaAutomatica ? "bi-robot" : "bi-person") me-1"></i>@(transaccion.PropuestaAutomatica ? "Auto" : "Manual")
                                                        </span>
                                                    }
                                                    else if (transaccion.ReconciliationStatus == ConcilationType.Conciliada)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-check me-1"></i> Conciliado
                                                        </span>
                                                    }
                                                    else if (transaccion.ReconciliationStatus == ConcilationType.Parcial)
                                                    {
                                                        <span class="badge bg-info text-dark">
                                                            <i class="bi bi-hourglass-split me-1"></i> Conciliado Parcialmente
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">
                                                            <i class="bi bi-clock me-1"></i> Pendiente
                                                        </span>
                                                    }
                                                    @{ var esAuto = EsConciliacionAutomatica(transaccion); }
                                                    @if (!transaccion.PropuestaPendiente && esAuto.HasValue)
                                                    {
                                                        <span class="badge bg-light text-dark border ms-1" title="@(esAuto.Value ? "Se concilió automáticamente por coincidencia exacta de monto" : "Se concilió manualmente")">
                                                            <i class="bi @(esAuto.Value ? "bi-robot" : "bi-person") me-1"></i>@(esAuto.Value ? "Auto" : "Manual")
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        @if (transaccion.PropuestaPendiente)
                                                        {
                                                            @if ((transaccion.Tipo == "Ingreso" && _canReconcileInstallments) || (transaccion.Tipo != "Ingreso" && _canReconcileExpenses))
                                                            {
                                                                <button class="btn btn-outline-secondary"
                                                                        title="Quitar propuesta (no toca la BD, todavía no se guardó nada)"
                                                                        @onclick="() => QuitarPropuesta(transaccion)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            }
                                                        }
                                                        else if (!transaccion.Ignored)
                                                        {
                                                            @if (transaccion.Tipo == "Ingreso")
                                                            {
                                                                @if (_canReconcileInstallments && (transaccion.ReconciliationStatus == ConcilationType.NoConciliada || transaccion.ReconciliationStatus == ConcilationType.Parcial))
                                                                {
                                                                    <button class="btn btn-outline-primary"
                                                                            title="Conciliar manualmente"
                                                                            @onclick="() => MostrarModalConciliarCuota(transaccion)">
                                                                        <i class="bi bi-link-45deg"></i>
                                                                    </button>
                                                                }
                                                            }
                                                            else if (_canReconcileExpenses && transaccion.ReconciliationStatus == ConcilationType.NoConciliada)
                                                            {
                                                                <button class="btn btn-outline-primary"
                                                                        title="Conciliar manualmente"
                                                                        @onclick="() => MostrarModalConciliar(transaccion)">
                                                                    <i class="bi bi-link-45deg"></i>
                                                                </button>
                                                                <button class="btn btn-outline-success"
                                                                        title="Crear gasto desde transacción"
                                                                        @onclick="() => CrearGastoDesdeTransaccion(transaccion)">
                                                                    <i class="bi bi-plus-circle"></i>
                                                                </button>
                                                            }
                                                        }
                                                        <button class="btn btn-outline-info"
                                                                title="Ver detalles"
                                                                @onclick="() => VerDetallesTransaccion(transaccion)">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        @if (!transaccion.PropuestaPendiente && (_canReconcileExpenses || _canReconcileInstallments))
                                                        {
                                                            <!-- Docs/Pendientes-Negocio-Migracion.md #3 -- marca este movimiento como el
                                                                 saldo de apertura de la cuenta, alimentando BankAccount.InitialBalance. -->
                                                            <button class="btn btn-outline-secondary"
                                                                    title="Marcar como Saldo Inicial de la cuenta"
                                                                    @onclick="() => MarcarComoSaldoInicial(transaccion)">
                                                                <i class="bi bi-flag"></i>
                                                            </button>
                                                        }
                                                        @if (!transaccion.PropuestaPendiente && transaccion.ReconciliationStatus == ConcilationType.Conciliada && _puedeCorregir)
                                                        {
                                                            <button class="btn btn-outline-danger"
                                                                    title="Corregir (requiere motivo, queda en el log de auditoría)"
                                                                    @onclick="() => CorregirConciliacion(transaccion)">
                                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                
                                @if (pagination.TotalRecords == 0)
                                {
                                    <div class="text-center py-5">
                                        <i class="bi bi-search bi-3x text-muted mb-3"></i>
                                        <h5 class="text-muted">No se encontraron transacciones</h5>
                                        <p class="text-muted">Intenta cambiar los filtros o cargar un nuevo estado de cuenta</p>
                                    </div>
                                }
                            </div>

                            <!-- Paginación: controles -->
                            @if (pagination.TotalPages > 1)
                            {
                                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top">
                                    <div class="text-muted">
                                        Página @pagination.CurrentPage de @pagination.TotalPages
                                    </div>
                                    <nav aria-label="Paginación de resultados">
                                        <ul class="pagination pagination-sm mb-0">
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToFirstPage" title="Primera página">
                                                    <i class="bi bi-chevron-double-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToPreviousPage" title="Página anterior">
                                                    <i class="bi bi-chevron-left"></i>
                                                </a>
                                            </li>
                                            @foreach (var pageNum in pagination.GetPageNumbers())
                                            {
                                                if (pageNum == -1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                                else
                                                {
                                                    <li class="page-item @(pageNum == pagination.CurrentPage ? "active" : "")">
                                                        <a class="page-link" @onclick="() => pagination.GoToPage(pageNum)">@pageNum</a>
                                                    </li>
                                                }
                                            }
                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToNextPage" title="Página siguiente">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                                            <li class="page-item @(pagination.CurrentPage == pagination.TotalPages ? "disabled" : "")">
                                                <a class="page-link" @onclick="pagination.GoToLastPage" title="Última página">
                                                    <i class="bi bi-chevron-double-right"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted">Ir a:</span>
                                        <input type="number" class="form-control form-control-sm" style="width: 70px;"
                                               min="1" max="@pagination.TotalPages"
                                               @bind="jumpToPage" @bind:event="oninput" />
                                        <button class="btn btn-sm btn-outline-primary" @onclick="JumpToPage"
                                                disabled="@(jumpToPage < 1 || jumpToPage > pagination.TotalPages)">
                                            Ir
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pie de tabla con acciones masivas -->
                    @if (transaccionesNoConciliadas.Any(t => t.Selected))
                    {
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted">
                                        @transaccionesNoConciliadas.Count(t => t.Selected) transacciones seleccionadas
                                    </span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary" @onclick="DeseleccionarTodo">
                                        Deseleccionar todo
                                    </button>
                                    @if (_canReconcileExpenses || _canReconcileInstallments)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-primary dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown">
                                                <i class="bi bi-lightning-charge me-2"></i>Acciones masivas
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" @onclick="ConciliarSeleccionadas">
                                                        <i class="bi bi-link-45deg me-2"></i>Conciliar seleccionadas
                                                    </a>
                                                </li>
                                                @* "Generar gastos" crea Expense nuevos -- no tiene sentido en la vista de
                                                   Pagos (ModoFijo="Ingreso"), donde ni siquiera hay gastosPendientes que
                                                   mostrar. *@
                                                @if (_canReconcileExpenses && ModoFijo != "Ingreso")
                                                {
                                                    <li>
                                                        <a class="dropdown-item" @onclick="GenerarGastosSeleccionados">
                                                            <i class="bi bi-plus-circle me-2"></i>Generar gastos
                                                        </a>
                                                    </li>
                                                }
                                                <li>
                                                    <a class="dropdown-item" @onclick="IgnorarSeleccionadas">
                                                        <i class="bi bi-slash-circle me-2"></i>Ignorar transacciones
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                
                </div>
            </div>
        </div>

        <!-- Panel de Resumen -->
        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Resumen de Conciliación</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Estado Actual</h6>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Saldo Inicial:</span>
                                        <span class="fw-bold">@Moneda(saldoInicial)</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Total Gastos:</span>
                                        <span class="fw-bold text-danger">@Moneda(totalGastos)</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Total Ingresos:</span>
                                        <span class="fw-bold text-success">@Moneda(totalIngresos)</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Saldo Final (Calculado):</span>
                                        <span class="fw-bold @(saldoFinalCalculado < 0 ? "text-danger" : "text-success")">
                                            @Moneda(saldoFinalCalculado)
                                        </span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <h6>Conciliación</h6>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Conciliados:</span>
                                        <span class="badge bg-success">@transaccionesConciliadas.Count</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Pendientes:</span>
                                        <span class="badge bg-warning">@transaccionesNoConciliadas.Count</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Coincidencias encontradas:</span>
                                        <span class="badge bg-info">@totalCoincidencias</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>Diferencia:</span>
                                        <span class="fw-bold @(diferenciaConciliacion < 0 ? "text-danger" : "text-success")">
                                            @Moneda(diferenciaConciliacion)
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-4">
                            <div class="progress" style="height: 25px;">
                                @{
                                    var porcentajeConciliado = totalTransacciones > 0 ? 
                                        (transaccionesConciliadas.Count * 100 / totalTransacciones) : 0;
                                }
                                <div class="progress-bar bg-success" 
                                     role="progressbar" 
                                     style="width: @porcentajeConciliado%">
                                    @porcentajeConciliado% Conciliado
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Acciones Rápidas</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            @if (_canReconcileExpenses)
                            {
                                <button class="btn btn-success" @onclick="FinalizarConciliacion">
                                    <i class="bi bi-check2-all me-2"></i>Finalizar Conciliación
                                </button>
                            }
                            <button class="btn btn-outline-primary" @onclick="BuscarCoincidenciasAutomaticas">
                                <i class="bi bi-search me-2"></i>Buscar Coincidencias Automáticas
                            </button>
                            <button class="btn btn-outline-warning" @onclick="MostrarReporteDiferencias">
                                <i class="bi bi-bar-chart me-2"></i>Ver Reporte de Diferencias
                            </button>
                        </div>
                        
                        <hr />
                        
                        <div class="mt-3">
                            <h6>Última Conciliación</h6>
                            @if (ultimaConciliacion != null)
                            {
                                <div class="alert alert-info">
                                    <div class="small">
                                        <strong>@ultimaConciliacion.Fecha.ToString("dd/MM/yyyy")</strong><br />
                                        Por: @ultimaConciliacion.Usuario<br />
                                        Estado: 
                                        <span class="badge @(ultimaConciliacion.Completada ? "bg-success" : "bg-warning")">
                                            @(ultimaConciliacion.Completada ? "Completada" : "Pendiente")
                                        </span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small">No hay conciliaciones previas</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal para Conciliar Manualmente -->
@if (mostrarModalConciliar && transaccionSeleccionada != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-link-45deg me-2"></i>Conciliar Transacción
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalConciliar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <h6>Transacción Bancaria</h6>
                        <div class="card">
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">Fecha:</dt>
                                    <dd class="col-sm-8">@transaccionSeleccionada.StatementDate.ToString("dd/MM/yyyy")</dd>
                                    
                                    <dt class="col-sm-4">Descripción:</dt>
                                    <dd class="col-sm-8">@transaccionSeleccionada.Description</dd>
                                    
                                    <dt class="col-sm-4">Referencia:</dt>
                                    <dd class="col-sm-8">@transaccionSeleccionada.Reference</dd>
                                    
                                    <dt class="col-sm-4">Monto:</dt>
                                    <dd class="col-sm-8 fw-bold @(transaccionSeleccionada.Amount < 0 ? "text-danger" : "text-success")">
                                        @Moneda(Math.Abs(transaccionSeleccionada.Amount))
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <h6 class="mb-3">Seleccionar Gasto para Conciliar</h6>
                        
                        @if (gastosParaConciliar.Any())
                        {
                            <div class="list-group" style="max-height: 300px; overflow-y: auto;">
                                @foreach (var gasto in gastosParaConciliar)
                                {
                                    <button class="list-group-item list-group-item-action"
                                            @onclick="() => ConciliarConGasto(transaccionSeleccionada, gasto)">
                                        <div class="d-flex w-100 justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">@gasto.Description</h6>
                                                <small class="text-muted">
                                                    <span class="badge bg-info">@gasto.Category</span>
                                                    @if (!string.IsNullOrEmpty(gasto.Supplier))
                                                    {
                                                        <span class="ms-2">@gasto.Supplier</span>
                                                    }
                                                </small>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold @(gasto.Amount < 0 ? "text-danger" : "text-success")">
                                                    @Moneda(Math.Abs(gasto.Amount))
                                                </div>
                                                <small class="text-muted">
                                                    @gasto.ExpenseDate.ToString("dd/MM/yy")
                                                </small>
                                            </div>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                No se encontraron gastos pendientes de conciliar
                            </div>
                        }
                        
                        @if (_canReconcileExpenses)
                        {
                            <div class="text-center mt-3">
                                <button class="btn btn-outline-primary" @onclick="() => CrearGastoDesdeTransaccion(transaccionSeleccionada)">
                                    <i class="bi bi-plus-circle me-2"></i>Crear nuevo gasto
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<!-- Modal para Crear Gasto desde Transacción -->
@if (mostrarModalCrearGasto && transaccionParaGasto != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-circle me-2"></i>Crear Gasto desde Transacción
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalCrearGasto"></button>
                </div>
                <div class="modal-body">
                    <CreateExpenseFromTransactionModal Transaccion="transaccionParaGasto"
                                                OnGastoCreado="GastoCreadoExitosamente"
                                                OnCancel="CerrarModalCrearGasto"
                                                FilteredCategory="FilteredCategory" />
                </div>
            </div>
        </div>
    </div>
}


<!-- Modal para Conciliar Manualmente un Pago (Ingreso) con una o varias cuotas -->
@if (mostrarModalConciliarCuota && transaccionParaCuota != null)
{
    <ErrorBoundary @ref="conciliarCuotaErrorBoundary">
        <ChildContent>
            <ReconcilePaymentModal Pago="transaccionParaCuota"
                                      CuotasDisponibles="cuotaspendientes"
                                      ErrorExterno="@mensajeError"
                                      OnClose="CerrarModalConciliarCuota"
                                      OnConfirmar="ConfirmarConciliarCuotas" />
        </ChildContent>
        <ErrorContent Context="ex">
            <div class="modal-backdrop show"></div>
            <div class="modal show d-block" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title text-danger">Error al abrir el modal de conciliación</h5>
                            <button type="button" class="btn-close" @onclick="CerrarModalConciliarCuota"></button>
                        </div>
                        <div class="modal-body">
                            <p class="fw-bold">@ex.GetType().Name: @ex.Message</p>
                            <pre class="small text-muted" style="white-space: pre-wrap;">@ex.StackTrace</pre>
                        </div>
                    </div>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
}


<!-- Modal para Ver Detalle de un pago (Ingreso) ya conciliado -->
@if (mostrarModalVerDetalleIngreso && transaccionDetalleIngreso != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-eye me-2"></i>
                        @(transaccionDetalleIngreso.PropuestaPendiente ? "Cuota(s) propuesta(s) para el pago" : "Cuotas asociadas al pago")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalVerDetalleIngreso"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Fecha:</dt>
                        <dd class="col-sm-8">@transaccionDetalleIngreso.StatementDate.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-sm-4">Descripción:</dt>
                        <dd class="col-sm-8">@transaccionDetalleIngreso.Description</dd>
                        <dt class="col-sm-4">Monto:</dt>
                        <dd class="col-sm-8 fw-bold text-success">@Moneda(Math.Abs(transaccionDetalleIngreso.Amount))</dd>
                        <dt class="col-sm-4">Saldo sin aplicar:</dt>
                        <dd class="col-sm-8">@Moneda(Math.Abs(transaccionDetalleIngreso.Balance))</dd>
                    </dl>

                    @{
                        var pagosDeEstaTransaccion = pagosCuotas.Where(p => p.IdTransaction == transaccionDetalleIngreso.IdStatementDetail).ToList();
                    }
                    @if (transaccionDetalleIngreso.PropuestaPendiente && transaccionDetalleIngreso.CuotasPropuestas.Any())
                    {
                        // Todavía no hay nada en pagosCuotas -- AplicarPagoAsync (lo que crea esos
                        // registros) recién se llama al confirmar con "Enviar a Conciliar". Se
                        // muestra la propuesta desde CuotasPropuestas (en memoria) en su lugar.
                        <div class="alert alert-primary">
                            <i class="bi bi-hourglass-top me-2"></i>
                            Todavía no se guardó -- usa "Enviar a Conciliar" para confirmar.
                        </div>
                        <div class="list-group">
                            @foreach (var cuota in transaccionDetalleIngreso.CuotasPropuestas)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold">@cuota.OwnerName (Unidad @cuota.UnitName)</span>
                                        <span class="fw-bold text-primary">@Moneda(cuota.Amount)</span>
                                    </div>
                                    <small class="text-muted">
                                        Cuota @cuota.Period.ToString("MMM-yy") &middot; Vence @cuota.DueDate.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            }
                        </div>
                    }
                    else if (!pagosDeEstaTransaccion.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            No se encontraron cuotas asociadas a este pago.
                        </div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var pago in pagosDeEstaTransaccion)
                            {
                                // pago.OwnerName/UnitName vienen de GET_InstallmentPaid (JOIN a
                                // Installment); se apoya en cuotaspendientes solo como fallback
                                // por si la BD todavía no corrió el script que agrega esas
                                // columnas -- cuotaspendientes no sirve para cuotas ya pagadas
                                // por completo, que es justo el caso más común acá.
                                var cuota = cuotaspendientes.FirstOrDefault(c => c.IdInstallment == pago.IdInstallment);
                                var ownerName = !string.IsNullOrEmpty(pago.OwnerName) ? pago.OwnerName : cuota?.OwnerName;
                                var unitName = !string.IsNullOrEmpty(pago.UnitName) ? pago.UnitName : cuota?.UnitName;
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold">@(!string.IsNullOrEmpty(ownerName) ? $"{ownerName} (Unidad {unitName})" : $"Cuota {pago.IdInstallment}")</span>
                                        <span class="fw-bold text-success">@Moneda(pago.Amount)</span>
                                    </div>
                                    <small class="text-muted">
                                        @pago.PaymentDate.ToString("dd/MM/yyyy")
                                        @if (pago.IsPartialPayment)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Pago parcial de la cuota</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success ms-1">Pago total de la cuota</span>
                                        }
                                    </small>
                                    @if (pago.InstallmentAmount > 0)
                                    {
                                        <div class="small text-muted mt-1">
                                            Cuota @pago.Period.ToString("MMM-yy"): @Moneda(pago.InstallmentAmount)
                                            &middot; Pendiente de la cuota: @Moneda(Math.Max(pago.InstallmentDebt, 0))
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

