    private void ActualizarPaginacion()
    {
        pagination.Initialize(GetTransaccionesFiltradas());
    }

    private void JumpToPage()
    {
        pagination.GoToPage(jumpToPage);
    }

    private async Task CargarDatosIniciales()
    {
        if (ParameterService.CurrentBuilding == null) return;

        cargando = true;

        try
        {
            // Cargar cuentas bancarias
            cuentasBancarias = await BankService.ObtenerCuentasBancariasAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Cargar categorías de gastos
            //categoriasGastos = await ExpenseService.ObtenerCategoriasAsync();

            // Cargar última conciliación
            ultimaConciliacion = await BankService.ObtenerUltimaConciliacionAsync();

            FilteredCategory = await CategoryService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarTransacciones()
    {
        cargando = true;
        // Docs/Pendientes-Negocio-Migracion.md #6.6: no se limpiaban acá -- un mensajeExito
        // de una carga anterior se quedaba pegado en pantalla junto al mensajeError de una
        // carga posterior que sí falló (o viceversa), confundiendo cuál de los dos reflejaba
        // el estado real de ESTA carga.
        mensajeExito = null;
        mensajeError = null;

        try
        {
            // Docs/Pendientes-Negocio-Migracion.md #3 -- antes esto nunca se asignaba, así
            // que "Saldo Inicial" (y "Saldo Final Calculado", que se calcula a partir de
            // éste en CalcularEstadisticas) siempre mostraban 0 sin importar el valor real
            // configurado en la cuenta bancaria.
            saldoInicial = cuentasBancarias.FirstOrDefault(c => c.IdBankAccount == cuentaSeleccionadaId)?.InitialBalance ?? 0;

            // Cargar transacciones del período seleccionado
            var (fechaInicio, fechaFin) = ObtenerFechasPeriodo();
            transacciones = await BankService.ObtenerTransaccionesAsync(cuentaSeleccionadaId, fechaInicio, fechaFin);

            // Cargar gastos pendientes del mismo período
            gastosPendientes = await ExpenseService.ObtenerGastosPendientesConciliacionAsync( ParameterService.CurrentBuilding.IdBuilding, fechaInicio, fechaFin);

            // Cargar Cuotas pendientes del mismo período
            cuotaspendientes = await InstallmentService.GetPendingInstallmentsAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Cargar pagos de cuotas ya registrados (para "Ver Detalle" de ingresos conciliados)
            pagosCuotas = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Buscar coincidencias automáticas
            await BuscarCoincidencias();

            // Calcular estadísticas
            CalcularEstadisticas();
            ActualizarPaginacion();

            // Antes decía "Cargadas {transacciones.Count} transacciones" -- transacciones
            // trae TODO el periodo (incluye lo ya Conciliado, necesario para calcular Saldo
            // Final/% Conciliado del resumen de abajo), pero esta pantalla sólo MUESTRA lo
            // pendiente (No Conciliados/Auto/Manual/Ignorados -- lo Conciliado vive en
            // Estados de Cuenta). Con 130 de 131 ya conciliadas, ese mensaje hacía parecer
            // que la carga había fallado (dice 131, la tabla muestra 1). Ahora refleja lo que
            // esta pantalla realmente hace: cuántas quedan por trabajar acá.
            var porTrabajar = transacciones.Count - transaccionesConciliadas.Count;
            mensajeExito = porTrabajar > 0
                ? $"{porTrabajar} transacción(es) por trabajar en este periodo ({transaccionesConciliadas.Count} ya conciliada(s) -- ver Estados de Cuenta)"
                : $"Todas las transacciones del periodo ya están conciliadas ({transaccionesConciliadas.Count}). Ver Estados de Cuenta para el detalle.";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar transacciones: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarCoincidencias()
    {
        totalCoincidencias = 0;
        totalCoincidenciasI = 0;

        foreach (var transaccion in transacciones.Where(t => t.ReconciliationStatus == ConcilationType.NoConciliada && t.Amount < 0))
        {
            // Buscar gastos con monto similar (±10%)
            var montoTransaccion = Math.Abs(transaccion.Amount);
            var posiblesMatches = gastosPendientes
                .Where(g => Math.Abs(g.Amount - montoTransaccion) / montoTransaccion <= 0.1m)
                .OrderBy(g => Math.Abs(g.Amount - montoTransaccion))
                .Take(3)
                .ToList();

            transaccion.PosiblesMatches = posiblesMatches;

            // Si hay coincidencia exacta, conciliar automáticamente
            //Colocar logica cuando haay mas de 2
            var matchExacto = posiblesMatches.FirstOrDefault(g => g.Amount == montoTransaccion);
            if (matchExacto != null)
            {
                await ConciliarConGasto(transaccion, matchExacto, automatico: true);
            }

            totalCoincidencias += posiblesMatches.Count;
        }

        foreach (var transaccion in transacciones.Where(t => t.ReconciliationStatus == ConcilationType.NoConciliada && t.Amount > 0))
        {
            // Buscar gastos con monto similar (±10%)
            var montoTransaccion = Math.Abs(transaccion.Amount);
            var posiblesMatches = cuotaspendientes
                .Where(g => Math.Abs(g.Amount - montoTransaccion) / montoTransaccion <= 0.1m)
                .OrderBy(g => Math.Abs(g.Amount - montoTransaccion))
                .Take(3)
                .ToList();

            transaccion.IPosiblesMatches = posiblesMatches;

            // Si hay coincidencia exacta, conciliar automáticamente
            //Colocar logica cuando haay mas de 2
            var matchExacto = posiblesMatches.FirstOrDefault(g => g.Amount == montoTransaccion);
            if (matchExacto != null)
            {
                await ConciliarConCuota(transaccion, matchExacto, automatico: true);
            }

            totalCoincidenciasI += posiblesMatches.Count;
        }
    }

    // Fase B -- conciliación en dos pasos: ConciliarConGasto/AplicarPagoACuotas ya NO
    // escriben en BD. Dejan la elección (automática o manual) como PROPUESTA en pantalla --
    // ReconciliationStatus queda sin tocar -- hasta que el usuario revisa el lote completo y
    // confirma con EnviarAConciliar, que es quien recién llama a los métodos reales de
    // persistencia (los mismos de siempre, sin cambios) y deja el registro de auditoría.
    private async Task ConciliarConGasto(TransactionBankDetail transaccion, ViewExpense gasto, bool automatico = false)
    {
        if (!_canReconcileExpenses) return;
        try
        {
            transaccion.GastoConciliado = gasto;
            transaccion.PropuestaPendiente = true;
            transaccion.PropuestaAutomatica = automatico;

            // Remover de listas pendientes para que no se vuelva a proponer a otra transacción
            gastosPendientes.Remove(gasto);

            CalcularEstadisticas();
            ActualizarPaginacion();

            if (!automatico)
            {
                mensajeExito = $"Propuesta: transacción con gasto '{gasto.Description}'. Usa 'Enviar a Conciliar' para confirmar.";
                CerrarModalConciliar();
            }

            StateHasChanged();
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al proponer conciliación: {ex.Message}";
        }
    }

    // Único camino para proponer un Ingreso contra una o varias cuotas: cubre pago menor,
    // igual y mayor (incluso cubriendo varias cuotas) -- la aplicación real contra
    // InstallmentService.AplicarPagoAsync ocurre recién en EnviarAConciliar.
    private async Task ConciliarConCuota(TransactionBankDetail transaccion, Installment cuota, bool automatico = false)
    {
        await AplicarPagoACuotas(transaccion, new List<Installment> { cuota }, automatico);
    }

    private async Task<bool> AplicarPagoACuotas(TransactionBankDetail transaccion, List<Installment> cuotas, bool automatico = false)
    {
        if (!_canReconcileInstallments) return false;
        if (transaccion == null) throw new ArgumentNullException(nameof(transaccion));
        if (cuotas == null || !cuotas.Any())
        {
            mensajeError = "Debe seleccionar al menos una cuota";
            return false;
        }

        transaccion.CuotasPropuestas = cuotas;
        transaccion.PropuestaPendiente = true;
        transaccion.PropuestaAutomatica = automatico;

        // Igual que gastosPendientes.Remove(gasto) en ConciliarConGasto -- sin esto, la misma
        // cuota seguía apareciendo como "posible match" de OTRA transacción mientras esta
        // propuesta seguía sin confirmar, permitiendo proponerla dos veces.
        var idsPropuestos = new HashSet<Guid>(cuotas.Select(c => c.IdInstallment));
        cuotaspendientes.RemoveAll(c => idsPropuestos.Contains(c.IdInstallment));

        CalcularEstadisticas();
        ActualizarPaginacion();

        if (!automatico)
        {
            mensajeExito = "Propuesta registrada. Usa 'Enviar a Conciliar' para confirmar.";
        }

        StateHasChanged();
        await Task.CompletedTask;
        return true;
    }

    private void QuitarPropuesta(TransactionBankDetail transaccion)
    {
        if (transaccion.GastoConciliado != null)
        {
            gastosPendientes.Add(transaccion.GastoConciliado);
            transaccion.GastoConciliado = null;
        }

        cuotaspendientes.AddRange(transaccion.CuotasPropuestas);
        transaccion.CuotasPropuestas = new();
        transaccion.PropuestaPendiente = false;
        transaccion.PropuestaAutomatica = false;

        CalcularEstadisticas();
        ActualizarPaginacion();
        StateHasChanged();
    }

    // Confirma TODAS las propuestas pendientes del lote actualmente cargado en un solo paso
    // -- acá recién se llama a los métodos reales de persistencia (sin cambios respecto a
    // los que ya existían antes de la Fase B) y se deja el registro de auditoría
    // (IWorkflowAuditService, module "Reconciliation") por cada transacción confirmada.
    // Devuelve true si efectivamente confirmó al menos una propuesta -- FinalizarConciliacion
    // lo usa para saber si de verdad hay algo que cerrar (el usuario pudo cancelar el
    // confirm de abajo, o no haber propuestas para empezar).
    private async Task<bool> EnviarAConciliar()
    {
        var propuestas = transacciones.Where(t => t.PropuestaPendiente).ToList();
        if (!propuestas.Any()) return false;

        if (!await ConfirmarAsync(
            $"¿Confirmar la conciliación de {propuestas.Count} transacción(es)? Una vez confirmada, una transacción solo se puede corregir con motivo (rol Administrador), no deshacer libremente."))
        {
            return false;
        }

        var confirmadas = 0;
        var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;
        var idBuilding = ParameterService.CurrentBuilding?.IdBuilding ?? Guid.Empty;

        foreach (var transaccion in propuestas)
        {
            try
            {
                if (transaccion.Tipo == "Ingreso" && transaccion.CuotasPropuestas.Any())
                {
                    await InstallmentService.AplicarPagoAsync(transaccion, transaccion.CuotasPropuestas, BankService, transaccion.PropuestaAutomatica);

                    var detalle = $"{transaccion.CuotasPropuestas.Count} cuota(s): Unidad " +
                        string.Join(", ", transaccion.CuotasPropuestas.Select(c => c.UnitName).Distinct());
                    await WorkflowAuditService.LogAsync("Reconciliation", transaccion.IdStatementDetail, WorkflowAction.Reconciled,
                        performedBy, idBuilding, $"{(transaccion.PropuestaAutomatica ? "Automático" : "Manual")} -- {detalle}");
                }
                else if (transaccion.Tipo == "Gasto" && transaccion.GastoConciliado != null)
                {
                    await BankService.ConciliarTransaccionAsync(transaccion, transaccion.GastoConciliado);
                    transaccion.ReconciliationStatus = ConcilationType.Conciliada;
                    transaccion.ReconciliationDate = DateTime.Now;

                    await WorkflowAuditService.LogAsync("Reconciliation", transaccion.IdStatementDetail, WorkflowAction.Reconciled,
                        performedBy, idBuilding, $"{(transaccion.PropuestaAutomatica ? "Automático" : "Manual")} -- Gasto: {transaccion.GastoConciliado.Description}");
                }
                else
                {
                    // Propuesta sin match real asociado (no debería pasar) -- se salta sin marcar
                    // como confirmada, para no dejar auditoría de algo que no se aplicó.
                    continue;
                }

                transaccion.PropuestaPendiente = false;
                confirmadas++;
            }
            catch (Exception ex)
            {
                mensajeError = $"Error al confirmar '{transaccion.Description}': {ex.Message}";
            }
        }

        // Recarga completa (no solo ActualizarListasPendientes) a propósito: para Ingresos,
        // AplicarPagoAsync puede dejar la transacción en Conciliada o Parcial según cuánto
        // cubrió el pago -- ese resultado lo decide el SP, no algo que convenga adivinar acá.
        // Sin recargar, la fila confirmada seguía con su ReconciliationStatus viejo en
        // memoria y, con las pestañas nuevas (solo Pendientes/Propuestos), volvía a aparecer
        // en "Pendientes" como si no se hubiera confirmado nada.
        await CargarTransacciones();

        if (confirmadas > 0)
        {
            mensajeExito = $"{confirmadas} transacción(es) conciliadas.";
        }

        StateHasChanged();
        return confirmadas > 0;
    }

    private async Task ActualizarListasPendientes()
    {
        if (ParameterService.CurrentBuilding == null) return;

        // Recargar cuotas pendientes y pagos ya registrados para que "Ver Detalle"
        // refleje los InstallmentPaid recién creados por AplicarPagoAsync.
        cuotaspendientes = await InstallmentService.GetPendingInstallmentsAsync(ParameterService.CurrentBuilding.IdBuilding);
        pagosCuotas = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
    }

    // Reemplaza al viejo "Desconciliar" (deshacer libre, sin rastro) para transacciones YA
    // CONFIRMADAS -- Fase B: restringido a rol Administrador, motivo obligatorio, y queda
    // registrado en el log de auditoría (IWorkflowAuditService). Antes de confirmar con
    // "Enviar a Conciliar" (mientras es solo una PROPUESTA), deshacer sigue siendo libre y
    // gratis vía QuitarPropuesta, porque ahí todavía no hay nada guardado en BD.
    //
    // Docs/Pendientes-Negocio-Migracion.md #3 -- alimenta BankAccount.InitialBalance
    // directamente desde un movimiento real, en vez de que el admin lo tipee a mano en la
    // ficha de la cuenta (donde además queda deshabilitado después de creada, ver
    // Database/Scripts/2026-09-05_51_BankAccount_InitialBalance.sql).
    private async Task MarcarComoSaldoInicial(TransactionBankDetail transaccion)
    {
        if (!_canReconcileExpenses && !_canReconcileInstallments) return;

        var cuenta = cuentasBancarias.FirstOrDefault(c => c.IdBankAccount == cuentaSeleccionadaId);
        if (cuenta == null) return;

        var nuevoSaldo = Math.Abs(transaccion.Amount);
        var mensaje = $"¿Marcar '{transaccion.Description}' ({transaccion.StatementDate:dd/MM/yyyy}, {Moneda(nuevoSaldo)}) como el Saldo Inicial de la cuenta '{cuenta.AccountNumber}'?" +
            (cuenta.InitialBalance != 0 ? $" Esto reemplaza el Saldo Inicial actual ({Moneda(cuenta.InitialBalance)})." : "");

        if (!await ConfirmarAsync(mensaje))
        {
            return;
        }

        try
        {
            await BankService.SetInitialBalanceAsync(cuenta.IdBankAccount, nuevoSaldo);
            cuenta.InitialBalance = nuevoSaldo;
            saldoInicial = nuevoSaldo;
            CalcularEstadisticas();

            var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;
            await WorkflowAuditService.LogAsync("BankAccount", cuenta.IdBankAccount, WorkflowAction.InitialBalanceSet,
                performedBy, ParameterService.CurrentBuilding?.IdBuilding ?? Guid.Empty,
                $"Saldo Inicial fijado en {Moneda(nuevoSaldo)} desde el movimiento '{transaccion.Description}' ({transaccion.StatementDate:dd/MM/yyyy}).");

            mensajeExito = "Saldo Inicial actualizado.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al actualizar el Saldo Inicial: {ex.Message}";
        }
    }

    private async Task CorregirConciliacion(TransactionBankDetail transaccion)
    {
        if (!_puedeCorregir) return;

        if (transaccion.Tipo == "Ingreso")
        {
            await CorregirConciliacionIngreso(transaccion);
        }
        else
        {
            await CorregirConciliacionGasto(transaccion);
        }
    }

    private async Task CorregirConciliacionIngreso(TransactionBankDetail transaccion)
    {
        if (!_canReconcileInstallments) return;

        var pagosDeEstaTransaccion = pagosCuotas.Where(p => p.IdTransaction == transaccion.IdStatementDetail).ToList();
        if (!pagosDeEstaTransaccion.Any())
        {
            mensajeError = "Este pago no tiene cuotas asociadas para corregir.";
            return;
        }

        var motivo = await PedirMotivoAsync(
            $"Vas a corregir la conciliación de '{transaccion.Description}' y liberar {pagosDeEstaTransaccion.Count} cuota(s) asociada(s).");
        if (string.IsNullOrWhiteSpace(motivo))
        {
            return;
        }

        try
        {
            var detalleAnterior = $"{pagosDeEstaTransaccion.Count} cuota(s): Unidad " +
                string.Join(", ", pagosDeEstaTransaccion.Select(p => p.UnitName).Distinct());

            await InstallmentService.RevertirPagoAsync(transaccion, pagosDeEstaTransaccion, BankService);

            var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;
            await WorkflowAuditService.LogAsync("Reconciliation", transaccion.IdStatementDetail, WorkflowAction.Corrected,
                performedBy, ParameterService.CurrentBuilding?.IdBuilding ?? Guid.Empty,
                $"Se liberó la conciliación con {detalleAnterior}. Motivo: {motivo}");

            CalcularEstadisticas();
            ActualizarPaginacion();
            await ActualizarListasPendientes();

            mensajeExito = "Conciliación corregida y cuota(s) liberada(s)";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al corregir: {ex.Message}";
        }
    }

    private async Task CorregirConciliacionGasto(TransactionBankDetail transaccion)
    {
        if (!_canReconcileExpenses) return;
        if (transaccion.GastoConciliado == null)
        {
            mensajeError = "Esta transacción no tiene un gasto conciliado asociado.";
            return;
        }

        var motivo = await PedirMotivoAsync(
            $"Vas a corregir la conciliación de '{transaccion.Description}' con el gasto '{transaccion.GastoConciliado.Description}'.");
        if (string.IsNullOrWhiteSpace(motivo))
        {
            return;
        }

        try
        {
            var gastoAnterior = transaccion.GastoConciliado;

            await BankService.DesconciliarGastoRealAsync(transaccion.IdStatementDetail, gastoAnterior.IdExpense);

            transaccion.ReconciliationStatus = ConcilationType.NoConciliada;
            transaccion.ReconciliationDate = null;
            gastoAnterior.Reconciled = false;
            gastoAnterior.ReconciledTransactionId = null;
            gastoAnterior.AutoReconcile = false;
            gastosPendientes.Add(gastoAnterior);
            transaccion.GastoConciliado = null;

            var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;
            await WorkflowAuditService.LogAsync("Reconciliation", transaccion.IdStatementDetail, WorkflowAction.Corrected,
                performedBy, ParameterService.CurrentBuilding?.IdBuilding ?? Guid.Empty,
                $"Se liberó la conciliación con gasto '{gastoAnterior.Description}'. Motivo: {motivo}");

            CalcularEstadisticas();
            ActualizarPaginacion();

            mensajeExito = "Conciliación corregida";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al corregir: {ex.Message}";
        }
    }

