    private async Task GenerarGastosSeleccionados()
    {
        if (!_canReconcileExpenses) return;
        var transaccionesSeleccionadas = transaccionesNoConciliadas.Where(t => t.Selected).ToList();

        if (!transaccionesSeleccionadas.Any())
        {
            mensajeError = "No hay transacciones seleccionadas";
            return;
        }

        // Aquí se podría abrir un modal para crear múltiples gastos a la vez
        // Por ahora, crear uno por uno
        foreach (var transaccion in transaccionesSeleccionadas)
        {
            // Crear gasto básico desde transacción
            var nuevoGasto = new ViewExpense
            {
                Description = transaccion.Description,
                Amount = Math.Abs(transaccion.Amount),
                ExpenseDate = transaccion.StatementDate,
                IdCategory = ParameterService.CurrentBuilding.Configuration.DefaultCategory.GetValueOrDefault(),
                IdBuilding = ParameterService.CurrentBuilding.IdBuilding,
                Distribution = TypeDistribution.Fija,
                Status = StatusExpense.Approved,
                PaymentMethod = PaymentMethod.BankTransfer
                //Reconciled = false
            };

            // Guardar gasto
            var gastoCreado = await ExpenseService.CrearGastoAsync(nuevoGasto);

            // Conciliar
            await ConciliarConGasto(transaccion, gastoCreado);
        }

        DeseleccionarTodo();
        mensajeExito = $"Se generaron {transaccionesSeleccionadas.Count} gastos nuevos";
    }

    // Sólo cubría Gastos (transaccion.PosiblesMatches) -- en la vista de Pagos (Ingresos,
    // ModoFijo="Ingreso") no hacía absolutamente nada, porque IPosiblesMatches (el
    // equivalente para cuotas) nunca se miraba acá. Ahora deja PROPUESTO (Fase B) con el
    // primer match disponible de cada tipo, igual que ya hace el auto-match individual.
    private async Task ConciliarSeleccionadas()
    {
        var transaccionesSeleccionadas = transaccionesNoConciliadas.Where(t => t.Selected).ToList();

        if (!transaccionesSeleccionadas.Any())
        {
            mensajeError = "No hay transacciones seleccionadas";
            return;
        }

        // Conciliar con el primer match disponible
        var propuestas = 0;
        foreach (var transaccion in transaccionesSeleccionadas)
        {
            if (transaccion.PropuestaPendiente) continue;

            // automatico: false -- es una elección manual (el usuario seleccionó las filas y
            // pidió "Conciliar seleccionadas"), aunque el match en sí se tome del primero
            // disponible; el badge debe decir "Manual", no "Auto".
            if (transaccion.Tipo == "Gasto" && _canReconcileExpenses && transaccion.PosiblesMatches.Any())
            {
                await ConciliarConGasto(transaccion, transaccion.PosiblesMatches.First(), automatico: false);
                propuestas++;
            }
            else if (transaccion.Tipo == "Ingreso" && _canReconcileInstallments && transaccion.IPosiblesMatches.Any())
            {
                await ConciliarConCuota(transaccion, transaccion.IPosiblesMatches.First(), automatico: false);
                propuestas++;
            }
        }

        if (propuestas == 0)
        {
            mensajeError = "Ninguna de las transacciones seleccionadas tiene coincidencias para proponer.";
            DeseleccionarTodo();
            return;
        }

        DeseleccionarTodo();
        mensajeExito = $"{propuestas} transacción(es) propuesta(s). Usa 'Enviar a Conciliar' para confirmar.";
    }

    private async Task IgnorarSeleccionadas()
    {
        if (!_canReconcileExpenses && !_canReconcileInstallments) return;
        var transaccionesSeleccionadas = transaccionesNoConciliadas.Where(t => t.Selected).ToList();

        if (!transaccionesSeleccionadas.Any())
        {
            mensajeError = "No hay transacciones seleccionadas";
            return;
        }

        // Docs/Pendientes-Negocio-Conciliacion.md #1 -- tipo + motivo obligatorios, mismo
        // motivo/tipo se aplica a todo el lote seleccionado (no tiene sentido pedirlo
        // transacción por transacción para una acción en lote).
        var respuesta = await PedirMotivoYTipoIgnorarAsync(
            $"Vas a ignorar {transaccionesSeleccionadas.Count} transacción(es) seleccionada(s). Van a dejar de aparecer como pendientes (quedan en la pestaña 'Ignorados').");
        if (respuesta == null)
        {
            return;
        }

        var (motivo, tipo) = respuesta.Value;
        var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;
        var idBuilding = ParameterService.CurrentBuilding?.IdBuilding ?? Guid.Empty;
        var errores = 0;

        foreach (var transaccion in transaccionesSeleccionadas)
        {
            try
            {
                await BankService.MarcarTransaccionComoIgnoradaAsync(transaccion, motivo, tipo);
                transaccion.Ignored = true;
                transaccion.IgnoredReason = motivo;
                transaccion.IgnoredType = tipo;

                await WorkflowAuditService.LogAsync("Reconciliation", transaccion.IdStatementDetail, WorkflowAction.Ignored,
                    performedBy, idBuilding,
                    $"Ignorada ({DescribirTipoIgnorado(tipo)}). Motivo: {motivo}");
            }
            catch (Exception ex)
            {
                errores++;
                Console.WriteLine($"Error al ignorar '{transaccion.Description}': {ex.Message}");
            }
        }

        DeseleccionarTodo();
        CalcularEstadisticas();
        ActualizarPaginacion();
        mensajeExito = errores == 0
            ? $"Se ignoraron {transaccionesSeleccionadas.Count} transacciones"
            : $"Se ignoraron {transaccionesSeleccionadas.Count - errores} de {transaccionesSeleccionadas.Count} transacciones ({errores} con error)";
        StateHasChanged();
    }

