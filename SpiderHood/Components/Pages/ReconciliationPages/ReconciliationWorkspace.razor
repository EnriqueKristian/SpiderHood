        }
    }

    private void CalcularEstadisticas()
    {
        totalTransacciones = transacciones.Count;
        totalGastos = transacciones.Where(t => t.Amount < 0).Sum(t => t.Amount);
        totalIngresos = transacciones.Where(t => t.Amount > 0).Sum(t => t.Amount);
        saldoFinalCalculado = saldoInicial + totalGastos + totalIngresos;

        // Calcular diferencia entre transacciones conciliadas y gastos
        var totalConciliado = transaccionesConciliadas.Where(t => t.Amount < 0).Sum(t => t.Amount);
        var totalGastosConciliados = transaccionesConciliadas
            .Where(t => t.GastoConciliado != null)
            .Sum(t => t.GastoConciliado?.Amount ?? 0);

        diferenciaConciliacion = Math.Abs(totalConciliado) - totalGastosConciliados;

        // Antes sumaba sólo transaccionesNoConciliadas.Where(t => t.Amount < 0) -- el monto
        // COMPLETO de los Gastos pendientes, ignorando por completo los Ingresos pendientes
        // (Amount siempre es > 0 ahí). Con una transacción "Conciliada Parcialmente" (un
        // Ingreso con Balance > 0 -- ver la columna "Pendiente" de la tabla, línea 343) esto
        // mostraba "S/ 0.00" en el resumen de arriba mientras la tabla, dos secciones más
        // abajo, mostraba un pendiente real de S/ 3.97 para esa misma transacción -- mismo
        // bug reportado por el usuario. Para Ingresos el pendiente real es t.Balance (sale de
        // VW_SUM_InstallmentPaidTransaction, ver el comentario de esa columna); para Gastos
        // Balance no aplica (siempre == Amount) así que se usa Amount directamente, igual que
        // en la tabla.
        totalPendiente = transaccionesNoConciliadas.Sum(t => t.Tipo == "Ingreso" ? Math.Abs(t.Balance) : Math.Abs(t.Amount));
    }

    // Null = no se pudo determinar (transacción sin conciliar, o Gasto conciliado en una
    // sesión anterior -- GastoConciliado solo queda poblado en memoria durante la sesión que
    // hizo la conciliación, ObtenerTransaccionesAsync no lo trae). Para Ingresos sí es
    // confiable siempre: pagosCuotas se recarga completo desde BD en cada CargarTransacciones.
    private bool? EsConciliacionAutomatica(TransactionBankDetail transaccion)
    {
        if (transaccion.Tipo == "Ingreso")
        {
            var pagos = pagosCuotas.Where(p => p.IdTransaction == transaccion.IdStatementDetail).ToList();
            return pagos.Any() ? pagos.All(p => p.IsAutoReconcile) : null;
        }

        return transaccion.GastoConciliado?.AutoReconcile;
    }

    private List<TransactionBankDetail> GetTransaccionesFiltradas()
    {
        IEnumerable<TransactionBankDetail> resultado = transacciones;

        // Aplicar filtro de tab -- esta pantalla es solo para trabajar lo pendiente
        // (Fase B): "Conciliados"/"Todas las Transacciones" ya no existen acá, esa consulta
        // vive en /movement -> "Detalle" (estado real en BD).
        if (tabActiva == "noConciliados")
        {
            resultado = resultado.Where(t => !t.Ignored && !t.PropuestaPendiente &&
                (t.ReconciliationStatus == ConcilationType.NoConciliada || t.ReconciliationStatus == ConcilationType.Parcial));
        }
        else if (tabActiva == "propuestosAuto")
        {
            resultado = resultado.Where(t => t.PropuestaPendiente && t.PropuestaAutomatica);
        }
        else if (tabActiva == "propuestosManual")
        {
            resultado = resultado.Where(t => t.PropuestaPendiente && !t.PropuestaAutomatica);
        }
        else if (tabActiva == "ignorados")
        {
            resultado = resultado.Where(t => t.Ignored);
        }

        // Aplicar filtro de tipo
        if (filtroTipo != null)
        {
            resultado = resultado.Where(t => t.Tipo == filtroTipo);
        }

        // Aplicar filtro de búsqueda
        if (!string.IsNullOrEmpty(textoBusqueda))
        {
            var busqueda = textoBusqueda.ToLower();
            resultado = resultado.Where(t =>
                t.Description.ToLower().Contains(busqueda) ||
                t.Reference.ToLower().Contains(busqueda) ||
                t.Notes?.ToLower().Contains(busqueda) == true);
        }

        return resultado.OrderByDescending(t => t.StatementDate).ToList();
    }

    private (DateTime inicio, DateTime fin) ObtenerFechasPeriodo()
    {
        var hoy = DateTime.Today;

        return periodoSeleccionado switch
        {
            // Rango amplio (no DateTime.MinValue: desborda el tipo datetime de SQL
            // Server, que arranca en 1753) en vez de un caso especial que salte el
            // filtro de fechas -- así ObtenerTransaccionesAsync no necesita cambios.
            "todos" => (new DateTime(1900, 1, 1), DateTime.Today.AddDays(1)),
            "mesAnterior" => (
                new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-1),
                new DateTime(hoy.Year, hoy.Month, 1).AddDays(-1)
            ),
            "trimestreActual" => (
                new DateTime(hoy.Year, ((hoy.Month - 1) / 3) * 3 + 1, 1),
                new DateTime(hoy.Year, ((hoy.Month - 1) / 3) * 3 + 4, 1).AddDays(-1)
            ),
            "personalizado" => (fechaDesde, fechaHasta),
            _ => ( // mesActual
                new DateTime(hoy.Year, hoy.Month, 1),
                new DateTime(hoy.Year, hoy.Month, DateTime.DaysInMonth(hoy.Year, hoy.Month))
            )
        };
    }

    private async Task CambiarCuenta(ChangeEventArgs args)
    {
        cuentaSeleccionadaId = Guid.Parse(args.Value?.ToString() ?? Guid.Empty.ToString());
        if (cuentaSeleccionadaId != Guid.Empty)
        {
            await CargarTransacciones();
        }
    }

    private async Task CambiarPeriodo()
    {
        if (cuentaSeleccionadaId != Guid.Empty)
        {
            await CargarTransacciones();
        }
    }

    private void CambiarTab(string tab)
    {
        tabActiva = tab;
        ActualizarPaginacion();
    }

    private void FiltrarPorTipo(string? tipo)
    {
        filtroTipo = tipo;
        ActualizarPaginacion();
    }

    private void LimpiarFiltros()
    {
        // En modo fijo (Pagos/Gastos) no se limpia el tipo -- si no, el botón "Limpiar
        // filtros" (la X) se saltaría el candado y volvería a mostrar ambos tipos mezclados.
        filtroTipo = ModoFijo;
        textoBusqueda = "";
        ActualizarPaginacion();
        DeseleccionarTodo();
    }

    private async Task VerDetallesTransaccion(TransactionBankDetail transaccion)
    {
        // PropuestaPendiente (Fase B) también entra acá -- antes solo se activaba con
        // ReconciliationStatus != NoConciliada, que ya no cambia hasta confirmar, así que el
        // "ojo" de una propuesta (automática o manual) caía siempre en el toast genérico de
        // abajo, sin decir con qué cuota se la estaba asociando.
        if (transaccion.Tipo == "Ingreso" && (transaccion.ReconciliationStatus != ConcilationType.NoConciliada || transaccion.PropuestaPendiente))
        {
            transaccionDetalleIngreso = transaccion;
            mostrarModalVerDetalleIngreso = true;
            return;
        }

        // Gasto (confirmado, propuesto, o sin conciliar todavía): vista simple existente.
        // showToast vuelca el mensaje via innerHTML (ver wwwroot/js/utilidades.js), asi que
        // los saltos de línea se pasan como <br> en vez de "\n" para que se vean.
        var estado = transaccion.PropuestaPendiente
            ? $"Propuesto ({(transaccion.PropuestaAutomatica ? "Auto" : "Manual")})"
            : (transaccion.ReconciliationStatus == ConcilationType.Conciliada ? "Conciliado" : "Pendiente");

        var detalles = $"Fecha: {transaccion.StatementDate:dd/MM/yyyy}<br>" +
              $"Descripción: {transaccion.Description}<br>" +
              $"Monto: {Moneda(transaccion.Amount)}<br>" +
              $"Referencia: {transaccion.Reference}<br>" +
              $"Tipo: {transaccion.Tipo}<br>" +
              $"Estado: {estado}";

        if (transaccion.Tipo == "Gasto" && transaccion.GastoConciliado != null)
        {
            detalles += $"<br>Gasto: {transaccion.GastoConciliado.Description} ({transaccion.GastoConciliado.Category})";
        }

        await ShowToast("Detalle de transacción", detalles, "info");
    }

    private void CerrarModalVerDetalleIngreso()
    {
        mostrarModalVerDetalleIngreso = false;
        transaccionDetalleIngreso = null;
    }

    public void Dispose()
    {
        // Limpiar recursos si es necesario
    }

    private async Task ShowToast(string title, string message, string type)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showToast", title, message, type);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando toast: {ex.Message}");
            Console.WriteLine($"{type.ToUpper()}: {title} - {message}");
        }
    }
