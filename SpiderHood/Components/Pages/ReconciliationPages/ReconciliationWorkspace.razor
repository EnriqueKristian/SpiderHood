    private void DeseleccionarTodo()
    {
        seleccionarTodos = false;
        foreach (var transaccion in transacciones)
        {
            transaccion.Selected = false;
        }
    }

    // Antes duplicaba la lógica de EnviarAConciliar con métodos que ya no eran reales
    // (ExpenseService.MarcarGastoComoConciliadoAsync/BankService.DesconciliarTransaccionAsync
    // -- ambos en memoria, nunca tocaban la BD) y buscaba
    // ReconciliationStatus == Conciliada, que con la Fase B ya no se setea hasta confirmar --
    // este botón nunca encontraba nada que guardar. Ahora es la misma acción que "Enviar a
    // Conciliar" del header, más el registro de la sesión de conciliación completa
    // (Conciliacion, con el usuario real en vez del "Administrador" fijo que tenía antes).
    private async Task FinalizarConciliacion()
    {
        if (!_canReconcileExpenses && !_canReconcileInstallments) return;

        var sinPropuesta = transaccionesNoConciliadas.Where(t => !t.PropuestaPendiente).ToList();
        if (sinPropuesta.Any())
        {
            if (!await ConfirmarAsync(
                $"Hay {sinPropuesta.Count} transacción(es) pendiente(s) sin ninguna propuesta de conciliación. ¿Deseas finalizar de todos modos?"))
            {
                return;
            }
        }

        try
        {
            if (transacciones.Any(t => t.PropuestaPendiente))
            {
                await EnviarAConciliar();

                // El usuario pudo cancelar el confirm de EnviarAConciliar -- si todavía quedan
                // propuestas pendientes, no se llegó a confirmar nada, así que no correspondé
                // registrar la sesión como finalizada.
                if (transacciones.Any(t => t.PropuestaPendiente)) return;
            }

            var performedBy = string.IsNullOrWhiteSpace(_currentUser.FullName) ? _currentUser.Email : _currentUser.FullName;
            var conciliacion = new Conciliacion
            {
                CuentaBancariaId = cuentaSeleccionadaId,
                FechaInicio = fechaDesde,
                FechaFin = fechaHasta,
                TransaccionesProcesadas = transacciones.Count,
                TransaccionesConciliadas = transaccionesConciliadas.Count,
                Diferencia = diferenciaConciliacion,
                Completada = true,
                Fecha = DateTime.Now,
                Usuario = performedBy
            };

            await BankService.GuardarConciliacionAsync(conciliacion);
            mensajeExito = "Conciliación finalizada exitosamente";

            await CargarTransacciones();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al finalizar conciliación: {ex.Message}";
        }
    }

