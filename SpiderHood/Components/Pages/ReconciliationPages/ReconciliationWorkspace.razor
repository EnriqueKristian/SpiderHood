    private async Task ExportarConciliacion()
    {
        try
        {
            var datos = new
            {
                Cuenta = cuentasBancarias.FirstOrDefault(c => c.IdBankAccount == cuentaSeleccionadaId)?.BankName,
                Periodo = $"{fechaDesde:dd/MM/yyyy} - {fechaHasta:dd/MM/yyyy}",
                Transacciones = transacciones,
                Resumen = new
                {
                    SaldoInicial = saldoInicial,
                    TotalGastos = totalGastos,
                    TotalIngresos = totalIngresos,
                    SaldoFinal = saldoFinalCalculado,
                    Conciliadas = transaccionesConciliadas.Count,
                    Pendientes = transaccionesNoConciliadas.Count,
                    Diferencia = diferenciaConciliacion
                }
            };

            await JSRuntime.InvokeVoidAsync("descargarJSON", datos, $"conciliacion_{DateTime.Now:yyyyMMdd_HHmmss}.json");
            mensajeExito = "Conciliación exportada exitosamente";

        }
        catch (Exception ex)
