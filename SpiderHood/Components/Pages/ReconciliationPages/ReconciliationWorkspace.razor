    // Claves ya existentes en BD (ver mapeo de permisos), sin necesidad de script nuevo.
    private bool _canReconcileExpenses;
    private bool _canReconcileInstallments;
    private UserSession _currentUser = new();
    // Corregir una conciliación ya confirmada queda restringido al rol Administrador (a
    // diferencia de _canReconcileExpenses/_canReconcileInstallments, que sí vienen del
    // sistema de permisos por BD) -- así lo pidió el usuario explícitamente, y agregar un
    // permiso nuevo requeriría un script de datos aparte para el rol Administrador sin
    // aportar nada distinto a chequear el rol directo.
    private bool _puedeCorregir => _currentUser.Role == "Administrador";

    private string noConciliados = "noConciliados";
    private string propuestosAuto = "propuestosAuto";
    private string propuestosManual = "propuestosManual";
    private string ignorados = "ignorados";
    private string Gasto = "Gasto";
    private string Ingreso = "Ingreso";

    // Propiedades calculadas
    // En modo fijo (Pagos/Gastos), estos conteos/badges quedan acotados al tipo de la
    // página -- si no, mostrarían números de ambos tipos mezclados aunque la tabla de
    // abajo (GetTransaccionesFiltradas, que sí respeta filtroTipo) sólo muestre uno.
    private IEnumerable<TransactionBankDetail> TransaccionesDelModo =>
        ModoFijo == null ? transacciones : transacciones.Where(t => t.Tipo == ModoFijo);
    private List<TransactionBankDetail> transaccionesConciliadas =>
        TransaccionesDelModo.Where(t => t.ReconciliationStatus == ConcilationType.Conciliada).ToList();
    // "No Conciliados" agrupa Pendientes (NoConciliada) y Parciales -- una transacción
    // Parcial todavía tiene saldo por conciliar, así que antes se perdía de este tab
    // (y del de "Conciliados", que exige == Conciliada) y sólo aparecía en "Todas".
    // Excluye Ignored -- Docs/Pendientes-Negocio-Conciliacion.md #1: ignorar una
    // transacción tiene que sacarla de la cola de pendientes, si no la acción no tiene
