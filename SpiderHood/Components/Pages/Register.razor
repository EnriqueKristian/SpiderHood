@page "/register"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using SpiderHood.Models
@inject Services.AuthService AuthService
@inject Services.IBuildingService BuildingService
@inject NavigationManager Navigation

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <i class="bi bi-building"></i>
                <h2>SpiderHood</h2>
            </div>
            <p class="text-muted">Crear una cuenta</p>
        </div>

        <div class="login-body">
            @if (_success)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>
                    Registro exitoso. Tu solicitud de acceso quedó <strong>pendiente de aprobación</strong>
                    por el administrador del edificio elegido. Ya podés iniciar sesión mientras tanto.
                </div>
                <a href="/login" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Ir a Iniciar Sesión
                </a>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
                    </div>
                }

                <EditForm Model="@_model" OnValidSubmit="@HandleRegister">
                    <DataAnnotationsValidator />
                    <div class="validation-summary-errors text-danger mb-3">
                        <ValidationSummary />
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="_model.FirstName" />
                            <ValidationMessage For="@(() => _model.FirstName)" />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="form-label">Apellido</label>
                            <InputText class="form-control" @bind-Value="_model.LastName" />
                            <ValidationMessage For="@(() => _model.LastName)" />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label"><i class="bi bi-envelope me-2"></i>Email</label>
                        <InputText class="form-control" @bind-Value="_model.Email" placeholder="tu@email.com" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="_model.PhoneNumber" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label"><i class="bi bi-building me-2"></i>Edificio</label>
                        <InputSelect class="form-select" @bind-Value="_model.BuildingId">
                            <option value="">-- Seleccionar edificio --</option>
                            @foreach (var building in _buildings)
                            {
                                <option value="@building.IdBuilding">@building.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.BuildingId)" />
                        <small class="text-muted">
                            Vas a quedar registrado como <strong>Residente</strong> de este edificio, pendiente
                            de aprobación por su administrador.
                        </small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="form-label"><i class="bi bi-lock me-2"></i>Contraseña</label>
                            <InputText type="password" class="form-control" @bind-Value="_model.Password" />
                            <ValidationMessage For="@(() => _model.Password)" />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="form-label">Confirmar contraseña</label>
                            <InputText type="password" class="form-control" @bind-Value="_model.ConfirmPassword" />
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-person-plus me-2"></i>
                        <span>Crear Cuenta</span>
                    </button>
                </EditForm>

                <div class="login-footer mt-4">
                    <p class="mb-0">
                        <a href="/login" class="text-decoration-none">
                            <i class="bi bi-box-arrow-in-right me-1"></i>¿Ya tenés cuenta? Iniciá sesión
                        </a>
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private RegisterModel _model = new();
    private List<Building> _buildings = new();
    private string _errorMessage = string.Empty;
    private bool _success;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _buildings = await BuildingService.GetAllBuildingsPublicAsync();
    }

    private async Task HandleRegister()
    {
        _errorMessage = string.Empty;
        _saving = true;
        try
        {
            var result = await AuthService.RegisterSelfServiceAsync(_model);
            if (result.Success)
            {
                _success = true;
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
