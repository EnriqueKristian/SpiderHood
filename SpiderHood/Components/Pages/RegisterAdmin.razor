@page "/register-admin"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using SpiderHood.Models
@inject Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 L12 21 M4 7 L20 7 M4 17 L20 17 M6 4 L18 20 M18 4 L6 20" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.55" />
                    <path d="M12 12 L12 5.2 M12 12 L18.2 8.6 M12 12 L18.2 15.4 M12 12 L12 18.8 M12 12 L5.8 15.4 M12 12 L5.8 8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                    <path d="M12 5.2 L15.4 6.6 L18.2 8.6 L19.4 12 L18.2 15.4 L15.4 17.4 L12 18.8 L8.6 17.4 L5.8 15.4 L4.6 12 L5.8 8.6 L8.6 6.6 Z" stroke="currentColor" stroke-width="1.1" opacity="0.6" fill="none" />
                </svg>
                <h2>SpiderHood</h2>
            </div>
            <p class="text-muted">Regístrate como Administrador y crea tu primer edificio</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
                </div>
            }

            <EditForm Model="@_model" OnValidSubmit="@HandleRegister">
                <DataAnnotationsValidator />
                <div class="validation-summary-errors text-danger mb-3">
                    <ValidationSummary />
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="_model.FirstName" />
                        <ValidationMessage For="@(() => _model.FirstName)" />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">Apellido</label>
                        <InputText class="form-control" @bind-Value="_model.LastName" />
                        <ValidationMessage For="@(() => _model.LastName)" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label"><i class="bi bi-envelope me-2"></i>Email</label>
                    <InputText class="form-control" @bind-Value="_model.Email" placeholder="tu@email.com" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="_model.PhoneNumber" />
                </div>

                <hr class="my-3" />
                <p class="small text-muted mb-2">
                    <i class="bi bi-receipt me-1"></i>Datos de facturación -- la suscripción se le cobra a esta cuenta.
                </p>

                <div class="form-group mb-3">
                    <label class="form-label">Razón Social</label>
                    <InputText class="form-control" @bind-Value="_model.RazonSocial" placeholder="Mi Empresa S.A.C." />
                    <ValidationMessage For="@(() => _model.RazonSocial)" />
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">RUC / DNI</label>
                        <InputText class="form-control" @bind-Value="_model.RucDni" />
                        <ValidationMessage For="@(() => _model.RucDni)" />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">Teléfono de facturación</label>
                        <InputText class="form-control" @bind-Value="_model.Telefono" />
                        <ValidationMessage For="@(() => _model.Telefono)" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label"><i class="bi bi-lock me-2"></i>Contraseña</label>
                        <InputText type="password" class="form-control" @bind-Value="_model.Password" />
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">Confirmar contraseña</label>
                        <InputText type="password" class="form-control" @bind-Value="_model.ConfirmPassword" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                    </div>
                </div>

                <div class="alert alert-info small">
                    <i class="bi bi-info-circle me-2"></i>
                    Al crear tu cuenta vas a quedar como <strong>Administrador</strong> y vas a poder crear tu
                    edificio de inmediato -- no necesitas aprobación de nadie.
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-person-plus me-2"></i>
                    <span>Crear mi cuenta</span>
                </button>
            </EditForm>

            <div class="login-footer mt-4">
                <p class="mb-0">
                    <a href="@_loginUrl" class="text-decoration-none">
                        <i class="bi bi-box-arrow-in-right me-1"></i>¿Ya tienes cuenta? Inicia sesión
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterAdminModel _model = new();
    private string _errorMessage = string.Empty;
    private bool _saving;
    // Si alguien vino de la landing eligiendo un plan (ej. "Empezar gratis" del
    // plan Empresarial) y ya tiene cuenta, "Inicia sesión" tiene que llevarse el
    // ?returnUrl al login para no perder esa intención -- ver Login.razor.
    private string _loginUrl = "/login";

    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        var returnUrl = query.TryGetValue("returnUrl", out var raw) ? raw.ToString() : null;
        if (!string.IsNullOrEmpty(returnUrl) && returnUrl.StartsWith('/') && !returnUrl.StartsWith("//"))
        {
            _loginUrl = $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
    }

    private async Task HandleRegister()
    {
        _errorMessage = string.Empty;
        _saving = true;
        try
        {
            var result = await AuthService.RegisterNewAdministratorAsync(_model);
            if (!result.Success)
            {
                _errorMessage = result.Message;
                return;
            }

            // RegisterNewAdministratorAsync ya deja al usuario logueado (autologin) --
            // BuildingPage abre el modal de "Nuevo Edificio" solo cuando detecta que
            // no tiene ninguno todavía (ver BuildingPage.razor.cs).
            Navigation.NavigateTo("/buildings");
        }
        finally
        {
            _saving = false;
        }
    }
}
