@page "/reportes/recaudacion"
@rendermode InteractiveServer
@using System.Globalization
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@using ClosedXML.Excel
@inject IBudgetService BudgetService
@inject IInstallmentService InstallmentService
@inject ParameterService ParameterService
@inject SpiderHood.Services.AuthService AuthService
@inject SpiderHood.Services.IPermissionService PermissionService
@inject IJSRuntime JSRuntime

<PageTitle>SpiderHood - Recaudación</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="page-header mb-4">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Recaudación</h1>
                <p class="text-muted mb-0">Presupuesto vs. recaudado, por periodo</p>
            </div>
        </div>
    </div>

    @if (!_inicializado)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3 mb-0">Cargando...</p>
        </div>
    }
    else if (!_canView)
    {
        <div class="alert alert-warning">No tenés permiso para ver este reporte.</div>
    }
    else if (ParameterService.CurrentBuilding == null)
    {
        <div class="alert alert-warning">Selecciona un edificio para continuar.</div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Periodo desde</label>
                        <input type="date" class="form-control" @bind="fechaDesde" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Periodo hasta</label>
                        <input type="date" class="form-control" @bind="fechaHasta" />
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <button class="btn btn-primary" @onclick="CargarAsync" disabled="@cargando">
                            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                        </button>
                        <button class="btn btn-outline-success" @onclick="ExportarExcel" disabled="@(cargando || !_filas.Any())">
                            <i class="bi bi-file-earmark-excel me-1"></i>Exportar a Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-3 mb-0">Procesando...</p>
            </div>
        }
        else if (!_filas.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No hay presupuestos Ordinarios publicados (Activo o Cerrado) en el periodo seleccionado.
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">Presupuesto vs. Recaudado por periodo</h6>
                        </div>
                        <div class="table-responsive" style="max-height: 500px;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="sticky-top table-light">
                                    <tr>
                                        <th>Periodo</th>
                                        <th>Nombre</th>
                                        <th class="text-end">Presupuesto</th>
                                        <th class="text-end">Recaudado</th>
                                        <th class="text-end">Dif</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in _filas)
                                    {
                                        <!-- Clickeable: elegir un periodo muestra sus deudores en el detalle de
                                             abajo (misma cuota que ya se cargó para calcular Dif, sin pedir nada
                                             nuevo a la BD). -->
                                        <tr class="@(f == _filaSeleccionada ? "table-primary" : "")"
                                            style="cursor:pointer"
                                            title="Ver deudores de este periodo"
                                            @onclick="() => SeleccionarFila(f)">
                                            <td class="fw-semibold">@f.Periodo</td>
                                            <td>@f.Nombre</td>
                                            <td class="text-end">@Moneda(f.Presupuesto)</td>
                                            <td class="text-end">@Moneda(f.Recaudado)</td>
                                            <td class="text-end @(f.Diferencia > 0 ? "text-danger" : "text-success")">@Moneda(f.Diferencia)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-secondary fw-bold">
                                        <td colspan="2">TOTAL</td>
                                        <td class="text-end">@Moneda(_filas.Sum(f => f.Presupuesto))</td>
                                        <td class="text-end">@Moneda(_filas.Sum(f => f.Recaudado))</td>
                                        <td class="text-end">@Moneda(_filas.Sum(f => f.Diferencia))</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">@TituloGrafico</h6>
                        </div>
                        <div class="card-body" style="height: 420px;">
                            <canvas id="chartRecaudacion"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Deudores del periodo seleccionado -- pedido explícito del usuario: qué
                 DPTO(s) explican el "Dif" de cada presupuesto, sin abrir un modal. -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0">
                        @if (_filaSeleccionada != null)
                        {
                            <text>Deudores -- @_filaSeleccionada.Nombre (@_filaSeleccionada.Periodo)</text>
                        }
                        else
                        {
                            <text>Deudores por periodo</text>
                        }
                    </h6>
                </div>
                @if (_filaSeleccionada == null)
                {
                    <div class="card-body text-muted">
                        Hacé click en un periodo de la tabla de arriba para ver qué unidades componen su "Dif".
                    </div>
                }
                else if (!_filaSeleccionada.Deudores.Any())
                {
                    <div class="card-body">
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-check-circle me-2"></i>Sin deudores en este periodo -- se recaudó el 100%.
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 400px;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="sticky-top table-light">
                                <tr>
                                    <th>DPTO</th>
                                    <th>Propietario</th>
                                    <th class="text-end">Deuda</th>
                                    <th class="text-end">Cuotas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _filaSeleccionada.Deudores)
                                {
                                    <tr>
                                        <td class="fw-semibold">@d.UnitName</td>
                                        <td>@d.OwnerName</td>
                                        <td class="text-end">@Moneda(d.Deuda)</td>
                                        <td class="text-end">@d.Cuotas</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-secondary fw-bold">
                                    <td colspan="2">TOTAL</td>
                                    <td class="text-end">@Moneda(_filaSeleccionada.Deudores.Sum(d => d.Deuda))</td>
                                    <td class="text-end">@_filaSeleccionada.Deudores.Sum(d => d.Cuotas)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private UserSession currentUser = new();
    private bool _canView;
    private bool _inicializado;
    private bool cargando = true;

    private DateTime fechaDesde = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime fechaHasta = DateTime.Today;

    private List<FilaRecaudacion> _filas = new();
    private FilaRecaudacion? _filaSeleccionada;
    private bool _debeRedibujarGrafico;

    private string TituloGrafico => $"Recaudación al {DateTime.Today.ToString("dd-MMMM-yy", new CultureInfo("es-ES"))}";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        // Mismo caveat que Docs/Pendientes-Negocio-Migracion.md #6.3 y el reporte de
        // Morosidad: no se tocó la BD del catálogo de Permission/RolePermissions desde
        // este entorno -- si nadie tiene "view_budget_execution" asignado todavía, hay
        // que sumarlo a los roles correspondientes desde /roles.
        _canView = await PermissionService.HasPermissionAsync(currentUser, "view_budget_execution");

        if (_canView)
        {
            await CargarAsync();
        }
        else
        {
            cargando = false;
        }

        _inicializado = true;
    }

    // El gráfico se dibuja acá, no al final de CargarAsync -- StateHasChanged() sólo
    // ENCOLA el render, no espera a que el DOM del browser ya tenga el <canvas> antes de
    // seguir ejecutando; un JS interop llamado justo después corre el riesgo real de que
    // document.getElementById todavía no encuentre el elemento (no tira excepción, sólo
    // no dibuja nada -- exactamente el síntoma reportado). OnAfterRenderAsync es la única
    // garantía de "el render ya se aplicó" -- corre después de CADA render, no sólo el
    // primero, así que también cubre la recarga vía el botón Actualizar. Bonus: nunca
    // corre durante el prerender estático, así que de paso evita el
    // InvalidOperationException de JS interop en ese pase sin necesitar adivinar
    // RendererInfo.IsInteractive.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_debeRedibujarGrafico)
        {
            _debeRedibujarGrafico = false;
            await RenderizarGraficoAsync();
        }
    }

    private async Task CargarAsync()
    {
        if (ParameterService.CurrentBuilding == null)
        {
            cargando = false;
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            var idBuilding = ParameterService.CurrentBuilding.IdBuilding;

            // "Presupuesto" acá es sólo el ciclo Ordinario mensual (BudgetType vacío) --
            // Extraordinaria/Cargos (Multas y Mora) viven bajo sus propios BudgetHeader
            // ("Extraordinario"/"Cargos") y no son "el presupuesto" del periodo en el
            // sentido de este reporte.
            //
            // Activo + Cerrado, no sólo Activo: IBudgetService.SaveInstallment (que genera
            // las cuotas reales) sólo corre al pasar a Active -- pero sólo puede haber UN
            // presupuesto Active por edificio a la vez (al publicar uno nuevo,
            // ClosePastBudgetsAsync pasa todos los anteriores a Closed). Filtrar sólo por
            // Active mostraba nada más el mes vigente, aunque los meses ya cerrados también
            // tienen cuotas reales y recaudación real para reportar. Created/Check/Approved/
            // Rejected sí quedan afuera -- esos todavía no generaron ninguna cuota.
            var presupuestos = await BudgetService.GetPresupuestosAsync(idBuilding);
            var ordinarios = presupuestos
                .Where(p => string.IsNullOrEmpty(p.BudgetType) &&
                    (p.Status == BudgetStatus.Active || p.Status == BudgetStatus.Closed) &&
                    p.BudgetDate.Date >= fechaDesde.Date && p.BudgetDate.Date <= fechaHasta.Date)
                .OrderBy(p => p.BudgetDate)
                .ToList();

            var filas = new List<FilaRecaudacion>();
            foreach (var presupuesto in ordinarios)
            {
                // Presupuesto/Recaudado/Dif se calculan los tres a partir de las MISMAS
                // cuotas que lee el reporte de Morosidad (GetInstallmentsByBudgetAsync),
                // no de BudgetHeader.Amount -- ese campo se graba una vez al generar el
                // presupuesto y puede no reflejar ajustes posteriores a las cuotas
                // individuales (exoneraciones, correcciones), lo que hacía que "Dif" acá
                // no cuadrara con "Deuda" en Morosidad para el mismo periodo. Dif usa
                // Installment.Debt (no Presupuesto - Recaudado) por el mismo motivo: es
                // el campo que de verdad se decrementa al aplicar pagos parciales
                // (IInstallmentService.cs:275/313/351), no necesariamente idéntico a
                // Amount - AmountPaid en todos los casos (redondeo, cargos parciales).
                var cuotas = await InstallmentService.GetInstallmentsByBudgetAsync(presupuesto.IdBudgetHeader);
                var montoPresupuesto = cuotas.Sum(c => c.Amount);
                var recaudado = cuotas.Sum(c => c.AmountPaid);
                var deuda = cuotas.Sum(c => c.Debt);

                // Deudores de este presupuesto -- mismas cuotas ya traídas arriba, sin pedir
                // nada nuevo a la BD. Pedido explícito del usuario: qué DPTO(s) explican el
                // "Dif" de cada periodo.
                var deudores = cuotas
                    .Where(c => c.Debt > 0)
                    .GroupBy(c => new { c.IdGroupUnit, c.UnitName, c.OwnerName })
                    .Select(g => new DeudorFila
                    {
                        UnitName = g.Key.UnitName,
                        OwnerName = g.Key.OwnerName,
                        Deuda = g.Sum(c => c.Debt),
                        Cuotas = g.Count()
                    })
                    .OrderByDescending(d => d.Deuda)
                    .ToList();

                filas.Add(new FilaRecaudacion
                {
                    Periodo = $"{presupuesto.Year:D4}-{presupuesto.Month:D2}",
                    Nombre = presupuesto.BudgetName,
                    Presupuesto = montoPresupuesto,
                    Recaudado = recaudado,
                    Diferencia = deuda,
                    Deudores = deudores
                });
            }

            _filas = filas;
            // La fila seleccionada (por Periodo) puede ya no existir tras recargar con otro
            // rango de fechas -- si sigue estando, mantenerla seleccionada en vez de perder
            // el detalle que el usuario ya estaba mirando.
            _filaSeleccionada = _filaSeleccionada == null
                ? null
                : _filas.FirstOrDefault(f => f.Periodo == _filaSeleccionada.Periodo);
        }
        finally
        {
            cargando = false;
        }

        StateHasChanged();
        _debeRedibujarGrafico = _filas.Any();
    }

    private string Moneda(decimal valor) => valor.FormatoMoneda(ParameterService.CurrentBuilding?.Configuration.Currency);

    private async Task RenderizarGraficoAsync()
    {
        if (!_filas.Any()) return;

        var labels = _filas.Select(f => f.Periodo).ToArray();
        var datasets = new[]
        {
            new { label = "Presupuesto", data = _filas.Select(f => f.Presupuesto).ToArray(), color = "rgba(31, 78, 121, 0.85)" },
            new { label = "Recaudado", data = _filas.Select(f => f.Recaudado).ToArray(), color = "rgba(237, 125, 49, 0.85)" }
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("spiderHoodReportCharts.groupedBar", "chartRecaudacion", labels, datasets, TituloGrafico);
        }
        catch (JSDisconnectedException)
        {
            // Circuito cerrándose (navegación afuera de la página) -- nada que hacer.
        }
        catch (InvalidOperationException)
        {
            // Prerender estático -- ver el comentario equivalente en
            // DelinquencyReport.razor.RenderizarGraficoAsync. OnAfterRenderAsync(firstRender)
            // reintenta ya con el circuito real conectado.
        }
    }

    private void SeleccionarFila(FilaRecaudacion fila)
    {
        _filaSeleccionada = fila == _filaSeleccionada ? null : fila;
    }

    private async Task ExportarExcel()
    {
        if (ParameterService.CurrentBuilding == null || !_filas.Any()) return;

        using var workbook = new XLWorkbook();
        var ws = workbook.Worksheets.Add("Recaudación");

        ws.Cell(1, 1).Value = "Periodo";
        ws.Cell(1, 2).Value = "Nombre";
        ws.Cell(1, 3).Value = "Presupuesto";
        ws.Cell(1, 4).Value = "Recaudado";
        ws.Cell(1, 5).Value = "Dif";
        ws.Row(1).Style.Font.Bold = true;

        var fila = 2;
        foreach (var f in _filas)
        {
            ws.Cell(fila, 1).Value = f.Periodo;
            ws.Cell(fila, 2).Value = f.Nombre;
            ws.Cell(fila, 3).Value = f.Presupuesto;
            ws.Cell(fila, 4).Value = f.Recaudado;
            ws.Cell(fila, 5).Value = f.Diferencia;
            fila++;
        }
        ws.Cell(fila, 1).Value = "TOTAL";
        ws.Cell(fila, 3).Value = _filas.Sum(f => f.Presupuesto);
        ws.Cell(fila, 4).Value = _filas.Sum(f => f.Recaudado);
        ws.Cell(fila, 5).Value = _filas.Sum(f => f.Diferencia);
        ws.Row(fila).Style.Font.Bold = true;
        ws.Columns().AdjustToContents();

        using var ms = new MemoryStream();
        workbook.SaveAs(ms);

        var fileName = $"Recaudacion_{ParameterService.CurrentBuilding.Name}_{DateTime.Now:yyyyMMdd}.xlsx";
        await JSRuntime.InvokeVoidAsync("descargarArchivo", fileName, Convert.ToBase64String(ms.ToArray()));
    }

    private class FilaRecaudacion
    {
        public string Periodo = "";
        public string Nombre = "";
        public decimal Presupuesto;
        public decimal Recaudado;
        public decimal Diferencia;
        public List<DeudorFila> Deudores = new();
    }

    private class DeudorFila
    {
        public string UnitName = "";
        public string OwnerName = "";
        public decimal Deuda;
        public int Cuotas;
    }
}
