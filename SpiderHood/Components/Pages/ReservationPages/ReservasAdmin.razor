@page "/reservas-admin"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Components.Pages.Components
@inject Services.AuthService AuthService
@inject Services.IPermissionService PermissionService
@inject Services.IAreaComunService AreaComunService
@inject Services.IReservaService ReservaService
@inject Services.IBuildingService BuildingService
@inject Services.ParameterService ParameterService

<PageTitle>Gestión de Reservas</PageTitle>

@if (_loading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!_canGestionar && !_canAprobar)
{
    <div class="container-fluid px-4 py-3">
        <div class="alert alert-danger">
            <i class="bi bi-shield-lock me-1"></i>
            No tenés permiso para gestionar ni aprobar Reservas en este edificio.
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="page-header mb-4">
            <div class="page-header-title">
                <div class="icon-badge">
                    <i class="bi bi-clipboard-check"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Gestión de Reservas</h1>
                    <p class="text-muted mb-0">Aprobación, check-in, check-out y liquidación de garantía de las reservas de áreas comunes.</p>
                </div>
            </div>
            @if (_canGestionar && _areasComunes.Any())
            {
                <div class="page-header-actions">
                    <button class="btn btn-primary" @onclick="AbrirNuevaReserva">
                        <i class="bi bi-plus-lg me-1"></i>Nueva Reserva
                    </button>
                </div>
            }
        </div>

        @if (_resultado is not null)
        {
            <div class="alert @(_resultadoOk ? "alert-success" : "alert-danger") alert-dismissible fade show">
                @_resultado
                <button type="button" class="btn-close" @onclick="() => _resultado = null"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h6 class="mb-0">Todas las Reservas</h6>
                    <div style="min-width: 220px;">
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Buscar por área o propietario..."
                               value="@_searchTerm"
                               @oninput="OnSearch" />
                    </div>
                </div>
                @if (_pagination.TotalRecords > 0)
                {
                    <p class="text-muted small mb-0 mt-1">
                        Mostrando @_pagination.StartRecord - @_pagination.EndRecord de @_pagination.TotalRecords reserva(s)
                    </p>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Área Común</th>
                            <th>Unidad</th>
                            <th>Fecha/Hora</th>
                            <th>Estado</th>
                            <th style="width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reserva in _pagination.CurrentPageData)
                        {
                            <tr>
                                <td>@reserva.NombreAreaComun</td>
                                <td>@GetGroupUnitName(reserva.IdGroupUnit)</td>
                                <td>@reserva.FechaInicio.ToString("dd/MM/yyyy HH:mm") - @reserva.FechaFin.ToString("HH:mm")</td>
                                <td>
                                    @EtiquetaEstado(reserva)
                                    @if (reserva.Estado is ReservaEstado.Aprobada or ReservaEstado.Entregada or ReservaEstado.Finalizada && reserva.PagoConfirmado)
                                    {
                                        <span class="badge bg-success ms-1" title="Pago confirmado">💰</span>
                                    }
                                </td>
                                <td>
                                    @if (_canAprobar && reserva.Estado == ReservaEstado.PendienteDeAprobacion)
                                    {
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => PedirAprobar(reserva)">
                                            <i class="bi bi-check-lg me-1"></i>Aprobar
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirRechazar(reserva)">
                                            <i class="bi bi-x-lg me-1"></i>Rechazar
                                        </button>
                                    }
                                    @if (_canGestionar && reserva.Estado == ReservaEstado.Aprobada && !reserva.PagoConfirmado)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => AbrirConfirmarPago(reserva)">
                                            <i class="bi bi-cash-coin me-1"></i>Confirmar Pago
                                        </button>
                                    }
                                    else if (_canGestionar && reserva.Estado == ReservaEstado.Aprobada)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirCheckIn(reserva)">
                                            <i class="bi bi-box-arrow-in-right me-1"></i>Check-in
                                        </button>
                                    }
                                    else if (_canGestionar && reserva.Estado == ReservaEstado.Entregada)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => AbrirCheckOut(reserva)">
                                            <i class="bi bi-box-arrow-left me-1"></i>Check-out
                                        </button>
                                    }
                                    else if (_canGestionar && (reserva.Estado == ReservaEstado.Finalizada || reserva.Estado is ReservaEstado.Cancelada or ReservaEstado.NoPresentado))
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => AbrirCerrar(reserva)">
                                            <i class="bi bi-shield-check me-1"></i>Cerrar
                                        </button>
                                    }
                                    @if (_canGestionar && reserva.IdCalendarItem == null && reserva.Estado is ReservaEstado.PendienteDeAprobacion or ReservaEstado.Aprobada or ReservaEstado.Entregada or ReservaEstado.Finalizada)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary ms-1" title="No aparece en el Calendario -- sincronizar" @onclick="() => SincronizarCalendario(reserva)">
                                            <i class="bi bi-calendar-plus"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!_pagination.CurrentPageData.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    @(string.IsNullOrWhiteSpace(_searchTerm) ? "No hay reservas todavía." : "Ninguna reserva coincide con la búsqueda.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_pagination.TotalPages > 1)
            {
                <div class="card-footer bg-transparent border-top py-3">
                    <PaginationControls _pagination="@_pagination" />
                </div>
            }
        </div>
    </div>

    <ConfirmationModal @ref="_confirmationModal" OnClose="OnAprobarConfirmado" />
    <RejectionModal @ref="_rejectionModal"
                    Title="Rechazar Reserva"
                    Message="El propietario ve la reserva como Rechazada, con el motivo indicado."
                    OnClose="OnRechazarConfirmado" />

    <!-- Modal: Check-in / Check-out -->
    <Modal @ref="_checklistModal" Title="@(_etapaChecklist == ChecklistEtapa.Entrega ? "Check-in" : "Check-out")" Size="ModalSize.Large"
           UseStaticBackdrop="true" CloseOnEscape="false">
        <BodyTemplate>
            @if (_errorModal is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @_errorModal
                    <button type="button" class="btn-close" @onclick="() => _errorModal = null"></button>
                </div>
            }
            @if (_reservaSeleccionada != null)
            {
                <p class="text-muted small">
                    @_reservaSeleccionada.NombreAreaComun -- @_reservaSeleccionada.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                </p>

                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-5">
                        <label class="form-label small">Ítem</label>
                        <input class="form-control form-control-sm" @bind="_nuevoItemDescripcion" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Estado</label>
                        <select class="form-select form-select-sm" @bind="_nuevoItemEstado">
                            <option value="@ChecklistEstado.Ok">OK</option>
                            <option value="@ChecklistEstado.Danado">Dañado</option>
                            <option value="@ChecklistEstado.Falta">Falta</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Observación</label>
                        <input class="form-control form-control-sm" @bind="_nuevoItemObservacion" @bind:event="oninput" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-sm btn-outline-primary w-100" @onclick="AgregarItemChecklist">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                </div>

                @if (_checklistItems.Any())
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in _checklistItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                <span>
                                    <strong>@item.Descripcion</strong> -- @EtiquetaChecklistEstado(item.Estado)
                                    @if (!string.IsNullOrWhiteSpace(item.Observacion))
                                    {
                                        <span class="text-muted small"> (@item.Observacion)</span>
                                    }
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _checklistItems.Remove(item)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </li>
                        }
                    </ul>
                }

                <div class="mb-2">
                    <label class="form-label small">Fotos</label>
                    <InputFile OnChange="SeleccionarFotos" multiple accept="image/*" class="form-control form-control-sm" />
                </div>
                @if (_fotosStaged.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var foto in _fotosStaged)
                        {
                            <span class="badge bg-secondary">@foto.FileName</span>
                        }
                    </div>
                }
            }
        </BodyTemplate>
        <FooterTemplate>
            <button class="btn btn-primary" @onclick="ConfirmarChecklist" disabled="@_procesando">
                @if (_procesando)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Confirmar @(_etapaChecklist == ChecklistEtapa.Entrega ? "Check-in" : "Check-out")
            </button>
            <button class="btn btn-secondary" @onclick="() => _checklistModal.HideAsync()">Cancelar</button>
        </FooterTemplate>
    </Modal>

    <!-- Modal: Cerrar reserva / liquidar garantía -->
    <Modal @ref="_cerrarModal" Title="Cerrar Reserva" Size="ModalSize.Regular" UseStaticBackdrop="true" CloseOnEscape="false">
        <BodyTemplate>
            @if (_errorModal is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @_errorModal
                    <button type="button" class="btn-close" @onclick="() => _errorModal = null"></button>
                </div>
            }
            @if (_reservaSeleccionada != null)
            {
                <p class="text-muted small">
                    @_reservaSeleccionada.NombreAreaComun -- @_reservaSeleccionada.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                </p>
                <p>Garantía: @Moneda(_reservaSeleccionada.MontoGarantia)</p>

                @if (_reservaSeleccionada.Estado == ReservaEstado.Finalizada)
                {
                    <div class="mb-3">
                        <label class="form-label">Monto de daño encontrado en el check-out (si hubo)</label>
                        <input type="number" step="0.01" class="form-control" @bind="_montoDanio" />
                        <div class="form-text">Si el daño supera la garantía, se genera automáticamente una cuota extraordinaria por la diferencia a la unidad responsable.</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning small mb-0">
                        Esta reserva quedó @(_reservaSeleccionada.Estado == ReservaEstado.Cancelada ? "Cancelada" : "como No Presentada") -- se liquida la garantía según la penalidad ya aplicada, sin cobrar Alquiler/Limpieza.
                    </div>
                }
            }
        </BodyTemplate>
        <FooterTemplate>
            <button class="btn btn-primary" @onclick="ConfirmarCerrar" disabled="@_procesando">
                @if (_procesando)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Cerrar Reserva
            </button>
            <button class="btn btn-secondary" @onclick="() => _cerrarModal.HideAsync()">Cancelar</button>
        </FooterTemplate>
    </Modal>

    <!-- Modal: Nueva Reserva -- el Administrador la carga en nombre de una unidad (ej.
         alguien llamó a pedir el área para un evento externo) -- misma lógica de
         SolicitarAsync que /reservas, pero acá se elige la unidad responsable en vez de
         resolverla del usuario actual. -->
    <Modal @ref="_nuevaReservaModal" Title="Nueva Reserva" Size="ModalSize.Large" UseStaticBackdrop="true" CloseOnEscape="false">
        <BodyTemplate>
            @if (_errorModal is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @_errorModal
                    <button type="button" class="btn-close" @onclick="() => _errorModal = null"></button>
                </div>
            }
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Área Común *</label>
                    <select class="form-select" value="@_areaSeleccionada?.IdAreaComun" @onchange="OnAreaChanged">
                        @foreach (var area in _areasComunes)
                        {
                            <option value="@area.IdAreaComun">@area.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Unidad Responsable *</label>
                    <select class="form-select" @bind="_nuevaReserva.IdGroupUnit">
                        <option value="@Guid.Empty">Seleccionar unidad...</option>
                        @foreach (var unidad in _unidades)
                        {
                            <option value="@unidad.IdGroupUnit">DPTO @unidad.UnitNumber</option>
                        }
                    </select>
                </div>
            </div>

            @if (_areaSeleccionada != null)
            {
                <div class="alert alert-light border small mb-3">
                    <div>Garantía: @Moneda(_areaSeleccionada.GarantiaInternos) (propietario) / @Moneda(_areaSeleccionada.GarantiaExternos) (externo)</div>
                    <div>Alquiler: @Moneda(_areaSeleccionada.AlquilerInternos) (propietario) / @Moneda(_areaSeleccionada.AlquilerExternos) (externo)</div>
                </div>

                @if (_proximasReservas.Any())
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted">Próximas reservas de esta área (referencia)</label>
                        <ul class="list-group list-group-flush small">
                            @foreach (var proxima in _proximasReservas)
                            {
                                <li class="list-group-item px-0 py-1">@proxima.FechaInicio.ToString("dd/MM HH:mm") - @proxima.FechaFin.ToString("dd/MM HH:mm")</li>
                            }
                        </ul>
                    </div>
                }
            }

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Fecha/Hora de Inicio *</label>
                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_nuevaReserva.FechaInicio" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha/Hora de Fin *</label>
                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_nuevaReserva.FechaFin" class="form-control" />
                </div>
            </div>

            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="_nuevaReserva.EsExterno" class="form-check-input" id="esExternoAdmin" />
                <label class="form-check-label" for="esExternoAdmin">Es para un evento con organizador externo (no propietario)</label>
            </div>

            @if (_nuevaReserva.EsExterno)
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Nombre del Organizador</label>
                        <InputText @bind-Value="_nuevaReserva.OrganizadorNombre" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Documento</label>
                        <InputText @bind-Value="_nuevaReserva.OrganizadorDocumento" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Teléfono</label>
                        <InputText @bind-Value="_nuevaReserva.OrganizadorTelefono" class="form-control" />
                    </div>
                </div>
            }
        </BodyTemplate>
        <FooterTemplate>
            <button class="btn btn-primary" @onclick="ConfirmarNuevaReserva" disabled="@(_procesando || _areaSeleccionada == null || _nuevaReserva.IdGroupUnit == Guid.Empty)">
                @if (_procesando)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="bi bi-send me-1"></i>Registrar Reserva
            </button>
            <button class="btn btn-secondary" @onclick="() => _nuevaReservaModal.HideAsync()">Cancelar</button>
        </FooterTemplate>
    </Modal>

    <!-- Modal: Confirmar Pago -- no hay pasarela de pago ni conciliación bancaria
         conectada (Docs/Pendientes-Negocio-Consolidado.md #21, "Cobro"); esto es
         un check manual del Administrador antes de habilitar el check-in. -->
    <Modal @ref="_confirmarPagoModal" Title="Confirmar Pago" Size="ModalSize.Regular" UseStaticBackdrop="true" CloseOnEscape="false">
        <BodyTemplate>
            @if (_errorModal is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @_errorModal
                    <button type="button" class="btn-close" @onclick="() => _errorModal = null"></button>
                </div>
            }
            @if (_reservaSeleccionada != null)
            {
                <p class="text-muted small">
                    @_reservaSeleccionada.NombreAreaComun -- @_reservaSeleccionada.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                </p>
                <p class="text-muted small">
                    Garantía + Alquiler + Limpieza: <strong>@Moneda(_reservaSeleccionada.MontoGarantia + _reservaSeleccionada.MontoAlquiler + _reservaSeleccionada.MontoLimpieza)</strong>
                </p>

                <div class="mb-3">
                    <label class="form-label">Monto recibido</label>
                    <input type="number" step="0.01" class="form-control" @bind="_montoPagoConfirmado" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Fecha del pago</label>
                    <InputDate Type="InputDateType.Date" @bind-Value="_fechaPagoConfirmado" class="form-control" />
                </div>
                <div class="alert alert-light border small mb-0">
                    Esto sólo queda registrado en la Reserva -- no valida nada contra una
                    cuenta bancaria real ni la Conciliación existente.
                </div>
            }
        </BodyTemplate>
        <FooterTemplate>
            <button class="btn btn-primary" @onclick="ConfirmarPago" disabled="@_procesando">
                @if (_procesando)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="bi bi-check-lg me-1"></i>Confirmar Pago
            </button>
            <button class="btn btn-secondary" @onclick="() => _confirmarPagoModal.HideAsync()">Cancelar</button>
        </FooterTemplate>
    </Modal>
}
