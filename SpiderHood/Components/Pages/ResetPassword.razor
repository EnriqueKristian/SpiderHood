@page "/reset-password"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject IPasswordResetService PasswordResetService

<PageTitle>SpiderHood - Nueva contraseña</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 L12 21 M4 7 L20 7 M4 17 L20 17 M6 4 L18 20 M18 4 L6 20" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.55" />
                    <path d="M12 12 L12 5.2 M12 12 L18.2 8.6 M12 12 L18.2 15.4 M12 12 L12 18.8 M12 12 L5.8 15.4 M12 12 L5.8 8.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                    <path d="M12 5.2 L15.4 6.6 L18.2 8.6 L19.4 12 L18.2 15.4 L15.4 17.4 L12 18.8 L8.6 17.4 L5.8 15.4 L4.6 12 L5.8 8.6 L8.6 6.6 Z" stroke="currentColor" stroke-width="1.1" opacity="0.6" fill="none" />
                </svg>
                <h2>SpiderHood</h2>
            </div>
            <p class="text-muted">Elegí tu nueva contraseña</p>
        </div>

        <div class="login-body">
            @if (string.IsNullOrEmpty(userId) || string.IsNullOrEmpty(token))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>Enlace inválido. Volvé a solicitar el restablecimiento de tu contraseña.
                </div>
                <div class="text-center mt-3">
                    <a href="/forgot-password" class="text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Solicitar enlace
                    </a>
                </div>
            }
            else if (submitted)
            {
                @if (success)
                {
                    <div class="alert alert-success" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@resultMessage
                    </div>
                    <div class="text-center mt-3">
                        <a href="/login" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@resultMessage
                    </div>
                    <div class="text-center mt-3">
                        <a href="/forgot-password" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Solicitar un enlace nuevo
                        </a>
                    </div>
                }
            }
            else
            {
                <EditForm Model="@model" OnValidSubmit="@HandleSubmit" FormName="resetPasswordForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="form-group mb-3">
                        <label for="newPassword" class="form-label">
                            <i class="bi bi-lock me-2"></i>Nueva contraseña
                        </label>
                        <InputText id="newPassword" type="password" class="form-control" @bind-Value="model.NewPassword" placeholder="••••••••" disabled="@isSubmitting" />
                        <ValidationMessage For="@(() => model.NewPassword)" />
                    </div>

                    <div class="form-group mb-4">
                        <label for="confirmPassword" class="form-label">
                            <i class="bi bi-lock me-2"></i>Confirmar contraseña
                        </label>
                        <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="model.ConfirmPassword" placeholder="••••••••" disabled="@isSubmitting" />
                        <ValidationMessage For="@(() => model.ConfirmPassword)" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-check2 me-2"></i>
                        <span>Restablecer contraseña</span>
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? userId { get; set; }

    [SupplyParameterFromQuery]
    public string? token { get; set; }

    private ResetPasswordModel model = new();
    private bool isSubmitting = false;
    private bool submitted = false;
    private bool success = false;
    private string resultMessage = string.Empty;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            var result = await PasswordResetService.ResetPasswordAsync(userId!, token!, model.NewPassword);
            success = result.Success;
            resultMessage = result.Message;
            submitted = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
