@page "/MyAnnouncements"
@rendermode InteractiveServer
@using SpiderHood.Models
@inject Services.AuthService AuthService
@inject Services.IComunicadoService ComunicadoService
@inject Services.ParameterService ParameterService

<PageTitle>Comunicados - SpiderHood</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="page-header mb-4">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-bell"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Comunicados</h1>
                <p class="text-muted mb-0">Avisos del edificio -- generales, de tu rol, o dirigidos a tu unidad.</p>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (!_comunicados.Any())
    {
        <div class="empty-state text-center text-muted py-5">
            <i class="bi bi-bell-slash" style="font-size: 3rem;"></i>
            <h5 class="mt-3">No hay comunicados todavía</h5>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var comunicado in _comunicados)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <span class="badge bg-secondary mb-2">@ParameterService.GetChildParameterDescription(_idCategoriaComunicado, comunicado.IdCategoria)</span>
                                <h5 class="card-title mb-1">@comunicado.Titulo</h5>
                            </div>
                            <span class="text-muted small">@comunicado.CreatedOn.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <p class="card-text mb-1" style="white-space: pre-wrap;">@comunicado.Cuerpo</p>
                        <p class="text-muted small mb-0">Publicado por @comunicado.CreatedByName</p>
                    </div>
                </div>
            }
        </div>
    }
</div>
