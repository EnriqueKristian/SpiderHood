@page "/MyPayments"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@using SpiderHood.Components.Pages.Components
@inject Services.AuthService AuthService
@inject Services.IInstallmentService InstallmentService
@inject Services.IBudgetService BudgetService
@inject Services.IServiceReadingService ServiceReadingService
@inject Services.IBankAccountService BankAccountService
@inject ParameterService ParameterService

<PageTitle>Mis Pagos - SpiderHood</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="page-header mb-4">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Mis Pagos</h1>
                <p class="text-muted mb-0">Consulta los depósitos que hiciste y cómo se aplicaron a tus cuotas</p>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_unitId == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Tu cuenta todavía no tiene una unidad vinculada en este edificio. Pedile al
            administrador que te la asigne en <em>Configuración &gt; Asignación de Roles</em>.
        </div>
    }
    else
    {
        <!-- Resumen -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card card-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Nro. de Depósitos</h6>
                                <h2 class="mb-0">@_pagosAgrupados.Count</h2>
                            </div>
                            <div style="color: #3b82f6;">
                                <i class="bi bi-receipt-cutoff" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Total Depositado</h6>
                                <h2 class="mb-0">@Moneda(_pagosAgrupados.Sum(p => p.MontoDeposito))</h2>
                            </div>
                            <div style="color: #10b981;">
                                <i class="bi bi-check-circle" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Último Pago</h6>
                                @{
                                    var ultimo = _pagosAgrupados.OrderByDescending(p => p.Fecha).FirstOrDefault();
                                }
                                <h2 class="mb-0">@(ultimo == null ? "—" : ultimo.Fecha.ToString("dd/MM/yy"))</h2>
                            </div>
                            <div style="color: #f59e0b;">
                                <i class="bi bi-calendar-event" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                @{
                    var totalSaldoAFavor = _pagosAgrupados.Sum(p => p.SaldoAFavor);
                }
                <div class="card card-hover h-100 @(totalSaldoAFavor > 0 ? "border-success" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Saldo a Favor</h6>
                                <h2 class="mb-0 @(totalSaldoAFavor > 0 ? "text-success" : "")">@Moneda(totalSaldoAFavor)</h2>
                            </div>
                            <div style="color: #10b981;">
                                <i class="bi bi-piggy-bank" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroPeriodoChanged">
                    <option value="">Todos los periodos</option>
                    @foreach (var periodo in PeriodosDisponibles())
                    {
                        <option value="@periodo.ToString("yyyy-MM-dd")" selected="@(_filtroPeriodo == periodo)">
                            @periodo.ToString("MMM-yy")
                        </option>
                    }
                </select>

                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroTipoChanged">
                    <option value="todos" selected="@(_filtroTipo == "todos")">Todos los tipos</option>
                    <option value="total" selected="@(_filtroTipo == "total")">Pago total</option>
                    <option value="parcial" selected="@(_filtroTipo == "parcial")">Pago parcial</option>
                </select>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="search-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control form-control-sm" style="min-width:220px;"
                           placeholder="Buscar por monto..."
                           value="@_filtroMonto"
                           @oninput="OnFiltroMontoInput" />
                </div>
                <label class="text-muted mb-0 ms-2">Mostrar:</label>
                <select class="form-select form-select-sm" style="width: auto;"
                        @onchange="(e) => _pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                    <option value="10" selected="@(_pagination.PageSize == 10)">10</option>
                    <option value="25" selected="@(_pagination.PageSize == 25)">25</option>
                    <option value="50" selected="@(_pagination.PageSize == 50)">50</option>
                    <option value="100" selected="@(_pagination.PageSize == 100)">100</option>
                </select>
            </div>
        </div>

        @if (!_pagination.AllData.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Todavía no se registran pagos aplicados a tu unidad en este edificio.
            </div>
        }
        else if (!_pagination.FilteredData.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-search me-2"></i>
                No se encontraron pagos con los filtros aplicados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th class="d-none d-md-table-cell">Descripción</th>
                            <th class="text-end">Monto del Depósito</th>
                            <th class="d-none d-md-table-cell">Aplicado a</th>
                            <th class="text-end">Saldo a Favor</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pago in _pagination.CurrentPageData)
                        {
                            <tr>
                                <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="d-none d-md-table-cell">@pago.Descripcion</td>
                                <td class="text-end fw-bold text-success">@Moneda(pago.MontoDeposito)</td>
                                <td class="d-none d-md-table-cell">
                                    @foreach (var aplicacion in pago.Aplicaciones)
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">
                                            @aplicacion.Period.ToString("MMM-yy")
                                            @(aplicacion.IsPartialPayment ? " (parcial)" : "")
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (pago.SaldoAFavor > 0)
                                    {
                                        <span class="badge bg-success">@Moneda(pago.SaldoAFavor)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetallePago(pago)">
                                        <i class="bi bi-eye me-1"></i>Ver Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_pagination.TotalPages > 1)
            {
                <PaginationControls _pagination="@_pagination" />
            }
        }
    }
</div>

<!-- Detalle de un depósito: mismo contenido que "Cuotas asociadas al pago" en
     ReconciliationWorkspace.razor/MovementPages/Index.razor -- de un solo click, el
     propietario ve el monto real que depositó y cómo se repartió entre sus cuotas
     (y si quedó algo sin aplicar, su saldo a favor). -->
@if (_pagoSeleccionado != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-eye me-2"></i>Cuotas asociadas al pago</h5>
                    <button type="button" class="btn-close" @onclick="() => _pagoSeleccionado = null"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Fecha:</dt>
                        <dd class="col-sm-8">@_pagoSeleccionado.Fecha.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-sm-4">Descripción:</dt>
                        <dd class="col-sm-8">@_pagoSeleccionado.Descripcion</dd>
                        <dt class="col-sm-4">Monto:</dt>
                        <dd class="col-sm-8 fw-bold text-success">@Moneda(_pagoSeleccionado.MontoDeposito)</dd>
                        <dt class="col-sm-4">Saldo a favor:</dt>
                        <dd class="col-sm-8 @(_pagoSeleccionado.SaldoAFavor > 0 ? "fw-bold text-success" : "")">@Moneda(_pagoSeleccionado.SaldoAFavor)</dd>
                    </dl>

                    <div class="list-group">
                        @foreach (var aplicacion in _pagoSeleccionado.Aplicaciones)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>
                                        <span class="fw-bold">Cuota @aplicacion.Period.ToString("MMM-yy")</span>
                                        @if (aplicacion.IsPartialPayment)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">Pago parcial</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success ms-2">Pago total de la cuota</span>
                                        }
                                    </span>
                                    <span class="fw-bold text-primary">@Moneda(aplicacion.Amount)</span>
                                </div>
                                <small class="text-muted d-block mb-2">
                                    Cuota @aplicacion.Period.ToString("MMM-yy"): @Moneda(aplicacion.InstallmentAmount)
                                    &middot; Pendiente de la cuota: @Moneda(Math.Max(aplicacion.InstallmentDebt, 0))
                                </small>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => VerCuota(aplicacion)">
                                    <i class="bi bi-eye me-1"></i>Ver Cuota
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<InstallmentDetailModal @ref="_detalleModal" />

@code {
    private string Moneda(decimal valor) => valor.FormatoMoneda(ParameterService.CurrentBuilding?.Configuration.Currency);

    // Un depósito real (un IdTransaction, la fila que el propietario ve en su estado de
    // cuenta) puede aplicarse a más de una cuota -- antes esta pantalla mostraba una fila
    // por CADA aplicación (InstallmentPaid), así que un solo depósito de S/ 247.67
    // repartido en dos cuotas aparecía como dos filas de S/ 32.09 y S/ 203.82 sin
    // ninguna forma de ver que en realidad eran UN solo pago. Se agrupa por IdTransaction
    // -- mismo criterio que "Cuotas asociadas al pago" en Conciliación/Movimientos.
    private class PagoAgrupado
    {
        public Guid IdTransaction { get; set; }
        public DateTime Fecha { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public decimal MontoDeposito { get; set; }
        public List<InstallmentPaid> Aplicaciones { get; set; } = new();
        public decimal TotalAplicado => Aplicaciones.Sum(a => a.Amount);
        public decimal SaldoAFavor => Math.Max(MontoDeposito - TotalAplicado, 0);
    }

    private bool _loading = true;
    private Guid? _unitId;
    private List<InstallmentPaid> _misPagos = new();
    // Se guarda para poder resolver la Installment completa en VerCuota (InstallmentDetailModal
    // necesita el objeto Installment, no solo el InstallmentPaid).
    private List<Installment> _misCuotas = new();
    private List<PagoAgrupado> _pagosAgrupados = new();
    private PaginationClass<PagoAgrupado> _pagination = new();

    private DateTime? _filtroPeriodo;
    private string _filtroTipo = "todos";
    private string _filtroMonto = string.Empty;

    private InstallmentDetailModal _detalleModal = null!;
    private PagoAgrupado? _pagoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        _pagination.OnPaginationChanged += StateHasChanged;
        _unitId = await AuthService.GetCurrentUnitIdAsync();
    }

    // ParameterService.CurrentBuilding lo resuelve HeaderMainLayout en SU PROPIO
    // OnAfterRenderAsync (necesita IJSRuntime para leer localStorage, no disponible
    // antes del primer render) -- un round-trip real, más lento que el resto del árbol
    // de componentes. Leerlo desde OnInitializedAsync (como estaba antes) siempre lo
    // encontraba en null en la primera carga real de un circuito (F5, login, cualquier
    // navegación nueva): la pantalla quedaba vacía y nunca reintentaba. Se reintenta en
    // cada re-render (HeaderMainLayout dispara StateHasChanged al resolver el edificio)
    // hasta que esté listo, con un tope para no dejar el spinner girando para siempre si
    // de verdad nunca se resuelve.
    private bool _dataLoaded = false;
    private int _renderAttempts = 0;
    private const int MaxRenderAttemptsBeforeGivingUp = 20;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dataLoaded) return;

        var edificioListo = ParameterService.CurrentBuilding != null && ParameterService.CurrentBuilding.IdBuilding != Guid.Empty;

        if (!edificioListo && _renderAttempts < MaxRenderAttemptsBeforeGivingUp)
        {
            _renderAttempts++;
            await Task.Delay(150);
            StateHasChanged();
            return;
        }

        _dataLoaded = true;
        await CargarPagosAsync();
        StateHasChanged();
    }

    private async Task CargarPagosAsync()
    {
        try
        {
            if (_unitId != null && ParameterService.CurrentBuilding != null)
            {
                // GetInstallmentsByBuildingAsync (no GetPendingInstallmentsAsync): necesitamos el
                // IdGroupUnit de TODAS las cuotas de mi unidad, sin importar su estado, para saber
                // a cuáles de mis cuotas corresponde cada InstallmentPaid -- las pendientes solas
                // no alcanzan (una cuota ya totalmente pagada desaparece de esa lista).
                var todasCuotas = await InstallmentService.GetInstallmentsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);
                _misCuotas = todasCuotas.Where(i => i.IdGroupUnit == _unitId).ToList();
                var misCuotaIds = _misCuotas.Select(i => i.IdInstallment).ToHashSet();

                var todosPagos = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
                _misPagos = todosPagos.Where(p => misCuotaIds.Contains(p.IdInstallment))
                    .OrderByDescending(p => p.PaymentDate)
                    .ToList();

                // Detalle del edificio completo (mismo método que usa Movimientos > Detalle) --
                // sólo para resolver Monto/Fecha/Descripción REALES del depósito por
                // IdTransaction; no hay un GET acotado a "mis transacciones" y el propio
                // filtro por misCuotaIds de arriba ya evita mostrar nada ajeno.
                var todasLasTransacciones = await BankAccountService.GetStatementDetailsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding, null);
                var transaccionesPorId = todasLasTransacciones.ToDictionary(t => t.IdStatementDetail, t => t);

                _pagosAgrupados = _misPagos
                    .GroupBy(p => p.IdTransaction)
                    .Select(g =>
                    {
                        transaccionesPorId.TryGetValue(g.Key, out var transaccion);
                        var aplicaciones = g.OrderBy(a => a.Period).ToList();
                        return new PagoAgrupado
                        {
                            IdTransaction = g.Key,
                            Fecha = transaccion?.StatementDate ?? aplicaciones.Min(a => a.PaymentDate),
                            Descripcion = transaccion?.Description ?? "Pago",
                            // Si no se encontró la transacción original (dato migrado, o el
                            // detalle bancario se borró), se usa lo aplicado como mejor estimado
                            // -- así el saldo a favor da 0 en vez de un número inventado.
                            MontoDeposito = transaccion != null ? Math.Abs(transaccion.Amount) : aplicaciones.Sum(a => a.Amount),
                            Aplicaciones = aplicaciones
                        };
                    })
                    .OrderByDescending(p => p.Fecha)
                    .ToList();

                _pagination.Initialize(_pagosAgrupados);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose() => _pagination.OnPaginationChanged -= StateHasChanged;

    private IEnumerable<DateTime> PeriodosDisponibles() =>
        _misPagos.Select(p => p.Period.Date).Distinct().OrderByDescending(p => p);

    private void OnFiltroPeriodoChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _filtroPeriodo = string.IsNullOrEmpty(value) ? null : DateTime.Parse(value);
        AplicarFiltros();
    }

    private void OnFiltroTipoChanged(ChangeEventArgs e)
    {
        _filtroTipo = e.Value?.ToString() ?? "todos";
        AplicarFiltros();
    }

    private void OnFiltroMontoInput(ChangeEventArgs e)
    {
        _filtroMonto = e.Value?.ToString() ?? string.Empty;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        _pagination.ApplyCustomFilter(item =>
            (_filtroPeriodo == null || item.Aplicaciones.Any(a => a.Period.Date == _filtroPeriodo.Value.Date))
            && _filtroTipo switch
            {
                "total" => item.Aplicaciones.Any(a => !a.IsPartialPayment),
                "parcial" => item.Aplicaciones.Any(a => a.IsPartialPayment),
                _ => true
            }
            && (string.IsNullOrWhiteSpace(_filtroMonto) || item.MontoDeposito.ToString("F2").Contains(_filtroMonto)));
    }

    private void VerDetallePago(PagoAgrupado pago) => _pagoSeleccionado = pago;

    private async Task VerCuota(InstallmentPaid pago)
    {
        var cuota = _misCuotas.FirstOrDefault(c => c.IdInstallment == pago.IdInstallment);
        if (cuota == null || ParameterService.CurrentBuilding == null) return;

        var budget = await BudgetService.GetBudgetByIdAsync(cuota.IdBudgetHeader);
        var waterReadings = await ServiceReadingService.GetServiceReadingDetailbyPeriodAsync(cuota.Period, ParameterService.CurrentBuilding!.IdBuilding);
        // Ver el mismo comentario y fix en MyReceipts.razor.VerDetalle.
        var exonerations = await BudgetService.GetExonerationsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

        await _detalleModal.ShowAsync(cuota, budget, waterReadings, exonerations);
    }
}
