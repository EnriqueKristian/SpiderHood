@page "/MyReceipts"
@rendermode InteractiveServer
@using System.Globalization
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@using SpiderHood.Components.Pages.Components
@inject Services.AuthService AuthService
@inject Services.IInstallmentService InstallmentService
@inject Services.IBankAccountService BankAccountService
@inject Services.IBudgetService BudgetService
@inject Services.IServiceReadingService ServiceReadingService
@inject Services.IBuildingService BuildingService
@inject Services.ICategoryService CategoryService
@inject Services.IExtraChargeService ExtraChargeService
@inject Services.IReceiptStorageService ReceiptStorageService
@inject ParameterService ParameterService
@inject IJSRuntime JSRuntime

<PageTitle>Mis Recibos - SpiderHood</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="page-header mb-4">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Mis Recibos</h1>
                <p class="text-muted mb-0">Consulta tus recibos, pagos y estado de cuenta</p>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_unitId == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Tu cuenta todavía no tiene una unidad vinculada en este edificio. Pedile al
            administrador que te la asigne en <em>Configuración &gt; Asignación de Roles</em>.
        </div>
    }
    else
    {
        @if (_saldoAFavor > 0.005m)
        {
            <div class="alert alert-success d-flex align-items-center" role="alert">
                <i class="bi bi-piggy-bank-fill fs-4 me-3"></i>
                <div>
                    <strong>Tienes un saldo a favor de @Moneda(_saldoAFavor).</strong>
                    Es un monto de un pago anterior que quedó sin aplicar a ninguna cuota. Coordina con la administración
                    para aplicarlo a tu próxima cuota pendiente.
                </div>
            </div>
        }

        <!-- Resumen -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card card-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Nro. de Recibos</h6>
                                <h2 class="mb-0">@_misCuotas.Count</h2>
                            </div>
                            <div style="color: #3b82f6;">
                                <i class="bi bi-receipt-cutoff" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Monto Deuda</h6>
                                <h2 class="mb-0">@Moneda(_misCuotas.Where(c => c.Status != ReconciliationType.Condonada).Sum(c => c.Debt))</h2>
                            </div>
                            <div style="color: #ef4444;">
                                <i class="bi bi-exclamation-circle" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Total Pagado</h6>
                                <h2 class="mb-0">@Moneda(_misCuotas.Sum(c => c.AmountPaid))</h2>
                            </div>
                            <div style="color: #10b981;">
                                <i class="bi bi-check-circle" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Próximo Vencimiento</h6>
                                @{
                                    var proximo = _misCuotas.Where(c => c.Debt > 0 && c.Status != ReconciliationType.Condonada).OrderBy(c => c.DueDate).FirstOrDefault();
                                }
                                @if (proximo == null)
                                {
                                    <h2 class="mb-0">Al día</h2>
                                }
                                else
                                {
                                    <h2 class="mb-0">@proximo.DueDate.ToString("dd/MM/yy")</h2>
                                }
                            </div>
                            <div style="color: #f59e0b;">
                                <i class="bi bi-calendar-event" style="font-size: 1.2rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Filtros -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroPeriodoChanged">
                    <option value="">Todos los periodos</option>
                    @foreach (var periodo in PeriodosDisponibles())
                    {
                        <option value="@periodo.ToString("yyyy-MM-dd")" selected="@(_filtroPeriodo == periodo)">
                            @periodo.ToString("MMM-yy")
                        </option>
                    }
                </select>

                <select class="form-select form-select-sm" style="width: auto;" @onchange="OnFiltroEstadoChanged">
                    <option value="todos" selected="@(_filtroEstado == "todos")">Todos los estados</option>
                    <option value="pendiente" selected="@(_filtroEstado == "pendiente")">Pendiente de Pago</option>
                    <option value="vencida" selected="@(_filtroEstado == "vencida")">Vencida</option>
                    <option value="parcial" selected="@(_filtroEstado == "parcial")">Parcial</option>
                    <option value="pagado" selected="@(_filtroEstado == "pagado")">Pagado</option>
                    <option value="condonada" selected="@(_filtroEstado == "condonada")">Condonada</option>
                </select>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="search-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control form-control-sm" style="min-width:260px;"
                           placeholder="Buscar por nombre, período, estado..."
                           value="@_searchTerm"
                           @oninput="OnSearchInput" />
                </div>
                <label class="text-muted mb-0 ms-2">Mostrar:</label>
                <select class="form-select form-select-sm" style="width: auto;"
                        @onchange="(e) => _pagination.ChangePageSize(Convert.ToInt32(e.Value))">
                    <option value="10" selected="@(_pagination.PageSize == 10)">10</option>
                    <option value="25" selected="@(_pagination.PageSize == 25)">25</option>
                    <option value="50" selected="@(_pagination.PageSize == 50)">50</option>
                    <option value="100" selected="@(_pagination.PageSize == 100)">100</option>
                </select>
            </div>
        </div>

        @if (!_pagination.AllData.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Todavía no hay recibos generados para tu unidad en este edificio.
            </div>
        }
        else if (!_pagination.FilteredData.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-search me-2"></i>
                No se encontraron recibos con los filtros aplicados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th role="button" @onclick='() => _pagination.SortByColumn("Name")'>
                                Recibo @_pagination.GetSortIndicator("Name")
                            </th>
                            <th class="d-none d-md-table-cell" role="button" @onclick='() => _pagination.SortByColumn("Period")'>
                                Período @_pagination.GetSortIndicator("Period")
                            </th>
                            <th role="button" @onclick='() => _pagination.SortByColumn("DueDate")'>
                                Vencimiento @_pagination.GetSortIndicator("DueDate")
                            </th>
                            <th class="text-end d-none d-md-table-cell" role="button" @onclick='() => _pagination.SortByColumn("Amount")'>
                                Monto @_pagination.GetSortIndicator("Amount")
                            </th>
                            <th class="text-end d-none d-md-table-cell" role="button" @onclick='() => _pagination.SortByColumn("AmountPaid")'>
                                Pagado @_pagination.GetSortIndicator("AmountPaid")
                            </th>
                            <th class="text-end" role="button" @onclick='() => _pagination.SortByColumn("Debt")'>
                                Deuda @_pagination.GetSortIndicator("Debt")
                            </th>
                            <th role="button" @onclick='() => _pagination.SortByColumn("Status")'>
                                Estado @_pagination.GetSortIndicator("Status")
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _pagination.CurrentPageData)
                        {
                            <tr>
                                <td>@ReceiptPagination.NombreRecibo(item)</td>
                                <td class="d-none d-md-table-cell">@item.Period.ToString("MMM-yy")</td>
                                <td>@item.DueDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end d-none d-md-table-cell">@Moneda(item.Amount)</td>
                                <td class="text-end d-none d-md-table-cell">@Moneda(item.AmountPaid)</td>
                                <td class="text-end">
                                    @if (item.Status == ReconciliationType.Condonada)
                                    {
                                        <span class="text-muted">@Moneda(0)</span>
                                    }
                                    else
                                    {
                                        <span class="@GetDeudaClass(item)">@Moneda(item.Debt)</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @EstadoBadgeClass(item)">@EstadoBadgeText(item)</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetalle(item)">
                                            <i class="bi bi-eye me-1"></i>Ver Detalle
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@(_generandoPdf == item.IdInstallment)" @onclick="() => DescargarPdf(item)">
                                            @if (_generandoPdf == item.IdInstallment)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            }
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_pagination.TotalPages > 1)
            {
                <PaginationControls _pagination="@_pagination" />
            }
        }
    }
</div>

@* OnImprimir wired al mismo botón "PDF" de la fila -- sin esto, el botón "Imprimir" del
   modal no hace nada (silencioso, ver InstallmentDetailModal.HandleImprimirClick). *@
<InstallmentDetailModal @ref="_detalleModal" OnImprimir="DescargarPdf" />

@code {
    private string Moneda(decimal valor) => valor.FormatoMoneda(ParameterService.CurrentBuilding?.Configuration.Currency);

    // Nombre del PDF descargado -- reportado por el usuario probando el APK real: el
    // fix de wwwroot/js/fileDownload.js ya evita que Android le ponga un GUID random,
    // pero ReceiptPagination.NombreRecibo por sí sola ("Recibo Marzo-2026 902") no
    // alcanza para distinguir edificios una vez que el PDF quedó suelto en el celular
    // (Descargas) -- un propietario con unidades en más de un edificio no puede saber
    // de cuál es solo mirando el nombre. Se antepone el edificio acá (en el archivo
    // descargado), no en NombreRecibo (que sigue usándose para la columna de la tabla
    // y el buscador, donde el edificio ya es obvio por el selector del header).
    private string NombreArchivoRecibo(Installment item)
    {
        var nombre = $"{ParameterService.CurrentBuilding?.Name} - {ReceiptPagination.NombreRecibo(item)}";
        foreach (var c in System.IO.Path.GetInvalidFileNameChars())
        {
            nombre = nombre.Replace(c, '-');
        }
        return nombre;
    }

    private bool _loading = true;
    private Guid? _unitId;
    private List<Installment> _misCuotas = new();
    private ReceiptPagination _pagination = new();
    private decimal _saldoAFavor;

    private string _searchTerm = string.Empty;
    private string _filtroEstado = "todos";
    private DateTime? _filtroPeriodo;

    // IdInstallment cuyo PDF se está generando ahora mismo -- deshabilita ese botón
    // puntual (VerDetalle) mientras dura, sin bloquear el resto de la tabla.
    private Guid? _generandoPdf;

    protected override async Task OnInitializedAsync()
    {
        _pagination.OnPaginationChanged += StateHasChanged;
        _unitId = await AuthService.GetCurrentUnitIdAsync();
    }

    // ParameterService.CurrentBuilding lo resuelve HeaderMainLayout en SU PROPIO
    // OnAfterRenderAsync (necesita IJSRuntime para leer localStorage, no disponible
    // antes del primer render) -- un round-trip real, más lento que el resto del árbol
    // de componentes. Leerlo desde OnInitializedAsync (como estaba antes) siempre lo
    // encontraba en null en la primera carga real de un circuito (F5, login, cualquier
    // navegación nueva): la pantalla quedaba vacía y nunca reintentaba. Se reintenta en
    // cada re-render (HeaderMainLayout dispara StateHasChanged al resolver el edificio)
    // hasta que esté listo, con un tope para no dejar el spinner girando para siempre si
    // de verdad nunca se resuelve.
    private bool _dataLoaded = false;
    private int _renderAttempts = 0;
    private const int MaxRenderAttemptsBeforeGivingUp = 20;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dataLoaded) return;

        var edificioListo = ParameterService.CurrentBuilding != null && ParameterService.CurrentBuilding.IdBuilding != Guid.Empty;

        if (!edificioListo && _renderAttempts < MaxRenderAttemptsBeforeGivingUp)
        {
            _renderAttempts++;
            await Task.Delay(150);
            StateHasChanged();
            return;
        }

        _dataLoaded = true;
        await CargarCuotasAsync();
        StateHasChanged();
    }

    private async Task CargarCuotasAsync()
    {
        try
        {
            if (_unitId != null && ParameterService.CurrentBuilding != null)
            {
                // Mismo fix que InstallmentList.razor.CargarCuotasAsync -- GetDistributionType
                // (columna Tipo de InstallmentDetailModal, ahora usado también acá para "Ver
                // Detalle") lee de ParameterService.ListParameters, que arranca vacía hasta que
                // alguna página llame a LoadParametersAsync. Sin esto, el modal mostraba "No se
                // encontró coincidencia" en vez de "Fija"/"%".
                await ParameterService.LoadParametersAsync(ParameterService.CurrentBuilding.IdBuilding);

                // GetInstallmentsByBuildingAsync (no GetPendingInstallmentsAsync): esta página
                // necesita poder filtrar por "Pagado" -- GetPendingInstallmentsAsync excluye las
                // cuotas Conciliada a nivel de SQL (Status <> 1), así que ese filtro nunca
                // mostraba nada y las cuotas ya pagadas ni siquiera llegaban a la lista general.
                var todas = await InstallmentService.GetInstallmentsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);
                _misCuotas = todas.Where(i => i.IdGroupUnit == _unitId).ToList();
                _pagination.Initialize(_misCuotas);
                await CalcularSaldoAFavorAsync();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    // Mismo cálculo que "Saldo sin aplicar" en Estados de Cuenta > Detalle (pantalla
    // admin, Index.razor) pero acotado a los pagos de ESTA unidad: de las transacciones
    // que alguna vez se aplicaron a una cuota de _misCuotas, ¿cuánto de su monto no se
    // usó en ninguna cuota? No cubre el caso (en investigación aparte, ver
    // Docs/Pendientes-Negocio-Conciliacion.md) de un pago que quedó con saldo asociado a
    // un IdGroupUnit histórico distinto al actual de la unidad -- ese saldo no aparece
    // acá porque GetInstallmentsPaidAsync lo asocia por Installment.IdGroupUnit, no por
    // esta unidad "actual".
    private async Task CalcularSaldoAFavorAsync()
    {
        if (ParameterService.CurrentBuilding == null || !_misCuotas.Any() || _unitId == null)
        {
            _saldoAFavor = 0;
            return;
        }

        var pagosCuotas = await InstallmentService.GetInstallmentsPaidAsync(ParameterService.CurrentBuilding.IdBuilding);
        var transacciones = await BankAccountService.GetStatementDetailsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding, null);

        _saldoAFavor = SaldoAFavorCalculator.CalcularNoAplicado(_unitId.Value, _misCuotas, pagosCuotas, transacciones);
    }

    public void Dispose() => _pagination.OnPaginationChanged -= StateHasChanged;

    private IEnumerable<DateTime> PeriodosDisponibles() =>
        _misCuotas.Select(i => i.Period.Date).Distinct().OrderByDescending(p => p);

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _pagination.Search(_searchTerm);
    }

    private void OnFiltroPeriodoChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _filtroPeriodo = string.IsNullOrEmpty(value) ? null : DateTime.Parse(value);
        AplicarFiltros();
    }

    private void OnFiltroEstadoChanged(ChangeEventArgs e)
    {
        _filtroEstado = e.Value?.ToString() ?? "todos";
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        _pagination.ApplyCustomFilter(item =>
            (_filtroPeriodo == null || item.Period.Date == _filtroPeriodo.Value.Date)
            && _filtroEstado switch
            {
                "pendiente" => item.Status == ReconciliationType.NoConciliada && item.DueDate.Date >= DateTime.Today,
                "vencida" => item.Status == ReconciliationType.NoConciliada && item.DueDate.Date < DateTime.Today,
                "parcial" => item.Status == ReconciliationType.Parcial,
                "pagado" => item.Status == ReconciliationType.Conciliada,
                "condonada" => item.Status == ReconciliationType.Condonada,
                _ => true
            });
    }

    private string GetDeudaClass(Installment item) => item.Debt > 0 ? "fw-bold text-danger" : "text-muted";

    private string EstadoBadgeClass(Installment item) => item.Status switch
    {
        ReconciliationType.Conciliada => "bg-success",
        ReconciliationType.Parcial => "bg-info text-dark",
        ReconciliationType.Condonada => "bg-secondary",
        _ => item.DueDate.Date < DateTime.Today ? "bg-danger" : "bg-warning text-dark"
    };

    private string EstadoBadgeText(Installment item) => item.Status switch
    {
        ReconciliationType.Conciliada => "Pagado",
        ReconciliationType.Parcial => "Parcial",
        ReconciliationType.Condonada => "Condonada",
        _ => item.DueDate.Date < DateTime.Today ? "Vencida" : "Pendiente de Pago"
    };

    // "Ver Detalle" (página/modal) y "PDF" (recibo impreso) son dos botones separados a
    // propósito -- una versión anterior los había fusionado en uno solo que abría
    // directamente el PDF, pero eso ocultaba justo el aviso de saldo a favor NO aplicado
    // (ver _saldoAFavor/CalcularSaldoAFavorAsync) detrás de un PDF que además tarda más en
    // generarse. "Ver Detalle" reusa el mismo InstallmentDetailModal que ya usa el admin en
    // /cuotas (InstallmentList.razor) -- mismo desglose, mismo aviso.
    private InstallmentDetailModal _detalleModal = null!;

    private async Task VerDetalle(Installment item)
    {
        if (ParameterService.CurrentBuilding == null) return;

        var budget = await BudgetService.GetBudgetByIdAsync(item.IdBudgetHeader);
        var waterReadings = await ServiceReadingService.GetServiceReadingDetailbyPeriodAsync(item.Period, ParameterService.CurrentBuilding.IdBuilding);
        var exonerations = await BudgetService.GetExonerationsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

        await _detalleModal.ShowAsync(item, budget, waterReadings, exonerations);
    }

    // Genera (o reusa, ver GetOrGenerateReceiptAsync) el mismo recibo PDF que ya usa
    // /cuotas y lo abre para VERLO (no fuerza la descarga) -- el propietario quiere ver el
    // recibo real, no solo un resumen en pantalla.
    private async Task DescargarPdf(Installment item)
    {
        if (ParameterService.CurrentBuilding == null || _generandoPdf != null) return;

        _generandoPdf = item.IdInstallment;
        try
        {
            var budget = await BudgetService.GetBudgetByIdAsync(item.IdBudgetHeader);
            var waterReadings = await ServiceReadingService.GetServiceReadingDetailbyPeriodAsync(item.Period, ParameterService.CurrentBuilding.IdBuilding);
            // GetExonerationByBudgetHeaderAsync lee de InstallmentExoneration, una tabla que
            // nada en el código escribe -- siempre vacía. Las excepciones son una
            // configuración viva del edificio (Edificio > Excepciones de Pago), no un
            // snapshot por presupuesto, así que se leen de ahí directamente.
            var exonerations = await BudgetService.GetExonerationsByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Igual que en /cuotas: refresca la configuración completa del edificio
            // (bancos/contactos/pie del recibo) antes de generar el PDF.
            ParameterService.CurrentBuilding.Configuration =
                await BuildingService.GetConfigurationAsync(ParameterService.CurrentBuilding.IdBuilding);

            var categorias = await BudgetService.GetCategoriesAsync(ParameterService.CurrentBuilding.IdBuilding);

            var cargosAdicionales = item.Type == InstallmentType.Ordinaria
                ? await ExtraChargeService.GetAdditionalChargesAsync(ParameterService.CurrentBuilding.IdBuilding, new List<Installment> { item })
                : new List<Installment>();

            // Deudas Anteriores: cuotas de periodos previos de esta misma unidad que
            // siguen sin conciliarse, igual que en "Ver Detalle" en pantalla.
            var deudasAnteriores = item.Type == InstallmentType.Ordinaria
                ? await InstallmentService.GetPendingInstallmentsAsync(ParameterService.CurrentBuilding.IdBuilding)
                : new List<Installment>();

            // Docs/Pendientes-Negocio-Consolidado.md #28 -- necesario para no
            // subestimar el desglose Fijo/Agua de cuotas que agrupan más de 1 unidad.
            var owners = await BuildingService.GetOwnersByBuildingAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Docs/Pendientes-Negocio-Consolidado.md #30, puntos d/e -- logo del
            // encabezado (Edificio o, de respaldo, Account) + nombre de la
            // administradora para la franja "Administrado por...".
            var (logoBytes, _, administradoraName) = await BuildingService.GetReceiptBrandingAsync(ParameterService.CurrentBuilding);

            var exportService = new InstallmentExportService(
                new List<Installment> { item },
                budget,
                waterReadings,
                exonerations,
                ParameterService.CurrentBuilding,
                categorias,
                owners,
                cargosAdicionales,
                deudasAnteriores,
                logoBytes,
                administradoraName,
                _saldoAFavor);

            // Docs/Pendientes-Negocio-Consolidado.md #18b -- si ya se generó antes,
            // sirve el mismo PDF guardado (no lo recalcula con la configuración
            // vigente hoy del edificio).
            var currentUser = await AuthService.GetCurrentUserAsync();
            var pdfBytes = await ReceiptStorageService.GetOrGenerateReceiptAsync(
                exportService, item, ParameterService.CurrentBuilding.IdBuilding, currentUser?.Email ?? "Sistema");

            await JSRuntime.InvokeVoidAsync("openPdfInNewTab",
                Convert.ToBase64String(pdfBytes),
                $"{NombreArchivoRecibo(item)}.pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar el recibo: {ex.Message}");
        }
        finally
        {
            _generandoPdf = null;
        }
    }
}