@* Shared/MenuItemNode.razor *@
@using SpiderHood.Models

@if (Item != null)
{
    <!-- Fila principal del nodo -->
    <tr class="menu-node-row @(IsPendingChange ? "pending-change" : "")">
        <!-- Columna de menú con indentación -->
        <td style="width: 40%;">
            <div class="menu-item-content">
                <!-- Indent según nivel - Usamos estilo inline para el nivel -->
                <span class="menu-indent" style="width: @(Level * 20)px;"></span>

                <!-- Expander para items con hijos -->
                @if (Item.Children?.Any() == true)
                {
                    <span class="expander-icon" @onclick="ToggleExpand">
                        <i class="fas @(IsExpanded ? "fa-chevron-down" : "fa-chevron-right")"></i>
                    </span>
                }
                else
                {
                    <span class="expander-icon">
                        <i class="fas fa-circle" style="font-size: 8px; color: #6c757d;"></i>
                    </span>
                }

                <!-- Icono del menú -->
                <i class="@Item.Icon"></i>

                <!-- Título y detalles -->
                <div>
                    <strong>@Item.Title</strong>
                    @if (!string.IsNullOrEmpty(Item.Url))
                    {
                        <small class="text-muted d-block">@Item.Url</small>
                    }
                </div>

                <!-- Badges -->
                <div class="badge-group">
                    @if (!Item.IsVisible)
                    {
                        <span class="badge bg-secondary">Oculto</span>
                    }
                    @if (Item.RequiredPermissions?.Any() == true)
                    {
                        <span class="badge bg-info">@Item.RequiredPermissions.Count permisos</span>
                    }
                    @if (!string.IsNullOrEmpty(Item.BadgeText))
                    {
                        <span class="badge bg-@Item.BadgeColor">@Item.BadgeText</span>
                    }
                </div>
            </div>
        </td>

        <!-- Columnas de checkboxes para cada rol (UNA POR ROL - EN HORIZONTAL) -->
        @foreach (var role in AllRoles)
        {
            var rolePerm = Item.RolePermissions?.FirstOrDefault(rp => rp.IdRole == role.Id);
            var isChecked = rolePerm?.CanView ?? false;
            var isPending = IsRolePending(role.Id);

            
            <td style="width: @(60 / AllRoles.Count)%"
                class="role-checkbox-container @(isPending ? "pending-change" : "")">
                @if (Item.Children?.Any() == false)
                {
                    <input type="checkbox"
                    class="form-check-input"
                    checked="@isChecked"
                    @onchange="@((ChangeEventArgs e) => OnRolePermissionChanged.InvokeAsync((Item.IdMenu, role.Id, (bool)e.Value!)))" />                    
                }
            </td>
        }

        <!-- Columna de acciones -->
        <td style="width: 150px;">
            <div class="actions-container">
                <button class="btn btn-sm btn-outline-primary" @onclick="() => OnEdit.InvokeAsync(Item.IdMenu)" title="Editar">
                    <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-outline-success" @onclick="() => OnAddChild.InvokeAsync(Item.IdMenu)" title="Añadir hijo">
                    <i class="fas fa-plus"></i>
                </button>
                <button class="btn btn-sm btn-outline-info" @onclick="() => OnManagePermissions.InvokeAsync(Item.IdMenu)" title="Gestionar permisos">
                    <i class="fas fa-shield-alt"></i>
                </button>
                <!--<button class="btn btn-sm btn-outline-danger" @onclick="() => OnDelete.InvokeAsync(Item.MenuId)" title="Eliminar">
                    <i class="fas fa-trash"></i>
                </button>-->
            </div>
        </td>
    </tr>

    <!-- Hijos (renderizados como filas adicionales) -->
    @if (Item.Children?.Any() == true && IsExpanded)
    {
        @foreach (var child in Item.Children.OrderBy(c => c.DisplayOrder))
        {
            <MenuItemNode Item="child"
                          Level="@(Level + 1)"
                          AllRoles="@AllRoles"
                          IsExpanded="@child.IsExpanded"
                          OnEdit="OnEdit"
                          OnDelete="OnDelete"
                          OnAddChild="OnAddChild"
                          OnManagePermissions="OnManagePermissions"
                          OnRolePermissionChanged="OnRolePermissionChanged"
                          OnToggleExpand="OnToggleExpand"
                          PendingChanges="@PendingChanges" />
        }
    }
}

@code {
    [Parameter] public MenuItemWithRoles Item { get; set; } = new();
    [Parameter] public int Level { get; set; } = 0;
    [Parameter] public List<RoleDto> AllRoles { get; set; } = new();
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public Dictionary<string, bool>? PendingChanges { get; set; }

    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnAddChild { get; set; }
    [Parameter] public EventCallback<Guid> OnManagePermissions { get; set; }
    [Parameter] public EventCallback<(Guid MenuItemId, Guid RoleId, bool CanView)> OnRolePermissionChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleExpand { get; set; }

    private bool IsPendingChange => PendingChanges?.Keys.Any(k =>
        k.StartsWith($"{Item.IdMenu}*")) ?? false;

    private bool IsRolePending(Guid roleId)
    {
        return PendingChanges?.ContainsKey($"{Item.IdMenu}*{roleId}") ?? false;
    }

    private async Task ToggleExpand()
    {
        if (OnToggleExpand.HasDelegate)
        {
            await OnToggleExpand.InvokeAsync(Item.IdMenu);
        }
        else
        {
            IsExpanded = !IsExpanded;
        }
    }
}