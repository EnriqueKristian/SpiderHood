@page "/Settings/SystemLogs"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services.Logging
@using SpiderHood.Utilities
@using SpiderHood.Components.Pages.Components
@inject ISystemLogAdminService SystemLogAdminService
@inject SpiderHood.Services.AuthService AuthService

<PageTitle>Logs de Sistema</PageTitle>

@if (!_loading && !_isSysAdmin)
{
    <div class="container-fluid px-4 py-3">
        <div class="alert alert-danger">
            <i class="bi bi-shield-lock me-1"></i>
            Sólo el Super Usuario (SysAdmin) puede configurar los logs de sistema.
        </div>
    </div>
}
else if (_loading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="page-header">
            <div class="page-header-title">
                <div class="icon-badge">
                    <i class="bi bi-journal-text"></i>
                </div>
                <h1 class="h3 fw-bold mb-0">Logs de Sistema</h1>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Configuración</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Apagado por defecto para no llenar la base de datos. Al activarlo, sólo se
                    guardan los eventos del nivel elegido para arriba (Critical es siempre el
                    más restrictivo). Los registros más viejos que la retención configurada se
                    borran automáticamente todos los días.
                </p>

                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="logsEnabled" @bind="_settings.IsEnabled" />
                            <label class="form-check-label" for="logsEnabled">
                                @(_settings.IsEnabled ? "Habilitado" : "Deshabilitado")
                            </label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Nivel mínimo</label>
                        <select class="form-select" @bind="_settings.MinLevel">
                            <option value="Critical">Critical</option>
                            <option value="Error">Error</option>
                            <option value="Warning">Warning</option>
                            <option value="Information">Information</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Retención (días)</label>
                        <input type="number" class="form-control" min="1" max="365" @bind="_settings.RetentionDays" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100" @onclick="SaveSettingsAsync" disabled="@_saving">
                            <i class="bi bi-save me-1"></i>Guardar
                        </button>
                    </div>
                </div>

                @if (_settings.UpdatedOn.HasValue)
                {
                    <p class="text-muted small mt-3 mb-0">
                        Última actualización: @_settings.UpdatedOn.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        por @_settings.UpdatedBy
                    </p>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Registros recientes</h5>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadLogsAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                </button>
            </div>
            <div class="card-body">
                @if (_pagination.CurrentPageData.Count == 0)
                {
                    <p class="text-muted mb-0">No hay registros.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Nivel</th>
                                    <th>Categoría</th>
                                    <th>Mensaje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in _pagination.CurrentPageData)
                                {
                                    <tr>
                                        <td class="text-nowrap">@log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td><span class="badge @LevelBadgeClass(log.Level)">@log.Level</span></td>
                                        <td class="text-nowrap">@log.Category</td>
                                        <td>
                                            @log.Message
                                            @if (!string.IsNullOrEmpty(log.Exception))
                                            {
                                                <details class="mt-1">
                                                    <summary class="text-muted small">Excepción</summary>
                                                    <pre class="small mb-0">@log.Exception</pre>
                                                </details>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <PaginationControls _pagination="@_pagination" />
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _isSysAdmin;
    private UserSession _currentUser = new();
    private SystemLogSettings _settings = new();
    private readonly PaginationClass<SystemLogEntry> _pagination = new();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _isSysAdmin = _currentUser.Roles.Contains("SysAdmin");

        if (_isSysAdmin)
        {
            _settings = await SystemLogAdminService.GetSettingsAsync();
            await ReloadLogsAsync();
        }

        _loading = false;
    }

    private async Task SaveSettingsAsync()
    {
        if (!_isSysAdmin || _saving) return;

        _saving = true;
        try
        {
            await SystemLogAdminService.SaveSettingsAsync(_settings, _currentUser.Email);
            _settings = await SystemLogAdminService.GetSettingsAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadLogsAsync()
    {
        var logs = await SystemLogAdminService.GetRecentLogsAsync();
        _pagination.Initialize(logs);
    }

    private static string LevelBadgeClass(string level) => level switch
    {
        "Critical" => "bg-dark",
        "Error" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Information" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}
