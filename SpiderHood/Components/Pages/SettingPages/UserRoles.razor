﻿﻿@* Pages/Settings/UserRoles.razor *@
@page "/Settings/UserRoles"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Components.Pages.Components
@inject Services.IPermissionAdminService PermissionAdminService
@inject Services.IPermissionService PermissionService
@inject Services.AuthService AuthService
@inject Services.IBuildingService BuildingService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Asignar Roles a Usuarios</PageTitle>

@if (!_loading && !_canAssignRoles)
{
    <div class="container-fluid">
        <div class="alert alert-danger">
            <i class="bi bi-shield-lock me-1"></i>
            No tienes permiso para asignar roles a usuarios.
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="page-header">
            <div class="page-header-title">
                <div class="icon-badge">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <h1 class="h3 fw-bold mb-0">Asignación de Roles a Usuarios</h1>
            </div>
        </div>

        @if (_loading)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else
        {
            <!-- Tarjetas de Resumen -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="icon-badge icon-badge-sm">
                                <i class="bi bi-people"></i>
                            </div>
                            <div>
                                <div class="stat-label">Usuarios con Rol</div>
                                <div class="stat-value">@_assignmentsInScope.Select(a => a.IdUser).Distinct().Count()</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="icon-badge icon-badge-sm icon-badge-secondary">
                                <i class="bi bi-building"></i>
                            </div>
                            <div>
                                <div class="stat-label">Edificios</div>
                                <div class="stat-value">@_buildings.Count</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="icon-badge icon-badge-sm icon-badge-success">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <div class="stat-label">Roles Asignados</div>
                                <div class="stat-value">@_assignmentsInScope.Count(a => a.IsApproved)</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="icon-badge icon-badge-sm icon-badge-warning">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div>
                                <div class="stat-label">Solicitudes Pendientes</div>
                                <div class="stat-value">@_pendingRequests.Count</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-envelope-plus me-2"></i>Invitar por Email</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Edificio</label>
                            <select class="form-select" @bind="_inviteBuildingId" @bind:after="OnInviteBuildingChangedAsync">
                                <option value="">-- Seleccionar --</option>
                                @foreach (var building in _buildings)
                                {
                                    <option value="@building.IdBuilding">@building.BuildingName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="_inviteEmail" placeholder="persona@email.com" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Rol</label>
                            <select class="form-select" @bind="_inviteRole">
                                @foreach (var role in _allRoles.Where(r => r.RoleName != "SysAdmin"))
                                {
                                    <option value="@role.RoleName" selected="@(role.RoleName == _inviteRole)">@role.RoleName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Unidad (opcional)</label>
                            <select class="form-select" @bind="_inviteGroupNumber" disabled="@(_inviteBuildingId == Guid.Empty)">
                                <option value="0">-- Sin asignar --</option>
                                @foreach (var unit in UnitsFor(_inviteBuildingId))
                                {
                                    <option value="@unit.GroupNumber">Grupo @unit.GroupNumber — @unit.FirstName @unit.LastName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" disabled="@(_inviting || _inviteBuildingId == Guid.Empty || string.IsNullOrWhiteSpace(_inviteEmail))"
                                    @onclick="SendInvitationAsync">
                                @if (_inviting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Invitar
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_inviteLink))
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <i class="bi bi-check-circle me-2"></i>Invitación creada. Compartí este link con la persona invitada:
                            <br /><code>@_inviteLink</code>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_inviteError))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@_inviteError</div>
                    }
                </div>
            </div>

            @if (_pendingRequests.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            <i class="bi bi-hourglass-split me-2"></i>
                            Solicitudes Pendientes de Aprobación (@_pendingRequests.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Usuario</th>
                                        <th>Email</th>
                                        <th>Edificio</th>
                                        <th>Rol</th>
                                        <th>Solicitado</th>
                                        <th style="width: 200px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in _pendingRequests)
                                    {
                                        <tr>
                                            <td>@req.UserName</td>
                                            <td>@req.UserEmail</td>
                                            <td>@req.BuildingName</td>
                                            <td><span class="badge @GetRoleBadgeClass(req.Role)">@req.Role</span></td>
                                            <td>@(req.RequestedAt?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td>
                                                <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveRequest(req)">
                                                    <i class="bi bi-check-lg"></i> Aprobar
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectRequest(req)">
                                                    <i class="bi bi-x-lg"></i> Rechazar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <!-- Filtros -->
                <div class="col-lg-3 mb-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filtros</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <h6 class="text-muted mb-3">
                                    <i class="bi bi-building me-2"></i>Edificio
                                </h6>
                                <div class="list-group list-group-flush">
                                    <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(_selectedBuildingId == null ? "active" : "")"
                                            @onclick="() => FiltrarPorEdificio(null)">
                                        Todos
                                        <span class="badge bg-primary rounded-pill">@ContarUsuariosPorEdificio(null)</span>
                                    </button>
                                    @foreach (var building in _buildings)
                                    {
                                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(_selectedBuildingId == building.IdBuilding ? "active" : "")"
                                                @onclick="() => FiltrarPorEdificio(building.IdBuilding)">
                                            @building.BuildingName
                                            <span class="badge bg-primary rounded-pill">@ContarUsuariosPorEdificio(building.IdBuilding)</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div>
                                <h6 class="text-muted mb-3">
                                    <i class="bi bi-search me-2"></i>Buscar usuario
                                </h6>
                                <input type="text" class="form-control" placeholder="Nombre o email..."
                                       @bind="_searchTerm" @bind:event="oninput" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Asignaciones -->
                <div class="col-lg-9">
                    <div class="card">
                        <div class="card-body">
                            @if (!FilteredRows.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-people bi-3x text-muted mb-3"></i>
                                    <p class="text-muted">No hay usuarios que coincidan con el filtro seleccionado</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Usuario</th>
                                                <th>Email</th>
                                                <th>Edificio</th>
                                                <th>Roles</th>
                                                <th style="width: 220px;">Unidad (Residente)</th>
                                                <th style="width: 220px;">Agregar rol</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in FilteredRows)
                                            {
                                                <tr>
                                                    <td>
                                                        <i class="bi bi-person-circle me-2"></i>
                                                        @row.UserName
                                                    </td>
                                                    <td>@row.UserEmail</td>
                                                    <td>@row.BuildingName</td>
                                                    <td>
                                                        @foreach (var role in row.Roles)
                                                        {
                                                            var asignacion = AssignmentFor(row, role);
                                                            var inactivo = asignacion != null && !asignacion.IsApproved && asignacion.Status == "Inactive";
                                                            <span class="badge @(inactivo ? "bg-secondary" : GetRoleBadgeClass(role)) me-1 mb-1">
                                                                @role
                                                                @if (inactivo)
                                                                {
                                                                    <span class="ms-1 fst-italic">(Inactivo)</span>
                                                                }
                                                                @if (asignacion != null)
                                                                {
                                                                    <i class="bi @(inactivo ? "bi-arrow-counterclockwise" : "bi-pause-circle") ms-1" role="button"
                                                                       title="@(inactivo ? "Reactivar" : "Desactivar")"
                                                                       @onclick="() => ToggleActive(asignacion)"></i>
                                                                }
                                                                <i class="bi bi-x-circle ms-1" role="button"
                                                                   title="Quitar rol"
                                                                   @onclick="() => RevokeRole(row, role)"></i>
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            var residente = ResidenteAssignmentFor(row);
                                                        }
                                                        @if (residente != null)
                                                        {
                                                            <select class="form-select form-select-sm"
                                                                    @onchange="(e) => AssignUnit(residente, e.Value?.ToString())">
                                                                <option value="">Sin asignar</option>
                                                                @foreach (var unit in UnitsFor(row.IdBuilding))
                                                                {
                                                                    <option value="@unit.IdGroupUnit"
                                                                            selected="@(residente.IdGroupUnit == unit.IdGroupUnit)">
                                                                        Grupo @unit.GroupNumber — @unit.FirstName @unit.LastName
                                                                    </option>
                                                                }
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">—</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            var assignable = AssignableRolesFor(row);
                                                        }
                                                        @if (assignable.Any())
                                                        {
                                                            <select class="form-select form-select-sm"
                                                                    @onchange="(e) => AssignRole(row, e.Value?.ToString())">
                                                                <option value="">Agregar rol...</option>
                                                                @foreach (var role in assignable)
                                                                {
                                                                    <option value="@role.RoleName">@role.RoleName</option>
                                                                }
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">Todos los roles asignados</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <ConfirmationModal @ref="_confirmationModal" OnClose="OnConfirmacion" />
}

@code {
    private List<UserBuildingRoleAssignment> _allAssignments = new();
    private List<Role> _allRoles = new();
    private bool _loading = true;
    private bool _initialized = false;
    private UserSession? _currentUser;

    private Guid? _selectedBuildingId;
    private string _searchTerm = string.Empty;

    // Unidades disponibles por edificio, para el selector "Unidad (Residente)" —
    // se cargan una vez por edificio involucrado, no por fila.
    private Dictionary<Guid, List<Models.OwnerUnitView>> _unitsByBuilding = new();

    // El permiso assign_roles ya no es exclusivo de SysAdmin -- un Administrador puede
    // tenerlo también (asignado desde /Settings/Roles/Permissions), pero sólo alcanza a
    // los edificios que administra (ver _misEdificios/_isSysAdmin más abajo). SysAdmin
    // asignándose a sí mismo el rol SysAdmin sigue bloqueado aparte (ver AssignRole).
    private bool _canAssignRoles;
    private bool _isSysAdmin;

    // Modal de confirmación propio (en vez del confirm() nativo del navegador, que no
    // sigue el estilo de la app) -- una sola instancia compartida por las 3 acciones
    // que antes usaban confirm() (Quitar Rol, Rechazar Solicitud, Desactivar/Reactivar),
    // cada una arma su propio mensaje y guarda qué hacer al confirmar en _accionPendiente.
    private ConfirmationModal? _confirmationModal;
    private Func<Task>? _accionPendiente;

    private void PedirConfirmacion(string titulo, string mensaje, string confirmText, string type, Func<Task> accion)
    {
        if (_confirmationModal == null) return;
        _accionPendiente = accion;
        _confirmationModal.Title = titulo;
        _confirmationModal.Message = mensaje;
        _confirmationModal.ConfirmText = confirmText;
        _confirmationModal.Show(type);
    }

    private async Task OnConfirmacion(bool confirmado)
    {
        var accion = _accionPendiente;
        _accionPendiente = null;
        if (confirmado && accion != null)
        {
            await accion();
        }
    }

    // Edificios donde el usuario actual tiene algún rol aprobado -- delimita qué puede
    // ver/tocar en esta pantalla cuando no es SysAdmin.
    private HashSet<Guid> _misEdificios = new();

    // Estado del formulario "Invitar por Email" -- ver SendInvitationAsync.
    private Guid _inviteBuildingId = Guid.Empty;
    private string _inviteEmail = string.Empty;
    private string _inviteRole = "Residente";
    private int _inviteGroupNumber = 0;
    private bool _inviting;
    private string? _inviteLink;
    private string? _inviteError;

    private class UserBuildingRow
    {
        public Guid IdUser { get; set; }
        public string UserName { get; set; } = string.Empty;
        public string UserEmail { get; set; } = string.Empty;
        public Guid IdBuilding { get; set; }
        public string BuildingName { get; set; } = string.Empty;
        public List<string> Roles { get; set; } = new();
    }

    // Sólo edificios donde el usuario actual tiene un rol aprobado -- para SysAdmin no se
    // filtra (ve/gestiona todos). Antes esta pantalla sólo era accesible para SysAdmin
    // (único rol con el permiso assign_roles); ahora que un Administrador también puede
    // entrar, no debe ver ni poder tocar roles de edificios que no administra.
    private IEnumerable<UserBuildingRoleAssignment> _assignmentsInScope =>
        _isSysAdmin ? _allAssignments : _allAssignments.Where(a => _misEdificios.Contains(a.IdBuilding));

    // Solicitudes de acceso (registro público o "solicitar acceso a otro edificio") que
    // todavía no fueron aprobadas ni rechazadas -- ver GET_AllUserBuildingRoles / IsApproved.
    // "Inactive" también queda afuera: es un rol que YA estuvo aprobado y se desactivó a
    // propósito (ver ToggleActive), no una solicitud nueva esperando revisión.
    private List<UserBuildingRoleAssignment> _pendingRequests =>
        _assignmentsInScope.Where(a => !a.IsApproved && a.Status != "Rejected" && a.Status != "Inactive").ToList();

    private List<(Guid IdBuilding, string BuildingName)> _buildings =>
        _assignmentsInScope
            .Select(a => (a.IdBuilding, a.BuildingName))
            .Distinct()
            .OrderBy(b => b.BuildingName)
            .ToList();

    private IEnumerable<UserBuildingRow> FilteredRows =>
        _assignmentsInScope
            .Where(a => !_selectedBuildingId.HasValue || _selectedBuildingId == Guid.Empty || a.IdBuilding == _selectedBuildingId)
            .Where(a => string.IsNullOrWhiteSpace(_searchTerm)
                || a.UserName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                || a.UserEmail.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            .GroupBy(a => new { a.IdUser, a.IdBuilding })
            .Select(g => new UserBuildingRow
            {
                IdUser = g.Key.IdUser,
                UserName = g.First().UserName,
                UserEmail = g.First().UserEmail,
                IdBuilding = g.Key.IdBuilding,
                BuildingName = g.First().BuildingName,
                Roles = g.Select(a => a.Role).OrderBy(r => r).ToList()
            })
            .OrderBy(r => r.BuildingName).ThenBy(r => r.UserName);

    // SysAdmin nunca aparece como opción para asignar: es un rol de sistema, no algo que
    // se otorgue caso a caso desde acá.
    private List<Role> AssignableRolesFor(UserBuildingRow row) =>
        _allRoles
            .Where(r => r.RoleName != "SysAdmin" && !row.Roles.Contains(r.RoleName))
            .OrderBy(r => r.RoleName)
            .ToList();

    private void FiltrarPorEdificio(Guid? buildingId)
    {
        _selectedBuildingId = buildingId;
    }

    private int ContarUsuariosPorEdificio(Guid? buildingId) =>
        _assignmentsInScope
            .Where(a => !buildingId.HasValue || a.IdBuilding == buildingId)
            .Select(a => a.IdUser)
            .Distinct()
            .Count();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
            _canAssignRoles = await PermissionService.HasPermissionAsync(_currentUser, "assign_roles");
            _isSysAdmin = _currentUser.Role == "SysAdmin";
            _misEdificios = _currentUser.Buildings
                .Where(b => b.IsApproved && b.Building != null)
                .Select(b => b.Building!.IdBuilding)
                .ToHashSet();
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _loading = true;
            _allAssignments = await PermissionAdminService.GetUserBuildingRoleAssignmentsAsync();
            _allRoles = await PermissionAdminService.GetAllRolesAsync();

            _unitsByBuilding = new();
            foreach (var buildingId in _allAssignments.Select(a => a.IdBuilding).Distinct())
            {
                _unitsByBuilding[buildingId] = await BuildingService.GetOwnersByBuildingAsync(buildingId);
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al cargar datos: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AssignRole(UserBuildingRow row, string? role)
    {
        if (!_canAssignRoles) return;
        if (string.IsNullOrWhiteSpace(role)) return;
        if (role == "SysAdmin") return;

        try
        {
            await PermissionAdminService.AssignUserBuildingRoleAsync(row.IdUser, row.IdBuilding, role, _currentUser!.IdUser);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al asignar el rol: {ex.Message}", "danger");
        }
    }

    private void RevokeRole(UserBuildingRow row, string role)
    {
        if (!_canAssignRoles) return;

        PedirConfirmacion(
            "Quitar Rol",
            $"¿Quitarle el rol \"{role}\" a {row.UserName} en {row.BuildingName}?",
            "Quitar", "danger",
            async () =>
            {
                try
                {
                    await PermissionAdminService.RevokeUserBuildingRoleAsync(row.IdUser, row.IdBuilding, role);
                    await LoadDataAsync();
                }
                catch (Exception ex)
                {
                    await ShowToast("Error", $"Error al quitar el rol: {ex.Message}", "danger");
                }
            });
    }

    private async Task ApproveRequest(UserBuildingRoleAssignment request)
    {
        if (!_canAssignRoles) return;

        try
        {
            await PermissionAdminService.SetUserBuildingApprovalAsync(
                request.IdUser, request.IdBuilding, request.IdRole, true, "Approved", _currentUser!.IdUser);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al aprobar la solicitud: {ex.Message}", "danger");
        }
    }

    private void RejectRequest(UserBuildingRoleAssignment request)
    {
        if (!_canAssignRoles) return;

        PedirConfirmacion(
            "Rechazar Solicitud",
            $"¿Rechazar la solicitud de {request.UserName} para {request.BuildingName} ({request.Role})?",
            "Rechazar", "danger",
            async () =>
            {
                try
                {
                    await PermissionAdminService.SetUserBuildingApprovalAsync(
                        request.IdUser, request.IdBuilding, request.IdRole, false, "Rejected", _currentUser!.IdUser);
                    await LoadDataAsync();
                }
                catch (Exception ex)
                {
                    await ShowToast("Error", $"Error al rechazar la solicitud: {ex.Message}", "danger");
                }
            });
    }

    // Fila real detrás de un badge de rol en la tabla principal -- para saber si está
    // activo/inactivo y poder togglearlo. Row.Roles ya no alcanza (es sólo el nombre).
    private UserBuildingRoleAssignment? AssignmentFor(UserBuildingRow row, string role) =>
        _allAssignments.FirstOrDefault(a =>
            a.IdUser == row.IdUser && a.IdBuilding == row.IdBuilding && a.Role == role);

    // Desactivar/reactivar un rol puntual (usuario+edificio+rol) sin borrarlo -- a
    // diferencia de RevokeRole (que elimina la fila), esto reutiliza el mismo mecanismo
    // de aprobación (UPD_UserBuildingApproval) con Status="Inactive"/"Approved", así que
    // no hace falta ninguna columna ni SP nuevo. Es lo que le permite a un Administrador
    // "desactivar a un usuario" sin afectar su cuenta global ni sus otros edificios --
    // a diferencia del toggle Activo/Inactivo de /users, que es global y sólo lo debería
    // usar SysAdmin.
    private void ToggleActive(UserBuildingRoleAssignment assignment)
    {
        if (!_canAssignRoles) return;

        var activar = !assignment.IsApproved && assignment.Status == "Inactive";
        var accion = activar ? "reactivar" : "desactivar";

        PedirConfirmacion(
            activar ? "Reactivar Rol" : "Desactivar Rol",
            $"¿{(activar ? "Reactivar" : "Desactivar")} el rol \"{assignment.Role}\" de {assignment.UserName} en {assignment.BuildingName}?",
            activar ? "Reactivar" : "Desactivar", activar ? "warning" : "danger",
            async () =>
            {
                try
                {
                    await PermissionAdminService.SetUserBuildingApprovalAsync(
                        assignment.IdUser, assignment.IdBuilding, assignment.IdRole,
                        activar, activar ? "Approved" : "Inactive", _currentUser!.IdUser);
                    await LoadDataAsync();
                }
                catch (Exception ex)
                {
                    await ShowToast("Error", $"Error al {accion} el rol: {ex.Message}", "danger");
                }
            });
    }

    private Task OnInviteBuildingChangedAsync()
    {
        _inviteGroupNumber = 0;
        return Task.CompletedTask;
    }

    // Genera el link de invitación (código único, válido 7 días) y dispara el envío
    // del correo con ese link (best-effort -- ver AuthService.SendInvitationEmailAsync,
    // mismo criterio que "Invitar Colaborador" en /Settings/Cuenta: si el SMTP no está
    // configurado en este entorno, no bloquea nada). El link se muestra igual acá abajo
    // para que el administrador pueda copiarlo y pasarlo a mano (WhatsApp, etc.) si el
    // correo no llega.
    private async Task SendInvitationAsync()
    {
        _inviteError = null;
        _inviteLink = null;
        if (_inviteBuildingId == Guid.Empty || string.IsNullOrWhiteSpace(_inviteEmail)) return;

        _inviting = true;
        try
        {
            var buildingName = _buildings.FirstOrDefault(b => b.IdBuilding == _inviteBuildingId).BuildingName ?? string.Empty;
            var invitedByName = !string.IsNullOrWhiteSpace(_currentUser?.FullName) ? _currentUser!.FullName : (_currentUser?.Email ?? "Administrador");

            var invitation = await AuthService.CreateInvitationAsync(
                _inviteBuildingId, buildingName, _inviteEmail, _inviteRole, _inviteGroupNumber, invitedByName);

            _inviteLink = $"{NavigationManager.BaseUri.TrimEnd('/')}/invitation/{invitation.Code}";
            _inviteEmail = string.Empty;
            _inviteGroupNumber = 0;
        }
        catch (Exception ex)
        {
            _inviteError = $"Error al crear la invitación: {ex.Message}";
        }
        finally
        {
            _inviting = false;
        }
    }

    // La unidad se guarda en la fila UserBuildingAssociation de rol "Residente"
    // específicamente (una misma fila de UserRoles.razor puede agrupar varios roles,
    // pero la unidad sólo tiene sentido para éste) — de ahí que se busque en
    // _allAssignments (que sí tiene el detalle por rol) en vez de en UserBuildingRow.
    private UserBuildingRoleAssignment? ResidenteAssignmentFor(UserBuildingRow row) =>
        _allAssignments.FirstOrDefault(a =>
            a.IdUser == row.IdUser && a.IdBuilding == row.IdBuilding && a.Role == "Residente");

    // Un mismo IdGroupUnit puede aparecer varias veces en GetOwnersByBuildingAsync (una
    // fila por cada unidad física — depto, cochera, depósito — dentro del mismo grupo),
    // así que se deduplica para el selector.
    private List<Models.OwnerUnitView> UnitsFor(Guid buildingId) =>
        _unitsByBuilding.TryGetValue(buildingId, out var units)
            ? units.DistinctBy(u => u.IdGroupUnit).OrderBy(u => u.GroupNumber).ToList()
            : new();

    private async Task AssignUnit(UserBuildingRoleAssignment residente, string? idGroupUnitStr)
    {
        if (!_canAssignRoles) return;

        Guid? idGroupUnit = Guid.TryParse(idGroupUnitStr, out var parsed) ? parsed : null;

        try
        {
            await PermissionAdminService.AssignUnitToUserBuildingAsync(
                residente.IdUser, residente.IdBuilding, residente.IdRole, idGroupUnit);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al asignar la unidad: {ex.Message}", "danger");
        }
    }

    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Administrador" => "bg-danger",
            "SysAdmin" => "bg-dark",
            "Junta" => "bg-warning text-dark",
            "Residente" => "bg-info",
            _ => "bg-secondary"
        };
    }

    private async Task ShowToast(string title, string message, string type)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showToast", title, message, type);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando toast: {ex.Message}");
            Console.WriteLine($"{type.ToUpper()}: {title} - {message}");
        }
    }
}
