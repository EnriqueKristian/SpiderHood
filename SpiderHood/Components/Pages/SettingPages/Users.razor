@page "/users"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject Services.AuthService AuthService
@inject IPermissionAdminService PermissionAdminService
@inject IPermissionService PermissionService
@inject IJSRuntime JSRuntime

<PageTitle>Gestión de Usuarios</PageTitle>

@if (!_loading && !_canManageUsers)
{
    <div class="container-fluid">
        <div class="alert alert-danger">
            <i class="bi bi-shield-lock me-1"></i>
            No tienes permiso para gestionar usuarios.
        </div>
    </div>
}
else
{
<div class="container-fluid">
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-people"></i>
            </div>
            <h1 class="h3 fw-bold mb-0">Gestión de Usuarios</h1>
        </div>
        <div class="page-header-actions">
            <a href="/Settings/UserRoles" class="btn btn-outline-secondary">
                <i class="bi bi-diagram-3 me-1"></i> Asignar Roles
            </a>
            <button class="btn btn-primary" @onclick="MostrarModalNuevoUsuario">
                <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <!-- Tarjetas de Resumen -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm">
                            <i class="bi bi-people"></i>
                        </div>
                        <div>
                            <div class="stat-label">Total Usuarios</div>
                            <div class="stat-value">@usuarios.Count</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm icon-badge-warning">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <div class="stat-label">Administradores</div>
                            <div class="stat-value">@usuarios.Count(u => u.Roles.Contains("Administrador"))</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm icon-badge-success">
                            <i class="bi bi-person-check"></i>
                        </div>
                        <div>
                            <div class="stat-label">Usuarios Activos</div>
                            <div class="stat-value">@usuarios.Count(u => u.Estado == "Activo")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm icon-badge-secondary">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div>
                            <div class="stat-label">Usuarios Inactivos</div>
                            <div class="stat-value">@usuarios.Count(u => u.Estado == "Inactivo")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Filtros -->
            <div class="col-lg-3 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filtros</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <h6 class="text-muted mb-3">
                                <i class="bi bi-person-badge me-2"></i>Roles
                            </h6>
                            <div class="list-group list-group-flush">
                                @foreach (var rol in roles)
                                {
                                    <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(rolSeleccionado == rol ? "active" : "")"
                                            @onclick="() => FiltrarPorRol(rol)">
                                        @rol
                                        <span class="badge bg-primary rounded-pill">@ObtenerCantidadPorRol(rol)</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div>
                            <h6 class="text-muted mb-3">
                                <i class="bi bi-bar-chart me-2"></i>Estado
                            </h6>
                            <div class="list-group list-group-flush">
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(filtroEstado == null ? "active" : "")"
                                        @onclick="() => FiltrarPorEstado(null)">
                                    Todos
                                    <span class="badge bg-secondary rounded-pill">@usuarios.Count</span>
                                </button>
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(filtroEstado == "Activo" ? "active" : "")"
                                        @onclick="() => FiltrarPorEstado(strActivo)">
                                    Activos
                                    <span class="badge bg-success rounded-pill">@usuarios.Count(u => u.Estado == "Activo")</span>
                                </button>
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(filtroEstado == "Inactivo" ? "active" : "")"
                                        @onclick="() => FiltrarPorEstado(strInactivo)">
                                    Inactivos
                                    <span class="badge bg-secondary rounded-pill">@usuarios.Count(u => u.Estado == "Inactivo")</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla de Usuarios -->
            <div class="col-lg-9">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>USUARIO</th>
                                        <th>CONTACTO</th>
                                        <th>ROL</th>
                                        <th>ESTADO</th>
                                        <th>FECHA INGRESO</th>
                                        <th>ACCIONES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in usuariosFiltrados)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar @GetAvatarClass(usuario)">
                                                        @GetIniciales(usuario.Nombre)
                                                    </div>
                                                    <div class="ms-3">
                                                        <div class="fw-bold">@usuario.Nombre</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <small class="text-primary">@usuario.Email</small>
                                                    <small class="text-muted">@usuario.Telefono</small>
                                                </div>
                                            </td>
                                            <td>
                                                @if (usuario.Roles.Any())
                                                {
                                                    @foreach (var rol in usuario.Roles)
                                                    {
                                                        <span class="badge @GetRolBadgeClass(rol) me-1 mb-1">@rol</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Sin rol</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @(usuario.Estado == "Activo" ? "bg-success" : "bg-secondary")">
                                                    @usuario.Estado
                                                </span>
                                            </td>
                                            <td>@usuario.FechaIngreso.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary"
                                                            @onclick="() => EditarUsuario(usuario.IdUser)"
                                                            title="Editar usuario">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button class="btn btn-outline-warning"
                                                            @onclick="() => CambiarEstadoUsuario(usuario)"
                                                            title="Cambiar estado">
                                                        <i class="bi @(usuario.Estado == "Activo" ? "bi-person-dash" : "bi-person-check")"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!usuariosFiltrados.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-people bi-3x text-muted mb-3"></i>
                                <p class="text-muted">No se encontraron usuarios con los filtros seleccionados</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal para Nuevo/Editar Usuario -->
@if (mostrarModalUsuario)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(formModel!.IsEdit ? "bi-person-fill-gear" : "bi-person-plus") me-2"></i>
                        @(formModel!.IsEdit ? "Editar Usuario" : "Nuevo Usuario")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalUsuario"></button>
                </div>
                <div class="modal-body">
                    <UsuarioForm Model="formModel!"
                                 OnSave="GuardarUsuario"
                                 OnCancel="CerrarModalUsuario" />
                </div>
            </div>
        </div>
    </div>
}
}

@code {
    private class UsuarioRow
    {
        public Guid IdUser { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public List<string> Roles { get; set; } = new();
        public string Estado { get; set; } = "Activo";
        public DateTime FechaIngreso { get; set; }
    }

    private List<UsuarioRow> usuarios = new();
    private List<UsuarioRow> usuariosFiltrados = new();
    private List<Role> _availableRoles = new();
    private List<string> roles = new() { "Todos" };

    private string? rolSeleccionado = "Todos";
    private string? filtroEstado;

    private bool _loading = true;
    private bool mostrarModalUsuario = false;
    private UsuarioFormModel? formModel;

    private string strActivo = "Activo";
    private string strInactivo = "Inactivo";

    // Reutiliza manage_users, ya existente y ya asignado sólo a Administrador/SysAdmin
    // — no hace falta script SQL nuevo para esta página.
    private bool _canManageUsers;

    // manage_users lo tiene tanto SysAdmin como Administrador -- sin este chequeo
    // extra, cualquier Administrador veía las cuentas SysAdmin en la lista y podía
    // asignarle el rol SysAdmin a cualquiera desde el combo "Rol" (escalación de
    // privilegios). Sólo SysAdmin gestiona SysAdmin.
    private bool _isSysAdmin;
    private UserSession _currentUser = new();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync() ?? new UserSession();
        _canManageUsers = await PermissionService.HasPermissionAsync(_currentUser, "manage_users");
        _isSysAdmin = _currentUser.Role == "SysAdmin";

        await CargarUsuarios();
        AplicarFiltros();
    }

    private async Task CargarUsuarios()
    {
        try
        {
            _loading = true;

            // assignments (UserRole) sigue siendo la única fuente para el DIRECTORIO
            // completo de usuarios (nombre/email/perfil) y para detectar SysAdmin (ver
            // más abajo) -- pero YA NO para el rol mostrado, que ahora sale de
            // UserBuildingAssociation (asociaciones). Antes las dos pantallas leían
            // tablas distintas y desconectadas: un usuario con "Junta" recién asignado
            // en /Settings/UserRoles (UserBuildingAssociation, la tabla real) seguía
            // apareciendo acá como "Sin rol", porque esta pantalla leía UserRole (una
            // tabla aparte, sin ningún efecto real en la sesión del usuario).
            var assignments = await PermissionAdminService.GetUserRoleAssignmentsAsync();
            _availableRoles = await PermissionAdminService.GetAllRolesAsync();

            var misEdificios = _currentUser.Buildings
                .Where(b => b.IsApproved && b.Building != null)
                .Select(b => b.Building!.IdBuilding)
                .ToHashSet();

            var asociaciones = await PermissionAdminService.GetUserBuildingRoleAssignmentsAsync();

            // Roles reales por usuario, acotados a los edificios que administra el
            // usuario actual (o todos, si es SysAdmin) -- mismo criterio de alcance que
            // /Settings/UserRoles. Sólo cuentan los ya aprobados (una solicitud
            // pendiente no es un rol real todavía).
            var rolesPorUsuario = asociaciones
                .Where(a => a.IsApproved && (_isSysAdmin || misEdificios.Contains(a.IdBuilding)))
                .GroupBy(a => a.IdUser)
                .ToDictionary(g => g.Key, g => g.Select(a => a.Role).Distinct().ToList());

            // Alcance por edificio: un Administrador sólo debe ver (y poder gestionar)
            // usuarios que tienen alguna asociación real (UserBuildingAssociation) en un
            // edificio que él administra -- antes esta pantalla traía TODOS los usuarios
            // del sistema sin ningún filtro, así que cualquier Administrador podía ver
            // y desactivar globalmente a usuarios de edificios ajenos. SysAdmin sigue
            // viendo todo.
            HashSet<Guid>? usuariosVisibles = null;
            if (!_isSysAdmin)
            {
                usuariosVisibles = asociaciones
                    .Where(a => misEdificios.Contains(a.IdBuilding))
                    .Select(a => a.IdUser)
                    .ToHashSet();
            }

            var rows = new List<UsuarioRow>();
            foreach (var assignment in assignments)
            {
                if (usuariosVisibles != null && !usuariosVisibles.Contains(assignment.IdUser))
                    continue;

                var profile = await AuthService.GetUserProfileAsync(assignment.IdUser);

                var nombre = profile != null && (!string.IsNullOrWhiteSpace(profile.FirstName) || !string.IsNullOrWhiteSpace(profile.LastName))
                    ? $"{profile.FirstName} {profile.LastName}".Trim()
                    : assignment.UserName;

                var rolesUsuario = rolesPorUsuario.TryGetValue(assignment.IdUser, out var r) ? new List<string>(r) : new();

                // Única excepción a "todo sale de UserBuildingAssociation": SysAdmin es
                // global por diseño (ver AuthService.GrantSysAdminAccessToAllBuildingsAsync)
                // y no tiene ninguna fila de edificio -- sin esto, Admin System volvería
                // a mostrar "Sin rol".
                if (assignment.CurrentRole == "SysAdmin" && !rolesUsuario.Contains("SysAdmin"))
                {
                    rolesUsuario.Add("SysAdmin");
                }

                rows.Add(new UsuarioRow
                {
                    IdUser = assignment.IdUser,
                    Nombre = string.IsNullOrWhiteSpace(nombre) ? assignment.UserEmail : nombre,
                    Email = assignment.UserEmail,
                    Telefono = profile?.PhoneNumber ?? string.Empty,
                    Roles = rolesUsuario,
                    Estado = (profile?.IsActive ?? true) ? "Activo" : "Inactivo",
                    FechaIngreso = profile?.CreatedAt ?? DateTime.MinValue
                });
            }

            if (!_isSysAdmin)
            {
                _availableRoles = _availableRoles.Where(r => r.RoleName != "SysAdmin").ToList();
                rows = rows.Where(r => !r.Roles.Contains("SysAdmin")).ToList();
            }

            usuarios = rows.OrderBy(u => u.Nombre).ToList();
            roles = new List<string> { "Todos" }.Concat(_availableRoles.Select(r => r.RoleName)).ToList();
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al cargar usuarios: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void FiltrarPorRol(string rol)
    {
        rolSeleccionado = rol;
        AplicarFiltros();
    }

    private void FiltrarPorEstado(string? estado)
    {
        filtroEstado = estado;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        usuariosFiltrados = usuarios
            .Where(u => rolSeleccionado == "Todos" || u.Roles.Contains(rolSeleccionado))
            .Where(u => filtroEstado == null || u.Estado == filtroEstado)
            .ToList();
    }

    private int ObtenerCantidadPorRol(string rol)
    {
        return rol == "Todos" ? usuarios.Count : usuarios.Count(u => u.Roles.Contains(rol));
    }

    private string GetAvatarClass(UsuarioRow usuario)
    {
        return usuario.Roles.FirstOrDefault() switch
        {
            "Administrador" => "avatar-admin",
            "Junta" => "avatar-junta",
            "Residente" => "avatar-residente",
            _ => "avatar-default"
        };
    }

    private string GetIniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
            return $"{partes[0][0]}{partes[1][0]}".ToUpper();
        return nombre.Length >= 2 ? nombre.Substring(0, 2).ToUpper() : nombre.ToUpper();
    }

    private string GetRolBadgeClass(string rol)
    {
        return rol switch
        {
            "Administrador" => "bg-primary",
            "SysAdmin" => "bg-danger",
            "Junta" => "bg-warning",
            "Residente" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private void MostrarModalNuevoUsuario()
    {
        if (!_canManageUsers) return;
        formModel = new UsuarioFormModel { IsActive = true };
        mostrarModalUsuario = true;
    }

    private void EditarUsuario(Guid idUser)
    {
        if (!_canManageUsers) return;
        var usuario = usuarios.FirstOrDefault(u => u.IdUser == idUser);
        if (usuario == null) return;

        formModel = new UsuarioFormModel
        {
            IdUser = usuario.IdUser,
            IsEdit = true,
            FirstName = usuario.Nombre.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(0) ?? string.Empty,
            LastName = usuario.Nombre.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(1) ?? string.Empty,
            Email = usuario.Email,
            PhoneNumber = usuario.Telefono,
            IsActive = usuario.Estado == "Activo"
        };
        mostrarModalUsuario = true;
    }

    private async Task GuardarUsuario(UsuarioFormModel model)
    {
        if (!_canManageUsers) return;
        try
        {
            if (model.IsEdit)
            {
                var result = await AuthService.UpdateUserAdminAsync(model.IdUser, model.FirstName, model.LastName, model.PhoneNumber, model.IsActive);
                if (!result.Success)
                {
                    await ShowToast("Error", result.Message, "danger");
                    return;
                }

                if (!string.IsNullOrWhiteSpace(model.Password))
                {
                    var passwordResult = await AuthService.AdminResetPasswordAsync(model.IdUser, model.Password);
                    if (!passwordResult.Success)
                    {
                        await ShowToast("Error", passwordResult.Message, "danger");
                        return;
                    }
                }
            }
            else
            {
                var result = await AuthService.CreateUserAsync(model.Email, model.FirstName, model.LastName, model.PhoneNumber, model.Password);
                if (!result.Success || result.User == null)
                {
                    await ShowToast("Error", result.Message, "danger");
                    return;
                }

                if (!model.IsActive)
                {
                    await AuthService.UpdateUserAdminAsync(result.User.IdUser, model.FirstName, model.LastName, model.PhoneNumber, false);
                }
            }

            CerrarModalUsuario();
            await CargarUsuarios();
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            await ShowToast("Error", $"Error al guardar: {ex.Message}", "danger");
        }
    }

    private void CerrarModalUsuario()
    {
        mostrarModalUsuario = false;
        formModel = null;
    }

    private async Task CambiarEstadoUsuario(UsuarioRow usuario)
    {
        if (!_canManageUsers) return;
        var nuevoEstadoActivo = usuario.Estado != "Activo";
        var accion = nuevoEstadoActivo ? "activar" : "desactivar";

        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro de {accion} a {usuario.Nombre}?"))
            return;

        var partes = usuario.Nombre.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        var result = await AuthService.UpdateUserAdminAsync(
            usuario.IdUser,
            partes.ElementAtOrDefault(0) ?? string.Empty,
            partes.ElementAtOrDefault(1) ?? string.Empty,
            usuario.Telefono,
            nuevoEstadoActivo);

        if (!result.Success)
        {
            await ShowToast("Error", result.Message, "danger");
            return;
        }

        await CargarUsuarios();
        AplicarFiltros();
    }

    private async Task ShowToast(string title, string message, string type)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showToast", title, message, type);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mostrando toast: {ex.Message}");
            Console.WriteLine($"{type.ToUpper()}: {title} - {message}");
        }
    }
}