@page "/Settings"
@rendermode InteractiveServer
@using SpiderHood.Models
@inject Services.AuthService AuthService
@inject Services.ISubscriptionService SubscriptionService
@inject Services.IPaymentService PaymentService
@inject Services.IAccountService AccountService
@inject Services.IPermissionService PermissionService
@inject NavigationManager Navigation

<section>
    <div><h4><strong>Mi Suscripción</strong></h4></div>
    <div><span class="text-muted">Plan y estado de tu cuenta en SpiderHood</span></div>
    <br />
</section>

<section class="card" style="max-width: 480px;">
    <div class="card-body">
        @if (_subscription == null)
        {
            <p class="text-muted mb-0">Esta cuenta todavía no tiene una suscripción registrada.</p>
        }
        else
        {
            @if (_subscription.Status == "Trial" && _subscription.EndDate.HasValue)
            {
                var daysLeft = Math.Max(0, (int)Math.Ceiling((_subscription.EndDate.Value - DateTime.UtcNow).TotalDays));
                <div class="alert @(daysLeft <= 10 ? "alert-warning" : "alert-info") py-2 mb-3">
                    <i class="bi bi-hourglass-split me-2"></i>
                    Estás en el período de prueba: te quedan <strong>@daysLeft día(s)</strong> (hasta @_subscription.EndDate.Value.ToString("dd/MM/yyyy"))
                    para elegir un plan pago antes de que venza.
                </div>
            }
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between lh-sm">
                    <div>
                        <h6 class="my-0">Plan</h6>
                        <small class="text-muted">Plan actual de la cuenta</small>
                    </div>
                    <span class="fw-bold">@_subscription.PlanName</span>
                </li>
                <li class="list-group-item d-flex justify-content-between lh-sm">
                    <div>
                        <h6 class="my-0">Estado</h6>
                    </div>
                    <span class="badge bg-secondary">@_subscription.Status</span>
                </li>
                <li class="list-group-item d-flex justify-content-between lh-sm">
                    <div>
                        <h6 class="my-0">Edificios</h6>
                        <small class="text-muted">Administrados con este plan</small>
                    </div>
                    <span>@_administeredBuildingsCount / @(_subscription.MaxBuildings?.ToString() ?? "Sin límite")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Inicio</span>
                    <strong>@_subscription.StartDate.ToString("dd/MM/yyyy")</strong>
                </li>
            </ul>
        }
    </div>
</section>

@if (_account != null)
{
    <section style="max-width: 700px;">
        <h6 class="mt-4 mb-2">Datos de Facturación</h6>
        <div class="card">
            <div class="card-body">
                @if (_accountSaveError != null)
                {
                    <div class="alert alert-danger py-2">@_accountSaveError</div>
                }
                @if (_editingAccountInfo)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1 d-block">Tipo de Cuenta</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input type="radio" class="form-check-input" id="accountTypeNatural" name="accountType"
                                       checked="@(_accountForm.AccountType == Models.AccountType.Natural)"
                                       disabled="@_savingAccount"
                                       @onchange="@(() => _accountForm.AccountType = Models.AccountType.Natural)" />
                                <label for="accountTypeNatural" class="form-check-label">Natural</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" id="accountTypeEmpresa" name="accountType"
                                       checked="@(_accountForm.AccountType == Models.AccountType.Empresa)"
                                       disabled="@_savingAccount"
                                       @onchange="@(() => _accountForm.AccountType = Models.AccountType.Empresa)" />
                                <label for="accountTypeEmpresa" class="form-check-label">Empresa</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">
                            @(_accountForm.AccountType == Models.AccountType.Empresa ? "Razón Social" : "Nombre Completo")
                        </label>
                        <input class="form-control" @bind="_accountForm.RazonSocial" disabled="@_savingAccount" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">RUC / DNI</label>
                        <input class="form-control" @bind="_accountForm.RucDni" disabled="@_savingAccount" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Teléfono</label>
                        <input class="form-control" @bind="_accountForm.Telefono" disabled="@_savingAccount" />
                    </div>
                    @if (_accountForm.AccountType == Models.AccountType.Empresa)
                    {
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Representante Legal</label>
                            <input class="form-control" @bind="_accountForm.LegalRepresentative" disabled="@_savingAccount" />
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Dirección Fiscal</label>
                        <input class="form-control" @bind="_accountForm.FiscalAddress" disabled="@_savingAccount" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Horario de Atención</label>
                        <input class="form-control" @bind="_accountForm.OfficeHours" disabled="@_savingAccount"
                               placeholder="Ej: Lunes a Viernes 8:00 - 17:00" />
                        <div class="form-text">
                            Se usa como valor por defecto en los edificios que no carguen su propio
                            horario de atención.
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" disabled="@_savingAccount" @onclick="SaveAccountInfoAsync">
                            @(_savingAccount ? "Guardando..." : "Guardar")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@_savingAccount" @onclick="CancelEditAccountInfo">
                            Cancelar
                        </button>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-2">
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <span class="text-muted">Tipo de Cuenta</span>
                            <span class="badge @(_account.AccountType == Models.AccountType.Empresa ? "bg-info" : "bg-secondary")">
                                @(_account.AccountType == Models.AccountType.Empresa ? "Empresa" : "Natural")
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <span class="text-muted">@(_account.AccountType == Models.AccountType.Empresa ? "Razón Social" : "Nombre Completo")</span>
                            <span class="fw-bold">@(_account.RazonSocial ?? "-")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <span class="text-muted">RUC / DNI</span>
                            <span>@(_account.RucDni ?? "-")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <span class="text-muted">Teléfono</span>
                            <span>@(_account.Telefono ?? "-")</span>
                        </li>
                        @if (_account.AccountType == Models.AccountType.Empresa)
                        {
                            <li class="list-group-item d-flex justify-content-between lh-sm">
                                <span class="text-muted">Representante Legal</span>
                                <span>@(_account.LegalRepresentative ?? "-")</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <span class="text-muted">Dirección Fiscal</span>
                            <span>@(_account.FiscalAddress ?? "-")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <span class="text-muted">Horario de Atención</span>
                            <span>@(_account.OfficeHours ?? "-")</span>
                        </li>
                    </ul>
                    @if (_canEditAccount)
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="StartEditAccountInfo">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </button>
                    }
                    else
                    {
                        <small class="text-muted">Sólo el Administrador de la cuenta puede editar estos datos.</small>
                    }
                }
            </div>
        </div>

        <h6 class="mt-4 mb-2">Logo de la Empresa</h6>
        <div class="card">
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Se usa en la emisión de recibos, PDFs y reportes exportados.
                </p>
                @if (_logoError != null)
                {
                    <div class="alert alert-danger py-2">@_logoError</div>
                }
                <div class="d-flex align-items-center gap-3 mb-2">
                    @if (_logoDataUri != null)
                    {
                        <img src="@_logoDataUri" alt="Logo" style="max-height:80px;max-width:200px;object-fit:contain;" class="border rounded p-1" />
                    }
                    else
                    {
                        <span class="text-muted">Sin logo cargado.</span>
                    }
                </div>
                @if (_canEditAccount)
                {
                    <InputFile OnChange="SubirLogoAsync" accept="image/png,image/jpeg,image/webp"
                               class="form-control" disabled="@_subiendoLogo" />
                    <small class="text-muted">JPG, PNG o WEBP -- máximo 2 MB.</small>
                }
            </div>
        </div>

        <h6 class="mt-4 mb-2">Colaboradores</h6>
        <div class="card">
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Las personas que invites acá administran los mismos edificios que vos, bajo la misma suscripción (@_account.RazonSocial).
                </p>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var collaborator in _collaborators)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@collaborator.FirstName @collaborator.LastName <small class="text-muted">(@collaborator.Email)</small></span>
                            <span class="badge bg-secondary">@collaborator.Role</span>
                        </li>
                    }
                </ul>

                @foreach (var invitation in _pendingInvitations)
                {
                    <div class="alert alert-warning py-2 d-flex justify-content-between align-items-center">
                        <span>Invitación pendiente: <strong>@invitation.Email</strong></span>
                        <code class="small">/accept-invitation?code=@invitation.Code</code>
                    </div>
                }

                @if (_inviteError != null)
                {
                    <div class="alert alert-danger py-2">@_inviteError</div>
                }
                @if (_inviteLink != null)
                {
                    <div class="alert alert-success py-2">
                        Invitación creada. Compartí este link: <code>@_inviteLink</code>
                    </div>
                }

                <div class="input-group">
                    <input class="form-control" placeholder="email@colaborador.com" @bind="_inviteEmail" />
                    <button class="btn btn-outline-primary" disabled="@_inviting" @onclick="InviteAsync">
                        <i class="bi bi-person-plus me-1"></i>Invitar
                    </button>
                </div>
            </div>
        </div>
    </section>
}

@if (_purchasablePlans.Count > 0)
{
    <section style="max-width: 900px;">
        <h6 class="mt-4 mb-2">Cambiar de plan</h6>
        @if (_paymentError != null)
        {
            <div class="alert alert-danger py-2">@_paymentError</div>
        }
        <div class="d-flex flex-wrap gap-3">
            @foreach (var plan in _purchasablePlans)
            {
                <div class="card" style="width: 260px;">
                    <div class="card-body d-flex flex-column">
                        <h6 class="fw-bold mb-1">@plan.Name</h6>
                        <div class="mb-1">@(plan.CurrencyId) @(plan.Amount?.ToString("0.00"))<small class="text-muted">/mes</small></div>
                        <small class="text-muted mb-2">
                            @(plan.MaxBuildings.HasValue ? $"{plan.MaxBuildings} edificio(s)" : "Edificios ilimitados")
                        </small>
                        <ul class="list-unstyled small mb-3">
                            @foreach (var feature in GetFeatures(plan.Name))
                            {
                                <li>✓ @feature</li>
                            }
                        </ul>
                        <button class="btn btn-primary btn-sm mt-auto" disabled="@_redirecting" @onclick="() => SuscribirseAsync(plan)">
                            Suscribirse
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>
}

@code{
    private Models.Subscription? _subscription;
    private int _administeredBuildingsCount;
    private List<Models.SubscriptionPlan> _purchasablePlans = [];
    private string? _paymentError;
    private bool _redirecting;
    private Guid _idUser;
    private string _userEmail = "";

    private Models.Account? _account;
    private List<Models.AccountUserView> _collaborators = [];
    private List<Models.AccountInvitation> _pendingInvitations = [];
    private string _inviteEmail = "";
    private string? _inviteError;
    private string? _inviteLink;
    private bool _inviting;

    // Administrador/SysAdmin siempre pueden editar (chequeo de rol, igual que
    // antes) -- el permiso "edit_account" (Database/Scripts/
    // 2026-09-22_137_Seed_EditAccountPermission.sql) es sólo para EXTENDER el
    // acceso a otro rol sin volverlo Administrador global, asignable desde
    // /roles. "view_account"/"export_account" no existen todavía -- no hay
    // nada que gatee lectura ni ninguna función de exportación de Account
    // (Docs/Pendientes-Negocio-Consolidado.md #30, punto b).
    private bool _canEditAccount;
    private bool _editingAccountInfo;
    private bool _savingAccount;
    private string? _accountSaveError;
    private Models.Account _accountForm = new();

    private string? _logoDataUri;
    private bool _subiendoLogo;
    private string? _logoError;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null) return;

        _idUser = currentUser.IdUser;
        _userEmail = currentUser.Email;
        _administeredBuildingsCount = currentUser.Buildings
            .Count(b => b.Role == "Administrador" && b.IsApproved);
        _canEditAccount = currentUser.Role is "Administrador" or "SysAdmin"
            || await PermissionService.HasPermissionAsync(currentUser, "edit_account");

        // No deja caerse toda la página de Settings si los scripts de Subscription
        // (Database/Scripts/2026-09-04_44_*.sql a _46_*.sql) todavía no corrieron
        // contra esta BD -- GetSubscriptionByUserAsync/GetAllPlansAsync relanzan la
        // excepción de SQL Server (procedure no existe), y acá simplemente se
        // muestra sin datos de suscripción ni planes para comprar.
        try
        {
            _subscription = await SubscriptionService.GetSubscriptionByUserAsync(_idUser);

            // Trial nunca se compra (no tiene Amount) -- y el plan en el que ya
            // está no tiene sentido reofrecérselo.
            var plans = await SubscriptionService.GetAllPlansAsync();
            _purchasablePlans = plans
                .Where(p => p.Amount.HasValue && p.IdSubscriptionPlan != _subscription?.IdSubscriptionPlan)
                .ToList();
        }
        catch (Exception)
        {
            _subscription = null;
            _purchasablePlans = [];
        }

        // Colaboradores (Docs/Design-Account-Facturacion.md): igual que arriba, no
        // deja caerse la página si la Account todavía no existe (registros de antes
        // de este feature) -- esa sección simplemente no se muestra.
        try
        {
            _account = await AccountService.GetAccountByUserAsync(_idUser);
            if (_account != null)
            {
                _collaborators = await AccountService.GetCollaboratorsAsync(_account.IdAccount);
                _pendingInvitations = await AccountService.GetPendingInvitationsAsync(_account.IdAccount);
                await CargarLogoAsync();
            }
        }
        catch (Exception)
        {
            _account = null;
        }
    }

    private void StartEditAccountInfo()
    {
        if (!_canEditAccount || _account == null) return;
        _accountSaveError = null;
        _accountForm = new Models.Account
        {
            IdAccount = _account.IdAccount,
            RazonSocial = _account.RazonSocial,
            RucDni = _account.RucDni,
            Telefono = _account.Telefono,
            AccountType = _account.AccountType,
            LegalRepresentative = _account.LegalRepresentative,
            FiscalAddress = _account.FiscalAddress,
            OfficeHours = _account.OfficeHours,
        };
        _editingAccountInfo = true;
    }

    private void CancelEditAccountInfo()
    {
        _editingAccountInfo = false;
        _accountSaveError = null;
    }

    private async Task SaveAccountInfoAsync()
    {
        if (!_canEditAccount || _account == null) return;
        _accountSaveError = null;
        _savingAccount = true;
        try
        {
            _account = await AccountService.UpdateAccountAsync(
                _account.IdAccount, _accountForm.RazonSocial, _accountForm.RucDni, _accountForm.Telefono,
                _accountForm.AccountType, _accountForm.LegalRepresentative, _accountForm.FiscalAddress,
                _accountForm.OfficeHours);
            _editingAccountInfo = false;
        }
        catch (Exception ex)
        {
            _accountSaveError = $"No se pudo guardar: {ex.Message}";
        }
        finally
        {
            _savingAccount = false;
        }
    }

    private async Task CargarLogoAsync()
    {
        if (_account == null) return;
        var logo = await AccountService.GetLogoAsync(_account.IdAccount);
        _logoDataUri = logo == null ? null : $"data:{logo.Value.ContentType};base64,{Convert.ToBase64String(logo.Value.Content)}";
    }

    private async Task SubirLogoAsync(InputFileChangeEventArgs e)
    {
        if (!_canEditAccount || _account == null) return;
        _logoError = null;
        var file = e.File;
        if (file is null) return;

        _subiendoLogo = true;
        try
        {
            // Techo de transporte por encima del límite real de negocio (2 MB,
            // validado adentro de AccountService.UploadLogoAsync) -- mismo criterio
            // que IncidentDetail.razor.SubirAdjunto, sin esto OpenReadStream usa un
            // default de 512 KB y cualquier logo real fallaría antes de validarse.
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            await AccountService.UploadLogoAsync(_account.IdAccount, file.Name, file.ContentType, memoryStream.ToArray());
            await CargarLogoAsync();
        }
        catch (ArgumentException ex)
        {
            _logoError = ex.Message;
        }
        catch (Exception ex)
        {
            _logoError = $"No se pudo subir el logo: {ex.Message}";
        }
        finally
        {
            _subiendoLogo = false;
        }
    }

    private async Task InviteAsync()
    {
        _inviteError = null;
        _inviteLink = null;
        if (_account == null || string.IsNullOrWhiteSpace(_inviteEmail))
            return;

        _inviting = true;
        try
        {
            var result = await AccountService.InviteCollaboratorAsync(_account.IdAccount, _inviteEmail, _idUser);
            if (!result.IsSuccess)
            {
                _inviteError = result.ErrorMessage;
                return;
            }

            var invitation = (Models.AccountInvitation)result.Data!;
            _inviteLink = $"{Navigation.BaseUri.TrimEnd('/')}/accept-invitation?code={invitation.Code}";
            _inviteEmail = "";
            _pendingInvitations = await AccountService.GetPendingInvitationsAsync(_account.IdAccount);
        }
        finally
        {
            _inviting = false;
        }
    }

    // Sólo texto informativo -- copiado de la landing (wwwroot/index.html,
    // sección "Planes para cada comunidad") para que se vea igual acá. No
    // limita ninguna funcionalidad de verdad todavía (ver
    // Docs/Design-Subscripcion-Administrador.md, "Cuarta vuelta").
    private static List<string> GetFeatures(string planName) => planName switch
    {
        "Basico" => ["Gestión de edificios", "Gestión económica básica", "Incidencias", "Alertas y comunicados", "Soporte por email"],
        "Profesional" => ["Todo lo del plan Básico", "Gestión económica avanzada", "Mantenimientos programados", "Documentación digital", "Portal para propietarios", "Soporte prioritario"],
        "Empresarial" => ["Todo lo del plan Profesional", "Múltiples edificios", "API para integraciones", "Informes personalizados", "Auditoría y cumplimiento", "Soporte 24/7"],
        _ => [],
    };

    private async Task SuscribirseAsync(Models.SubscriptionPlan plan)
    {
        _paymentError = null;
        _redirecting = true;
        try
        {
            var checkoutUrl = await PaymentService.CreateCheckoutSessionAsync(_idUser, _userEmail, plan.IdSubscriptionPlan);
            Navigation.NavigateTo(checkoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            _paymentError = $"No se pudo iniciar el pago: {ex.Message}";
            _redirecting = false;
        }
    }
}
