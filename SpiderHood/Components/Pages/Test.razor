@page "/test"
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>El Alcalde de Dacorí - Presupuesto Julio 2026</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Estilos para simular un fondo de página principal */
        .main-content {
            max-width: 1200px;
            width: 100%;
            padding: 20px;
        }

        .page-header {
            margin-bottom: 30px;
            text-align: center;
        }

        .page-title {
            font-size: 2rem;
            color: #1e3c72;
            margin-bottom: 10px;
        }

        .open-modal-btn {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 5px 15px rgba(30, 60, 114, 0.2);
        }

            .open-modal-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(30, 60, 114, 0.3);
            }

        /* Estilos del modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s;
            z-index: 1000;
        }

        #modal-toggle {
            display: none;
        }

            #modal-toggle:checked ~ .modal-overlay {
                opacity: 1;
                visibility: visible;
            }

        .modal-container {
            max-width: 900px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            background-color: white;
            border-radius: 16px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            animation: modalAppear 0.4s ease-out;
        }

        @*keyframes modalAppear {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }*@

        .modal-header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 30px 40px;
            position: relative;
        }

        .modal-header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .modal-title {
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .modal-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-top: 5px;
        }

        .status-badge {
            background-color: rgba(255, 255, 255, 0.2);
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .status-badge i {
                color: #4cd964;
            }

        .metadata {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .metadata-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .metadata-label {
            font-size: 0.85rem;
            opacity: 0.8;
        }

        .metadata-value {
            font-weight: 600;
            font-size: 1rem;
        }

        .modal-content {
            padding: 40px;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1e3c72;
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 2px solid #eef2f7;
        }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .category-card {
            background-color: #f9fafc;
            border-radius: 12px;
            padding: 22px;
            border-left: 5px solid;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.03);
        }

            .category-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
            }

            .category-card:nth-child(1) {
                border-color: #4a6fa5;
            }

            .category-card:nth-child(2) {
                border-color: #6a8eae;
            }

            .category-card:nth-child(3) {
                border-color: #8fb8de;
            }

            .category-card:nth-child(4) {
                border-color: #b8d4e3;
            }

            .category-card:nth-child(5) {
                border-color: #1e3c72;
            }

        .category-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .category-name {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
        }

        .category-percentage {
            background-color: rgba(30, 60, 114, 0.1);
            color: #1e3c72;
            padding: 4px 12px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .category-amount {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1e3c72;
            margin-bottom: 10px;
        }

        .progress-bar {
            height: 8px;
            background-color: #eef2f7;
            border-radius: 4px;
            overflow: hidden;
            margin-top: 15px;
        }

        .progress-fill {
            height: 100%;
            border-radius: 4px;
        }

        .category-card:nth-child(1) .progress-fill {
            width: 24.1%;
            background-color: #4a6fa5;
        }

        .category-card:nth-child(2) .progress-fill {
            width: 4.5%;
            background-color: #6a8eae;
        }

        .category-card:nth-child(3) .progress-fill {
            width: 7.4%;
            background-color: #8fb8de;
        }

        .category-card:nth-child(4) .progress-fill {
            width: 4.8%;
            background-color: #b8d4e3;
        }

        .category-card:nth-child(5) .progress-fill {
            width: 59.2%;
            background-color: #1e3c72;
        }

        .total-summary {
            background: linear-gradient(to right, #f8fafd, #eef2f7);
            border-radius: 12px;
            padding: 25px;
            margin-top: 30px;
            text-align: center;
            border: 1px solid #e1e8f0;
        }

        .total-label {
            font-size: 1.1rem;
            color: #5a6c7d;
            margin-bottom: 10px;
        }

        .total-amount {
            font-size: 2.5rem;
            font-weight: 800;
            color: #1e3c72;
        }

        .modal-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 40px;
            background-color: #f9fafc;
            border-top: 1px solid #eef2f7;
        }

        .modal-actions {
            display: flex;
            gap: 15px;
        }

        .modal-btn {
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
            border: none;
            font-size: 0.95rem;
            text-decoration: none;
        }

        .btn-close {
            background-color: #eef2f7;
            color: #5a6c7d;
        }

            .btn-close:hover {
                background-color: #e1e8f0;
            }

        .btn-save {
            background-color: #1e3c72;
            color: white;
        }

            .btn-save:hover {
                background-color: #2a5298;
                transform: translateY(-2px);
                box-shadow: 0 5px 10px rgba(30, 60, 114, 0.2);
            }

        .created-by {
            color: #5a6c7d;
            font-size: 0.9rem;
        }

            .created-by strong {
                color: #2c3e50;
            }

        .close-modal-label {
            position: absolute;
            top: 20px;
            right: 20px;
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.2rem;
            transition: background-color 0.3s;
            z-index: 10;
        }

            .close-modal-label:hover {
                background-color: rgba(255, 255, 255, 0.3);
            }

        @*media (max-width: 768px) {
            .categories-grid {
                grid-template-columns: 1fr;
            }

            .modal-header, .modal-content, .modal-footer {
                padding: 25px;
            }

            .modal-header-top {
                flex-direction: column;
                gap: 15px;
            }

            .modal-actions {
                width: 100%;
                justify-content: center;
                margin-bottom: 15px;
            }

            .modal-footer {
                flex-direction: column;
                gap: 20px;
            }

            .metadata {
                gap: 15px;
            }

            .modal-title {
                font-size: 1.8rem;
            }

            .modal-container {
                max-height: 95vh;
            }
        }

        @media (max-width: 480px) {
            .modal-title {
                font-size: 1.6rem;
            }

            .category-amount {
                font-size: 1.5rem;
            }

            .total-amount {
                font-size: 2rem;
            }
        }*@
    </style>
</head>
<body>
    <!-- Contenido principal de ejemplo -->
    <div class="main-content">
        <header class="page-header">
            <h1 class="page-title">Sistema de Gestión Presupuestaria</h1>
            <p>Municipalidad de Dacorí - Panel de Administración</p>
        </header>

        <!-- Botón para abrir el modal -->
        <label for="modal-toggle" class="open-modal-btn">
            <i class="fas fa-chart-pie"></i>
            Ver Presupuesto de Julio 2026
        </label>

        <div class="info-section">
            <p style="margin-top: 30px; color: #666; max-width: 600px; text-align: center;">
                Este es un ejemplo de interfaz donde el presupuesto se muestra en un modal.
                Haz clic en el botón de arriba para abrir el documento.
            </p>
        </div>
    </div>

    <!-- Checkbox para controlar la visibilidad del modal -->
    <input type="checkbox" id="modal-toggle" style="display: none;">

    <!-- Overlay y contenido del modal -->
    <div class="modal-overlay">
        <div class="modal-container">
            <!-- Botón para cerrar el modal (X en la esquina) -->
            <label for="modal-toggle" class="close-modal-label">
                <i class="fas fa-times"></i>
            </label>

            <header class="modal-header">
                <div class="modal-header-top">
                    <div>
                        <h1 class="modal-title">El Alcalde de Dacorí</h1>
                        <p class="modal-subtitle">Presupuesto Mensual - Julio 2026</p>
                    </div>
                    <div class="status-badge">
                        <i class="fas fa-circle-check"></i>
                        <span>CREATED</span>
                    </div>
                </div>

                <div class="metadata">
                    <div class="metadata-item">
                        <span class="metadata-label">Mes</span>
                        <span class="metadata-value">Julio 2026</span>
                    </div>
                    <div class="metadata-item">
                        <span class="metadata-label">Fecha de Creación</span>
                        <span class="metadata-value">14/01/2026</span>
                    </div>
                    <div class="metadata-item">
                        <span class="metadata-label">Documento ID</span>
                        <span class="metadata-value">PRES-JUL-2026-001</span>
                    </div>
                </div>
            </header>

            <main class="modal-content">
                <h2 class="section-title">Resumen por Categorías</h2>

                <div class="categories-grid">
                    <!-- Administración -->
                    <div class="category-card">
                        <div class="category-header">
                            <span class="category-name">Administración</span>
                            <span class="category-percentage">24.1%</span>
                        </div>
                        <div class="category-amount">S/ 800.00</div>
                        <div class="progress-bar">
                            <div class="progress-fill"></div>
                        </div>
                    </div>

                    <!-- Diversos -->
                    <div class="category-card">
                        <div class="category-header">
                            <span class="category-name">Diversos</span>
                            <span class="category-percentage">4.5%</span>
                        </div>
                        <div class="category-amount">S/ 150.00</div>
                        <div class="progress-bar">
                            <div class="progress-fill"></div>
                        </div>
                    </div>

                    <!-- Mantenimiento -->
                    <div class="category-card">
                        <div class="category-header">
                            <span class="category-name">Mantenimiento</span>
                            <span class="category-percentage">7.4%</span>
                        </div>
                        <div class="category-amount">S/ 245.00</div>
                        <div class="progress-bar">
                            <div class="progress-fill"></div>
                        </div>
                    </div>

                    <!-- RESERVAS -->
                    <div class="category-card">
                        <div class="category-header">
                            <span class="category-name">RESERVAS</span>
                            <span class="category-percentage">4.8%</span>
                        </div>
                        <div class="category-amount">S/ 160.00</div>
                        <div class="progress-bar">
                            <div class="progress-fill"></div>
                        </div>
                    </div>

                    <!-- Servicios Básicos -->
                    <div class="category-card">
                        <div class="category-header">
                            <span class="category-name">Servicios Básicos</span>
                            <span class="category-percentage">59.2%</span>
                        </div>
                        <div class="category-amount">S/ 1,970.00</div>
                        <div class="progress-bar">
                            <div class="progress-fill"></div>
                        </div>
                    </div>
                </div>

                <div class="total-summary">
                    <div class="total-label">PRESUPUESTO TOTAL</div>
                    <div class="total-amount">S/ 3,325.00</div>
                </div>
            </main>

            <footer class="modal-footer">
                <div class="modal-actions">
                    <!-- Usamos etiqueta label para cerrar el modal -->
                    <label for="modal-toggle" class="modal-btn btn-close">
                        <i class="fas fa-times"></i>
                        Cerrar
                    </label>

                    <!-- Botón de guardar que no cierra el modal -->
                    <a href="#" class="modal-btn btn-save" onclick="return false;">
                        <i class="fas fa-save"></i>
                        Guardar Cambios
                    </a>
                </div>
                <div class="created-by">
                    Documento creado por: <strong>Admin</strong>
                </div>
            </footer>
        </div>
    </div>

    <!-- Nota: No hay JavaScript en esta versión -->
</body>
</html>