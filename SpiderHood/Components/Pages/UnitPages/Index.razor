    // Métodos para clases CSS
    private string GetTypeBadgeClass(int type)
    {
        return type switch
        {
            1 => "bg-primary",
            4 => "bg-success",
            2 => "bg-info",
            3 => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private string GetStatusBadgeClass(string estado)
    {
        return estado switch
