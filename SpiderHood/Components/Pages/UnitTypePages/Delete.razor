@page "/unittypes/delete"
@using Microsoft.EntityFrameworkCore
@using SpiderHood.Models
@inject IDbContextFactory<SpiderHood.Data.SpiderHoodContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>UnitType</h2>
    <hr />
    @if (unittype is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@unittype.Type</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@unittype.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@unittype.Status</dd>
        </dl>
        <EditForm method="post" Model="unittype" OnValidSubmit="DeleteUnitType" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(unittype is null)">Delete</button> |
            <a href="/unittypes">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private UnitType? unittype;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        unittype = await context.UnitType.FirstOrDefaultAsync(m => m.Id == Id);

        if (unittype is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteUnitType()
    {
        using var context = DbFactory.CreateDbContext();
        context.UnitType.Remove(unittype!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/unittypes");
    }
}
