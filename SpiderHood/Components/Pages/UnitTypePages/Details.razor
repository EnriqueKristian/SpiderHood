@page "/unittypes/details"
@using Microsoft.EntityFrameworkCore
@using SpiderHood.Models
@inject IDbContextFactory<SpiderHood.Data.SpiderHoodContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>UnitType</h2>
    <hr />
    @if (unittype is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@unittype.Type</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@unittype.Description</dd>
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@unittype.Status</dd>
        </dl>
        <div>
            <a href="@($"/unittypes/edit?id={unittype.Id}")">Edit</a> |
            <a href="@($"/unittypes")">Back to List</a>
        </div>
    }
</div>

@code {
    private UnitType? unittype;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        unittype = await context.UnitType.FirstOrDefaultAsync(m => m.Id == Id);

        if (unittype is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
