@page "/unittypes/edit"
@using Microsoft.EntityFrameworkCore
@using SpiderHood.Models
@inject IDbContextFactory<SpiderHood.Data.SpiderHoodContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>UnitType</h2>
<hr />
@if (UnitType is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="UnitType" OnValidSubmit="UpdateUnitType" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="UnitType.Id" value="@UnitType.Id" />
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="type" class="form-label">Type:</label>
                    <InputText id="type" @bind-Value="UnitType.Type" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => UnitType.Type" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="UnitType.Description" class="form-control" />
                    <ValidationMessage For="() => UnitType.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status:</label>
                    <InputNumber id="status" @bind-Value="UnitType.Status" class="form-control" />
                    <ValidationMessage For="() => UnitType.Status" class="text-danger" />
                </div>
                
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/unittypes">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    [SupplyParameterFromForm]
    private UnitType? UnitType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        UnitType ??= await context.UnitType.FirstOrDefaultAsync(m => m.Id == Id);

        if (UnitType is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateUnitType()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(UnitType!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!UnitTypeExists(UnitType!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/unittypes");
    }

    private bool UnitTypeExists(Guid id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.UnitType.Any(e => e.Id == id);
    }
}
