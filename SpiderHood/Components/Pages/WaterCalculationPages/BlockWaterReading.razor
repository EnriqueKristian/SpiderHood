    private string GetRowClass(ServiceReadingDetail lectura)
    {
        if (!lectura.Procesed)
            return "table-warning";

        if (lectura.Minimum)
            return "table-info";

        if (lectura.Consumption > 100 )
            return "table-danger";

        return "";
    }

    private string GetRowTooltip(ServiceReadingDetail lectura)
    {
        if (!lectura.Procesed)
            return "Lectura pendiente de procesar";

        if (lectura.Minimum)
            return $"Consumo mínimo/personalizado aplicado ({lectura.Consumption} m³)";

        if (lectura.Consumption > 100 )
            return $"Consumo alto detectado ({lectura.Consumption} m³)";

        return $"Consumo: {lectura.Consumption:F2} m³ | Monto: S/ {lectura.CalculatedAmount:F2}";
    }

