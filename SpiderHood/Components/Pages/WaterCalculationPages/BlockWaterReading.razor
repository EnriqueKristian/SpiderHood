@using SpiderHood.Components.Pages.Components
@using SpiderHood.Components.Pages.PeriodPages
@using SpiderHood.Models
@using SpiderHood.Services
@using SpiderHood.Utilities
@using System.Globalization
@inject ICalculoService CalculoService
@inject NavigationManager Navigation
@inject ParameterService ParameterService
@using ClosedXML.Excel
@inject IJSRuntime JSRuntime



<script src="/js/fileDownload.js"></script>
<script src="/js/utilidades.js"></script>

<div class="lectura-bloque-container">
    <div class="card mb-4">
        <div class="card-body">
            <!-- Selector de período -->
            <div class="row align-items-center">
                <!-- Período -->
                <div class="col-md-4">
                    <div class="card">
                        <div style="padding-left:20px; padding-right:20px;">
                            <div class="form-group">
                                <label class="form-label"><strong>Período:</strong></label>
                                <select @bind="_ultimoPeriodo" class="form-select" @bind:event="onchange" @bind:after="() => CargarPeriodo(_ultimoPeriodo)" disabled="@_ServiceReadingState.OpenFromModal">
                                    @foreach (var item in _periods.OrderBy(c => c.StartDate))
                                    {
                                        <option value="@item.StartDate">@item.StartDate.ToString("MMM-yy")</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Cargo Fijo -->
                        <div style="padding-left:20px; padding-right:20px;">
                            <div class="form-group">
                                <label class="form-label"><strong>Cargo Fijo:</strong></label>
                                <div class="input-group">
                                    <span class="input-group-text">S/</span>
                                    <InputNumber @bind-Value="_ServiceReadingState.CargoFijo" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if(_ServiceReadingState.CurrentReading.Status < 2 ){
                    <!-- Importar Excel -->
                    <div class="col-md-5">
                        <div class="card" disabled="@(!_ServiceReadingState.OpenFromModal)">
                            <div class="card-body">
                            
                                <div class="mb-3">
                                    <!-- InputFile oculto -->
                                    <InputFile id="fileInput"
                                                OnChange="CargarArchivoExcel"
                                                accept=".xlsx,.xls,.csv"
                                                style="display:none;" />

                                    <!-- Botón para abrir el selector de archivos -->
                                    <div class="text-center">
                                        <button class="btn btn-primary btn-lg" @onclick="AbrirSelectorArchivo">
                                            <i class="bi bi-cloud-upload mr-2"></i>
                                            Importar Lecturas de Agua
                                        </button>

                                        <div class="summary">
                                            <div><i class="bi bi-info-circle"></i> Formatos aceptados: .xlsx, .xls</div>
                                            <div>
                                                <i class="bi bi-download"></i>
                                                <a href="javascript:void(0)" @onclick="ExportarPlantillaVacia">
                                                    Descargar plantilla
                                                </a>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            
                            
                                @if (!string.IsNullOrEmpty(_archivoNombre))
                                {
                                    <div class="alert alert-success">
                                        <i class="bi bi-check-circle mr-2"></i>
                                        @_archivoNombre (@_lecturasCargadas.Count registros)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                <!-- Lecturas Procesadas -->
                <div class="col-md-3">
                    <div class="card">
                        <div class="display-6 text-primary" style="padding-left:20px; padding-right:20px;">@_ServiceReadingState.CurrentReadingDetail.Count</div>
                        <div class="text-muted" style="padding-left:20px; padding-right:20px;">Lecturas procesadas</div>
                    </div>
                </div>
            </div>
            <!-- Indicador de carga global -->
            @if (util._isLoading)
            {
                        <div class="loading-overlay">
                            <div class="loading-card shadow">
                                <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>

                                <div class="mt-3 text-center">
                                    <strong>@util._currentOperation</strong>
                                    <p class="text-muted small mb-0">Por favor espere…</p>
                                </div>
                            </div>
                        </div>
            }
            
            <!-- Mensajes de estado -->
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <p></p>
                <div class="alert @(mensaje.Contains("éxito") ? "alert-success" : mensaje.Contains("Error") ? "alert-danger" : "alert-warning") alert-dismissible fade show">
                    <div class="d-flex align-items-center">
                        <i class="bi @(mensaje.Contains("éxito") ? "bi-check-circle-fill" : mensaje.Contains("Error") ? "bi-exclamation-triangle-fill" : "bi-info-circle-fill") me-2"></i>
                        <div>
                            <strong>@mensaje</strong>
                            <br />
                            @if (mensaje.Contains("Error"))
                            {
                                @foreach (var error in _ServiceReadingState.CurrentReading.ValidationErrors!.Errors)
                                {
                                    <label>@error.Code: @error.Message</label><br />
                                }
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
                </div>
            }

            <!-- Tabla de lecturas -->
            @if (_ServiceReadingState.CurrentReadingDetail.Any())
            {
                <!-- Controles específicos para lecturas -->
                <div class="row mb-2">
                    <div class="d-flex align-items-center gap-3 mt-2 mt-md-0">
                        <div style="width:60%">
                            <h3 class="h5 mb-0">
                                <i class="bi bi-table me-2"></i>Vista previa de datos
                            </h3>
                            <p class="text-muted mb-0 mt-1">
                                Mostrando @_pagination.StartRecord - @_pagination.EndRecord de @_pagination.TotalRecords registros
                            </p>
                        </div>
                        <div class="col-md-3">
                            <InputText type="text" class="form-control border-start-0"
                                       placeholder="Buscar Departamento ..."
                                       @bind-Value="@searchTerm"
                                       @oninput="OnSearch" />
                        </div>
                        <!-- Filtro por estado -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-funnel me-1"></i>
                                @(selectedFilter == "all" ? "Todos" :
                                                            selectedFilter == "valid" ? "Válidos" :
                                                            selectedFilter == "duplicate" ? "Duplicados" :
                                                            "Con error")
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var filter in filters)
                                {
                                    <li>
                                        <a class="dropdown-item @(selectedFilter == filter ? "active" : "")"
                                           @onclick="() => ChangeFilter(filter)">
                                            @GetFilterLabel(filter)
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <!-- Selector de página -->
                        <div class="d-flex align-items-center">
                            <label class="me-2 text-muted">Mostrar:</label>
                            <select class="form-select form-select-sm" style="width: auto;"
                                    @onchange="(e) => ChangePageSize(Convert.ToInt32(e.Value))">
                                <!option value="10" selected="@(pageSize == 10)">10</!option>
                                <!option value="25" selected="@(pageSize == 25)">25</!option>
                                <!option value="50" selected="@(pageSize == 50)">50</!option>
                                <!option value="100" selected="@(pageSize == 100)">100</!option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-4">
                    
                    <table class="table table-bordered table-hover table-striped">
                        <thead>
                            <tr>
                                <th @onclick="() => SortColumn(GroupNumber)" style="cursor: pointer;">DPTO @_pagination.GetSortIndicator("GroupNumber")</th>
                                <th><i class="bi bi-calendar3"></i> PERÍODO</th>
                                <th><i class="bi bi-fingerprint"></i> ID LECTURA</th>
                                <th><i class="bi bi-clock-history"></i> LECTURA ANTERIOR</th>
                                <th><i class="bi bi-lightning-charge"></i> LECTURA ACTUAL</th>
                                <th @onclick="() => SortColumn(Consumption)" style="cursor: pointer;"><i class="bi bi-droplet"></i> CONSUMO (M³) @_pagination.GetSortIndicator("Consumption")</th>
                                <th @onclick="() => SortColumn(CalculatedAmount)" style="cursor: pointer;"><i class="bi bi-cash-coin"></i> MONTO TOTAL @_pagination.GetSortIndicator("CalculatedAmount")</th>
                                <th><i class="bi bi-gear-fill"></i> ACCIONES</th>
                            </tr>
                        </thead>
                        <tbody>
                            
                            @foreach (var lectura in  _pagination.CurrentPageData ) //_ServiceReadingState.CurrentReadingDetail)
                            {
                                <!--tr class="@(!lectura.Minimum ? "table-success" : "table-warning")"-->

                                <tr class="@GetRowClass(lectura)"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="@GetRowTooltip(lectura)">



                                    <td>@lectura.GroupNumber</td>
                                    <td>@lectura.Period.ToString("MMM-yy", new CultureInfo("es-ES"))</td>
                                    <td><small class="text-muted">@lectura.Code</small></td>
                                    <td align="right">@lectura.PreviousReading.ToString("F3")</td>
                                    <td align="right">
                                        <strong>@lectura.CurrentReading.ToString("F3")</strong>
                                    </td>
                                    <td align="right">
                                        @if (lectura.Procesed)
                                        {
                                            <span class="badge @(!lectura.Minimum ? "bg-primary" : "bg-danger")">
                                                @lectura.Consumption.ToString("F2") m³
                                            </span>
                                        }
                                        else{
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-danger dropdown-toggle"
                                                        type="button"
                                                        data-bs-toggle="dropdown">
                                                    Posibles Actions
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <a class="dropdown-item"
                                                           @onclick="() => ApplyMinimun(lectura)">
                                                            <div class="d-flex justify-content-between">
                                                                <span>Minimo</span>
                                                                <span class="text-muted">@ParameterService.CurrentBuilding.Configuration.MinWaterConsumtion</span>
                                                            </div>
                                                            <small class="text-muted">Aplicar Minimo</small>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item">
                                                            <div class="d-flex justify-content-between">
                                                                <span>Otro</span>
                                                                <span class="text-muted">@_anotherValue</span>
                                                            </div>
                                                            <InputNumber @bind-Value="_anotherValue" class="form-control" @onkeypress="async (e) => await onKeyPress(lectura, e)" />
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                            }
                                    </td>
                                    <td align="right">
                                            <strong class="text-success">
                                            S/ @lectura.CalculatedAmount.ToString("F2")
                                            </strong>
                                    </td>
                                    <td>
                                        <button @onclick="() => SeleccionarLectura(lectura)"
                                                class="btn btn-info btn-sm mr-1"
                                                title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="6" class="text-end"><strong>TOTAL GENERAL:</strong></td>
                                <td colspan="2">
                                    <strong class="text-primary">
                                        S/ @TotalGeneral.ToString("F2")
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Reutilizar el mismo componente de paginación -->
                <PaginationControls _pagination="@_pagination" />

                <p></p>

                @if (!_ServiceReadingState.OpenFromModal && _ServiceReadingState.CurrentReading.Status < 2)
                {
                    <!-- Botones de acción -->
                    <div class="d-flex justify-content-between">
                        <button @onclick="ExportarAExcel" class="btn btn-success">
                            <i class="bi bi-file-earmark-excel mr-2"></i>&nbsp;Exportar a Excel
                        </button>
                        @if (_ServiceReadingState.ShowSaveReadings) // !_error )
                        {
                        <button @onclick="GuardarLecturas" class="btn btn-primary">
                            <i class="bi bi-floppy mr-2"></i>&nbsp;Guardar Lecturas
                        </button>
                    }
                    <button @onclick="LimpiarDatos" class="btn btn-danger">
                        <i class="bi bi-trash mr-2"></i>&nbsp;Limpiar Todo
                    </button>
                </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-arrow-down bi-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No hay lecturas cargadas</h4>
                    <p class="text-muted">Importe un archivo Excel o ingrese lecturas manualmente</p>
                </div>
            }
        </div>
    </div>

    <!-- Modal para detalle de cálculo -->
    @if (_lecturaSeleccionada != null && _lecturaSeleccionada.CalculationDetail != null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5)">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="bi bi-calculator mr-2"></i>
                            Detalle de Cálculo - Dpto @_lecturaSeleccionada.GroupNumber
                        </h5>
                        <button @onclick="CerrarModalDetalle" class="btn-close btn-close-white"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Consumo:</strong> @_lecturaSeleccionada.Consumption.ToString("F2") m³
                            </div>
                            <div class="col-md-6">
                                <strong>Período:</strong> @_ServiceReadingState.CurrentReading.Period.ToString("MMMM yy")
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr class="table-secondary">
                                        <th align="center">Rango</th>
                                        <th align="center">Consumo (m³)</th>
                                        <th align="center">Tarifa Unit.</th>
                                        <th align="center">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in _lecturaSeleccionada.CalculationDetail.Detalles)
                                    {
                                        <tr>
                                            <td>@detalle.Rango</td>
                                            <td align="right">@detalle.Consumo.ToString("F2")</td>
                                            <td align="right">S/ @detalle.Tarifa.ToString("F3")</td>
                                            <td align="right">S/ @detalle.Monto.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end">Subtotal:</td>
                                        <td align="right">S/ @_lecturaSeleccionada.CalculationDetail.Subtotal.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end">Cargo Fijo:</td>
                                        <td align="right">S/ @_lecturaSeleccionada.CalculationDetail.CargoFijo.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end">Total sin IGV:</td>
                                        <td align="right">S/ @_lecturaSeleccionada.CalculationDetail.TotalSinIGV.ToString("F2")</td>
                                    </tr>
                                    <tr class="table-primary">
                                        <td colspan="3" class="text-end"><strong>TOTAL + IGV:</strong></td>
                                        <td align="right"><strong>S/ @_lecturaSeleccionada.CalculationDetail.TotalConIGV.ToString("F2")</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button @onclick="CerrarModalDetalle" class="btn btn-secondary">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<PeriodForm ShowModal="ShowModalPeriod" isNew="@isNewPeriod" OnSave="SavePeriod" period="period" />

@code {

    [Inject] private IServiceReadingService ServiceReadingService { get; set; } = default!;
    [Inject] private IBuildingService BuildingService { get; set; } = default!;

    private string @GroupNumber = "GroupNumber";
    private string @Consumption = "Consumption";
    private string CalculatedAmount = "CalculatedAmount";


    private bool ShowModalPeriod = false;
    private bool isNewPeriod = false;
    private Models.Period period = new();


    [Parameter] public DateTime _period { get; set; }
    [Parameter] public EventCallback<ServiceReadingState> OnSaveReady { get; set; }

    // Constantes y configuración
    private const decimal CARGO_FIJO_DEFAULT = 5.04m;

    // Estado del componente

    private List<ServiceReadingDetail> _lecturasCargadas = new();
    private ServiceReadingDetail? _lecturaSeleccionada;
    private string _archivoNombre = string.Empty;
    private IBrowserFile? _archivoExcel;

    private DateTime _ultimoPeriodo;
    private DateTime _periodoActual = DateTime.Now;

    //private bool _esPrimeraCarga = false;
    private string mensaje = "";
    private double _anotherValue = 0;

    private List<Period> _periods = new();
    private Period _currentPeriod = new();
    private ConfirmationUtil util = new ConfirmationUtil();

    private ServiceReadingState _ServiceReadingState = new();
    private List<ServiceReading> readings = new();

    // Propiedades calculadas
    private decimal TotalGeneral => _ServiceReadingState.CurrentReadingDetail
        .Sum(l => l.CalculatedAmount);

    private bool HayLecturasCargadas => _lecturasCargadas.Any();
    private bool HayLecturasProcesadas => _ServiceReadingState.CurrentReadingDetail.Any();
    private bool PuedeGuardar => HayLecturasProcesadas && _ServiceReadingState.CurrentReadingDetail.All(l => l.Procesed);

    public record SaveReadyArgs(bool PuedeGuardar, decimal TotalAmount);

    public async Task GuardarLectura()
    {
        // lógica de guardado
        await GuardarLecturas();
        Console.WriteLine("Guardando lectura desde LecturaBloque...");
    }

    private async Task onKeyPress(ServiceReadingDetail lectura, KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Task.Delay(500); // Asegurar que cambiara el valor
            _ = RecalcularLectura(lectura, _anotherValue);
            _anotherValue = 0;
        }
    }

    private async Task ApplyMinimun(ServiceReadingDetail lectura)
    {
        _ = RecalcularLectura(lectura, (double)ParameterService.CurrentBuilding.Configuration.MinWaterConsumtion);
        await OnSaveReady.InvokeAsync(_ServiceReadingState);
    }

    protected override async Task OnInitializedAsync()
    {
        if (ParameterService.CurrentBuilding == null) return;
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        try
        {
            _ServiceReadingState.CargoFijo = CARGO_FIJO_DEFAULT;

            // Cargar periodos desde BD
            _periods = await ParameterService.GetPeriodsAsync(ParameterService.CurrentBuilding.IdBuilding);

            // Determinar si es primera carga
            if (_periods.Count == 0)
            {
                ShowModalPeriod = true;
                isNewPeriod = true;
                period = await ParameterService.CreateNewPeriod(DateTime.Today, ParameterService.CurrentBuilding.IdBuilding);
            }
            else { 
                // Configurar periodo inicial
                await ConfigurarPeriodoInicial();

                // Cargar lecturas del periodo anterior
                await CargarPeriodo(_periodoActual);
            }
        }
        catch (Exception ex)
        {
            // TODO: Implementar logging de errores
            Console.WriteLine($"Error al cargar datos iniciales: {ex.Message}");
        }
    }

    private async Task ConfigurarPeriodoInicial()
    {
        //Obtener el último período registrado
        readings = await CalculoService.GetServiceReadingsAsync(ParameterService.CurrentBuilding.IdBuilding);

        _ServiceReadingState.Period = _period;

        if (_period == DateTime.MinValue)
            _ultimoPeriodo = (DateTime)_periods.MaxBy(x => x.StartDate)?.StartDate!;
        else
            _ultimoPeriodo = _period;

        if (!_periods.Any(p => p.StartDate == _ultimoPeriodo))
        {
            await CrearNuevoPeriodo();
        }
        _periodoActual = _ultimoPeriodo;
    }

    private async Task CrearNuevoPeriodo()
    {
        Period newPeriod = ParameterService.CreateNewPeriod(_ultimoPeriodo, ParameterService.CurrentBuilding.IdBuilding).Result;
        _periods.Add(newPeriod);
        _currentPeriod = newPeriod;
    }

    private async Task CargarPeriodo(DateTime periodo)
    {
        try
        {
            await util.StartLoading("Loading from BD");
            mensaje = string.Empty;
            _periodoActual = periodo;

            _periods = _periods.OrderBy(c => c.StartDate).ToList();

            var periodoExistente = _periods.FirstOrDefault(p => p.StartDate == periodo);

            if (periodoExistente != null)
            {
                _ServiceReadingState.CurrentReading = readings.Where(c => c.Period == periodo).FirstOrDefault()!;

                if (_ServiceReadingState.CurrentReading == null)
                {
                    var nuevoPeriodo = new ServiceReading
                    {
                        IdServiceReading = Guid.NewGuid(),
                        Status = 1,
                        IdBuilding = ParameterService.CurrentBuilding.IdBuilding,
                        Period = _ultimoPeriodo,
                        CreatedOn = DateTime.Now,
                        IdPeriod = periodoExistente.IdPeriod
                    };
                    _ServiceReadingState.CurrentReading = nuevoPeriodo;
                }

                _ServiceReadingState.CurrentReadingDetail = await CalculoService.ObtenerLecturasPorPeriodoAsync(periodo);

                if (_ServiceReadingState.CurrentReadingDetail.Count > 0)
                {
                    MarcarTodasComoProcesadas();
                    await RecalcularTodas();
                }
                else
                {
                    var periodoAnterior = periodo.AddMonths(-1);
                    _ServiceReadingState.PreviousReadingDetail = await CalculoService.ObtenerLecturasPorPeriodoAsync(periodoAnterior);
                }

                await OnSaveReady.InvokeAsync(_ServiceReadingState);

                _pagination.Initialize(_ServiceReadingState.CurrentReadingDetail);
                // Suscribirse a cambios en la paginación
                _pagination.OnPaginationChanged += StateHasChanged;
            }
        }
        catch (Exception ex)
        {
            // TODO: Mostrar mensaje de error al usuario
            Console.WriteLine($"Error al cargar periodo: {ex.Message}");
        }
        finally{
            util.StopLoading();
            StateHasChanged();
        }
    }

    // Método para abrir el selector de archivos
    private async Task AbrirSelectorArchivo()
    {
        await JSRuntime.InvokeVoidAsync("clickElement", "fileInput");
    }

    private async Task CargarArchivoExcel(InputFileChangeEventArgs e)
    {
        try
        {
            _archivoExcel = e.File;
            _archivoNombre = _archivoExcel.Name;
            mensaje = string.Empty;
            //await util.StartLoading("Cargando desde Excel...");

            if (_archivoExcel.Size > 10 * 1024 * 1024) // 10MB límite
            {
                // TODO: Mostrar error de archivo muy grande
                return;
            }

            using var stream = _archivoExcel.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            _ServiceReadingState.CurrentReading.FileName = _archivoNombre;
            _ServiceReadingState.CurrentReading.Period = _periodoActual;

            if (_ServiceReadingState.PreviousReadingDetail == null || !_ServiceReadingState.PreviousReadingDetail.Any())
            {
                _ServiceReadingState.PreviousReadingDetail = await CalculoService.GetFirstWaterReadingDetailList(ParameterService.CurrentBuilding.IdBuilding);
            } 

            _ServiceReadingState.CurrentReading = await CalculoService.ImportarDesdeExcelAsync(
                memoryStream,
                _ServiceReadingState.CurrentReading,
                _ServiceReadingState.PreviousReadingDetail);

            _lecturasCargadas = _ServiceReadingState.CurrentReading.WaterReadingDetail ?? new List<ServiceReadingDetail>();

            if (_ServiceReadingState.CurrentReading.HasErrors)
            {
                int erroresEncontrados = _ServiceReadingState.CurrentReading.ValidationErrors!.Errors.Count();

                mensaje = $"Archivo '{_archivoNombre}' con errores. "
                    + Environment.NewLine
                    + $"Se encontraron ({erroresEncontrados}) errores."
                    + Environment.NewLine
                    + "El formato debe ser: DPTO | Periodo | Lectura Actual | Fecha Lectura";
            }

            //errorProcesamiento = _lecturaActual.errors;
            await ProcesarLecturasCargadas();

            await OnSaveReady.InvokeAsync(_ServiceReadingState);

            _pagination.Initialize(_ServiceReadingState.CurrentReadingDetail);
            // Suscribirse a cambios en la paginación
            _pagination.OnPaginationChanged += StateHasChanged;

            //_toast.ShowSuccess("Lecturas cargadas exitosamente");
            Console.WriteLine($"Lecturas cargadas exitosamente");

        }
        catch (Exception ex)
        {
            // TODO: Mostrar mensaje de error al usuario
            Console.WriteLine($"Error al cargar archivo: {ex.Message}");
            //_toast.ShowSuccess($"Error al cargar archivo: {ex.Message}");
