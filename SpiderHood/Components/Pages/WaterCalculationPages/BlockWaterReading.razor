    private async Task ProcesarLecturasCargadas()
    {
        if (!_lecturasCargadas.Any()) return;

        if ( _ServiceReadingState.PreviousReadingDetail.Any(c => c.CurrentReading  == 0) ) //_esPrimeraCarga)
        {
            _ServiceReadingState.CurrentReadingDetail = _lecturasCargadas;
            MarcarTodasComoProcesadas();
        }
        else
        {
            _ServiceReadingState.CurrentReadingDetail = await CalculoService.ProcesarLecturasBloqueAsync(
                _lecturasCargadas,
                _ServiceReadingState.CargoFijo
            );
        }

        StateHasChanged();
    }

    private void MarcarTodasComoProcesadas()
    {
        foreach (var lectura in _ServiceReadingState.CurrentReadingDetail)
        {
            lectura.Procesed = true;
            lectura.Minimum = lectura.Minimum ? lectura.Minimum : lectura.Consumption <= 0;
        }
    }

    private async Task RecalcularLectura(ServiceReadingDetail lectura, double value)
    {
        try
        {
            var consumo = lectura.Consumption == 0 ?
                                value : lectura.Consumption;

            var calculo = await CalculoService.CalcularConsumoAsync(consumo, _ServiceReadingState.CargoFijo);

            lectura.CalculationDetail = calculo;
            lectura.CalculatedAmount = calculo.TotalConIGV;
            lectura.Minimum = lectura.Minimum ? lectura.Minimum : lectura.Consumption <= 0;
            lectura.Consumption = consumo;
            lectura.Procesed = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            // TODO: Mostrar error al recalcular
            Console.WriteLine($"Error al recalcular: {ex.Message}");
        }
    }

    private async Task RecalcularTodas()
    {
        foreach (var lectura in _ServiceReadingState.CurrentReadingDetail.Where(l => l.Procesed))
        {
            await RecalcularLectura(lectura, (double)ParameterService.CurrentBuilding.Configuration.MinWaterConsumtion);
        }
    }

