    private async Task CambiarCargoFijo(decimal nuevoCargoFijo)
    {
        _ServiceReadingState.CargoFijo = nuevoCargoFijo;

        // Recalcular todas las lecturas con nuevo cargo fijo
        foreach (var lectura in _ServiceReadingState.CurrentReadingDetail)
        {
            if (lectura.Procesed)
            {
                await RecalcularLectura(lectura, (double)ParameterService.CurrentBuilding.Configuration.MinWaterConsumtion);
            }
        }

        await MostrarMensajeExito($"Cargo fijo actualizado a {nuevoCargoFijo:C}");
    }

    private async Task SincronizarConPeriodoAnterior()
    {
        try
        {
            if (!_ServiceReadingState.PreviousReadingDetail.Any())
            {
                await MostrarMensajeError("No hay datos del periodo anterior");
                return;
            }

            foreach (var lecturaActual in _ServiceReadingState.CurrentReadingDetail)
            {
                var lecturaAnterior = _ServiceReadingState.PreviousReadingDetail
            .FirstOrDefault(l => l.GroupNumber == lecturaActual.GroupNumber);

                if (lecturaAnterior != null)
                {
                    // Copiar datos relevantes del periodo anterior
                    lecturaActual.PreviousReading = lecturaAnterior.CurrentReading;
                    // TODO: Agregar más campos según sea necesario
                }
            }

            await MostrarMensajeExito("Datos sincronizados con periodo anterior");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await MostrarMensajeError($"Error en sincronización: {ex.Message}");
        }
    }

