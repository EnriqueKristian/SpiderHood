    private async Task GuardarLecturas()
    {
        using var context = await ParameterService.ContextFactory().CreateDbContextAsync();

        using var transaction = await context.Database.BeginTransactionAsync();

        using (transaction)

        try
        {
            if (!PuedeGuardar)
            {
                // TODO: Mostrar mensaje de que faltan procesar lecturas
                return;
            }

            //agregar periodo
            if (_periods.Where(c => c.IsNewPeriod).Count() > 0)
            {
                await ServiceReadingService.AddPeriodAsync(_currentPeriod);
            }

            // Asignar detalles procesados a la lectura actual
            _ServiceReadingState.CurrentReading.TotalAmount = TotalGeneral;

            // Guardar en base de datos
            await ServiceReadingService.AddServiceReadingAsync(_ServiceReadingState.CurrentReading);

            // Guardar en base de datos
            await ServiceReadingService.AddServiceReadingDetailAsync(_ServiceReadingState.CurrentReading.WaterReadingDetail!);

            await transaction.CommitAsync();

            //await MostrarMensajeExito("Lecturas guardadas exitosamente");
            await ShowToast("Info", $"Lecturas guardadas exitosamente.", "success");

            LimpiarDatos();

            _periods = await ParameterService.GetPeriodsAsync(ParameterService.CurrentBuilding.IdBuilding);

            await ConfigurarPeriodoInicial();

            await CargarPeriodo(_periodoActual);

        }
        catch (Exception ex)
        {
            // TODO: Mostrar mensaje de error
            await transaction.RollbackAsync();
            //await MostrarMensajeError($"Error al guardar lecturas: {ex.Message}");
            await ShowToast("Error", $"Error al guardar lecturas: {ex.Message}", "danger");
        }
        finally
        {
            StateHasChanged();
        }
    }

