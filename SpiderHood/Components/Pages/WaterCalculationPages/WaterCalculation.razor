@code {
    private Departamento departamento = new();
    private decimal cargoFijo = 5.04m;
    private CalculoResultado? resultado;
    private List<ConsumoHistorico> historicoConsumo = new();
    private List<TarifaAgua> tarifas = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarTarifas();
        await CargarHistorico();
    }

    private async Task CargarTarifas()
    {
        tarifas = await CalculoService.ObtenerTarifasAsync();
    }

    private async Task CargarHistorico()
    {
        if (departamento.Id > 0)
        {
            historicoConsumo = await CalculoService.ObtenerHistoricoAsync(departamento.Id);
        }
    }

    private async Task Calcular()
    {
        if (departamento.ConsumoActual > 0)
        {
            resultado = await CalculoService.CalcularConsumoAsync(departamento.ConsumoActual, cargoFijo);
        }
    }

    private async Task GuardarLectura()
    {
        if (departamento.ConsumoActual > 0)
        {
            await CalculoService.GuardarLecturaAsync(departamento);
            await CargarHistorico();
            await Calcular();
        }
    }
}