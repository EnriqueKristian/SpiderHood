@page "/workflow"
@rendermode InteractiveServer
@using SpiderHood.Models
@using SpiderHood.Services
@inject IWorkflowService WorkflowService
@inject IJSRuntime JSRuntime

<PageTitle>Catálogo de Workflows</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="page-header">
        <div class="page-header-title">
            <div class="icon-badge">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1">Catálogo de Workflows</h1>
                <p class="text-muted mb-0">Documenta y trackea los flujos de negocio de la app y su estado de implementación</p>
            </div>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="ShowCreateWorkflowModal">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Workflow
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Estadísticas -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm">
                            <i class="bi bi-diagram-3"></i>
                        </div>
                        <div>
                            <div class="stat-label">Total Workflows</div>
                            <div class="stat-value">@_workflows.Count</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm icon-badge-success">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div>
                            <div class="stat-label">Implementados</div>
                            <div class="stat-value">@_workflows.Count(w => w.Status == WorkflowImplementationStatus.Implementado)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm icon-badge-warning">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div>
                            <div class="stat-label">En Desarrollo</div>
                            <div class="stat-value">@_workflows.Count(w => w.Status == WorkflowImplementationStatus.EnDesarrollo)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-badge icon-badge-sm icon-badge-secondary">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div>
                            <div class="stat-label">Pendientes</div>
                            <div class="stat-value">@_workflows.Count(w => w.Status == WorkflowImplementationStatus.Pendiente)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!_workflows.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-body text-center py-5">
                    <i class="bi bi-diagram-3 text-muted display-4"></i>
                    <h5 class="text-muted mb-2 mt-3">No hay workflows registrados</h5>
                    <p class="text-muted mb-3">Documentá acá los flujos de negocio de la app (aprobaciones, conciliaciones, etc.) y su estado de implementación.</p>
                    <button class="btn btn-primary" @onclick="ShowCreateWorkflowModal">
                        <i class="bi bi-plus-circle me-2"></i>Agregar el Primer Workflow
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var workflow in _workflows.OrderBy(w => w.Name))
                {
                    <div class="col-12 mb-3">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-transparent border-bottom py-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleExpanded(workflow.IdWorkflow)" title="Mostrar/ocultar pasos">
                                            <i class="bi @(_expanded.Contains(workflow.IdWorkflow) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                        </button>
                                        <div>
                                            <h5 class="card-title mb-0">@workflow.Name</h5>
                                            @if (!string.IsNullOrWhiteSpace(workflow.Description))
                                            {
                                                <p class="text-muted mb-0 small">@workflow.Description</p>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @GetStatusBadgeClass(workflow.Status)">@GetStatusLabel(workflow.Status)</span>
                                        @if (workflow.TotalSteps > 0)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @workflow.ImplementedSteps / @workflow.TotalSteps pasos implementados
                                            </span>
                                        }
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" title="Editar" @onclick="() => ShowEditWorkflowModal(workflow)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" title="Eliminar" @onclick="() => ConfirmDeleteWorkflow(workflow)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (_expanded.Contains(workflow.IdWorkflow))
                            {
                                <div class="card-body">
                                    @if (!workflow.Steps.Any())
                                    {
                                        <p class="text-muted mb-2">Todavía no tiene pasos definidos.</p>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush mb-3">
                                            @foreach (var step in workflow.Steps.OrderBy(s => s.StepOrder))
                                            {
                                                <div class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                        <div class="d-flex align-items-start gap-2">
                                                            <span class="badge bg-secondary">@step.StepOrder</span>
                                                            <div>
                                                                <div class="fw-semibold">
                                                                    @step.Name
                                                                    @if (!string.IsNullOrWhiteSpace(step.Responsible))
                                                                    {
                                                                        <span class="text-muted small ms-1">— @step.Responsible</span>
                                                                    }
                                                                </div>
                                                                @if (!string.IsNullOrWhiteSpace(step.Description))
                                                                {
                                                                    <div class="text-muted small">@step.Description</div>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            @if (step.IsImplemented)
                                                            {
                                                                <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Implementado</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Pendiente</span>
                                                            }
                                                            <button class="btn btn-sm btn-outline-primary" title="Editar paso" @onclick="() => ShowEditStepModal(workflow, step)">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger" title="Eliminar paso" @onclick="() => ConfirmDeleteStep(workflow, step)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowCreateStepModal(workflow)">
                                        <i class="bi bi-plus-lg me-1"></i>Agregar Paso
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Modal: Crear/Editar Workflow -->
@if (_showWorkflowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <EditForm Model="@_workflowForm" OnValidSubmit="SaveWorkflow">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-diagram-3 me-2 text-primary"></i>@(_isNewWorkflow ? "Nuevo Workflow" : "Editar Workflow")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseWorkflowModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="_workflowForm.Name" />
                            <ValidationMessage For="() => _workflowForm.Name" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_workflowForm.Description" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label">Estado de implementación</label>
                            <InputSelect class="form-select" @bind-Value="_workflowForm.Status">
                                @foreach (WorkflowImplementationStatus status in Enum.GetValues<WorkflowImplementationStatus>())
                                {
                                    <option value="@status">@GetStatusLabel(status)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseWorkflowModal">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal: Crear/Editar Paso -->
@if (_showStepModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <EditForm Model="@_stepForm" OnValidSubmit="SaveStep">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-list-check me-2 text-primary"></i>@(_isNewStep ? "Nuevo Paso" : "Editar Paso")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseStepModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Orden</label>
                                <InputNumber class="form-control" @bind-Value="_stepForm.StepOrder" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Nombre del paso</label>
                                <InputText class="form-control" @bind-Value="_stepForm.Name" />
                                <ValidationMessage For="() => _stepForm.Name" class="text-danger" />
                            </div>
                        </div>
                        <div class="mb-3 mt-3">
                            <label class="form-label">Descripción</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_stepForm.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Responsable</label>
                            <InputText class="form-control" placeholder="Ej: Administrador, Junta, Sistema" @bind-Value="_stepForm.Responsible" />
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" id="stepImplemented" @bind-Value="_stepForm.IsImplemented" />
                            <label class="form-check-label" for="stepImplemented">Ya está implementado</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseStepModal">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Workflow> _workflows = new();
    private HashSet<Guid> _expanded = new();
    private bool _loading = true;

    private bool _showWorkflowModal = false;
    private bool _isNewWorkflow = true;
    private Workflow _workflowForm = new();

    private bool _showStepModal = false;
    private bool _isNewStep = true;
    private WorkflowStep _stepForm = new();
    private Guid _stepFormWorkflowId;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkflows();
    }

    private async Task LoadWorkflows()
    {
        _loading = true;
        _workflows = await WorkflowService.GetWorkflowsAsync();
        _loading = false;
    }

    private void ToggleExpanded(Guid idWorkflow)
    {
        if (!_expanded.Add(idWorkflow))
            _expanded.Remove(idWorkflow);
    }

    private string GetStatusLabel(WorkflowImplementationStatus status) => status switch
    {
        WorkflowImplementationStatus.Pendiente => "Pendiente",
        WorkflowImplementationStatus.EnDesarrollo => "En Desarrollo",
        WorkflowImplementationStatus.Implementado => "Implementado",
        WorkflowImplementationStatus.Descartado => "Descartado",
        _ => status.ToString()
    };

    private string GetStatusBadgeClass(WorkflowImplementationStatus status) => status switch
    {
        WorkflowImplementationStatus.Pendiente => "bg-secondary",
        WorkflowImplementationStatus.EnDesarrollo => "bg-warning",
        WorkflowImplementationStatus.Implementado => "bg-success",
        WorkflowImplementationStatus.Descartado => "bg-danger",
        _ => "bg-secondary"
    };

    /*  === WORKFLOW ===  */

    private void ShowCreateWorkflowModal()
    {
        _isNewWorkflow = true;
        _workflowForm = new Workflow();
        _showWorkflowModal = true;
    }

    private void ShowEditWorkflowModal(Workflow workflow)
    {
        _isNewWorkflow = false;
        _workflowForm = new Workflow
        {
            IdWorkflow = workflow.IdWorkflow,
            Name = workflow.Name,
            Description = workflow.Description,
            Status = workflow.Status
        };
        _showWorkflowModal = true;
    }

    private void CloseWorkflowModal()
    {
        _showWorkflowModal = false;
    }

    private async Task SaveWorkflow()
    {
        if (_isNewWorkflow)
        {
            await WorkflowService.CreateWorkflowAsync(_workflowForm);
        }
        else
        {
            await WorkflowService.UpdateWorkflowAsync(_workflowForm);
        }

        _showWorkflowModal = false;
        await LoadWorkflows();
    }

    private async Task ConfirmDeleteWorkflow(Workflow workflow)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Eliminar el workflow \"{workflow.Name}\"? También se eliminarán todos sus pasos.");

        if (!confirmed) return;

        await WorkflowService.DeleteWorkflowAsync(workflow);
        await LoadWorkflows();
    }

    /*  === STEP ===  */

    private void ShowCreateStepModal(Workflow workflow)
    {
        _isNewStep = true;
        _stepFormWorkflowId = workflow.IdWorkflow;
        _stepForm = new WorkflowStep
        {
            IdWorkflow = workflow.IdWorkflow,
            StepOrder = (workflow.Steps.Any() ? workflow.Steps.Max(s => s.StepOrder) : 0) + 1
        };
        _showStepModal = true;
    }

    private void ShowEditStepModal(Workflow workflow, WorkflowStep step)
    {
        _isNewStep = false;
        _stepFormWorkflowId = workflow.IdWorkflow;
        _stepForm = new WorkflowStep
        {
            IdWorkflowStep = step.IdWorkflowStep,
            IdWorkflow = step.IdWorkflow,
            StepOrder = step.StepOrder,
            Name = step.Name,
            Description = step.Description,
            Responsible = step.Responsible,
            IsImplemented = step.IsImplemented
        };
        _showStepModal = true;
    }

    private void CloseStepModal()
    {
        _showStepModal = false;
    }

    private async Task SaveStep()
    {
        if (_isNewStep)
        {
            await WorkflowService.AddStepAsync(_stepForm);
        }
        else
        {
            await WorkflowService.UpdateStepAsync(_stepForm);
        }

        _showStepModal = false;
        _expanded.Add(_stepFormWorkflowId);
        await LoadWorkflows();
    }

    private async Task ConfirmDeleteStep(Workflow workflow, WorkflowStep step)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Eliminar el paso \"{step.Name}\"?");
        if (!confirmed) return;

        await WorkflowService.DeleteStepAsync(step);
        await LoadWorkflows();
    }
}