@page "/usuariosOld"

<PageTitle>Usuarios</PageTitle>

@using System.ComponentModel.DataAnnotations
<!-- Bootstrap y Bootstrap Icons (opcional pero recomendado) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<style>
    body {
        background: #f8f9fa;
    }

    .summary-card {
        border: 0;
        box-shadow: 0 8px 24px rgba(0,0,0,.06);
    }

        .summary-card .card-body {
            padding: .75rem;
        }

    .summary-title {
        font-size: .9rem;
        color: #6c757d;
    }

    .summary-value {
        font-size: 1.35rem;
        font-weight: 600;
    }

    .filters {
        gap: .5rem;
    }

        .filters .btn-group {
            flex-wrap: wrap;
        }

    .table td, .table th {
        vertical-align: middle;
    }

    .badge {
        font-size: .8rem;
    }

    .actions .btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
</style>
<div class="container mt-4">
    <h4 class="mb-3">Usuarios</h4>

    <!-- Resumen -->
    <div class="row text-center mb-4">
        @foreach (var resumen in Resumenes)
        {
            <div class="col-md-2 col-6 mb-2">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-2">
                        <strong>@resumen.Titulo</strong>
                        <div class="fs-5">@resumen.Valor</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Filtros -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <select class="form-select w-auto" @bind="FiltroRol">
            <option value="">Todos los roles</option>
            <option value="Administrador">Administradores</option>
            <option value="Junta Directiva">Junta Directiva</option>
            <option value="Residente">Residentes</option>
        </select>

        <select class="form-select w-auto" @bind="FiltroEstado">
            <option value="">Todos los estados</option>
            <option value="Activo">Activos</option>
            <option value="Inactivo">Inactivos</option>
        </select>

        <button class="btn btn-primary ms-auto" @onclick="AgregarUsuario">
            + Agregar Usuario
        </button>
    </div>

    <!-- Tabla -->
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Usuario</th>
                <th>Contacto</th>
                <th>Rol</th>
                <th>Depto</th>
                <th>Estado</th>
                <th>Fecha Ingreso</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in UsuariosFiltrados)
            {
                <tr>
                    <td>@usuario.Nombre</td>
                    <td>
                        <div>@usuario.Email</div>
                        <div class="text-muted">@usuario.Telefono</div>
                    </td>
                    <td>@usuario.Rol</td>
                    <td>@usuario.Departamento</td>
                    <td>
                        <span class="badge @(usuario.Estado == "Activo" ? "bg-success" : "bg-secondary")">
                            @usuario.Estado
                        </span>
                    </td>
                    <td>@usuario.FechaIngreso.ToString("dd MMM yyyy")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarUsuario(usuario)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarUsuario(usuario)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    public class Usuario
    {
        public string Nombre { get; set; } = "";
        public string Email { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Rol { get; set; } = "";
        public string Departamento { get; set; } = "";
        public string Estado { get; set; } = "";
        public DateTime FechaIngreso { get; set; }
    }

    public class ResumenItem
    {
        public string Titulo { get; set; } = "";
        public int Valor { get; set; }
    }

    private List<Usuario> Usuarios1 = new()
  {
    new() { Nombre="Juan Pérez", Email="juan.perez@email.com", Telefono="+52 55 1234 5678", Rol="Administrador", Departamento="101", Estado="Activo", FechaIngreso=new DateTime(2023,1,14) },
    new() { Nombre="María García", Email="maria.garcia@email.com", Telefono="+52 55 2345 6789", Rol="Junta Directiva", Departamento="102", Estado="Activo", FechaIngreso=new DateTime(2023,2,19) },
    new() { Nombre="Carlos López", Email="carlos.lopez@email.com", Telefono="+52 55 3456 7890", Rol="Residente", Departamento="201", Estado="Activo", FechaIngreso=new DateTime(2023,3,9) },
    new() { Nombre="Ana Martínez", Email="ana.martinez@email.com", Telefono="+52 55 4567 8901", Rol="Junta Directiva", Departamento="202", Estado="Activo", FechaIngreso=new DateTime(2023,4,4) },
    new() { Nombre="Roberto Silva", Email="roberto.silva@email.com", Telefono="+52 55 5678 9012", Rol="Residente", Departamento="301", Estado="Activo", FechaIngreso=new DateTime(2023,5,11) },
    new() { Nombre="Laura Torres", Email="laura.torres@email.com", Telefono="+52 55 6789 0123", Rol="Residente", Departamento="302", Estado="Inactivo", FechaIngreso=new DateTime(2023,6,20) }
  };

    private string FiltroRol = "";
    private string FiltroEstado = "";

    private List<Usuario> UsuariosFiltrados =>
      Usuarios1
        .Where(u => string.IsNullOrEmpty(FiltroRol) || u.Rol == FiltroRol)
        .Where(u => string.IsNullOrEmpty(FiltroEstado) || u.Estado == FiltroEstado)
        .ToList();

    private List<ResumenItem> Resumenes =>
    [
      new() { Titulo = "Total Usuarios", Valor = Usuarios1.Count },
    new() { Titulo = "Administradores", Valor = Usuarios1.Count(u => u.Rol == "Administrador") },
    new() { Titulo = "Junta Directiva", Valor = Usuarios1.Count(u => u.Rol == "Junta Directiva") },
    new() { Titulo = "Residentes", Valor = Usuarios1.Count(u => u.Rol == "Residente") },
    new() { Titulo = "Activos", Valor = Usuarios1.Count(u => u.Estado == "Activo") },
    new() { Titulo = "Inactivos", Valor = Usuarios1.Count(u => u.Estado == "Inactivo") }
    ];

    private void AgregarUsuario()
    {
        // Abrir modal o redirigir a formulario
    }

    private void EditarUsuario(Usuario usuario)
    {
        // Abrir modal con datos del usuario
    }

    private void EliminarUsuario(Usuario usuario)
    {
        Usuarios1.Remove(usuario);
    }
}
