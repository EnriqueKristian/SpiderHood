<Project>
  <!--
    Perfil de publicación para el ambiente de QA (IIS + SQL Server, Windows 11).
    Usalo desde Visual Studio: click derecho en el proyecto SpiderHood > Publish >
    elegí este perfil ("QA-IIS") > Publish.

    Publica como "Folder" directo a la carpeta física del sitio IIS -- no usa Web
    Deploy, así que no hace falta el agente de Web Deploy instalado. Framework-
    dependent (no self-contained): en la máquina de QA tiene que estar instalado
    el ASP.NET Core Hosting Bundle (ver DEPLOY-QA.md), que trae el runtime.

    PublishDir: ajustá esta ruta a la carpeta física real de tu sitio IIS antes de
    publicar (Visual Studio también te deja cambiarla desde la UI de Publish sin
    tocar este archivo).
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>C:\inetpub\wwwroot\SpiderHoodQA\</PublishDir>
    <!-- Esto queda grabado en el web.config generado, como variable de entorno
         ASPNETCORE_ENVIRONMENT=QA -- así la app carga appsettings.QA.json
         automáticamente al arrancar bajo IIS, sin tocar nada en el Application Pool. -->
    <EnvironmentName>QA</EnvironmentName>
  </PropertyGroup>
</Project>
